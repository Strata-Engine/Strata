-- Blasts in the viewer's world: a crater on a ruin leaves the structure
-- layer agreeing with the chunk, a crater under lake water wakes the fluid,
-- and the generator's settings come from its parameter file.
mod StrataViewer.Test.Blast do
  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem
  needs IO.Clock

  alias Strata.World as Wb
  alias Strata.Coord as Cb
  alias Strata.Edit as Eb

  pfn island() : Strata.Atlas.Atlas do Strata.Atlas.load_or_build(".march/atlas", StrataViewer.island_def(), 7) end

  -- the 3 x 3 x 3 chunks about the one holding voxel (x, y, z), loaded from g
  pfn around(w : Strata.World.World, g : Strata.Terrain.Gen, x : Int, y : Int, z : Int) : Strata.World.World do
    List.fold_left(List.range(0, 27), w, fn (acc, i) ->
      let k = Cb.key(Cb.chunk_of(x) + i % 3 - 1, Cb.chunk_of(y) + (i / 3) % 3 - 1, Cb.chunk_of(z) + i / 9 - 1)
      Wb.insert(acc, k, Strata.Terrain.run(g, k, 7)))
  end

  -- Over the 27 chunks about (x, y, z): (stamped voxels holding a ruin block,
  -- stamped voxels that are air, stamped voxels holding anything else, voxels
  -- in the ruin's box holding a ruin block with no stamp, air stamps farther
  -- than [reach] from (x, y, z))
  pfn agree(w : Strata.World.World, g : Strata.Terrain.Gen, b : (Int, Int, Int, Int, Int, Int), x : Int, y : Int, z : Int, reach : Int) : (Int, Int, Int, Int, Int) do
    List.fold_left(List.range(0, 27), (0, 0, 0, 0, 0), fn (acc, i) ->
      let k = Cb.key(Cb.chunk_of(x) + i % 3 - 1, Cb.chunk_of(y) + (i / 3) % 3 - 1, Cb.chunk_of(z) + i / 9 - 1)
      agree_go(w, Strata.Terrain.stamps(g, k, 7), b, 32 * Cb.kx(k), 32 * Cb.ky(k), 32 * Cb.kz(k), x, y, z, reach, 0, acc))
  end
  pfn agree_go(w : Strata.World.World, st : NativeI32Arr, b : (Int, Int, Int, Int, Int, Int), ox : Int, oy : Int, oz : Int, x : Int, y : Int, z : Int, reach : Int, i : Int, acc : (Int, Int, Int, Int, Int)) : (Int, Int, Int, Int, Int) do
    if i >= 32768 do acc
    else
      let vx = ox + i % 32
      let vy = oy + i / 1024
      let vz = oz + (i / 32) % 32
      let id = Wb.get_block(w, vx, vy, vz)
      let stamped = NativeArray.get_i32(st, i) != 0
      let (kept, carved, other, loose, far) = acc
      let inbox = match b do (x0, y0, z0, x1, y1, z1) -> vx >= x0 && vx <= x1 && vy >= y0 && vy <= y1 && vz >= z0 && vz <= z1 end
      let d2 = (vx - x) * (vx - x) + (vy - y) * (vy - y) + (vz - z) * (vz - z)
      let acc2 = if stamped do
          (if StrataViewer.ruin_block(id) do (kept + 1, carved, other, loose, far)
           else if id == 0 do (kept, carved + 1, other, loose, if d2 > reach * reach do far + 1 else far end)
           else (kept, carved, other + 1, loose, far) end end)
        else if inbox && StrataViewer.ruin_block(id) do (kept, carved, other, loose + 1, far)
        else acc end end
      agree_go(w, st, b, ox, oy, oz, x, y, z, reach, i + 1, acc2)
    end
  end

  describe "Blasts and the structure layer" do
    test "blasting a ruin's wall leaves the stamps agreeing with the chunk" do
      let a = island()
      let land = StrataViewer.Island(a)
      let d = StrataViewer.decor(1.0, 7)
      let g = StrataViewer.island_gen(a, d, 1.0)
      match Strata.Atlas.site_near(a, 0.0, 0.0, 100000.0) do
        None -> Test.fail("the island has sites")
        Some(_) ->
          match StrataViewer.crater_target(land, d, 7) do
            (x, y, z) ->
              match StrataViewer.slope_site(a) do
                None -> Test.fail("a slope site")
                Some(s) ->
                  match StrataViewer.site_ruin(d, s, 1.0, 7) do
                    None -> Test.fail("the ruins load")
                    Some((t, ox, oy, oz, rot)) ->
                      let b = Strata.Template.bounds(t, ox, oy, oz, rot)
                      let w = around(Wb.new(StrataViewer.registry(), g, 7, 1.0), g, x, y, z)
                      let (k0, c0, o0, l0, _) = agree(w, g, b, x, y, z, 8)
                      println("ruin before the blast: " ++ int_to_string(k0) ++ " stamped ruin voxels, " ++ int_to_string(c0) ++ " stamped air, " ++ int_to_string(o0) ++ " stamped other, " ++ int_to_string(l0) ++ " unstamped ruin blocks in its box")
                      Test.assert_true(k0 > 50, "the ruin is stamped")
                      Test.assert_eq_int(c0 + o0, 0, "before the blast every stamp holds the ruin's block")
                      Test.assert_eq_int(l0, 0, "and every ruin block in its box is stamped")
                      let w2 = Eb.world(Eb.blast(w, x, y, z, 6, 11, 0))
                      let (k1, c1, o1, l1, f1) = agree(w2, g, b, x, y, z, 8)
                      println("ruin after the blast: " ++ int_to_string(k1) ++ " stamped ruin voxels, " ++ int_to_string(c1) ++ " carved, " ++ int_to_string(o1) ++ " other, " ++ int_to_string(l1) ++ " unstamped ruin blocks")
                      Test.assert_true(c1 > 0, "the blast carved stamped voxels: they are air")
                      Test.assert_eq_int(k1 + c1, k0, "every stamp is still the ruin's block or carved")
                      Test.assert_eq_int(o1, 0, "no stamp holds anything else")
                      Test.assert_eq_int(l1, 0, "every block still the ruin's id has a stamp")
                      Test.assert_eq_int(f1, 0, "carving only within 1.3 radii of the blast")
                  end
              end
          end
      end
    end
    test "a blast under lake water wakes the fluid" do
      let a = island()
      let land = StrataViewer.Island(a)
      let g = StrataViewer.island_gen(a, StrataViewer.bare_decor(), 1.0)
      match StrataViewer.scene_lake(land, 7) do
        (cx, cz, rad, line, _, bed, _) ->
          Test.assert_true(rad > 0, "the island has a test lake")
          let reg = StrataViewer.registry()
          let w = around(Wb.new(reg, g, 7, 1.0), g, cx, line, cz)
          Test.assert_true(Strata.Blocks.is_fluid(reg, Wb.get_block(w, cx, line, cz)), "lake water at its line")
          let o = Eb.blast(w, cx, bed, cz, 6, 11, 0)
          let f0 = Strata.Fluid.new(reg, Cons((StrataViewer.lake_base(), Strata.Fluid.flowing()), Cons((5, Strata.Fluid.sink()), Nil)))
          Test.assert_eq_int(Strata.Fluid.active_count(f0), 0, "a lake at rest")
          let f1 = Strata.Fluid.wake(f0, Eb.world(o), o)
          println("blast under the lake: " ++ int_to_string(List.length(Eb.changes(o))) ++ " voxels changed, " ++ int_to_string(Strata.Fluid.active_count(f1)) ++ " fluid cells woken")
          Test.assert_true(Strata.Fluid.active_count(f1) > 0, "water woken")
      end
    end
  end

  describe "The generator's settings" do
    test "a parameter file that sets the sea level to 50 gives a generator whose sea is 50" do
      let path = ".march/test-sea.gen"
      Test.assert_true(Result.is_ok(File.write(path, "# a test\nsea = 50   # metres\nnot a setting\nwibble = 3\n")), "the file is written")
      let p = StrataViewer.Params.read(path)
      let gp = StrataViewer.gp_of(p)
      Test.assert_true(StrataViewer.gen_sea(gp) == 50.0, "the generator's sea")
      Test.assert_true(Strata.Atlas.d_sea(StrataViewer.island_def_of(gp)) == 50.0, "and the atlas's")
      Test.assert_true(StrataViewer.gp_value(gp, "tree_cell") == 6.0, "a name the file leaves out keeps its default")
      let said = StrataViewer.param_report(p)
      Test.assert_eq_int(List.length(said), List.length(StrataViewer.param_table()) - 1 + 2, "one line for each default taken, the unknown name and the bad line")
    end
    test "the shipped file sets every setting to its default" do
      let p = StrataViewer.Params.read(StrataViewer.params_path())
      Test.assert_eq_int(List.length(StrataViewer.param_report(p)), 0, "nothing left to default, unknown or unread")
      Test.assert_true(Strata.Atlas.cache_name(StrataViewer.island_def_of(StrataViewer.gp_of(p)), 7) == Strata.Atlas.cache_name(StrataViewer.island_def(), 7), "the same atlas as the defaults")
    end
  end
end
