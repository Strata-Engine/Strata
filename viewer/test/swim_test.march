-- The viewer's body in water: it floats, swims up, wades, and is carried by a current.
mod StrataViewer.Test.Swim do
  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.Process
  needs IO.Spawn

  alias StrataViewer.Walker as Wk3
  alias StrataViewer as Vw3
  alias Strata.World as Wd3
  alias Strata.Edit as Ed3
  alias Strata.Coord as Cd3
  alias Strata.Chunk as C3
  alias Strata.Fluid as F3

  -- stone below y = 0, air above; chunks -1..0 in x and z, -1..1 in y
  pfn load_go(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 12 do w
    else
      let cy = i / 4 - 1
      load_go(Wd3.insert(w, Cd3.key(i % 2 - 1, cy, (i / 2) % 2 - 1), if cy < 0 do C3.uniform(1) else C3.uniform(0) end), i + 1)
    end
  end
  pfn flat() : Strata.World.World do
    load_go(Wd3.new(Vw3.registry(), Strata.Terrain.gen(fn (k, seed) -> C3.uniform(0)), 1, 1.0), 0)
  end
  pfn box(w : Strata.World.World, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, id : Int) : Strata.World.World do
    Ed3.world(Ed3.fill_box(w, x0, y0, z0, x1, y1, z1, id))
  end
  pfn fluid() : Strata.Fluid.Fluid do F3.new(Vw3.registry(), Cons((Vw3.lake_base(), F3.flowing()), Cons((5, F3.sink()), Nil))) end
  -- a walled pool of sea water 8 deep and 9 x 9 across, its surface at y = 8
  pfn pool() : Strata.World.World do
    box(box(flat(), -6, 0, -6, 6, 9, 6, 1), -4, 0, -4, 4, 9, 4, 0) |> fill_pool
  end
  pfn fill_pool(w : Strata.World.World) : Strata.World.World do box(w, -4, 0, -4, 4, 7, 4, 5) end

  pfn run(w : Strata.World.World, b : StrataViewer.Walker.Body, mx : Float, mz : Float, up : Bool, n : Int) : StrataViewer.Walker.Body do
    if n <= 0 do b else run(w, Wk3.step_in(w, fluid(), b, mx, mz, up, 0.016667), mx, mz, up, n - 1) end
  end
  pfn deepest(w : Strata.World.World, b : StrataViewer.Walker.Body, n : Int, low : Float) : Float do
    if n <= 0 do low
    else
      let b2 = Wk3.step_in(w, fluid(), b, 0.0, 0.0, false, 0.016667)
      deepest(w, b2, n - 1, if Wk3.eye_y(b2) < low do Wk3.eye_y(b2) else low end)
    end
  end

  describe "Swimming" do
    test "a body dropped into deep water does not go to the bottom, and comes to float at the surface" do
      let w = pool()
      Test.assert_true(deepest(w, Wk3.body(0.5, 12.0, 0.5), 300, 100.0) > 4.0, "five seconds on, it has never been within reach of the bed")
      let b = run(w, Wk3.body(0.5, 12.0, 0.5), 0.0, 0.0, false, 600)
      Test.assert_true(Wk3.eye_y(b) > 7.6 && Wk3.eye_y(b) < 8.9, "it floats with its eyes about at the surface")
      Test.assert_false(Wk3.grounded(b), "and is not standing on anything")
    end
    test "holding jump under water swims up" do
      let w = pool()
      let b = run(w, Wk3.body_with(0.5, 3.0, 0.5, 0.0, false), 0.0, 0.0, true, 60)
      Test.assert_true(Wk3.eye_y(b) > 4.5, "a second of swimming gains over a metre and a half")
    end
    test "swimming is slower than walking" do
      let w = pool()
      let b = run(w, run(w, Wk3.body(0.5, 9.0, 0.5), 0.0, 0.0, false, 300), 5.0, 0.0, false, 30)
      Test.assert_true(Wk3.eye_x(b) > 1.4 && Wk3.eye_x(b) < 2.6, "half a second at a wanted 5 m/s covers between one and two metres")
    end
    test "a current carries a body that does nothing" do
      -- a walled channel of lake water one deep whose level falls toward +x
      let ch = box(box(flat(), -3, 0, -2, 12, 2, 2, 1), -2, 0, -1, 11, 2, 1, 0)
      let w = box(box(box(ch, -2, 0, -1, 2, 0, 1, Vw3.lake_base() + 7), 3, 0, -1, 6, 0, 1, Vw3.lake_base() + 4), 7, 0, -1, 10, 0, 1, Vw3.lake_base() + 1)
      let b = run(w, Wk3.body(2.5, 1.7, 0.5), 0.0, 0.0, false, 120)
      Test.assert_true(Wk3.eye_x(b) > 3.5, "two seconds in the stream move it more than a metre downstream")
    end
    test "on dry land the body walks as before" do
      let w = flat()
      let a = run(w, Wk3.body(0.5, 1.7, 0.5), 5.0, 0.0, false, 60)
      Test.assert_true(Wk3.eye_x(a) > 5.3 && Wk3.eye_x(a) < 5.7, "one second at 5 m/s is five metres")
      Test.assert_true(Wk3.grounded(a), "on the ground")
    end
  end
end
