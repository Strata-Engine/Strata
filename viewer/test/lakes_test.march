-- The viewer's lakes: terrain stays a pure function, a lake's rim holds its
-- water, and the sea is not a fluid.
mod StrataViewer.Test.Lakes do
  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.Process
  needs IO.Spawn

  alias StrataViewer as Vw
  alias Strata.World as Wl2
  alias Strata.Coord as Cl2
  alias Strata.Chunk as Chl2
  alias Strata.Blocks as Bl2

  pfn same_go(a : Strata.Chunk.Chunk, b : Strata.Chunk.Chunk, i : Int) : Bool do
    if i >= 32768 do true else if Chl2.get_or(a, i % 32, i / 1024, (i / 32) % 32, -1) != Chl2.get_or(b, i % 32, i / 1024, (i / 32) % 32, -1) do false else same_go(a, b, i + 97) end end
  end

  -- load the chunks covering x0..x1, z0..z1 (chunk coordinates) at heights cy 0..2
  pfn load_go(w : Strata.World.World, x0 : Int, x1 : Int, z0 : Int, z1 : Int, x : Int, y : Int, z : Int) : Strata.World.World do
    if y > 2 do w
    else if z > z1 do load_go(w, x0, x1, z0, z1, x0, y + 1, z0)
    else if x > x1 do load_go(w, x0, x1, z0, z1, x0, y, z + 1)
    else load_go(Wl2.insert(w, Cl2.key(x, y, z), Vw.terrain(x, y, z, 7)), x0, x1, z0, z1, x + 1, y, z) end end end
  end

  -- every lake-water cell at the water line has no air beside it; the count of water cells seen, or -1 at the first leak
  pfn held(w : Strata.World.World, cx : Int, cz : Int, rad : Int, line : Int, i : Int, n : Int, seen : Int) : Int do
    if i >= n * n do seen
    else
      let x = cx - rad - 4 + i % n
      let z = cz - rad - 4 + i / n
      if !Bl2.is_fluid(Vw.registry(), Wl2.get_block(w, x, line, z)) do held(w, cx, cz, rad, line, i + 1, n, seen)
      else if Wl2.get_block(w, x - 1, line, z) == 0 || Wl2.get_block(w, x + 1, line, z) == 0 || Wl2.get_block(w, x, line, z - 1) == 0 || Wl2.get_block(w, x, line, z + 1) == 0 do -1
      else held(w, cx, cz, rad, line, i + 1, n, seen + 1) end end
    end
  end

  describe "Viewer lakes" do
    test "terrain with lakes is still a pure function" do
      match Vw.test_lake(7) do
        (cx, cz, rad, line, _) ->
          Test.assert_true(rad > 0, "seed 7 has a lake near the origin")
          let kx = Cl2.chunk_of(cx)
          let kz = Cl2.chunk_of(cz)
          Test.assert_true(same_go(Vw.terrain(kx, Cl2.chunk_of(line), kz, 7), Vw.terrain(kx, Cl2.chunk_of(line), kz, 7), 0), "the same chunk twice")
      end
    end
    test "a lake's rim holds its water" do
      match Vw.test_lake(7) do
        (cx, cz, rad, line, _) ->
          let w = load_go(Wl2.new(Vw.registry(), Strata.Terrain.gen(fn (k, seed) -> Chl2.uniform(0)), 7, 1.0), Cl2.chunk_of(cx - rad - 5), Cl2.chunk_of(cx + rad + 5), Cl2.chunk_of(cz - rad - 5), Cl2.chunk_of(cz + rad + 5), Cl2.chunk_of(cx - rad - 5), 0, Cl2.chunk_of(cz - rad - 5))
          let n = held(w, cx, cz, rad, line, 0, 2 * rad + 9, 0)
          Test.assert_true(n > 0, "the lake has water at its line, and none of it stands beside air")
          Test.assert_true(Bl2.is_fluid(Vw.registry(), Wl2.get_block(w, cx, line, cz)), "its middle is lake water")
          Test.assert_eq_int(Wl2.get_block(w, cx, line + 1, cz), 0, "with air over it")
      end
    end
    test "the sea is not a fluid, and lake water is" do
      Test.assert_false(Bl2.is_fluid(Vw.registry(), 5), "the sea never moves")
      Test.assert_true(Bl2.is_fluid(Vw.registry(), Vw.lake_base()), "lake water does")
      Test.assert_eq_int(Bl2.fill(Vw.registry(), Vw.lake_base() + 7), 8, "and its last state is a full voxel")
    end
  end
end
