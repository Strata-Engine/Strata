-- The viewer's lakes: the island read from an atlas, its lakes, rivers and
-- damped detail, and the sea is not a fluid.
mod StrataViewer.Test.Lakes do
  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.FileRead    -- the viewer lists viewer/sounds/ (charged to every test module, as in GAPS S3)
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem
  needs IO.Clock

  alias StrataViewer as Vw
  alias Strata.World as Wl2
  alias Strata.Coord as Cl2
  alias Strata.Chunk as Chl2
  alias Strata.Blocks as Bl2

  pfn same_go(a : Strata.Chunk.Chunk, b : Strata.Chunk.Chunk, i : Int) : Bool do
    if i >= 32768 do true else if Chl2.get_or(a, i % 32, i / 1024, (i / 32) % 32, -1) != Chl2.get_or(b, i % 32, i / 1024, (i / 32) % 32, -1) do false else same_go(a, b, i + 97) end end
  end


  -- ── The island ─────────────────────────────────────────────────────────
  -- the demo-sized atlas (256 x 256, 4 m): a second to build, with lakes and rivers
  pfn atlas() : Strata.Atlas.Atlas do Strata.Atlas.build(Strata.Atlas.def(256, 4.0, 400.0, 120.0, 5, 40.0), 7) end

  pfn whole(m : Float) : Int do float_to_int(Math.floor(m)) end

  -- the block at a world position, from the island chunk holding it
  pfn island_block(a : Strata.Atlas.Atlas, x : Int, y : Int, z : Int) : Int do
    let kx = Cl2.chunk_of(x)
    let ky = Cl2.chunk_of(y)
    let kz = Cl2.chunk_of(z)
    Chl2.get_or(Vw.island_terrain(a, 1.0, kx, ky, kz, 7), x - 32 * kx, y - 32 * ky, z - 32 * kz, -1)
  end

  -- the first lake that holds water
  pfn wet_lake(ls : List((Float, Float, Float))) : (Float, Float, Float) do
    match ls do
      Nil -> (0.0, 0.0, 0.0 -. 1.0)
      Cons((x, z, lv), rest) -> if lv >= 0.0 do (x, z, lv) else wet_lake(rest) end
    end
  end

  -- the first river point standing over [above] metres and at least [wide] metres wide
  pfn river_point(a : Strata.Atlas.Atlas, rs : List(List((Float, Float, Float))), above : Float, wide : Float) : (Float, Float, Float) do
    match rs do
      Nil -> (0.0, 0.0, 0.0)
      Cons(r, rest) ->
        match List.find(r, fn pt -> match pt do (x, z, w) -> if w < wide do false else Strata.Atlas.height_at(a, x, z) > above end end) do
          Some(p) -> p
          None -> river_point(a, rest, above, wide)
        end
    end
  end

  pfn col_h(c : (Int, Int, Int)) : Int do match c do (h, _, _) -> h end end
  pfn col_lake(c : (Int, Int, Int)) : Int do match c do (_, l, _) -> l end end
  pfn col_river(c : (Int, Int, Int)) : Int do match c do (_, _, r) -> r end end

  -- the island columns of the (2 half + 1)^2 box about (x0, z0), as ground, lake line and river line arrays
  type LakeBox = LakeBox(Int, Int, Int, NativeIntArr, NativeIntArr, NativeIntArr)
  pfn box_go(a : Strata.Atlas.Atlas, x0 : Int, z0 : Int, half : Int, k : Int, hs : NativeIntArr, ls : NativeIntArr, rs : NativeIntArr) : LakeBox do
    let side = 2 * half + 1
    if k >= side * side do LakeBox(x0, z0, half, hs, ls, rs)
    else
      let c = Vw.island_column(a, x0 - half + k % side, z0 - half + k / side, 7, 1.0)
      box_go(a, x0, z0, half, k + 1, NativeArray.set_int(hs, k, col_h(c)), NativeArray.set_int(ls, k, col_lake(c)), NativeArray.set_int(rs, k, col_river(c)))
    end
  end
  pfn box(a : Strata.Atlas.Atlas, x0 : Int, z0 : Int, half : Int) : LakeBox do
    let n = (2 * half + 1) * (2 * half + 1)
    box_go(a, x0, z0, half, 0, NativeArray.make_int(Strata.Size.of(n), 0), NativeArray.make_int(Strata.Size.of(n), 0), NativeArray.make_int(Strata.Size.of(n), 0))
  end

  -- a lake column within 3 m of box cell k: its lake line, or 0
  pfn lake_near(b : LakeBox, k : Int, t : Int) : Int do
    if t >= 49 do 0
    else
      match b do
        LakeBox(_, _, half, _, ls, _) ->
          let side = 2 * half + 1
          let dx = t % 7 - 3
          let dz = t / 7 - 3
          let x = k % side + dx
          let z = k / side + dz
          let l = if x < 0 || z < 0 || x >= side || z >= side || dx * dx + dz * dz > 9 do 0 else NativeArray.get_int(ls, x + side * z) end
          if l > 0 do l else lake_near(b, k, t + 1) end
      end
    end
  end

  -- land columns (no lake, no river) within 3 m of a lake column standing under its line + 1: their count, and how many were checked
  pfn rim_go(b : LakeBox, k : Int, bad : Int, seen : Int) : (Int, Int) do
    match b do
      LakeBox(_, _, half, hs, ls, rs) ->
        let side = 2 * half + 1
        if k >= side * side do (bad, seen)
        else if NativeArray.get_int(ls, k) > 0 || NativeArray.get_int(rs, k) > 0 do rim_go(b, k + 1, bad, seen)
        else
          let l = lake_near(b, k, 0)
          if l == 0 do rim_go(b, k + 1, bad, seen)
          else rim_go(b, k + 1, if NativeArray.get_int(hs, k) < l + 1 do bad + 1 else bad end, seen + 1) end
        end end
    end
  end

  -- bank columns: along +x from each river point, the first column out of the channel and the one past it
  -- (both within 2 m of it); (columns checked, those whose ground stands under the atlas height)
  pfn bank_go(a : Strata.Atlas.Atlas, pts : List((Float, Float, Float)), seen : Int, bad : Int) : (Int, Int) do
    match pts do
      Nil -> (seen, bad)
      Cons((x, z, _), rest) ->
        if seen >= 50 do (seen, bad)
        else
          let wz = whole(z)
          let e = bank_edge(a, whole(x), wz, 0)
          if e < 0 do bank_go(a, rest, seen, bad)
          else
            let b1 = if below_atlas(a, e, wz) do 1 else 0 end
            let b2 = if below_atlas(a, e + 1, wz) do 1 else 0 end
            bank_go(a, rest, seen + 2, bad + b1 + b2)
          end
        end
    end
  end
  -- the first column at or east of wx (within 12 m) that is neither channel nor lake; -1 if none
  pfn bank_edge(a : Strata.Atlas.Atlas, wx : Int, wz : Int, t : Int) : Int do
    if t > 12 do -1
    else
      let c = Vw.island_column(a, wx + t, wz, 7, 1.0)
      if col_lake(c) > 0 do -1
      else if col_river(c) == 0 do wx + t
      else bank_edge(a, wx, wz, t + 1) end end
    end
  end
  pfn below_atlas(a : Strata.Atlas.Atlas, wx : Int, wz : Int) : Bool do
    let xm = int_to_float(wx)
    let zm = int_to_float(wz)
    Vw.island_height_m(a, xm, zm, 7) < Strata.Atlas.height_at(a, xm, zm)
  end
  pfn all_points(rs : List(List((Float, Float, Float))), acc : List((Float, Float, Float))) : List((Float, Float, Float)) do
    match rs do
      Nil -> acc
      Cons(r, rest) -> all_points(rest, List.append(acc, r))
    end
  end

  -- a river point whose column 2 m east is channel, the sample 4 m east is not river, and whose
  -- own (sample) height and the bilinear height 2 m east differ by a voxel or more: (x, z), or None
  pfn off_sample(a : Strata.Atlas.Atlas, pts : List((Float, Float, Float))) : Option((Float, Float)) do
    match pts do
      Nil -> None
      Cons((x, z, _), rest) ->
        let own = whole(Strata.Atlas.height_at(a, x, z))
        let mid = whole(Strata.Atlas.height_at(a, x +. 2.0, z))
        let lone = Strata.Atlas.river_width_at(a, x +. 4.0, z) == 0.0
        let ok = if !lone || own == mid do false else col_river(Vw.island_column(a, whole(x) + 2, whole(z), 7, 1.0)) > 0 end
        if ok do Some((x, z)) else off_sample(a, rest) end
    end
  end

  -- no river sample within 20 m (5 samples) of sample (i, j)
  pfn dry_go(a : Strata.Atlas.Atlas, i : Int, j : Int, t : Int) : Bool do
    if t >= 121 do true
    else if Strata.Atlas.river_width_ij(a, i + t % 11 - 5, j + t / 11 - 5) > 0.0 do false
    else dry_go(a, i, j, t + 1) end end
  end
  -- over samples 16 m apart in the 400 m about the origin, those 20 m from any river and off the lakes:
  -- (how many, the largest |detail| among them)
  pfn far_go(a : Strata.Atlas.Atlas, k : Int, n : Int, best : Float) : (Int, Float) do
    if k >= 625 do (n, best)
    else
      let i = 128 + 4 * (k % 25 - 12)
      let j = 128 + 4 * (k / 25 - 12)
      let xm = int_to_float(i - 128) *. 4.0
      let zm = int_to_float(j - 128) *. 4.0
      let land = Strata.Atlas.height_at(a, xm, zm) > 41.0
      let ok = if !land do false else if Strata.Atlas.lake_at(a, xm, zm) >= 0.0 do false else dry_go(a, i, j, 0) end end
      if !ok do far_go(a, k + 1, n, best)
      else
        let d = Math.abs(Vw.island_height_m(a, xm, zm, 7) -. Strata.Atlas.height_at(a, xm, zm))
        far_go(a, k + 1, n + 1, if d > best do d else best end)
      end
    end
  end

  -- ── Density, caves and the early-outs (Task 7) ───────────────────────────
  -- the viewer's own island, read from its cache (built once if missing)
  pfn island() : Strata.Atlas.Atlas do Strata.Atlas.load_or_build(".march/atlas", Vw.island_def(), 7) end

  pfn full_same(a : Strata.Chunk.Chunk, b : Strata.Chunk.Chunk, i : Int) : Bool do
    if i >= 32768 do true else if Chl2.get_or(a, i % 32, i / 1024, (i / 32) % 32, -1) != Chl2.get_or(b, i % 32, i / 1024, (i / 32) % 32, -1) do false else full_same(a, b, i + 1) end end
  end

  -- Lake columns 3 m apart over 60 m about each lake's centre: for each, the
  -- voxels from 4 m under the bed up to it must be solid ground (not air,
  -- not water). (columns checked, bad voxels, distinct chunks seen as a list of keys)
  pfn under_lakes(a : Strata.Atlas.Atlas, ls : List((Float, Float, Float)), cols : Int, bad : Int, seen : List(Int)) : (Int, Int, List(Int)) do
    match ls do
      Nil -> (cols, bad, seen)
      Cons((x, z, lv), rest) ->
        if lv < 0.0 do under_lakes(a, rest, cols, bad, seen)
        else
          match lake_cols(a, whole(x), whole(z), 0, cols, bad, seen) do
            (c2, b2, s2) -> under_lakes(a, rest, c2, b2, s2)
          end
        end
    end
  end
  pfn lake_cols(a : Strata.Atlas.Atlas, cx : Int, cz : Int, t : Int, cols : Int, bad : Int, seen : List(Int)) : (Int, Int, List(Int)) do
    if t >= 441 do (cols, bad, seen)
    else
      let wx = cx - 30 + 3 * (t % 21)
      let wz = cz - 30 + 3 * (t / 21)
      let c = Vw.island_column(a, wx, wz, 7, 1.0)
      if col_lake(c) == 0 do lake_cols(a, cx, cz, t + 1, cols, bad, seen)
      else
        let h = col_h(c)
        let k1 = chunk_tag(wx, h, wz)
        let k2 = chunk_tag(wx, h - 4, wz)
        let s1 = if List.member(seen, k1) do seen else Cons(k1, seen) end
        let s2 = if List.member(s1, k2) do s1 else Cons(k2, s1) end
        lake_cols(a, cx, cz, t + 1, cols + 1, bad + soft_go(a, wx, wz, h - 4, h, 0), s2)
      end
    end
  end
  pfn chunk_tag(x : Int, y : Int, z : Int) : Int do (Cl2.chunk_of(x) + 512) + 1024 * ((Cl2.chunk_of(y) + 512) + 1024 * (Cl2.chunk_of(z) + 512)) end
  -- voxels from y to top that are air or water
  pfn soft_go(a : Strata.Atlas.Atlas, x : Int, z : Int, y : Int, top : Int, n : Int) : Int do
    if y > top do n
    else
      let b = island_block(a, x, y, z)
      let isoft = soft(b)
      soft_go(a, x, z, y + 1, top, if isoft do n + 1 else n end)
    end
  end

  -- air voxels well under the ground (20 m below the column's height less the
  -- 12 m of density noise) in the chunks of a 4 x 4 chunk area at the origin's ground
  pfn caves_go(a : Strata.Atlas.Atlas, k : Int, n : Int) : Int do
    if k >= 16 * 8 do n
    else
      let cx = k % 4 - 2
      let cz = (k / 4) % 4 - 2
      let x = cx * 32 + 16
      let z = cz * 32 + 16
      let g = col_h(Vw.island_column(a, x, z, 7, 1.0))
      let cy = Cl2.chunk_of(g) - k / 16
      let ch = Vw.island_terrain(a, 1.0, cx, cy, cz, 7)
      caves_go(a, k + 1, n + deep_air(a, ch, cx, cy, cz, 0, 0))
    end
  end
  pfn deep_air(a : Strata.Atlas.Atlas, ch : Strata.Chunk.Chunk, cx : Int, cy : Int, cz : Int, i : Int, n : Int) : Int do
    if i >= 32768 do n
    else
      let x = i % 32
      let z = (i / 32) % 32
      let y = i / 1024
      let deep = if Chl2.get_or(ch, x, y, z, -1) != 0 do false
        else int_to_float(cy * 32 + y) < Vw.island_height_m(a, int_to_float(cx * 32 + x), int_to_float(cz * 32 + z), 7) -. 32.0 end
      deep_air(a, ch, cx, cy, cz, i + 37, if deep do n + 1 else n end)
    end
  end


  -- ── Fix round 1 ──────────────────────────────────────────────────────────
  -- chunks generated once and looked up by world voxel
  type Cache = Cache(List((Int, Strata.Chunk.Chunk)))
  pfn ckey(cx : Int, cy : Int, cz : Int) : Int do (cx + 512) + 1024 * ((cy + 512) + 1024 * (cz + 512)) end
  pfn cache_find(cs : List((Int, Strata.Chunk.Chunk)), k : Int) : Option(Strata.Chunk.Chunk) do
    match cs do
      Nil -> None
      Cons((k2, c), rest) -> if k2 == k do Some(c) else cache_find(rest, k) end
    end
  end
  -- the block at (x, y, z) and the cache, grown by the chunk if it was not there
  pfn cblock(a : Strata.Atlas.Atlas, ca : Cache, x : Int, y : Int, z : Int) : (Int, Cache) do
    let cx = Cl2.chunk_of(x)
    let cy = Cl2.chunk_of(y)
    let cz = Cl2.chunk_of(z)
    match ca do
      Cache(cs) ->
        match cache_find(cs, ckey(cx, cy, cz)) do
          Some(c) -> (Chl2.get_or(c, x - 32 * cx, y - 32 * cy, z - 32 * cz, -1), ca)
          None ->
            let c = Vw.island_terrain(a, 1.0, cx, cy, cz, 7)
            (Chl2.get_or(c, x - 32 * cx, y - 32 * cy, z - 32 * cz, -1), Cache(Cons((ckey(cx, cy, cz), c), cs)))
        end
    end
  end
  -- air, sea or lake water (the lake family's ids, not Bl2.is_fluid: building the registry for every voxel cost gigabytes)
  pfn soft(b : Int) : Bool do if b == 0 do true else if b == 5 do true else if b < Vw.lake_base() do false else b <= Vw.lake_base() + 7 end end end end

  -- Connectivity: every solid voxel (not air, sea or lake water) of a chunk
  -- is reached by a 6-connected flood from the solid voxels of its faces
  -- that rest on solid across the face: its bottom row on the chunk below's
  -- top row, its four sides on the side neighbours' facing rows (solid can
  -- rest on the ground through a side wall). The top face seeds nothing.
  pfn solid_arr(c : Strata.Chunk.Chunk, out : NativeIntArr, i : Int) : NativeIntArr do
    if i >= 32768 do out else solid_arr(c, NativeArray.set_int(out, i, if soft(Chl2.get_or(c, i % 32, i / 1024, (i / 32) % 32, 0)) do 0 else 1 end), i + 1) end
  end
  -- face voxel i (local x, y, z) rests on solid in its neighbour across face f (0 below, 1 -x, 2 +x, 3 -z, 4 +z)
  pfn rests(nb : Strata.Chunk.Chunk, f : Int, x : Int, y : Int, z : Int) : Bool do
    let b = if f == 0 do Chl2.get_or(nb, x, 31, z, 0)
      else if f == 1 do Chl2.get_or(nb, 31, y, z, 0)
      else if f == 2 do Chl2.get_or(nb, 0, y, z, 0)
      else if f == 3 do Chl2.get_or(nb, x, y, 31, 0)
      else Chl2.get_or(nb, x, y, 0, 0) end end end end
    !soft(b)
  end
  -- seeds on face f: its 1024 voxels, k = a + 32 b over the face
  pfn face_go(sol : NativeIntArr, nb : Strata.Chunk.Chunk, f : Int, seen : NativeIntArr, st : NativeIntArr, sp : Int, k : Int) : (NativeIntArr, NativeIntArr, Int) do
    if k >= 1024 do (seen, st, sp)
    else
      let u = k % 32
      let v = k / 32
      -- (x, y, z) of the face voxel
      let x = if f == 1 do 0 else if f == 2 do 31 else u end end
      let y = if f == 0 do 0 else v end
      let z = if f == 0 do v else if f == 3 do 0 else if f == 4 do 31 else u end end end
      let i = x + 32 * (z + 32 * y)
      let take = if NativeArray.get_int(sol, i) == 0 do false else if NativeArray.get_int(seen, i) == 1 do false else rests(nb, f, x, y, z) end end
      if take do face_go(sol, nb, f, NativeArray.set_int(seen, i, 1), NativeArray.set_int(st, sp, i), sp + 1, k + 1)
      else face_go(sol, nb, f, seen, st, sp, k + 1) end
    end
  end
  -- the flood, one neighbour (d 0..5) of voxel i a call, popping the next voxel at d = 6:
  -- one self-recursive loop
  pfn flood(sol : NativeIntArr, seen : NativeIntArr, st : NativeIntArr, sp : Int, i : Int, d : Int) : NativeIntArr do
    if d >= 6 do
      if sp <= 0 do seen else flood(sol, seen, st, sp - 1, NativeArray.get_int(st, sp - 1), 0) end
    else
      let x = i % 32
      let z = (i / 32) % 32
      let y = i / 1024
      let ok = if d == 0 do x > 0 else if d == 1 do x < 31 else if d == 2 do z > 0 else if d == 3 do z < 31 else if d == 4 do y > 0 else y < 31 end end end end end
      let q = if d == 0 do i - 1 else if d == 1 do i + 1 else if d == 2 do i - 32 else if d == 3 do i + 32 else if d == 4 do i - 1024 else i + 1024 end end end end end
      let take = if !ok do false else if NativeArray.get_int(sol, q) == 0 do false else NativeArray.get_int(seen, q) == 0 end end
      if take do flood(sol, NativeArray.set_int(seen, q, 1), NativeArray.set_int(st, sp, q), sp + 1, i, d + 1)
      else flood(sol, seen, st, sp, i, d + 1) end
    end
  end
  pfn unreached(sol : NativeIntArr, seen : NativeIntArr, i : Int, n : Int) : Int do
    if i >= 32768 do n
    else
      let u = if NativeArray.get_int(sol, i) == 0 do false else NativeArray.get_int(seen, i) == 0 end
      unreached(sol, seen, i + 1, if u do n + 1 else n end)
    end
  end
  pfn floating(a : Strata.Atlas.Atlas, cx : Int, cy : Int, cz : Int) : Int do
    let sol = solid_arr(Vw.island_terrain(a, 1.0, cx, cy, cz, 7), NativeArray.make_int(32768, 0), 0)
    let st0 = (NativeArray.make_int(32768, 0), NativeArray.make_int(32768, 0), 0)
    let s0 = match st0 do (se, st, sp) -> face_go(sol, Vw.island_terrain(a, 1.0, cx, cy - 1, cz, 7), 0, se, st, sp, 0) end
    let s1 = match s0 do (se, st, sp) -> face_go(sol, Vw.island_terrain(a, 1.0, cx - 1, cy, cz, 7), 1, se, st, sp, 0) end
    let s2 = match s1 do (se, st, sp) -> face_go(sol, Vw.island_terrain(a, 1.0, cx + 1, cy, cz, 7), 2, se, st, sp, 0) end
    let s3 = match s2 do (se, st, sp) -> face_go(sol, Vw.island_terrain(a, 1.0, cx, cy, cz - 1, 7), 3, se, st, sp, 0) end
    let s4 = match s3 do (se, st, sp) -> face_go(sol, Vw.island_terrain(a, 1.0, cx, cy, cz + 1, 7), 4, se, st, sp, 0) end
    match s4 do (se, st, sp) -> unreached(sol, flood(sol, se, st, sp, 0, 6), 0, 0) end
  end
  -- the chunk columns round (kx, kz) (all 9, or the 8 round it), the ground's chunk and the one above: unreached voxels
  pfn float_go(a : Strata.Atlas.Atlas, kx : Int, kz : Int, mid : Bool, k : Int, n : Int) : Int do
    if k >= 9 do n
    else if k == 4 && !mid do float_go(a, kx, kz, mid, k + 1, n)
    else
      let cx = kx + k % 3 - 1
      let cz = kz + k / 3 - 1
      let cy = Cl2.chunk_of(col_h(Vw.island_column(a, cx * 32 + 16, cz * 32 + 16, 7, 1.0)))
      float_go(a, kx, kz, mid, k + 1, n + floating(a, cx, cy, cz) + floating(a, cx, cy + 1, cz))
    end end
  end

  -- Thermal seams: chunk pairs (cx, cz) | (cx + 1, cz) whose shared border is
  -- steep (the island height changes over 3 m by more than 3 m somewhere along
  -- it, every 4 m); for each, the worst disagreement of the two border
  -- columns' relaxed H between each chunk and a patch centred on the border.
  pfn steep_border(a : Strata.Atlas.Atlas, bx : Int, z0 : Int, t : Int) : Bool do
    if t >= 8 do false
    else
      let z = int_to_float(z0 + 4 * t)
      let d = Math.abs(Vw.island_height_m(a, int_to_float(bx - 1), z, 7) -. Vw.island_height_m(a, int_to_float(bx + 2), z, 7))
      if d > 3.0 do true else steep_border(a, bx, z0, t + 1) end
    end
  end
  pfn seam_err(l : NativeF32Arr, r : NativeF32Arr, mid : NativeF32Arr, z : Int, worst : Float) : Float do
    if z >= 32 do worst
    else
      let e1 = Math.abs(NativeArray.get_f32(l, 31 + 32 * z) -. NativeArray.get_f32(mid, 15 + 32 * z))
      let e2 = Math.abs(NativeArray.get_f32(r, 32 * z) -. NativeArray.get_f32(mid, 16 + 32 * z))
      seam_err(l, r, mid, z + 1, fmax3(worst, e1, e2))
    end
  end
  pfn fmax3(p : Float, q : Float, s : Float) : Float do if p >= q && p >= s do p else if q >= s do q else s end end end
  -- (pairs checked, worst error)
  pfn seams_go(a : Strata.Atlas.Atlas, k : Int, n : Int, worst : Float) : (Int, Float) do
    if n >= 20 do (n, worst)
    else if k >= 400 do (n, worst)
    else
      let cx = k % 20 - 10
      let cz = k / 20 - 10
      let bx = cx * 32 + 31
      if !steep_border(a, bx, cz * 32, 0) do seams_go(a, k + 1, n, worst)
      else
        let l = Vw.relaxed_heights(a, 1.0, cx * 32, cz * 32, 7)
        let r = Vw.relaxed_heights(a, 1.0, cx * 32 + 32, cz * 32, 7)
        let mid = Vw.relaxed_heights(a, 1.0, cx * 32 + 16, cz * 32, 7)
        seams_go(a, k + 1, n + 1, seam_err(l, r, mid, 0, worst))
      end
    end end
  end

  -- Tunnels: along lines of 64 m through the cave scene's chunks, at every
  -- height, the longest run of air lying more than 6 m under the island height
  -- air that only a tunnel cut: its column's entrance noise at or under 0.6
  -- and the cavern noise there under its 0.55 threshold (by 0.05, as the
  -- voxel's value is filled from the lattice); the viewer's settings and seeds
  pfn tunnel_only(x : Int, y : Int, z : Int) : Bool do
    let one = Strata.Noise.settings(0, 1, 2.0, 0.5, 0, 0.0)
    let en = Strata.Noise.sample2(one, Strata.Seed.mix(7, 9), 1.0 /. 120.0, int_to_float(x), int_to_float(z))
    if en > 0.6 do false
    else Strata.Noise.sample3(one, Strata.Seed.mix(7, 8), 1.0 /. 90.0, int_to_float(x), int_to_float(y), int_to_float(z)) < 0.5 end
  end
  -- x runs from 0 to 63 (chunks 0 and 1), z in chunk 2 (64..95), y from 42 to 98; h0 and h1 the two chunks' relaxed heights
  -- the relaxed H of the 96 x 96 columns from (0, 32), x + 96 z: chunks x 0..2, z 1..3
  pfn area_h(a : Strata.Atlas.Atlas, out : NativeF32Arr, k : Int) : NativeF32Arr do
    if k >= 9 do out
    else area_h(a, put_h(Vw.relaxed_heights(a, 1.0, 32 * (k % 3), 32 + 32 * (k / 3), 7), out, 32 * (k % 3), 32 * (k / 3), 0), k + 1) end
  end
  pfn put_h(hs : NativeF32Arr, out : NativeF32Arr, ox : Int, oz : Int, c : Int) : NativeF32Arr do
    if c >= 1024 do out else put_h(hs, NativeArray.set_f32(out, (ox + c % 32) + 96 * (oz + c / 32), NativeArray.get_f32(hs, c)), ox, oz, c + 1) end
  end
  -- lines along x (dir 0) at every other z, and along z (dir 1) at every other x, for y 42..110:
  -- the longest run of tunnel air 6 m or more under H
  pfn tunnel_go(a : Strata.Atlas.Atlas, ca : Cache, hs : NativeF32Arr, dir : Int, w : Int, y : Int, best : Int) : Int do
    if dir >= 2 do best
    else if w >= 96 do tunnel_go(a, ca, hs, dir + 1, 0, 42, best)
    else if y > 110 do tunnel_go(a, ca, hs, dir, w + 2, 42, best)
    else
      match run_line(a, ca, hs, dir, w, y, 0, 0, 0) do
        (r, ca2) -> tunnel_go(a, ca2, hs, dir, w, y + 1, if r > best do r else best end)
      end
    end end end
  end
  pfn run_line(a : Strata.Atlas.Atlas, ca : Cache, hs : NativeF32Arr, dir : Int, w : Int, y : Int, t : Int, run : Int, best : Int) : (Int, Cache) do
    if t >= 96 do (if run > best do run else best end, ca)
    else
      let x = if dir == 0 do t else w end
      let z = if dir == 0 do w else t end
      match cblock(a, ca, x, y, z + 32) do
        (b, ca2) ->
          let deep = int_to_float(y) < NativeArray.get_f32(hs, x + 96 * z) -. 6.0
          let air = if b != 0 do false else if !deep do false else tunnel_only(x, y, z + 32) end end
          if air do run_line(a, ca2, hs, dir, w, y, t + 1, run + 1, best)
          else run_line(a, ca2, hs, dir, w, y, t + 1, 0, if run > best do run else best end) end
      end
    end
  end

  -- The lake rim: around each lake, every land column within 4 m of a lake
  -- column has no air or water from 4 m under the nearby bed up to the line.
  -- (columns checked, bad voxels)
  pfn near4(b : LakeBox, k : Int, t : Int, line : Int, bed : Int) : (Int, Int) do
    if t >= 81 do (line, bed)
    else
      match b do
        LakeBox(_, _, half, hs, ls, _) ->
          let side = 2 * half + 1
          let dx = t % 9 - 4
          let dz = t / 9 - 4
          let x = k % side + dx
          let z = k / side + dz
          let inside = if x < 0 || z < 0 || x >= side || z >= side do false else dx * dx + dz * dz <= 16 end
          let l = if inside do NativeArray.get_int(ls, x + side * z) else 0 end
          if l > 0 do near4(b, k, t + 1, if l > line do l else line end, if NativeArray.get_int(hs, x + side * z) < bed do NativeArray.get_int(hs, x + side * z) else bed end)
          else near4(b, k, t + 1, line, bed) end
      end
    end
  end
  pfn rim4_go(a : Strata.Atlas.Atlas, ca : Cache, b : LakeBox, k : Int, cols : Int, bad : Int) : (Int, Int, Cache) do
    match b do
      LakeBox(x0, z0, half, _, ls, rs) ->
        let side = 2 * half + 1
        if k >= side * side do (cols, bad, ca)
        else if NativeArray.get_int(ls, k) > 0 || NativeArray.get_int(rs, k) > 0 do rim4_go(a, ca, b, k + 1, cols, bad)
        else
          match near4(b, k, 0, 0, 100000) do
            (line, bed) ->
              if line == 0 do rim4_go(a, ca, b, k + 1, cols, bad)
              else
                match soft_count(a, ca, x0 - half + k % side, z0 - half + k / side, bed - 4, line, 0) do
                  (n, ca2) -> rim4_go(a, ca2, b, k + 1, cols + 1, bad + n)
                end
              end
          end
        end end
    end
  end
  pfn soft_count(a : Strata.Atlas.Atlas, ca : Cache, x : Int, z : Int, y : Int, top : Int, n : Int) : (Int, Cache) do
    if y > top do (n, ca)
    else
      match cblock(a, ca, x, y, z) do
        (blk, ca2) -> soft_count(a, ca2, x, z, y + 1, top, if soft(blk) do n + 1 else n end)
      end
    end
  end
  pfn rims_go(a : Strata.Atlas.Atlas, ls : List((Float, Float, Float)), cols : Int, bad : Int) : (Int, Int) do
    match ls do
      Nil -> (cols, bad)
      Cons((x, z, lv), rest) ->
        if lv < 0.0 do rims_go(a, rest, cols, bad)
        else
          match rim4_go(a, Cache(Nil), box(a, whole(x), whole(z), 40), 0, 0, 0) do
            (c2, b2, _) -> rims_go(a, rest, cols + c2, bad + b2)
          end
        end
    end
  end

  -- Sea pockets: land columns standing over the sea but within A (12 m) of
  -- it, along the coast east of the origin: (columns checked, sea-water or
  -- air voxels from 10 m under the sea line up to it)
  pfn coast_go(a : Strata.Atlas.Atlas, ca : Cache, cx : Int, cz : Int, hs : NativeF32Arr, c : Int, cols : Int, bad : Int) : (Int, Int, Cache) do
    if c >= 1024 do (cols, bad, ca)
    else
      let x = cx * 32 + c % 32
      let z = cz * 32 + c / 32
      let h = NativeArray.get_f32(hs, c)
      let col = Vw.island_column(a, x, z, 7, 1.0)
      let ok = if h < 41.5 do false else if h > 51.5 do false else col_lake(col) + col_river(col) == 0 end end
      if !ok do coast_go(a, ca, cx, cz, hs, c + 1, cols, bad)
      else
        match soft_count(a, ca, x, z, 30, 40, 0) do
          (n, ca2) -> coast_go(a, ca2, cx, cz, hs, c + 1, cols + 1, bad + n)
        end
      end
    end
  end
  pfn coasts_go(a : Strata.Atlas.Atlas, k : Int, cols : Int, bad : Int) : (Int, Int) do
    if k >= 40 do (cols, bad)
    else
      let cx = k % 20 + 5
      let cz = 2 * (k / 20) - 1
      match coast_go(a, Cache(Nil), cx, cz, Vw.relaxed_heights(a, 1.0, cx * 32, cz * 32, 7), 0, 0, 0) do
        (c2, b2, _) -> coasts_go(a, k + 1, cols + c2, bad + b2)
      end
    end
  end

  -- Early-outs: the decision from the atlas against full generation. Keys:
  -- 300 drawn from the island's box (chunk x and z -32..31, y 0..5), and for
  -- 30 drawn columns the chunks one under and one over the surface chunk.
  -- (keys checked, declared uniform but not so in full, missed: uniform in full but not declared)
  -- Full generation carries the viewer's trees and ruins, so the room left for them is checked too.
  pfn early_check(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, cx : Int, cy : Int, cz : Int) : (Int, Int) do
    let e = Vw.island_early(a, 1.0, cx, cy, cz)
    let u = Chl2.uniform_id(Vw.island_full_chunk(a, d, 1.0, cx, cy, cz, 7))
    let bad = if e < 0 do 0 else if u == e do 0 else 1 end end
    let missed = if e >= 0 do 0 else if u == 0 || u == 1 do 1 else 0 end end
    (bad, missed)
  end
  pfn early_go(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, k : Int, n : Int, bad : Int, missed : Int) : (Int, Int, Int) do
    if k >= 390 do (n, bad, missed)
    else
      let h = if k < 300 do Strata.Seed.cell(7, 77, k, 0, 0) else Strata.Seed.cell(7, 78, (k - 300) / 3, 0, 0) end
      let cx = int_abs(h) % 64 - 32
      let cz = int_abs(h / 64) % 64 - 32
      let key = if k < 300 do (cx, int_abs(h / 4096) % 6, cz)
        else
          let g = col_h(Vw.island_column(a, cx * 32 + 16, cz * 32 + 16, 7, 1.0))
          (cx, Cl2.chunk_of(g) + (k - 300) % 3 - 1, cz)
        end
      match key do
        (x, y, z) ->
          match early_check(a, d, x, y, z) do
            (b, m) -> early_go(a, d, k + 1, n + 1, bad + b, missed + m)
          end
      end
    end
  end

  -- ── Levels ─────────────────────────────────────────────────────────────
  -- ground: not air, water, lake water, tall grass or a post
  pfn ground(id : Int) : Bool do
    if id <= 0 do false else if id == 5 do false else if id == 11 || id == 12 do false else id < Vw.lake_base() end end end
  end
  -- the coarsening of a level-1 key's eight children: whether any of the 2 x 2 x 2 fine voxels under each coarse voxel is ground (flat index)
  pfn coarse_go(cs : List(Strata.Chunk.Chunk), out : NativeIntArr, i : Int) : NativeIntArr do
    if i >= 32768 do out
    else
      let x = i % 32
      let z = (i / 32) % 32
      let y = i / 1024
      -- Coord.children's order: x fastest, then y, then z
      let c = List.nth(cs, (x / 16) + 2 * (y / 16) + 4 * (z / 16))
      let fx = (2 * x) % 32
      let fy = (2 * y) % 32
      let fz = (2 * z) % 32
      let any = List.any(List.range(0, 8), fn t -> ground(Chl2.get_or(c, fx + t % 2, fy + (t / 2) % 2, fz + t / 4, 0)))
      coarse_go(cs, NativeArray.set_int(out, i, if any do 1 else 0 end), i + 1)
    end
  end
  -- ground in the coarse chunk at (x, y, z) or one of its 26 neighbours inside it
  pfn near_ground(c : Strata.Chunk.Chunk, x : Int, y : Int, z : Int, t : Int) : Bool do
    if t >= 27 do false
    else if ground(Chl2.get_or(c, x + t % 3 - 1, y + t / 9 - 1, z + (t / 3) % 3 - 1, 0)) do true
    else near_ground(c, x, y, z, t + 1) end end
  end
  -- the chunk coordinate and the local of v - 1, v or v + 1 (d = -1..1) across a chunk border
  pfn across(v : Int, d : Int) : (Int, Int) do if v + d < 0 do (-1, 31) else if v + d > 31 do (1, 0) else (0, v + d) end end end
  -- as near_ground, looking into the neighbouring chunks (generated) where a neighbour lies outside
  pfn near_ground_out(g : Strata.Terrain.Gen, key : Strata.Coord.Key, c : Strata.Chunk.Chunk, x : Int, y : Int, z : Int, t : Int) : Bool do
    if t >= 27 do false
    else
      match (across(x, t % 3 - 1), across(y, t / 9 - 1), across(z, (t / 3) % 3 - 1)) do
        ((ox, lx), (oy, ly), (oz, lz)) ->
          let ch = if ox == 0 && oy == 0 && oz == 0 do c else Strata.Terrain.run(g, Cl2.offset(key, ox, oy, oz), 7) end
          if ground(Chl2.get_or(ch, lx, ly, lz, 0)) do true else near_ground_out(g, key, c, x, y, z, t + 1) end
      end
    end
  end
  -- (coarsened ground voxels, those with no coarse ground within one voxel)
  pfn contain_go(g : Strata.Terrain.Gen, key : Strata.Coord.Key, c : Strata.Chunk.Chunk, fine : NativeIntArr, i : Int, n : Int, miss : Int) : (Int, Int) do
    if i >= 32768 do (n, miss)
    else if NativeArray.get_int(fine, i) == 0 do contain_go(g, key, c, fine, i + 1, n, miss)
    else if near_ground(c, i % 32, i / 1024, (i / 32) % 32, 0) do contain_go(g, key, c, fine, i + 1, n + 1, miss)
    else if near_ground_out(g, key, c, i % 32, i / 1024, (i / 32) % 32, 0) do contain_go(g, key, c, fine, i + 1, n + 1, miss)
    else contain_go(g, key, c, fine, i + 1, n + 1, miss + 1) end end end end
  end
  -- 10 level-1 keys at the ground, drawn from the island's middle: (coarsened ground voxels, those missed, the most missed in one key)
  pfn levels_go(a : Strata.Atlas.Atlas, g : Strata.Terrain.Gen, k : Int, n : Int, miss : Int, worst : Int) : (Int, Int, Int) do
    if k >= 10 do (n, miss, worst)
    else
      let h = Strata.Seed.cell(7, 79, k, 0, 0)
      let cx = int_abs(h) % 12 - 6
      let cz = int_abs(h / 64) % 12 - 6
      let gy = col_h(Vw.island_column(a, cx * 64 + 32, cz * 64 + 32, 7, 1.0))
      let key = Cl2.parent(Cl2.key(2 * cx, Cl2.chunk_of(gy), 2 * cz))
      let coarse = Strata.Terrain.run(g, key, 7)
      let fine = coarse_go(List.map(Cl2.children(key), fn ck -> Strata.Terrain.run(g, ck, 7)), NativeArray.make_int(32768, 0), 0)
      match contain_go(g, key, coarse, fine, 0, 0, 0) do
        (cnt, m) -> levels_go(a, g, k + 1, n + cnt, miss + m, if m > worst do m else worst end)
      end
    end
  end


  -- ── Coarse trees ───────────────────────────────────────────────────────
  pfn int_pow2(l : Int) : Int do if l <= 0 do 1 else 2 * int_pow2(l - 1) end end
  pfn fdv(v : Int, d : Int) : Int do if v >= 0 do v / d else 0 - ((d - 1 - v) / d) end end
  -- two instances in the same place with the same variant and turn
  pfn same_tree(x : Strata.Populate.PopInstance, y : Strata.Populate.PopInstance) : Bool do
    if Strata.Populate.i_xm(x) != Strata.Populate.i_xm(y) do false
    else if Strata.Populate.i_zm(x) != Strata.Populate.i_zm(y) do false
    else if Strata.Populate.i_variant(x) != Strata.Populate.i_variant(y) do false
    else Strata.Populate.i_rot(x) == Strata.Populate.i_rot(y) end end end
  end
  describe "Viewer lakes" do
    test "a column inside an atlas lake holds lake water to the lake level over sand" do
      let a = atlas()
      match wet_lake(Strata.Atlas.lakes(a)) do
        (x, z, lv) ->
          Test.assert_true(lv >= 0.0, "the atlas has a lake")
          let wx = whole(x)
          let wz = whole(z)
          let line = whole(lv)
          match Vw.island_column(a, wx, wz, 7, 1.0) do
            (h, ln, river) ->
              Test.assert_eq_int(ln, line, "the column's water line is the lake level")
              Test.assert_eq_int(river, 0, "and no river")
              Test.assert_true(h < line, "its bed is under the water")
              Test.assert_eq_int(island_block(a, wx, line, wz), Vw.lake_base() + 7, "full lake water at the level")
              Test.assert_eq_int(island_block(a, wx, h + 1, wz), Vw.lake_base() + 7, "and just over the bed")
              Test.assert_eq_int(island_block(a, wx, line + 1, wz), 0, "air over it")
              Test.assert_eq_int(island_block(a, wx, h, wz), 4, "a sandy bed")
          end
      end
    end
    test "a column on a river is sink water up to the atlas height" do
      let a = atlas()
      match river_point(a, Strata.Atlas.rivers(a), 45.0, 2.0) do
        (x, z, w) ->
          Test.assert_true(w >= 2.0, "the atlas has a river over 45 m")
          let wx = whole(x)
          let wz = whole(z)
          let top = whole(Strata.Atlas.height_at(a, int_to_float(wx), int_to_float(wz)))
          match Vw.island_column(a, wx, wz, 7, 1.0) do
            (h, _, line) ->
              Test.assert_eq_int(line, top, "the water line is the atlas height")
              Test.assert_true(h < line, "the channel is cut below it")
              Test.assert_eq_int(island_block(a, wx, top, wz), 5, "sink water at the surface")
              Test.assert_eq_int(island_block(a, wx, h + 1, wz), 5, "and down to the bed")
              Test.assert_eq_int(island_block(a, wx, top + 1, wz), 0, "air over it")
          end
      end
    end
    test "2 m from a river's bank the detail is under 1 m, and far from rivers it is not" do
      let a = atlas()
      -- damp there is 2 / (2 w), so the 6 m of detail is under 1 m only for rivers over 6 m wide
      -- (controller ruling): a narrower river of width w gets up to 6 / w m 2 m from its bank
      match river_point(a, Strata.Atlas.rivers(a), 40.0, 6.5) do
        (x, z, w) ->
          Test.assert_true(w >= 6.5, "the atlas has a river over 6.5 m wide")
          let xm = x +. 0.5 *. w +. 2.0
          Test.assert_true(Math.abs(Vw.island_height_m(a, xm, z, 7) -. Strata.Atlas.height_at(a, xm, z)) < 1.0, "under 1 m on one bank")
          let xn = x -. 0.5 *. w -. 2.0
          Test.assert_true(Math.abs(Vw.island_height_m(a, xn, z, 7) -. Strata.Atlas.height_at(a, xn, z)) < 1.0, "and on the other")
      end
      match far_go(a, 0, 0, 0.0) do
        (n, most) ->
          Test.assert_true(n >= 10, "at least 10 land samples 20 m from any river and off the lakes")
          Test.assert_true(most > 1.0, "on one of them the detail passes 1 m")
      end
    end
    test "land within 3 m of a lake stands a voxel over its water line" do
      let a = atlas()
      match wet_lake(Strata.Atlas.lakes(a)) do
        (x, z, _) ->
          match rim_go(box(a, whole(x), whole(z), 60), 0, 0, 0) do
            (bad, seen) ->
              Test.assert_true(seen > 50, "some land columns lie within 3 m of the lake")
              Test.assert_eq_int(bad, 0, "none stands under the water line + 1")
          end
      end
    end
    test "beside a river the detail only raises the ground" do
      let a = atlas()
      match bank_go(a, all_points(Strata.Atlas.rivers(a), Nil), 0, 0) do
        (seen, bad) ->
          Test.assert_true(seen >= 50, "50 bank columns within 2 m of a channel")
          Test.assert_eq_int(bad, 0, "none under the atlas height")
      end
    end
    test "off a river sample the channel's water line is the nearest sample's height, not the bilinear one" do
      let a = atlas()
      match off_sample(a, all_points(Strata.Atlas.rivers(a), Nil)) do
        None -> Test.fail("no channel column 2 m off a river sample where the bilinear height differs by a voxel at seed 7")
        Some((x, z)) ->
          let line = col_river(Vw.island_column(a, whole(x) + 2, whole(z), 7, 1.0))
          Test.assert_eq_int(line, whole(Strata.Atlas.height_at(a, x, z)), "the sample's height")
          Test.assert_true(line != whole(Strata.Atlas.height_at(a, x +. 2.0, z)), "not the bilinear height there")
      end
    end
    test "an island chunk generated twice is identical" do
      let a = atlas()
      match wet_lake(Strata.Atlas.lakes(a)) do
        (x, z, lv) ->
          let kx = Cl2.chunk_of(whole(x))
          let kz = Cl2.chunk_of(whole(z))
          let ky = Cl2.chunk_of(whole(lv))
          Test.assert_true(same_go(Vw.island_terrain(a, 1.0, kx, ky, kz, 7), Vw.island_terrain(a, 1.0, kx, ky, kz, 7), 0), "the lake's chunk")
          Test.assert_true(same_go(Vw.island_terrain(a, 1.0, 0, 1, 0, 7), Vw.island_terrain(a, 1.0, 0, 1, 0, 7), 0), "the origin's")
      end
    end
    test "no cave voxel within 4 m under a lake bed, and caves elsewhere" do
      let a = island()
      match under_lakes(a, Strata.Atlas.lakes(a), 0, 0, Nil) do
        (cols, bad, seen) ->
          Authority.must(println("lakes: " ++ int_to_string(cols) ++ " lake columns in " ++ int_to_string(List.length(seen)) ++ " chunks checked"))
          Test.assert_true(List.length(seen) >= 20, "20 chunks or more under the lakes")
          Test.assert_eq_int(bad, 0, "no air or water from 4 m under a lake bed to the bed")
      end
      Test.assert_true(caves_go(a, 0, 0) > 0, "the island has caves: air 32 m under the ground")
    end
    test "no solid voxel floats: every one is reached from the ground below (round the test lake and the cave scene)" do
      let a = island()
      match Vw.scene_lake(StrataViewer.Island(a), 7) do
        (cx, cz, rad, _, _, _, _) ->
          Test.assert_true(rad > 0, "the island has a test lake")
          let n = float_go(a, Cl2.chunk_of(cx), Cl2.chunk_of(cz), false, 0, 0)
          Authority.must(println("connectivity: " ++ int_to_string(n) ++ " solid voxels unreached in 16 chunks round the test lake"))
          Test.assert_eq_int(n, 0, "none unreached round the lake")
          -- the cave scene looks at (44, 78), chunk (1, 2), on a hill of 80 to 120 m
          let m = float_go(a, 1, 2, true, 0, 0)
          Authority.must(println("connectivity: " ++ int_to_string(m) ++ " solid voxels unreached in 18 chunks round the cave scene"))
          Test.assert_eq_int(m, 0, "none unreached round the cave scene")
      end
    end
    test "chunks agree on the relaxed heights along their seams" do
      match seams_go(island(), 0, 0, 0.0) do
        (n, worst) ->
          Authority.must(println("seams: " ++ int_to_string(n) ++ " steep chunk pairs, worst " ++ float_to_string(worst) ++ " m"))
          Test.assert_eq_int(n, 20, "20 steep chunk pairs")
          Test.assert_true(worst <= 0.01, "within 0.01 m of a patch centred on the border")
      end
    end
    test "a tunnel crosses the cave scene's chunks: a run over 8 m of tunnel air, 6 m or more under the ground" do
      let a = island()
      let best = tunnel_go(a, Cache(Nil), area_h(a, NativeArray.make_f32(9216, 0.0), 0), 0, 0, 42, 0)
      Authority.must(println("tunnels: longest run of tunnel air " ++ int_to_string(best) ++ " m"))
      Test.assert_true(best > 8, "a run longer than 8 m")
    end
    test "land within 4 m of a lake column holds no air or water from 4 m under the bed to the line" do
      let a = island()
      match rims_go(a, Strata.Atlas.lakes(a), 0, 0) do
        (cols, bad) ->
          Authority.must(println("lake rims: " ++ int_to_string(cols) ++ " land columns within 4 m of a lake checked"))
          Test.assert_true(cols > 100, "over 100 such columns")
          Test.assert_eq_int(bad, 0, "no air or water in them")
      end
    end
    test "coastal land within 12 m of the sea holds no sea pocket" do
      match coasts_go(island(), 0, 0, 0) do
        (cols, bad) ->
          Authority.must(println("coast: " ++ int_to_string(cols) ++ " land columns 1.5 to 11.5 m over the sea checked"))
          Test.assert_true(cols > 100, "over 100 such columns")
          Test.assert_eq_int(bad, 0, "no sea water or air from 30 m to the sea line under them")
      end
    end
    test "the early-out agrees with full generation on 390 chunk keys" do
      match early_go(island(), Vw.decor(island(), 1.0, 7), 0, 0, 0, 0) do
        (n, bad, missed) ->
          Authority.must(println("early-outs: " ++ int_to_string(n) ++ " keys, " ++ int_to_string(bad) ++ " declared uniform but not, " ++ int_to_string(missed) ++ " uniform in full but generated"))
          Test.assert_eq_int(n, 390, "390 keys")
          Test.assert_eq_int(bad, 0, "every chunk declared uniform is that uniform chunk in full")
      end
    end
    test "a chunk 200 m over the ground is uniform air, and one 200 m under it uniform stone" do
      let a = island()
      let g = col_h(Vw.island_column(a, 16, 16, 7, 1.0))
      let up = Vw.island_terrain(a, 1.0, 0, Cl2.chunk_of(g + 200), 0, 7)
      let down = Vw.island_terrain(a, 1.0, 0, Cl2.chunk_of(g - 200), 0, 7)
      Test.assert_eq_int(Chl2.uniform_id(up), 0, "uniform(0)")
      Test.assert_eq_int(Chl2.uniform_id(down), 1, "uniform(1)")
    end
    test "a chunk generated alone equals one generated after its neighbours" do
      let a = island()
      let g = col_h(Vw.island_column(a, 40, -70, 7, 1.0))
      let cy = Cl2.chunk_of(g)
      let alone = Vw.island_terrain(a, 1.0, 1, cy, -3, 7)
      let n1 = Vw.island_terrain(a, 1.0, 0, cy, -3, 7)
      let n2 = Vw.island_terrain(a, 1.0, 2, cy, -3, 7)
      let n3 = Vw.island_terrain(a, 1.0, 1, cy + 1, -3, 7)
      let n4 = Vw.island_terrain(a, 1.0, 1, cy, -2, 7)
      let after = Vw.island_terrain(a, 1.0, 1, cy, -3, 7)
      Test.assert_true(Chl2.form(n1) + Chl2.form(n2) + Chl2.form(n3) + Chl2.form(n4) >= 0, "the neighbours were made")
      Test.assert_true(full_same(alone, after, 0), "every voxel the same")
    end
    test "the sea is not a fluid, and lake water is" do
      Test.assert_false(Bl2.is_fluid(Vw.registry(), 5), "the sea never moves")
      Test.assert_true(Bl2.is_fluid(Vw.registry(), Vw.lake_base()), "lake water does")
      Test.assert_eq_int(Bl2.fill(Vw.registry(), Vw.lake_base() + 7), 8, "and its last state is a full voxel")
    end
    test "a level-1 chunk holds the coarsening of its eight children within one voxel, on 10 keys at the ground" do
      let a = island()
      match levels_go(a, Vw.island_gen(a, Vw.bare_decor(a), 1.0), 0, 0, 0, 0) do
        (n, miss, worst) ->
          Authority.must(println("levels: " ++ int_to_string(n) ++ " coarsened ground voxels over 10 level-1 keys, " ++ int_to_string(miss) ++ " with no level-1 ground within one voxel (worst key " ++ int_to_string(worst) ++ ")"))
          Test.assert_true(n > 10000, "the keys hold ground")
          Test.assert_eq_int(miss, 0, "every coarsened ground voxel has level-1 ground within one voxel")
      end
    end
    test "a level-3 key beyond the atlas is sea: water to the sea line, ground under it, air over it" do
      let a = island()
      let c = Strata.Terrain.run(Vw.island_gen(a, Vw.bare_decor(a), 1.0), Cl2.key_at(6, 0, -7, 3), 7)
      -- 8 m voxels: level 0's sea (1 m voxels, the sea at 40 m) tops out at 41 m, so level 3's tops out at
      -- 40 m, voxel 4, not over it; the floor at 20 m is voxel 2
      Test.assert_true(List.all(List.range(0, 1024), fn t -> Chl2.get_or(c, t % 32, 4, t / 32, -1) == 5), "water to the sea line in every column")
      Test.assert_true(List.all(List.range(0, 1024), fn t -> Chl2.get_or(c, t % 32, 5, t / 32, -1) == 0), "air over it")
      Test.assert_true(List.all(List.range(0, 1024), fn t -> ground(Chl2.get_or(c, t % 32, 0, t / 32, -1))), "ground at the bottom")
    end
  
    test "a coarse level's water never stands over level 0's, and keeps a voxel of water" do
      -- level 0 at 1 m: the sea at 40 m fills voxel 40, its top at 41 m
      Test.assert_eq_int(Vw.water_line(40.0, 1.0, 1.0), 40, "level 0 is as before")
      Test.assert_true(List.all(List.range(1, 6), fn l ->
        let sc = int_to_float(int_pow2(l))
        let top = int_to_float(Vw.water_line(40.0, sc, 1.0) + 1) *. sc
        if top > 41.0 do false else top > 41.0 -. sc end), "at levels 1 to 5 the water's top is within one coarse voxel under 41 m")
      let a = island()
      let c = Strata.Terrain.run(Vw.island_gen(a, Vw.bare_decor(a), 1.0), Cl2.key_at(3, 0, -4, 4), 7)
      -- 16 m voxels: the water's top at 32 m, voxel 1; the bed kept under it
      Test.assert_true(List.all(List.range(0, 1024), fn t -> Chl2.get_or(c, t % 32, 1, t / 32, -1) == 5), "level 4's sea has a voxel of water")
    end
    test "the level-1 chunk over the forest holds coarse trees, and its trees are level 0's: the same place, variant and turn" do
      let a = island()
      let d = Vw.decor(a, 1.0, 7)
      let g = Vw.island_gen(a, d, 1.0)
      -- the level-1 column over the forest (144, 80), at the chunk holding its ground
      let gy = col_h(Vw.island_column(a, 144, 80, 7, 1.0))
      let k = Cl2.key_at(2, fdv(Cl2.chunk_of(gy), 2), 1, 1)
      let c1 = Strata.Terrain.run(g, k, 7)
      -- the trees standing in the level-1 chunk column, and those level 0 stands over its 2 x 2 chunk columns
      let coarse = List.filter(Vw.island_level_trees(a, d, 1.0, 1, Cl2.kx(k), Cl2.kz(k), 7), fn e -> match e do (_, _, wx, _, wz) -> if fdv(wx, 32) != Cl2.kx(k) do false else fdv(wz, 32) == Cl2.kz(k) end end)
      let fine = List.flat_map(List.range(0, 4), fn q -> Vw.island_chunk_trees(a, d, 1.0, 2 * Cl2.kx(k) + q % 2, 2 * Cl2.kz(k) + q / 2, 7))
      let same = List.filter(coarse, fn e -> match e do (_, x, _, _, _) -> List.any(fine, fn f -> match f do (_, y, _, _, _) -> same_tree(x, y) end) end)
      let wood = List.fold_left(List.range(0, 32768), 0, fn (n, i) -> if Chl2.get_idx(c1, Chl2.index(i)) == 7 do n + 1 else n end)
      Authority.must(println("coarse trees: " ++ int_to_string(List.length(coarse)) ++ " stand in the forest's level-1 chunk column, " ++ int_to_string(List.length(same)) ++ " of them as level 0 stands them; " ++ int_to_string(wood) ++ " coarse wood voxels in its chunk"))
      Test.assert_true(List.length(coarse) > 5, "trees stand in the forest's level-1 chunk column")
      Test.assert_true(wood > 0, "and its chunk holds their coarse wood")
      Test.assert_true(List.length(same) * 10 >= List.length(coarse) * 9, "nine in ten or more of them are level 0's (ground fields are read at the coarse column: Task 7's gap)")
    end
  end
end
