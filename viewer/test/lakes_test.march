-- The viewer's lakes: terrain stays a pure function, a lake's rim holds its
-- water, and the sea is not a fluid. Then the island read from an atlas:
-- lakes, rivers, the damped detail.
mod StrataViewer.Test.Lakes do
  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.FileRead    -- the viewer lists viewer/sounds/ (charged to every test module, as in GAPS S3)
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem
  needs IO.Clock

  alias StrataViewer as Vw
  alias Strata.World as Wl2
  alias Strata.Coord as Cl2
  alias Strata.Chunk as Chl2
  alias Strata.Blocks as Bl2

  pfn same_go(a : Strata.Chunk.Chunk, b : Strata.Chunk.Chunk, i : Int) : Bool do
    if i >= 32768 do true else if Chl2.get_or(a, i % 32, i / 1024, (i / 32) % 32, -1) != Chl2.get_or(b, i % 32, i / 1024, (i / 32) % 32, -1) do false else same_go(a, b, i + 97) end end
  end

  -- load the chunks covering x0..x1, z0..z1 (chunk coordinates) at heights cy 0..2
  pfn load_go(w : Strata.World.World, x0 : Int, x1 : Int, z0 : Int, z1 : Int, x : Int, y : Int, z : Int) : Strata.World.World do
    if y > 2 do w
    else if z > z1 do load_go(w, x0, x1, z0, z1, x0, y + 1, z0)
    else if x > x1 do load_go(w, x0, x1, z0, z1, x0, y, z + 1)
    else load_go(Wl2.insert(w, Cl2.key(x, y, z), Vw.terrain(1.0, x, y, z, 7)), x0, x1, z0, z1, x + 1, y, z) end end end
  end

  -- every lake-water cell at the water line has no air beside it; the count of water cells seen, or -1 at the first leak
  pfn held(w : Strata.World.World, cx : Int, cz : Int, rad : Int, line : Int, i : Int, n : Int, seen : Int) : Int do
    if i >= n * n do seen
    else
      let x = cx - rad - 4 + i % n
      let z = cz - rad - 4 + i / n
      if !Bl2.is_fluid(Vw.registry(), Wl2.get_block(w, x, line, z)) do held(w, cx, cz, rad, line, i + 1, n, seen)
      else if Wl2.get_block(w, x - 1, line, z) == 0 || Wl2.get_block(w, x + 1, line, z) == 0 || Wl2.get_block(w, x, line, z - 1) == 0 || Wl2.get_block(w, x, line, z + 1) == 0 do -1
      else held(w, cx, cz, rad, line, i + 1, n, seen + 1) end end
    end
  end


  -- ── The island ─────────────────────────────────────────────────────────
  -- the demo-sized atlas (256 x 256, 4 m): a second to build, with lakes and rivers
  pfn atlas() : Strata.Atlas.Atlas do Strata.Atlas.build(Strata.Atlas.def(256, 4.0, 400.0, 120.0, 5, 40.0), 7) end

  pfn whole(m : Float) : Int do float_to_int(Math.floor(m)) end

  -- the block at a world position, from the island chunk holding it
  pfn island_block(a : Strata.Atlas.Atlas, x : Int, y : Int, z : Int) : Int do
    let kx = Cl2.chunk_of(x)
    let ky = Cl2.chunk_of(y)
    let kz = Cl2.chunk_of(z)
    Chl2.get_or(Vw.island_terrain(a, 1.0, kx, ky, kz, 7), x - 32 * kx, y - 32 * ky, z - 32 * kz, -1)
  end

  -- the first lake that holds water
  pfn wet_lake(ls : List((Float, Float, Float))) : (Float, Float, Float) do
    match ls do
      Nil -> (0.0, 0.0, 0.0 -. 1.0)
      Cons((x, z, lv), rest) -> if lv >= 0.0 do (x, z, lv) else wet_lake(rest) end
    end
  end

  -- the first river point standing over [above] metres and at least [wide] metres wide
  pfn river_point(a : Strata.Atlas.Atlas, rs : List(List((Float, Float, Float))), above : Float, wide : Float) : (Float, Float, Float) do
    match rs do
      Nil -> (0.0, 0.0, 0.0)
      Cons(r, rest) ->
        match List.find(r, fn pt -> match pt do (x, z, w) -> if w < wide do false else Strata.Atlas.height_at(a, x, z) > above end end) do
          Some(p) -> p
          None -> river_point(a, rest, above, wide)
        end
    end
  end

  pfn col_h(c : (Int, Int, Int)) : Int do match c do (h, _, _) -> h end end
  pfn col_lake(c : (Int, Int, Int)) : Int do match c do (_, l, _) -> l end end
  pfn col_river(c : (Int, Int, Int)) : Int do match c do (_, _, r) -> r end end

  -- the island columns of the (2 half + 1)^2 box about (x0, z0), as ground, lake line and river line arrays
  type LakeBox = LakeBox(Int, Int, Int, NativeIntArr, NativeIntArr, NativeIntArr)
  pfn box_go(a : Strata.Atlas.Atlas, x0 : Int, z0 : Int, half : Int, k : Int, hs : NativeIntArr, ls : NativeIntArr, rs : NativeIntArr) : LakeBox do
    let side = 2 * half + 1
    if k >= side * side do LakeBox(x0, z0, half, hs, ls, rs)
    else
      let c = Vw.island_column(a, x0 - half + k % side, z0 - half + k / side, 7, 1.0)
      box_go(a, x0, z0, half, k + 1, NativeArray.set_int(hs, k, col_h(c)), NativeArray.set_int(ls, k, col_lake(c)), NativeArray.set_int(rs, k, col_river(c)))
    end
  end
  pfn box(a : Strata.Atlas.Atlas, x0 : Int, z0 : Int, half : Int) : LakeBox do
    let n = (2 * half + 1) * (2 * half + 1)
    box_go(a, x0, z0, half, 0, NativeArray.make_int(n, 0), NativeArray.make_int(n, 0), NativeArray.make_int(n, 0))
  end

  -- a lake column within 3 m of box cell k: its lake line, or 0
  pfn lake_near(b : LakeBox, k : Int, t : Int) : Int do
    if t >= 49 do 0
    else
      match b do
        LakeBox(_, _, half, _, ls, _) ->
          let side = 2 * half + 1
          let dx = t % 7 - 3
          let dz = t / 7 - 3
          let x = k % side + dx
          let z = k / side + dz
          let l = if x < 0 || z < 0 || x >= side || z >= side || dx * dx + dz * dz > 9 do 0 else NativeArray.get_int(ls, x + side * z) end
          if l > 0 do l else lake_near(b, k, t + 1) end
      end
    end
  end

  -- land columns (no lake, no river) within 3 m of a lake column standing under its line + 1: their count, and how many were checked
  pfn rim_go(b : LakeBox, k : Int, bad : Int, seen : Int) : (Int, Int) do
    match b do
      LakeBox(_, _, half, hs, ls, rs) ->
        let side = 2 * half + 1
        if k >= side * side do (bad, seen)
        else if NativeArray.get_int(ls, k) > 0 || NativeArray.get_int(rs, k) > 0 do rim_go(b, k + 1, bad, seen)
        else
          let l = lake_near(b, k, 0)
          if l == 0 do rim_go(b, k + 1, bad, seen)
          else rim_go(b, k + 1, if NativeArray.get_int(hs, k) < l + 1 do bad + 1 else bad end, seen + 1) end
        end end
    end
  end

  -- bank columns: along +x from each river point, the first column out of the channel and the one past it
  -- (both within 2 m of it); (columns checked, those whose ground stands under the atlas height)
  pfn bank_go(a : Strata.Atlas.Atlas, pts : List((Float, Float, Float)), seen : Int, bad : Int) : (Int, Int) do
    match pts do
      Nil -> (seen, bad)
      Cons((x, z, _), rest) ->
        if seen >= 50 do (seen, bad)
        else
          let wz = whole(z)
          let e = bank_edge(a, whole(x), wz, 0)
          if e < 0 do bank_go(a, rest, seen, bad)
          else
            let b1 = if below_atlas(a, e, wz) do 1 else 0 end
            let b2 = if below_atlas(a, e + 1, wz) do 1 else 0 end
            bank_go(a, rest, seen + 2, bad + b1 + b2)
          end
        end
    end
  end
  -- the first column at or east of wx (within 12 m) that is neither channel nor lake; -1 if none
  pfn bank_edge(a : Strata.Atlas.Atlas, wx : Int, wz : Int, t : Int) : Int do
    if t > 12 do -1
    else
      let c = Vw.island_column(a, wx + t, wz, 7, 1.0)
      if col_lake(c) > 0 do -1
      else if col_river(c) == 0 do wx + t
      else bank_edge(a, wx, wz, t + 1) end end
    end
  end
  pfn below_atlas(a : Strata.Atlas.Atlas, wx : Int, wz : Int) : Bool do
    let xm = int_to_float(wx)
    let zm = int_to_float(wz)
    Vw.island_height_m(a, xm, zm, 7) < Strata.Atlas.height_at(a, xm, zm)
  end
  pfn all_points(rs : List(List((Float, Float, Float))), acc : List((Float, Float, Float))) : List((Float, Float, Float)) do
    match rs do
      Nil -> acc
      Cons(r, rest) -> all_points(rest, List.append(acc, r))
    end
  end

  -- a river point whose column 2 m east is channel, the sample 4 m east is not river, and whose
  -- own (sample) height and the bilinear height 2 m east differ by a voxel or more: (x, z), or None
  pfn off_sample(a : Strata.Atlas.Atlas, pts : List((Float, Float, Float))) : Option((Float, Float)) do
    match pts do
      Nil -> None
      Cons((x, z, _), rest) ->
        let own = whole(Strata.Atlas.height_at(a, x, z))
        let mid = whole(Strata.Atlas.height_at(a, x +. 2.0, z))
        let lone = Strata.Atlas.river_width_at(a, x +. 4.0, z) == 0.0
        let ok = if !lone || own == mid do false else col_river(Vw.island_column(a, whole(x) + 2, whole(z), 7, 1.0)) > 0 end
        if ok do Some((x, z)) else off_sample(a, rest) end
    end
  end

  -- no river sample within 20 m (5 samples) of sample (i, j)
  pfn dry_go(a : Strata.Atlas.Atlas, i : Int, j : Int, t : Int) : Bool do
    if t >= 121 do true
    else if Strata.Atlas.river_width_ij(a, i + t % 11 - 5, j + t / 11 - 5) > 0.0 do false
    else dry_go(a, i, j, t + 1) end end
  end
  -- over samples 16 m apart in the 400 m about the origin, those 20 m from any river and off the lakes:
  -- (how many, the largest |detail| among them)
  pfn far_go(a : Strata.Atlas.Atlas, k : Int, n : Int, best : Float) : (Int, Float) do
    if k >= 625 do (n, best)
    else
      let i = 128 + 4 * (k % 25 - 12)
      let j = 128 + 4 * (k / 25 - 12)
      let xm = int_to_float(i - 128) *. 4.0
      let zm = int_to_float(j - 128) *. 4.0
      let land = Strata.Atlas.height_at(a, xm, zm) > 41.0
      let ok = if !land do false else if Strata.Atlas.lake_at(a, xm, zm) >= 0.0 do false else dry_go(a, i, j, 0) end end
      if !ok do far_go(a, k + 1, n, best)
      else
        let d = Math.abs(Vw.island_height_m(a, xm, zm, 7) -. Strata.Atlas.height_at(a, xm, zm))
        far_go(a, k + 1, n + 1, if d > best do d else best end)
      end
    end
  end


  describe "Viewer lakes" do
    test "terrain with lakes is still a pure function" do
      match Vw.test_lake(7) do
        (cx, cz, rad, line, _) ->
          Test.assert_true(rad > 0, "seed 7 has a lake near the origin")
          let kx = Cl2.chunk_of(cx)
          let kz = Cl2.chunk_of(cz)
          Test.assert_true(same_go(Vw.terrain(1.0, kx, Cl2.chunk_of(line), kz, 7), Vw.terrain(1.0, kx, Cl2.chunk_of(line), kz, 7), 0), "the same chunk twice")
      end
    end
    test "a lake's rim holds its water" do
      match Vw.test_lake(7) do
        (cx, cz, rad, line, _) ->
          let w = load_go(Wl2.new(Vw.registry(), Strata.Terrain.gen(fn (k, seed) -> Chl2.uniform(0)), 7, 1.0), Cl2.chunk_of(cx - rad - 5), Cl2.chunk_of(cx + rad + 5), Cl2.chunk_of(cz - rad - 5), Cl2.chunk_of(cz + rad + 5), Cl2.chunk_of(cx - rad - 5), 0, Cl2.chunk_of(cz - rad - 5))
          let n = held(w, cx, cz, rad, line, 0, 2 * rad + 9, 0)
          Test.assert_true(n > 0, "the lake has water at its line, and none of it stands beside air")
          Test.assert_true(Bl2.is_fluid(Vw.registry(), Wl2.get_block(w, cx, line, cz)), "its middle is lake water")
          Test.assert_eq_int(Wl2.get_block(w, cx, line + 1, cz), 0, "with air over it")
      end
    end
    test "a column inside an atlas lake holds lake water to the lake level over sand" do
      let a = atlas()
      match wet_lake(Strata.Atlas.lakes(a)) do
        (x, z, lv) ->
          Test.assert_true(lv >= 0.0, "the atlas has a lake")
          let wx = whole(x)
          let wz = whole(z)
          let line = whole(lv)
          match Vw.island_column(a, wx, wz, 7, 1.0) do
            (h, ln, river) ->
              Test.assert_eq_int(ln, line, "the column's water line is the lake level")
              Test.assert_eq_int(river, 0, "and no river")
              Test.assert_true(h < line, "its bed is under the water")
              Test.assert_eq_int(island_block(a, wx, line, wz), Vw.lake_base() + 7, "full lake water at the level")
              Test.assert_eq_int(island_block(a, wx, h + 1, wz), Vw.lake_base() + 7, "and just over the bed")
              Test.assert_eq_int(island_block(a, wx, line + 1, wz), 0, "air over it")
              Test.assert_eq_int(island_block(a, wx, h, wz), 4, "a sandy bed")
          end
      end
    end
    test "a column on a river is sink water up to the atlas height" do
      let a = atlas()
      match river_point(a, Strata.Atlas.rivers(a), 45.0, 2.0) do
        (x, z, w) ->
          Test.assert_true(w >= 2.0, "the atlas has a river over 45 m")
          let wx = whole(x)
          let wz = whole(z)
          let top = whole(Strata.Atlas.height_at(a, int_to_float(wx), int_to_float(wz)))
          match Vw.island_column(a, wx, wz, 7, 1.0) do
            (h, _, line) ->
              Test.assert_eq_int(line, top, "the water line is the atlas height")
              Test.assert_true(h < line, "the channel is cut below it")
              Test.assert_eq_int(island_block(a, wx, top, wz), 5, "sink water at the surface")
              Test.assert_eq_int(island_block(a, wx, h + 1, wz), 5, "and down to the bed")
              Test.assert_eq_int(island_block(a, wx, top + 1, wz), 0, "air over it")
          end
      end
    end
    test "2 m from a river's bank the detail is under 1 m, and far from rivers it is not" do
      let a = atlas()
      -- damp there is 2 / (2 w), so the 6 m of detail is under 1 m only for rivers over 6 m wide
      -- (controller ruling): a narrower river of width w gets up to 6 / w m 2 m from its bank
      match river_point(a, Strata.Atlas.rivers(a), 40.0, 6.5) do
        (x, z, w) ->
          Test.assert_true(w >= 6.5, "the atlas has a river over 6.5 m wide")
          let xm = x +. 0.5 *. w +. 2.0
          Test.assert_true(Math.abs(Vw.island_height_m(a, xm, z, 7) -. Strata.Atlas.height_at(a, xm, z)) < 1.0, "under 1 m on one bank")
          let xn = x -. 0.5 *. w -. 2.0
          Test.assert_true(Math.abs(Vw.island_height_m(a, xn, z, 7) -. Strata.Atlas.height_at(a, xn, z)) < 1.0, "and on the other")
      end
      match far_go(a, 0, 0, 0.0) do
        (n, most) ->
          Test.assert_true(n >= 10, "at least 10 land samples 20 m from any river and off the lakes")
          Test.assert_true(most > 1.0, "on one of them the detail passes 1 m")
      end
    end
    test "land within 3 m of a lake stands a voxel over its water line" do
      let a = atlas()
      match wet_lake(Strata.Atlas.lakes(a)) do
        (x, z, _) ->
          match rim_go(box(a, whole(x), whole(z), 60), 0, 0, 0) do
            (bad, seen) ->
              Test.assert_true(seen > 50, "some land columns lie within 3 m of the lake")
              Test.assert_eq_int(bad, 0, "none stands under the water line + 1")
          end
      end
    end
    test "beside a river the detail only raises the ground" do
      let a = atlas()
      match bank_go(a, all_points(Strata.Atlas.rivers(a), Nil), 0, 0) do
        (seen, bad) ->
          Test.assert_true(seen >= 50, "50 bank columns within 2 m of a channel")
          Test.assert_eq_int(bad, 0, "none under the atlas height")
      end
    end
    test "off a river sample the channel's water line is the nearest sample's height, not the bilinear one" do
      let a = atlas()
      match off_sample(a, all_points(Strata.Atlas.rivers(a), Nil)) do
        None -> Test.fail("no channel column 2 m off a river sample where the bilinear height differs by a voxel at seed 7")
        Some((x, z)) ->
          let line = col_river(Vw.island_column(a, whole(x) + 2, whole(z), 7, 1.0))
          Test.assert_eq_int(line, whole(Strata.Atlas.height_at(a, x, z)), "the sample's height")
          Test.assert_true(line != whole(Strata.Atlas.height_at(a, x +. 2.0, z)), "not the bilinear height there")
      end
    end
    test "an island chunk generated twice is identical" do
      let a = atlas()
      match wet_lake(Strata.Atlas.lakes(a)) do
        (x, z, lv) ->
          let kx = Cl2.chunk_of(whole(x))
          let kz = Cl2.chunk_of(whole(z))
          let ky = Cl2.chunk_of(whole(lv))
          Test.assert_true(same_go(Vw.island_terrain(a, 1.0, kx, ky, kz, 7), Vw.island_terrain(a, 1.0, kx, ky, kz, 7), 0), "the lake's chunk")
          Test.assert_true(same_go(Vw.island_terrain(a, 1.0, 0, 1, 0, 7), Vw.island_terrain(a, 1.0, 0, 1, 0, 7), 0), "the origin's")
      end
    end
    test "the sea is not a fluid, and lake water is" do
      Test.assert_false(Bl2.is_fluid(Vw.registry(), 5), "the sea never moves")
      Test.assert_true(Bl2.is_fluid(Vw.registry(), Vw.lake_base()), "lake water does")
      Test.assert_eq_int(Bl2.fill(Vw.registry(), Vw.lake_base() + 7), 8, "and its last state is a full voxel")
    end
  end
end
