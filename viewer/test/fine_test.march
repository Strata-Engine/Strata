-- The 10 cm world's terrain: a pure function, with its tower, wall, cliff
-- and stream where StrataViewer.Fine says they are.
mod StrataViewer.Test.Fine do

  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.Process
  needs IO.Spawn
  import Test
  alias StrataViewer.Fine as Fi

  -- the block at world voxel (x, y, z), from the chunk the terrain makes for it
  pfn at(x : Int, y : Int, z : Int) : Int do
    let c = Fi.terrain(Strata.Coord.chunk_of(x), Strata.Coord.chunk_of(y), Strata.Coord.chunk_of(z), 7)
    Strata.Chunk.get_or(c, Strata.Coord.local_of(x), Strata.Coord.local_of(y), Strata.Coord.local_of(z), -1)
  end

  describe "Fine terrain" do
    test "is a pure function of the chunk and the seed" do
      Test.assert_true(Strata.Chunk.hash(Fi.terrain(1, 0, -2, 7)) == Strata.Chunk.hash(Fi.terrain(1, 0, -2, 7)), "the same chunk twice")
      Test.assert_true(Strata.Chunk.hash(Fi.terrain(0, -1, 0, 7)) == Strata.Chunk.hash(Fi.terrain(0, -1, 0, 7)), "and the ground")
    end

    test "the ground is solid below y 0 and open above" do
      Test.assert_true(at(5, -1, 5) != 0 && at(5, -20, 5) != 0, "solid below")
      Test.assert_eq_int(at(5, 3, 5), 0, "air above")
    end

    test "the tower stands where the module says, hollow" do
      match Fi.tower() do
        (x0, z0, side, tall) ->
          Test.assert_eq_int(at(x0, tall - 1, z0 + side / 2), Fi.stone(), "a wall voxel at the top")
          Test.assert_eq_int(at(x0 + side / 2, 5, z0 + side / 2), 0, "hollow inside")
          Test.assert_eq_int(at(x0 + side / 2, tall, z0 + side / 2), 0, "open above")
      end
    end

    test "the wall stands where the module says" do
      match Fi.wall() do
        (x0, z0, long, high, thick) ->
          Test.assert_eq_int(at(x0, 0, z0), Fi.stone(), "its foot")
          Test.assert_eq_int(at(x0 + long - 1, high - 1, z0 + thick - 1), Fi.stone(), "its far top corner")
          Test.assert_eq_int(at(x0 + long / 2, high, z0), 0, "nothing above it")
          Test.assert_eq_int(at(x0 + long / 2, high / 2, z0 + thick), 0, "nothing behind it")
      end
    end

    test "the cliff is at least 12 m high, with a 10 x 8 x 2 m face" do
      match Fi.cliff() do
        (x0, z0, long, high) ->
          Test.assert_true(high >= 120, "120 voxels or more")
          Test.assert_eq_int(at(x0 + long / 2, high - 1, z0 - 5), Fi.stone(), "stone at its top, behind the face")
          Test.assert_eq_int(at(x0 + long / 2, 40, z0 + 1), 0, "air in front of the face")
          Test.assert_true(long >= 100, "the face is at least 10 m wide")
      end
    end

    test "the stream is water in a channel 1 m wide" do
      match Fi.stream() do
        (x0, wide) ->
          Test.assert_eq_int(wide, 10, "1 m")
          Test.assert_true(at(x0 + 5, -2, 0) != 0 && at(x0 + 5, -2, 0) != Fi.stone(), "water in it")
          Test.assert_eq_int(at(x0 + 5, 0, 0), 0, "air over it")
      end
    end
  end
end
