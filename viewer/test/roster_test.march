-- Roster: the twelve characters in viewer/assets/characters load and differ.
mod StrataViewer.Test.Roster do

  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem
  import Test

  pfn ids() : List(String) do ["knight", "manatarms", "archer", "crossbowman", "norseman", "templar", "landsknecht", "ranger", "executioner", "friar", "squire", "lord"] end
  pfn dir() : String do if Authority.must(File.exists("assets/characters/knight.vox")) do "assets/characters/" else "viewer/assets/characters/" end end
  pfn load(id : String) : Strata.Character.Character do
    match Strata.Character.load(dir() ++ id ++ ".vox") do Ok(c) -> c | Err(e) -> panic(id ++ ": " ++ e) end
  end
  pfn rig_of(id : String) : Strata.Rig.Rig do
    let c = load(id)
    c.rig
  end
  pfn all() : List(Strata.Character.Character) do List.map(ids(), load) end
  pfn height(c : Strata.Character.Character) : Float do c.size.height end

  pfn filled_go(g : NativeU8Arr, i : Int, n : Int, acc : Int) : Int do if i >= n do acc else filled_go(g, i + 1, n, if NativeArray.get_u8(g, i) != 0 do acc + 1 else acc end) end end
  pfn filled(r : Strata.Rig.Rig, p : Int) : Int do
    let g = Strata.Rig.grid(r, p)
    filled_go(g, 0, NativeArray.length_u8(g), 0)
  end
  pfn total(r : Strata.Rig.Rig) : Int do List.fold_left(List.range(0, Strata.Rig.part_count(r)), 0, fn (a, p) -> a + filled(r, p)) end
  pfn skin_go(g : NativeU8Arr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc else skin_go(g, i + 1, n, if List.member([1, 17, 33, 49], NativeArray.get_u8(g, i)) do acc + 1 else acc end) end
  end

  pfn check_empty(r : Strata.Rig.Rig, par : NativeI32Arr, p : Int) : Unit do
    let hangs = p >= 2 && p <= 8 || p >= 15 && List.member([2, 3, 4, 5, 6, 7, 8], NativeArray.get_i32(par, p))
    if hangs do Test.assert_eq_int(filled(r, p), 0, "part " ++ int_to_string(p) ++ " empty") else () end
  end

  describe "Roster" do
    test "all twelve load" do
      Test.assert_eq_int(List.length(all()), 12, "twelve")
    end

    test "heights within 10% of each other, between 1.7 and 2.0 m" do
      let hs = List.map(all(), height)
      let lo = List.fold_left(hs, 100.0, fn (a, h) -> if h < a do h else a end)
      let hi = List.fold_left(hs, 0.0, fn (a, h) -> if h > a do h else a end)
      Test.assert_true(hi /. lo <= 1.10, "tallest over shortest " ++ float_to_string(hi /. lo))
      Test.assert_true(lo >= 1.7 && hi <= 2.0, "heights " ++ float_to_string(lo) ++ " to " ++ float_to_string(hi))
    end

    test "no two alike: every character's voxels differ in number or parts" do
      let keys = List.map(all(), fn c -> (total(c.rig), Strata.Rig.part_count(c.rig)))
      Test.assert_eq_int(List.length(List.dedup(keys)), 12, "twelve different")
    end

    test "a missing file is replaced by the humanoid" do
      let c = StrataViewer.Roster.load_from(["nowhere/"], "nobody")
      Test.assert_eq_int(Strata.Rig.part_count(c.rig), 15, "15 parts")
      Test.assert_true(float_abs(c.size.height -. 1.8) < 0.001, "1.8 m")
    end

    test "the player's pick swaps with its owner" do
      Test.assert_eq_int(StrataViewer.Roster.cast(0, 5), 5, "the player")
      Test.assert_eq_int(StrataViewer.Roster.cast(5, 5), 0, "the owner")
      Test.assert_eq_int(StrataViewer.Roster.cast(3, 5), 3, "anyone else")
      Test.assert_eq_int(StrataViewer.Roster.cast(0, 99), 0, "out of range is 0")
    end

    test "a fallen fighter's pieces include its extras" do
      let r = rig_of("norseman")
      let n = Strata.Rig.part_count(r)
      Test.assert_true(n > 15, "the norseman has a shield on his back")
      Test.assert_true(filled(StrataViewer.Roster.piece_of(r, n - 1), 0) > 0, "the shield's piece has voxels")
    end

    test "the player's own body has no head, arms, or what hangs from them" do
      let r = StrataViewer.Roster.body_of(rig_of("knight"))
      let par = Strata.Rig.parents(r)
      List.map(List.range(0, Strata.Rig.part_count(r)), fn p -> check_empty(r, par, p))
      Test.assert_true(filled(r, 1) > 0, "the torso stays")
    end

    test "the knight's forearm in view is his plate, not skin" do
      let fa = StrataViewer.Roster.forearm_of(rig_of("knight"))
      let g = Strata.Rig.grid(fa, 0)
      Test.assert_true(filled(fa, 0) > 20, "it has voxels")
      Test.assert_eq_int(skin_go(g, 0, NativeArray.length_u8(g), 0), 0, "no skin")
    end

    test "every character has trim, at 1/16 m voxels" do
      List.map(all(), fn c -> Test.assert_true(!is_nil(c.trim), "trim"))
      List.map(all(), fn c -> Test.assert_true(float_abs(Strata.Rig.voxel_size(c.rig) -. 0.0625) < 0.00001, "1/16 m"))
      ()
    end
  end
end
