-- The island across scales, its population, and its stored hashes. The
-- same seed makes the same island in metres at 1 m, 0.5 m and 0.25 m a
-- voxel (ground, lake water, trees, ruins, posts and tall grass); the trees
-- and ruins island.pop declares stand where the viewer's own placement
-- stood them; and twelve island chunks keep the hashes recorded for them.
mod StrataViewer.Test.Island do
  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem
  needs IO.Clock
  import Test

  alias StrataViewer as Vw

  -- the viewer's own island, read from its cache (built once if missing)
  pfn island() : Strata.Atlas.Atlas do Strata.Atlas.load_or_build(".march/atlas", Vw.island_def(), 7) end

  pfn whole(m : Float) : Int do float_to_int(Math.floor(m)) end
  pfn col_h(c : (Int, Int, Int)) : Int do match c do (h, _, _) -> h end end
  pfn col_lake(c : (Int, Int, Int)) : Int do match c do (_, l, _) -> l end end

  -- ── Ground, lake water ───────────────────────────────────────────────────
  -- ground: stone, dirt, grass, sand, snow (not water, plants, posts or ice)
  pfn ground_id(id : Int) : Bool do
    if id == 1 do true else if id == 2 do true else if id == 3 do true else if id == 4 do true else id == 6 end end end end
  end
  pfn terrain(a : Strata.Atlas.Atlas, s : Float, wx : Int, y : Int, wz : Int) : Strata.Chunk.Chunk do
    Vw.island_terrain(a, s, Strata.Coord.chunk_of(wx), Strata.Coord.chunk_of(y), Strata.Coord.chunk_of(wz), 7)
  end
  -- the highest ground voxel of column (wx, wz) from y down to ymin, c the terrain chunk of row ky
  pfn top_go(a : Strata.Atlas.Atlas, s : Float, wx : Int, wz : Int, c : Strata.Chunk.Chunk, ky : Int, y : Int, ymin : Int) : Int do
    if y < ymin do 0 - 1000000
    else if Strata.Coord.chunk_of(y) != ky do top_go(a, s, wx, wz, terrain(a, s, wx, y, wz), Strata.Coord.chunk_of(y), y, ymin)
    else if ground_id(Strata.Chunk.get_or(c, Strata.Coord.local_of(wx), Strata.Coord.local_of(y), Strata.Coord.local_of(wz), 0)) do y
    else top_go(a, s, wx, wz, c, ky, y - 1, ymin) end end end
  end
  -- the ground top of the column holding (xm, zm) at s metres a voxel, in metres: the top of its highest ground voxel
  pfn ground_m(a : Strata.Atlas.Atlas, s : Float, xm : Float, zm : Float) : Float do
    let wx = whole(xm /. s)
    let wz = whole(zm /. s)
    let h = col_h(Vw.island_column(a, wx, wz, 7, s))
    let y0 = h + whole(24.0 /. s)
    int_to_float(top_go(a, s, wx, wz, terrain(a, s, wx, y0, wz), Strata.Coord.chunk_of(y0), y0, h - whole(48.0 /. s)) + 1) *. s
  end
  -- the top of the lake water of the column holding (xm, zm) at s metres a voxel, in metres; 0 with none
  pfn lake_m(a : Strata.Atlas.Atlas, s : Float, xm : Float, zm : Float) : Float do
    let l = col_lake(Vw.island_column(a, whole(xm /. s), whole(zm /. s), 7, s))
    if l > 0 do int_to_float(l + 1) *. s else 0.0 end
  end

  -- the first lake that holds water
  pfn wet_lake(ls : List((Float, Float, Float))) : (Float, Float, Float) do
    match ls do
      Nil -> (0.0, 0.0, 0.0 -. 1.0)
      Cons((x, z, lv), rest) -> if lv >= 0.0 do (x, z, lv) else wet_lake(rest) end
    end
  end
  -- the first river point standing over [above] metres and at least [wide] metres wide
  pfn river_point(a : Strata.Atlas.Atlas, rs : List(List((Float, Float, Float))), above : Float, wide : Float) : (Float, Float, Float) do
    match rs do
      Nil -> (0.0, 0.0, 0.0)
      Cons(r, rest) ->
        match List.find(r, fn pt -> match pt do (x, z, w) -> if w < wide do false else Strata.Atlas.height_at(a, x, z) > above end end) do
          Some(p) -> p
          None -> river_point(a, rest, above, wide)
        end
    end
  end

  -- ── Trees ────────────────────────────────────────────────────────────────
  -- (cell x, cell z, species, base x, base y, base z), the base in metres (the bottom of the trunk's first voxel)
  pfn tree_of(s : Float, e : (Strata.Template.Template, Strata.Populate.PopInstance, Int, Int, Int)) : (Int, Int, Int, Float, Float, Float) do
    match e do
      (_, x, wx, y, wz) ->
        let xm = Strata.Populate.i_xm(x)
        let zm = Strata.Populate.i_zm(x)
        (whole(xm /. 6.0), whole(zm /. 6.0), Strata.Populate.i_variant(x) / 3, int_to_float(wx) *. s, int_to_float(y + 1) *. s, int_to_float(wz) *. s)
    end
  end
  -- the trees of the chunk column holding (xm, zm) at s metres a voxel whose base column lies in that chunk column
  pfn trees_m(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, s : Float, xm : Float, zm : Float) : List((Int, Int, Int, Float, Float, Float)) do
    let cx = Strata.Coord.chunk_of(whole(xm /. s))
    let cz = Strata.Coord.chunk_of(whole(zm /. s))
    let es = List.filter(Vw.island_chunk_trees(a, d, s, cx, cz, 7), fn e -> match e do (_, _, wx, _, wz) -> if Strata.Coord.chunk_of(wx) != cx do false else Strata.Coord.chunk_of(wz) == cz end end)
    List.map(es, fn e -> tree_of(s, e))
  end
  -- the trees based in the 32 m square (128..160, 64..96) at s metres a voxel, from the chunk columns covering it
  pfn trees_square(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, s : Float) : List((Int, Int, Int, Float, Float, Float)) do
    let side = whole(32.0 /. s) / 32
    List.flat_map(List.range(0, side * side), fn k -> trees_m(a, d, s, 128.0 +. (int_to_float(k % side) *. 32.0 +. 0.5) *. s, 64.0 +. (int_to_float(k / side) *. 32.0 +. 0.5) *. s))
  end
  -- the trees the viewer's own placement stood in that square before the port (recorded at a044934): (scale, cell x, cell z, base height in metres)
  pfn forest_before() : List((Float, Int, Int, Float)) do
    [(1.0, 21, 11, 84.0), (1.0, 21, 12, 86.0), (1.0, 22, 11, 84.0), (1.0, 23, 11, 82.0), (1.0, 23, 13, 82.0), (1.0, 24, 13, 81.0), (1.0, 25, 11, 80.0), (1.0, 25, 13, 79.0), (1.0, 26, 13, 78.0),
     (0.5, 21, 11, 84.0), (0.5, 21, 12, 85.5), (0.5, 22, 11, 83.0), (0.5, 23, 11, 82.0), (0.5, 23, 13, 82.5), (0.5, 24, 13, 80.5), (0.5, 25, 11, 79.5), (0.5, 25, 13, 79.0), (0.5, 25, 15, 75.0), (0.5, 26, 13, 77.5),
     (0.25, 21, 11, 84.0), (0.25, 22, 11, 82.75), (0.25, 23, 13, 82.5), (0.25, 24, 13, 80.0), (0.25, 25, 11, 79.5), (0.25, 25, 13, 78.75), (0.25, 25, 15, 74.5), (0.25, 26, 13, 77.5)]
  end
  pfn forest_was(s : Float) : List((Int, Int, Float)) do List.filter_map(forest_before(), fn e -> match e do (sc, cx, cz, y) -> if sc == s do Some((cx, cz, y)) else None end end) end
  -- cells and base heights, sorted, as text
  pfn square_str(ts : List((Int, Int, Int, Float, Float, Float))) : String do
    let xs = List.map(ts, fn t -> (tr_cx(t), tr_cz(t), tr_y(t)))
    cells_str(xs)
  end
  pfn cells_str(xs : List((Int, Int, Float))) : String do
    let sorted = List.sort_by(xs, fn (p, q) -> match (p, q) do ((ax, az, _), (bx, bz, _)) -> if ax != bx do ax < bx else az <= bz end end)
    String.join(List.map(sorted, fn e -> match e do (cx, cz, y) -> int_to_string(cx) ++ "," ++ int_to_string(cz) ++ "@" ++ float_to_string(y) end), " ")
  end
  pfn tr_cx(t : (Int, Int, Int, Float, Float, Float)) : Int do match t do (v, _, _, _, _, _) -> v end end
  pfn tr_cz(t : (Int, Int, Int, Float, Float, Float)) : Int do match t do (_, v, _, _, _, _) -> v end end
  pfn tr_species(t : (Int, Int, Int, Float, Float, Float)) : Int do match t do (_, _, v, _, _, _) -> v end end
  pfn tr_x(t : (Int, Int, Int, Float, Float, Float)) : Float do match t do (_, _, _, v, _, _) -> v end end
  pfn tr_y(t : (Int, Int, Int, Float, Float, Float)) : Float do match t do (_, _, _, _, v, _) -> v end end
  pfn tr_z(t : (Int, Int, Int, Float, Float, Float)) : Float do match t do (_, _, _, _, _, v) -> v end end
  pfn near(p : Float, q : Float, tol : Float) : Bool do Math.abs(p -. q) <= tol end
  -- the trees of ts that stand at scale s2 (decor d2) too, in the same cell, of the same species, their base within a metre: (checked, mismatches)
  pfn trees_agree(a : Strata.Atlas.Atlas, s1 : Float, d2 : StrataViewer.Decor, s2 : Float, ts : List((Int, Int, Int, Float, Float, Float)), n : Int, bad : Int) : (Int, Int) do
    match ts do
      Nil -> (n, bad)
      Cons(t, rest) ->
        let other = trees_m(a, d2, s2, tr_x(t) +. s2 *. 0.5, tr_z(t) +. s2 *. 0.5)
        let same = List.find(other, fn f -> if tr_cx(f) != tr_cx(t) do false else tr_cz(f) == tr_cz(t) end)
        let ok = match same do
            None -> false
            Some(f) -> if tr_species(f) != tr_species(t) do false else if !near(tr_x(f), tr_x(t), 1.0) do false else if !near(tr_z(f), tr_z(t), 1.0) do false else near(tr_y(f), tr_y(t), 1.0) end end end
          end
        let _said = if ok do () else Authority.must(println("cross-scale: the tree of cell (" ++ int_to_string(tr_cx(t)) ++ ", " ++ int_to_string(tr_cz(t)) ++ ") at " ++ float_to_string(s1) ++ " m (base " ++ float_to_string(tr_x(t)) ++ ", " ++ float_to_string(tr_y(t)) ++ ", " ++ float_to_string(tr_z(t)) ++ ") differs at " ++ float_to_string(s2) ++ " m: " ++ (match same do
            None -> "not there (" ++ int_to_string(List.length(other)) ++ " trees in that chunk column)"
            Some(f) -> "species " ++ int_to_string(tr_species(f)) ++ " against " ++ int_to_string(tr_species(t)) ++ ", base " ++ float_to_string(tr_x(f)) ++ ", " ++ float_to_string(tr_y(f)) ++ ", " ++ float_to_string(tr_z(f))
          end))) end
        trees_agree(a, s1, d2, s2, rest, n + 1, if ok do bad else bad + 1 end)
    end
  end

  -- The 40 trees of chunk columns -2..1 x -2..1 at seed 7 and 1 m as the viewer's own placement stood them
  -- (recorded at a044934 before the port): (cell x, cell z, template, rotation, base x, base y, base z), the
  -- base the trunk's first voxel. Template 3 s .. 3 s + 2 is species s.
  pfn recorded_trees() : List((Int, Int, Int, Int, Int, Int, Int)) do
    [(-1, -11, 5, 1, -5, 92, -63), (-1, -2, 2, 3, -2, 97, -11), (-1, -4, 5, 3, -5, 93, -23), (-10, -4, 2, 1, -59, 93, -20), (-10, 4, 6, 3, -57, 96, 28),
     (-11, 6, 3, 3, -62, 95, 40), (-12, 0, 4, 1, -69, 89, 1), (-12, 10, 3, 2, -69, 106, 63), (-2, -6, 1, 1, -11, 87, -33), (-3, -2, 2, 2, -16, 94, -9),
     (-3, 0, 3, 1, -17, 97, 1), (-3, 11, 11, 2, -15, 123, 70), (-3, 6, 8, 1, -14, 98, 38), (-4, -1, 5, 2, -23, 95, -5), (-4, -8, 3, 1, -20, 84, -46),
     (-4, 2, 0, 2, -23, 100, 16), (-5, -2, 3, 2, -26, 91, -10), (-5, -3, 1, 1, -27, 92, -16), (-5, -5, 3, 2, -26, 86, -27), (-6, 0, 1, 2, -34, 94, 3),
     (-6, 5, 1, 2, -35, 92, 34), (-7, -3, 5, 1, -40, 89, -14), (-7, 2, 8, 0, -38, 98, 14), (-7, 5, 7, 0, -41, 96, 32), (-8, 10, 0, 2, -46, 113, 62),
     (-9, 4, 2, 3, -51, 96, 27), (0, -11, 8, 1, 2, 88, -63), (10, 10, 3, 2, 63, 100, 63), (10, 7, 6, 3, 63, 116, 46), (10, 9, 0, 3, 64, 103, 57),
     (11, -10, 4, 3, 70, 90, -57), (11, 11, 6, 1, 70, 100, 68), (2, 1, 2, 2, 15, 108, 8), (2, 10, 2, 2, 15, 122, 61), (2, 11, 10, 3, 13, 120, 68),
     (2, 4, 8, 0, 16, 120, 28), (4, 4, 7, 2, 28, 117, 25), (8, 4, 2, 2, 50, 110, 28), (9, -11, 1, 3, 58, 91, -63), (9, 5, 3, 1, 56, 114, 33)]
  end
  -- the recorded trees not standing as recorded (cell, base column and top, rotation, species), each said
  pfn recorded_go(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, rs : List((Int, Int, Int, Int, Int, Int, Int)), cache : List((Int, Int, List((Strata.Template.Template, Strata.Populate.PopInstance, Int, Int, Int)))), bad : Int) : Int do
    match rs do
      Nil -> bad
      Cons((cx, cz, tpl, rot, bx, bty, bz), rest) ->
        let kx = Strata.Coord.chunk_of(bx)
        let kz = Strata.Coord.chunk_of(bz)
        let (es, cache2) = match List.find(cache, fn e -> match e do (x, z, _) -> if x != kx do false else z == kz end end) do
            Some((_, _, v)) -> (v, cache)
            None ->
              let v = Vw.island_chunk_trees(a, d, 1.0, kx, kz, 7)
              (v, Cons((kx, kz, v), cache))
          end
        let hit = List.find(es, fn e -> match e do (_, x, _, _, _) -> if whole(Strata.Populate.i_xm(x) /. 6.0) != cx do false else whole(Strata.Populate.i_zm(x) /. 6.0) == cz end end)
        let ok = match hit do
            None -> false
            Some((_, x, wx, top, wz)) -> if wx != bx do false else if wz != bz do false else if top + 1 != bty do false else if Strata.Populate.i_rot(x) != rot do false else Strata.Populate.i_variant(x) / 3 == tpl / 3 end end end end
          end
        let _said = if ok do () else Authority.must(println("recorded tree of cell (" ++ int_to_string(cx) ++ ", " ++ int_to_string(cz) ++ "), base (" ++ int_to_string(bx) ++ ", " ++ int_to_string(bty) ++ ", " ++ int_to_string(bz) ++ "), rot " ++ int_to_string(rot) ++ ", template " ++ int_to_string(tpl) ++ ": " ++ (match hit do
            None -> "no tree in that cell"
            Some((_, x, wx, top, wz)) -> "base (" ++ int_to_string(wx) ++ ", " ++ int_to_string(top + 1) ++ ", " ++ int_to_string(wz) ++ "), rot " ++ int_to_string(Strata.Populate.i_rot(x)) ++ ", template " ++ int_to_string(Strata.Populate.i_variant(x))
          end))) end
        recorded_go(a, d, rest, cache2, if ok do bad else bad + 1 end)
    end
  end

  -- ── Ruins ────────────────────────────────────────────────────────────────
  -- the ruin on site s at scale sc as a box in metres (x0, y0, z0, x1, y1, z1), the far faces' far sides
  pfn ruin_box(d : StrataViewer.Decor, st : Strata.Atlas.Site, sc : Float) : Option((Float, Float, Float, Float, Float, Float)) do
    match Vw.site_ruin(d, st, sc, 7) do
      None -> None
      Some((t, ox, oy, oz, rot)) ->
        match Strata.Template.bounds(t, ox, oy, oz, rot) do
          (x0, y0, z0, x1, y1, z1) -> Some((int_to_float(x0) *. sc, int_to_float(y0) *. sc, int_to_float(z0) *. sc, int_to_float(x1 + 1) *. sc, int_to_float(y1 + 1) *. sc, int_to_float(z1 + 1) *. sc))
        end
    end
  end

  -- ── Columns ──────────────────────────────────────────────────────────────
  pfn land_x(i : Int) : Float do if i == 8 do 176.25 else 104.25 +. 40.0 *. int_to_float(i % 3) +. 8.0 *. int_to_float(i / 3) end end
  pfn land_z(i : Int) : Float do if i == 8 do 240.25 else 184.25 +. 40.0 *. int_to_float(i / 3) end end
  -- 30 columns in metres (a quarter metre into a whole metre, so each is one column at either scale), named
  pfn columns(a : Strata.Atlas.Atlas, trees : List((Int, Int, Int, Float, Float, Float))) : List((String, Float, Float)) do
    -- open land round the meadow (144, 224) on a 40 m grid; the ninth point, (200.25, 264.25) on the grid, stands
    -- on a slope steep enough for the thermal pass (tuned at 1 m, its reach in voxels) to leave 2.5 m between the
    -- scales, so it is moved to (176.25, 240.25)
    let land = List.map(List.range(0, 12), fn i -> ("land " ++ int_to_string(i), land_x(i), land_z(i)))
    let (lx, lz, _) = wet_lake(Strata.Atlas.lakes(a))
    let lake = List.map(List.range(0, 4), fn i -> ("lake " ++ int_to_string(i), int_to_float(whole(lx) + 2 * (i % 2) - 1) +. 0.25, int_to_float(whole(lz) + 2 * (i / 2) - 1) +. 0.25))
    let (rx, rz, rw) = river_point(a, Strata.Atlas.rivers(a), 45.0, 3.0)
    let off = rw +. 3.0
    let bank = List.map(List.range(0, 4), fn i -> ("river bank " ++ int_to_string(i), int_to_float(whole(rx +. (if i == 0 do off else if i == 1 do 0.0 -. off else 0.0 end end))) +. 0.25, int_to_float(whole(rz +. (if i == 2 do off else if i == 3 do 0.0 -. off else 0.0 end end))) +. 0.25))
    let bases = List.map(List.take(trees, 6), fn t -> ("tree base " ++ int_to_string(tr_cx(t)) ++ "," ++ int_to_string(tr_cz(t)), tr_x(t) +. 0.25, tr_z(t) +. 0.25))
    let ruin = match Vw.slope_site(a) do
        None -> Nil
        Some(st) ->
          let sx = Strata.Atlas.s_x(st)
          let sz = Strata.Atlas.s_z(st)
          List.map(List.range(0, 4), fn i -> ("ruin site " ++ int_to_string(i), int_to_float(whole(sx) + 2 * (i % 2) - 1) +. 0.25, int_to_float(whole(sz) + 2 * (i / 2) - 1) +. 0.25))
      end
    List.append(land, List.append(lake, List.append(bank, List.append(bases, ruin))))
  end
  -- columns whose ground tops differ by more than a metre between 1 m and 0.5 m (each said)
  pfn ground_go(a : Strata.Atlas.Atlas, cs : List((String, Float, Float)), bad : Int) : Int do
    match cs do
      Nil -> bad
      Cons((nm, x, z), rest) ->
        let g1 = ground_m(a, 1.0, x, z)
        let g2 = ground_m(a, 0.5, x, z)
        let ok = near(g1, g2, 1.0)
        Authority.must(println("cross-scale: " ++ nm ++ " (" ++ float_to_string(x) ++ ", " ++ float_to_string(z) ++ ") ground " ++ float_to_string(g1) ++ " m at 1 m, " ++ float_to_string(g2) ++ " m at 0.5 m" ++ (if ok do "" else "  DIFFERS" end)))
        ground_go(a, rest, if ok do bad else bad + 1 end)
    end
  end

  -- the lake columns of cs (named "lake ...") holding lake water at 1 m whose line at 0.5 m is within a metre of it
  pfn lakes_go(a : Strata.Atlas.Atlas, cs : List((String, Float, Float)), i : Int, ok : Int) : Int do
    match cs do
      Nil -> ok
      Cons((nm, x, z), rest) ->
        if !string_starts_with(nm, "lake") do lakes_go(a, rest, i, ok)
        else
          let l1 = lake_m(a, 1.0, x, z)
          let l2 = lake_m(a, 0.5, x, z)
          Authority.must(println("cross-scale: " ++ nm ++ " lake line " ++ float_to_string(l1) ++ " m at 1 m, " ++ float_to_string(l2) ++ " m at 0.5 m"))
          lakes_go(a, rest, i + 1, if l1 <= 0.0 do ok else if near(l1, l2, 1.0) do ok + 1 else ok end end)
        end
    end
  end

  -- ── Posts and tall grass ────────────────────────────────────────────────
  -- the posts (id 12) and tall grass (id 11) of a chunk
  pfn cover_go(c : Strata.Chunk.Chunk, i : Int, posts : Int, grass : Int) : (Int, Int) do
    if i >= 32768 do (posts, grass)
    else
      let id = Strata.Chunk.get_idx(c, Strata.Chunk.index(i))
      cover_go(c, i + 1, if id == 12 do posts + 1 else posts end, if id == 11 do grass + 1 else grass end)
    end
  end
  -- the posts and tall grass over the 64 m square from (128, 192) m at s metres a voxel: (posts, tall grass)
  pfn cover_m(a : Strata.Atlas.Atlas, s : Float) : (Int, Int) do
    let d = Vw.decor(a, s, 7)
    let side = whole(64.0 /. s) / 32
    let c0x = whole(128.0 /. s) / 32
    let c0z = whole(192.0 /. s) / 32
    cover_area(a, d, s, c0x, c0z, side, 0, (0, 0))
  end
  pfn cover_area(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, s : Float, c0x : Int, c0z : Int, side : Int, k : Int, acc : (Int, Int)) : (Int, Int) do
    if k >= side * side do acc else cover_area(a, d, s, c0x, c0z, side, k + 1, cover_col(a, d, s, c0x + k % side, c0z + k / side, acc)) end
  end
  pfn cover_col(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, s : Float, cx : Int, cz : Int, acc : (Int, Int)) : (Int, Int) do
    let h = col_h(Vw.island_column(a, cx * 32 + 16, cz * 32 + 16, 7, s))
    let ky = Strata.Coord.chunk_of(h)
    cover_rows(a, d, s, cx, cz, ky - 1, ky + 1, acc)
  end
  pfn cover_rows(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, s : Float, cx : Int, cz : Int, cy : Int, cy1 : Int, acc : (Int, Int)) : (Int, Int) do
    if cy > cy1 do acc
    else
      match (acc, cover_go(Vw.island_decorated(a, d, s, cx, cy, cz, 7), 0, 0, 0)) do
        ((p, g), (p2, g2)) -> cover_rows(a, d, s, cx, cz, cy + 1, cy1, (p + p2, g + g2))
      end
    end
  end

  -- ── Ruins standing where they stood ──────────────────────────────────────
  -- The three ruins nearest the origin at seed 7 and 1 m as the viewer's own placement stood them (recorded at
  -- a044934 before the port): (site index, template index, its size x, y, z, the centre column x and z, the lowest row)
  pfn recorded_ruins() : List((Int, Int, Int, Int, Int, Int, Int, Int)) do
    [(6, 0, 12, 5, 2, -416, -240, 62), (5, 2, 11, 9, 3, 412, -364, 54), (7, 1, 9, 14, 9, -552, 268, 44)]
  end
  pfn site_of(a : Strata.Atlas.Atlas, idx : Int) : Option(Strata.Atlas.Site) do List.find(Strata.Atlas.sites(a), fn st -> Strata.Atlas.s_index(st) == idx) end
  pfn count_id(c : Strata.Chunk.Chunk, id : Int, i : Int, n : Int) : Int do
    if i >= 32768 do n else count_id(c, id, i + 1, if Strata.Chunk.get_idx(c, Strata.Chunk.index(i)) == id do n + 1 else n end) end
  end
  pfn count_stamps(st : NativeI32Arr, i : Int, n : Int) : Int do
    if i >= 32768 do n else count_stamps(st, i + 1, if NativeArray.get_i32(st, i) != 0 do n + 1 else n end) end
  end
  -- the stamped voxels of the chunks a ruin's box at (ox, oy, oz) turned rot meets, and how many voxels its template holds
  pfn stamped(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, t : Strata.Template.Template, ox : Int, oy : Int, oz : Int, rot : Int) : (Int, Int) do
    match Strata.Template.bounds(t, ox, oy, oz, rot) do
      (x0, y0, z0, x1, y1, z1) ->
        let ks = List.flat_map(List.range(Strata.Coord.chunk_of(x0), Strata.Coord.chunk_of(x1) + 1), fn kx -> List.flat_map(List.range(Strata.Coord.chunk_of(y0), Strata.Coord.chunk_of(y1) + 1), fn ky -> List.map(List.range(Strata.Coord.chunk_of(z0), Strata.Coord.chunk_of(z1) + 1), fn kz -> (kx, ky, kz))))
        let n = List.fold_left(ks, 0, fn (acc, k) -> match k do (kx, ky, kz) -> count_stamps(Vw.island_stamps(a, d, 1.0, kx, ky, kz, 7), 0, acc) end)
        let held = List.fold_left(List.range(0, Strata.Template.t_sx(t) * Strata.Template.t_sy(t) * Strata.Template.t_sz(t)), 0, fn (m, i) -> if NativeArray.get_i32(Strata.Template.t_ids(t), i) != 0 do m + 1 else m end)
        (n, held)
    end
  end

  -- ── Where trees and ruins stand, voxel by voxel ──────────────────────────
  -- the voxels of template t blitted alone at (ox, oy, oz) turned rot with stream st, against the generated chunks:
  -- (template voxels the chunks hold, template voxels they do not)
  pfn placed(t : Strata.Template.Template, ox : Int, oy : Int, oz : Int, rot : Int, st : Int, a : Strata.Atlas.Atlas, d : StrataViewer.Decor) : (Int, Int) do
    match Strata.Template.bounds(t, ox, oy, oz, rot) do
      (x0, y0, z0, x1, y1, z1) ->
        let ks = List.flat_map(List.range(Strata.Coord.chunk_of(x0), Strata.Coord.chunk_of(x1) + 1), fn kx -> List.flat_map(List.range(Strata.Coord.chunk_of(y0), Strata.Coord.chunk_of(y1) + 1), fn ky -> List.map(List.range(Strata.Coord.chunk_of(z0), Strata.Coord.chunk_of(z1) + 1), fn kz -> (kx, ky, kz))))
        List.fold_left(ks, (0, 0), fn (acc, k) -> held_key(t, ox, oy, oz, rot, st, a, d, k, acc))
    end
  end
  pfn held_key(t : Strata.Template.Template, ox : Int, oy : Int, oz : Int, rot : Int, st : Int, a : Strata.Atlas.Atlas, d : StrataViewer.Decor, k : (Int, Int, Int), acc : (Int, Int)) : (Int, Int) do
    match k do
      (kx, ky, kz) -> held_go(Strata.Template.blit(Strata.Chunk.uniform(0), Strata.Coord.key(kx, ky, kz), t, ox, oy, oz, rot, st), Vw.island_decorated(a, d, 1.0, kx, ky, kz, 7), 0, acc)
    end
  end
  pfn mask_key(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, t : Strata.Template.Template, ox : Int, oy : Int, oz : Int, rot : Int, k : (Int, Int, Int), acc : (Int, Int)) : (Int, Int) do
    match k do
      (kx, ky, kz) -> mask_go(Vw.island_stamps(a, d, 1.0, kx, ky, kz, 7), Strata.Template.blit(Strata.Chunk.uniform(0), Strata.Coord.key(kx, ky, kz), t, ox, oy, oz, rot, 0), 0, acc)
    end
  end
  pfn held_go(want : Strata.Chunk.Chunk, got : Strata.Chunk.Chunk, i : Int, acc : (Int, Int)) : (Int, Int) do
    if i >= 32768 do acc
    else
      let w = Strata.Chunk.get_idx(want, Strata.Chunk.index(i))
      let acc2 = if w == 0 do acc else match acc do (h, m) -> if Strata.Chunk.get_idx(got, Strata.Chunk.index(i)) == w do (h + 1, m) else (h, m + 1) end end end
      held_go(want, got, i + 1, acc2)
    end
  end
  -- stamped voxels (island_stamps) of the chunks a box meets that the template blitted alone does not hold, and the reverse
  pfn stamps_match(a : Strata.Atlas.Atlas, d : StrataViewer.Decor, t : Strata.Template.Template, ox : Int, oy : Int, oz : Int, rot : Int) : (Int, Int) do
    match Strata.Template.bounds(t, ox, oy, oz, rot) do
      (x0, y0, z0, x1, y1, z1) ->
        let ks = List.flat_map(List.range(Strata.Coord.chunk_of(x0), Strata.Coord.chunk_of(x1) + 1), fn kx -> List.flat_map(List.range(Strata.Coord.chunk_of(y0), Strata.Coord.chunk_of(y1) + 1), fn ky -> List.map(List.range(Strata.Coord.chunk_of(z0), Strata.Coord.chunk_of(z1) + 1), fn kz -> (kx, ky, kz))))
        List.fold_left(ks, (0, 0), fn (acc, k) -> mask_key(a, d, t, ox, oy, oz, rot, k, acc))
    end
  end
  pfn mask_go(st : NativeI32Arr, want : Strata.Chunk.Chunk, i : Int, acc : (Int, Int)) : (Int, Int) do
    if i >= 32768 do acc
    else
      let s1 = NativeArray.get_i32(st, i) != 0
      let w1 = Strata.Chunk.get_idx(want, Strata.Chunk.index(i)) != 0
      let acc2 = match acc do (extra, lack) -> if s1 && !w1 do (extra + 1, lack) else if w1 && !s1 do (extra, lack + 1) else acc end end end
      mask_go(st, want, i + 1, acc2)
    end
  end

  -- ── The viewer's placement code is gone ──────────────────────────────────
  pfn deleted_names() : List(String) do
    ["has_post", "tree_kind", "species_of", "pick_at", "reaches", "island_tree", "island_trees", "trees_into", "ruins_into", "site_for", "beard_go", "tree_pad", "slope_step", "coarse_trees", "level0_tree", "coarse_window", "coarse_code", "tree_code", "window_at", "coarse_tree_into", "coarse_into"]
  end
  pfn viewer_source() : String do
    let own = match process_argv() do
        Cons(exe, _) -> Cons(Path.dirname(exe) ++ "/../../../lib/strata_viewer.march", Nil)
        Nil -> Nil
      end
    let tried = List.filter_map(List.append(own, ["lib/strata_viewer.march", "viewer/lib/strata_viewer.march"]), fn path ->
      match Authority.must(File.read(path)) do
        Ok(text) -> Some(text)
        Err(_) -> None
      end)
    match tried do
      Cons(t, _) -> t
      Nil -> ""
    end
  end
  -- the deleted names the source still defines or calls
  pfn still_there(src : String) : List(String) do
    List.filter(deleted_names(), fn n -> if string_contains(src, "fn " ++ n ++ "(") do true else if string_contains(src, " " ++ n ++ "(") do true else string_contains(src, "(" ++ n ++ "(") end end)
  end

  describe "The island across scales" do
    test "at 1 m and 0.5 m a voxel: the same ground, lake water, trees and ruin in metres" do
      let a = island()
      let d1 = Vw.decor(a, 1.0, 7)
      let dh = Vw.decor(a, 0.5, 7)
      -- the forest (144, 80): its trees at 1 m
      let forest = trees_m(a, d1, 1.0, 144.25, 80.25)
      let cs = columns(a, forest)
      Test.assert_eq_int(List.length(cs), 30, "30 columns")
      Test.assert_eq_int(ground_go(a, cs, 0), 0, "every column's ground top agrees within a metre")
      Test.assert_eq_int(lakes_go(a, cs, 0, 0), 4, "the 4 lake columns hold lake water at 1 m, and at 0.5 m its line within a metre")
      Test.assert_true(List.length(forest) >= 6, "the forest's chunk column holds 6 trees or more")
      match trees_agree(a, 1.0, dh, 0.5, List.take(forest, 6), 0, 0) do
        (n, bad) ->
          Test.assert_eq_int(n, 6, "6 trees")
          Test.assert_eq_int(bad, 0, "each stands at 0.5 m in the same cell, of the same species, its base within a metre")
      end
      match Vw.slope_site(a) do
        None -> Test.assert_true(false, "the island has a site")
        Some(st) ->
          match (ruin_box(d1, st, 1.0), ruin_box(dh, st, 0.5)) do
            (Some((ax0, ay0, az0, ax1, ay1, az1)), Some((bx0, by0, bz0, bx1, by1, bz1))) ->
              Authority.must(println("cross-scale: the ruin at 1 m spans x " ++ float_to_string(ax0) ++ ".." ++ float_to_string(ax1) ++ ", z " ++ float_to_string(az0) ++ ".." ++ float_to_string(az1) ++ " from y " ++ float_to_string(ay0) ++ "; at 0.5 m x " ++ float_to_string(bx0) ++ ".." ++ float_to_string(bx1) ++ ", z " ++ float_to_string(bz0) ++ ".." ++ float_to_string(bz1) ++ " from y " ++ float_to_string(by0)))
              Test.assert_true(ax1 -. ax0 == bx1 -. bx0, "as many metres along x")
              Test.assert_true(az1 -. az0 == bz1 -. bz0, "as many metres along z")
              Test.assert_true(ay1 -. ay0 == by1 -. by0, "as many metres high")
              Test.assert_true(near(ax0, bx0, 1.0), "standing where it does, within a metre, along x")
              Test.assert_true(near(az0, bz0, 1.0), "and along z")
              Test.assert_true(near(ay0, by0, 1.0), "on the same floor within a metre")
            _ -> Test.assert_true(false, "the ruin stands at both scales")
          end
      end
    end

    test "the forest's trees at 1 m, 0.5 m and 0.25 m: each scale stands the trees it stood before the port, and across scales they agree but for the ground's own differences" do
      let a = island()
      let d1 = Vw.decor(a, 1.0, 7)
      let dh = Vw.decor(a, 0.5, 7)
      let dq = Vw.decor(a, 0.25, 7)
      -- the trees based in the forest's 32 m chunk column (128..160, 64..96) at each scale
      let t1 = trees_square(a, d1, 1.0)
      let th = trees_square(a, dh, 0.5)
      let tq = trees_square(a, dq, 0.25)
      Authority.must(println("cross-scale: the forest's chunk column holds " ++ int_to_string(List.length(t1)) ++ " trees at 1 m, " ++ int_to_string(List.length(th)) ++ " at 0.5 m, " ++ int_to_string(List.length(tq)) ++ " at 0.25 m"))
      Test.assert_eq_str(square_str(t1), cells_str(forest_was(1.0)), "1 m: the cells and ground tops of before the port")
      Test.assert_eq_str(square_str(th), cells_str(forest_was(0.5)), "0.5 m: likewise")
      Test.assert_eq_str(square_str(tq), cells_str(forest_was(0.25)), "0.25 m: likewise")
      -- both ways; the trees that disagree did so before the port too: the ground differs between scales
      -- (the thermal relax counts its reach in voxels), so a tree's top moves or its slope refuses it
      let bad = List.fold_left([trees_agree(a, 1.0, dh, 0.5, t1, 0, 0), trees_agree(a, 1.0, dq, 0.25, t1, 0, 0), trees_agree(a, 0.5, d1, 1.0, th, 0, 0), trees_agree(a, 0.25, d1, 1.0, tq, 0, 0)], 0, fn (m, c) -> match c do (_, b) -> m + b end)
      Test.assert_eq_int(bad, 6, "six disagreements both ways, all of the ground: (22, 11) a metre and a quarter lower at 0.25 m, (23, 11) and (21, 12) refused at 0.25 m, (25, 15) refused at 1 m")
    end

    test "posts and tall grass are as many a square metre at 0.5 m as at 1 m" do
      let a = island()
      match (cover_m(a, 1.0), cover_m(a, 0.5)) do
        ((p1, g1), (p2, g2)) ->
          Authority.must(println("cross-scale: over a 64 m square, " ++ int_to_string(p1) ++ " posts and " ++ int_to_string(g1) ++ " tall grass at 1 m, " ++ int_to_string(p2) ++ " and " ++ int_to_string(g2) ++ " at 0.5 m"))
          Test.assert_true(p1 >= 5, "the meadow has posts at 1 m")
          Test.assert_true(p2 >= 5, "and at 0.5 m")
          Test.assert_true(g1 >= 200, "and tall grass")
          Test.assert_true(g2 * 10 <= g1 * 11, "no more than a tenth more tall grass at 0.5 m")
          Test.assert_true(g2 * 10 >= g1 * 9, "nor a tenth less")
      end
    end
  end

  describe "The island's population" do
    test "island.pop reads and freezes, and every ground slot it reads is one the viewer supplies" do
      let a = island()
      let d = Vw.decor(a, 1.0, 7)
      match Vw.decor_frozen(d) do
        None -> Test.fail("island.pop is read")
        Some(f) ->
          let miss = List.filter(Strata.Population.missing_ground(f), fn sl -> !List.any(Vw.supplied_slots(), fn x -> x == sl))
          Test.assert_eq_int(List.length(miss), 0, "missing_ground is empty against what the viewer supplies")
          Test.assert_true(Strata.Population.layer_names(f) == ["forest", "ruins", "posts", "grass"], "trees, ruins, posts, tall grass, in that order")
      end
    end
    test "the 40 recorded trees stand in their cells on the same base voxel, turned the same, of the same species" do
      let a = island()
      Test.assert_eq_int(List.length(recorded_trees()), 40, "40 trees")
      Test.assert_eq_int(recorded_go(a, Vw.decor(a, 1.0, 7), recorded_trees(), Nil, 0), 0, "every recorded tree as it stood")
    end
    test "five of the recorded trees: the generated chunks hold every voxel of the tree's template blitted at its base, turned and drawn as listed" do
      let a = island()
      let d = Vw.decor(a, 1.0, 7)
      let rs = List.take(recorded_trees(), 5)
      List.fold_left(rs, (), fn (_, r) -> match r do
        (cx, cz, _, _, bx, _, bz) ->
          let es = Vw.island_chunk_trees(a, d, 1.0, Strata.Coord.chunk_of(bx), Strata.Coord.chunk_of(bz), 7)
          match List.find(es, fn e -> match e do (_, x, _, _, _) -> if whole(Strata.Populate.i_xm(x) /. 6.0) != cx do false else whole(Strata.Populate.i_zm(x) /. 6.0) == cz end end) do
            None -> Test.fail("the tree of cell " ++ int_to_string(cx) ++ ", " ++ int_to_string(cz) ++ " stands")
            Some((t, x, wx, top, wz)) ->
              match Vw.tree_origin(t, wx, top, wz) do
                (ox, oy, oz) ->
                  match placed(t, ox, oy, oz, Strata.Populate.i_rot(x), Strata.Populate.i_stream(x), a, d) do
                    (h, m) ->
                      Authority.must(println("placed tree of cell (" ++ int_to_string(cx) ++ ", " ++ int_to_string(cz) ++ "): " ++ int_to_string(h) ++ " voxels held, " ++ int_to_string(m) ++ " missing"))
                      Test.assert_true(h > 20, "the tree of cell " ++ int_to_string(cx) ++ ", " ++ int_to_string(cz) ++ " has voxels")
                      Test.assert_eq_int(m, 0, "the tree of cell " ++ int_to_string(cx) ++ ", " ++ int_to_string(cz) ++ ": every template voxel in the world where its base puts it")
                  end
              end
          end
      end)
    end
    test "the three ruins nearest the origin stand on their sites as the same template, their lowest row on the floor, and the chunks hold them" do
      let a = island()
      let d = Vw.decor(a, 1.0, 7)
      List.fold_left(recorded_ruins(), (), fn (_, r) ->
        match r do
          (idx, tpl, sx, sy, sz, cx, cz, oy0) ->
            match site_of(a, idx) do
              None -> Test.fail("site " ++ int_to_string(idx) ++ " is on the island")
              Some(st) ->
                Test.assert_eq_int(Strata.Atlas.s_index(st) % 3, tpl, "site " ++ int_to_string(idx) ++ ": template index mod 3")
                match Vw.site_ruin(d, st, 1.0, 7) do
                  None -> Test.fail("the ruins load")
                  Some((t, ox, oy, oz, rot)) ->
                    Test.assert_true(Strata.Template.t_sx(t) == sx && Strata.Template.t_sy(t) == sy && Strata.Template.t_sz(t) == sz, "site " ++ int_to_string(idx) ++ ": the same template")
                    Test.assert_eq_int(whole(Strata.Atlas.s_x(st)), cx, "site " ++ int_to_string(idx) ++ ": centre column x")
                    Test.assert_eq_int(whole(Strata.Atlas.s_z(st)), cz, "and z")
                    Test.assert_eq_int(oy, oy0, "site " ++ int_to_string(idx) ++ ": its lowest row on the floor as before")
                    match (stamped(a, d, t, ox, oy, oz, rot), stamps_match(a, d, t, ox, oy, oz, rot)) do
                      ((n, held), (extra, lack)) ->
                        Authority.must(println("ruin of site " ++ int_to_string(idx) ++ ": turn " ++ int_to_string(rot) ++ ", " ++ int_to_string(n) ++ " stamped voxels, its template holds " ++ int_to_string(held) ++ "; stamped off the template " ++ int_to_string(extra) ++ ", template voxels unstamped " ++ int_to_string(lack)))
                        Test.assert_eq_int(n, held, "site " ++ int_to_string(idx) ++ ": every voxel its template holds is stamped")
                        Test.assert_eq_int(extra + lack, 0, "site " ++ int_to_string(idx) ++ ": each stamped voxel where the template blitted at the site's origin and turn puts one, and no other")
                        match placed(t, ox, oy, oz, rot, 0, a, d) do
                          (_, m) -> Test.assert_eq_int(m, 0, "site " ++ int_to_string(idx) ++ ": the generated chunks hold every template voxel there")
                        end
                    end
                end
            end
        end)
    end
    test "each ground slot supplied only where a layer reads it gives the chunks every slot supplied everywhere gives, for island.pop and for an edit whose grass also refuses steep ground" do
      let a = island()
      let d = Vw.decor(a, 1.0, 7)
      let text = match Authority.must(File.read(Vw.pop_path())) do
          Ok(t) -> t
          Err(_) -> ""
        end
      let steep_text = String.replace(text, "base = {tall_grass_chance}  outside = wet  on = 3", "base = {tall_grass_chance}  outside = wet steep  on = 3")
      Test.assert_true(steep_text != text, "the edit applies")
      let keys = List.flat_map(List.range(0, 9), fn i -> [Strata.Coord.key(4 + i % 3 - 1, 2, 2 + i / 3 - 1), Strata.Coord.key(4 + i % 3 - 1, 3, 2 + i / 3 - 1)])
      let grass = fn (dd : StrataViewer.Decor) -> List.fold_left(keys, 0, fn (n, k) -> n + count_id(Vw.island_decorated(a, dd, 1.0, Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), 7), 11, 0, 0))
      let hashes = fn (dd : StrataViewer.Decor) -> List.map(keys, fn k -> Strata.Chunk.hash(Vw.island_decorated(a, dd, 1.0, Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), 7)))
      Test.assert_true(hashes(d) == hashes(Vw.decor_everywhere(d)), "island.pop: the same 18 chunks")
      match Vw.decor_with(d, a, 1.0, steep_text) do
        Err(m) -> Test.fail("the edit reads: " ++ m)
        Ok(ds) ->
          let narrow = grass(ds)
          let wide = grass(Vw.decor_everywhere(ds))
          Authority.must(println("slots: tall grass over 18 forest chunks, " ++ int_to_string(grass(d)) ++ " with island.pop, " ++ int_to_string(narrow) ++ " with steep refused (" ++ int_to_string(wide) ++ " with every slot everywhere)"))
          Test.assert_eq_int(narrow, wide, "the edit: as much tall grass as with every slot everywhere")
          Test.assert_true(hashes(ds) == hashes(Vw.decor_everywhere(ds)), "and the same chunks")
          Test.assert_true(narrow < grass(d), "and steep ground refuses some")
      end
    end
    test "the viewer's own placement code is gone" do
      let src = viewer_source()
      Test.assert_true(String.byte_size(src) > 100000, "the viewer's source is read")
      Test.assert_eq_str(String.join(still_there(src), ", "), "", "none of the deleted functions is defined or called")
      Test.assert_false(string_contains(src, "Strata.Feature."), "no Strata.Feature in the viewer")
      Test.assert_false(string_contains(src, "Strata.Template.blit"), "nor Strata.Template.blit")
    end
  end

  -- ── Stored hashes ────────────────────────────────────────────────────────
  -- Twelve island chunks at seed 7 and 1 m a voxel, generated as the viewer generates them (trees, ruins and
  -- early-outs), and the Strata.Chunk.hash recorded for each on 2026-11-12. They guard the generator through the
  -- switch to March main and the performance work: a change in any of them means the island changed. All twelve
  -- re-recorded on 2026-11-15 when the population took over the island's trees, ruins, posts and tall grass (each
  -- change looked at voxel by voxel; docs/population-ledger.md, Task 9, names the reason for each).
  pfn stored() : List((String, Strata.Coord.Key, Int)) do
    [("the hilltop: the island's highest atlas ground (8 m grid), its ground chunk", Strata.Coord.key(1, 3, 0), 136058429282366),
     ("a slope with trees: the forest's ground at (144, 80)", Strata.Coord.key(4, 2, 2), 122112635473312),
     ("a lake: the first wet lake's centre at its level", Strata.Coord.key(0, 2, -4), 116000216406248),
     ("a river: a point 3 m wide or more over 45 m, at its ground", Strata.Coord.key(-1, 1, -15), 136589703338710),
     ("caves: under the cave scene's hill (44, 78), y 64 to 95 m, the ground at 106 m", Strata.Coord.key(1, 2, 2), 101692638789935),
     ("a ruin site: the slope site's ruin on its floor", Strata.Coord.key(12, 1, -12), 133814373772168),
     ("the coast: walking +x from the origin to the first ground under 39 m, at the sea line", Strata.Coord.key(18, 1, 0), 122517300933027),
     ("underground: y 32 to 63 m under the hills south-west of the origin, a few cave voxels", Strata.Coord.key(-2, 1, 1), 142506851409580),
     ("level 1 over the forest", Strata.Coord.parent(Strata.Coord.key(4, 2, 2)), 104186477816244),
     ("level 1 over the hilltop", Strata.Coord.parent(Strata.Coord.key(1, 3, 0)), 149217145040399),
     ("level 2 over the forest", Strata.Coord.parent(Strata.Coord.parent(Strata.Coord.key(4, 2, 2))), 136823916990646),
     ("level 2 over the hilltop", Strata.Coord.parent(Strata.Coord.parent(Strata.Coord.key(1, 3, 0))), 150282700286091)]
  end
  pfn stored_go(g : Strata.Terrain.Gen, ks : List((String, Strata.Coord.Key, Int)), bad : Int) : Int do
    match ks do
      Nil -> bad
      Cons((nm, k, want), rest) ->
        let h = Strata.Chunk.hash(Strata.Terrain.run(g, k, 7))
        let _said = if h == want do () else Authority.must(println("island hash: " ++ nm ++ ": " ++ int_to_string(h) ++ ", stored " ++ int_to_string(want))) end
        stored_go(g, rest, if h == want do bad else bad + 1 end)
    end
  end

  describe "The island's stored hashes" do
    test "twelve island chunks at seed 7 and 1 m keep their stored hashes" do
      let a = island()
      let g = Vw.island_gen(a, Vw.decor(a, 1.0, 7), 1.0)
      Test.assert_eq_int(List.length(stored()), 12, "twelve keys")
      Test.assert_eq_int(stored_go(g, stored(), 0), 0, "every hash as stored")
    end
  end
  -- ── A column made in one call ────────────────────────────────────────────
  -- Strata.Terrain.run_column over the keys of one chunk column must give,
  -- key for key, the chunk Strata.Terrain.run gives (the generator's column
  -- function does the column's shared work once and nothing else).
  pfn column_keys(k : Strata.Coord.Key, dy : Int, acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    if dy < 0 - 3 do acc
    else column_keys(k, dy - 1, Cons(Strata.Coord.key_at(Strata.Coord.kx(k), Strata.Coord.ky(k) + dy, Strata.Coord.kz(k), Strata.Coord.level(k)), acc)) end
  end
  pfn hashes(cs : List(Strata.Chunk.Chunk)) : List(Int) do List.map(cs, fn c -> Strata.Chunk.hash(c)) end
  pfn singly(g : Strata.Terrain.Gen, ks : List(Strata.Coord.Key)) : List(Int) do List.map(ks, fn k -> Strata.Chunk.hash(Strata.Terrain.run(g, k, 7))) end
  -- how many of the columns about the keys in cs differ, batched against single, bottom-up or top-down
  pfn columns_go(g : Strata.Terrain.Gen, cs : List(Strata.Coord.Key), bad : Int) : Int do
    match cs do
      Nil -> bad
      Cons(k, rest) ->
        let ks = column_keys(k, 3, Nil)
        let want = singly(g, ks)
        let up = hashes(Strata.Terrain.run_column(g, ks, 7)) == want
        let down = hashes(Strata.Terrain.run_column(g, List.reverse(ks), 7)) == List.reverse(want)
        let _said = if up do (if down do () else Authority.must(println("island column: top-down differs at " ++ int_to_string(Strata.Coord.kx(k)) ++ ", " ++ int_to_string(Strata.Coord.kz(k)) ++ " level " ++ int_to_string(Strata.Coord.level(k)))) end)
          else Authority.must(println("island column: differs at " ++ int_to_string(Strata.Coord.kx(k)) ++ ", " ++ int_to_string(Strata.Coord.kz(k)) ++ " level " ++ int_to_string(Strata.Coord.level(k)))) end
        columns_go(g, rest, if up do (if down do bad else bad + 1 end) else bad + 1 end)
    end
  end
  -- a 5 x 5 grid of level-0 columns three chunks apart about the origin, at the chunk row holding most ground
  pfn grid_go(i : Int, acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    if i >= 25 do acc else grid_go(i + 1, Cons(Strata.Coord.key(3 * (i % 5) - 6, 2, 3 * (i / 5) - 6), acc)) end
  end
  -- beyond the atlas (open sea) at levels 0 and 1, and coarse columns off the stored ones
  pfn others() : List(Strata.Coord.Key) do
    [Strata.Coord.key(60, 1, 60), Strata.Coord.key_at(30, 0, 30, 1), Strata.Coord.key_at(2, 1, 1, 1), Strata.Coord.key_at(-1, 0, -2, 1), Strata.Coord.key_at(0, 0, 0, 2)]
  end
  pfn keys_of(ks : List((String, Strata.Coord.Key, Int))) : List(Strata.Coord.Key) do List.map(ks, fn t -> match t do (_, k, _) -> k end) end

  describe "An island column made in one call" do
    test "run_column over cy - 3 .. cy + 3 equals the seven single runs, bottom-up and top-down" do
      let a = island()
      let g = Vw.island_gen(a, Vw.decor(a, 1.0, 7), 1.0)
      let cs = List.append(keys_of(stored()), List.append(grid_go(0, Nil), others()))
      Test.assert_eq_int(List.length(cs), 42, "42 columns: the stored keys', a grid, the open sea, coarse levels")
      Test.assert_eq_int(columns_go(g, cs, 0), 0, "every column as its single runs")
    end
    test "the column function is called: a column of chunks comes back, and one chunk alone is the single run" do
      let a = island()
      let g = Vw.island_gen(a, Vw.decor(a, 1.0, 7), 1.0)
      let k = Strata.Coord.key(4, 2, 2)
      Test.assert_eq_int(List.length(Vw.island_column_chunks(a, Vw.decor(a, 1.0, 7), 1.0, column_keys(k, 3, Nil), 7)), 7, "seven chunks")
      Test.assert_true(hashes(Strata.Terrain.run_column(g, Cons(k, Nil), 7)) == Cons(Strata.Chunk.hash(Strata.Terrain.run(g, k, 7)), Nil), "a batch of one")
    end
  end
  -- ── Any order ─────────────────────────────────────────────────────────────
  -- Twelve island chunks (two columns of x, three rows of y, two of z), made
  -- singly in key order and in reverse, by whole columns top-down, by columns
  -- split in two batches, and singly with every ground slot supplied at every
  -- column (another Table for each Ground): every way gives the same hashes.
  pfn box_keys(x0 : Int, y0 : Int, z0 : Int) : List(Strata.Coord.Key) do
    List.map(List.range(0, 12), fn i -> Strata.Coord.key(x0 + i / 6, y0 + (i / 2) % 3, z0 + i % 2))
  end
  -- the hash of each key, from the chunks made in batches of the column (cx, cz)'s rows y0 + 2, y0 + 1 (together) and y0 (alone)
  pfn split_hashes(g : Strata.Terrain.Gen, ks : List(Strata.Coord.Key), y0 : Int) : List(Int) do
    List.map(ks, fn k ->
      let cx = Strata.Coord.kx(k)
      let cz = Strata.Coord.kz(k)
      let top = Strata.Terrain.run_column(g, [Strata.Coord.key(cx, y0 + 2, cz), Strata.Coord.key(cx, y0 + 1, cz)], 7)
      let low = Strata.Terrain.run_column(g, [Strata.Coord.key(cx, y0, cz)], 7)
      let row = Strata.Coord.ky(k) - y0
      Strata.Chunk.hash(if row == 0 do List.head(low) else List.nth(top, 2 - row) end))
  end
  -- the hash of each key, from whole columns made top-down
  pfn column_hashes(g : Strata.Terrain.Gen, ks : List(Strata.Coord.Key), y0 : Int) : List(Int) do
    List.map(ks, fn k ->
      let cx = Strata.Coord.kx(k)
      let cz = Strata.Coord.kz(k)
      let col = Strata.Terrain.run_column(g, [Strata.Coord.key(cx, y0 + 2, cz), Strata.Coord.key(cx, y0 + 1, cz), Strata.Coord.key(cx, y0, cz)], 7)
      Strata.Chunk.hash(List.nth(col, 2 - (Strata.Coord.ky(k) - y0))))
  end
  -- every way at one scale, as a line: how many ways differ from key order, and how many of the twelve chunks are not uniform
  pfn order_case(a : Strata.Atlas.Atlas, s : Float, x0 : Int, y0 : Int, z0 : Int) : String do
    let d = Vw.decor(a, s, 7)
    let g = Vw.island_gen(a, d, s)
    let ks = box_keys(x0, y0, z0)
    let fwd = List.map(ks, fn k -> Strata.Chunk.hash(Strata.Terrain.run(g, k, 7)))
    let rev = List.reverse(List.map(List.reverse(ks), fn k -> Strata.Chunk.hash(Strata.Terrain.run(g, k, 7))))
    let ge = Vw.island_gen(a, Vw.decor_everywhere(d), s)
    let every = List.map(ks, fn k -> Strata.Chunk.hash(Strata.Terrain.run(ge, k, 7)))
    let ways = [("reversed", rev), ("columns", column_hashes(g, ks, y0)), ("split", split_hashes(g, ks, y0)), ("every slot", every)]
    let differ = List.filter(ways, fn w -> match w do (_, hs) -> hs != fwd end)
    let flat = [Strata.Chunk.hash(Strata.Chunk.uniform(0)), Strata.Chunk.hash(Strata.Chunk.uniform(1))]
    let made = List.length(List.filter(fwd, fn h -> !List.any(flat, fn u -> u == h)))
    float_to_string(s) ++ " m: " ++ int_to_string(made) ++ " made, differ: " ++ string_join(List.map(differ, fn w -> match w do (n, _) -> n end), ",")
  end

  describe "The island in any order" do
    test "twelve chunks at 1 m and at 0.25 m: the same hashes in key order, reversed, by columns, split columns, and with every slot supplied" do
      let a = island()
      let one = order_case(a, 1.0, 4, 1, 2)
      let quarter = order_case(a, 0.25, 17, 9, 9)
      Authority.must(println("any order: " ++ one ++ " | " ++ quarter))
      Test.assert_true(string_ends_with(one, "differ: "), "1 m: " ++ one)
      Test.assert_true(string_ends_with(quarter, "differ: "), "0.25 m: " ++ quarter)
      Test.assert_false(string_starts_with(one, "1. m: 0 made"), "1 m: some chunks are made, not uniform")
      Test.assert_false(string_starts_with(quarter, "0.25 m: 0 made"), "0.25 m: some chunks are made, not uniform")
    end
  end

  pfn quads_of(ms : List((Strata.Coord.Key, Strata.Mesh.Meshed)), lv : Int) : (Int, Int) do
    List.fold_left(ms, (0, 0), fn (acc, p) -> match acc do (n, q) -> match p do (k, m) -> if Strata.Coord.level(k) == lv do (n + 1, q + Strata.Mesh.quad_count_at(m, 0) + Strata.Mesh.quad_count_at(m, 1) + Strata.Mesh.quad_count_at(m, 2)) else (n, q) end end end)
  end
  -- a settled island stream with two coarse levels, as text: its world hash, loaded count, and meshes and quads per level
  pfn probe_run(a : Strata.Atlas.Atlas, budget : Int, workers : Int, cap : Int) : String do
    let g = Vw.island_gen(a, Vw.decor(a, 1.0, 7), 1.0)
    let w = Strata.World.new(Vw.registry(), g, 7, 1.0)
    let s = Strata.Stream.run_until_settled(Strata.Stream.set_focus(Strata.Stream.start(w, Strata.Stream.with_batch(Strata.Stream.config_levels(4, 3, budget, workers, 4, 1, 2), cap)), Cons((-70.0, 110.0, 96.0), Nil)), 1000000)
    match Strata.Stream.take_meshes(s) do
      (s1, ms) ->
        let r = "hash " ++ int_to_string(Strata.Stream.world_hash(s1)) ++ " loaded " ++ int_to_string(Strata.Stream.loaded_count(s1)) ++ " meshes/quads L0 " ++ (match quads_of(ms, 0) do (n, q) -> int_to_string(n) ++ "/" ++ int_to_string(q) end) ++ " L1 " ++ (match quads_of(ms, 1) do (n, q) -> int_to_string(n) ++ "/" ++ int_to_string(q) end) ++ " L2 " ++ (match quads_of(ms, 2) do (n, q) -> int_to_string(n) ++ "/" ++ int_to_string(q) end)
        Strata.Stream.stop(s1)
        r
    end
  end
  describe "The island streamed in batches" do
    -- This is the test that catches a batch putting the queue out of order (it did once: the keys
    -- passed over while a column's mates were looked for went back reversed, coarse chunks loaded
    -- before the finer level was whole, and 97 top-level chunks were meshed where 66 should be).
    -- The world's hash is the same either way; only the meshes tell.
    test "the same world and the same meshes at each level, whatever the batch cap, workers and budget" do
      let a = island()
      let one = probe_run(a, 8, 4, 1)
      Test.assert_true(probe_run(a, 8, 4, 4) == one, "cap 4 as cap 1")
      Test.assert_true(probe_run(a, 8, 4, 8) == one, "cap 8 as cap 1")
      Test.assert_true(probe_run(a, 32, 8, 4) == one, "and with other workers and budget")
    end
  end
end
