-- The viewer's effects (StrataViewer.Fx): five defined once, and the two
-- embers blocks a burning cell becomes.
mod StrataViewer.Test.Fx do

  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem
  import Test
  alias StrataViewer.Fx as Fx

  describe "the viewer's effects" do
    test "define_all defines seven distinct ids from 1" do
      match Fx.define_all(Strata.Particles.new(1)) do
        (p, ids) ->
          let all = [ids.fx_flame, ids.fx_ember, ids.fx_smoke, ids.fx_spark, ids.fx_steam, ids.fx_blaze, ids.fx_frost]
          Test.assert_true(List.all(all, fn i -> i >= 1 && i <= 7), "ids 1 to 7")
          Test.assert_eq_int(List.length(List.dedup(List.sort_by(all, fn (a, b) -> a <= b))), 7, "distinct")
          Test.assert_eq_int(List.length(Strata.Particles.pending_effects(p)), 7, "seven to send")
      end
    end
    test "embers_for: wood and grass burn as burning wood, leaves as burning leaves, the rest not at all" do
      Test.assert_eq_int(Fx.embers_for(7), 25, "wood")
      Test.assert_eq_int(Fx.embers_for(3), 25, "grass")
      Test.assert_eq_int(Fx.embers_for(8), 26, "leaves")
      Test.assert_eq_int(Fx.embers_for(11), -1, "tall grass is not swapped")
      Test.assert_eq_int(Fx.embers_for(13), -1, "ice is not swapped")
      Test.assert_eq_int(Fx.embers_for(1), -1, "stone")
    end
    test "the registry holds 25 and 26, both glowing, 26 cutout as leaves are" do
      let reg = StrataViewer.registry()
      Test.assert_true(Strata.Blocks.emission(reg, Fx.burning_wood()) > 0, "burning wood glows")
      Test.assert_true(Strata.Blocks.emission(reg, Fx.burning_leaves()) > 0, "burning leaves glow")
      Test.assert_eq_int(Strata.Blocks.layer_index(reg, Fx.burning_leaves()), Strata.Blocks.layer_index(reg, 8), "burning leaves are cutout as leaves")
      Test.assert_eq_int(Strata.Blocks.layer_index(reg, Fx.burning_wood()), Strata.Blocks.layer_index(reg, 7), "burning wood is opaque as wood")
      Test.assert_true(Strata.Blocks.collides(reg, Fx.burning_wood()), "and solid")
    end
    test "the textures hold the flame and the two burning tiles" do
      Test.assert_eq_int(StrataViewer.Textures.count(), 17, "seventeen layers")
      -- the flame's middle is bright and its corner clear
      Test.assert_true(NativeArray.get_u8(StrataViewer.Textures.tile(14), 4 * (8 + 16 * 9) + 3) > 200, "the flame's heart is opaque")
      Test.assert_eq_int(NativeArray.get_u8(StrataViewer.Textures.tile(14), 3), 0, "its corner clear")
    end
  end
end
