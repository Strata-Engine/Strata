-- Combat: the rules of the free-for-all (docs/2026-11-12-combat-design.md).
mod StrataViewer.Test.Combat do

  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem
  needs IO.Clock
  needs IO.Foreign
  needs Anim
  needs Ent
  import Test
  alias StrataViewer.Combat as Cmb
  alias StrataViewer.Figures as Fg

  -- [n] hits of [damage] on [victim] by [who]; the fighters after, and how many of the hits killed
  pfn hits(fs : List(StrataViewer.Combat.CbFighter), victim : Int, who : Int, damage : Int, n : Int, killed : Int) : (List(StrataViewer.Combat.CbFighter), Int) do
    if n <= 0 do (fs, killed)
    else
      match Cmb.hit(fs, victim, who, damage) do
        (fs2, o) -> hits(fs2, victim, who, damage, n - 1, if Cmb.killed(o) do killed + 1 else killed end)
      end
    end
  end
  -- fighter [i] given [k] kills by killing fighter 11 over and over (it is brought back between)
  pfn with_kills(fs : List(StrataViewer.Combat.CbFighter), i : Int, k : Int) : List(StrataViewer.Combat.CbFighter) do
    if k <= 0 do fs
    else
      match Cmb.hit(fs, 11, i, 1000) do
        (fs2, _) -> match Cmb.tick(fs2, 3.1) do (fs3, _) -> with_kills(fs3, i, k - 1) end
      end
    end
  end
  pfn idle_for(f : StrataViewer.Combat.CbFighter, steps : Int, moved : Float, fought : Bool) : (StrataViewer.Combat.CbFighter, Bool) do
    if steps <= 0 do (f, false)
    else
      match Cmb.idle(f, moved, fought, 0.1) do
        (f2, true) -> (f2, true)
        (f2, false) -> if steps == 1 do (f2, false) else idle_for(f2, steps - 1, moved, fought) end
      end
    end
  end
  pfn dist(a : (Float, Float), b : (Float, Float)) : Float do
    match a do (ax, az) -> match b do (bx, bz) -> Math.sqrt((ax -. bx) *. (ax -. bx) +. (az -. bz) *. (az -. bz)) end end
  end
  pfn closest(p : (Float, Float), l : List((Float, Float)), best : Float) : Float do
    match l do
      Nil -> best
      Cons(q, rest) -> closest(p, rest, if dist(p, q) < best do dist(p, q) else best end)
    end
  end
  -- the least distance between any two of the points
  pfn least_gap(l : List((Float, Float)), best : Float) : Float do
    match l do
      Nil -> best
      Cons(p, rest) -> least_gap(rest, closest(p, rest, best))
    end
  end
  pfn all_between(l : List((Float, Float)), lo : Float, hi : Float) : Bool do
    match l do
      Nil -> true
      Cons(p, rest) -> if dist(p, (0.0, 0.0)) < lo do false else if dist(p, (0.0, 0.0)) > hi do false else all_between(rest, lo, hi) end end
    end
  end
  pfn has_cell(l : List((Int, Int, Int)), x : Int, y : Int, z : Int) : Bool do
    match l do
      Nil -> false
      Cons((a, b, c), rest) -> if a == x && b == y && c == z do true else has_cell(rest, x, y, z) end
    end
  end
  pfn same_intent(a : StrataViewer.Combat.CbIntent, b : Int) : Bool do Cmb.intent_code(a) == b end

  pfn nth_clip(cs : List(Strata.Clip.Clip), i : Int) : Strata.Clip.Clip do
    match cs do
      Nil -> Strata.Clip.new(Fg.humanoid(), 0.0, false)
      Cons(c, rest) -> if i == 0 do c else nth_clip(rest, i - 1) end
    end
  end
  -- does any key of the clip move a part at or above [from]?
  pfn keys_from(ks : List((Int, Int, Int, Float, Float, Float, Float, Float)), from : Int) : Bool do
    match ks do
      Nil -> false
      Cons((p, _, _, _, _, _, _, _), rest) -> if p >= from do true else keys_from(rest, from) end
    end
  end
  pfn pieces_whole(p : Int) : Bool do
    if p >= 15 do true
    else if Strata.Rig.refused(Fg.piece(p)) != 0 do false
    else if Strata.Rig.part_count(Fg.piece(p)) != 1 do false
    else pieces_whole(p + 1) end end end
  end

  -- a small world for fire: a stone at the origin cell, a grass floor at y = -2, wood everywhere else
  pfn fire_world(x : Int, y : Int, z : Int) : Int do
    if x == 0 && y == 0 && z == 0 do 1 else if y == -2 do 3 else 7 end end
  end
  pfn change_at(l : List((Int, Int, Int, Int)), x : Int, y : Int, z : Int) : Int do
    match l do
      Nil -> -5
      Cons((a, b, c, id), rest) -> if a == x && b == y && c == z do id else change_at(rest, x, y, z) end
    end
  end

  -- stone below y = 0, air above; chunks -1..0 in x and z, -1..1 in y (as the walker's tests)
  pfn flat_reg() : Strata.Blocks.Registry do
    match Strata.Blocks.register(Strata.Blocks.empty(), Strata.Blocks.def()) do
      Ok((r, _)) -> r
      Err(_) -> Strata.Blocks.empty()
    end
  end
  pfn flat_go(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 12 do w
    else
      let cy = i / 4 - 1
      flat_go(Strata.World.insert(w, Strata.Coord.key(i % 2 - 1, cy, (i / 2) % 2 - 1), if cy < 0 do Strata.Chunk.uniform(1) else Strata.Chunk.uniform(0) end), i + 1)
    end
  end
  pfn flat() : Strata.World.World do flat_go(Strata.World.new(flat_reg(), Strata.Terrain.gen(fn (k, seed) -> Strata.Chunk.uniform(0)), 1, 1.0), 0) end

  describe "Combat rules" do
    test "damage_table: arrows and fire fell fighters as the design's table says" do
      let fs = Cmb.roster()
      Test.assert_eq_int(List.length(fs), 12, "twelve fighters")
      Test.assert_eq_int(match hits(fs, 1, 0, Cmb.arrow_damage(), 2, 0) do (_, k) -> k end, 0, "two arrows do not fell a rusher")
      Test.assert_eq_int(match hits(fs, 1, 0, Cmb.arrow_damage(), 3, 0) do (_, k) -> k end, 1, "three do")
      Test.assert_eq_int(match hits(fs, 8, 0, Cmb.arrow_damage(), 1, 0) do (_, k) -> k end, 0, "one arrow does not fell a shooter")
      Test.assert_eq_int(match hits(fs, 8, 0, Cmb.arrow_damage(), 2, 0) do (_, k) -> k end, 1, "two do")
      Test.assert_eq_int(Cmb.fire_damage(0.0), 60, "fire at the centre")
      Test.assert_eq_int(Cmb.fire_damage(1.0), 40, "fire at 1 m")
      Test.assert_eq_int(Cmb.fire_damage(2.0), 20, "fire at 2 m")
      Test.assert_eq_int(Cmb.fire_damage(2.01), 0, "fire beyond 2 m")
      Test.assert_eq_int(match hits(fs, 8, 0, Cmb.fire_damage(0.0), 1, 0) do (_, k) -> k end, 1, "one fireball fells a shooter")
      Test.assert_eq_int(match hits(fs, 1, 0, Cmb.fire_damage(0.0), 1, 0) do (_, k) -> k end, 0, "one does not fell a rusher")
      Test.assert_eq_int(match hits(fs, 1, 0, Cmb.fire_damage(0.0), 2, 0) do (_, k) -> k end, 1, "two do")
      Test.assert_eq_int(Cmb.swing_damage(), 25, "a swing")
    end

    test "one_death_a_tick: a second killing hit on a dead fighter is ignored" do
      match Cmb.hit(Cmb.roster(), 3, 1, 100) do
        (fs1, o1) ->
          match Cmb.hit(fs1, 3, 2, 100) do
            (fs2, o2) ->
              Test.assert_eq_int(Cmb.credit(o1), 1, "the first hit kills, credited to 1")
              Test.assert_eq_int(Cmb.credit(o2), -20, "the second is ignored")
              Test.assert_eq_int(Cmb.deaths(fs2, 3), 1, "one death")
              Test.assert_eq_int(Cmb.kills(fs2, 2), 0, "no kill for the second")
              Test.assert_eq_int(Cmb.kills(fs2, 1), 1, "one for the first")
          end
      end
    end

    test "self_kill_credits_no_one" do
      match Cmb.hit(Cmb.roster(), 0, 0, 100) do
        (fs, o) ->
          Test.assert_eq_int(Cmb.credit(o), -1, "killed, no credit")
          Test.assert_eq_int(Cmb.kills(fs, 0), 0, "no kill")
          Test.assert_eq_int(Cmb.deaths(fs, 0), 1, "one death")
      end
    end

    test "credit_outlives_the_shooter: a dead fighter's arrow still counts" do
      match Cmb.hit(Cmb.roster(), 8, 1, 100) do
        (fs1, _) ->
          match Cmb.hit(fs1, 1, 8, 100) do
            (fs2, o) ->
              Test.assert_eq_int(Cmb.credit(o), 8, "credited to the dead shooter")
              Test.assert_eq_int(Cmb.kills(fs2, 8), 1, "its kill is kept")
          end
      end
    end

    test "first_to_thirty_wins: nothing counts after the winning kill" do
      let fs = with_kills(with_kills(Cmb.roster(), 1, 29), 2, 29)
      Test.assert_eq_int(Cmb.winner(fs), -1, "no winner at 29")
      match Cmb.hit(fs, 5, 1, 1000) do
        (fs1, _) ->
          match Cmb.hit(fs1, 6, 2, 1000) do
            (fs2, o) ->
              Test.assert_eq_int(Cmb.winner(fs2), 1, "the first to thirty")
              Test.assert_eq_int(Cmb.kills(fs2, 2), 29, "the later kill does not count")
              Test.assert_eq_int(Cmb.credit(o), -1, "and is credited to no one")
          end
      end
    end

    test "back_after_three_seconds: at full health" do
      match Cmb.hit(Cmb.roster(), 8, 0, 100) do
        (fs1, _) ->
          match Cmb.tick(fs1, 2.9) do
            (fs2, back2) ->
              Test.assert_eq_int(List.length(back2), 0, "not yet")
              match Cmb.tick(fs2, 0.2) do
                (fs3, back3) ->
                  Test.assert_true(back3 == [8], "the shooter is back")
                  Test.assert_true(Cmb.alive(fs3, 8), "alive")
                  Test.assert_eq_int(Cmb.health(fs3, 8), 60, "at a shooter's full health")
              end
          end
      end
    end

    test "standings_order: kills, then fewer deaths, then index" do
      -- 0: 5 kills 2 deaths; 1: 5 kills 1 death; 2: 7 kills 0 deaths
      let a = with_kills(with_kills(with_kills(Cmb.roster(), 0, 5), 1, 5), 2, 7)
      let b = match Cmb.hit(a, 0, 11, 1000) do (x, _) -> match Cmb.tick(x, 3.1) do (y, _) -> y end end
      let c = match Cmb.hit(b, 0, 11, 1000) do (x, _) -> match Cmb.tick(x, 3.1) do (y, _) -> y end end
      let d = match Cmb.hit(c, 1, 11, 1000) do (x, _) -> match Cmb.tick(x, 3.1) do (y, _) -> y end end
      Test.assert_true(List.take(Cmb.standings(d), 3) == [2, 1, 0], "2, then 1, then 0")
      Test.assert_eq_int(List.length(Cmb.standings(d)), 12, "everyone is listed")
    end

    test "idle_rule: twenty seconds without moving or fighting" do
      let f = Cmb.at(Cmb.roster(), 1)
      Test.assert_false(match idle_for(f, 199, 0.0, false) do (_, hit) -> hit end, "19.9 s is not yet")
      Test.assert_true(match idle_for(f, 201, 0.0, false) do (_, hit) -> hit end, "20 s is")
      let nearly = match idle_for(f, 199, 0.0, false) do (g, _) -> g end
      let moved = match Cmb.idle(nearly, 2.0, false, 0.1) do (g, _) -> g end
      Test.assert_false(match idle_for(moved, 150, 0.0, false) do (_, hit) -> hit end, "moving 2 m starts the count again")
      let fought = match Cmb.idle(nearly, 0.0, true, 0.1) do (g, _) -> g end
      Test.assert_false(match idle_for(fought, 150, 0.0, false) do (_, hit) -> hit end, "so does a hit")
    end

    test "nearest_clear_target" do
      let at = [(0.0, 0.0, 0.0), (10.0, 0.0, 0.0), (0.0, 0.0, 20.0), (50.0, 0.0, 0.0)]
      let alive = [true, true, true, true]
      Test.assert_eq_int(Cmb.target(0, at, alive, fn i -> i != 1), 2, "the nearest it can see")
      Test.assert_eq_int(Cmb.target(0, at, alive, fn _ -> false), -1, "none clear")
      Test.assert_eq_int(Cmb.target(0, at, alive, fn _ -> true), 1, "never itself")
      Test.assert_eq_int(Cmb.target(0, at, [true, false, true, true], fn _ -> true), 2, "never the dead")
      Test.assert_eq_int(Cmb.target(0, [(0.0, 0.0, 0.0), (50.0, 0.0, 0.0)], [true, true], fn _ -> true), -1, "none beyond 40 m")
    end

    test "intents: what a fighter means to do" do
      Test.assert_true(same_intent(Cmb.intent(Cmb.rusher(), true, false, 3, 5.0, 0.0), 0), "off the field: return")
      Test.assert_true(same_intent(Cmb.intent(Cmb.rusher(), false, true, 3, 1.0, 0.0), 7), "swimming, even in reach: swim")
      Test.assert_true(same_intent(Cmb.intent(Cmb.rusher(), false, false, -1, 0.0, 0.0), 1), "no target: wander")
      Test.assert_true(same_intent(Cmb.intent(Cmb.rusher(), false, false, 3, 1.5, 0.0), 3), "a rusher in reach, cool: swing")
      Test.assert_true(same_intent(Cmb.intent(Cmb.rusher(), false, false, 3, 1.5, 0.4), 2), "in reach, not cool: chase")
      Test.assert_true(same_intent(Cmb.intent(Cmb.rusher(), false, false, 3, 9.0, 0.0), 2), "out of reach: chase")
      Test.assert_true(same_intent(Cmb.intent(Cmb.shooter(), false, false, 3, 8.0, 0.0), 5), "a shooter under 12 m: retreat")
      Test.assert_true(same_intent(Cmb.intent(Cmb.shooter(), false, false, 3, 30.0, 0.0), 2), "over 25 m: chase")
      Test.assert_true(same_intent(Cmb.intent(Cmb.shooter(), false, false, 3, 18.0, 0.0), 6), "between, cool: shoot")
      Test.assert_true(same_intent(Cmb.intent(Cmb.shooter(), false, false, 3, 18.0, 0.7), 4), "between, not cool: hold")
    end

    test "spawn_farthest: the point farthest from its nearest living fighter" do
      let points = [(10.0, 0.0, 0.0), (40.0, 0.0, 0.0), (70.0, 0.0, 0.0)]
      Test.assert_eq_int(Cmb.spawn_at(points, [(0.0, 0.0, 0.0)]), 2, "the third")
      Test.assert_eq_int(Cmb.spawn_at(points, [(0.0, 0.0, 0.0), (72.0, 0.0, 0.0)]), 1, "the middle one, with a fighter at each end")
      Test.assert_eq_int(Cmb.spawn_at(points, Nil), 0, "the first with no one living")
    end

    test "ring_shape: sixteen spread points" do
      let r = Cmb.ring(0.0, 0.0)
      Test.assert_eq_int(List.length(r), 16, "sixteen")
      Test.assert_true(all_between(r, 30.0, 72.0), "between 30 and 72 m of the middle")
      Test.assert_true(least_gap(r, 1000.0) > 10.0, "no two within 10 m")
    end

    test "fire_burns: wood, leaves, tall grass and ice go; grass turns to dirt" do
      Test.assert_eq_int(Cmb.burns(7), 0, "wood")
      Test.assert_eq_int(Cmb.burns(8), 0, "leaves")
      Test.assert_eq_int(Cmb.burns(11), 0, "tall grass")
      Test.assert_eq_int(Cmb.burns(13), 0, "ice")
      Test.assert_eq_int(Cmb.burns(3), 2, "grass to dirt")
      Test.assert_true(Cmb.burns(1) == -1 && Cmb.burns(2) == -1 && Cmb.burns(4) == -1 && Cmb.burns(5) == -1 && Cmb.burns(6) == -1 && Cmb.burns(10) == -1, "stone, dirt, sand, water, snow and glass stay")
      let cells = Cmb.burn_cells(0.5, 0.5, 0.5)
      Test.assert_eq_int(List.length(cells), 33, "33 cells within 2 m of a cell's centre")
      Test.assert_true(has_cell(cells, 0, 0, 0) && has_cell(cells, 1, 0, 0) && has_cell(cells, 0, -2, 0), "the centre, a neighbour, two below")
      Test.assert_false(has_cell(cells, 2, 2, 0), "not a far corner")
    end

    test "tools: the bow, fire, then blocks" do
      Test.assert_eq_int(Cmb.tool(0), 0, "the bow")
      Test.assert_eq_int(Cmb.tool(1), 1, "fire")
      Test.assert_eq_int(Cmb.tool(2), 3, "stone")
      Test.assert_eq_int(Cmb.tool(3), 4, "dirt")
      Test.assert_true(Cmb.tool(8) >= 3, "a block in the last slot")
    end
  end

  describe "Combat figures" do
    test "nine_clips: the seven as they were, then flinch and fall" do
      let cs = Fg.clips(Fg.humanoid())
      Test.assert_eq_int(List.length(cs), 9, "nine clips")
      Test.assert_true(Math.abs(Strata.Clip.duration(nth_clip(cs, 6)) -. 0.8) < 0.001, "the swing is still the seventh")
      Test.assert_true(Math.abs(Strata.Clip.duration(nth_clip(cs, 7)) -. 0.25) < 0.001, "flinch lasts 0.25 s")
      Test.assert_true(Math.abs(Strata.Clip.duration(nth_clip(cs, 8)) -. 0.6) < 0.001, "fall lasts 0.6 s")
      Test.assert_false(Strata.Clip.loops(nth_clip(cs, 7)) || Strata.Clip.loops(nth_clip(cs, 8)), "neither loops")
      Test.assert_eq_int(Strata.Clip.refused(nth_clip(cs, 7)) + Strata.Clip.refused(nth_clip(cs, 8)), 0, "no key refused")
    end

    test "flinch_spares_the_legs: so it layers over a walk" do
      let c = nth_clip(Fg.clips(Fg.humanoid()), 7)
      Test.assert_true(Strata.Clip.key_count(c) > 0, "it has keys")
      Test.assert_false(keys_from(Strata.Clip.keys(c), 9), "no key on a leg part (9 to 14)")
    end

    test "small_rigs_are_whole: bow, arrow, fireball and the loose parts" do
      Test.assert_eq_int(Strata.Rig.refused(Fg.bow()) + Strata.Rig.refused(Fg.arrow()) + Strata.Rig.refused(Fg.fireball()), 0, "nothing refused")
      Test.assert_true(Strata.Rig.part_count(Fg.bow()) == 1 && Strata.Rig.part_count(Fg.arrow()) == 1 && Strata.Rig.part_count(Fg.fireball()) == 1, "one part each")
      Test.assert_true(pieces_whole(0), "each of the humanoid's 15 parts makes a whole one-part rig")
    end
  end


  describe "Combat fire" do
    test "fire_edit: what burns within 2 m is removed, grass turns to dirt, the rest is left" do
      let cs = Cmb.fire_changes(fn (x, y, z) -> fire_world(x, y, z), 0.5, 0.5, 0.5)
      Test.assert_eq_int(change_at(cs, 1, 0, 0), 0, "wood beside the centre is removed")
      Test.assert_eq_int(change_at(cs, 0, 2, 0), 0, "wood 2 m up is removed")
      Test.assert_eq_int(change_at(cs, 0, -2, 0), 2, "grass 2 m down turns to dirt")
      Test.assert_eq_int(change_at(cs, 0, 0, 0), -5, "the stone is left")
      Test.assert_eq_int(change_at(cs, 2, 2, 0), -5, "wood beyond 2 m is left")
      Test.assert_eq_int(List.length(cs), 32, "every cell in reach but the stone")
    end
  end


  describe "Combat edits" do
    test "single_edit: a dig takes one block, a build sets one against the face met, never where the player stands" do
      let w = flat()
      -- the eye 1.6 m over the ground at (0.5, 0.5), looking forward (+z) and down
      Test.assert_true(StrataViewer.Match.single_edit(w, 0.5, 1.6, 0.5, 0.0, -0.6, 0.8, true, false, 1) == [(0, -1, 2, 0)], "the dig removes the one block the view meets")
      Test.assert_true(StrataViewer.Match.single_edit(w, 0.5, 1.6, 0.5, 0.0, -0.6, 0.8, false, true, 1) == [(0, 0, 2, 1)], "the build sets one block on top of it")
      Test.assert_true(StrataViewer.Match.single_edit(w, 0.5, 1.6, 0.5, 0.0, -1.0, 0.0, false, true, 1) == Nil, "no block is set where the player stands")
      Test.assert_true(StrataViewer.Match.single_edit(w, 0.5, 1.6, 0.5, 0.0, -0.6, 0.8, true, false, -1) == Nil, "a weapon's slot edits nothing")
      Test.assert_true(StrataViewer.Match.single_edit(w, 0.5, 9.0, 0.5, 0.0, -1.0, 0.0, true, false, 1) == Nil, "nothing beyond 6 m")
      Test.assert_eq_int(StrataViewer.Match.block_for(0), -1, "slot 1 is the bow")
      Test.assert_eq_int(StrataViewer.Match.block_for(2), 1, "slot 3 is stone")
    end
  end

  describe "Combat goal" do
    test "a_match_to_three: the goal can be other than thirty" do
      let fs = with_kills(Cmb.roster(), 1, 2)
      Test.assert_eq_int(Cmb.winner_at(fs, 3), -1, "no winner at two of three")
      match Cmb.hit_to(fs, 5, 1, 1000, 3) do
        (fs1, _) ->
          Test.assert_eq_int(Cmb.winner_at(fs1, 3), 1, "the third kill wins")
          Test.assert_eq_int(Cmb.winner(fs1), -1, "but not a match to thirty")
          match Cmb.hit_to(fs1, 6, 2, 1000, 3) do
            (fs2, o) ->
              Test.assert_eq_int(Cmb.credit(o), -1, "nothing counts after the win")
              Test.assert_eq_int(Cmb.kills(fs2, 2), 0, "no kill for the late hit")
          end
      end
    end
  end

  describe "Combat bench" do
    test "restore_and_bench: a stuck fighter is healed in place; a benched one never comes back" do
      let hurt = match Cmb.hit(Cmb.roster(), 1, 2, 70) do (fs, _) -> fs end
      Test.assert_eq_int(Cmb.health(Cmb.restore(hurt, 1), 1), 100, "restored to full health")
      Test.assert_eq_int(Cmb.deaths(Cmb.restore(hurt, 1), 1), 0, "with no death counted")
      let benched = Cmb.bench(Cmb.roster(), 3)
      Test.assert_false(Cmb.alive(benched, 3), "a benched fighter is not alive")
      Test.assert_eq_int(List.length(match Cmb.tick(benched, 1000.0) do (_, back) -> back end), 0, "and does not come back")
      Test.assert_eq_int(Cmb.deaths(benched, 3), 0, "nor count a death")
    end
  end
end
