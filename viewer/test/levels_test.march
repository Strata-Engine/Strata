-- The viewer's main level: the 9 and 0 keys step it from where it started.
mod StrataViewer.Test.Levels do

  -- the app's capabilities are charged to its test module too (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.Process
  needs IO.Spawn
  needs IO.Foreign
  needs Audio
  import Test

  describe "viewer main level" do
    test "the key state starts at the level given at start" do
      Test.assert_eq_int(StrataViewer.level_tenths(StrataViewer.level_bits(1.0)), 10, "full")
      Test.assert_eq_int(StrataViewer.level_tenths(StrataViewer.level_bits(0.2)), 2, "0.2 is two tenths, so 9 goes to 0.1 and 0 to 0.3")
      Test.assert_eq_int(StrataViewer.level_tenths(StrataViewer.level_bits(0.26)), 3, "rounded to the nearest tenth")
      Test.assert_eq_int(StrataViewer.level_tenths(StrataViewer.level_bits(-1.0)), 0, "below 0 is silent")
      Test.assert_eq_int(StrataViewer.level_tenths(StrataViewer.level_bits(7.0)), 10, "above 1 is full")
    end
  end
end
