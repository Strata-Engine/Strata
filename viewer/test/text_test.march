-- Text across the boundary: strings reach C, fonts load, text becomes quads.
mod StrataViewer.Test.Text do

  needs IO.Console
  needs IO.Process
  needs IO.Spawn
  import Test
  alias Strata.Text as Tx
  alias Strata.Ui as Uw

  pfn white() : (Float, Float, Float, Float) do (1.0, 1.0, 1.0, 1.0) end
  pfn at(u : Strata.Ui.Ui, q : Int, i : Int) : Float do NativeArray.get_f32(Uw.quads(u), 16 * q + i) end
  pfn screen() : Strata.Ui.Ui do Uw.begin(800.0, 600.0, 1.0, 1.0) end
  -- draw until every glyph is in the atlas (new glyphs are spread over frames)
  pfn settled(n : Int) : Bool do n == 0 || Tx.waiting() == 0 end

  describe "Strings reach C" do
    test "a short string, a long one and one with accents are counted right" do
      Test.assert_eq_int(Strata.Ffi.Text.utf8_count("héllo"), 5, "five characters in six bytes")
      Test.assert_eq_int(Strata.Ffi.Text.byte_count("héllo"), 6, "six bytes")
      Test.assert_eq_int(Strata.Ffi.Text.utf8_count(""), 0, "empty")
      Test.assert_eq_int(Strata.Ffi.Text.utf8_count("The quick brown fox jumps over the lazy dog"), 43, "a string too long to be packed in a word")
      Test.assert_eq_int(Strata.Ffi.Text.utf8_count("你好，世界"), 5, "Chinese")
      Test.assert_eq_int(Strata.Ffi.Text.utf8_count("a" ++ "bcdefgh"), 8, "a built string")
    end
  end

  describe "Fonts" do
    test "the built-in font is there and a missing file is a failure the game can see" do
      Test.assert_eq_int(Tx.default_font(), 1, "handle 1")
      Test.assert_eq_int(Tx.font("no/such/font.ttf", 0, Nil), 0, "0 for a missing file")
      Test.assert_true(Tx.font("../test/fonts/NotoSans-Latin.ttf", 0, Nil) > 1, "a real file loads")
      Test.assert_eq_int(Tx.font("../test/fonts/OFL.txt", 0, Nil), 0, "0 for a file that is not a font")
    end
  end

  describe "Text as quads" do
    test "a word becomes one glyph quad a letter, left to right" do
      let _ = Tx.set_raster_budget(1000000)
      let u = Tx.text(screen(), Uw.top_left(), 10.0, 10.0, Tx.default_font(), 24.0, white(), "Hello")
      Test.assert_true(settled(Uw.quad_count(u)), "nothing waits with a large budget")
      Test.assert_eq_int(Uw.quad_count(u), 5, "five quads")
      Test.assert_true(at(u, 0, 12) == 3.0, "glyph kind")
      Test.assert_true(at(u, 1, 0) > at(u, 0, 0) && at(u, 4, 0) > at(u, 3, 0), "left to right")
    end
    test "text follows quads already in the display and keeps them" do
      let u0 = Uw.rect(screen(), Uw.top_left(), 0.0, 0.0, 5.0, 5.0, white())
      let u = Tx.text(u0, Uw.top_left(), 10.0, 10.0, Tx.default_font(), 24.0, white(), "Hi")
      Test.assert_eq_int(Uw.quad_count(u), 3, "one rect and two glyphs")
      Test.assert_true(at(u, 0, 12) == 0.0 && at(u, 0, 2) == 5.0, "the rect is untouched")
    end
    test "two texts built on the same display do not write over each other" do
      let base = screen()
      let a = Tx.text(base, Uw.top_left(), 0.0, 0.0, 1, 24.0, white(), "A")
      let b = Tx.text(base, Uw.top_left(), 0.0, 0.0, 1, 24.0, white(), "W")
      Test.assert_eq_int(Uw.quad_count(a), 1, "one glyph each")
      Test.assert_true(at(a, 0, 4) != at(b, 0, 4) || at(a, 0, 5) != at(b, 0, 5), "the first display still holds its own glyph")
      Test.assert_true(at(a, 0, 6) -. at(a, 0, 4) < at(b, 0, 6) -. at(b, 0, 4), "an A, narrower than the W")
    end
    test "invalid UTF-8 and empty strings draw nothing" do
      Test.assert_eq_int(Uw.quad_count(Tx.text(screen(), Uw.top_left(), 0.0, 0.0, 1, 24.0, white(), "")), 0, "empty")
      Test.assert_eq_int(Uw.quad_count(Tx.text(screen(), Uw.top_left(), 0.0, 0.0, 1, 24.0, white(), "   \n ")), 0, "blank")
    end
    test "a long text grows the display" do
      let s = "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog."
      let u = Tx.text(screen(), Uw.top_left(), 0.0, 0.0, 1, 12.0, white(), s)
      Test.assert_eq_int(Uw.quad_count(u), 72, "seventy-two inked letters")
    end
    test "a bad font handle draws with the built-in font" do
      Test.assert_eq_int(Uw.quad_count(Tx.text(screen(), Uw.top_left(), 0.0, 0.0, 999, 24.0, white(), "ok")), 2, "two glyphs")
    end
    test "scale 2 doubles the glyphs" do
      let a = Tx.text(Uw.begin(800.0, 600.0, 1.0, 1.0), Uw.top_left(), 0.0, 0.0, 1, 24.0, white(), "H")
      let b = Tx.text(Uw.begin(800.0, 600.0, 2.0, 1.0), Uw.top_left(), 0.0, 0.0, 1, 24.0, white(), "H")
      Test.assert_true(Math.abs((at(b, 0, 3) -. at(b, 0, 1)) -. 2.0 *. (at(a, 0, 3) -. at(a, 0, 1))) < 0.01, "twice as tall")
    end
  end

  describe "Measuring" do
    test "an empty string is zero wide and one line high" do
      match Tx.measure(1, 20.0, "", 0.0) do
        (w, h, lines) ->
          Test.assert_true(w == 0.0 && h > 20.0 && h < 36.0, "zero wide, about a line high")
          Test.assert_eq_int(lines, 1, "one line")
      end
    end
    test "wrapping makes lines; a newline forces one" do
      match Tx.measure(1, 20.0, "a b", 0.0) do
        (w, _, lines) ->
          Test.assert_eq_int(lines, 1, "one line unwrapped")
          match Tx.measure(1, 20.0, "a b", w *. 0.6) do (_, _, l2) -> Test.assert_eq_int(l2, 2, "two lines at a width that fits one word") end
      end
      match Tx.measure(1, 20.0, "a\nb", 0.0) do (_, _, l3) -> Test.assert_eq_int(l3, 2, "a newline") end
    end
    test "a text anchored at the bottom right ends at that corner" do
      let u = Tx.text(screen(), Uw.bottom_right(), 0.0, 0.0, 1, 40.0, white(), "HH")
      Test.assert_true(at(u, 1, 2) > 780.0 && at(u, 1, 2) < 815.0, "the last glyph ends near the right edge")
      Test.assert_true(at(u, 1, 3) < 615.0 && at(u, 1, 3) > 560.0, "and near the bottom")
    end
    test "runs of different sizes share a baseline and follow one another" do
      let u = Tx.runs(screen(), Uw.top_left(), 10.0, 10.0, Tx.style(), Cons((1, 40.0, white(), "H"), Cons((1, 20.0, (1.0, 0.0, 0.0, 1.0), "H"), Nil)))
      Test.assert_eq_int(Uw.quad_count(u), 2, "two glyphs")
      -- an H sits on the baseline: both bottoms agree, give or take the field's margin at each size
      Test.assert_true(Math.abs((at(u, 0, 3) -. 40.0 *. 8.0 /. 48.0) -. (at(u, 1, 3) -. 20.0 *. 8.0 /. 48.0)) < 1.01, "one baseline")
      Test.assert_true(at(u, 1, 0) > at(u, 0, 0) +. 20.0, "the second follows the first")
      Test.assert_true(at(u, 1, 9) == 0.0, "and keeps its own colour")
    end
  end
end
