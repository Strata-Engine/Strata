-- strata_viewer — fly through a generated world. The first rendering slice:
-- a block registry, a pure terrain function, the greedy mesher, and the
-- Vulkan quad renderer, end to end.
--
--   W A S D   move        mouse / arrows   look
--   space     up          left shift       down        escape   quit
--   left click   carve a sphere out of what you are looking at
--   right click  build a sphere of stone onto it
--
-- The world streams in around the camera and has no edge.
--
-- STRATA_RADIUS=n   horizontal radius in chunks (default 10)
-- STRATA_FRAMES=n   draw n frames, save a screenshot, exit (for scripts)
-- STRATA_SHOT=path  where the screenshot goes (a PPM)
-- STRATA_DIG=1      carve once at frame 10, as a left click would (for scripts)
-- STRATA_SCENE=n    start from fixed camera pose n (see `pose`); with STRATA_FRAMES the run is deterministic
-- STRATA_VSYNC=0    present immediately, for timing
-- STRATA_SIZE=WxH   window size in points (default 1280x800)
--
-- With STRATA_FRAMES set the run is scripted: keyboard and mouse are ignored.
mod StrataViewer do

  needs IO
  needs IO.Process
  needs IO.Spawn

  alias Strata.Blocks as Bk
  alias Strata.Chunk as Ch
  alias Strata.Mesh as Mh
  alias Strata.Noise as Ns
  alias Strata.Math.Mat4 as M4
  alias Strata.Math.Vec3 as V3

  -- ── Blocks ───────────────────────────────────────────────────────────────
  -- ids: 1 stone, 2 dirt, 3 grass, 4 sand, 5 water, 6 snow, 7 wood, 8 leaves
  -- texture ids index the palette: the block id, plus 9 for a grass side
  pfn add(r : Strata.Blocks.Registry, d : Strata.Blocks.Def) : Strata.Blocks.Registry do
    match Bk.register(r, d) do
      Ok((r2, _)) -> r2
      Err(_) -> r
    end
  end

  pfn registry() : Strata.Blocks.Registry do
    let stone = Bk.with_faces(Bk.def(), 1, 1, 1)
    let dirt = Bk.with_faces(Bk.def(), 2, 2, 2)
    let grass = Bk.with_faces(Bk.def(), 3, 2, 9)
    let sand = Bk.with_faces(Bk.def(), 4, 4, 4)
    let water = Bk.with_faces(Bk.with_collide(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false), 5, 5, 5)
    let snow = Bk.with_faces(Bk.def(), 6, 6, 6)
    let wood = Bk.with_faces(Bk.def(), 7, 7, 7)
    let leaves = Bk.with_faces(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Cutout), 8, 8, 8)
    add(add(add(add(add(add(add(add(Bk.empty(), stone), dirt), grass), sand), water), snow), wood), leaves)
  end

  pfn palette() : Unit do
    Strata.Ffi.Vk.set_palette(1, 0.52, 0.53, 0.55, 1.0)
    Strata.Ffi.Vk.set_palette(2, 0.47, 0.34, 0.22, 1.0)
    Strata.Ffi.Vk.set_palette(3, 0.36, 0.62, 0.24, 1.0)
    Strata.Ffi.Vk.set_palette(4, 0.76, 0.70, 0.48, 1.0)
    Strata.Ffi.Vk.set_palette(5, 0.16, 0.42, 0.72, 0.72)
    Strata.Ffi.Vk.set_palette(6, 0.90, 0.92, 0.95, 1.0)
    Strata.Ffi.Vk.set_palette(7, 0.40, 0.28, 0.16, 1.0)
    Strata.Ffi.Vk.set_palette(8, 0.20, 0.47, 0.17, 1.0)
    Strata.Ffi.Vk.set_palette(9, 0.40, 0.42, 0.22, 1.0)
  end

  -- ── Terrain: a pure function of chunk coordinates and seed ───────────────
  pfn sea() : Int do 40 end

  pfn height(wx : Int, wz : Int, seed : Int) : Int do
    let x = int_to_float(wx)
    let z = int_to_float(wz)
    let base = Ns.fbm(x *. 0.005, z *. 0.005, seed)
    let hills = Ns.fbm(x *. 0.021, z *. 0.021, seed + 10)
    let ridge = Ns.ridged_fbm(x *. 0.009, z *. 0.009, seed + 20)
    let mount = Ns.clamp01((base -. 0.5) *. 4.0)
    float_to_int(22.0 +. base *. 34.0 +. hills *. 12.0 +. ridge *. mount *. 52.0)
  end

  pfn heights_go(hs : NativeIntArr, x0 : Int, z0 : Int, seed : Int, i : Int) : NativeIntArr do
    if i >= 1024 do hs else heights_go(NativeArray.set_int(hs, i, height(x0 + i % 32, z0 + i / 32, seed)), x0, z0, seed, i + 1) end
  end
  pfn min_go(hs : NativeIntArr, i : Int, m : Int) : Int do
    if i >= 1024 do m else min_go(hs, i + 1, if NativeArray.get_int(hs, i) < m do NativeArray.get_int(hs, i) else m end) end
  end
  pfn max_go(hs : NativeIntArr, i : Int, m : Int) : Int do
    if i >= 1024 do m else max_go(hs, i + 1, if NativeArray.get_int(hs, i) > m do NativeArray.get_int(hs, i) else m end) end
  end

  pfn block_at(wy : Int, h : Int) : Int do
    if wy > h do (if wy <= sea() do 5 else 0 end)
    else if wy == h do (if h <= sea() + 1 do 4 else if h > 84 do 6 else if h > 72 do 1 else 3 end end end)
    else if wy >= h - 3 do (if h <= sea() + 1 do 4 else if h > 72 do 1 else 2 end end)
    else 1 end end end
  end

  pfn ground_go(a : NativeI32Arr, hs : NativeIntArr, y0 : Int, i : Int) : NativeI32Arr do
    if i >= 32768 do a
    else ground_go(NativeArray.set_i32(a, i, block_at(y0 + i / 1024, NativeArray.get_int(hs, i % 1024))), hs, y0, i + 1) end
  end

  -- A tree stands on a grass column well inside the chunk's footprint, so
  -- its canopy never crosses a chunk's sides; it may cross the top, and each
  -- chunk in the column draws the part of it that falls in its own y range.
  pfn has_tree(wx : Int, wz : Int, h : Int, seed : Int) : Bool do
    h > sea() + 1 && h <= 72 && Ns.hash2(wx, wz, seed + 500) > 0.988
  end

  pfn put(a : NativeI32Arr, x : Int, wy : Int, z : Int, y0 : Int, id : Int, over : Bool) : NativeI32Arr do
    let ly = wy - y0
    if x < 0 || x > 31 || z < 0 || z > 31 || ly < 0 || ly > 31 do a
    else
      let i = x + 32 * (z + 32 * ly)
      if over || NativeArray.get_i32(a, i) == 0 do NativeArray.set_i32(a, i, id) else a end
    end
  end

  pfn canopy_go(a : NativeI32Arr, x : Int, z : Int, top : Int, y0 : Int, k : Int) : NativeI32Arr do
    -- 5 x 5 x 3 of leaves under a 3 x 3 cap; k walks the 100 cells
    if k >= 100 do a
    else
      let layer = k / 25
      let dx = k % 5 - 2
      let dz = (k / 5) % 5 - 2
      let cap = layer == 3
      let skip = (cap && (dx < -1 || dx > 1 || dz < -1 || dz > 1)) || (!cap && (dx == -2 || dx == 2) && (dz == -2 || dz == 2) && layer == 2)
      canopy_go(if skip do a else put(a, x + dx, top - 2 + layer, z + dz, y0, 8, false) end, x, z, top, y0, k + 1)
    end
  end

  pfn trunk_go(a : NativeI32Arr, x : Int, z : Int, wy : Int, top : Int, y0 : Int) : NativeI32Arr do
    if wy > top do a else trunk_go(put(a, x, wy, z, y0, 7, true), x, z, wy + 1, top, y0) end
  end

  pfn trees_go(a : NativeI32Arr, hs : NativeIntArr, x0 : Int, y0 : Int, z0 : Int, seed : Int, i : Int) : NativeI32Arr do
    if i >= 1024 do a
    else
      let x = i % 32
      let z = i / 32
      let h = NativeArray.get_int(hs, i)
      if x >= 2 && x <= 29 && z >= 2 && z <= 29 && has_tree(x0 + x, z0 + z, h, seed) do
        let top = h + 5
        trees_go(trunk_go(canopy_go(a, x, z, top, y0, 0), x, z, h + 1, top, y0), hs, x0, y0, z0, seed, i + 1)
      else trees_go(a, hs, x0, y0, z0, seed, i + 1) end
    end
  end

  doc "The chunk at chunk coordinates (cx, cy, cz) for [seed]. Pure: the same inputs give the same chunk."
  fn terrain(cx : Int, cy : Int, cz : Int, seed : Int) : Strata.Chunk.Chunk do
    let y0 = cy * 32
    let hs = heights_go(NativeArray.make_int(1024, 0), cx * 32, cz * 32, seed, 0)
    let lo = min_go(hs, 0, 100000)
    let hi = max_go(hs, 0, -100000)
    let roof = (if hi > sea() do hi else sea() end) + 8
    if y0 > roof do Ch.uniform(0)
    else if y0 + 31 < lo - 3 do Ch.uniform(1)
    else Ch.from_flat(trees_go(ground_go(NativeArray.make_i32(32768, 0), hs, y0, 0), hs, cx * 32, y0, cz * 32, seed, 0)) end end
  end

  -- ── Chunk slots on the GPU ───────────────────────────────────────────────
  -- Each loaded chunk with a mesh owns one renderer slot: key -> slot, the
  -- slots handed back by unloaded chunks, and the next never-used slot.
  type Slots = Slots(Strata.Store.Store(Int), List(Int), Int)

  pfn slot_for(sl : Slots, k : Strata.Coord.Key) : (Slots, Int) do
    match sl do
      Slots(owned, free, next) ->
        let have = Strata.Store.get(owned, k)
        if have >= 0 do (sl, have)
        else
          match free do
            Cons(f, rest) -> (Slots(Strata.Store.put(owned, k, f), rest, next), f)
            Nil -> (Slots(Strata.Store.put(owned, k, next), Nil, next + 1), next)
          end
        end
    end
  end

  pfn upload_layer(slot : Int, m : Strata.Mesh.Meshed, l : Int, k : Strata.Coord.Key) : Int do
    -- an empty layer is uploaded too: it clears what the slot held before
    if Strata.Ffi.Vk.chunk_upload(slot, l, Mh.quads_at(m, l), Mh.quad_count_at(m, l), 32 * Strata.Coord.kx(k), 32 * Strata.Coord.ky(k), 32 * Strata.Coord.kz(k)) do 0 else 1 end
  end

  pfn upload_all(sl : Slots, ms : List((Strata.Coord.Key, Strata.Mesh.Meshed)), refused : Int) : (Slots, Int) do
    match ms do
      Nil -> (sl, refused)
      Cons((k, m), t) ->
        match slot_for(sl, k) do
          (sl2, slot) -> upload_all(sl2, t, refused + upload_layer(slot, m, 0, k) + upload_layer(slot, m, 1, k) + upload_layer(slot, m, 2, k))
        end
    end
  end

  pfn free_all(sl : Slots, gone : List(Strata.Coord.Key)) : Slots do
    match gone do
      Nil -> sl
      Cons(k, t) ->
        match sl do
          Slots(owned, free, next) ->
            let slot = Strata.Store.get(owned, k)
            if slot < 0 do free_all(sl, t)
            else
              Strata.Ffi.Vk.chunk_free(slot)
              free_all(Slots(Strata.Store.remove(owned, k), Cons(slot, free), next), t)
            end
        end
    end
  end

  -- Move finished meshes and unloads from the stream to the renderer.
  pfn sync(s : Strata.Stream.Stream, sl : Slots) : (Strata.Stream.Stream, Slots) do
    match Strata.Stream.take_meshes(s) do
      (s2, ms) ->
        match Strata.Stream.take_unloads(s2) do
          (s3, gone) ->
            match upload_all(free_all(sl, gone), ms, 0) do
              (sl2, _) -> (s3, sl2)
            end
        end
    end
  end

  -- ── The camera and the frame loop ────────────────────────────────────────
  pfn axis(pos : Bool, neg : Bool) : Float do (if pos do 1.0 else 0.0 end) -. (if neg do 1.0 else 0.0 end) end
  pfn clampf(v : Float, lo : Float, hi : Float) : Float do if v < lo do lo else if v > hi do hi else v end end end

  -- Left click carves, right click builds, each once per press.
  pfn act(s : Strata.Stream.Stream, reg : Strata.Blocks.Registry, x : Float, y : Float, z : Float, fx : Float, fy : Float, fz : Float, dig : Bool, build : Bool) : Strata.Stream.Stream do
    if !dig && !build do s
    else
      let w = Strata.Stream.world(s)
      let h = Strata.Query.raycast(w, x, y, z, fx, fy, fz, 250.0, Strata.Query.targetable(reg))
      if !Strata.Query.is_hit(h) do s
      else if dig do Strata.Stream.apply(s, Strata.Edit.fill_sphere(w, Strata.Query.hit_x(h), Strata.Query.hit_y(h), Strata.Query.hit_z(h), 6, 0))
      else Strata.Stream.apply(s, Strata.Edit.fill_sphere(w, Strata.Query.hit_x(h), Strata.Query.hit_y(h) + 2, Strata.Query.hit_z(h), 2, 1)) end end
    end
  end

  pfn ms2(v : Float) : String do float_to_string(Math.round(v *. 100.0) /. 100.0) end

  -- position, yaw, pitch, the chunk the camera was last in, mouse buttons last frame
  type Cam = Cam(Float, Float, Float, Float, Float, Int, Int, Int, Bool, Bool)

  pfn frame_loop(s : Strata.Stream.Stream, sl : Slots, reg : Strata.Blocks.Registry, cam : Cam, frame : Int, frames : Int, t_prev : Float, t_mark : Float, vp : NativeF32Arr) : Unit do
    Strata.Ffi.Vk.poll()
    if Strata.Ffi.Vk.should_close() || Strata.Ffi.Vk.key(256) || (frames > 0 && frame >= frames) do Strata.Stream.stop(s)
    else
      match cam do
        Cam(x, y, z, yaw, pitch, kx0, ky0, kz0, lb0, rb0) ->
          let now = Strata.Ffi.Vk.time()
          let dt = clampf(now -. t_prev, 0.0, 0.1)
          -- a scripted run ignores the keyboard and mouse
          let live = if frames > 0 do 0.0 else 1.0 end
          let yaw2 = yaw +. live *. (Strata.Ffi.Vk.mouse_dx() *. 0.0025 +. axis(Strata.Ffi.Vk.key(262), Strata.Ffi.Vk.key(263)) *. dt *. 1.6)
          let pitch2 = clampf(pitch -. live *. (Strata.Ffi.Vk.mouse_dy() *. 0.0025 -. axis(Strata.Ffi.Vk.key(265), Strata.Ffi.Vk.key(264)) *. dt *. 1.2), -1.5, 1.5)
          let fx = Math.sin(yaw2) *. Math.cos(pitch2)
          let fy = Math.sin(pitch2)
          let fz = 0.0 -. Math.cos(yaw2) *. Math.cos(pitch2)
          let speed = 40.0 *. dt *. live
          let fwd = axis(Strata.Ffi.Vk.key(87), Strata.Ffi.Vk.key(83)) *. speed
          let side = axis(Strata.Ffi.Vk.key(68), Strata.Ffi.Vk.key(65)) *. speed
          let up = axis(Strata.Ffi.Vk.key(32), Strata.Ffi.Vk.key(340)) *. speed
          let x2 = x +. fx *. fwd +. Math.cos(yaw2) *. side
          let y2 = y +. fy *. fwd +. up
          let z2 = z +. fz *. fwd +. Math.sin(yaw2) *. side
          -- the stream: refocus when the camera enters another chunk, then one tick
          let kx = Strata.Coord.chunk_of(float_to_int(Math.floor(x2)))
          let ky = Strata.Coord.chunk_of(float_to_int(Math.floor(y2)))
          let kz = Strata.Coord.chunk_of(float_to_int(Math.floor(z2)))
          let s1 = if kx != kx0 || ky != ky0 || kz != kz0 do Strata.Stream.set_focus(s, Cons((x2, y2, z2), Nil)) else s end
          let lb = frames == 0 && Strata.Ffi.Vk.mouse_button(0)
          let rb = frames == 0 && Strata.Ffi.Vk.mouse_button(1)
          let s2 = Strata.Stream.tick(act(s1, reg, x2, y2, z2, fx, fy, fz, (lb && !lb0) || (frame == 10 && Env.get_int("STRATA_DIG", 0) == 1), rb && !rb0))
          match sync(s2, sl) do
            (s3, sl2) ->
              let aspect = int_to_float(Strata.Ffi.Vk.fb_w()) /. int_to_float(if Strata.Ffi.Vk.fb_h() < 1 do 1 else Strata.Ffi.Vk.fb_h() end)
              let view = M4.look_at(V3.new(x2, y2, z2), V3.new(x2 +. fx, y2 +. fy, z2 +. fz), V3.new(0.0, 1.0, 0.0))
              let vp2 = M4.mul_into_f32(M4.perspective(1.15, aspect, 0.1, 1200.0), view, vp)
              Strata.Ffi.Vk.set_camera(vp2)
              Strata.Ffi.Vk.set_eye(x2, y2, z2, 1.0)
              if frames > 0 && frame == frames - 3 do Strata.Ffi.Vk.request_shot() else () end
              -- the result is used, not dropped: a zero-argument extern bound to an unused name is optimised away (cube_forge GAPS G16)
              let next = if Strata.Ffi.Vk.frame() do frame + 1 else frame end
              let cam2 = Cam(x2, y2, z2, yaw2, pitch2, kx, ky, kz, lb, rb)
              if next != frame && frame % 240 == 239 do
                println("  " ++ float_to_string(Math.round(240.0 /. (now -. t_mark))) ++ " fps; shim " ++ ms2(Strata.Ffi.Vk.stat(0)) ++ " ms, waiting " ++ ms2(Strata.Ffi.Vk.stat(1)) ++ " ms, gpu " ++ ms2(Strata.Ffi.Vk.stat(3)) ++ " ms; " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(2))) ++ " draw calls, " ++ int_to_string(Strata.Ffi.Vk.drawn_chunks()) ++ " chunks, " ++ int_to_string(Strata.Ffi.Vk.drawn_quads()) ++ " quads; " ++ int_to_string(Strata.Stream.loaded_count(s3)) ++ " chunks loaded")
                frame_loop(s3, sl2, reg, cam2, next, frames, now, now, vp2)
              else frame_loop(s3, sl2, reg, cam2, next, frames, now, t_mark, vp2) end
          end
      end
    end
  end

  -- The window size from STRATA_SIZE=WxH, or 1280 x 800.
  pfn window_size() : (Int, Int) do
    match String.split(Env.get("STRATA_SIZE", "1280x800"), "x") do
      Cons(a, Cons(b, Nil)) ->
        match (String.to_int(a), String.to_int(b)) do
          (Ok(w), Ok(h)) -> if w >= 64 && h >= 64 && w <= 8192 && h <= 8192 do (w, h) else (1280, 800) end
          _ -> (1280, 800)
        end
      _ -> (1280, 800)
    end
  end

  -- Fixed camera poses for scripted runs and golden images: (x, y, z, yaw, pitch).
  --   1 overview      high over the hills, the lake ahead
  --   2 shore         low over the water, along the shoreline
  --   3 forest floor  among the trees, looking level
  -- Any other number is the overview.
  -- The first column, walking a fixed grid outward from the origin, whose
  -- ground lies at least four blocks under the water: somewhere to look at
  -- water from. The origin if the grid finds none.
  pfn deep_water(seed : Int, i : Int) : (Int, Int) do
    if i >= 4096 do (0, 0)
    else
      let x = (i % 64 - 32) * 8
      let z = (i / 64 - 32) * 8
      if height(x, z, seed) <= sea() - 4 do (x, z) else deep_water(seed, i + 1) end
    end
  end

  pfn pose(scene : Int, seed : Int) : (Float, Float, Float, Float, Float) do
    if scene == 2 do
      match deep_water(seed, 0) do
        (wx, wz) -> (int_to_float(wx) +. 0.5, int_to_float(sea()) +. 3.5, int_to_float(wz) +. 0.5, 0.9, -0.15)
      end
    else if scene == 3 do (-40.0, int_to_float(height(-40, 60, seed)) +. 2.6, 60.0, 0.62, -0.05)
    else (-70.0, int_to_float(height(0, 0, seed)) +. 46.0, 96.0, 0.62, -0.42) end end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let r = Env.get_int("STRATA_RADIUS", 10)
    let frames = Env.get_int("STRATA_FRAMES", 0)
    let seed = Env.get_int("STRATA_SEED", 7)
    let size = window_size()
    let start = pose(Env.get_int("STRATA_SCENE", 1), seed)
    if !Strata.Ffi.Vk.open(match size do (w, _) -> w end, match size do (_, h) -> h end, frames == 0) do println("strata_viewer: could not open a Vulkan window")
    else
      Strata.Ffi.Vk.set_vsync(Env.get_int("STRATA_VSYNC", 1) != 0)
      let reg = registry()
      palette()
      Strata.Ffi.Vk.set_sun(0.45, 0.80, 0.35, 0.30)
      Strata.Ffi.Vk.set_sky(0.53, 0.72, 0.92)
      -- chunks are meshed out to one short of the radius, so the fog closes there
      Strata.Ffi.Vk.set_fog(int_to_float(r - 1) *. 32.0 *. 0.55, int_to_float(r - 1) *. 32.0)
      let ex = match start do (x, _, _, _, _) -> x end
      let ey = match start do (_, y, _, _, _) -> y end
      let ez = match start do (_, _, z, _, _) -> z end
      let yaw0 = match start do (_, _, _, a, _) -> a end
      let pitch0 = match start do (_, _, _, _, a) -> a end
      let world = Strata.World.new(reg, Strata.Terrain.gen(fn (k, sd) -> terrain(Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), sd)), seed, 1.0)
      let t0 = Strata.Ffi.Vk.time()
      let s0 = Strata.Stream.run_until_settled(Strata.Stream.set_focus(Strata.Stream.start(world, Strata.Stream.config(r, 3, 32, 8)), Cons((ex, ey, ez), Nil)), 1000000)
      let t1 = Strata.Ffi.Vk.time()
      match sync(s0, Slots(Strata.Store.empty(-1), Nil, 0)) do
        (s1, sl) ->
          println("strata_viewer: " ++ int_to_string(Strata.Stream.loaded_count(s1)) ++ " chunks streamed in " ++ float_to_string(Math.round((t1 -. t0) *. 1000.0)) ++ " ms; " ++ int_to_string(Strata.Ffi.Vk.live_quads()) ++ " quads, " ++ int_to_string(Strata.Ffi.Vk.live_quads() * 8 / 1024) ++ " KB on the GPU")
          let cam = Cam(ex, ey, ez, yaw0, pitch0, Strata.Coord.chunk_of(float_to_int(Math.floor(ex))), Strata.Coord.chunk_of(float_to_int(Math.floor(ey))), Strata.Coord.chunk_of(float_to_int(Math.floor(ez))), false, false)
          frame_loop(s1, sl, reg, cam, 0, frames, Strata.Ffi.Vk.time(), Strata.Ffi.Vk.time(), NativeArray.make_f32(16, 0.0))
      end
      Strata.Ffi.Vk.close()
    end
  end
end
