-- strata_viewer — fly through a generated world. The first rendering slice:
-- a block registry, a pure terrain function, the greedy mesher, and the
-- Vulkan quad renderer, end to end.
--
--   W A S D   move        mouse / arrows   look        escape   quit
--   space     jump        F   switch between walking and flying
--   (flying: space rises, left shift sinks)
--   left click   carve a sphere out of what you are looking at
--   right click  build a sphere of stone onto it
--   L   step through the light modes        [ and ]   lower and raise the sun
--   N   play a recording from viewer/sounds/ (WAV, FLAC, MP3) 5 m ahead
--   H   switch sound between headphones (3D) and speakers
--
-- The world streams in around the camera and has no edge: a 2 km island,
-- read from Strata.Atlas, in a sea that goes on.
--
-- STRATA_LIGHT_BOX=n the light volume's horizontal radius in chunks (default: the stream's)
-- STRATA_SLAB_AT=f, STRATA_SLAB_OFF=f   scene 12: the frame its slab appears at, and the frame it goes
-- STRATA_LIGHT=n     light mode: 0 the old flat shading, 1 sky and sun, 2 + shadows, 3 + reflections, 4 + sky light (default), 9 the light volume
-- STRATA_FLUID=0     stop the water from moving
-- STRATA_FLUID_CAP=n, STRATA_FLUID_REACH=n   the fluid's cell cap a step and its way-down search (defaults 4096, 16)
-- STRATA_SPLASH=f     scene 21: drop a block of water from 12 cells up, and one cell from 4, at frame f
-- STRATA_SPRAY=0      no spray from falling water;  STRATA_FOUNTAIN=n  n spray particles a frame ahead of the camera
-- STRATA_ISLAND=0    the old noise terrain instead of the atlas island (default 1: the island)
-- STRATA_ATLAS_DIR=d  where the island's atlas is cached (default .march/atlas)
-- STRATA_CHUNK_TIMES=1  time 200 surface chunks of the land in use, print the median and worst, then run as usual
-- STRATA_BREACH=f     scenes 18 and 19: breach the test lake's rim at frame f
-- STRATA_DRAIN=f      open a shaft in the test lake's floor at frame f
-- STRATA_SUN2=deg, STRATA_SUN2_AT=f   move the sun to that height at that frame
-- STRATA_SUN=deg    the sun's height above the horizon in degrees (default 55)
-- STRATA_HIDDEN=1    never show the window (use with STRATA_OFFSCREEN=1)
-- STRATA_PIXELS=1    STRATA_SIZE is in pixels, not points: the same image on any display
-- STRATA_RADIUS=n   horizontal radius in chunks (default 10)
-- STRATA_FRAMES=n   draw n frames, save a screenshot, exit (for scripts)
-- STRATA_SHOT=path  where the screenshot goes (a PPM)
-- STRATA_DIG=1      carve once at frame 10, as a left click would (for scripts)
-- STRATA_SCENE=n    start from fixed camera pose n (see `pose`); with STRATA_FRAMES the run is deterministic
-- STRATA_VSYNC=0    present immediately, for timing
-- STRATA_SIZE=WxH   window size in points (default 1280x800)
-- STRATA_OFFSCREEN=1 render without presenting, so frames are not paced by the display (timing)
-- STRATA_PAD_CMDS=n append n empty draw commands to each indirect call (measurement)
-- STRATA_LIGHT=n    light mode (0: the shading from before ray tracing)
-- STRATA_QUADS=n    how many quads the GPU buffer holds (default 8388608)
-- STRATA_REBUILD_AT=f  rebuild the swapchain at frame f, as a resize would (scripted runs)
--
-- STRATA_SOAK=n     fly a fixed circuit for n frames, carving a sphere every 100, then report
-- STRATA_AUDIO=0|1|null|wav:path   sound off (scripted default), the device (playing default), the silent null device, or rendered to a WAV in game time
-- STRATA_AUDIO_METER=1   a line of voices, refusals, underruns, CPU and level once a second
-- STRATA_STALL=n    hold the main thread 100 ms every n frames, as a hitch would (soak runs)
--                   the worst and mean frame time and what the renderer still holds
--
-- With STRATA_FRAMES or STRATA_SOAK set the run is scripted: keyboard and mouse are ignored.
mod StrataViewer do

  needs IO
  needs IO.Process
  needs IO.Spawn
  needs IO.Foreign
  needs Audio
  needs IO.FileSystem

  alias Strata.Blocks as Bk
  alias Strata.Chunk as Ch
  alias Strata.Mesh as Mh
  alias Strata.Noise as Ns
  alias Strata.Math.Mat4 as M4
  alias Strata.Math.Vec3 as V3

  -- ── Blocks ───────────────────────────────────────────────────────────────
  -- ids: 1 stone, 2 dirt, 3 grass, 4 sand, 5 water, 6 snow, 7 wood, 8 leaves,
  -- 9 a block whose texture id (999) no layer has: it must draw as 'missing',
  -- 10 red glass (see-through, translucent), 11 tall grass (a cross),
  -- 12 a lantern post (a model: a thin post under a wider cap), 13 ice (smooth: it mirrors),
  -- 14..21 lake water, a fluid: one id per eighth of a voxel it fills (21 is full).
  -- Water (5) is the sea: it never moves, and swallows lake water that reaches it.
  -- texture ids are StrataViewer.Textures layers: the block id, plus 9 for a grass side
  pfn add(r : Strata.Blocks.Registry, d : Strata.Blocks.Def) : Strata.Blocks.Registry do
    match Bk.register(r, d) do
      Ok((r2, _)) -> r2
      Err(_) -> r
    end
  end

  -- The lantern post: what it looks like, and the boxes it collides by.
  pfn post_shape() : Strata.Model.Geometry do
    Strata.Model.box(Strata.Model.box(Strata.Model.empty(), 0.42, 0.0, 0.42, 0.58, 0.75, 0.58, 7), 0.3, 0.75, 0.3, 0.7, 1.0, 0.7, 4)
  end
  pfn post_boxes() : List(Strata.Blocks.Box) do
    Cons(Strata.Blocks.Box(0.42, 0.0, 0.42, 0.58, 0.75, 0.58), Cons(Strata.Blocks.Box(0.3, 0.75, 0.3, 0.7, 1.0, 0.7), Nil))
  end

  doc "The first id of the lake water family; the full voxel is this plus 7."
  fn lake_base() : Int do 14 end

  doc "The viewer's blocks."
  fn registry() : Strata.Blocks.Registry do
    let stone = Bk.with_faces(Bk.def(), 1, 1, 1)
    let dirt = Bk.with_faces(Bk.def(), 2, 2, 2)
    let grass = Bk.with_faces(Bk.def(), 3, 2, 9)
    let sand = Bk.with_faces(Bk.def(), 4, 4, 4)
    -- roughness: water 10 and ice 20 mirror, snow 140 carries a soft highlight, the rest are fully rough
    let water = Bk.with_material(Bk.with_faces(Bk.with_collide(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false), 5, 5, 5), 10, 0)
    let ice = Bk.with_material(Bk.with_faces(Bk.def(), 12, 12, 12), 20, 0)
    let snow = Bk.with_material(Bk.with_faces(Bk.def(), 6, 6, 6), 140, 0)
    let wood = Bk.with_faces(Bk.def(), 7, 7, 7)
    let leaves = Bk.with_faces(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Cutout), 8, 8, 8)
    let bad = Bk.with_faces(Bk.def(), 999, 999, 999)
    let glass = Bk.with_faces(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), 10, 10, 10)
    let tall = Bk.with_faces(Bk.with_collide(Bk.with_style(Bk.with_opacity(Bk.def(), Strata.Blocks.Clear), Strata.Blocks.Cross), false), 11, 11, 11)
    match Bk.add_model(Bk.empty(), Strata.Model.floats(post_shape()), post_boxes()) do
      (r0, m) ->
        -- the post is a lantern: it gives off warm light
        let post = Bk.with_emission(Bk.with_style(Bk.with_opacity(Bk.def(), Strata.Blocks.Clear), Strata.Blocks.Model(m)), 255, 176, 96, 255)
        let r13 = add(add(add(add(add(add(add(add(add(add(add(add(add(r0, stone), dirt), grass), sand), water), snow), wood), leaves), bad), glass), tall), post), ice)
        match Bk.register_fluid(r13, water) do
          Ok((r21, _)) -> r21
          Err(_) -> r13
        end
    end
  end

  -- Upload the viewer's painted tiles and the registry's block table.
  pfn tiles_go(i : Int, ok : Bool) : Bool do
    if i >= StrataViewer.Textures.count() do ok
    else tiles_go(i + 1, Strata.Ffi.Vk.texture_set(i, StrataViewer.Textures.tile(i)) && ok) end
  end
  pfn textures(reg : Strata.Blocks.Registry) : Bool do
    Strata.Ffi.Vk.textures_create(StrataViewer.Textures.size(), StrataViewer.Textures.count()) && tiles_go(0, true) && Strata.Ffi.Vk.textures_commit() && Strata.Render.upload_blocks(reg) && Strata.Render.upload_models(reg)
  end

  -- ── Terrain: a pure function of chunk coordinates and seed ───────────────
  -- The land is described in metres: frequencies in cycles per metre,
  -- amplitudes in metres. The world's scale (metres a voxel) only decides how
  -- finely that shape is cut into voxels; the viewer runs at 1 m a voxel.
  --
  -- Seeds: Strata.Seed.mix(seed, 1) the base, 2 the hills, 3 the ridges, 4 the island's detail.
  -- Salts for Strata.Seed.cell: 21 trees, 22 / 23 / 24 a lake's centre x, centre z
  -- and radius, 25 lantern posts, 26 tall grass. Salt 27 seeds the snow-patch noise.
  pfn fbm_s() : Strata.Noise.Settings do Ns.settings(0, 3, 2.0, 0.5, 1, 0.0) end
  pfn ridge_s() : Strata.Noise.Settings do Ns.settings(1, 3, 2.0, 0.5, 2, 0.0) end
  pfn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end

  -- Noise in [-1, 1] mapped around 0.5 with spread [k]. The old value-noise
  -- fBm clustered near 0.5 (sd 0.126 base, 0.143 hills); OpenSimplex2 fBm has
  -- sd 0.365, so 0.5 + 0.5 v made the land far hillier. Measured at seed 7 over
  -- 1000 m sampled every 4 m: old height mean 51.78 sd 12.32; with k 0.30 for
  -- the base and 0.40 for the hills, mean 51.14 sd 12.46. The ridge is as it was.
  pfn unit_noise(seed : Int, freq : Float, k : Float, xm : Float, zm : Float) : Float do
    0.5 +. k *. Ns.sample2(fbm_s(), seed, freq, xm, zm)
  end

  -- a fresh [0, 1) value for a column, from its own salt
  pfn roll(wx : Int, wz : Int, seed : Int, salt : Int) : Float do
    Strata.Seed.unit(Strata.Seed.cell(seed, salt, wx, 0, wz))
  end

  -- whole voxels of [scale] metres in [m] metres (a hair over, so 34 m at 0.1 is 340)
  pfn vox(m : Float, scale : Float) : Int do float_to_int(Math.floor(m /. scale +. 0.000001)) end

  -- The sea stands 40 m up. [sea] is whole metres; [sea_v] the same in voxels.
  pfn sea() : Int do 40 end
  pfn sea_v(scale : Float) : Int do vox(int_to_float(sea()), scale) end

  doc "The natural ground height in metres at (xm, zm), lakes not included."
  fn height_m(xm : Float, zm : Float, seed : Int) : Float do
    let base = unit_noise(Strata.Seed.mix(seed, 1), 0.005, 0.30, xm, zm)
    let hills = unit_noise(Strata.Seed.mix(seed, 2), 0.021, 0.40, xm, zm)
    let ridge = Ns.sample2(ridge_s(), Strata.Seed.mix(seed, 3), 0.009, xm, zm)
    let mount = clamp01((base -. 0.5) *. 4.0)
    22.0 +. base *. 34.0 +. hills *. 12.0 +. ridge *. mount *. 52.0
  end

  doc "The natural ground height in whole metres at whole-metre column (wx, wz): the viewer's scripted scenes work in 1 m voxels."
  fn height(wx : Int, wz : Int, seed : Int) : Int do
    float_to_int(height_m(int_to_float(wx), int_to_float(wz), seed))
  end

  -- ── Lakes above sea level ────────────────────────────────────────────────
  -- The map is cut into squares 192 m on a side (six chunks at 1 m a voxel).
  -- A square whose chosen centre stands between 50 and 68 m holds a round
  -- lake: a flat-bedded basin 5 to 8 m deep, filled to one metre below the
  -- centre's height, inside a rim three metres wide raised to at least one
  -- above the water. Lake figures are whole metres.
  pfn fdiv(a : Int, b : Int) : Int do if a >= 0 do a / b else 0 - ((b - 1 - a) / b) end end

  doc "The lake of map square (gx, gz): (centre x, centre z, radius, water line), whole metres. A radius of 0 means the square has none."
  fn lake_of(gx : Int, gz : Int, seed : Int) : (Int, Int, Int, Int) do
    let cx = gx * 192 + 40 + float_to_int(roll(gx, gz, seed, 22) *. 112.0)
    let cz = gz * 192 + 40 + float_to_int(roll(gx, gz, seed, 23) *. 112.0)
    let hc = height(cx, cz, seed)
    if hc < 50 || hc > 68 do (cx, cz, 0, 0) else (cx, cz, 14 + float_to_int(roll(gx, gz, seed, 24) *. 14.99), hc - 1) end
  end

  doc "How deep a lake of radius [rad] is, in metres: its bed is flat, 5 to 8 m under the water line."
  fn lake_depth(rad : Int) : Int do 3 + rad / 5 end

  -- A column's ground height once its square's lake is taken into account,
  -- and the lake's water line over it (0 where there is no lake water), both
  -- in voxels of [scale] metres. (xm, zm) is the column's place and hm its
  -- natural ground height, in metres.
  pfn lake_column(lk : (Int, Int, Int, Int), xm : Float, zm : Float, hm : Float, scale : Float) : (Int, Int) do
    match lk do
      (cx, cz, rad, line) ->
        let dx = xm -. int_to_float(cx)
        let dz = zm -. int_to_float(cz)
        let d2 = dx *. dx +. dz *. dz
        let r = int_to_float(rad)
        let l = int_to_float(line)
        if rad == 0 || d2 > (r +. 3.0) *. (r +. 3.0) do (vox(hm, scale), 0)
        else if d2 > r *. r do (vox(if hm > l +. 1.0 do hm else l +. 1.0 end, scale), 0)
        else
          (vox(l -. int_to_float(lake_depth(rad)), scale), vox(l, scale))
        end end
    end
  end

  doc "The ground height in whole metres at a whole-metre column, lakes included."
  fn ground(wx : Int, wz : Int, seed : Int) : Int do
    let xm = int_to_float(wx)
    let zm = int_to_float(wz)
    match lake_column(lake_of(fdiv(wx, 192), fdiv(wz, 192), seed), xm, zm, height_m(xm, zm, seed), 1.0) do (h, _) -> h end
  end

  -- a chunk's 32 x 32 ground heights, and its lake water lines
  type Columns = Columns(NativeIntArr, NativeIntArr)
  pfn heights_go(hs : NativeIntArr, ws : NativeIntArr, lk : (Int, Int, Int, Int), x0 : Int, z0 : Int, seed : Int, scale : Float, i : Int) : Columns do
    if i >= 1024 do Columns(hs, ws)
    else
      let xm = int_to_float(x0 + i % 32) *. scale
      let zm = int_to_float(z0 + i / 32) *. scale
      match lake_column(lk, xm, zm, height_m(xm, zm, seed), scale) do
        (h, line) -> heights_go(NativeArray.set_int(hs, i, h), NativeArray.set_int(ws, i, line), lk, x0, z0, seed, scale, i + 1)
      end
    end
  end
  pfn min_go(hs : NativeIntArr, i : Int, m : Int) : Int do
    if i >= 1024 do m else min_go(hs, i + 1, if NativeArray.get_int(hs, i) < m do NativeArray.get_int(hs, i) else m end) end
  end
  pfn max_go(hs : NativeIntArr, i : Int, m : Int) : Int do
    if i >= 1024 do m else max_go(hs, i + 1, if NativeArray.get_int(hs, i) > m do NativeArray.get_int(hs, i) else m end) end
  end

  -- hm is a column's ground height in metres; grass grows between one metre over the sea and 72 m
  pfn grassy(hm : Float) : Bool do hm > int_to_float(sea()) +. 1.0 && hm <= 72.0 end

  pfn has_post(wx : Int, wz : Int, hm : Float, seed : Int) : Bool do
    grassy(hm) && roll(wx, wz, seed, 25) > 0.994
  end

  pfn block_at(wx : Int, wy : Int, wz : Int, h : Int, line : Int, sv : Int, scale : Float, seed : Int) : Int do
    let hm = int_to_float(h) *. scale
    -- a lake column: full lake water over a sandy bed
    if line > 0 do (if wy > h do (if wy <= line do lake_base() + 7 else 0 end) else if wy >= h - 3 do 4 else 1 end end)
    else
    -- a lantern post on a few grass columns, tall grass on about a seventh of the rest
    if wy == h + 1 && has_post(wx, wz, hm, seed) do 12
    else if wy == h + 1 && grassy(hm) && roll(wx, wz, seed, 26) > 0.86 do 11
    else if wy > h do (if wy <= sv do 5 else 0 end)
    else if wy == h do (if hm <= int_to_float(sea()) +. 1.0 do 4 else if hm > 84.0 do (if unit_noise(Strata.Seed.mix(seed, 27), 0.06, 0.40, int_to_float(wx) *. scale, int_to_float(wz) *. scale) > 0.62 do 13 else 6 end) else if hm > 72.0 do 1 else 3 end end end)
    else if wy >= h - 3 do (if hm <= int_to_float(sea()) +. 1.0 do 4 else if hm > 72.0 do 1 else 2 end end)
    else 1 end end end end end
    end
  end

  pfn ground_go(a : NativeI32Arr, hs : NativeIntArr, ws : NativeIntArr, x0 : Int, y0 : Int, z0 : Int, sv : Int, scale : Float, seed : Int, i : Int) : NativeI32Arr do
    if i >= 32768 do a
    else ground_go(NativeArray.set_i32(a, i, block_at(x0 + i % 32, y0 + i / 1024, z0 + (i / 32) % 32, NativeArray.get_int(hs, i % 1024), NativeArray.get_int(ws, i % 1024), sv, scale, seed)), hs, ws, x0, y0, z0, sv, scale, seed, i + 1) end
  end

  -- A tree stands on a grass column well inside the chunk's footprint, so
  -- its canopy never crosses a chunk's sides; it may cross the top, and each
  -- chunk in the column draws the part of it that falls in its own y range.
  pfn has_tree(wx : Int, wz : Int, hm : Float, seed : Int) : Bool do
    grassy(hm) && roll(wx, wz, seed, 21) > 0.988
  end

  pfn put(a : NativeI32Arr, x : Int, wy : Int, z : Int, y0 : Int, id : Int, over : Bool) : NativeI32Arr do
    let ly = wy - y0
    if x < 0 || x > 31 || z < 0 || z > 31 || ly < 0 || ly > 31 do a
    else
      let i = x + 32 * (z + 32 * ly)
      if over || NativeArray.get_i32(a, i) == 0 do NativeArray.set_i32(a, i, id) else a end
    end
  end

  pfn canopy_go(a : NativeI32Arr, x : Int, z : Int, top : Int, y0 : Int, k : Int) : NativeI32Arr do
    -- 5 x 5 x 3 of leaves under a 3 x 3 cap; k walks the 100 cells
    if k >= 100 do a
    else
      let layer = k / 25
      let dx = k % 5 - 2
      let dz = (k / 5) % 5 - 2
      let cap = layer == 3
      let skip = (cap && (dx < -1 || dx > 1 || dz < -1 || dz > 1)) || (!cap && (dx == -2 || dx == 2) && (dz == -2 || dz == 2) && layer == 2)
      canopy_go(if skip do a else put(a, x + dx, top - 2 + layer, z + dz, y0, 8, false) end, x, z, top, y0, k + 1)
    end
  end

  pfn trunk_go(a : NativeI32Arr, x : Int, z : Int, wy : Int, top : Int, y0 : Int) : NativeI32Arr do
    if wy > top do a else trunk_go(put(a, x, wy, z, y0, 7, true), x, z, wy + 1, top, y0) end
  end

  pfn trees_go(a : NativeI32Arr, hs : NativeIntArr, ws : NativeIntArr, x0 : Int, y0 : Int, z0 : Int, scale : Float, seed : Int, i : Int) : NativeI32Arr do
    if i >= 1024 do a
    else
      let x = i % 32
      let z = i / 32
      let h = NativeArray.get_int(hs, i)
      if x >= 2 && x <= 29 && z >= 2 && z <= 29 && NativeArray.get_int(ws, i) == 0 && has_tree(x0 + x, z0 + z, int_to_float(h) *. scale, seed) do
        let top = h + 5
        trees_go(trunk_go(canopy_go(a, x, z, top, y0, 0), x, z, h + 1, top, y0), hs, ws, x0, y0, z0, scale, seed, i + 1)
      else trees_go(a, hs, ws, x0, y0, z0, scale, seed, i + 1) end
    end
  end

  doc "The chunk at chunk coordinates (cx, cy, cz) for [seed], in a world of [scale] metres a voxel. Pure: the same inputs give the same chunk."
  fn terrain(scale : Float, cx : Int, cy : Int, cz : Int, seed : Int) : Strata.Chunk.Chunk do
    let y0 = cy * 32
    let sv = sea_v(scale)
    -- the lake squares are 192 m, so the square of a chunk's corner is found in metres
    let lk = lake_of(fdiv(float_to_int(Math.floor(int_to_float(cx * 32) *. scale)), 192), fdiv(float_to_int(Math.floor(int_to_float(cz * 32) *. scale)), 192), seed)
    match heights_go(NativeArray.make_int(1024, 0), NativeArray.make_int(1024, 0), lk, cx * 32, cz * 32, seed, scale, 0) do
      Columns(hs, ws) ->
        let lo = min_go(hs, 0, 100000)
        let hi = max_go(hs, 0, -100000)
        let wet = max_go(ws, 0, sv)
        let roof = (if hi > wet do hi else wet end) + 8
        if y0 > roof do Ch.uniform(0)
        else if y0 + 31 < lo - 3 do Ch.uniform(1)
        else Ch.from_flat(trees_go(ground_go(NativeArray.make_i32(32768, 0), hs, ws, cx * 32, y0, cz * 32, sv, scale, seed, 0), hs, ws, cx * 32, y0, cz * 32, scale, seed, 0)) end end
    end
  end

  -- ── The island: terrain read from the atlas ──────────────────────────────
  -- STRATA_ISLAND=1 (the default): the land is Strata.Atlas's island, read
  -- per column, with 6 m of detail on top. STRATA_ISLAND=0 keeps the noise
  -- terrain above for the goldens that still need it.
  --
  -- A column's height is the atlas height plus detail, damp times 6 m of fBm
  -- (Strata.Seed.mix(seed, 4)). damp = clamp01(distance from the nearest
  -- river sample's bank / (2 * its width)), and 0 over a lake: the land
  -- flattens toward a river and lies still under a lake. Where the bilinear
  -- river width is 1 m or more the column is channel: sink water (id 5)
  -- stands to the river's surface, the atlas height of the nearest river
  -- sample (the bilinear height climbs the banks), over ground lowered
  -- min(1.5, width / 6) m (at least one voxel) under it. A column whose nearest atlas
  -- sample is lake holds the lake fluid, full voxels from its sandy bed (the
  -- atlas bed) to the atlas level. The sea is sink water up to 40 m.
  --
  -- Two clamps keep water from standing beside air: land within 3 m of a lake
  -- column stands at least one metre over its level, and beside a river
  -- (damp below 1) the detail only raises the ground.

  doc "The viewer's island: 512 x 512 atlas samples 4 m apart, a 2 km island 800 m in radius, the sea at 40 m."
  fn island_def() : Strata.Atlas.Def do Strata.Atlas.def(512, 4.0, 800.0, 160.0, 5, 40.0) end

  -- What the viewer's land is: the noise terrain (STRATA_ISLAND=0) or the island of an atlas.
  type Land = Noise | Island(Strata.Atlas.Atlas)

  pfn fmax(p : Float, q : Float) : Float do if p > q do p else q end end
  pfn fmin(p : Float, q : Float) : Float do if p < q do p else q end end

  pfn detail_s() : Strata.Noise.Settings do Ns.settings(0, 4, 2.0, 0.5, 1, 0.0) end

  -- 6 m of fBm at 1/40 cycles per metre, undamped
  pfn detail_raw(xm : Float, zm : Float, seed : Int) : Float do
    6.0 *. Ns.sample2(detail_s(), Strata.Seed.mix(seed, 4), 0.025, xm, zm)
  end

  -- The atlas around an area, copied once into arrays the generating task
  -- owns (reading the shared atlas column by column ran 45 times slower,
  -- GAPS S15): the first sample (i0, j0), the side, the step, the atlas's n,
  -- then the heights, lake levels and river widths, and the river samples
  -- whose banks lie within two widths of the area, as (x, z, width, height);
  -- last, whether any sample in the window is lake (if not, no rim is looked for).
  type Win = Win(Int, Int, Int, Float, Int, NativeF32Arr, NativeF32Arr, NativeF32Arr, List((Float, Float, Float, Float)), Bool)

  -- how far past an area the window reaches for rivers, in metres
  pfn reach_m() : Float do 64.0 end

  doc "The atlas copied over the area x0..x1, z0..z1 (metres), with 64 m around it for the rivers."
  fn island_window(a : Strata.Atlas.Atlas, x0 : Float, z0 : Float, x1 : Float, z1 : Float) : Win do
    let st = Strata.Atlas.step(a)
    let nn = Strata.Atlas.n(a)
    let i0 = float_to_int(Math.floor((x0 -. reach_m()) /. st)) + nn / 2
    let j0 = float_to_int(Math.floor((z0 -. reach_m()) /. st)) + nn / 2
    let i1 = float_to_int(Math.ceil((x1 +. reach_m()) /. st)) + nn / 2 + 1
    let j1 = float_to_int(Math.ceil((z1 +. reach_m()) /. st)) + nn / 2 + 1
    let side = if i1 - i0 > j1 - j0 do i1 - i0 + 1 else j1 - j0 + 1 end
    let ws = Strata.Atlas.window(a, 4, i0, j0, side)
    let hs = Strata.Atlas.window(a, 0, i0, j0, side)
    let ls = Strata.Atlas.window(a, 2, i0, j0, side)
    Win(i0, j0, side, st, nn, hs, ls, ws, near_go(ws, hs, i0, j0, side, st, nn, x0, z0, x1, z1, 0, Nil), any_lake(ls, 0, side * side))
  end

  pfn any_lake(ls : NativeF32Arr, k : Int, cnt : Int) : Bool do
    if k >= cnt do false else if NativeArray.get_f32(ls, k) >= 0.0 do true else any_lake(ls, k + 1, cnt) end end
  end

  pfn near_go(ws : NativeF32Arr, hs : NativeF32Arr, i0 : Int, j0 : Int, side : Int, st : Float, nn : Int, x0 : Float, z0 : Float, x1 : Float, z1 : Float, k : Int, acc : List((Float, Float, Float, Float))) : List((Float, Float, Float, Float)) do
    if k >= side * side do acc
    else
      let w = NativeArray.get_f32(ws, k)
      if w <= 0.0 do near_go(ws, hs, i0, j0, side, st, nn, x0, z0, x1, z1, k + 1, acc)
      else
        let x = int_to_float(i0 + k % side - nn / 2) *. st
        let z = int_to_float(j0 + k / side - nn / 2) *. st
        let reach = 2.5 *. w
        let near = if x < x0 -. reach || x > x1 +. reach do false else if z < z0 -. reach do false else z <= z1 +. reach end end
        near_go(ws, hs, i0, j0, side, st, nn, x0, z0, x1, z1, k + 1, if near do Cons((x, z, w, NativeArray.get_f32(hs, k)), acc) else acc end)
      end
    end
  end

  -- a window layer at a position: bilinear, as Strata.Atlas.height_at does it
  pfn win_bilinear(wn : Win, arr : NativeF32Arr, xm : Float, zm : Float) : Float do
    match wn do
      Win(i0, j0, side, st, nn, _, _, _, _, _) ->
        let gx = xm /. st +. int_to_float(nn / 2) -. int_to_float(i0)
        let gz = zm /. st +. int_to_float(nn / 2) -. int_to_float(j0)
        let fx = Math.floor(gx)
        let fz = Math.floor(gz)
        let i = float_to_int(fx)
        let j = float_to_int(fz)
        let tx = gx -. fx
        let tz = gz -. fz
        let a0 = NativeArray.get_f32(arr, i + side * j) *. (1.0 -. tx) +. NativeArray.get_f32(arr, i + 1 + side * j) *. tx
        let a1 = NativeArray.get_f32(arr, i + side * (j + 1)) *. (1.0 -. tx) +. NativeArray.get_f32(arr, i + 1 + side * (j + 1)) *. tx
        a0 *. (1.0 -. tz) +. a1 *. tz
    end
  end

  -- the lake level of the sample nearest a position (-1: none), as Strata.Atlas.lake_at
  pfn win_lake(wn : Win, xm : Float, zm : Float) : Float do
    match wn do
      Win(i0, j0, side, st, nn, _, ls, _, _, _) ->
        let i = float_to_int(Math.floor(xm /. st +. int_to_float(nn / 2) +. 0.5)) - i0
        let j = float_to_int(Math.floor(zm /. st +. int_to_float(nn / 2) +. 0.5)) - j0
        NativeArray.get_f32(ls, i + side * j)
    end
  end

  -- the highest lake level among the samples whose water can come within
  -- 3 m of a position: those within 3 m + half a diagonal step of it (a lake
  -- column's nearest sample is at most that far off), in the 4 x 4 samples
  -- around it; -1 if none is lake
  pfn win_rim(wn : Win, xm : Float, zm : Float) : Float do
    match wn do
      Win(i0, j0, side, st, nn, _, ls, _, _, wet) ->
        if !wet do 0.0 -. 1.0
        else rim_go(ls, i0, j0, side, st, nn, float_to_int(Math.floor(xm /. st)) + nn / 2, float_to_int(Math.floor(zm /. st)) + nn / 2, xm, zm, 3.0 +. st *. 0.70711, 0, 0.0 -. 1.0) end
    end
  end
  pfn rim_go(ls : NativeF32Arr, i0 : Int, j0 : Int, side : Int, st : Float, nn : Int, gi : Int, gj : Int, xm : Float, zm : Float, reach : Float, t : Int, best : Float) : Float do
    if t >= 16 do best
    else
      let i = gi + t % 4 - 1
      let j = gj + t / 4 - 1
      let dx = int_to_float(i - nn / 2) *. st -. xm
      let dz = int_to_float(j - nn / 2) *. st -. zm
      let v = if dx *. dx +. dz *. dz > reach *. reach do 0.0 -. 1.0 else NativeArray.get_f32(ls, (i - i0) + side * (j - j0)) end
      rim_go(ls, i0, j0, side, st, nn, gi, gj, xm, zm, reach, t + 1, fmax(v, best))
    end
  end

  -- damp from the rivers in rs: the least of clamp01(bank distance / (2 width))
  pfn river_damp(rs : List((Float, Float, Float, Float)), xm : Float, zm : Float, best : Float) : Float do
    match rs do
      Nil -> best
      Cons((x, z, w, _), rest) ->
        let dx = xm -. x
        let dz = zm -. z
        let v = clamp01((Math.sqrt(dx *. dx +. dz *. dz) -. 0.5 *. w) /. (2.0 *. w))
        river_damp(rest, xm, zm, if v < best do v else best end)
    end
  end

  -- the height of the river sample nearest a position: the river's surface there
  pfn river_surface(rs : List((Float, Float, Float, Float)), xm : Float, zm : Float, bd : Float, bh : Float) : Float do
    match rs do
      Nil -> bh
      Cons((x, z, _, h), rest) ->
        let dd = (xm -. x) *. (xm -. x) +. (zm -. z) *. (zm -. z)
        if dd < bd do river_surface(rest, xm, zm, dd, h) else river_surface(rest, xm, zm, bd, bh) end
    end
  end

  -- detail times damp at a position; 0 over a lake, and never negative beside a river
  pfn damped(wn : Win, xm : Float, zm : Float, seed : Int) : Float do
    if win_lake(wn, xm, zm) >= 0.0 do 0.0
    else
      let dm = match wn do Win(_, _, _, _, _, _, _, _, rs, _) -> river_damp(rs, xm, zm, 1.0) end
      let v = detail_raw(xm, zm, seed) *. dm
      if dm < 1.0 && v < 0.0 do 0.0 else v end
    end
  end

  doc "The island's ground height in metres at (xm, zm) before it is cut into voxels: the atlas height plus the damped detail (no channel, rim or lake bed applied)."
  fn island_height_m(a : Strata.Atlas.Atlas, xm : Float, zm : Float, seed : Int) : Float do
    let wn = island_window(a, xm, zm, xm, zm)
    match wn do Win(_, _, _, _, _, hs, _, _, _, _) -> win_bilinear(wn, hs, xm, zm) +. damped(wn, xm, zm, seed) end
  end

  -- A column at (xm, zm) of a world of [scale] metres a voxel: (ground, lake
  -- water line, river water line) in voxels; a line is 0 where that water is not.
  pfn island_col(wn : Win, xm : Float, zm : Float, seed : Int, scale : Float) : (Int, Int, Int) do
    match wn do
      Win(_, _, _, _, _, hs, _, ws, _, _) ->
        let h = win_bilinear(wn, hs, xm, zm)
        let lake = win_lake(wn, xm, zm)
        let w = win_bilinear(wn, ws, xm, zm)
        if lake >= 0.0 do (vox(h, scale), vox(lake, scale), 0)
        else if w >= 1.0 do
          let top = match wn do Win(_, _, _, _, _, _, _, _, rs, _) -> river_surface(rs, xm, zm, 1000000.0, h) end
          let line = vox(top, scale)
          let bed = vox(top -. fmin(1.5, w /. 6.0), scale)
          (if bed < line do bed else line - 1 end, 0, line)
        else
          let rim = win_rim(wn, xm, zm)
          let hm = h +. damped(wn, xm, zm, seed)
          (vox(if rim >= 0.0 && hm < rim +. 1.0 do rim +. 1.0 else hm end, scale), 0, 0)
        end end
    end
  end

  doc "The island column at whole-voxel column (wx, wz) of a world of [scale] metres a voxel: (ground, lake water line, river water line) in voxels, a line 0 where there is no such water."
  fn island_column(a : Strata.Atlas.Atlas, wx : Int, wz : Int, seed : Int, scale : Float) : (Int, Int, Int) do
    let xm = int_to_float(wx) *. scale
    let zm = int_to_float(wz) *. scale
    island_col(island_window(a, xm, zm, xm, zm), xm, zm, seed, scale)
  end

  pfn island_go(wn : Win, hs : NativeIntArr, ws : NativeIntArr, vs : NativeIntArr, x0 : Int, z0 : Int, seed : Int, scale : Float, i : Int) : (NativeIntArr, NativeIntArr, NativeIntArr) do
    if i >= 1024 do (hs, ws, vs)
    else
      match island_col(wn, int_to_float(x0 + i % 32) *. scale, int_to_float(z0 + i / 32) *. scale, seed, scale) do
        (h, lake, river) -> island_go(wn, NativeArray.set_int(hs, i, h), NativeArray.set_int(ws, i, lake), NativeArray.set_int(vs, i, river), x0, z0, seed, scale, i + 1)
      end
    end
  end

  -- channel water (sink) over a sandy bed, a lake column as before, else the noise terrain's blocks
  pfn island_block(wx : Int, wy : Int, wz : Int, h : Int, lake : Int, river : Int, sv : Int, scale : Float, seed : Int) : Int do
    if river > 0 do (if wy > h do (if wy <= river || wy <= sv do 5 else 0 end) else if wy >= h - 3 do 4 else 1 end end)
    else block_at(wx, wy, wz, h, lake, sv, scale, seed) end
  end

  pfn island_fill(a : NativeI32Arr, hs : NativeIntArr, ws : NativeIntArr, vs : NativeIntArr, x0 : Int, y0 : Int, z0 : Int, sv : Int, scale : Float, seed : Int, i : Int) : NativeI32Arr do
    if i >= 32768 do a
    else island_fill(NativeArray.set_i32(a, i, island_block(x0 + i % 32, y0 + i / 1024, z0 + (i / 32) % 32, NativeArray.get_int(hs, i % 1024), NativeArray.get_int(ws, i % 1024), NativeArray.get_int(vs, i % 1024), sv, scale, seed)), hs, ws, vs, x0, y0, z0, sv, scale, seed, i + 1) end
  end

  -- 1 where a column holds lake or river water, so no tree stands there
  pfn wet_go(ws : NativeIntArr, vs : NativeIntArr, i : Int, out : NativeIntArr) : NativeIntArr do
    if i >= 1024 do out else wet_go(ws, vs, i + 1, NativeArray.set_int(out, i, NativeArray.get_int(ws, i) + NativeArray.get_int(vs, i))) end
  end

  doc "The island chunk at chunk coordinates (cx, cy, cz) for [seed], read from atlas [a], in a world of [scale] metres a voxel. Pure."
  fn island_terrain(a : Strata.Atlas.Atlas, scale : Float, cx : Int, cy : Int, cz : Int, seed : Int) : Strata.Chunk.Chunk do
    let y0 = cy * 32
    let sv = sea_v(scale)
    let x0m = int_to_float(cx * 32) *. scale
    let z0m = int_to_float(cz * 32) *. scale
    let wn = island_window(a, x0m, z0m, x0m +. 31.0 *. scale, z0m +. 31.0 *. scale)
    match island_go(wn, NativeArray.make_int(1024, 0), NativeArray.make_int(1024, 0), NativeArray.make_int(1024, 0), cx * 32, cz * 32, seed, scale, 0) do
      (hs, ws, vs) ->
        let lo = min_go(hs, 0, 100000)
        let hi = max_go(hs, 0, -100000)
        let wet = max_go(vs, 0, max_go(ws, 0, sv))
        let roof = (if hi > wet do hi else wet end) + 8
        if y0 > roof do Ch.uniform(0)
        else if y0 + 31 < lo - 3 do Ch.uniform(1)
        else Ch.from_flat(trees_go(island_fill(NativeArray.make_i32(32768, 0), hs, ws, vs, cx * 32, y0, cz * 32, sv, scale, seed, 0), hs, wet_go(ws, vs, 0, NativeArray.make_int(1024, 0)), cx * 32, y0, cz * 32, scale, seed, 0)) end end
    end
  end

  doc "The chunk of the viewer's land at key k for seed, in 1 m voxels."
  fn land_chunk(land : Land, k : Strata.Coord.Key, seed : Int) : Strata.Chunk.Chunk do
    match land do
      Noise -> terrain(1.0, Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), seed)
      Island(a) -> island_terrain(a, 1.0, Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), seed)
    end
  end

  doc "The ground height in whole metres at a whole-metre column of the viewer's land, lakes included (a river column's bed)."
  fn land_height(land : Land, wx : Int, wz : Int, seed : Int) : Int do
    match land do
      Noise -> ground(wx, wz, seed)
      Island(a) -> match island_column(a, wx, wz, seed, 1.0) do (h, _, _) -> h end
    end
  end

  -- ── The camera and the frame loop ────────────────────────────────────────
  pfn axis(pos : Bool, neg : Bool) : Float do (if pos do 1.0 else 0.0 end) -. (if neg do 1.0 else 0.0 end) end
  pfn clampf(v : Float, lo : Float, hi : Float) : Float do if v < lo do lo else if v > hi do hi else v end end end

  -- ── The test lake ────────────────────────────────────────────────────────
  -- Direction i of sixteen round the compass, as (dx, dz) scaled by 1000;
  -- a camera with yaw i * pi / 8 looks along it.
  pfn dir_x(i : Int) : Float do Math.sin(int_to_float(i) *. 0.39269908) end
  pfn dir_z(i : Int) : Float do 0.0 -. Math.cos(int_to_float(i) *. 0.39269908) end
  pfn at_x(cx : Int, i : Int, d : Int) : Int do cx + float_to_int(Math.round(dir_x(i) *. int_to_float(d))) end
  pfn at_z(cz : Int, i : Int, d : Int) : Int do cz + float_to_int(Math.round(dir_z(i) *. int_to_float(d))) end

  -- The direction in which the natural ground 10 voxels beyond a lake's rim is lowest.
  pfn low_side(cx : Int, cz : Int, rad : Int, seed : Int, i : Int, best : Int, low : Int) : (Int, Int) do
    if i >= 16 do (best, low)
    else
      let h = height(at_x(cx, i, rad + 10), at_z(cz, i, rad + 10), seed)
      if h < low do low_side(cx, cz, rad, seed, i + 1, i, h) else low_side(cx, cz, rad, seed, i + 1, best, low) end
    end
  end

  -- Walk the 9 x 9 map squares about the origin for the lake a breach will
  -- drain best: the one whose bed stands highest over the ground just
  -- beyond its rim, among those of radius 20 or more; failing any that
  -- large, among all.
  pfn lake_walk(seed : Int, i : Int, bx : Int, bz : Int, brad : Int, bline : Int, bdir : Int, bscore : Int) : (Int, Int, Int, Int, Int) do
    if i >= 81 do (bx, bz, brad, bline, bdir)
    else
      match lake_of(i % 9 - 4, i / 9 - 4, seed) do
        (cx, cz, rad, line) ->
          if rad == 0 do lake_walk(seed, i + 1, bx, bz, brad, bline, bdir, bscore)
          else
            match low_side(cx, cz, rad, seed, 0, 0, 100000) do
              (d, low) ->
                -- how far the bed stands over the ground outside; a large lake outranks any small one
                let score = line - lake_depth(rad) - low + (if rad >= 20 do 1000 else 0 end)
                if score > bscore do lake_walk(seed, i + 1, cx, cz, rad, line, d, score)
                else lake_walk(seed, i + 1, bx, bz, brad, bline, bdir, bscore) end
            end
          end
      end
    end
  end

  doc "The noise terrain's lake the scripted scenes breach: (centre x, centre z, radius, water line, the direction 0..15 of its lowest side). Radius 0 if the seed has no lake near the origin."
  fn test_lake(seed : Int) : (Int, Int, Int, Int, Int) do lake_walk(seed, 0, 0, 0, 0, 0, 0, -100000) end

  -- The island's test lake: the deepest carved lake (level over the bed at
  -- its centre; every bowl has the same radius) within 400 m of the origin,
  -- or failing one, 800 m. [best] is (x, z, level, depth).
  pfn deepest_go(a : Strata.Atlas.Atlas, ls : List((Float, Float, Float)), reach : Float, best : (Float, Float, Float, Float)) : (Float, Float, Float, Float) do
    match ls do
      Nil -> best
      Cons((x, z, lv), rest) ->
        let depth = lv -. Strata.Atlas.height_at(a, x, z)
        let ok = if lv < 0.0 do false else if Math.sqrt(x *. x +. z *. z) > reach do false else depth > (match best do (_, _, _, bd) -> bd end) end end
        deepest_go(a, rest, reach, if ok do (x, z, lv, depth) else best end)
    end
  end

  -- The island lake's outlet: down the flood's receivers from sample (i, j),
  -- the first sample off the lake whose receiver is off it too (a bump in
  -- the water that drains back into it is passed over), as (x, z): where
  -- the lake spills into the river leaving it.
  pfn outlet_go(a : Strata.Atlas.Atlas, i : Int, j : Int, left : Int) : (Float, Float) do
    let nn = Strata.Atlas.n(a)
    let st = Strata.Atlas.step(a)
    let r = Strata.Atlas.receiver_ij(a, i, j)
    let off = Strata.Atlas.lake_ij(a, i, j) < 0.0
    let away = if r < 0 do true else Strata.Atlas.lake_ij(a, r % nn, r / nn) < 0.0 end
    let out = if off do away else false end   -- not `&&`: GAPS S16
    if out || r < 0 || left <= 0 do (int_to_float(i - nn / 2) *. st, int_to_float(j - nn / 2) *. st)
    else outlet_go(a, r % nn, r / nn, left - 1) end
  end

  -- how far along direction d from (cx, cz) the first column stands at or over the water line: the water's edge
  pfn water_edge(land : Land, cx : Int, cz : Int, d : Int, line : Int, seed : Int, t : Int) : Int do
    if t >= 200 do t
    else if land_height(land, at_x(cx, d, t), at_z(cz, d, t), seed) >= line do t
    else water_edge(land, cx, cz, d, line, seed, t + 1) end end
  end

  -- the nearest of the sixteen compass directions (see dir_x) to (dx, dz)
  pfn dir_of(dx : Float, dz : Float) : Int do
    let i = float_to_int(Math.round(Math.atan2(dx, 0.0 -. dz) /. 0.39269908))
    ((i % 16) + 16) % 16
  end

  doc "The lake the scripted scenes breach on [land]: (centre x, centre z, radius, water line, the direction 0..15 of its lowest side, the bed under its centre, the ground 10 m beyond its rim on that side), whole metres. On the island the lowest side is toward the outlet and the radius is the water's edge on that side. Radius 0 if there is none."
  fn scene_lake(land : Land, seed : Int) : (Int, Int, Int, Int, Int, Int, Int) do
    match land do
      Noise ->
        match test_lake(seed) do
          (cx, cz, rad, line, d) -> (cx, cz, rad, line, d, line - lake_depth(rad), height(at_x(cx, d, rad + 10), at_z(cz, d, rad + 10), seed))
        end
      Island(a) ->
        let near = deepest_go(a, Strata.Atlas.lakes(a), 400.0, (0.0, 0.0, 0.0, 0.0))
        let pick = match near do (_, _, _, dn) -> if dn > 0.0 do near else deepest_go(a, Strata.Atlas.lakes(a), 800.0, (0.0, 0.0, 0.0, 0.0)) end end
        match pick do
          (x, z, lv, depth) ->
            if depth <= 0.0 do (0, 0, 0, 0, 0, 0, 0)
            else
              let cx = float_to_int(Math.round(x))
              let cz = float_to_int(Math.round(z))
              let st = Strata.Atlas.step(a)
              let nn = Strata.Atlas.n(a)
              match outlet_go(a, float_to_int(Math.round(x /. st)) + nn / 2, float_to_int(Math.round(z /. st)) + nn / 2, nn * nn) do
                (ox, oz) ->
                  let d = dir_of(ox -. x, oz -. z)
                  let rad = water_edge(land, cx, cz, d, vox(lv, 1.0), seed, 0)
                  (cx, cz, rad, vox(lv, 1.0), d, land_height(land, cx, cz, seed), land_height(land, at_x(cx, d, rad + 10), at_z(cz, d, rad + 10), seed))
              end
            end
        end
    end
  end

  -- A stream and the fluid that moves in its world.
  type Sim = Sim(Strata.Stream.Stream, Strata.Fluid.Fluid)
  pfn sim_stream(m : Sim) : Strata.Stream.Stream do match m do Sim(s, _) -> s end end
  pfn sim_fluid(m : Sim) : Strata.Fluid.Fluid do match m do Sim(_, f) -> f end end

  -- Apply an edit and tell the fluid about it.
  pfn edit(m : Sim, o : Strata.Edit.Outcome) : Sim do
    match m do
      Sim(s, f) -> Sim(Strata.Stream.apply(s, o), Strata.Fluid.wake(f, Strata.Edit.world(o), o))
    end
  end

  -- Breach the test lake on its lowest side: a channel of carve spheres of
  -- radius 4 through its rim and out, in two rows, one at the water line
  -- and one at the lake's bed, each sphere three voxels further out and (in
  -- the lower row) one lower, so the lake can run out to its floor.
  pfn breach_go(m : Sim, cx : Int, cz : Int, rad : Int, line : Int, bed : Int, d : Int, i : Int) : Sim do
    if i >= 12 do m
    else
      let out = rad - 2 + 3 * (i / 2)
      let y = if i % 2 == 0 do line - 2 else bed + 2 - i / 2 end
      breach_go(edit(m, Strata.Edit.fill_sphere(Strata.Stream.world(sim_stream(m)), at_x(cx, d, out), y, at_z(cz, d, out), 4, 0)), cx, cz, rad, line, bed, d, i + 1)
    end
  end
  pfn breach(m : Sim, tl : (Int, Int, Int, Int, Int, Int, Int)) : Sim do
    match tl do
      (cx, cz, rad, line, d, bed, _) -> if rad == 0 do m else breach_go(m, cx, cz, rad, line, bed, d, 0) end
    end
  end

  -- Open a shaft 3 x 3 and 12 deep in the floor at the middle of the test lake.
  pfn drain_floor(m : Sim, tl : (Int, Int, Int, Int, Int, Int, Int)) : Sim do
    match tl do
      (cx, cz, rad, _, _, bed, _) ->
        if rad == 0 do m
        else edit(m, Strata.Edit.fill_box(Strata.Stream.world(sim_stream(m)), cx - 1, bed - 12, cz - 1, cx + 1, bed, cz + 1, 0)) end
    end
  end

  -- Spray for what the water did this step: a burst where it lands, bigger
  -- for more water and faster for a longer fall; a little mist where it is
  -- still falling.
  pfn spray_events(es : List(Strata.Fluid.Event), n : Int) : Int do
    match es do
      Nil -> n
      Cons(e, t) ->
        let x = int_to_float(Strata.Fluid.ev_x(e)) +. 0.5
        let y = int_to_float(Strata.Fluid.ev_y(e))
        let z = int_to_float(Strata.Fluid.ev_z(e)) +. 0.5
        let eighths = Strata.Fluid.ev_eighths(e)
        if Strata.Fluid.ev_landed(e) do
          let speed = 1.5 +. 0.9 *. Math.sqrt(int_to_float(Strata.Fluid.ev_fell(e)))
          let count = if 2 * eighths > 64 do 64 else 2 * eighths end
          spray_events(t, if Strata.Render.spray(x, y +. 0.3, z, 0.0, speed *. 0.55, 0.0, count, speed *. 0.45, 0.8, 13) do n + count else n end)
        else if eighths >= 4 do
          spray_events(t, if Strata.Render.spray(x, y +. 0.5, z, 0.0, -1.0, 0.0, eighths / 4, 0.6, 0.5, 13) do n + eighths / 4 else n end)
        else spray_events(t, n) end end
    end
  end

  -- Left click carves, right click builds, each once per press.
  pfn act(m : Sim, reg : Strata.Blocks.Registry, x : Float, y : Float, z : Float, fx : Float, fy : Float, fz : Float, dig : Bool, build : Bool, block : Int) : Sim do
    if !dig && !build do m
    else
      let w = Strata.Stream.world(sim_stream(m))
      let h = Strata.Query.raycast(w, x, y, z, fx, fy, fz, 250.0, Strata.Query.targetable(reg))
      if !Strata.Query.is_hit(h) do m
      else if dig do edit(m, Strata.Edit.fill_sphere(w, Strata.Query.hit_x(h), Strata.Query.hit_y(h), Strata.Query.hit_z(h), 6, 0))
      else edit(m, Strata.Edit.fill_sphere(w, Strata.Query.hit_x(h), Strata.Query.hit_y(h) + 2, Strata.Query.hit_z(h), 2, block)) end end
    end
  end

  -- Sound. STRATA_AUDIO=0 off (the default for scripted runs), 1 the device
  -- (the default when playing), null the silent null device, wav:path the
  -- whole session rendered in game time to a file with no device.
  pfn audio_start(frames : Int) : Strata.Sound.Sound do
    let mode = Env.get("STRATA_AUDIO", if frames > 0 do "0" else "1" end)
    let opened = if mode == "1" do Strata.Ffi.Audio.open(false)
      else if mode == "null" do Strata.Ffi.Audio.open_null()
      else if String.starts_with(mode, "wav:") do Strata.Ffi.Audio.render(String.slice_bytes(mode, 4, String.byte_size(mode) - 4))
      else false end end end
    if mode != "0" do println("strata_viewer: sound " ++ (if opened do "on (" ++ mode ++ ")" else "unavailable; running silent" end)) else () end
    let loaded = if opened do load_all(sound_files(), 0) else 0 end
    if loaded > 0 do println("strata_viewer: " ++ int_to_string(loaded) ++ " recordings from viewer/sounds/; N plays one") else () end
    -- the strike patch first (id 1), then a gust whose strength follows how open the sky is
    let s1 = match Strata.Sound.upload(Strata.Sound.new(), Strata.Sound.strike()) do (s, _) -> s end
    match Strata.Sound.with_gust(s1, true) do (s2, _) -> s2 end
  end
  -- the WAV files in viewer/sounds/, in the order listed; loaded at start, so the nth has recording id 2048 + n
  pfn sound_files() : List(String) do
    match Dir.list("sounds") do
      Ok(names) -> List.filter(names, fn n -> String.ends_with(n, ".wav") || String.ends_with(n, ".flac") || String.ends_with(n, ".mp3"))
      Err(_) -> Nil
    end
  end
  pfn load_all(names : List(String), n : Int) : Int do
    match names do
      Nil -> n
      Cons(h, t) -> load_all(t, if Strata.Ffi.Audio.load("sounds/" ++ h) > 0 do n + 1 else n end)
    end
  end
  pfn place_recording(snd : Strata.Sound.Sound, frame : Int, x : Float, y : Float, z : Float) : Strata.Sound.Sound do
    let n = List.length(sound_files())
    if n == 0 do
      println("strata_viewer: no recordings in viewer/sounds/")
      snd
    else
      let id = 2048 + frame % n
      if !Strata.Ffi.Audio.ready(id) do
        println("strata_viewer: recording " ++ int_to_string(id - 2048) ++ " is not ready")
        snd
      else match Strata.Sound.play(Strata.Sound.recorded(snd, id, Strata.Ffi.Audio.length(id)), id, x, y, z, 0.9, 1.0, 1.0) do (s, v) -> Strata.Sound.with_range(s, v, 3.0, 150.0) end end
    end
  end
  -- the strike patch is the first uploaded
  pfn strike_patch() : Int do 1 end
  -- how the viewer's blocks sound underfoot: (hardness, size), its own table
  pfn underfoot(id : Int) : (Float, Float) do
    if id == 1 do (0.9, 0.4)
    else if id == 2 do (0.3, 0.6)
    else if id == 3 || id == 11 do (0.2, 0.5)
    else if id == 4 do (0.12, 0.7)
    else if id == 6 do (0.08, 0.6)
    else if id == 7 do (0.6, 0.6)
    else if id == 13 do (1.0, 0.3)
    else (0.5, 0.5) end end end end end end end
  end
  pfn footstep(snd : Strata.Sound.Sound, id : Int, x : Float, y : Float, z : Float, energy : Float) : Strata.Sound.Sound do
    match underfoot(id) do
      (hard, size) ->
        match Strata.Sound.play(snd, strike_patch(), x, y, z, 0.5, 1.0, 0.5) do
          (s1, v) -> Strata.Sound.control(Strata.Sound.control(Strata.Sound.control(s1, v, 0, hard), v, 1, size), v, 2, energy)
        end
    end
  end
  -- a strike where the view's ray meets the world, or 3 m ahead when it meets nothing
  pfn strike_at(snd : Strata.Sound.Sound, w : Strata.World.World, reg : Strata.Blocks.Registry, x : Float, y : Float, z : Float, fx : Float, fy : Float, fz : Float, hardness : Float, size : Float) : Strata.Sound.Sound do
    let h = Strata.Query.raycast(w, x, y, z, fx, fy, fz, 250.0, Strata.Query.targetable(reg))
    let d = if Strata.Query.is_hit(h) do Strata.Query.hit_dist(h) else 3.0 end
    match Strata.Sound.play(snd, strike_patch(), x +. fx *. d, y +. fy *. d, z +. fz *. d, 0.9, 1.0, 1.0) do
      (s1, v) -> Strata.Sound.control(Strata.Sound.control(Strata.Sound.control(Strata.Sound.with_range(s1, v, 4.0, 250.0), v, 0, hardness), v, 1, size), v, 2, 0.8)
    end
  end
  -- once a frame, last: hand over the frame's sound, mix it in game time if rendering, and with STRATA_AUDIO_METER=1 report once a second
  pfn audio_frame(snd : Strata.Sound.Sound, w : Strata.World.World, fl : Strata.Fluid.Fluid, dt : Float, frame : Int, scripted : Bool, now : Float, t_prev : Float) : Strata.Sound.Sound do
    match Strata.Sound.update(snd, w, fl, dt) do
      (s2, cmds) ->
        let took = Strata.Ffi.Audio.send(cmds)
        Strata.Ffi.Audio.advance(dt)
        let second = if scripted do frame % 60 == 59 else Math.floor(now) != Math.floor(t_prev) end
        if second && took >= 0 && Env.get_int("STRATA_AUDIO_METER", 0) == 1 do
          println("audio: playing " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(0))) ++ " virtual " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(1))) ++ " refused " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(2)) + Strata.Sound.refused(s2)) ++ " ring " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(3))) ++ " underruns " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(4))) ++ " cpu " ++ ms2(Strata.Ffi.Audio.stat(5) *. 100.0) ++ "% peak " ++ ms2(Strata.Ffi.Audio.stat(6)) ++ "dB rms " ++ ms2(Strata.Ffi.Audio.stat(7)) ++ "dB")
        else () end
        s2
    end
  end

  -- the soak line's sound figures: the mixer's state, the worst frame's sound
  -- work on the main thread, and an acoustics update for 64 voices round
  -- the camera timed here on the real terrain
  pfn ring64(x : Float, y : Float, z : Float, i : Int, acc : List((Int, Float, Float, Float))) : List((Int, Float, Float, Float)) do
    if i >= 64 do acc
    else
      let a = int_to_float(i) *. 0.0981747704
      ring64(x, y, z, i + 1, Cons((i + 1, x +. 30.0 *. Math.cos(a), y -. 5.0 +. int_to_float(i % 8), z +. 30.0 *. Math.sin(a)), acc))
    end
  end
  pfn audio_summary(s : Strata.Stream.Stream, reg : Strata.Blocks.Registry, cam : Cam, aworst : Float) : String do
    match cam do
      Cam(x, y, z, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        let t0 = Strata.Ffi.Vk.time()
        let n = List.length(Strata.Acoustics.finish(Strata.Acoustics.begin(Strata.Stream.world(s), reg, (x, y, z), ring64(x, y, z, 0, Nil))))
        let acoustics_ms = (Strata.Ffi.Vk.time() -. t0) *. 1000.0
        " audio_underruns=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(4))) ++ " audio_ring_refused=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(3))) ++ " audio_refused=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(2))) ++ " audio_cpu=" ++ ms2(Strata.Ffi.Audio.stat(5) *. 100.0) ++ " audio_main_ms=" ++ ms2(aworst) ++ " audio_latency_ms=" ++ ms2(Strata.Ffi.Audio.stat(10)) ++ " audio_mem_kb=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(11)) / 1024) ++ " acoustics_ms=" ++ ms2(acoustics_ms) ++ " acoustics_voices=" ++ int_to_string(n)
    end
  end

  pfn ms2(v : Float) : String do float_to_string(Math.round(v *. 100.0) /. 100.0) end

  -- eye position, yaw, pitch, the chunk the camera was last in, mouse buttons
  -- last frame, flying or walking, vertical speed, on the ground, F last frame
  -- ..., then the sun's height in degrees, the light mode, and whether L was down,
  -- then the sound keys down last frame (bit 0 N, bit 1 H) and bit 2: headphones,
  -- then the metres walked since the last footstep, then the hotbar slot chosen
  type Cam = Cam(Float, Float, Float, Float, Float, Int, Int, Int, Bool, Bool, Bool, Float, Bool, Bool, Float, Int, Bool, Int, Float, Int)

  -- the hotbar slot a number key held this frame asks for, else the one already chosen
  pfn slot_key(i : Int, chosen : Int) : Int do
    if i >= 9 do chosen else if Strata.Ffi.Vk.key(49 + i) do i else slot_key(i + 1, chosen) end end
  end
  -- is the display on? STRATA_UI says; otherwise it is on when a person is at the keys
  pfn ui_on(scripted : Bool) : Bool do Env.get_int("STRATA_UI", if scripted do 0 else 1 end) != 0 end
  -- the display's scale: STRATA_UI_SCALE in hundredths, 100 by default
  pfn ui_scale() : Float do int_to_float(Env.get_int("STRATA_UI_SCALE", 100)) /. 100.0 end

  -- Put the sun [deg] degrees above the horizon, to the south-east, warmer and dimmer the lower it is.
  fn sun_at(deg : Float) : Unit do
    let h = deg *. 0.01745329
    let warm = clampf(Math.sin(h) /. 0.45, 0.0, 1.0)
    let bright = 0.55 +. 0.5 *. warm
    Strata.Render.set_sun(Math.cos(h) *. 0.789, Math.sin(h), Math.cos(h) *. 0.614, bright, bright *. (0.52 +. 0.44 *. warm), bright *. (0.24 +. 0.62 *. warm))
  end


  -- [frames] > 0 is a scripted run: no keyboard or mouse, a fixed time step,
  -- so the same script draws the same frames. [script] is 0 for a held pose,
  -- 1 to hold "forward" (the walk scene), 2 for the soak circuit. [worst] and
  -- [total] gather real frame times, in seconds, from frame 10 on.
  -- [script] 3 empties the chunk whose low corner is [hole] at frame 10, after
  -- the renderer has drawn it: its old quads must then disappear.
  -- The soak's circuit: 150 m round the origin, or, when the run breaches
  -- the test lake, 70 m round the lake.
  pfn soak_lake() : Bool do Env.get_int("STRATA_BREACH", -1) >= 0 end
  -- [mid] is the circuit's centre, worked out once from the scene's lake.
  pfn soak_mid(tl : (Int, Int, Int, Int, Int, Int, Int)) : (Int, Int, Int) do
    if soak_lake() do match tl do (cx, cz, _, _, _, _, _) -> (cx, 70, cz) end else (0, 150, 0) end
  end
  pfn soak_x(turn : Float, mid : (Int, Int, Int)) : Float do match mid do (cx, rad, _) -> int_to_float(cx) +. int_to_float(rad) *. Math.cos(turn) end end
  pfn soak_z(turn : Float, mid : (Int, Int, Int)) : Float do match mid do (_, rad, cz) -> int_to_float(cz) +. int_to_float(rad) *. Math.sin(turn) end end
  pfn lake_voxels(w : Strata.World.World, reg : Strata.Blocks.Registry, tl : (Int, Int, Int, Int, Int, Int, Int)) : Int do
    match tl do
      (cx, cz, rad, line, _, _, _) -> Strata.Fluid.amount(w, reg, cx - rad - 3, line - 17, cz - rad - 3, cx + rad + 3, line + 1, cz + rad + 3) / 8
    end
  end

  pfn frame_loop(s : Strata.Stream.Stream, fl : Strata.Fluid.Fluid, job : Option(Strata.Fluid.Job), sl : Strata.Render.Render, reg : Strata.Blocks.Registry, cam : Cam, frame : Int, frames : Int, script : Int, hole : (Int, Int, Int), tl : (Int, Int, Int, Int, Int, Int, Int), worst : Float, total : Float, fworst : Float, t_prev : Float, t_mark : Float, vp : NativeF32Arr, snd : Strata.Sound.Sound, aworst : Float) : Unit do
    Strata.Ffi.Vk.poll()
    if Strata.Ffi.Vk.should_close() || Strata.Ffi.Vk.key(256) || (frames > 0 && frame >= frames) do
      println("strata_viewer: done after " ++ int_to_string(frame) ++ " frames; uploads refused " ++ int_to_string(Strata.Ffi.Vk.refused()) ++ ", still waiting " ++ int_to_string(Strata.Render.waiting(sl)) ++ "; rebuilds " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(6))) ++ "; draw calls " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(2))))
      if Strata.Render.ui_dropped() > 0 do println("ui: dropped " ++ int_to_string(Strata.Render.ui_dropped()) ++ " quads") else () end
      if script == 2 do
        println("soak: frames=" ++ int_to_string(frame) ++ " worst_ms=" ++ ms2(worst *. 1000.0) ++ " mean_ms=" ++ ms2(total *. 1000.0 /. int_to_float(if frame > 10 do frame - 10 else 1 end)) ++ " refused=" ++ int_to_string(Strata.Ffi.Vk.refused()) ++ " waiting=" ++ int_to_string(Strata.Render.waiting(sl)) ++ " slots=" ++ int_to_string(Strata.Render.used(sl)) ++ " live_quads=" ++ int_to_string(Strata.Ffi.Vk.live_quads()) ++ " leaked=" ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(7))) ++ " loaded=" ++ int_to_string(Strata.Stream.loaded_count(s)) ++ " fluid_worst_ms=" ++ ms2(fworst) ++ " fluid_active=" ++ int_to_string(Strata.Fluid.active_count(fl)) ++ " fluid_waiting=" ++ int_to_string(Strata.Fluid.waiting_count(fl)) ++ " ui_dropped=" ++ int_to_string(Strata.Render.ui_dropped()) ++ " text_waiting=" ++ int_to_string(Strata.Text.waited_last_frame()) ++ " atlas_bytes=" ++ int_to_string(Strata.Text.atlas_bytes()) ++ (if soak_lake() do " lake_end=" ++ int_to_string(lake_voxels(Strata.Stream.world(s), reg, tl)) else "" end) ++ audio_summary(s, reg, cam, aworst))
      else () end
      Strata.Stream.stop(s)
      Strata.Ffi.Audio.close()
    else
      match cam do
        Cam(x, y, z, yaw, pitch, kx0, ky0, kz0, lb0, rb0, fly0, vy0, ground0, f0, sun0, mode0, l0, keys0, stride0, slot0) ->
          let now = Strata.Ffi.Vk.time()
          let scripted = frames > 0
          let dt = if scripted do 0.016667 else clampf(now -. t_prev, 0.0, 0.1) end
          let live = if scripted do 0.0 else 1.0 end
          let yaw_in = if script == 2 do int_to_float(frame) *. 0.004 +. 3.14159265 else yaw end
          let yaw2 = yaw_in +. live *. (Strata.Ffi.Vk.mouse_dx() *. 0.0025 +. axis(Strata.Ffi.Vk.key(262), Strata.Ffi.Vk.key(263)) *. dt *. 1.6)
          let pitch2 = clampf(pitch -. live *. (Strata.Ffi.Vk.mouse_dy() *. 0.0025 -. axis(Strata.Ffi.Vk.key(265), Strata.Ffi.Vk.key(264)) *. dt *. 1.2), -1.5, 1.5)
          let fx = Math.sin(yaw2) *. Math.cos(pitch2)
          let fy = Math.sin(pitch2)
          let fz = 0.0 -. Math.cos(yaw2) *. Math.cos(pitch2)
          -- F switches between walking and flying, once per press
          let fkey = !scripted && Strata.Ffi.Vk.key(70)
          let fly = if fkey && !f0 do !fly0 else fly0 end
          -- [ and ] lower and raise the sun
          let sun_keys = clampf(sun0 +. live *. axis(Strata.Ffi.Vk.key(93), Strata.Ffi.Vk.key(91)) *. dt *. 20.0, -5.0, 90.0)
          -- a scripted run may move the sun once, to check that the light follows it
          let sun = if scripted && frame == Env.get_int("STRATA_SUN2_AT", -1) do int_to_float(Env.get_int("STRATA_SUN2", 55)) else sun_keys end
          -- L steps through the light modes, once per press
          let lkey = !scripted && Strata.Ffi.Vk.key(76)
          let mode = if lkey && !l0 do (mode0 + 1) % 5 else mode0 end
          let go = if script == 1 do 1.0 else live *. axis(Strata.Ffi.Vk.key(87), Strata.Ffi.Vk.key(83)) end
          let strafe = live *. axis(Strata.Ffi.Vk.key(68), Strata.Ffi.Vk.key(65))
          let space = !scripted && Strata.Ffi.Vk.key(32)
          let w0 = Strata.Stream.world(s)
          -- flying moves along the view at 40 m/s; walking moves on the ground at 5 m/s under gravity
          let moved = if fly do
              let rise = live *. axis(space, Strata.Ffi.Vk.key(340))
              StrataViewer.Walker.body_with(x +. (fx *. go +. Math.cos(yaw2) *. strafe) *. 40.0 *. dt, y +. (fy *. go +. rise) *. 40.0 *. dt, z +. (fz *. go +. Math.sin(yaw2) *. strafe) *. 40.0 *. dt, 0.0, false)
            else
              let mx = (Math.sin(yaw2) *. go +. Math.cos(yaw2) *. strafe) *. 5.0
              let mz = (Math.sin(yaw2) *. strafe -. Math.cos(yaw2) *. go) *. 5.0
              StrataViewer.Walker.step_in(w0, fl, StrataViewer.Walker.body_with(x, y, z, vy0, ground0), mx, mz, space, dt)
            end
          -- the soak circuit: a 150 m circle at about 36 m/s, looking along it and down
          let turn = int_to_float(frame) *. 0.004
          let x2 = if script == 2 do soak_x(turn, hole) else StrataViewer.Walker.eye_x(moved) end
          let y2 = if script == 2 do y else StrataViewer.Walker.eye_y(moved) end
          let z2 = if script == 2 do soak_z(turn, hole) else StrataViewer.Walker.eye_z(moved) end
          -- the stream: refocus when the camera enters another chunk, then one tick
          let t_march = Strata.Ffi.Vk.time()
          let kx = Strata.Coord.chunk_of(float_to_int(Math.floor(x2)))
          let ky = Strata.Coord.chunk_of(float_to_int(Math.floor(y2)))
          let kz = Strata.Coord.chunk_of(float_to_int(Math.floor(z2)))
          let s1a = if kx != kx0 || ky != ky0 || kz != kz0 do Strata.Stream.set_focus(s, Cons((x2, y2, z2), Nil)) else s end
          let seed = Env.get_int("STRATA_SEED", 7)
          if script == 2 && soak_lake() && frame == Env.get_int("STRATA_BREACH", -1) - 1 do println("soak-lake: lake_start=" ++ int_to_string(lake_voxels(Strata.Stream.world(s1a), reg, tl))) else () end
          let m0 = Sim(s1a, fl)
          let m1 = if script == 3 && frame == 10 do
              match hole do
                (hx, hy, hz) -> edit(m0, Strata.Edit.fill_box(Strata.Stream.world(s1a), hx, hy, hz, hx + 31, hy + 31, hz + 31, 0))
              end
            else m0 end
          let m2 = if scripted && frame == Env.get_int("STRATA_SLAB_AT", -1) do edit(m1, slab_edit(Strata.Stream.world(sim_stream(m1)), seed, 1))
            else if scripted && frame == Env.get_int("STRATA_SLAB_OFF", -1) do edit(m1, slab_edit(Strata.Stream.world(sim_stream(m1)), seed, 0)) else m1 end end
          let m2s = if scripted && frame == Env.get_int("STRATA_SPLASH", -1) do
              let o1 = Strata.Edit.fill_box(Strata.Stream.world(sim_stream(m2)), -38, height(-35, 53, seed) + 16, 52, -37, height(-35, 53, seed) + 17, 53, lake_base() + 7)
              let m2a = edit(m2, o1)
              edit(m2a, Strata.Edit.set_block(Strata.Stream.world(sim_stream(m2a)), -32, height(-35, 53, seed) + 8, 53, lake_base() + 7))
            else m2 end
          let m3 = if scripted && frame == Env.get_int("STRATA_BREACH", -1) do breach(m2s, tl) else if scripted && frame == Env.get_int("STRATA_DRAIN", -1) do drain_floor(m2s, tl) else m2s end end
          let slot = if scripted do slot0 else slot_key(0, slot0) end
          let lb = !scripted && Strata.Ffi.Vk.mouse_button(0)
          let rb = !scripted && Strata.Ffi.Vk.mouse_button(1)
          let dig_now = (lb && !lb0) || (frame == 10 && Env.get_int("STRATA_DIG", 0) == 1) || (script == 2 && frame % 100 == 50)
          let build_now = rb && !rb0
          let m4 = act(m3, reg, x2, y2, z2, fx, fy, fz, dig_now, build_now, StrataViewer.Hud.slot_block(slot))
          -- sound: the camera is the listener; a carve or a build strikes where it lands
          let sndl = Strata.Sound.listener(snd, x2, y2, z2, fx, fy, fz, 0.0, 1.0, 0.0)
          let snd0 = if dig_now do strike_at(sndl, w0, reg, x2, y2, z2, fx, fy, fz, 0.55, 0.85) else if build_now do strike_at(sndl, w0, reg, x2, y2, z2, fx, fy, fz, 0.95, 0.3) else sndl end end
          -- footsteps every half metre walked on the ground, from the block underfoot; a landing, by how hard
          let walked = !fly && StrataViewer.Walker.grounded(moved)
          let dx_w = StrataViewer.Walker.eye_x(moved) -. x
          let dz_w = StrataViewer.Walker.eye_z(moved) -. z
          let stride1 = if walked do stride0 +. Math.sqrt(dx_w *. dx_w +. dz_w *. dz_w) else 0.0 end
          let step_now = stride1 >= 0.5
          let stride = if step_now do stride1 -. 0.5 else stride1 end
          let feet_y = y2 -. 1.6
          let under = Strata.World.get_block(w0, float_to_int(Math.floor(x2)), float_to_int(Math.floor(feet_y -. 0.1)), float_to_int(Math.floor(z2)))
          let landed = !fly && !ground0 && StrataViewer.Walker.grounded(moved) && vy0 < -3.0
          let snd_f = if step_now do footstep(snd0, under, x2, feet_y, z2, 0.45)
            else if landed do footstep(snd0, under, x2, feet_y, z2, clampf((0.0 -. vy0) /. 15.0, 0.4, 1.0)) else snd0 end end
          -- N plays the next recording from viewer/sounds/ 5 m ahead; H switches headphones and speakers
          let nkey = !scripted && Strata.Ffi.Vk.key(78)
          let hkey = !scripted && Strata.Ffi.Vk.key(72)
          let hp_was = int_and(keys0, 4) != 0
          let hp_now = if hkey && int_and(keys0, 2) == 0 do !hp_was else hp_was end
          let keys = (if nkey do 1 else 0 end) + (if hkey do 2 else 0 end) + (if hp_now do 4 else 0 end)
          let snd_n = if nkey && int_and(keys0, 1) == 0 do place_recording(snd_f, frame, x2 +. fx *. 5.0, y2 +. fy *. 5.0, z2 +. fz *. 5.0) else snd_f end
          let snd1 = if hkey && int_and(keys0, 2) == 0 do
              let hp = int_and(keys, 4) != 0
              println("strata_viewer: sound on " ++ (if hp do "headphones" else "speakers" end))
              Strata.Sound.set_output(snd_n, hp)
            else snd_n end
          -- the fluid: ten steps a second (a scripted run: every sixth frame)
          let t_fluid = Strata.Ffi.Vk.time()
          let due = Env.get_int("STRATA_FLUID", 1) != 0 && (if scripted do frame % 6 == 0 else Math.floor(now *. 10.0) != Math.floor(t_prev *. 10.0) end)
          -- a step is worked out on a worker: the one begun last time is finished here, then the next begins
          let m5 = if !due do m4
            else if Env.get_int("STRATA_FLUID_SYNC", 0) == 1 do
              match Strata.Fluid.step(sim_fluid(m4), sim_stream(m4), Cons((x2, y2, z2), Nil)) do (f2, sf) -> Sim(sf, f2) end
            else
              match job do
                Some(j) -> match Strata.Fluid.finish(j, sim_fluid(m4), sim_stream(m4)) do (f2, sf) -> Sim(sf, f2) end
                None -> m4
              end
            end end
          let begun = if due && Env.get_int("STRATA_FLUID_SYNC", 0) != 1 do
              match Strata.Fluid.begin(sim_fluid(m5), Strata.Stream.world(sim_stream(m5)), Cons((x2, y2, z2), Nil)) do
                (f3, j2) -> (f3, Some(j2))
              end
            else (sim_fluid(m5), job) end
          -- spray for what the step that just ended did, and a fountain if a timing run asks for one
          let _sprayed = if due && Env.get_int("STRATA_SPRAY", 1) != 0 do spray_events(Strata.Fluid.events(sim_fluid(m5)), 0) else 0 end
          let fountain = Env.get_int("STRATA_FOUNTAIN", 0)
          if fountain > 0 && Strata.Render.spray(x2 +. fx *. 30.0, y2 +. fy *. 30.0 -. 4.0, z2 +. fz *. 30.0, 0.0, 9.0, 0.0, fountain, 4.0, 3.0, 13) do () else () end
          let fl2 = match begun do (f3, _) -> f3 end
          let job2 = match begun do (_, j3) -> j3 end
          let fluid_ms = (Strata.Ffi.Vk.time() -. t_fluid) *. 1000.0
          if due && scripted && frame % 240 == 0 && Strata.Fluid.active_count(fl2) > 0 do println("  fluid step at frame " ++ int_to_string(frame) ++ ": " ++ ms2(fluid_ms) ++ " ms on the main thread for " ++ int_to_string(Strata.Fluid.active_count(fl2)) ++ " active cells") else () end
          let s2 = Strata.Stream.tick(sim_stream(m5))
          match Strata.Render.sync(sl, s2) do
            (sl2, s3) ->
              let march_ms = (Strata.Ffi.Vk.time() -. t_march) *. 1000.0
              let aspect = int_to_float(Strata.Ffi.Vk.fb_w()) /. int_to_float(if Strata.Ffi.Vk.fb_h() < 1 do 1 else Strata.Ffi.Vk.fb_h() end)
              let view = M4.look_at(V3.new(x2, y2, z2), V3.new(x2 +. fx, y2 +. fy, z2 +. fz), V3.new(0.0, 1.0, 0.0))
              let vp2 = M4.mul_into_f32(M4.perspective(1.15, aspect, 0.1, 1200.0), view, vp)
              Strata.Ffi.Vk.set_camera(vp2)
              Strata.Ffi.Vk.set_eye(x2, y2, z2, 1.0)
              -- under water the world is seen through it
              let top = Strata.Fluid.surface(fl, Strata.Stream.world(s3), float_to_int(Math.floor(x2)), float_to_int(Math.floor(y2)), float_to_int(Math.floor(z2)))
              if top > y2 do Strata.Render.set_underwater(top, 0.035, 0.17, 0.30, 0.055) else Strata.Render.clear_underwater() end
              -- the display, built afresh each frame
              if ui_on(scripted) do
                let shown = Env.get_int("STRATA_UI_SHOW", 0)
                let t_ui = Strata.Ffi.Vk.time()
                let u0 = Strata.Render.ui_begin(ui_scale())
                let fps = if scripted do 60.0 else Math.round(1.0 /. (if now -. t_prev > 0.0005 do now -. t_prev else 0.0005 end)) end
                let readout = (if script == 2 do "frame " ++ int_to_string(frame) ++ "\n" else "" end) ++ int_to_string(float_to_int(fps)) ++ " fps\n" ++ ms2(x2) ++ ", " ++ ms2(y2) ++ ", " ++ ms2(z2) ++ "\nlight mode " ++ int_to_string(mode)
                let u1 = if shown == 1 do StrataViewer.Hud.flood(u0, 0, 20000) else if shown == 2 do StrataViewer.Hud.frames(u0) else if shown == 3 do StrataViewer.Hud.sheet(u0) else if shown == 4 do StrataViewer.Hud.styles(u0) else if shown == 5 do StrataViewer.Hud.busy(u0, ":") else if shown == 6 do StrataViewer.Hud.busy(u0, int_to_string(frame)) else if shown == 7 do StrataViewer.Hud.scripts(u0) else StrataViewer.Hud.build(u0, slot, readout) end end end end end end end
                if Strata.Render.draw_ui(u1) do () else () end
                if Env.get_int("STRATA_TEXT_LOG", 0) == 1 && frame < 12 do println("text: frame " ++ int_to_string(frame) ++ ", " ++ int_to_string(Strata.Text.waiting()) ++ " glyph requests waited, " ++ int_to_string(float_to_int(Strata.Ffi.Text.stat(5))) ++ " us spent drawing glyphs, " ++ int_to_string(float_to_int(Strata.Ffi.Text.stat(0))) ++ " in the atlas") else () end
                if (shown == 5 || shown == 6) && frame % 60 == 59 do println("ui: " ++ int_to_string(Strata.Ui.quad_count(u1)) ++ " quads built and handed over in " ++ int_to_string(float_to_int((Strata.Ffi.Vk.time() -. t_ui) *. 1000000.0)) ++ " us") else () end
              else () end
              Strata.Render.set_time(if scripted do int_to_float(frame) /. 60.0 else now end)
              if sun != sun0 do sun_at(sun) else () end
              if mode != mode0 do Strata.Ffi.Vk.set_lighting(mode) else () end
              -- a soak takes no screenshot: reading the image back would be its slowest frame
              if scripted && script != 2 && frame == frames - 3 do Strata.Ffi.Vk.request_shot() else () end
              if scripted && frame == Env.get_int("STRATA_REBUILD_AT", -1) do Strata.Ffi.Vk.force_rebuild() else () end
              -- the result is used, not dropped: a zero-argument extern bound to an unused name is optimised away (cube_forge GAPS G16)
              let t_audio = Strata.Ffi.Vk.time()
              let snd2 = audio_frame(snd1, Strata.Stream.world(s3), fl2, dt, frame, scripted, now, t_prev)
              let audio_ms = (Strata.Ffi.Vk.time() -. t_audio) *. 1000.0
              let aworst2 = if frame >= 10 && audio_ms > aworst do audio_ms else aworst end
              -- STRATA_STALL=n: hold the main thread 100 ms every n frames, as a hitch would (soak runs)
              let stall = Env.get_int("STRATA_STALL", 0)
              -- nested, not &&: both sides of && are evaluated (GAPS S16 on main), and frame % 0 panics
              if stall > 0 do (if frame % stall == stall - 1 do Strata.Ffi.Audio.debug_stall(100) else () end) else () end
              let next = if Strata.Ffi.Vk.frame() do frame + 1 else frame end
              let spent = now -. t_prev
              -- in a soak, name any frame slower than 25 ms and where its time went
              if script == 2 && frame >= 10 && (spent > 0.025 || march_ms > 4.0) do println("  slow frame " ++ int_to_string(frame) ++ ": " ++ ms2(spent *. 1000.0) ++ " ms since the last; this frame's march " ++ ms2(march_ms) ++ " ms, last frame's shim " ++ ms2(Strata.Ffi.Vk.stat(0)) ++ " ms and waiting " ++ ms2(Strata.Ffi.Vk.stat(1)) ++ " ms") else () end
              let worst2 = if frame >= 10 && spent > worst do spent else worst end
              let fworst2 = if fluid_ms > fworst do fluid_ms else fworst end
              let total2 = if frame >= 10 do total +. spent else total end
              let cam2 = Cam(x2, y2, z2, yaw2, pitch2, kx, ky, kz, lb, rb, fly, StrataViewer.Walker.speed_y(moved), StrataViewer.Walker.grounded(moved), fkey, sun, mode, lkey, keys, stride, slot)
              if next != frame && frame % 240 == 239 do
                println("  " ++ float_to_string(Math.round(240.0 /. (now -. t_mark))) ++ " fps; march " ++ ms2(march_ms) ++ " ms, shim " ++ ms2(Strata.Ffi.Vk.stat(0)) ++ " ms, waiting " ++ ms2(Strata.Ffi.Vk.stat(1)) ++ " ms, gpu " ++ ms2(Strata.Ffi.Vk.stat(3)) ++ " ms; " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(2))) ++ " draw calls, " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(4))) ++ " see-through chunks ordered in " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(5))) ++ " us, " ++ int_to_string(Strata.Ffi.Vk.drawn_chunks()) ++ " chunks, " ++ int_to_string(Strata.Ffi.Vk.drawn_quads()) ++ " quads; " ++ int_to_string(Strata.Stream.loaded_count(s3)) ++ " chunks loaded")
                if scripted && script != 2 && (Env.get_int("STRATA_BREACH", -1) >= 0 || Env.get_int("STRATA_DRAIN", -1) >= 0) do
                  match tl do
                    (lcx, lcz, lrad, lline, _, lbed, lout) -> println("  lake: frame " ++ int_to_string(frame) ++ ", bed " ++ int_to_string(lbed) ++ ", ground outside " ++ int_to_string(lout) ++ ", " ++ int_to_string(Strata.Fluid.amount(Strata.Stream.world(s3), reg, lcx - lrad - 3, lline - 17, lcz - lrad - 3, lcx + lrad + 3, lline + 1, lcz + lrad + 3) / 8) ++ " voxels of water left in it; radius " ++ int_to_string(lrad) ++ ", water line " ++ int_to_string(lline))
                  end
                else () end
                if Strata.Fluid.active_count(fl2) + Strata.Fluid.dormant_count(fl2) > 0 do println("  fluid: active " ++ int_to_string(Strata.Fluid.active_count(fl2)) ++ ", waiting " ++ int_to_string(Strata.Fluid.waiting_count(fl2)) ++ ", dormant " ++ int_to_string(Strata.Fluid.dormant_count(fl2)) ++ "; last step " ++ ms2(fluid_ms) ++ " ms") else () end
                frame_loop(s3, fl2, job2, sl2, reg, cam2, next, frames, script, hole, tl, worst2, total2, fworst2, now, now, vp2, snd2, aworst2)
              else frame_loop(s3, fl2, job2, sl2, reg, cam2, next, frames, script, hole, tl, worst2, total2, fworst2, now, t_mark, vp2, snd2, aworst2) end
          end
      end
    end
  end

  -- The window size from STRATA_SIZE=WxH, or 1280 x 800.
  pfn window_size() : (Int, Int) do
    match String.split(Env.get("STRATA_SIZE", "1280x800"), "x") do
      Cons(a, Cons(b, Nil)) ->
        match (String.to_int(a), String.to_int(b)) do
          (Ok(w), Ok(h)) -> if w >= 64 && h >= 64 && w <= 8192 && h <= 8192 do (w, h) else (1280, 800) end
          _ -> (1280, 800)
        end
      _ -> (1280, 800)
    end
  end

  -- Fixed camera poses for scripted runs and golden images: (x, y, z, yaw, pitch).
  --   1 overview      high over the hills, the lake ahead
  --   2 shore         low over the water, along the shoreline
  --   3 forest floor  among the trees, looking level
  --   4 dug out       the overview, with one whole chunk of ground removed ahead
  --   5 bad ids       the forest floor, with a wall of blocks whose texture does not exist and one block id nobody registered
  --   6 glass front   high in the air: a red glass wall with a water wall behind it, in another chunk
  --   7 glass back    the same two walls from the other side: the water wall is now the near one
  --   8 underwater    just under a lake's surface, looking up and out through it at the shore
  --   9 meadow        low over the grass, across the tall grass
  --   10 post         close to a lantern post
  --   11 walk         standing on the ground at the origin; a scripted run walks forward
  --   22 river mouth  the island's widest river where it meets the sea, from out at sea
  --   23 lake bank    the test lake from its bank opposite the outlet, looking down across it to the river leaving it
  --   0  (the default) the same spot, for playing: walking, with the keyboard and mouse
  -- Scenes 18, 19 and 23 use the lake scene_lake picks on the land in use (the
  -- island's deepest lake near the origin; on the noise terrain, test_lake's).
  -- Any other number is the overview.
  -- The first column, walking a fixed grid outward from the origin, whose
  -- ground lies at least four blocks under the water: somewhere to look at
  -- water from. The origin if the grid finds none.
  pfn deep_water(seed : Int, i : Int) : (Int, Int) do
    if i >= 4096 do (0, 0)
    else
      let x = (i % 64 - 32) * 8
      let z = (i / 64 - 32) * 8
      if height(x, z, seed) <= sea() - 4 do (x, z) else deep_water(seed, i + 1) end
    end
  end

  -- The first column in a fixed walk of the 128 x 128 columns about the origin
  -- that carries a lantern post and no tree. The origin if there is none.
  pfn first_post(seed : Int, i : Int) : (Int, Int) do
    if i >= 16384 do (0, 0)
    else
      let x = i % 128 - 64
      let z = i / 128 - 64
      let h = height(x, z, seed)
      if has_post(x, z, int_to_float(h), seed) && !has_tree(x, z, int_to_float(h), seed) do (x, z) else first_post(seed, i + 1) end
    end
  end

  -- Scene 12's stone slab, hung over open grass ahead of the camera: put there ([id] 1) or taken away (0).
  -- Scene 20's water: three rows of cells at (x, y, z) running one eighth to full along x, then two full columns.
  pfn stairs(y : Int, i : Int, acc : List((Int, Int, Int, Int))) : List((Int, Int, Int, Int)) do
    if i >= 30 do acc
    else stairs(y, i + 1, Cons((-40 + i % 10, y, 52 + i / 10, lake_base() + (if i % 10 > 7 do 7 else i % 10 end)), acc)) end
  end

  pfn slab_edit(w : Strata.World.World, seed : Int, id : Int) : Strata.Edit.Outcome do
    let gy = height(-35, 53, seed)
    Strata.Edit.fill_box(w, -38, gy + 5, 50, -32, gy + 5, 56, id)
  end
  pfn slab(s : Strata.Stream.Stream, seed : Int, id : Int) : Strata.Stream.Stream do Strata.Stream.apply(s, slab_edit(Strata.Stream.world(s), seed, id)) end

  -- The highest column on a coarse walk of the 1200 m about the origin: snow and ice country.
  pfn peak_go(seed : Int, i : Int, bx : Int, bz : Int, bh : Int) : (Int, Int, Int) do
    if i >= 22500 do (bx, bz, bh)
    else
      let x = (i % 150 - 75) * 8
      let z = (i / 150 - 75) * 8
      let h = height(x, z, seed)
      if h > bh do peak_go(seed, i + 1, x, z, h) else peak_go(seed, i + 1, bx, bz, bh) end
    end
  end

  -- The mouth of the island's widest river where it meets the sea: the
  -- last point of the polyline that ends in the sea at the greatest width,
  -- with the point four back for its direction. None on the noise terrain.
  pfn mouth_go(a : Strata.Atlas.Atlas, rs : List(List((Float, Float, Float))), best : Option((Float, Float, Float, Float, Float))) : Option((Float, Float, Float, Float, Float)) do
    match rs do
      Nil -> best
      Cons(r, rest) ->
        let k = List.length(r)
        if k < 6 do mouth_go(a, rest, best)
        else
          match (List.nth(r, k - 1), List.nth(r, k - 5)) do
            ((mx, mz, w), (px, pz, _)) ->
              let wider = match best do
                  None -> true
                  Some((_, _, bw, _, _)) -> w > bw
                end
              if Strata.Atlas.height_at(a, mx, mz) <= 40.0 && wider do mouth_go(a, rest, Some((mx, mz, w, px, pz))) else mouth_go(a, rest, best) end
          end
        end
    end
  end

  -- scene 22: 60 m out to sea from that mouth, 18 m over the water, looking back at it
  pfn mouth_pose(land : Land, seed : Int) : (Float, Float, Float, Float, Float) do
    match land do
      Noise -> (-70.0, int_to_float(height(0, 0, seed)) +. 46.0, 96.0, 0.62, -0.42)
      Island(a) ->
        match mouth_go(a, Strata.Atlas.rivers(a), None) do
          None -> (-70.0, int_to_float(land_height(land, 0, 0, seed)) +. 46.0, 96.0, 0.62, -0.42)
          Some((mx, mz, _, px, pz)) ->
            let dx = mx -. px
            let dz = mz -. pz
            let len = fmax(0.001, Math.sqrt(dx *. dx +. dz *. dz))
            let ux = dx /. len
            let uz = dz /. len
            let out = 60.0
            (mx +. ux *. out, int_to_float(sea()) +. 18.0, mz +. uz *. out, Math.atan2(0.0 -. ux, uz), 0.0 -. Math.atan2(18.0, out))
        end
    end
  end

  pfn pose(scene : Int, seed : Int, land : Land, tl : (Int, Int, Int, Int, Int, Int, Int)) : (Float, Float, Float, Float, Float) do
    if scene == 0 || scene == 11 do (0.5, int_to_float(land_height(land, 0, 0, seed)) +. 2.7, 0.5, 0.62, -0.1)
    else if scene == 2 do
      match deep_water(seed, 0) do
        (wx, wz) -> (int_to_float(wx) +. 0.5, int_to_float(sea()) +. 3.5, int_to_float(wz) +. 0.5, 0.9, -0.15)
      end
    else if scene == 13 || scene == 14 do
      -- the lake, looking across it to catch the sun's glints (13; the sun itself now stands behind a hill at the old bearing) or steeply down at the water (14)
      match deep_water(seed, 0) do
        (wx, wz) -> (int_to_float(wx) +. 0.5, int_to_float(sea()) +. 3.5, int_to_float(wz) +. 0.5, if scene == 13 do 1.2 else 0.9 end, if scene == 13 do -0.12 else -0.75 end)
      end
    else if scene == 15 do
      -- high ground, from 30 m back and 14 m up, looking across the top toward the sun
      match peak_go(seed, 0, 0, 0, -1000) do
        (px, pz, ph) -> (int_to_float(px) -. 23.7, int_to_float(ph) +. 12.0, int_to_float(pz) -. 18.4, 2.23, -0.4)
      end
    else if scene == 12 do (-45.0, int_to_float(land_height(land, -35, 53, seed)) +. 11.0, 40.0, 2.5, -0.45)
    else if scene == 6 do (16.5, 150.0, -8.0, 3.14159265, 0.0)
    else if scene == 7 do (16.5, 150.0, 68.0, 0.0, 0.0)
    else if scene == 8 do
      match deep_water(seed, 0) do
        (wx, wz) -> (int_to_float(wx) +. 0.5, int_to_float(sea()) -. 1.4, int_to_float(wz) +. 0.5, 0.9, 0.22)
      end
    else if scene == 24 do
      -- under the sea, looking steeply up at its surface
      match deep_water(seed, 0) do
        (wx, wz) -> (int_to_float(wx) +. 0.5, int_to_float(sea()) -. 2.4, int_to_float(wz) +. 0.5, 0.9, 1.05)
      end
    else if scene == 25 do
      -- on the bed of the test lake, looking across it toward the breach
      match test_lake(seed) do
        (cx, cz, rad, line, d) -> (int_to_float(at_x(cx, d, 0 - rad / 2)) +. 0.5, int_to_float(line) -. 4.4, int_to_float(at_z(cz, d, 0 - rad / 2)) +. 0.5, int_to_float(d) *. 0.39269908, 0.12)
      end
    else if scene == 18 || scene == 19 do
      -- the test lake: from over its far side looking at the breach (18), or from the valley below looking back (19)
      match tl do
        (cx, cz, rad, line, d, _, _) ->
          if scene == 18 do (int_to_float(at_x(cx, d, 0 - (rad * 6) / 10)), int_to_float(line) +. 16.0, int_to_float(at_z(cz, d, 0 - (rad * 6) / 10)), int_to_float(d) *. 0.39269908, -0.5)
          else (int_to_float(at_x(cx, d, rad + 44)), int_to_float(land_height(land, at_x(cx, d, rad + 44), at_z(cz, d, rad + 44), seed)) +. 14.0, int_to_float(at_z(cz, d, rad + 44)), int_to_float(d) *. 0.39269908 +. 3.14159265, -0.25) end
      end
    else if scene == 26 do (-40.5, int_to_float(land_height(land, -35, 53, seed)) +. 6.0, 53.5, 1.5708, -0.3)
    else if scene == 21 || scene == 27 do (-45.0, int_to_float(land_height(land, -35, 53, seed)) +. 10.0, 40.0, 2.5, -0.4)
    else if scene == 20 do (-35.5, int_to_float(land_height(land, -35, 53, seed)) +. 12.0, 60.5, 0.0, -0.95)
    else if scene == 16 do (-34.5, int_to_float(land_height(land, -35, 53, seed)) -. 1.3, 58.2, 0.0, -0.03)
    else if scene == 10 || scene == 17 do
      match first_post(seed, 0) do
        (px, pz) -> (int_to_float(px) -. 2.7, int_to_float(land_height(land, px, pz, seed)) +. 2.3, int_to_float(pz) +. 2.9, 0.927, -0.22)
      end
    else if scene == 9 do (-44.0, int_to_float(land_height(land, -44, 42, seed)) +. 1.9, 42.0, 2.5, -0.12)
    else if scene == 5 do (-42.0, int_to_float(land_height(land, -35, 53, seed)) +. 7.0, 44.0, 2.5, -0.25)
    else if scene == 3 do (-45.0, int_to_float(land_height(land, -45, 40, seed)) +. 2.6, 40.0, 2.5, -0.05)
    else if scene == 22 do mouth_pose(land, seed)
    else if scene == 23 do
      -- the test lake from its bank opposite the outlet, looking across the water to the river leaving it
      match tl do
        (cx, cz, rad, line, d, _, _) ->
          let bx = at_x(cx, d, 0 - (rad + 8))
          let bz = at_z(cz, d, 0 - (rad + 8))
          let ey = int_to_float(land_height(land, bx, bz, seed)) +. 5.0
          (int_to_float(bx) +. 0.5, ey, int_to_float(bz) +. 0.5, int_to_float(d) *. 0.39269908, 0.0 -. Math.atan2(ey -. int_to_float(line), int_to_float(2 * rad + 8)))
      end
    else (-70.0, int_to_float(land_height(land, 0, 0, seed)) +. 46.0, 96.0, 0.62, -0.42) end end end end end end end end end end end end end end end end end end end end end
  end

  -- The land for STRATA_ISLAND: the island's atlas from the cache in
  -- STRATA_ATLAS_DIR (built and written there the first time), or the noise terrain.
  pfn load_land(seed : Int) : Land do
    if Env.get_int("STRATA_ISLAND", 1) == 0 do Noise
    else
      let dir = Env.get("STRATA_ATLAS_DIR", ".march/atlas")
      let cached = File.exists(dir ++ "/" ++ Strata.Atlas.cache_name(island_def(), seed))
      let t0 = unix_time_ms()
      let a = Strata.Atlas.load_or_build(dir, island_def(), seed)
      println("strata_viewer: atlas " ++ int_to_string(Strata.Atlas.n(a)) ++ " x " ++ int_to_string(Strata.Atlas.n(a)) ++ (if cached do " read from the cache" else " built and cached" end) ++ " in " ++ int_to_string(unix_time_ms() - t0) ++ " ms")
      Island(a)
    end
  end

  -- ── Timing the generator ─────────────────────────────────────────────────
  -- STRATA_CHUNK_TIMES=1: generate each of 200 surface chunks (10 x 20 about
  -- the origin, cy holding the ground at the chunk's middle) 10 times on one
  -- task, print the median and worst time a chunk on the land in use, and exit.
  pfn time_go(land : Land, seed : Int, k : Int, acc : List(Int)) : List(Int) do
    if k >= 200 do acc
    else
      let cx = k % 10 - 5
      let cz = k / 10 - 10
      let cy = Strata.Coord.chunk_of(land_height(land, cx * 32 + 16, cz * 32 + 16, seed))
      let key = Strata.Coord.key(cx, cy, cz)
      let t0 = unix_time_ms()
      let forms = gen_n(land, key, seed, 10, 0)
      -- hundredths of a millisecond a chunk; the forms are used so no call is dropped (GAPS S9)
      time_go(land, seed, k + 1, Cons((unix_time_ms() - t0) * 10 + (if forms < 0 do 1 else 0 end), acc))
    end
  end
  pfn gen_n(land : Land, key : Strata.Coord.Key, seed : Int, left : Int, acc : Int) : Int do
    if left <= 0 do acc else gen_n(land, key, seed, left - 1, acc + Ch.form(land_chunk(land, key, seed))) end
  end
  pfn hundredths(v : Int) : String do int_to_string(v / 100) ++ "." ++ String.pad_left(int_to_string(v % 100), 2, "0") end
  pfn chunk_times(land : Land, seed : Int) : Unit do
    let ts = List.sort_by(time_go(land, seed, 0, Nil), fn (p, q) -> p < q)
    println("strata_viewer: " ++ (match land do
        Noise -> "noise"
        Island(_) -> "island"
      end) ++ " chunks: median " ++ hundredths(List.nth(ts, 100)) ++ " ms, worst " ++ hundredths(List.nth(ts, 199)) ++ " ms over 200 surface chunks, 10 runs each on one task")
  end

  fn main(_cap : Cap(IO)) : Unit do
    let r = Env.get_int("STRATA_RADIUS", 10)
    let soak = Env.get_int("STRATA_SOAK", 0)
    let frames = if soak > 0 do soak else Env.get_int("STRATA_FRAMES", 0) end
    let seed = Env.get_int("STRATA_SEED", 7)
    let size = window_size()
    let scene = Env.get_int("STRATA_SCENE", 0)
    let land = load_land(seed)
    if Env.get_int("STRATA_CHUNK_TIMES", 0) == 1 do chunk_times(land, seed) else () end
    let tl = scene_lake(land, seed)
    -- the soak starts on its circuit, 60 m over the origin's ground, looking down a little
    let mid = soak_mid(tl)
    let start = if soak > 0 do (soak_x(0.0, mid), int_to_float(land_height(land, match mid do (cx, _, _) -> cx end, match mid do (_, _, cz) -> cz end, seed)) +. (if soak_lake() do 45.0 else 60.0 end), soak_z(0.0, mid), 3.14159265, -0.35) else pose(scene, seed, land, tl) end
    if !Strata.Ffi.Vk.open(match size do (w, _) -> w end, match size do (_, h) -> h end, frames == 0, Env.get_int("STRATA_QUADS", 0)) do println("strata_viewer: could not open a Vulkan window")
    else
      Strata.Ffi.Vk.set_vsync(Env.get_int("STRATA_VSYNC", 1) != 0)
      Strata.Ffi.Vk.set_offscreen(Env.get_int("STRATA_OFFSCREEN", 0) == 1)
      Strata.Ffi.Vk.pad_commands(Env.get_int("STRATA_PAD_CMDS", 0))
      Strata.Ffi.Vk.set_lighting(Env.get_int("STRATA_LIGHT", 4))
      let reg = registry()
      if Strata.Render.set_light_box(Env.get_int("STRATA_LIGHT_BOX", r), 3) do () else println("strata_viewer: could not build the light volume") end
      if textures(reg) do () else println("strata_viewer: could not upload textures") end
      if Strata.Render.ui_atlas(StrataViewer.Hud.atlas_w(), StrataViewer.Hud.atlas_h(), StrataViewer.Hud.atlas()) do () else println("strata_viewer: could not upload the interface atlas") end
      if Strata.Render.light_overflow(reg) > 0 do println("strata_viewer: " ++ int_to_string(Strata.Render.light_overflow(reg)) ++ " blocks share another block's light class") else () end
      sun_at(int_to_float(Env.get_int("STRATA_SUN", 55)))
      -- chunks are meshed out to one short of the radius, so the fog closes there
      Strata.Ffi.Vk.set_fog(int_to_float(r - 1) *. 32.0 *. 0.55, int_to_float(r - 1) *. 32.0)
      let ex = match start do (x, _, _, _, _) -> x end
      let ey = match start do (_, y, _, _, _) -> y end
      let ez = match start do (_, _, z, _, _) -> z end
      let yaw0 = match start do (_, _, _, a, _) -> a end
      let pitch0 = match start do (_, _, _, _, a) -> a end
      let world = Strata.World.new(reg, Strata.Terrain.gen(fn (k, sd) -> land_chunk(land, k, sd)), seed, 1.0)
      let t0 = Strata.Ffi.Vk.time()
      let s0 = Strata.Stream.run_until_settled(Strata.Stream.set_focus(Strata.Stream.start(world, Strata.Stream.config(r, 3, 32, 8)), Cons((ex, ey, ez), Nil)), 1000000)
      let t1 = Strata.Ffi.Vk.time()
      -- scene 4 empties the chunk holding the ground 40 m ahead, but only at
      -- frame 10, once the renderer holds and has drawn its mesh
      let hpx = float_to_int(Math.floor(ex +. Math.sin(yaw0) *. 40.0))
      let hpz = float_to_int(Math.floor(ez -. Math.cos(yaw0) *. 40.0))
      let hole0 = (Strata.Coord.chunk_of(hpx) * 32, Strata.Coord.chunk_of(land_height(land, hpx, hpz, seed)) * 32, Strata.Coord.chunk_of(hpz) * 32)
      -- a soak has no hole to dig: its circuit's centre rides in that slot
      let hole = if soak > 0 do mid else hole0 end
      let s0b = s0
      -- scene 5 builds a wall of the bad-texture block ahead, topped by an unregistered id
      let s0c = if scene != 5 do s0b
        else
          let gy = height(-35, 53, seed)
          let w1 = Strata.Edit.world(Strata.Edit.fill_box(Strata.Stream.world(s0b), -38, gy + 1, 53, -32, gy + 2, 53, 9))
          Strata.Stream.run_until_settled(Strata.Stream.apply(Strata.Stream.apply(s0b, Strata.Edit.fill_box(Strata.Stream.world(s0b), -38, gy + 1, 53, -32, gy + 2, 53, 9)), Strata.Edit.set_block(w1, -35, gy + 3, 53, 60000)), 1000000)
        end
      -- scenes 6 and 7 hang two see-through walls in the air, in different chunks: red glass at z = 20, water at z = 40
      let s0d = if scene != 6 && scene != 7 do s0c
        else
          let a1 = Strata.Stream.apply(s0c, Strata.Edit.fill_box(Strata.Stream.world(s0c), 8, 144, 20, 24, 156, 20, 10))
          Strata.Stream.run_until_settled(Strata.Stream.apply(a1, Strata.Edit.fill_box(Strata.Stream.world(a1), 8, 144, 40, 24, 156, 40, 5)), 1000000)
        end
      -- scene 16 digs a pit and, from it, a tunnel 14 m into the ground: a cave mouth to look into
      let s0f = if scene != 16 do s0d
        else
          let gy = height(-35, 53, seed)
          let pit = Strata.Stream.apply(s0d, Strata.Edit.fill_box(Strata.Stream.world(s0d), -36, gy - 3, 55, -34, gy + 6, 60, 0))
          Strata.Stream.run_until_settled(Strata.Stream.apply(pit, Strata.Edit.fill_box(Strata.Stream.world(pit), -36, gy - 3, 41, -34, gy - 1, 54, 0)), 1000000)
        end
      -- scene 17 stands a stone block two steps from the first lantern post
      let s0g = if scene != 17 do s0f
        else
          match first_post(seed, 0) do
            (px, pz) -> Strata.Stream.run_until_settled(Strata.Stream.apply(s0f, Strata.Edit.set_block(Strata.Stream.world(s0f), px + 2, height(px + 2, pz - 1, seed) + 1, pz - 1, 1)), 1000000)
          end
        end
      -- scene 20 lays a stone tray on stilts holding a row of lake water, one eighth to full, beside a full block of it
      let s0h = if scene == 21 || scene == 27 do
          let gy1 = height(-35, 53, seed) + 3
          let tray1 = Strata.Stream.apply(s0g, Strata.Edit.fill_box(Strata.Stream.world(s0g), -41, gy1, 50, -29, gy1, 56, 1))
          -- scene 23 puts a stone roof over it all, so the splash is in shade
          Strata.Stream.run_until_settled(if scene == 27 do Strata.Stream.apply(tray1, Strata.Edit.fill_box(Strata.Stream.world(tray1), -46, gy1 + 17, 44, -24, gy1 + 17, 62, 1)) else tray1 end, 1000000)
        else if scene != 20 && scene != 26 do s0g
        else
          let gy = height(-35, 53, seed) + 3
          let tray = Strata.Stream.apply(s0g, Strata.Edit.fill_box(Strata.Stream.world(s0g), -41, gy, 51, -30, gy + 1, 55, 1))
          let hollow = Strata.Stream.apply(tray, Strata.Edit.fill_box(Strata.Stream.world(tray), -40, gy + 1, 52, -31, gy + 1, 54, 0))
          Strata.Stream.run_until_settled(Strata.Stream.apply(hollow, Strata.Edit.set_many(Strata.Stream.world(hollow), stairs(gy + 1, 0, Nil))), 1000000)
        end end
      -- scene 12 starts with its slab in place unless a run asks for it to appear later
      let s0e = if scene == 12 && Env.get_int("STRATA_SLAB_AT", -1) < 0 do Strata.Stream.run_until_settled(slab(s0h, seed, 1), 1000000) else s0h end
      match Strata.Render.sync(Strata.Render.new(16384), s0e) do
        (sl, s1) ->
          println("strata_viewer: " ++ int_to_string(Strata.Stream.loaded_count(s1)) ++ " chunks streamed in " ++ float_to_string(Math.round((t1 -. t0) *. 1000.0)) ++ " ms; " ++ int_to_string(Strata.Ffi.Vk.live_quads()) ++ " quads, " ++ int_to_string(Strata.Ffi.Vk.live_quads() * 8 / 1024) ++ " KB on the GPU")
          -- the fixed scenes fly, holding their pose; the default and the walk scene stand on the ground
          let cam = Cam(ex, ey, ez, yaw0, pitch0, Strata.Coord.chunk_of(float_to_int(Math.floor(ex))), Strata.Coord.chunk_of(float_to_int(Math.floor(ey))), Strata.Coord.chunk_of(float_to_int(Math.floor(ez))), false, false, soak > 0 || (scene != 0 && scene != 11), 0.0, false, false, int_to_float(Env.get_int("STRATA_SUN", 55)), Env.get_int("STRATA_LIGHT", 4), false, 0, 0.0, 0)
          frame_loop(s1, Strata.Fluid.with_limits(Strata.Fluid.with_sea_top(Strata.Fluid.new(reg, Cons((lake_base(), Strata.Fluid.flowing()), Cons((5, Strata.Fluid.sea()), Nil))), sea()), Env.get_int("STRATA_FLUID_CAP", 4096), Env.get_int("STRATA_FLUID_REACH", 16), 4), None, sl, reg, cam, 0, frames, if soak > 0 do 2 else if scene == 11 && frames > 0 do 1 else if scene == 4 && frames > 0 do 3 else 0 end end end, hole, tl, 0.0, 0.0, 0.0, Strata.Ffi.Vk.time(), Strata.Ffi.Vk.time(), NativeArray.make_f32(16, 0.0), audio_start(frames), 0.0)
      end
      Strata.Ffi.Vk.close()
    end
  end
end
