-- strata_viewer — fly through a generated world. The first rendering slice:
-- a block registry, a pure terrain function, the greedy mesher, and the
-- Vulkan quad renderer, end to end.
--
--   W A S D   move        mouse / arrows   look        escape   quit
--   space     jump        F   switch between walking and flying
--   (flying: space rises, left shift sinks)
--   left click   blast a crater in what you are looking at
--   right click  build a sphere of stone onto it
--   L   step through the light modes        [ and ]   lower and raise the sun
--   N   play a recording from viewer/sounds/ (WAV, FLAC, MP3) 5 m ahead
--   H   switch sound between headphones (3D) and speakers      9 and 0   main sound level down and up
--   C   drop a crate ahead
--   R   reread viewer/assets/island.gen and regenerate every chunk not edited
--
-- The world streams in around the camera and has no edge: a 2 km island,
-- read from Strata.Atlas, in a sea that goes on.
--
-- STRATA_SCALE=0.1  the 10 cm world (StrataViewer.Fine): a tower, a wall, a cliff and a stream to knock down; stream radius 8 (STRATA_RADIUS is ignored)
-- STRATA_CRATE=f     drop a crate ahead of the camera at frame f (C does it by hand)
-- STRATA_CRATES=n    n crates in rows ahead of the camera at the start (for timing the rays)
-- STRATA_SUPPORT=0|1 terrain without support comes loose and falls (default: on when playing, off in scripted runs)
-- STRATA_LIGHT_BOX=n the light volume's horizontal radius in chunks (default: the stream's)
-- STRATA_SLAB_AT=f, STRATA_SLAB_OFF=f   scene 12: the frame its slab appears at, and the frame it goes
-- STRATA_LIGHT=n     light mode: 0 the old flat shading, 1 sky and sun, 2 + shadows, 3 + reflections, 4 + sky light (default), 9 the light volume
-- STRATA_FLUID=0     stop the water from moving
-- STRATA_FLUID_CAP=n, STRATA_FLUID_REACH=n   the fluid's cell cap a step and its way-down search (defaults 4096, 16)
-- STRATA_SPLASH=f     scene 21: drop a block of water from 12 cells up, and one cell from 4, at frame f
-- STRATA_SPRAY=0      no spray from falling water;  STRATA_FOUNTAIN=n  n spray particles a frame ahead of the camera
-- STRATA_ATLAS_DIR=d  where the island's atlas is cached (default .march/atlas)
-- STRATA_PARAMS=path  the generator's settings (default viewer/assets/island.gen, found as the ruins are)
-- STRATA_REGEN=1      regenerate once at frame 30, as the R key does (scripted runs)
-- STRATA_SCALE=m      metres a voxel (default 1; the fixed scenes are posed at 1 m)
-- STRATA_CHUNK_TIMES=1  time 200 surface chunks of the land in use, print the median and worst and the air and stone early-outs, then run as usual
-- STRATA_CHUNK_LEVEL=l  ... chunks of level l (the far field's; default 0)
-- STRATA_BREACH=f     scenes 18 and 19: breach the test lake's rim at frame f
-- STRATA_DRAIN=f      open a shaft in the test lake's floor at frame f
-- STRATA_SUN2=deg, STRATA_SUN2_AT=f   move the sun to that height at that frame
-- STRATA_SUN=deg    the sun's height above the horizon in degrees (default 55)
-- STRATA_HIDDEN=1    never show the window (use with STRATA_OFFSCREEN=1)
-- STRATA_PIXELS=1    STRATA_SIZE is in pixels, not points: the same image on any display
-- STRATA_RADIUS=n   horizontal radius in chunks (default 10)
-- STRATA_LEVELS=n   the far field: rings of coarser chunks, levels 1..n each 10 of its chunks out and 1 up and down
--                   (default 4: to 5.1 km at 1 m a voxel, 1.3 km at 0.25 m); 0 the near field alone, as before
-- STRATA_FRAMES=n   draw n frames, save a screenshot, exit (for scripts)
-- STRATA_SHOT=path  where the screenshot goes (a PPM)
-- STRATA_COMBAT_NAV=0  the match without path finding: fighters go straight at their goal, as before Strata.Nav
-- STRATA_FALLS=0|1  spray where a river's surface steps down (default: on when playing, off in scripted runs)
-- Key P            when playing: a picture of the view, saved as screenshots/strata-<process>-<frame>.png
-- STRATA_DIG=1      blast once at frame 10, as a left click would (for scripts)
-- STRATA_SCENE=n    start from fixed camera pose n (see `pose`); with STRATA_FRAMES the run is deterministic
-- STRATA_VSYNC=0    present immediately, for timing
-- STRATA_SIZE=WxH   window size in points (default 1280x800)
-- STRATA_OFFSCREEN=1 render without presenting, so frames are not paced by the display (timing)
-- STRATA_PAD_CMDS=n append n empty draw commands to each indirect call (measurement)
-- STRATA_LIGHT=n    light mode (0: the shading from before ray tracing)
-- STRATA_QUADS=n    how many quads the GPU buffer holds (default 8388608)
-- STRATA_REBUILD_AT=f  rebuild the swapchain at frame f, as a resize would (scripted runs)
--
-- STRATA_SOAK=n     fly a circuit round the test lake for n frames, blasting every 100, then report
--                   the worst and mean frame time, what the renderer still holds and each atlas lake's water
-- STRATA_AUDIO=0|1|null|wav:path   sound off (scripted default), the device (playing default), the silent null device, or rendered to a WAV in game time
-- STRATA_AUDIO_METER=1   a line of voices, refusals, underruns, CPU and level once a second
-- STRATA_STALL=n    hold the main thread 100 ms every n frames, as a hitch would (soak runs)
-- STRATA_AUDIO_LEVEL=x   the main level at start, 0..1 (9 and 0 change it while playing)
-- STRATA_FIGURES=n  n humanoids walking in small circles in rows ahead of the camera, on dry ground (StrataViewer.Figures)
-- STRATA_COMBAT=1  the free-for-all match (StrataViewer.Match; docs/2026-11-12-combat-design.md). With it: STRATA_COMBAT_PLAYER=0 no player,
--                   STRATA_COMBAT_WIN=n the kills that win (30), STRATA_COMBAT_REPEAT=n that many more matches after the first (scripted),
--                   STRATA_COMBAT_SCENE=duel|trap|fire|channel and STRATA_COMBAT_SCRIPT=archer|victim|far the scripted checks' scenes and players,
--                   STRATA_COMBAT_HOLD=1 a scripted run goes on to its last frame after a win (for the end screen's picture)
-- STRATA_SHORE=1  start on the shore nearest the origin, just above sea level, looking along it
-- STRATA_FIG_ROW=r  r of those walkers a row (default 32)
-- STRATA_TRACED=k  the first k of those walkers traced (seen by the light pass's rays; 64 at most at once)
-- STRATA_FIG_BOXES=0  traced figures that move unsettle no light history round them (read by the renderer: to show the trail they prevent)
-- STRATA_FIG_SHADOWS=0  plain figures cast no sun shadow (read by the renderer; the stored figure scenes 31 and 32 predate the shadows)
--
-- With STRATA_FRAMES or STRATA_SOAK set the run is scripted: keyboard and mouse are ignored.
mod StrataViewer do

  needs IO
  needs IO.Process
  needs IO.Spawn
  needs IO.Foreign
  needs Audio
  needs IO.FileSystem
  needs Anim

  alias Strata.Blocks as Bk
  alias Strata.Chunk as Ch
  alias Strata.Noise as Ns
  alias Strata.Math.Mat4 as M4
  alias Strata.Math.Vec3 as V3

  -- ── Blocks ───────────────────────────────────────────────────────────────
  -- ids: 1 stone, 2 dirt, 3 grass, 4 sand, 5 water, 6 snow, 7 wood, 8 leaves,
  -- 9 a block whose texture id (999) no layer has: it must draw as 'missing',
  -- 10 red glass (see-through, translucent), 11 tall grass (a cross),
  -- 12 a lantern post (a model: a thin post under a wider cap), 13 ice (smooth: it mirrors),
  -- 14..21 lake water, a fluid: one id per eighth of a voxel it fills (21 is full).
  -- Water (5) is the sea: it never moves, and swallows lake water that reaches it.
  -- texture ids are StrataViewer.Textures layers: the block id, plus 9 for a grass side
  pfn add(r : Strata.Blocks.Registry, d : Strata.Blocks.Def) : Strata.Blocks.Registry do
    match Bk.register(r, d) do
      Ok((r2, _)) -> r2
      Err(_) -> r
    end
  end

  -- The lantern post: what it looks like, and the boxes it collides by.
  pfn post_shape() : Strata.Model.Geometry do
    Strata.Model.box(Strata.Model.box(Strata.Model.empty(), 0.42, 0.0, 0.42, 0.58, 0.75, 0.58, 7), 0.3, 0.75, 0.3, 0.7, 1.0, 0.7, 4)
  end
  pfn post_boxes() : List(Strata.Blocks.Box) do
    Cons(Strata.Blocks.Box(0.42, 0.0, 0.42, 0.58, 0.75, 0.58), Cons(Strata.Blocks.Box(0.3, 0.75, 0.3, 0.7, 1.0, 0.7), Nil))
  end

  doc "The first id of the lake water family; the full voxel is this plus 7."
  fn lake_base() : Int do 14 end

  doc "The viewer's blocks."
  fn registry() : Strata.Blocks.Registry do
    let stone = Bk.with_faces(Bk.def(), 1, 1, 1)
    let dirt = Bk.with_faces(Bk.def(), 2, 2, 2)
    let grass = Bk.with_faces(Bk.def(), 3, 2, 9)
    let sand = Bk.with_faces(Bk.def(), 4, 4, 4)
    -- roughness: water 10 and ice 20 mirror, snow 140 carries a soft highlight, the rest are fully rough
    let water = Bk.with_material(Bk.with_faces(Bk.with_collide(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false), 5, 5, 5), 10, 0)
    let ice = Bk.with_material(Bk.with_faces(Bk.def(), 12, 12, 12), 20, 0)
    let snow = Bk.with_material(Bk.with_faces(Bk.def(), 6, 6, 6), 140, 0)
    let wood = Bk.with_faces(Bk.def(), 7, 7, 7)
    let leaves = Bk.with_faces(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Cutout), 8, 8, 8)
    let bad = Bk.with_faces(Bk.def(), 999, 999, 999)
    let glass = Bk.with_faces(Bk.with_layer(Bk.with_opacity(Bk.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), 10, 10, 10)
    let tall = Bk.with_faces(Bk.with_collide(Bk.with_style(Bk.with_opacity(Bk.def(), Strata.Blocks.Clear), Strata.Blocks.Cross), false), 11, 11, 11)
    match Bk.add_model(Bk.empty(), Strata.Model.floats(post_shape()), post_boxes()) do
      (r0, m) ->
        -- the post is a lantern: it gives off warm light
        let post = Bk.with_emission(Bk.with_style(Bk.with_opacity(Bk.def(), Strata.Blocks.Clear), Strata.Blocks.Model(m)), 255, 176, 96, 255)
        let r13 = add(add(add(add(add(add(add(add(add(add(add(add(add(r0, stone), dirt), grass), sand), water), snow), wood), leaves), bad), glass), tall), post), ice)
        match Bk.register_fluid(r13, water) do
          Ok((r21, _)) -> r21
          Err(_) -> r13
        end
    end
  end

  -- Upload the viewer's painted tiles and the registry's block table.
  pfn tiles_go(i : Int, ok : Bool) : Bool do
    if i >= StrataViewer.Textures.count() do ok
    else tiles_go(i + 1, Strata.Ffi.Vk.texture_set(i, StrataViewer.Textures.tile(i)) && ok) end
  end
  pfn textures(reg : Strata.Blocks.Registry) : Bool do
    Strata.Ffi.Vk.textures_create(StrataViewer.Textures.size(), StrataViewer.Textures.count()) && tiles_go(0, true) && Strata.Ffi.Vk.textures_commit() && Strata.Render.upload_blocks(reg) && Strata.Render.upload_models(reg)
  end

  -- ── The generator's settings ─────────────────────────────────────────────
  -- The land is described in metres: lengths and periods in metres (a noise
  -- frequency is 1 / its period), amplitudes in metres. The world's scale
  -- (metres a voxel) only decides how finely that shape is cut into voxels.
  --
  -- The generator's tunable numbers are settings, read from
  -- viewer/assets/island.gen (StrataViewer.Params: `name = value` lines) at
  -- start and on a regenerate (some stay in the code: a lake rim's 4 m,
  -- feature_top, max_reach, reach_m, a channel's depth, the tree species,
  -- and the atlas's site radius and relief; see the README); a name the file does not set takes the
  -- default below, and is said once a load. A generator holds its settings
  -- as a Gp, one float an entry of `param_table`, in its order.
  --
  -- Seeds: Strata.Seed.mix(seed, 4) the island's detail; 5 to 10 the island
  -- underground: density, tunnels (6, 7), caverns, entrance, rock strength.
  -- Salts for Strata.Seed.cell: 21 the tree kind's cells, 25 lantern posts,
  -- 26 tall grass, 28 / 29 a ruin's turn and stream, 31 a blast's crater
  -- (Strata.Edit uses salt 30 inside it); Strata.Seed.mix(seed, 600 + i) the tree templates.

  doc "Every generator setting as (name, default), in the order a Gp holds them: the atlas Def, the noise, the caves, the surface, the trees, then six per region 0..4 (tree density, the oak, birch, pine and willow shares of its trees, cave factor)."
  fn param_table() : List((String, Float)) do
    List.append(Cons(("atlas_samples", 512.0), Cons(("atlas_step", 4.0), Cons(("island_radius", 800.0), Cons(("region_size", 160.0), Cons(("region_count", 5.0), Cons(("sea", 40.0),
    Cons(("erosion_iterations", 50.0), Cons(("erosion_dt", 250000.0), Cons(("erosion_k", 0.000000561), Cons(("erosion_m", 0.4), Cons(("erosion_uplift", 0.000005), Cons(("erosion_talus_lo", 15.0), Cons(("erosion_talus_hi", 60.0),
    Cons(("river_min_area", 2000.0), Cons(("lake_margin", 0.3), Cons(("site_count", 8.0), Cons(("site_spacing", 150.0), Cons(("site_flat", 2.0), Cons(("lake_count", 6.0), Cons(("lake_radius", 30.0), Cons(("lake_depth", 5.0),
    Cons(("detail_amplitude", 6.0), Cons(("detail_period", 40.0), Cons(("detail_octaves", 4.0),
    Cons(("density_amplitude", 12.0), Cons(("density_squash", 1.0), Cons(("density_period", 60.0), Cons(("density_octaves", 3.0), Cons(("density_stretch", 4.0),
    Cons(("tunnel_period", 25.0), Cons(("tunnel_width", 0.08), Cons(("cavern_period", 90.0), Cons(("cavern_open", 0.45), Cons(("cave_roof", 6.0), Cons(("cave_depth", 40.0), Cons(("entrance_period", 120.0), Cons(("entrance_threshold", 0.6),
    Cons(("rock_period", 80.0), Cons(("talus_mid", 40.0), Cons(("talus_spread", 15.0), Cons(("thermal_passes", 4.0),
    Cons(("sand_below", 42.0), Cons(("snow_above", 95.0), Cons(("grass_below", 72.0), Cons(("post_chance", 0.006), Cons(("tall_grass_chance", 0.14), Cons(("beard_margin", 3.0),
    Cons(("tree_cell", 6.0), Cons(("tree_jitter", 0.6), Cons(("tree_chance", 0.35), Cons(("tree_min_height", 41.5), Cons(("tree_max_slope", 35.0),
    Nil)))))))))))))))))))))))))))))))))))))))))))))))))))),
    List.append(region_params(0, 0.9, 0.55, 0.25, 0.10, 0.10), List.append(region_params(1, 1.0, 0.10, 0.20, 0.70, 0.00), List.append(region_params(2, 0.6, 0.40, 0.40, 0.20, 0.00), List.append(region_params(3, 0.8, 0.20, 0.50, 0.30, 0.00), region_params(4, 0.5, 0.35, 0.15, 0.20, 0.30))))))
  end
  pfn region_params(r : Int, trees : Float, oak : Float, birch : Float, pine : Float, willow : Float) : List((String, Float)) do
    let n = "region" ++ int_to_string(r) ++ "_"
    Cons((n ++ "trees", trees), Cons((n ++ "oak", oak), Cons((n ++ "birch", birch), Cons((n ++ "pine", pine), Cons((n ++ "willow", willow), Cons((n ++ "caves", 1.0), Nil))))))
  end

  -- the settings, one float an entry of param_table
  type Gp = Gp(NativeFloatArr)
  pfn pv(g : Gp, i : Int) : Float do match g do Gp(a) -> NativeArray.get_float(a, i) end end
  pfn pi(g : Gp, i : Int) : Int do float_to_int(Math.round(pv(g, i))) end

  pfn gp_go(p : StrataViewer.Params.Params, t : List((String, Float)), a : NativeFloatArr, i : Int) : NativeFloatArr do
    match t do
      Nil -> a
      Cons((name, dflt), rest) -> gp_go(p, rest, NativeArray.set_float(a, i, unwrap_or(StrataViewer.Params.get(p, name), dflt)), i + 1)
    end
  end

  doc "The generator settings [p] gives: each name of param_table its value in [p], or its default."
  fn gp_of(p : StrataViewer.Params.Params) : Gp do
    let t = param_table()
    Gp(gp_go(p, t, NativeArray.make_float(List.length(t), 0.0), 0))
  end

  doc "Every setting at its default."
  fn gp_default() : Gp do gp_of(StrataViewer.Params.empty()) end

  pfn index_go(t : List((String, Float)), name : String, i : Int) : Int do
    match t do
      Nil -> -1
      Cons((k, _), rest) -> if k == name do i else index_go(rest, name, i + 1) end
    end
  end
  doc "The value of the setting [name] in g; 0 for a name param_table does not have."
  fn gp_value(g : Gp, name : String) : Float do
    let i = index_go(param_table(), name, 0)
    if i < 0 do 0.0 else pv(g, i) end
  end

  -- the names of ns, each once, in the order first met; and those met more than once, each once
  pfn once(ns : List(String), seen : List(String), twice : List(String)) : (List(String), List(String)) do
    match ns do
      Nil -> (List.reverse(seen), List.reverse(twice))
      Cons(n, rest) ->
        if List.member(seen, n) do once(rest, seen, if List.member(twice, n) do twice else Cons(n, twice) end)
        else once(rest, Cons(n, seen), twice) end
    end
  end

  doc "What a load of [p] says: a line for each name it leaves to its default, each name it sets that is no setting, each name it sets more than once (the last line wins), and each line it could not read; a name is said once."
  fn param_report(p : StrataViewer.Params.Params) : List(String) do
    let t = param_table()
    let (names, twice) = once(StrataViewer.Params.names(p), Nil, Nil)
    let unset = List.filter_map(t, fn e -> match e do (k, v) -> if Option.is_some(StrataViewer.Params.get(p, k)) do None else Some("strata_viewer: island.gen does not set " ++ k ++ "; the default " ++ float_to_string(v) ++ " is used") end end)
    let odd = List.filter_map(names, fn k -> if index_go(t, k, 0) < 0 do Some("strata_viewer: island.gen sets " ++ k ++ ", which is no setting; ignored") else None end)
    let dup = List.map(twice, fn k -> "strata_viewer: island.gen sets " ++ k ++ " more than once; the last line is used")
    let bad = List.map(StrataViewer.Params.bad_lines(p), fn l -> "strata_viewer: island.gen line not understood, ignored: " ++ l)
    List.append(unset, List.append(odd, List.append(dup, bad)))
  end

  -- the settings by name (indices into param_table)
  pfn p_sea(g : Gp) : Float do pv(g, 5) end
  pfn p_detail_amp(g : Gp) : Float do pv(g, 21) end
  pfn p_detail_freq(g : Gp) : Float do 1.0 /. pv(g, 22) end
  pfn p_detail_oct(g : Gp) : Int do pi(g, 23) end
  pfn p_amp(g : Gp) : Float do pv(g, 24) end
  pfn p_squash(g : Gp) : Float do pv(g, 25) end
  pfn p_dens_freq(g : Gp) : Float do 1.0 /. pv(g, 26) end
  pfn p_dens_oct(g : Gp) : Int do pi(g, 27) end
  -- the density noise is sampled at y / stretch: stretched that many times upright
  pfn p_dens_squeeze(g : Gp) : Float do 1.0 /. pv(g, 28) end
  pfn p_tunnel_freq(g : Gp) : Float do 1.0 /. pv(g, 29) end
  pfn p_tunnel_w(g : Gp) : Float do pv(g, 30) end
  pfn p_cavern_freq(g : Gp) : Float do 1.0 /. pv(g, 31) end
  pfn p_cavern_open(g : Gp) : Float do pv(g, 32) end
  pfn p_roof(g : Gp) : Float do pv(g, 33) end
  pfn p_cave_depth(g : Gp) : Float do pv(g, 34) end
  pfn p_entrance_freq(g : Gp) : Float do 1.0 /. pv(g, 35) end
  pfn p_entrance(g : Gp) : Float do pv(g, 36) end
  pfn p_rock_freq(g : Gp) : Float do 1.0 /. pv(g, 37) end
  pfn p_talus_mid(g : Gp) : Float do pv(g, 38) end
  pfn p_talus_spread(g : Gp) : Float do pv(g, 39) end
  pfn p_passes(g : Gp) : Int do pi(g, 40) end
  pfn p_sand_below(g : Gp) : Float do pv(g, 41) end
  pfn p_snow_above(g : Gp) : Float do pv(g, 42) end
  pfn p_grass_below(g : Gp) : Float do pv(g, 43) end
  pfn p_post(g : Gp) : Float do pv(g, 44) end
  pfn p_tall_grass(g : Gp) : Float do pv(g, 45) end
  pfn p_beard(g : Gp) : Float do pv(g, 46) end
  pfn p_tree_cell(g : Gp) : Float do pv(g, 47) end
  pfn p_tree_jitter(g : Gp) : Float do pv(g, 48) end
  pfn p_tree_chance(g : Gp) : Float do pv(g, 49) end
  pfn p_tree_min(g : Gp) : Float do pv(g, 50) end
  -- tan of the steepest slope a tree stands on
  pfn p_tree_slope(g : Gp) : Float do math_tan(pv(g, 51) *. 0.017453292519943295) end
  -- region r's settings: 0 tree density, 1..4 the species shares, 5 the cave factor; regions
  -- past 4 (and the sea's -1) read region 4's trees, as before the settings were read
  pfn p_region(g : Gp, r : Int, k : Int) : Float do pv(g, 52 + 6 * (if r >= 0 && r <= 3 do r else 4 end) + k) end

  doc "The island's sea level in metres in settings g."
  fn gen_sea(g : Gp) : Float do p_sea(g) end
  -- the sea level in whole metres at the default settings (voxels at 1 m): the shore searches, crates and figures stand by it
  pfn sea() : Int do float_to_int(Math.floor(gen_sea(gp_default()))) end

  doc "The atlas definition in settings g: by default 512 x 512 samples 4 m apart, a 2 km island 800 m in radius, the sea at 40 m."
  fn island_def_of(g : Gp) : Strata.Atlas.Def do
    -- the erosion's n exponent is 1: Strata.Erosion carries it for the record and does not use it
    let e = Strata.Erosion.params(pi(g, 6), pv(g, 7), pv(g, 8), pv(g, 9), 1.0, pv(g, 10), pv(g, 11), pv(g, 12))
    let d0 = Strata.Atlas.def(pi(g, 0), pv(g, 1), pv(g, 2), pv(g, 3), pi(g, 4), p_sea(g))
    Strata.Atlas.with_lakes(Strata.Atlas.with_sites(Strata.Atlas.with_rivers(Strata.Atlas.with_erosion(d0, e), pv(g, 13), pv(g, 14)), pi(g, 15), pv(g, 16), pv(g, 17)), pi(g, 18), pv(g, 19), pv(g, 20))
  end

  doc "The viewer's island at the default settings."
  fn island_def() : Strata.Atlas.Def do island_def_of(gp_default()) end

  pfn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end

  -- a fresh [0, 1) value for a column, from its own salt
  pfn roll(wx : Int, wz : Int, seed : Int, salt : Int) : Float do
    Strata.Seed.unit(Strata.Seed.cell(seed, salt, wx, 0, wz))
  end

  -- whole voxels of [scale] metres in [m] metres (a hair over, so 34 m at 0.1 is 340)
  pfn vox(m : Float, scale : Float) : Int do float_to_int(Math.floor(m /. scale +. 0.000001)) end

  -- the sea's level in whole voxels
  pfn sea_v(g : Gp, scale : Float) : Int do vox(p_sea(g), scale) end

  pfn fdiv(a : Int, b : Int) : Int do if a >= 0 do a / b else 0 - ((b - 1 - a) / b) end end

  -- hm is a column's ground height in metres; grass grows between one metre over the sea and grass_below
  pfn grassy(g : Gp, hm : Float) : Bool do hm > p_sea(g) +. 1.0 && hm <= p_grass_below(g) end

  -- the whole metre holding voxel w's low corner
  pfn metre_of(w : Int, scale : Float) : Int do float_to_int(Math.floor(int_to_float(w) *. scale +. 0.000001)) end

  -- A post is rolled per one-metre cell (salt 25 at the cell's whole-metre
  -- coordinates), so posts are as many to a square metre at every scale, and
  -- stands on the column holding the cell's centre. At 1 m the cell is the
  -- column, so the posts are where they always were.
  pfn has_post(g : Gp, wx : Int, wz : Int, hm : Float, seed : Int, scale : Float) : Bool do
    let mx = metre_of(wx, scale)
    let mz = metre_of(wz, scale)
    if !grassy(g, hm) do false
    else if wx != vox(int_to_float(mx) +. 0.5, scale) do false
    else if wz != vox(int_to_float(mz) +. 0.5, scale) do false
    else roll(mx, mz, seed, 25) > 1.0 -. p_post(g) end end end
  end

  -- ── Features: trees and ruins ────────────────────────────────────────────
  -- Trees are Strata.Feature placements of a tree kind: cells tree_cell (6 m) on a side,
  -- jitter tree_jitter (0.6), salt 21, chance tree_chance (0.35) times the region's density, its radius
  -- the largest tree template's half-width (at least 4 m). Each tree is one
  -- of a library of 12 templates built at start-up by StrataViewer.Trees at
  -- the world's voxel size, 3 of each species with seeds
  -- Strata.Seed.mix(seed, 600 + i); a placement's index picks the species by
  -- its region's mix, then one of the three. A chunk asks for the placements
  -- of its own box (the kind's radius grows it) and blits each tree, clipped
  -- to the chunk, so a tree that crosses chunks is whole. A tree stands on
  -- the ground top of its base column, not on lake or river water, not
  -- within a site's beard, not on a slope over tree_max_slope (35 degrees),
  -- not below tree_min_height (41.5 m).
  --
  -- Region ids 0..4: tree density (of the chance) and the species mix
  -- (oak, birch, pine, willow), the defaults of the regionN_ settings:
  --   0  0.9   0.55 0.25 0.10 0.10      3  0.8   0.20 0.50 0.30 0.00
  --   1  1.0   0.10 0.20 0.70 0.00      4  0.5   0.35 0.15 0.20 0.30
  --   2  0.6   0.40 0.40 0.20 0.00
  --
  -- Ruins stand on the atlas's sites: template s_index % 3 of wall, tower,
  -- arch (viewer/assets/ruins, palette 1 and 2 stone, 3 rubble as dirt),
  -- turned by the site's hash (Strata.Seed.cell(seed, 28, s_index, 0, 0)),
  -- centred on the site, its bottom row on the ground at the site floor.
  -- They were authored at 1 m a voxel and are fitted to the world's voxel
  -- size (Strata.Template.fit: each voxel 2 x 2 x 2 at 0.5 m), so a ruin is
  -- as many metres across at every scale that divides a metre; at any other
  -- scale the world has none, and says so once.

  -- the tree templates (species s at 3 s .. 3 s + 2), the ruins (wall, tower, arch), the trees' reach in metres, the settings,
  -- and each tree template coarsened for levels 1 and 2 (coarse_windows)
  type Decor = Decor(List(Strata.Template.Template), List(Strata.Template.Template), Float, Gp, List((NativeU8Arr, NativeU8Arr)))

  doc "No trees and no ruins: the land alone, at the default settings."
  fn bare_decor() : Decor do Decor(Nil, Nil, 4.0, gp_default(), Nil) end

  doc "No trees and no ruins, at settings g."
  fn bare_decor_of(g : Gp) : Decor do Decor(Nil, Nil, 4.0, g, Nil) end

  -- ── Coarse trees ─────────────────────────────────────────────────────────
  -- A tree at level 1 or 2 is its template coarsened: a coarse voxel is wood
  -- if any voxel of the fine template in its 2^L cube is wood, else leaves if
  -- any is leaves. The cubes are the WORLD's (a coarse voxel of the chunk),
  -- not the template's, so the coarse tree is exactly the fine tree's
  -- coarsening wherever the tree stands: for each template and level a
  -- window table holds, for every cube start in template coordinates
  -- (-(2^L - 1) .. size - 1 on each axis), 2 for wood, 1 for leaves, 0 for
  -- none; it is built once, beside the template.

  -- the code of a template id: 2 wood (any id but leaves and holes), 1 leaves (8), 0 a hole
  pfn tree_code(id : Int) : Int do if id == 0 do 0 else if id == 8 do 1 else 2 end end end
  pfn codes_go(ids : NativeI32Arr, out : NativeU8Arr, i : Int, n : Int) : NativeU8Arr do
    if i >= n do out else codes_go(ids, NativeArray.set_u8(out, i, tree_code(NativeArray.get_i32(ids, i))), i + 1, n) end
  end
  -- the largest code over a window of [w] along one axis: src is nx x ny x nz (x fastest, then y, then z),
  -- the result one axis (0 x, 1 y, 2 z) w - 1 longer, its entry c the window starting at c - (w - 1)
  pfn win_max(src : NativeU8Arr, nx : Int, ny : Int, nz : Int, axis : Int, w : Int, q : Int, x : Int, y : Int, z : Int, best : Int) : Int do
    if q >= w do best
    else
      let xx = if axis == 0 do x - (w - 1) + q else x end
      let yy = if axis == 1 do y - (w - 1) + q else y end
      let zz = if axis == 2 do z - (w - 1) + q else z end
      let inside = if xx < 0 do false else if xx >= nx do false else if yy < 0 do false else if yy >= ny do false else if zz < 0 do false else zz < nz end end end end end
      let v = if inside do NativeArray.get_u8(src, xx + nx * (yy + ny * zz)) else 0 end
      win_max(src, nx, ny, nz, axis, w, q + 1, x, y, z, if v > best do v else best end)
    end
  end
  pfn win_go(src : NativeU8Arr, nx : Int, ny : Int, nz : Int, axis : Int, w : Int, out : NativeU8Arr, mx : Int, my : Int, t : Int, n : Int) : NativeU8Arr do
    if t >= n do out
    else
      let x = t % mx
      let y = (t / mx) % my
      let z = t / (mx * my)
      win_go(src, nx, ny, nz, axis, w, NativeArray.set_u8(out, t, win_max(src, nx, ny, nz, axis, w, 0, x, y, z, 0)), mx, my, t + 1, n)
    end
  end
  pfn win_axis(src : NativeU8Arr, nx : Int, ny : Int, nz : Int, axis : Int, w : Int) : NativeU8Arr do
    let mx = if axis == 0 do nx + w - 1 else nx end
    let my = if axis == 1 do ny + w - 1 else ny end
    let mz = if axis == 2 do nz + w - 1 else nz end
    win_go(src, nx, ny, nz, axis, w, NativeArray.make_u8(mx * my * mz, 0), mx, my, 0, mx * my * mz)
  end
  doc "A tree template's window table for level [l] (cubes of 2^l): (sx + m) x (sy + m) x (sz + m), m = 2^l - 1, x fastest; the entry at (i + m, j + m, k + m) is the code of the cube starting at template voxel (i, j, k): 2 if it holds wood, else 1 if leaves, else 0."
  fn coarse_window(t : Strata.Template.Template, l : Int) : NativeU8Arr do
    let w = float_to_int(pow2f(l))
    let sx = Strata.Template.t_sx(t)
    let sy = Strata.Template.t_sy(t)
    let sz = Strata.Template.t_sz(t)
    let c0 = codes_go(Strata.Template.t_ids(t), NativeArray.make_u8(sx * sy * sz, 0), 0, sx * sy * sz)
    let c1 = win_axis(c0, sx, sy, sz, 0, w)
    let c2 = win_axis(c1, sx + w - 1, sy, sz, 1, w)
    win_axis(c2, sx + w - 1, sy + w - 1, sz, 2, w)
  end

  -- the window code at cube start (i, j, k) of template t, 0 off the table
  pfn window_at(t : Strata.Template.Template, win : NativeU8Arr, m : Int, i : Int, j : Int, k : Int) : Int do
    let ax = Strata.Template.t_sx(t) + m
    let ay = Strata.Template.t_sy(t) + m
    let az = Strata.Template.t_sz(t) + m
    let ii = i + m
    let jj = j + m
    let kk = k + m
    if ii < 0 do 0 else if ii >= ax do 0 else if jj < 0 do 0 else if jj >= ay do 0 else if kk < 0 do 0 else if kk >= az do 0
    else NativeArray.get_u8(win, ii + ax * (jj + ay * kk)) end end end end end end
  end

  doc "The code (2 wood, 1 leaves, 0 none) of coarse voxel (cx, cy, cz) of level [l] (cubes of w = 2^l level-0 voxels) for template t blitted at level-0 voxel (ox, oy, oz), turned rot, with its window table win."
  fn coarse_code(t : Strata.Template.Template, win : NativeU8Arr, w : Int, ox : Int, oy : Int, oz : Int, rot : Int, cx : Int, cy : Int, cz : Int) : Int do
    let m = w - 1
    let a = cx * w - ox
    let b = cz * w - oz
    let j = cy * w - oy
    let sx = Strata.Template.t_sx(t)
    let sz = Strata.Template.t_sz(t)
    let r = ((rot % 4) + 4) % 4
    -- the footprint window [a, a + w) x [b, b + w) in the template's own coordinates (Strata.Template's turns)
    if r == 0 do window_at(t, win, m, a, j, b)
    else if r == 1 do window_at(t, win, m, b, j, sz - a - w)
    else if r == 2 do window_at(t, win, m, sx - a - w, j, sz - b - w)
    else window_at(t, win, m, sx - b - w, j, a) end end end
  end

  -- floor(v / d), d > 0, any sign
  pfn fdivv(v : Int, d : Int) : Int do if v >= 0 do v / d else 0 - ((d - 1 - v) / d) end end

  -- one coarse tree into chunk c (level-l voxels from (x0, y0, z0)): every coarse voxel of it inside the chunk that is air
  pfn coarse_tree_into(c : Strata.Chunk.Chunk, t : Strata.Template.Template, win : NativeU8Arr, w : Int, ox : Int, oy : Int, oz : Int, rot : Int, x0 : Int, y0 : Int, z0 : Int) : Strata.Chunk.Chunk do
    let fw = if rot % 2 == 0 do Strata.Template.t_sx(t) else Strata.Template.t_sz(t) end
    let fd = if rot % 2 == 0 do Strata.Template.t_sz(t) else Strata.Template.t_sx(t) end
    let gx0 = imax(fdivv(ox, w), x0)
    let gx1 = imin(fdivv(ox + fw - 1, w), x0 + 31)
    let gy0 = imax(fdivv(oy, w), y0)
    let gy1 = imin(fdivv(oy + Strata.Template.t_sy(t) - 1, w), y0 + 31)
    let gz0 = imax(fdivv(oz, w), z0)
    let gz1 = imin(fdivv(oz + fd - 1, w), z0 + 31)
    if gx0 > gx1 || gy0 > gy1 || gz0 > gz1 do c
    else
      let nx = gx1 - gx0 + 1
      let nz = gz1 - gz0 + 1
      coarse_cells(c, t, win, w, ox, oy, oz, rot, x0, y0, z0, gx0, gy0, gz0, nx, nz, 0, nx * nz * (gy1 - gy0 + 1))
    end
  end
  pfn coarse_cells(c : Strata.Chunk.Chunk, t : Strata.Template.Template, win : NativeU8Arr, w : Int, ox : Int, oy : Int, oz : Int, rot : Int, x0 : Int, y0 : Int, z0 : Int, gx0 : Int, gy0 : Int, gz0 : Int, nx : Int, nz : Int, i : Int, n : Int) : Strata.Chunk.Chunk do
    if i >= n do c
    else
      let gx = gx0 + i % nx
      let gz = gz0 + (i / nx) % nz
      let gy = gy0 + i / (nx * nz)
      let code = coarse_code(t, win, w, ox, oy, oz, rot, gx, gy, gz)
      let c2 = if code == 0 do c else if Ch.get_or(c, gx - x0, gy - y0, gz - z0, 1) != 0 do c else Ch.set(c, gx - x0, gy - y0, gz - z0, if code == 2 do 7 else 8 end) end end
      coarse_cells(c2, t, win, w, ox, oy, oz, rot, x0, y0, z0, gx0, gy0, gz0, nx, nz, i + 1, n)
    end
  end
  pfn imax(a : Int, b : Int) : Int do if a > b do a else b end end
  pfn imin(a : Int, b : Int) : Int do if a < b do a else b end end

  pfn trees_go(scale : Float, seed : Int, i : Int, acc : List(Strata.Template.Template)) : List(Strata.Template.Template) do
    if i < 0 do acc else trees_go(scale, seed, i - 1, Cons(StrataViewer.Trees.build(i / 3, Strata.Seed.mix(seed, 600 + i), scale), acc)) end
  end
  pfn reach_go(ts : List(Strata.Template.Template), scale : Float, best : Float) : Float do
    match ts do
      Nil -> best
      Cons(t, rest) -> reach_go(rest, scale, fmax(best, (int_to_float(StrataViewer.Trees.base_offset(t)) +. 0.5) *. scale))
    end
  end

  -- a ruin's palette: 1 and 2 stone, 3 rubble (dirt)
  pfn ruin_palette() : NativeI32Arr do
    NativeArray.set_i32(NativeArray.set_i32(NativeArray.set_i32(NativeArray.make_i32(256, 0), 1, 1), 2, 1), 3, 2)
  end
  pfn vox_file(path : String) : Option(NativeU8Arr) do
    match Authority.must(File.read(path)) do
      Ok(text) -> Some(Bytes.to_u8_arr(Bytes.from_string(text)))
      Err(_) -> None
    end
  end
  -- where the ruins are: viewer/assets/ruins, found from the program's own path (the viewer and its
  -- tests are built in viewer/.march/build/<profile>/), else from the working directory
  pfn ruin_dirs() : List(String) do
    let own = match process_argv() do
        Cons(exe, _) -> Cons(Path.dirname(exe) ++ "/../../../assets/ruins/", Nil)
        Nil -> Nil
      end
    List.append(own, Cons("viewer/assets/ruins/", Cons("assets/ruins/", Nil)))
  end
  pfn first_file(ds : List(String), name : String) : Option(NativeU8Arr) do
    match ds do
      Nil -> None
      Cons(d, rest) ->
        match vox_file(d ++ name) do
          Some(b) -> Some(b)
          None -> first_file(rest, name)
        end
    end
  end
  -- the voxel size the ruins were authored at, in metres
  pfn ruin_voxel() : Float do 1.0 end

  -- a ruin template by file name, as authored (ruin_voxel metres a voxel), added to acc when it can be read
  pfn ruin(name : String, acc : List((String, Strata.Template.Template))) : List((String, Strata.Template.Template)) do
    let bytes = first_file(ruin_dirs(), name)
    match bytes do
      Some(b) ->
        match Strata.Template.from_vox(b, ruin_palette(), ruin_voxel()) do
          Some(t) -> Cons((name, t), acc)
          None -> acc
        end
      None -> acc
    end
  end

  pfn say_once(line : String) : Unit do
    let _set = process_set_env("STRATA_RUINS_SAID", "1")
    Authority.must(println(line))
  end

  doc "The trees and ruins of a world of [scale] metres a voxel for [seed], at the default settings: 12 tree templates and the three ruins (none if their files are not found)."
  fn decor(scale : Float, seed : Int) : Decor do decor_of(gp_default(), scale, seed) end

  doc "The trees and ruins of a world of [scale] metres a voxel for [seed], at settings g."
  fn decor_of(g : Gp, scale : Float, seed : Int) : Decor do
    let ts = trees_go(scale, seed, 11, Nil)
    let read = ruin("wall.vox", ruin("tower.vox", ruin("arch.vox", Nil)))
    -- each put into the world's voxel size, as many metres across as authored (Strata.Template.fit)
    let rs = List.filter_map(read, fn e -> match e do (_, t) -> Strata.Template.fit(t, scale) end)
    let refused = List.filter_map(read, fn e -> match e do (nm, t) -> if Option.is_some(Strata.Template.fit(t, scale)) do None else Some(nm) end end)
    -- said once a run: the flag is an environment variable of this process
    let _said = if List.length(rs) == 3 do () else if Authority.must(Env.get("STRATA_RUINS_SAID", "")) == "1" do ()
      else if List.length(read) < 3 do say_once("strata_viewer: the ruins (wall, tower, arch .vox) were not all found under " ++ String.join(ruin_dirs(), ", ") ++ "; no ruins")
      else say_once("strata_viewer: the ruins " ++ String.join(refused, ", ") ++ " were authored at " ++ float_to_string(ruin_voxel()) ++ " m a voxel, which " ++ float_to_string(scale) ++ " m a voxel does not divide; no ruins") end end end
    Decor(ts, if List.length(rs) == 3 do rs else Nil end, fmax(4.0, reach_go(ts, scale, 0.0)), g, List.map(ts, fn t -> (coarse_window(t, 1), coarse_window(t, 2))))
  end

  doc "The tree templates of a Decor (species s at 3 s .. 3 s + 2)."
  fn decor_trees(d : Decor) : List(Strata.Template.Template) do match d do Decor(v, _, _, _, _) -> v end end
  doc "The ruin templates of a Decor: wall, tower, arch, or none."
  fn decor_ruins(d : Decor) : List(Strata.Template.Template) do match d do Decor(_, v, _, _, _) -> v end end
  pfn decor_reach(d : Decor) : Float do match d do Decor(_, _, v, _, _) -> v end end
  pfn decor_coarse(d : Decor) : List((NativeU8Arr, NativeU8Arr)) do match d do Decor(_, _, _, _, v) -> v end end
  doc "The generator settings a Decor carries."
  fn decor_gp(d : Decor) : Gp do match d do Decor(_, _, _, g, _) -> g end end

  doc "The tree kind of a Decor: cells tree_cell (6 m), its radius the trees' reach, jitter tree_jitter (0.6), salt 21, chance tree_chance (0.35)."
  fn tree_kind(d : Decor) : Strata.Feature.FeatureKind do
    let g = decor_gp(d)
    Strata.Feature.kind(p_tree_cell(g), decor_reach(d), p_tree_jitter(g), 21, p_tree_chance(g))
  end

  doc "How high over the ground a tree or a ruin may reach, in metres (the early-outs leave this much room)."
  fn feature_top() : Float do 18.0 end
  doc "How far from its base a tree may reach, in metres (the island's early-out window covers this much more)."
  fn max_reach() : Float do 10.0 end

  pfn region_density(g : Gp, r : Int) : Float do p_region(g, r, 0) end
  -- the species whose share of region r's mix u falls in (the shares summed in turn)
  pfn species_of(g : Gp, r : Int, u : Float) : Int do
    let a = p_region(g, r, 1)
    let b = a +. p_region(g, r, 2)
    let c = b +. p_region(g, r, 3)
    if u < a do 0 else if u < b do 1 else if u < c do 2 else 3 end end end
  end

  doc "The species (0 oak, 1 birch, 2 pine, 3 willow) a placement's index picks in a region, by the region's mix in settings g."
  fn tree_species(g : Gp, region : Int, index : Int) : Int do species_of(g, region, Strata.Seed.unit(index)) end

  doc "The tree template a placement's index picks in a region: the species by the region's mix, then one of its three; None with no trees."
  fn pick_tree(d : Decor, region : Int, index : Int) : Option(Strata.Template.Template) do
    let ts = decor_trees(d)
    if List.length(ts) < 12 do None else List.nth_opt(ts, pick_at(d, region, index)) end
  end
  doc "Which of the 12 tree templates (species s at 3 s .. 3 s + 2) a placement's index picks in a region, by d's settings."
  fn tree_pick(d : Decor, region : Int, index : Int) : Int do pick_at(d, region, index) end
  -- which of the 12 templates a placement's index picks in a region
  pfn pick_at(d : Decor, region : Int, index : Int) : Int do
    let sp = tree_species(decor_gp(d), region, index)
    let v = float_to_int(Strata.Seed.unit(Strata.Seed.next(index)) *. 3.0)
    3 * sp + (if v > 2 do 2 else v end)
  end

  -- whether a placement stands in the box x0..x1, z0..z1 (metres) grown by r: the only ones whose template can reach it
  pfn reaches(p : Strata.Feature.Placed, x0 : Float, z0 : Float, x1 : Float, z1 : Float, r : Float) : Bool do
    let x = Strata.Feature.p_xm(p)
    let z = Strata.Feature.p_zm(p)
    if x < x0 -. r do false else if x > x1 +. r do false else if z < z0 -. r do false else z <= z1 +. r end end end
  end

  doc "A tree's world box (x0, y0, z0, x1, y1, z1) and where it is blitted: template t with its base on ground top y of column (wx, wz), turned rot. The trunk's base voxel is (wx, y + 1, wz)."
  fn tree_origin(t : Strata.Template.Template, wx : Int, y : Int, wz : Int) : (Int, Int, Int) do
    let half = StrataViewer.Trees.base_offset(t)
    (wx - half, y + 1, wz - half)
  end

  -- a tree on ground top y of column (wx, wz), blitted into chunk c at key k
  pfn put_tree(c : Strata.Chunk.Chunk, k : Strata.Coord.Key, t : Strata.Template.Template, p : Strata.Feature.Placed, wx : Int, y : Int, wz : Int) : Strata.Chunk.Chunk do
    match tree_origin(t, wx, y, wz) do
      (ox, oy, oz) -> Strata.Template.blit(c, k, t, ox, oy, oz, Strata.Feature.p_rot(p), Strata.Feature.p_stream(p))
    end
  end

  -- whether a slope of (dx, dz) metres a metre is steeper than tan [t] (tree_max_slope)
  pfn steep(t : Float, dx : Float, dz : Float) : Bool do dx *. dx +. dz *. dz > t *. t end

  -- the trees blitted into chunk c at key k
  pfn trees_into(c : Strata.Chunk.Chunk, k : Strata.Coord.Key, ts : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int))) : Strata.Chunk.Chunk do
    match ts do
      Nil -> c
      Cons((t, p, wx, y, wz), rest) -> trees_into(put_tree(c, k, t, p, wx, y, wz), k, rest)
    end
  end
  -- ── The island: terrain read from the atlas ──────────────────────────────
  -- The land is Strata.Atlas's island, read per column, with detail_amplitude
  -- (6 m) of detail on top.
  --
  -- A column's height is the atlas height plus detail, damp times 6 m of fBm
  -- (Strata.Seed.mix(seed, 4), detail_octaves 4 at 1 / detail_period, 1/40 cycles a metre). damp = clamp01(distance from the nearest
  -- river sample's bank / (2 * its width)), and 0 over a lake: the land
  -- flattens toward a river and lies still under a lake. Where the bilinear
  -- river width is 1 m or more the column is channel: sink water (id 5)
  -- stands to the river's surface, the atlas height of the nearest river
  -- sample (the bilinear height climbs the banks), over ground lowered
  -- min(1.5, width / 6) m (at least one voxel) under it. A column whose nearest atlas
  -- sample is lake holds the lake fluid, full voxels from its sandy bed (the
  -- atlas bed) to the atlas level. The sea is sink water up to 40 m.
  --
  -- Two clamps keep water from standing beside air: land within 4 m of a lake
  -- column stands at least one metre over its level, and beside a river
  -- (damp below 1) the detail only raises the ground.

  -- The viewer's land: the island of an atlas.
  type Land = Island(Strata.Atlas.Atlas)

  pfn fmax(p : Float, q : Float) : Float do if p > q do p else q end end
  pfn fmin(p : Float, q : Float) : Float do if p < q do p else q end end

  -- detail_amplitude of fBm at 1 / detail_period cycles per metre, undamped
  pfn detail_raw(g : Gp, xm : Float, zm : Float, seed : Int) : Float do
    p_detail_amp(g) *. Ns.sample2(Ns.settings(0, p_detail_oct(g), 2.0, 0.5, 1, 0.0), Strata.Seed.mix(seed, 4), p_detail_freq(g), xm, zm)
  end

  -- The atlas around an area, copied once into arrays the generating task
  -- owns (reading the shared atlas column by column ran 45 times slower,
  -- GAPS S15): the first sample (i0, j0), the side, the step, the atlas's n,
  -- then the heights, lake levels and river widths, and the river samples
  -- whose banks lie within two widths of the area, as (x, z, width, height);
  -- last, whether any sample in the window is lake (if not, no rim is looked for).
  type Win = Win(Int, Int, Int, Float, Int, NativeF32Arr, NativeF32Arr, NativeF32Arr, List((Float, Float, Float, Float)), Bool)

  -- how far past an area the window reaches for rivers, in metres
  pfn reach_m() : Float do 64.0 end

  doc "The atlas copied over the area x0..x1, z0..z1 (metres), with 64 m around it for the rivers."
  fn island_window(a : Strata.Atlas.Atlas, x0 : Float, z0 : Float, x1 : Float, z1 : Float) : Win do
    let st = Strata.Atlas.step(a)
    let nn = Strata.Atlas.n(a)
    let i0 = float_to_int(Math.floor((x0 -. reach_m()) /. st)) + nn / 2
    let j0 = float_to_int(Math.floor((z0 -. reach_m()) /. st)) + nn / 2
    let i1 = float_to_int(Math.ceil((x1 +. reach_m()) /. st)) + nn / 2 + 1
    let j1 = float_to_int(Math.ceil((z1 +. reach_m()) /. st)) + nn / 2 + 1
    let side = if i1 - i0 > j1 - j0 do i1 - i0 + 1 else j1 - j0 + 1 end
    let ws = Strata.Atlas.window(a, 4, i0, j0, side)
    let hs = Strata.Atlas.window(a, 0, i0, j0, side)
    let ls = Strata.Atlas.window(a, 2, i0, j0, side)
    Win(i0, j0, side, st, nn, hs, ls, ws, near_go(ws, hs, i0, j0, side, st, nn, x0, z0, x1, z1, 0, Nil), any_lake(ls, 0, side * side))
  end

  pfn any_lake(ls : NativeF32Arr, k : Int, cnt : Int) : Bool do
    if k >= cnt do false else if NativeArray.get_f32(ls, k) >= 0.0 do true else any_lake(ls, k + 1, cnt) end end
  end

  pfn near_go(ws : NativeF32Arr, hs : NativeF32Arr, i0 : Int, j0 : Int, side : Int, st : Float, nn : Int, x0 : Float, z0 : Float, x1 : Float, z1 : Float, k : Int, acc : List((Float, Float, Float, Float))) : List((Float, Float, Float, Float)) do
    if k >= side * side do acc
    else
      let w = NativeArray.get_f32(ws, k)
      if w <= 0.0 do near_go(ws, hs, i0, j0, side, st, nn, x0, z0, x1, z1, k + 1, acc)
      else
        let x = int_to_float(i0 + k % side - nn / 2) *. st
        let z = int_to_float(j0 + k / side - nn / 2) *. st
        let reach = 2.5 *. w
        let near = if x < x0 -. reach || x > x1 +. reach do false else if z < z0 -. reach do false else z <= z1 +. reach end end
        near_go(ws, hs, i0, j0, side, st, nn, x0, z0, x1, z1, k + 1, if near do Cons((x, z, w, NativeArray.get_f32(hs, k)), acc) else acc end)
      end
    end
  end

  -- a window layer at a position: bilinear, as Strata.Atlas.height_at does it
  pfn win_bilinear(wn : Win, arr : NativeF32Arr, xm : Float, zm : Float) : Float do
    match wn do
      Win(i0, j0, side, st, nn, _, _, _, _, _) ->
        let gx = xm /. st +. int_to_float(nn / 2) -. int_to_float(i0)
        let gz = zm /. st +. int_to_float(nn / 2) -. int_to_float(j0)
        let fx = Math.floor(gx)
        let fz = Math.floor(gz)
        let i = float_to_int(fx)
        let j = float_to_int(fz)
        let tx = gx -. fx
        let tz = gz -. fz
        let a0 = NativeArray.get_f32(arr, i + side * j) *. (1.0 -. tx) +. NativeArray.get_f32(arr, i + 1 + side * j) *. tx
        let a1 = NativeArray.get_f32(arr, i + side * (j + 1)) *. (1.0 -. tx) +. NativeArray.get_f32(arr, i + 1 + side * (j + 1)) *. tx
        a0 *. (1.0 -. tz) +. a1 *. tz
    end
  end

  -- the lake level of the sample nearest a position (-1: none), as Strata.Atlas.lake_at
  pfn win_lake(wn : Win, xm : Float, zm : Float) : Float do
    match wn do
      Win(i0, j0, side, st, nn, _, ls, _, _, _) ->
        let i = float_to_int(Math.floor(xm /. st +. int_to_float(nn / 2) +. 0.5)) - i0
        let j = float_to_int(Math.floor(zm /. st +. int_to_float(nn / 2) +. 0.5)) - j0
        NativeArray.get_f32(ls, i + side * j)
    end
  end

  -- the highest lake level among the samples whose water can come within
  -- 4 m of a position: those within 4 m + half a diagonal step of it (a lake
  -- column's nearest sample is at most that far off), in the 6 x 6 samples
  -- around it; -1 if none is lake
  pfn win_rim(wn : Win, xm : Float, zm : Float) : Float do
    match wn do
      Win(i0, j0, side, st, nn, _, ls, _, _, wet) ->
        if !wet do 0.0 -. 1.0
        else rim_go(ls, i0, j0, side, st, nn, float_to_int(Math.floor(xm /. st)) + nn / 2, float_to_int(Math.floor(zm /. st)) + nn / 2, xm, zm, 4.0 +. st *. 0.70711, 0, 0.0 -. 1.0) end
    end
  end
  pfn rim_go(ls : NativeF32Arr, i0 : Int, j0 : Int, side : Int, st : Float, nn : Int, gi : Int, gj : Int, xm : Float, zm : Float, reach : Float, t : Int, best : Float) : Float do
    if t >= 36 do best
    else
      let i = gi + t % 6 - 2
      let j = gj + t / 6 - 2
      let dx = int_to_float(i - nn / 2) *. st -. xm
      let dz = int_to_float(j - nn / 2) *. st -. zm
      let v = if dx *. dx +. dz *. dz > reach *. reach do 0.0 -. 1.0 else NativeArray.get_f32(ls, (i - i0) + side * (j - j0)) end
      rim_go(ls, i0, j0, side, st, nn, gi, gj, xm, zm, reach, t + 1, fmax(v, best))
    end
  end

  -- damp from the rivers in rs: the least of clamp01(bank distance / (2 width))
  pfn river_damp(rs : List((Float, Float, Float, Float)), xm : Float, zm : Float, best : Float) : Float do
    match rs do
      Nil -> best
      Cons((x, z, w, _), rest) ->
        let dx = xm -. x
        let dz = zm -. z
        let v = clamp01((Math.sqrt(dx *. dx +. dz *. dz) -. 0.5 *. w) /. (2.0 *. w))
        river_damp(rest, xm, zm, if v < best do v else best end)
    end
  end

  -- the height of the river sample nearest a position: the river's surface there
  pfn river_surface(rs : List((Float, Float, Float, Float)), xm : Float, zm : Float, bd : Float, bh : Float) : Float do
    match rs do
      Nil -> bh
      Cons((x, z, _, h), rest) ->
        let dd = (xm -. x) *. (xm -. x) +. (zm -. z) *. (zm -. z)
        if dd < bd do river_surface(rest, xm, zm, dd, h) else river_surface(rest, xm, zm, bd, bh) end
    end
  end

  -- detail times damp at a position; 0 over a lake, and never negative beside a river
  pfn damped(g : Gp, wn : Win, xm : Float, zm : Float, seed : Int) : Float do
    if win_lake(wn, xm, zm) >= 0.0 do 0.0
    else
      let dm = match wn do Win(_, _, _, _, _, _, _, _, rs, _) -> river_damp(rs, xm, zm, 1.0) end
      let v = detail_raw(g, xm, zm, seed) *. dm
      if dm < 1.0 && v < 0.0 do 0.0 else v end
    end
  end

  doc "The island's ground height in metres at (xm, zm) before it is cut into voxels: the atlas height plus the damped detail (no channel, rim or lake bed applied)."
  fn island_height_m(a : Strata.Atlas.Atlas, xm : Float, zm : Float, seed : Int) : Float do
    let wn = island_window(a, xm, zm, xm, zm)
    match wn do Win(_, _, _, _, _, hs, _, _, _, _) -> win_bilinear(wn, hs, xm, zm) +. damped(gp_default(), wn, xm, zm, seed) end
  end

  -- A column at (xm, zm) of a world of [scale] metres a voxel: (ground, lake
  -- water line, river water line) in voxels, a line 0 where that water is
  -- not; then the ground in metres before it is cut into voxels, and how
  -- calm the column must stay: 0 on a lake or river column and within the
  -- lake rim's reach, else the river damp (1 far from rivers).
  -- [fine] is level 0's metres a voxel (the same as [scale] at level 0): above level 0 a water line
  -- stands no higher than level 0's (water_line), and a lake keeps a voxel of water over its bed
  pfn island_cell(g : Gp, wn : Win, xm : Float, zm : Float, seed : Int, scale : Float, fine : Float) : (Int, Int, Int, Float, Float) do
    match wn do
      Win(_, _, _, _, _, hs, _, ws, rs, _) ->
        let h = win_bilinear(wn, hs, xm, zm)
        let lake = win_lake(wn, xm, zm)
        let w = win_bilinear(wn, ws, xm, zm)
        if lake >= 0.0 do
          let line = water_line(lake, scale, fine)
          let gr0 = vox(h, scale)
          let gr = if fine < scale do (if gr0 >= line do line - 1 else gr0 end) else gr0 end
          (gr, line, 0, int_to_float(gr) *. scale, 0.0)
        else if w >= 1.0 do
          let top = river_surface(rs, xm, zm, 1000000.0, h)
          let line = water_line(top, scale, fine)
          let bed = vox(top -. fmin(1.5, w /. 6.0), scale)
          let g = if bed < line do bed else line - 1 end
          (g, 0, line, int_to_float(g) *. scale, 0.0)
        else
          let rim = win_rim(wn, xm, zm)
          -- as `damped`, off a lake: detail times the river damp, never negative beside a river
          let dm = river_damp(rs, xm, zm, 1.0)
          let v = detail_raw(g, xm, zm, seed) *. dm
          let hm = h +. (if dm < 1.0 && v < 0.0 do 0.0 else v end)
          let top = if rim >= 0.0 && hm < rim +. 1.0 do rim +. 1.0 else hm end
          (vox(top, scale), 0, 0, top, if rim >= 0.0 do 0.0 else dm end)
        end end
    end
  end

  doc "The highest voxel of [scale] metres that water standing at [m] metres fills, in a world whose level 0 is [fine] metres a voxel: at level 0 the voxel holding m; above it, the last whose top is at or under level 0's water top, so a coarse level's water never stands above a finer level's."
  fn water_line(m : Float, scale : Float, fine : Float) : Int do
    if fine >= scale do vox(m, scale)
    else float_to_int(Math.floor(int_to_float(vox(m, fine) + 1) *. fine /. scale +. 0.000001)) - 1 end
  end

  -- the column's (ground, lake line, river line) in voxels
  pfn island_col(g : Gp, wn : Win, xm : Float, zm : Float, seed : Int, scale : Float) : (Int, Int, Int) do
    match island_cell(g, wn, xm, zm, seed, scale, scale) do (gr, l, r, _, _) -> (gr, l, r) end
  end

  doc "The island column at whole-voxel column (wx, wz) of a world of [scale] metres a voxel, at the default settings: (ground, lake water line, river water line) in voxels, a line 0 where there is no such water."
  fn island_column(a : Strata.Atlas.Atlas, wx : Int, wz : Int, seed : Int, scale : Float) : (Int, Int, Int) do
    let xm = int_to_float(wx) *. scale
    let zm = int_to_float(wz) *. scale
    island_col(gp_default(), island_window(a, xm, zm, xm, zm), xm, zm, seed, scale)
  end

  -- a water column: channel water (sink) over a sandy bed, or full lake water over a sandy bed; stone under [fill] voxels of sand (filler_depth)
  pfn island_block(wy : Int, h : Int, lake : Int, river : Int, sv : Int, fill : Int) : Int do
    if river > 0 do (if wy > h do (if wy <= river || wy <= sv do 5 else 0 end) else if wy >= h - fill do 4 else 1 end end)
    else (if wy > h do (if wy <= lake do lake_base() + 7 else 0 end) else if wy >= h - fill do 4 else 1 end end) end
  end

  -- How many voxels of filler (dirt under grass, sand under water) lie
  -- under a surface voxel: 3 m at level 0, whatever the scale (3 voxels at
  -- 1 m, 6 at 0.5 m). A coarse level keeps 3 of its own voxels, as before:
  -- its filler is a look from afar (its risers take the top texture), and
  -- 3 m of a 4 m voxel would leave none.
  pfn filler_depth(fine : Bool, scale : Float) : Int do if fine do vox(3.0, scale) else 3 end end

  -- ── Under the island: density, caves, cliffs, the surface ───────────────
  -- A land column's 2D height H (the column above, before voxels) is first
  -- relaxed thermally: 4 passes over the chunk and a halo of 8 columns (twice
  -- the passes, so every chunk relaxes a column alike), talus 25 to 55
  -- degrees from a rock-strength noise (Seed.mix(seed, 10), 1/80 cycles per
  -- metre), so the steepest slopes shed scree and strong rock keeps its
  -- cliffs. The density is then
  --
  --   (H - y) * squash + A * calm * n'(x, y, z)      squash 1, A 12 m
  --
  -- n the fBm of Seed.mix(seed, 5) at 1/60 cycles per metre (3 octaves),
  -- stretched 4 times upright, on the Strata.Lattice samples, filled, so the
  -- density only falls going up a column; n' is n shaped (`shaped`): only
  -- raising where calm is under 1 (beside water) or H - A is under the sea,
  -- and a positive n quartered above H. calm is 1 far from water and the
  -- river damp nearer it. Caves carve where min(tunnel, cavern) < 0 per voxel, from
  -- three filled fields: tunnel = max(|a|, |b|) - 0.08 f (a, b the
  -- OpenSimplex2S of Seed.mix(seed, 6) and 7 at 1/25), cavern = (1 - 0.45 f)
  -- - c (c of Seed.mix(seed, 8) at 1/90), f the region's cave factor (0 in
  -- the sea), bilinear per column. Caves stay under a 6 m roof of density
  -- except where the entrance noise (Seed.mix(seed, 9), 1/120, per column)
  -- passes 0.6, where they are cut up through the surface; they keep
  -- above the sea (so it never fills them) and within A + 40 m of H (so the
  -- stone early-out is exact), and are only cut where calm is 1. Lake and
  -- river columns (and land within 4 m of a lake, calm 0) are as before: no
  -- noise, no caves, their fill exactly Task 6's. In a chunk where a cave
  -- was cut, solid not joined through solid to the chunk's faces (slivers
  -- where the cave fields cross) is turned to air (`drop_islands`).
  --
  -- Strata.Surface scans the density: depth 0 is grass (sand under 42 m or
  -- under the sea's line, snow over 95 m), 1 to 3 dirt (sand where the top
  -- would be sand), deeper and ceilings stone; air at or under the sea is
  -- sea water. Tall grass and posts stand on grass inside the chunk, trees
  -- (see Features) on their base column's density surface, found from the same lattice noise.
  -- A chunk wholly above the highest H + A (and the water, and feature_top for
  -- trees and ruins) is air and one wholly below the lowest H - A - 40 m is stone,
  -- decided from the atlas samples alone before any column is made.

  pfn dens_s(g : Gp) : Strata.Noise.Settings do Ns.settings(0, p_dens_oct(g), 2.0, 0.5, 1, 0.0) end
  pfn tunnel_s() : Strata.Noise.Settings do Ns.settings(1, 1, 2.0, 0.5, 0, 0.0) end
  pfn single_s() : Strata.Noise.Settings do Ns.settings(0, 1, 2.0, 0.5, 0, 0.0) end
  pfn rock_s() : Strata.Noise.Settings do Ns.settings(0, 2, 2.0, 0.5, 1, 0.0) end

  -- The settings the per-voxel density reads, as plain floats passed down
  -- the voxel loop (a value read from the heap a voxel cost a chunk two thirds
  -- again: GAPS S15): A, squash, the sea, the tunnel width, the cavern
  -- opening, the cave roof, the cave depth, the entrance threshold.
  type Cv = Cv(Float, Float, Float, Float, Float, Float, Float, Float)
  pfn cave_vals(g : Gp) : Cv do Cv(p_amp(g), p_squash(g), p_sea(g), p_tunnel_w(g), p_cavern_open(g), p_roof(g), p_cave_depth(g), p_entrance(g)) end

  -- region r's cave factor (regionN_caves): it scales the cave thresholds (0 none, 1 the default); 0 in the sea, 1 past region 4
  pfn region_factor(g : Gp, r : Int) : Float do
    if r < 0 do 0.0 else if r > 4 do 1.0 else p_region(g, r, 5) end end
  end

  -- a lattice field: 9 x 5 x 9 samples (4, 8, 4) voxels apart from the chunk's corner
  pfn lattice_field(s : Strata.Noise.Settings, seed : Int, freq : Float, x0m : Float, y0m : Float, z0m : Float, scale : Float) : NativeF32Arr do
    let out = NativeArray.make_f32(405, 0.0)
    if Ns.field3(s, seed, freq, x0m, y0m, z0m, 4.0 *. scale, 8.0 *. scale, 4.0 *. scale, 9, 5, 9, out) == 405 do out else out end
  end

  -- The density noise's lattice samples. Its y is a quarter of the world's
  -- (the noise is stretched 4 times upright): A times its steepest slope up
  -- a column, 12 x 0.25 / 4 = 0.75 a metre, stays under squash, so the
  -- density only falls going up a column and no solid hangs over air from
  -- the noise alone (overhangs come from the caves).
  pfn dens_field(g : Gp, seed : Int, x0m : Float, y0m : Float, z0m : Float, scale : Float) : NativeF32Arr do
    let out = NativeArray.make_f32(405, 0.0)
    let q = p_dens_squeeze(g)
    if Ns.field3(dens_s(g), Strata.Seed.mix(seed, 5), p_dens_freq(g), x0m, q *. y0m, z0m, 4.0 *. scale, 8.0 *. q *. scale, 4.0 *. scale, 9, 5, 9, out) == 405 do out else out end
  end

  -- lattice samples filled to the chunk's 32768 voxels
  pfn lattice_fill(s : NativeF32Arr) : NativeF32Arr do
    let out = NativeArray.make_f32(32768, 0.0)
    if Strata.Lattice.fill(s, out) == 32768 do out else out end
  end

  -- the cave factors of the 9 x 9 sample columns
  pfn factors_go(a : Strata.Atlas.Atlas, g : Gp, x0m : Float, z0m : Float, scale : Float, out : NativeF32Arr, q : Int) : NativeF32Arr do
    if q >= 81 do out
    else factors_go(a, g, x0m, z0m, scale, NativeArray.set_f32(out, q, region_factor(g, Strata.Atlas.region_at(a, x0m +. int_to_float(4 * (q % 9)) *. scale, z0m +. int_to_float(4 * (q / 9)) *. scale))), q + 1) end
  end

  -- a column's cave factor: bilinear between the 9 x 9 sample columns' factors
  pfn factor_at(fac : NativeF32Arr, x : Int, z : Int) : Float do
    let i = x / 4
    let k = z / 4
    let tx = int_to_float(x % 4) *. 0.25
    let tz = int_to_float(z % 4) *. 0.25
    let a0 = NativeArray.get_f32(fac, i + 9 * k) *. (1.0 -. tx) +. NativeArray.get_f32(fac, i + 1 + 9 * k) *. tx
    let a1 = NativeArray.get_f32(fac, i + 9 * (k + 1)) *. (1.0 -. tx) +. NativeArray.get_f32(fac, i + 1 + 9 * (k + 1)) *. tx
    a0 *. (1.0 -. tz) +. a1 *. tz
  end
  pfn factor_cols(fac : NativeF32Arr, out : NativeF32Arr, c : Int) : NativeF32Arr do
    if c >= 1024 do out else factor_cols(fac, NativeArray.set_f32(out, c, factor_at(fac, c % 32, c / 32)), c + 1) end
  end

  -- a lattice field at the row just above the chunk (local y 32, the samples' top layer), bilinear
  pfn top_at(s : NativeF32Arr, x : Int, z : Int) : Float do
    let i = x / 4
    let k = z / 4
    let tx = int_to_float(x % 4) *. 0.25
    let tz = int_to_float(z % 4) *. 0.25
    let a0 = NativeArray.get_f32(s, i + 9 * (4 + 5 * k)) *. (1.0 -. tx) +. NativeArray.get_f32(s, i + 1 + 9 * (4 + 5 * k)) *. tx
    let a1 = NativeArray.get_f32(s, i + 9 * (4 + 5 * (k + 1))) *. (1.0 -. tx) +. NativeArray.get_f32(s, i + 1 + 9 * (4 + 5 * (k + 1))) *. tx
    a0 *. (1.0 -. tz) +. a1 *. tz
  end

  -- The density noise as it applies at height ym over a column (H, calm):
  -- only raising where calm is under 1 or where H - A is under the sea (so
  -- no pit fills with sea inland), and above H a positive value quartered,
  -- so A / 4 times its steepest slope (0.25 a metre on the lattice) stays
  -- under squash and the density never grows going up above H: no solid
  -- floats over the hill.
  pfn shaped(a : Float, sea : Float, n : Float, h : Float, cm : Float, ym : Float) : Float do
    let low = h -. a < sea
    let n1 = if n >= 0.0 do n else if cm < 1.0 do 0.0 else if low do 0.0 else n end end end
    if ym > h && n1 > 0.0 do 0.25 *. n1 else n1 end
  end

  -- the density of one voxel at height ym from its column (H, calm, entrance,
  -- cave factor f) and its filled noise n and cave fields a, b, c; -1 where a cave is cut
  pfn voxel_density(a : Float, sq : Float, sea : Float, tw : Float, co : Float, roof : Float, depth : Float, ent : Float, h : Float, cm : Float, en : Float, f : Float, n : Float, ta : Float, tb : Float, cav : Float, ym : Float, seam : Float) : Float do
    let d = (h -. ym) *. sq +. a *. cm *. shaped(a, sea, n, h, cm, ym)
    let carve = fmin(fmax(Math.abs(ta), Math.abs(tb)) -. tw *. f, (1.0 -. co *. f) -. cav)
    if carve >= 0.0 do d
    else if cm < 1.0 do d
    else if ym <= seam do d
    else if ym < h -. a -. depth do d
    else if d > roof do 0.0 -. 1.0
    -- where the entrance noise passes 0.6 the whole cave volume is cut, up
    -- through the surface: a cut stopped 2 m under H leaves roofs a voxel
    -- thick that break into free pieces (17 voxels round the cave scene, 4
    -- still after drop_islands, where they touch a chunk's face)
    else if en > ent do 0.0 -. 1.0
    else d end end end end end end
  end

  -- the chunk's per-column values (H, calm, entrance, cave factor) and its filled fields
  type Fields = Fields(NativeF32Arr, NativeF32Arr, NativeF32Arr, NativeF32Arr, NativeF32Arr, NativeF32Arr, NativeF32Arr, NativeF32Arr)

  pfn dens_go(cv : Cv, fl : Fields, out : NativeF32Arr, y0m : Float, scale : Float, seam : Float) : NativeF32Arr do
    match (cv, fl) do
      (Cv(a, sq, sea, tw, co, roof, depth, ent), Fields(hs, cms, ens, fs, dn, da, db, dc)) -> dens_loop(a, sq, sea, tw, co, roof, depth, ent, hs, cms, ens, fs, dn, da, db, dc, out, y0m, scale, seam, 0)
    end
  end
  pfn dens_loop(a : Float, sq : Float, sea : Float, tw : Float, co : Float, roof : Float, depth : Float, ent : Float, hs : NativeF32Arr, cms : NativeF32Arr, ens : NativeF32Arr, fs : NativeF32Arr, dn : NativeF32Arr, da : NativeF32Arr, db : NativeF32Arr, dc : NativeF32Arr, out : NativeF32Arr, y0m : Float, scale : Float, seam : Float, i : Int) : NativeF32Arr do
    if i >= 32768 do out
    else
      let c = i % 1024
      let d = voxel_density(a, sq, sea, tw, co, roof, depth, ent, NativeArray.get_f32(hs, c), NativeArray.get_f32(cms, c), NativeArray.get_f32(ens, c), NativeArray.get_f32(fs, c), NativeArray.get_f32(dn, i), NativeArray.get_f32(da, i), NativeArray.get_f32(db, i), NativeArray.get_f32(dc, i), y0m +. int_to_float(i / 1024) *. scale, seam)
      dens_loop(a, sq, sea, tw, co, roof, depth, ent, hs, cms, ens, fs, dn, da, db, dc, NativeArray.set_f32(out, i, d), y0m, scale, seam, i + 1)
    end
  end

  -- the density of the row just above the chunk, from the samples' top layer
  pfn above_go(cv : Cv, hs : NativeF32Arr, cms : NativeF32Arr, ens : NativeF32Arr, fs : NativeF32Arr, ns : NativeF32Arr, ta : NativeF32Arr, tb : NativeF32Arr, cav : NativeF32Arr, out : NativeF32Arr, ym : Float, seam : Float, c : Int) : NativeF32Arr do
    if c >= 1024 do out
    else
      let x = c % 32
      let z = c / 32
      let d = match cv do Cv(a, sq, sea, tw, co, roof, depth, ent) -> voxel_density(a, sq, sea, tw, co, roof, depth, ent, NativeArray.get_f32(hs, c), NativeArray.get_f32(cms, c), NativeArray.get_f32(ens, c), NativeArray.get_f32(fs, c), top_at(ns, x, z), top_at(ta, x, z), top_at(tb, x, z), top_at(cav, x, z), ym, seam) end
      above_go(cv, hs, cms, ens, fs, ns, ta, tb, cav, NativeArray.set_f32(out, c, d), ym, seam, c + 1)
    end
  end

  -- Cave islands: where the cave fields cross, the solid they leave can be a
  -- voxel or two held by nothing but an edge. A flood from every solid voxel
  -- on the chunk's faces (what lies beyond is unknown, so a face counts as
  -- held) through 6-connected solid; what it does not reach is turned to
  -- air. Only run on a chunk where a cave was cut. The flood is one
  -- self-recursive loop: neighbour d (0..5) of voxel i a call, the next
  -- voxel popped at d = 6.
  pfn isle_seed(d : NativeF32Arr, seen : NativeIntArr, st : NativeIntArr, sp : Int, i : Int) : (NativeIntArr, NativeIntArr, Int) do
    if i >= 32768 do (seen, st, sp)
    else
      let x = i % 32
      let z = (i / 32) % 32
      let y = i / 1024
      let face = x == 0 || x == 31 || z == 0 || z == 31 || y == 0 || y == 31
      let take = if !face do false else NativeArray.get_f32(d, i) >= 0.0 end
      if take do isle_seed(d, NativeArray.set_int(seen, i, 1), NativeArray.set_int(st, sp, i), sp + 1, i + 1)
      else isle_seed(d, seen, st, sp, i + 1) end
    end
  end
  pfn isle_flood(d : NativeF32Arr, seen : NativeIntArr, st : NativeIntArr, sp : Int, i : Int, k : Int) : NativeIntArr do
    if k >= 6 do
      if sp <= 0 do seen else isle_flood(d, seen, st, sp - 1, NativeArray.get_int(st, sp - 1), 0) end
    else
      let x = i % 32
      let z = (i / 32) % 32
      let y = i / 1024
      let ok = if k == 0 do x > 0 else if k == 1 do x < 31 else if k == 2 do z > 0 else if k == 3 do z < 31 else if k == 4 do y > 0 else y < 31 end end end end end
      let q = if k == 0 do i - 1 else if k == 1 do i + 1 else if k == 2 do i - 32 else if k == 3 do i + 32 else if k == 4 do i - 1024 else i + 1024 end end end end end
      let take = if !ok do false else if NativeArray.get_f32(d, q) < 0.0 do false else NativeArray.get_int(seen, q) == 0 end end
      if take do isle_flood(d, NativeArray.set_int(seen, q, 1), NativeArray.set_int(st, sp, q), sp + 1, i, k + 1)
      else isle_flood(d, seen, st, sp, i, k + 1) end
    end
  end
  pfn isle_drop(d : NativeF32Arr, seen : NativeIntArr, i : Int) : NativeF32Arr do
    if i >= 32768 do d
    else
      let drop = if NativeArray.get_f32(d, i) < 0.0 do false else NativeArray.get_int(seen, i) == 0 end
      isle_drop(if drop do NativeArray.set_f32(d, i, 0.0 -. 1.0) else d end, seen, i + 1)
    end
  end
  pfn drop_islands(d : NativeF32Arr) : NativeF32Arr do
    match isle_seed(d, NativeArray.make_int(32768, 0), NativeArray.make_int(32768, 0), 0, 0) do
      (seen, st, sp) -> isle_drop(d, isle_flood(d, seen, st, sp, 0, 6), 0)
    end
  end
  -- whether any voxel of the chunk was cut by a cave (voxel_density gives exactly -1 there)
  pfn any_cut(d : NativeF32Arr, i : Int) : Bool do
    if i >= 32768 do false else if NativeArray.get_f32(d, i) == 0.0 -. 1.0 do true else any_cut(d, i + 1) end end
  end

  -- a voxel's block from its depth under the surface (Strata.Surface), its world y and the sea; [fill] voxels of dirt or sand under the top (filler_depth)
  pfn material(sand : Float, snow : Float, depth : Int, wy : Int, sv : Int, scale : Float, wet : Bool, fill : Int) : Int do
    if depth < 0 do (if wy <= sv do 5 else 0 end)
    else
      let ym = int_to_float(wy) *. scale
      let sandy = if wet do true else ym < sand end
      if depth == 0 do (if sandy do 4 else if ym > snow do 6 else 3 end end)
      else if depth <= fill do (if sandy do 4 else 2 end)
      else 1 end end
    end
  end

  -- The thermal patch reaches past the chunk by twice the pass count: a
  -- pass moves material between neighbours, so what a column holds after it
  -- depends on columns two away, and after 4 passes on columns 8 away. With
  -- that halo a column's relaxed height is the same whichever patch it is
  -- relaxed in, so chunks agree along their seams.
  pfn halo(g : Gp) : Int do 2 * p_passes(g) end

  -- The columns of an area n x n from (x0, z0) and its halo, side = n + 2 halo:
  -- H in metres and calm; and for the area's own n x n, ground, lake and river lines.
  type Cols3 = Cols3(NativeF32Arr, NativeF32Arr, NativeIntArr, NativeIntArr, NativeIntArr)
  pfn cols3_go(g : Gp, hl : Int, wn : Win, x0 : Int, z0 : Int, n : Int, seed : Int, scale : Float, fine : Float, t : Int, hm : NativeF32Arr, cm : NativeF32Arr, gs : NativeIntArr, ls : NativeIntArr, rs : NativeIntArr) : Cols3 do
    let side = n + 2 * hl
    if t >= side * side do Cols3(hm, cm, gs, ls, rs)
    else
      let x = t % side - hl
      let z = t / side - hl
      match island_cell(g, wn, int_to_float(x0 + x) *. scale, int_to_float(z0 + z) *. scale, seed, scale, fine) do
        (gr, l, r, h, c) ->
          let hm2 = NativeArray.set_f32(hm, t, h)
          let cm2 = NativeArray.set_f32(cm, t, c)
          if x >= 0 && x < n && z >= 0 && z < n do
            let k = x + n * z
            cols3_go(g, hl, wn, x0, z0, n, seed, scale, fine, t + 1, hm2, cm2, NativeArray.set_int(gs, k, gr), NativeArray.set_int(ls, k, l), NativeArray.set_int(rs, k, r))
          else cols3_go(g, hl, wn, x0, z0, n, seed, scale, fine, t + 1, hm2, cm2, gs, ls, rs) end
      end
    end
  end

  -- talus angles in degrees, 25 to 55, from the rock-strength noise in [-1, 1]
  pfn talus_go(a : NativeF32Arr, mid : Float, spread : Float, k : Int, cnt : Int) : NativeF32Arr do
    if k >= cnt do a else talus_go(NativeArray.set_f32(a, k, mid +. spread *. NativeArray.get_f32(a, k)), mid, spread, k + 1, cnt) end
  end

  pfn span_go(a : NativeF32Arr, k : Int, cnt : Int, lo : Float, hi : Float) : (Float, Float) do
    if k >= cnt do (lo, hi)
    else
      let v = NativeArray.get_f32(a, k)
      span_go(a, k + 1, cnt, fmin(v, lo), fmax(v, hi))
    end
  end

  -- the area's own H and calm (n x n): the relaxed heights, then kept within
  -- the halo patch's range (a pass can overshoot into a one-column pit); calm-0 columns as they were
  pfn inner_go(hl : Int, hm : NativeF32Arr, hr : NativeF32Arr, cm : NativeF32Arr, lo : Float, hi : Float, hs : NativeF32Arr, cs : NativeF32Arr, n : Int, c : Int) : (NativeF32Arr, NativeF32Arr) do
    if c >= n * n do (hs, cs)
    else
      let t = (c % n + hl) + (n + 2 * hl) * (c / n + hl)
      let calm = NativeArray.get_f32(cm, t)
      let h = if calm <= 0.0 do NativeArray.get_f32(hm, t) else fmin(hi, fmax(lo, NativeArray.get_f32(hr, t))) end
      inner_go(hl, hm, hr, cm, lo, hi, NativeArray.set_f32(hs, c, h), NativeArray.set_f32(cs, c, calm), n, c + 1)
    end
  end

  -- ── Sites: the ground pulled to a ruin's floor ───────────────────────────
  -- Within a site's radius + 3 m a land column's H moves toward the site
  -- floor, all the way within the radius and linearly to not at all over
  -- the 3 m margin, and its calm toward 0 (no density noise, no caves where
  -- the ruin stands); lake and river columns are left as they were. It is
  -- done after the thermal relax and before the density, and is a function
  -- of the column alone, so chunks agree along their seams. Sites are 150 m
  -- apart, so an area under 150 m across meets at most the beard of the site
  -- nearest its centre.
  -- how far a column at (xm, zm) is pulled to site s: 1 within its radius, 0 past radius + bm (beard_margin, 3 m)
  pfn beard_w(bm : Float, s : Strata.Atlas.Site, xm : Float, zm : Float) : Float do
    let dx = xm -. Strata.Atlas.s_x(s)
    let dz = zm -. Strata.Atlas.s_z(s)
    clamp01((Strata.Atlas.s_radius(s) +. bm -. Math.sqrt(dx *. dx +. dz *. dz)) /. bm)
  end

  -- the site whose beard can reach an area n x n columns from (x0m, z0m) metres
  pfn site_for(a : Strata.Atlas.Atlas, x0m : Float, z0m : Float, n : Int, scale : Float) : Option(Strata.Atlas.Site) do
    let half = int_to_float(n) *. scale *. 0.5
    Strata.Atlas.site_near(a, x0m +. half, z0m +. half, half *. 1.4143 +. 40.0)
  end

  pfn beard_go(bm : Float, s : Strata.Atlas.Site, hs : NativeF32Arr, cs : NativeF32Arr, ls : NativeIntArr, rs : NativeIntArr, x0 : Int, z0 : Int, n : Int, scale : Float, c : Int) : (NativeF32Arr, NativeF32Arr) do
    if c >= n * n do (hs, cs)
    else
      let w = beard_w(bm, s, int_to_float(x0 + c % n) *. scale, int_to_float(z0 + c / n) *. scale)
      if w <= 0.0 do beard_go(bm, s, hs, cs, ls, rs, x0, z0, n, scale, c + 1)
      else if NativeArray.get_int(ls, c) > 0 do beard_go(bm, s, hs, cs, ls, rs, x0, z0, n, scale, c + 1)
      else if NativeArray.get_int(rs, c) > 0 do beard_go(bm, s, hs, cs, ls, rs, x0, z0, n, scale, c + 1)
      else
        let h = NativeArray.get_f32(hs, c)
        let h2 = h +. (Strata.Atlas.s_floor(s) -. h) *. w
        beard_go(bm, s, NativeArray.set_f32(hs, c, h2), NativeArray.set_f32(cs, c, NativeArray.get_f32(cs, c) *. (1.0 -. w)), ls, rs, x0, z0, n, scale, c + 1)
      end end end
    end
  end

  doc "Whether a place (xm, zm) is within a site's beard (its radius + beard_margin, 3 m, in settings g): no tree stands there."
  fn in_site(g : Gp, a : Strata.Atlas.Atlas, xm : Float, zm : Float) : Bool do
    match Strata.Atlas.site_near(a, xm, zm, 40.0) do
      Some(s) -> beard_w(p_beard(g), s, xm, zm) > 0.0
      None -> false
    end
  end

  -- The area n x n from whole-voxel column (x0, z0): its relaxed H (pulled
  -- to a site's floor in its beard) and calm, and its ground, lake and river lines (voxels).
  type Area = Area(NativeF32Arr, NativeF32Arr, NativeIntArr, NativeIntArr, NativeIntArr)
  pfn area_n(g : Gp, a : Strata.Atlas.Atlas, scale : Float, x0 : Int, z0 : Int, n : Int, seed : Int) : Area do area_lv(g, a, scale, scale, x0, z0, n, seed) end
  -- as area_n, in a world whose level 0 is [fine] metres a voxel (its water lines: water_line)
  pfn area_lv(g : Gp, a : Strata.Atlas.Atlas, scale : Float, fine : Float, x0 : Int, z0 : Int, n : Int, seed : Int) : Area do
    let hl = halo(g)
    let side = n + 2 * hl
    let cnt = side * side
    let x0m = int_to_float(x0) *. scale
    let z0m = int_to_float(z0) *. scale
    let hw = int_to_float(hl) *. scale
    let far = int_to_float(n - 1) *. scale
    let wn = island_window(a, x0m -. hw, z0m -. hw, x0m +. far +. hw, z0m +. far +. hw)
    match cols3_go(g, hl, wn, x0, z0, n, seed, scale, fine, 0, NativeArray.make_f32(cnt, 0.0), NativeArray.make_f32(cnt, 0.0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0)) do
      Cols3(hm, cm, gs, ls, rs) ->
        let tal = NativeArray.make_f32(cnt, 0.0)
        let tal2 = if Ns.field2(rock_s(), Strata.Seed.mix(seed, 10), p_rock_freq(g), x0m -. hw, z0m -. hw, scale, side, side, tal) == cnt do talus_go(tal, p_talus_mid(g), p_talus_spread(g), 0, cnt) else tal end
        let hr = Strata.Thermal.relax(hm, side, scale, tal2, p_passes(g))
        match span_go(hm, 0, cnt, 1000000.0, 0.0 -. 1000000.0) do
          (lo, hi) ->
            match inner_go(hl, hm, hr, cm, lo, hi, NativeArray.make_f32(n * n, 0.0), NativeArray.make_f32(n * n, 0.0), n, 0) do
              (hs, cms) ->
                match site_for(a, x0m, z0m, n, scale) do
                  Some(st) -> match beard_go(p_beard(g), st, hs, cms, ls, rs, x0, z0, n, scale, 0) do (hs2, cms2) -> Area(hs2, cms2, gs, ls, rs) end
                  None -> Area(hs, cms, gs, ls, rs)
                end
            end
        end
    end
  end

  doc "The island's thermally relaxed 2D heights H (metres) of the 32 x 32 columns from whole-voxel column (x0, z0), index x + 32 * z, pulled to a site's floor in its beard: what the density is built on. Any (x0, z0), not only a chunk's corner."
  fn relaxed_heights(a : Strata.Atlas.Atlas, scale : Float, x0 : Int, z0 : Int, seed : Int) : NativeF32Arr do
    match area_n(gp_default(), a, scale, x0, z0, 32, seed) do Area(hs, _, _, _, _) -> hs end
  end

  -- the lattice noise on the rows of one column, rows r0..r0 + cnt - 1 (8 voxels apart), bilinear between its four sample columns
  pfn rows_go(g : Gp, seed : Int, gx : Int, gz : Int, tx : Float, tz : Float, r0 : Int, scale : Float, out : NativeF32Arr, k : Int, cnt : Int) : NativeF32Arr do
    if k >= cnt do out
    else
      -- the density noise is stretched density_stretch (4) times upright (dens_field)
      let ym = p_dens_squeeze(g) *. int_to_float(8 * (r0 + k)) *. scale
      let s = Strata.Seed.mix(seed, 5)
      let ds = dens_s(g)
      let fq = p_dens_freq(g)
      let x0 = int_to_float(gx) *. scale
      let x1 = int_to_float(gx + 4) *. scale
      let z0 = int_to_float(gz) *. scale
      let z1 = int_to_float(gz + 4) *. scale
      let a0 = Ns.sample3(ds, s, fq, x0, ym, z0) *. (1.0 -. tx) +. Ns.sample3(ds, s, fq, x1, ym, z0) *. tx
      let a1 = Ns.sample3(ds, s, fq, x0, ym, z1) *. (1.0 -. tx) +. Ns.sample3(ds, s, fq, x1, ym, z1) *. tx
      rows_go(g, seed, gx, gz, tx, tz, r0, scale, NativeArray.set_f32(out, k, a0 *. (1.0 -. tz) +. a1 *. tz), k + 1, cnt)
    end
  end
  pfn top_go(cv : Cv, rows : NativeF32Arr, r0 : Int, h : Float, cm : Float, scale : Float, y : Int, low : Int) : Int do
    if y < low do low
    else
      let r = fdiv(y, 8)
      let t = int_to_float(y - 8 * r) *. 0.125
      let n0 = NativeArray.get_f32(rows, r - r0)
      let n = n0 +. (NativeArray.get_f32(rows, r - r0 + 1) -. n0) *. t
      let ym = int_to_float(y) *. scale
      let d = match cv do Cv(a, sq, sea, _, _, _, _, _) -> (h -. ym) *. sq +. a *. cm *. shaped(a, sea, n, h, cm, ym) end
      if d >= 0.0 do y else top_go(cv, rows, r0, h, cm, scale, y - 1, low) end
    end
  end

  doc "The highest solid voxel of an island column's density (caves aside), at whole-voxel column (wx, wz) with 2D height h metres and calm cm: where a tree stands."
  fn density_top(g : Gp, seed : Int, wx : Int, wz : Int, h : Float, cm : Float, scale : Float) : Int do
    let gx = fdiv(wx, 4) * 4
    let gz = fdiv(wz, 4) * 4
    let hi = vox(h +. p_amp(g), scale) + 1
    let low = vox(h -. p_amp(g), scale) - 1
    let r0 = fdiv(low, 8)
    let cnt = fdiv(hi, 8) - r0 + 2
    let rows = rows_go(g, seed, gx, gz, int_to_float(wx - gx) *. 0.25, int_to_float(wz - gz) *. 0.25, r0, scale, NativeArray.make_f32(cnt, 0.0), 0, cnt)
    top_go(cave_vals(g), rows, r0, h, cm, scale, hi, low)
  end

  -- how many columns apart a tree's slope is sampled, each side of its base: a metre's worth (one at 1 m, two at
  -- 0.5 m), so the slope a tree stands on is measured over the same 2 m at every scale
  pfn slope_step(scale : Float) : Int do
    let k = vox(1.0, scale)
    if k < 1 do 1 else k end
  end

  -- The island's trees on an area's columns: hs, cms, ls, rs are n x n from
  -- whole-voxel column (ax0, az0). A tree stands on the density top of its
  -- base column (so on an overhang's top too) when the column is neither
  -- lake nor river nor in a site's beard, its slope (central differences a metre each side, of
  -- H) is tree_max_slope (35 degrees) or less, its entrance noise
  -- entrance_threshold (0.6) or less (where caves cut up through the ground)
  -- and its top tree_min_height (41.5 m) or more.
  pfn island_tree(a : Strata.Atlas.Atlas, d : Decor, p : Strata.Feature.Placed, hs : NativeF32Arr, cms : NativeF32Arr, ls : NativeIntArr, rs : NativeIntArr, ax0 : Int, az0 : Int, n : Int, seed : Int, scale : Float, acc : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int))) : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int)) do
    let xm = Strata.Feature.p_xm(p)
    let zm = Strata.Feature.p_zm(p)
    let wx = float_to_int(Math.floor(xm /. scale))
    let wz = float_to_int(Math.floor(zm /. scale))
    let px = wx - ax0
    let pz = wz - az0
    let g = decor_gp(d)
    let k = slope_step(scale)
    if px < k || px > n - 1 - k || pz < k || pz > n - 1 - k do acc
    else
      let c = px + n * pz
      if NativeArray.get_int(ls, c) > 0 do acc
      else if NativeArray.get_int(rs, c) > 0 do acc
      else if in_site(g, a, xm, zm) do acc
      else
        let gx = (NativeArray.get_f32(hs, c + k) -. NativeArray.get_f32(hs, c - k)) /. (2.0 *. int_to_float(k) *. scale)
        let gz = (NativeArray.get_f32(hs, c + k * n) -. NativeArray.get_f32(hs, c - k * n)) /. (2.0 *. int_to_float(k) *. scale)
        if steep(p_tree_slope(g), gx, gz) do acc
        else if Ns.sample2(single_s(), Strata.Seed.mix(seed, 9), p_entrance_freq(g), int_to_float(wx) *. scale, int_to_float(wz) *. scale) > p_entrance(g) do acc
        else
          let top = density_top(g, seed, wx, wz, NativeArray.get_f32(hs, c), NativeArray.get_f32(cms, c), scale)
          if int_to_float(top) *. scale < p_tree_min(g) do acc
          else
            match pick_tree(d, Strata.Atlas.region_at(a, xm, zm), Strata.Feature.p_index(p)) do
              Some(t) -> Cons((t, p, wx, top, wz), acc)
              None -> acc
            end
          end
        end end
      end end end
    end
  end

  doc "The island's trees that can reach the chunk at (cx, cz), from its area padded by pad columns each side (n = 32 + 2 pad, from column (32 cx - pad, 32 cz - pad)): (template, placement, base column x, ground top y, base column z)."
  fn island_trees(a : Strata.Atlas.Atlas, d : Decor, hs : NativeF32Arr, cms : NativeF32Arr, ls : NativeIntArr, rs : NativeIntArr, cx : Int, cz : Int, pad : Int, seed : Int, scale : Float) : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int)) do
    if List.length(decor_trees(d)) < 12 do Nil
    else
      let k = tree_kind(d)
      let x0 = int_to_float(cx * 32) *. scale
      let z0 = int_to_float(cz * 32) *. scale
      let x1 = int_to_float(cx * 32 + 32) *. scale
      let z1 = int_to_float(cz * 32 + 32) *. scale
      let g = decor_gp(d)
      let ps = Strata.Feature.candidates(k, seed, x0, z0, x1, z1, fn (x, z) -> region_density(g, Strata.Atlas.region_at(a, x, z)))
      let n = 32 + 2 * pad
      List.reverse(List.fold_left(ps, Nil, fn (acc, p) -> if reaches(p, x0, z0, x1, z1, Strata.Feature.k_radius(k)) do island_tree(a, d, p, hs, cms, ls, rs, cx * 32 - pad, cz * 32 - pad, n, seed, scale, acc) else acc end))
    end
  end

  doc "The trees that reach the island chunk column (cx, cz) for [seed], as island_full finds them: (template, placement, base column x, ground top y, base column z)."
  fn island_chunk_trees(a : Strata.Atlas.Atlas, d : Decor, scale : Float, cx : Int, cz : Int, seed : Int) : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int)) do
    let pad = tree_pad(d, scale)
    match area_n(decor_gp(d), a, scale, cx * 32 - pad, cz * 32 - pad, 32 + 2 * pad, seed) do
      Area(hp, cp, _, lp, rp) -> island_trees(a, d, hp, cp, lp, rp, cx, cz, pad, seed, scale)
    end
  end

  doc "The ruin standing on site s, and where: (template, x, y, z, rot) for Strata.Template.blit, centred on the site, its bottom row on the ground at the site floor (whole voxel vox(floor) + 1), turned by the site's hash."
  fn site_ruin(d : Decor, s : Strata.Atlas.Site, scale : Float, seed : Int) : Option((Strata.Template.Template, Int, Int, Int, Int)) do
    match List.nth_opt(decor_ruins(d), Strata.Atlas.s_index(s) % 3) do
      None -> None
      Some(t) ->
        let rot = int_and(int_shr(Strata.Seed.cell(seed, 28, Strata.Atlas.s_index(s), 0, 0), 20), 3)
        match Strata.Template.bounds(t, 0, 0, 0, rot) do
          (_, _, _, w1, _, d1) ->
            let cx = float_to_int(Math.floor(Strata.Atlas.s_x(s) /. scale))
            let cz = float_to_int(Math.floor(Strata.Atlas.s_z(s) /. scale))
            Some((t, cx - (w1 + 1) / 2, vox(Strata.Atlas.s_floor(s), scale) + 1, cz - (d1 + 1) / 2, rot))
        end
    end
  end

  -- how far the ground around a site falls or rises from its floor: the most over 16 directions 25 m out
  pfn site_drop(a : Strata.Atlas.Atlas, s : Strata.Atlas.Site, i : Int, best : Float) : Float do
    if i >= 16 do best
    else
      let h = Strata.Atlas.height_at(a, Strata.Atlas.s_x(s) +. 25.0 *. dir_x(i), Strata.Atlas.s_z(s) +. 25.0 *. dir_z(i))
      site_drop(a, s, i + 1, fmax(best, Math.abs(h -. Strata.Atlas.s_floor(s))))
    end
  end
  pfn slope_go(a : Strata.Atlas.Atlas, ss : List(Strata.Atlas.Site), best : Option(Strata.Atlas.Site), bd : Float) : Option(Strata.Atlas.Site) do
    match ss do
      Nil -> best
      Cons(s, rest) ->
        let dd = site_drop(a, s, 0, 0.0)
        if dd > bd do slope_go(a, rest, Some(s), dd) else slope_go(a, rest, best, bd) end
    end
  end
  doc "The site on the steepest ground: the one whose atlas ground 25 m out departs most from its floor (scene 129, and the viewer test)."
  fn slope_site(a : Strata.Atlas.Atlas) : Option(Strata.Atlas.Site) do slope_go(a, Strata.Atlas.sites(a), None, 0.0 -. 1.0) end

  -- the direction 0..15 (see dir_x) in which the ground 25 m out from a site is lowest
  pfn low_dir(a : Strata.Atlas.Atlas, s : Strata.Atlas.Site, i : Int, best : Int, bh : Float) : Int do
    if i >= 16 do best
    else
      let h = Strata.Atlas.height_at(a, Strata.Atlas.s_x(s) +. 25.0 *. dir_x(i), Strata.Atlas.s_z(s) +. 25.0 *. dir_z(i))
      if h < bh do low_dir(a, s, i + 1, i, h) else low_dir(a, s, i + 1, best, bh) end
    end
  end

  -- the ruin of the site near chunk (cx, cy, cz), if any, blitted into c
  pfn ruins_into(a : Strata.Atlas.Atlas, d : Decor, c : Strata.Chunk.Chunk, cx : Int, cy : Int, cz : Int, scale : Float, seed : Int) : Strata.Chunk.Chunk do
    let half = 16.0 *. scale
    match Strata.Atlas.site_near(a, int_to_float(cx * 32) *. scale +. half, int_to_float(cz * 32) *. scale +. half, half *. 1.4143 +. 40.0) do
      None -> c
      Some(s) ->
        match site_ruin(d, s, scale, seed) do
          Some((t, ox, oy, oz, rot)) -> Strata.Template.blit(c, Strata.Coord.key(cx, cy, cz), t, ox, oy, oz, rot, Strata.Seed.cell(seed, 29, Strata.Atlas.s_index(s), 0, 0))
          None -> c
        end
    end
  end

  -- the inner 32 x 32 of an n x n array padded by pad
  pfn inner_f32(src : NativeF32Arr, n : Int, pad : Int, out : NativeF32Arr, c : Int) : NativeF32Arr do
    if c >= 1024 do out else inner_f32(src, n, pad, NativeArray.set_f32(out, c, NativeArray.get_f32(src, (c % 32 + pad) + n * (c / 32 + pad))), c + 1) end
  end
  pfn inner_int(src : NativeIntArr, n : Int, pad : Int, out : NativeIntArr, c : Int) : NativeIntArr do
    if c >= 1024 do out else inner_int(src, n, pad, NativeArray.set_int(out, c, NativeArray.get_int(src, (c % 32 + pad) + n * (c / 32 + pad))), c + 1) end
  end

  -- lake and river columns get Task 6's fill; tall grass and posts on grass where deco
  pfn finish_go(g : Gp, deco0 : Bool, m : NativeI32Arr, gs : NativeIntArr, ls : NativeIntArr, rs : NativeIntArr, x0 : Int, y0 : Int, z0 : Int, sv : Int, scale : Float, seed : Int, i : Int) : NativeI32Arr do
    if i >= 32768 do m
    else
      let c = i % 1024
      let wx = x0 + c % 32
      let wz = z0 + c / 32
      let wy = y0 + i / 1024
      let l = NativeArray.get_int(ls, c)
      let r = NativeArray.get_int(rs, c)
      if l > 0 || r > 0 do
        finish_go(g, deco0, NativeArray.set_i32(m, i, island_block(wy, NativeArray.get_int(gs, c), l, r, sv, filler_depth(deco0, scale))), gs, ls, rs, x0, y0, z0, sv, scale, seed, i + 1)
      else if !deco0 do finish_go(g, deco0, m, gs, ls, rs, x0, y0, z0, sv, scale, seed, i + 1)
      else if i < 1024 do finish_go(g, deco0, m, gs, ls, rs, x0, y0, z0, sv, scale, seed, i + 1)
      else if NativeArray.get_i32(m, i) != 0 do finish_go(g, deco0, m, gs, ls, rs, x0, y0, z0, sv, scale, seed, i + 1)
      else if NativeArray.get_i32(m, i - 1024) != 3 do finish_go(g, deco0, m, gs, ls, rs, x0, y0, z0, sv, scale, seed, i + 1)
      else
        let hm = int_to_float(wy - 1) *. scale
        let deco = if has_post(g, wx, wz, hm, seed, scale) do 12 else if grassy(g, hm) && roll(wx, wz, seed, 26) > 1.0 -. p_tall_grass(g) do 11 else 0 end end
        finish_go(g, deco0, if deco > 0 do NativeArray.set_i32(m, i, deco) else m end, gs, ls, rs, x0, y0, z0, sv, scale, seed, i + 1)
      end end end end end
    end
  end

  -- the early-out bounds from the atlas samples over a chunk's footprint, its
  -- thermal halo and one sample beyond: (lowest H, highest H, highest water),
  -- metres. Every column of the thermal patch lies within detail_amplitude
  -- (6 m) of detail (and 2 m more of channel) of these samples and the rim clamp within a metre of
  -- the highest lake level; relaxed heights are clamped to the patch's range.
  pfn quick_bounds(g : Gp, a : Strata.Atlas.Atlas, x0m : Float, z0m : Float, scale : Float) : (Float, Float, Float) do
    let st = Strata.Atlas.step(a)
    let nn = Strata.Atlas.n(a)
    -- the thermal halo's columns and the trees' reach, and one sample beyond them
    let m = float_to_int(Math.ceil((int_to_float(halo(g)) *. scale +. max_reach()) /. st)) + 1
    let i0 = float_to_int(Math.floor(x0m /. st)) + nn / 2 - m
    let j0 = float_to_int(Math.floor(z0m /. st)) + nn / 2 - m
    let side = float_to_int(Math.ceil(32.0 *. scale /. st)) + 1 + 2 * m
    -- a site's beard pulls the ground to its floor
    let half = 16.0 *. scale
    let (flo, fhi) = match Strata.Atlas.site_near(a, x0m +. half, z0m +. half, half *. 1.4143 +. int_to_float(m) *. st +. 40.0) do
        Some(s) -> (Strata.Atlas.s_floor(s), Strata.Atlas.s_floor(s))
        None -> (1000000.0, 0.0 -. 1000000.0)
      end
    match span_go(Strata.Atlas.window(a, 0, i0, j0, side), 0, side * side, flo, fhi) do
      (lo, hi) ->
        match span_go(Strata.Atlas.window(a, 2, i0, j0, side), 0, side * side, 1000000.0, 0.0 -. 1000000.0) do
          (_, lake) -> (lo -. p_detail_amp(g) -. 2.0, fmax(hi +. p_detail_amp(g), lake +. 1.0), fmax(lake, p_sea(g)))
        end
    end
  end

  -- how many columns an island chunk's area reaches past it each side: the trees' reach and one more for their slope
  pfn tree_pad(d : Decor, scale : Float) : Int do
    if List.length(decor_trees(d)) < 12 do 0 else float_to_int(Math.ceil(decor_reach(d) /. scale)) + 1 end
  end

  -- the island chunk (cx, cy, cz) of level lvl, whose voxels are [scale] metres
  pfn island_full(a : Strata.Atlas.Atlas, d : Decor, scale : Float, lvl : Int, cx : Int, cy : Int, cz : Int, seed : Int) : Strata.Chunk.Chunk do
    let g = decor_gp(d)
    let fine = lvl == 0
    let x0 = cx * 32
    let y0 = cy * 32
    let z0 = cz * 32
    -- level 0's metres a voxel; above level 0 the water stands no higher than there
    let s0 = scale /. pow2f(lvl)
    let sv = water_line(p_sea(g), scale, s0)
    let x0m = int_to_float(x0) *. scale
    let y0m = int_to_float(y0) *. scale
    let z0m = int_to_float(z0) *. scale
    -- level 0 reads its trees from its own area; a coarse chunk asks level 0 about each tree (coarse_trees)
    let pad = if fine do tree_pad(d, scale) else 0 end
    let n = 32 + 2 * pad
    match area_lv(g, a, scale, s0, x0 - pad, z0 - pad, n, seed) do
      Area(hp0, cp, gp, lp, rp) ->
        -- above level 0 the land stands a little higher, so a coarse voxel is solid where a fine one under it would be
        let hp = if fine do hp0 else lift_go(hp0, level_lift(scale), 0, n * n) end
        let hs = if pad == 0 do hp else inner_f32(hp, n, pad, NativeArray.make_f32(1024, 0.0), 0) end
        let cms = if pad == 0 do cp else inner_f32(cp, n, pad, NativeArray.make_f32(1024, 0.0), 0) end
        let gs = if pad == 0 do gp else inner_int(gp, n, pad, NativeArray.make_int(1024, 0), 0) end
        let ls = if pad == 0 do lp else inner_int(lp, n, pad, NativeArray.make_int(1024, 0), 0) end
        let rs = if pad == 0 do rp else inner_int(rp, n, pad, NativeArray.make_int(1024, 0), 0) end
        let ens0 = NativeArray.make_f32(1024, 0.0)
        let ens = if Ns.field2(single_s(), Strata.Seed.mix(seed, 9), p_entrance_freq(g), x0m, z0m, scale, 32, 32, ens0) == 1024 do ens0 else ens0 end
        let ns = dens_field(g, seed, x0m, y0m, z0m, scale)
        -- above level 0 no cave is cut: cave fields that never carve
        let ta = if fine do lattice_field(tunnel_s(), Strata.Seed.mix(seed, 6), p_tunnel_freq(g), x0m, y0m, z0m, scale) else NativeArray.make_f32(405, 1000.0) end
        let tb = if fine do lattice_field(tunnel_s(), Strata.Seed.mix(seed, 7), p_tunnel_freq(g), x0m, y0m, z0m, scale) else NativeArray.make_f32(405, 1000.0) end
        let cav = if fine do lattice_field(single_s(), Strata.Seed.mix(seed, 8), p_cavern_freq(g), x0m, y0m, z0m, scale) else NativeArray.make_f32(405, 0.0 -. 1000.0) end
        let fac = factors_go(a, g, x0m, z0m, scale, NativeArray.make_f32(81, 0.0), 0)
        let fs = factor_cols(fac, NativeArray.make_f32(1024, 0.0), 0)
        let seam = p_sea(g) +. 1.0
        let cv = cave_vals(g)
        let sand = p_sand_below(g)
        let snow = p_snow_above(g)
        let fill = filler_depth(fine, scale)
        let fl = if fine do Fields(hs, cms, ens, fs, lattice_fill(ns), lattice_fill(ta), lattice_fill(tb), lattice_fill(cav))
          else Fields(hs, cms, ens, fs, lattice_fill(ns), NativeArray.make_f32(32768, 1000.0), NativeArray.make_f32(32768, 1000.0), NativeArray.make_f32(32768, 0.0 -. 1000.0)) end
        let dens0 = dens_go(cv, fl, NativeArray.make_f32(32768, 0.0), y0m, scale, seam)
        let dens = if !fine do dens0 else if any_cut(dens0, 0) do drop_islands(dens0) else dens0 end end
        let above = above_go(cv, hs, cms, ens, fs, ns, ta, tb, cav, NativeArray.make_f32(1024, 0.0), y0m +. 32.0 *. scale, seam, 0)
        let mats = Strata.Surface.scan_wet(dens, above, NativeArray.make_int(1024, sv - y0), fn (depth, yl, wet) -> material(sand, snow, depth, y0 + yl, sv, scale, wet, fill))
        let land = Ch.from_flat(finish_go(g, fine, mats, gs, ls, rs, x0, y0, z0, sv, scale, seed, 0))
        -- a tree stands at least H - A, so a chunk wholly under that holds none
        let (low, _) = span_go(hp, 0, n * n, 1000000.0, 0.0 -. 1000000.0)
        let ts = if lvl > 2 do Nil else if (int_to_float(y0 + 32) *. scale) < low -. p_amp(g) do Nil
          else if fine do island_trees(a, d, hp, cp, lp, rp, cx, cz, pad, seed, scale) else coarse_trees(a, d, cx, cz, scale, s0, seed) end end end
        if fine do ruins_into(a, d, trees_into(land, Strata.Coord.key(cx, cy, cz), ts), cx, cy, cz, scale, seed)
        else coarse_into(land, a, d, ts, lvl, x0, y0, z0) end
    end
  end

  doc "The trees level 0 stands that can reach the coarse chunk column (cx, cz) of [sc] metres a voxel, in a world of [s0] metres a voxel at level 0: (template, placement, base column x, ground top y, base column z) in level-0 voxels, each decided as level 0 decides it, from the area of level-0 columns a metre each side of its base (3 x 3 at 1 m)."
  fn coarse_trees(a : Strata.Atlas.Atlas, d : Decor, cx : Int, cz : Int, sc : Float, s0 : Float, seed : Int) : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int)) do
    if List.length(decor_trees(d)) < 12 do Nil
    else
      let k = tree_kind(d)
      let x0 = int_to_float(cx * 32) *. sc
      let z0 = int_to_float(cz * 32) *. sc
      let x1 = int_to_float(cx * 32 + 32) *. sc
      let z1 = int_to_float(cz * 32 + 32) *. sc
      let g = decor_gp(d)
      let ps = Strata.Feature.candidates(k, seed, x0, z0, x1, z1, fn (x, z) -> region_density(g, Strata.Atlas.region_at(a, x, z)))
      List.reverse(List.fold_left(ps, Nil, fn (acc, p) -> if reaches(p, x0, z0, x1, z1, Strata.Feature.k_radius(k)) do level0_tree(a, d, p, s0, seed, acc) else acc end))
    end
  end
  pfn level0_tree(a : Strata.Atlas.Atlas, d : Decor, p : Strata.Feature.Placed, s0 : Float, seed : Int, acc : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int))) : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int)) do
    let wx = float_to_int(Math.floor(Strata.Feature.p_xm(p) /. s0))
    let wz = float_to_int(Math.floor(Strata.Feature.p_zm(p) /. s0))
    let k = slope_step(s0)
    match area_n(decor_gp(d), a, s0, wx - k, wz - k, 2 * k + 1, seed) do
      Area(hs, cms, _, ls, rs) -> island_tree(a, d, p, hs, cms, ls, rs, wx - k, wz - k, 2 * k + 1, seed, s0, acc)
    end
  end

  -- levels 1 and 2: each tree as its template coarsened (coarse_window), into chunk c whose first voxel is (x0, y0, z0) of level lvl
  pfn coarse_into(c : Strata.Chunk.Chunk, a : Strata.Atlas.Atlas, d : Decor, ts : List((Strata.Template.Template, Strata.Feature.Placed, Int, Int, Int)), lvl : Int, x0 : Int, y0 : Int, z0 : Int) : Strata.Chunk.Chunk do
    match ts do
      Nil -> c
      Cons((t, p, wx, top, wz), rest) ->
        let i = pick_at(d, Strata.Atlas.region_at(a, Strata.Feature.p_xm(p), Strata.Feature.p_zm(p)), Strata.Feature.p_index(p))
        match List.nth_opt(decor_coarse(d), i) do
          None -> coarse_into(c, a, d, rest, lvl, x0, y0, z0)
          Some((w1, w2)) ->
            match tree_origin(t, wx, top, wz) do
              (ox, oy, oz) -> coarse_into(coarse_tree_into(c, t, if lvl == 1 do w1 else w2 end, if lvl == 1 do 2 else 4 end, ox, oy, oz, Strata.Feature.p_rot(p), x0, y0, z0), a, d, rest, lvl, x0, y0, z0)
            end
        end
    end
  end

  doc "The island chunk's early-out at chunk coordinates (cx, cy, cz) at the default settings, decided from the atlas alone: 0 wholly air, 1 wholly stone, -1 when the chunk must be generated in full. Room is left for trees and ruins (feature_top over the ground)."
  fn island_early(a : Strata.Atlas.Atlas, scale : Float, cx : Int, cy : Int, cz : Int) : Int do island_early_of(gp_default(), a, scale, cx, cy, cz) end

  doc "As island_early, at settings g."
  fn island_early_of(g : Gp, a : Strata.Atlas.Atlas, scale : Float, cx : Int, cy : Int, cz : Int) : Int do island_early_lift(g, a, scale, 0.0, cx, cy, cz) end

  -- as island_early_of, the land lifted [lift] metres
  pfn island_early_lift(g : Gp, a : Strata.Atlas.Atlas, scale : Float, lift : Float, cx : Int, cy : Int, cz : Int) : Int do
    let y0m = int_to_float(cy * 32) *. scale
    match quick_bounds(g, a, int_to_float(cx * 32) *. scale, int_to_float(cz * 32) *. scale, scale) do
      (lo, hi, wet) ->
        if y0m > fmax(hi +. lift +. p_amp(g) /. p_squash(g), wet) +. feature_top() do 0
        else if y0m +. 31.0 *. scale < lo -. p_amp(g) /. p_squash(g) -. p_cave_depth(g) do 1
        else 0 - 1 end end
    end
  end

  doc "The island chunk at chunk coordinates (cx, cy, cz) generated in full with the trees and ruins of d, without the early-outs (for checking them)."
  fn island_full_chunk(a : Strata.Atlas.Atlas, d : Decor, scale : Float, cx : Int, cy : Int, cz : Int, seed : Int) : Strata.Chunk.Chunk do
    island_full(a, d, scale, 0, cx, cy, cz, seed)
  end

  doc "The island chunk at chunk coordinates (cx, cy, cz) for [seed], read from atlas [a], in a world of [scale] metres a voxel: the land alone, no trees or ruins (a site's ground is pulled to its floor all the same). Pure."
  fn island_terrain(a : Strata.Atlas.Atlas, scale : Float, cx : Int, cy : Int, cz : Int, seed : Int) : Strata.Chunk.Chunk do
    island_decorated(a, bare_decor(), scale, cx, cy, cz, seed)
  end

  doc "The island chunk at chunk coordinates (cx, cy, cz) with the trees and ruins of d, at d's settings. Pure."
  fn island_decorated(a : Strata.Atlas.Atlas, d : Decor, scale : Float, cx : Int, cy : Int, cz : Int, seed : Int) : Strata.Chunk.Chunk do
    let e = island_early_of(decor_gp(d), a, scale, cx, cy, cz)
    if e >= 0 do Ch.uniform(e) else island_full(a, d, scale, 0, cx, cy, cz, seed) end
  end

  -- ── Levels: the far field ────────────────────────────────────────────────
  -- A level-L chunk is the same chain at scale * 2^L metres a voxel: the
  -- atlas read at that step, the detail and density noise at the same
  -- frequencies in metres, the early-outs as before; water lines stand no
  -- higher than level 0's (water_line). Above level 0 no cave is cut and no
  -- tall grass or post stands; levels 1 and 2 keep each tree level 0 stands
  -- as its template coarsened (coarse_window), coarser levels none; a ruin is level 0's alone, but its site's beard (the ground pulled
  -- to its floor) is at every level. The thermal halo and the density's
  -- lattice are counted in voxels, so at coarser levels they reach over more
  -- metres. A chunk wholly beyond the atlas (and the reach of its rivers and
  -- the thermal halo) is open sea at every level: water to the sea line over
  -- a floor 20 m under it (the atlas's own fill there), sand 4 voxels deep.

  doc "The highest level of detail the island's generator makes."
  fn island_levels() : Int do 5 end

  -- how far a coarse level's land is lifted, in metres, at [sc] metres a voxel: a share of a voxel
  pfn level_lift(sc : Float) : Float do 0.5 *. sc end

  pfn lift_go(a : NativeF32Arr, lift : Float, k : Int, cnt : Int) : NativeF32Arr do
    if k >= cnt do a else lift_go(NativeArray.set_f32(a, k, NativeArray.get_f32(a, k) +. lift), lift, k + 1, cnt) end
  end

  pfn pow2f(l : Int) : Float do if l <= 0 do 1.0 else 2.0 *. pow2f(l - 1) end end

  -- whether the chunk column (cx, cz) of [sc] metres a voxel lies wholly beyond the atlas, its rivers' reach and the thermal halo
  pfn beyond(g : Gp, a : Strata.Atlas.Atlas, sc : Float, cx : Int, cz : Int) : Bool do
    let st = Strata.Atlas.step(a)
    let nn = Strata.Atlas.n(a)
    let margin = reach_m() +. int_to_float(halo(g)) *. sc +. max_reach() +. 2.0 *. st
    let lo = int_to_float(0 - nn / 2) *. st -. margin
    let hi = int_to_float(nn / 2 - 1) *. st +. margin
    let x0 = int_to_float(cx * 32) *. sc
    let z0 = int_to_float(cz * 32) *. sc
    let side = 32.0 *. sc
    x0 > hi || x0 +. side < lo || z0 > hi || z0 +. side < lo
  end

  pfn sea_go(m : NativeI32Arr, y0 : Int, bed : Int, sv : Int, i : Int) : NativeI32Arr do
    if i >= 32768 do m
    else
      let wy = y0 + i / 1024
      let id = if wy <= bed - 4 do 1 else if wy <= bed do 4 else if wy <= sv do 5 else 0 end end end
      sea_go(NativeArray.set_i32(m, i, id), y0, bed, sv, i + 1)
    end
  end

  -- open sea at chunk row cy of [sc] metres a voxel
  pfn sea_chunk(g : Gp, sc : Float, s0 : Float, cy : Int) : Strata.Chunk.Chunk do
    let sv = water_line(p_sea(g), sc, s0)
    -- the bed stays under the water line, so the coarsest level still has a voxel of sea
    let bed0 = vox(p_sea(g) -. 20.0, sc)
    let bed = if bed0 >= sv do sv - 1 else bed0 end
    let y0 = cy * 32
    if y0 > sv do Ch.uniform(0)
    else if y0 + 31 <= bed - 4 do Ch.uniform(1)
    else Ch.from_flat(sea_go(NativeArray.make_i32(32768, 0), y0, bed, sv, 0)) end end
  end

  doc "The island chunk of key k at any level 0..island_levels() with the trees and ruins of d, at d's settings, in a world of [scale] metres a voxel: level L at scale * 2^L. Pure."
  fn island_level(a : Strata.Atlas.Atlas, d : Decor, scale : Float, k : Strata.Coord.Key, seed : Int) : Strata.Chunk.Chunk do
    let l = Strata.Coord.level(k)
    let cx = Strata.Coord.kx(k)
    let cy = Strata.Coord.ky(k)
    let cz = Strata.Coord.kz(k)
    let g = decor_gp(d)
    let sc = scale *. pow2f(l)
    if beyond(g, a, sc, cx, cz) do sea_chunk(g, sc, scale, cy)
    else if l == 0 do island_decorated(a, d, scale, cx, cy, cz, seed)
    else
      let e = island_early_lift(g, a, sc, level_lift(sc), cx, cy, cz)
      if e >= 0 do Ch.uniform(e) else island_full(a, d, sc, l, cx, cy, cz, seed) end
    end end
  end

  -- ── The structure layer ──────────────────────────────────────────────────
  -- The ruins' replay: the site pass of island_full alone, blitted into an
  -- empty chunk, so every voxel a ruin template wrote is known. A ruin is
  -- blitted last, so in the generated chunk each of these voxels holds the
  -- ruin's block; an edit that removes one leaves it in the replay and air
  -- (or what was put there) in the chunk.

  doc "The structure layer of the island chunk at (cx, cy, cz): per voxel (x + 32 z + 1024 y) the index + 1 of the site whose ruin wrote it, 0 for none. A chunk the early-out makes uniform holds none. Pure."
  fn island_stamps(a : Strata.Atlas.Atlas, d : Decor, scale : Float, cx : Int, cy : Int, cz : Int, seed : Int) : NativeI32Arr do
    let none = NativeArray.make_i32(32768, 0)
    if island_early_of(decor_gp(d), a, scale, cx, cy, cz) >= 0 do none
    else
      let half = 16.0 *. scale
      match Strata.Atlas.site_near(a, int_to_float(cx * 32) *. scale +. half, int_to_float(cz * 32) *. scale +. half, half *. 1.4143 +. 40.0) do
        None -> none
        Some(s) ->
          let c = ruins_into(a, d, Ch.uniform(0), cx, cy, cz, scale, seed)
          stamp_go(c, Strata.Atlas.s_index(s) + 1, none, 0)
      end
    end
  end
  pfn stamp_go(c : Strata.Chunk.Chunk, v : Int, out : NativeI32Arr, i : Int) : NativeI32Arr do
    if i >= 32768 do out
    else if Ch.get_idx(c, i) == 0 do stamp_go(c, v, out, i + 1)
    else stamp_go(c, v, NativeArray.set_i32(out, i, v), i + 1) end end
  end

  doc "The ids a ruin is built of (its palette: stone, and dirt for rubble)."
  fn ruin_block(id : Int) : Bool do id == 1 || id == 2 end

  doc "The viewer's generator for atlas a with the trees, ruins and settings of d, in a world of [scale] metres a voxel: the island's chunks at levels 0..island_levels() (`island_level`), and its ruins replayed as stamps."
  fn island_gen(a : Strata.Atlas.Atlas, d : Decor, scale : Float) : Strata.Terrain.Gen do
    Strata.Terrain.with_stamps(Strata.Terrain.gen_levels(fn (k, sd) -> island_level(a, d, scale, k, sd), island_levels()),
      Strata.Terrain.Stamps(fn (k, sd) -> island_stamps(a, d, scale, Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), sd)))
  end

  doc "The ground height in whole metres at a whole-metre column of the viewer's land at the default settings, lakes included (a river column's bed)."
  fn land_height(land : Land, wx : Int, wz : Int, seed : Int) : Int do
    match land do
      Island(a) -> match island_column(a, wx, wz, seed, 1.0) do (h, _, _) -> h end
    end
  end

  -- ── The camera and the frame loop ────────────────────────────────────────
  pfn axis(pos : Bool, neg : Bool) : Float do (if pos do 1.0 else 0.0 end) -. (if neg do 1.0 else 0.0 end) end
  pfn clampf(v : Float, lo : Float, hi : Float) : Float do if v < lo do lo else if v > hi do hi else v end end end

  -- ── The test lake ────────────────────────────────────────────────────────
  -- Direction i of sixteen round the compass, as (dx, dz) scaled by 1000;
  -- a camera with yaw i * pi / 8 looks along it.
  pfn dir_x(i : Int) : Float do Math.sin(int_to_float(i) *. 0.39269908) end
  pfn dir_z(i : Int) : Float do 0.0 -. Math.cos(int_to_float(i) *. 0.39269908) end
  pfn at_x(cx : Int, i : Int, d : Int) : Int do cx + float_to_int(Math.round(dir_x(i) *. int_to_float(d))) end
  pfn at_z(cz : Int, i : Int, d : Int) : Int do cz + float_to_int(Math.round(dir_z(i) *. int_to_float(d))) end

  -- The island's test lake: the deepest carved lake (level over the bed at
  -- its centre; every bowl has the same radius) within 400 m of the origin,
  -- or failing one, 800 m. [best] is (x, z, level, depth).
  pfn deepest_go(a : Strata.Atlas.Atlas, ls : List((Float, Float, Float)), reach : Float, best : (Float, Float, Float, Float)) : (Float, Float, Float, Float) do
    match ls do
      Nil -> best
      Cons((x, z, lv), rest) ->
        let depth = lv -. Strata.Atlas.height_at(a, x, z)
        let ok = if lv < 0.0 do false else if Math.sqrt(x *. x +. z *. z) > reach do false else depth > (match best do (_, _, _, bd) -> bd end) end end
        deepest_go(a, rest, reach, if ok do (x, z, lv, depth) else best end)
    end
  end

  -- The island lake's outlet: down the flood's receivers from sample (i, j),
  -- the first sample off the lake whose receiver is off it too (a bump in
  -- the water that drains back into it is passed over), as (x, z): where
  -- the lake spills into the river leaving it.
  pfn outlet_go(a : Strata.Atlas.Atlas, i : Int, j : Int, left : Int) : (Float, Float) do
    let nn = Strata.Atlas.n(a)
    let st = Strata.Atlas.step(a)
    let r = Strata.Atlas.receiver_ij(a, i, j)
    let off = Strata.Atlas.lake_ij(a, i, j) < 0.0
    let away = if r < 0 do true else Strata.Atlas.lake_ij(a, r % nn, r / nn) < 0.0 end
    let out = if off do away else false end   -- not `&&`: GAPS S16
    if out || r < 0 || left <= 0 do (int_to_float(i - nn / 2) *. st, int_to_float(j - nn / 2) *. st)
    else outlet_go(a, r % nn, r / nn, left - 1) end
  end

  -- how far along direction d from (cx, cz) the first column stands at or over the water line: the water's edge
  pfn water_edge(land : Land, cx : Int, cz : Int, d : Int, line : Int, seed : Int, t : Int) : Int do
    if t >= 200 do t
    else if land_height(land, at_x(cx, d, t), at_z(cz, d, t), seed) >= line do t
    else water_edge(land, cx, cz, d, line, seed, t + 1) end end
  end

  -- the nearest of the sixteen compass directions (see dir_x) to (dx, dz)
  pfn dir_of(dx : Float, dz : Float) : Int do
    let i = float_to_int(Math.round(Math.atan2(dx, 0.0 -. dz) /. 0.39269908))
    ((i % 16) + 16) % 16
  end

  doc "The lake the scripted scenes breach on [land]: (centre x, centre z, radius, water line, the direction 0..15 of its lowest side, the bed under its centre, the ground 10 m beyond its rim on that side), whole metres: the island's deepest lake near the origin, its lowest side toward the outlet and its radius the water's edge on that side. Radius 0 if there is none."
  fn scene_lake(land : Land, seed : Int) : (Int, Int, Int, Int, Int, Int, Int) do
    match land do
      Island(a) ->
        let near = deepest_go(a, Strata.Atlas.lakes(a), 400.0, (0.0, 0.0, 0.0, 0.0))
        let pick = match near do (_, _, _, dn) -> if dn > 0.0 do near else deepest_go(a, Strata.Atlas.lakes(a), 800.0, (0.0, 0.0, 0.0, 0.0)) end end
        match pick do
          (x, z, lv, depth) ->
            if depth <= 0.0 do (0, 0, 0, 0, 0, 0, 0)
            else
              let cx = float_to_int(Math.round(x))
              let cz = float_to_int(Math.round(z))
              let st = Strata.Atlas.step(a)
              let nn = Strata.Atlas.n(a)
              match outlet_go(a, float_to_int(Math.round(x /. st)) + nn / 2, float_to_int(Math.round(z /. st)) + nn / 2, nn * nn) do
                (ox, oz) ->
                  let d = dir_of(ox -. x, oz -. z)
                  let rad = water_edge(land, cx, cz, d, vox(lv, 1.0), seed, 0)
                  (cx, cz, rad, vox(lv, 1.0), d, land_height(land, cx, cz, seed), land_height(land, at_x(cx, d, rad + 10), at_z(cz, d, rad + 10), seed))
              end
            end
        end
    end
  end

  -- A stream and the fluid that moves in its world.
  type Sim = Sim(Strata.Stream.Stream, Strata.Fluid.Fluid, Strata.Physics.Physics)
  pfn sim_stream(m : Sim) : Strata.Stream.Stream do match m do Sim(s, _, _) -> s end end
  pfn sim_fluid(m : Sim) : Strata.Fluid.Fluid do match m do Sim(_, f, _) -> f end end
  pfn sim_phys(m : Sim) : Strata.Physics.Physics do match m do Sim(_, _, p) -> p end end

  -- Apply an edit and tell the fluid and physics about it.
  pfn edit_one(m : Sim, o : Strata.Edit.Outcome) : Sim do
    match m do
      Sim(s, f, p) -> Sim(Strata.Stream.apply(s, o), Strata.Fluid.wake(f, Strata.Edit.world(o), o), Strata.Physics.wake(p, o))
    end
  end

  -- An edit applied to the simulation: the stream, the fluid and the physics hear of it; then the tall grass (block 11) it left hanging is taken away, as a second edit (Strata.Edit.unsupported).
  pfn edit(m : Sim, o : Strata.Edit.Outcome) : Sim do
    let m1 = edit_one(m, o)
    let w = Strata.Edit.world(o)
    let reg = Strata.World.registry(w)
    match Strata.Edit.unsupported(w, Strata.Edit.changes(o), fn id -> id == 11, fn id -> id != 0 && Strata.Blocks.collides(reg, id)) do
      Nil -> m1
      gone -> edit_one(m1, Strata.Edit.set_many(Strata.Stream.world(sim_stream(m1)), gone))
    end
  end

  pfn match_edit(m : Sim, x : Float, y : Float, z : Float, fx : Float, fy : Float, fz : Float, dig : Bool, build : Bool, block : Int) : Sim do
    match StrataViewer.Match.single_edit(Strata.Stream.world(sim_stream(m)), x, y, z, fx, fy, fz, dig, build, block) do
      Nil -> m
      cs -> edit(m, Strata.Edit.set_many(Strata.Stream.world(sim_stream(m)), cs))
    end
  end
  -- A picture of the next frame drawn, as screenshots/strata-<process>-<frame>.png under the folder the viewer was started in.
  -- The renderer writes a PPM; a second later `sips` (macOS) turns it into a PNG and the PPM is removed.
  pfn take_picture(frame : Int) : Unit do
    let stem = "screenshots/strata-" ++ int_to_string(Authority.must(Process.pid())) ++ "-" ++ int_to_string(frame)
    let _ = Authority.must(Dir.mkdir_p("screenshots"))
    let _ = Process.set_env("STRATA_SHOT", stem ++ ".ppm")
    Strata.Ffi.Vk.request_shot()
    let _ = Process.run("sh", ["-c", "(sleep 1; sips -s format png '" ++ stem ++ ".ppm' --out '" ++ stem ++ ".png' && rm '" ++ stem ++ ".ppm') >/dev/null 2>&1 &"])
    Authority.must(println("strata_viewer: picture saved as " ++ stem ++ ".png"))
  end

  -- STRATA_COMBAT_SCRIPT: the match's scripted players by name; 0 none
  pfn combat_script(name : String) : Int do
    if name == "archer" do 1 else if name == "victim" do 2 else if name == "far" do 3 else if name == "waller" do 4 else 0 end end end end
  end

  -- STRATA_COMBAT_SCENE: the match's scripted scenes by name (StrataViewer.Match's head lists them); 0 the match itself
  pfn combat_scene(name : String) : Int do
    if name == "duel" do 1 else if name == "trap" do 2 else if name == "fire" do 3 else if name == "channel" do 4 else if name == "fence" do 40 else 0 end end end end end
  end

  -- A frame of the match on the simulation: the match's own step, then what it changed in the world as one edit.
  pfn match_frame(mt : StrataViewer.Match.MtMatch, m : Sim, inp : StrataViewer.Match.MtInput, dt : Float) : (StrataViewer.Match.MtMatch, Sim) do
    if !StrataViewer.Match.is_on(mt) do (mt, m)
    else
      match m do
        Sim(s, f, p) ->
          match StrataViewer.Match.frame(mt, s, f, inp, dt) do
            (mt2, s2, changes) ->
              match changes do
                Nil -> (mt2, Sim(s2, f, p))
                _ -> (mt2, edit(Sim(s2, f, p), Strata.Edit.set_many(Strata.Stream.world(s2), changes)))
              end
          end
      end
    end
  end

  -- ── Physics ──────────────────────────────────────────────────────────────
  -- physics, the step in flight, the walker's driven body, C last frame, metres per voxel, the clock's start
  type PhysRig = PhysRig(Strata.Physics.Physics, Option(Strata.Physics.Stepping), Int, Bool, Float, Float)

  pfn block_of(n : Int, id : Int, i : Int, g : Strata.Body.Grid) : Strata.Body.Grid do
    if i >= n * n * n do g else block_of(n, id, i + 1, Strata.Body.grid_set(g, i % n, (i / n) % n, i / (n * n), id)) end
  end
  -- a wooden crate 2 m across at 1 m voxels, 1 m across at 10 cm
  pfn crate(scale : Float) : Strata.Body.Grid do
    let n = if scale < 0.5 do 10 else 2 end
    block_of(n, 7, 0, Strata.Body.grid(n, n, n))
  end
  pfn add_crate(p : Strata.Physics.Physics, x : Float, y : Float, z : Float, scale : Float) : Strata.Physics.Physics do
    match Strata.Physics.add(p, crate(scale), x, y, z, Strata.Math.Quat.identity(), Strata.Physics.dynamic()) do
      (p2, _) -> p2
    end
  end
  -- the first column along the view, 4 to 60 m out, whose ground stands above the sea: a crate on it
  pfn shore_crate(p : Strata.Physics.Physics, land : Land, ex : Float, ez : Float, yaw : Float, seed : Int, sc : Float, d : Int) : Strata.Physics.Physics do
    if d > 60 do p
    else
      let x = float_to_int(Math.floor(ex +. Math.sin(yaw) *. int_to_float(d)))
      let z = float_to_int(Math.floor(ez -. Math.cos(yaw) *. int_to_float(d)))
      let h = land_height(land, x, z, seed)
      if h >= sea() do add_crate(p, int_to_float(x), int_to_float(h + 1), int_to_float(z), sc)
      else shore_crate(p, land, ex, ez, yaw, seed, sc, d + 1) end
    end
  end
  -- n crates in rows of ten ahead of the camera, 4 m apart, 2 m above the ground (STRATA_CRATES, for timing the rays)
  pfn crates_in_view(p : Strata.Physics.Physics, land : Land, ex : Float, ez : Float, yaw : Float, seed : Int, sc : Float, n : Int, i : Int) : Strata.Physics.Physics do
    if i >= n do p
    else
      let ahead = 25.0 +. int_to_float(i / 10) *. 4.0
      let side = (int_to_float(i % 10) -. 4.5) *. 4.0
      let x = ex +. Math.sin(yaw) *. ahead +. Math.cos(yaw) *. side
      let z = ez -. Math.cos(yaw) *. ahead +. Math.sin(yaw) *. side
      let h = land_height(land, float_to_int(Math.floor(x)), float_to_int(Math.floor(z)), seed)
      crates_in_view(add_crate(p, x, int_to_float(h + 3), z, sc), land, ex, ez, yaw, seed, sc, n, i + 1)
    end
  end

  -- a stone slab 6 x 1 x 2 voxels
  pfn slab_body(i : Int, g : Strata.Body.Grid) : Strata.Body.Grid do
    if i >= 12 do g else slab_body(i + 1, Strata.Body.grid_set(g, i % 6, 0, i / 6, 1)) end
  end

  -- Breach the test lake on its lowest side: a channel of carve spheres of
  -- radius 4 through its rim and out, in two rows, one at the water line
  -- and one at the lake's bed, each sphere three voxels further out and (in
  -- the lower row) one lower, so the lake can run out to its floor.
  pfn breach_go(m : Sim, cx : Int, cz : Int, rad : Int, line : Int, bed : Int, d : Int, i : Int) : Sim do
    if i >= 12 do m
    else
      let out = rad - 2 + 3 * (i / 2)
      let y = if i % 2 == 0 do line - 2 else bed + 2 - i / 2 end
      breach_go(edit(m, Strata.Edit.fill_sphere(Strata.Stream.world(sim_stream(m)), at_x(cx, d, out), y, at_z(cz, d, out), 4, 0)), cx, cz, rad, line, bed, d, i + 1)
    end
  end
  pfn breach(m : Sim, tl : (Int, Int, Int, Int, Int, Int, Int)) : Sim do
    match tl do
      (cx, cz, rad, line, d, bed, _) -> if rad == 0 do m else breach_go(m, cx, cz, rad, line, bed, d, 0) end
    end
  end

  -- Open a shaft 3 x 3 and 12 deep in the floor at the middle of the test lake.
  pfn drain_floor(m : Sim, tl : (Int, Int, Int, Int, Int, Int, Int)) : Sim do
    match tl do
      (cx, cz, rad, _, _, bed, _) ->
        if rad == 0 do m
        else edit(m, Strata.Edit.fill_box(Strata.Stream.world(sim_stream(m)), cx - 1, bed - 12, cz - 1, cx + 1, bed, cz + 1, 0)) end
    end
  end

  -- Spray for what the water did this step: a burst where it lands, bigger
  -- for more water and faster for a longer fall; a little mist where it is
  -- still falling.
  pfn spray_events(es : List(Strata.Fluid.Event), n : Int) : Int do
    match es do
      Nil -> n
      Cons(e, t) ->
        let x = int_to_float(Strata.Fluid.ev_x(e)) +. 0.5
        let y = int_to_float(Strata.Fluid.ev_y(e))
        let z = int_to_float(Strata.Fluid.ev_z(e)) +. 0.5
        let eighths = Strata.Fluid.ev_eighths(e)
        if Strata.Fluid.ev_landed(e) do
          let speed = 1.5 +. 0.9 *. Math.sqrt(int_to_float(Strata.Fluid.ev_fell(e)))
          let count = if 2 * eighths > 64 do 64 else 2 * eighths end
          spray_events(t, if Strata.Render.spray(x, y +. 0.3, z, 0.0, speed *. 0.55, 0.0, count, speed *. 0.45, 0.8, 13) do n + count else n end)
        else if eighths >= 4 do
          spray_events(t, if Strata.Render.spray(x, y +. 0.5, z, 0.0, -1.0, 0.0, eighths / 4, 0.6, 0.5, 13) do n + eighths / 4 else n end)
        else spray_events(t, n) end end
    end
  end

  -- (id, count) of the blocks a list of changes removed, an id once
  pfn tally(cs : List(Strata.Edit.Change), acc : List((Int, Int))) : List((Int, Int)) do
    match cs do
      Nil -> acc
      Cons(c, rest) ->
        let old = Strata.Edit.old_id(c)
        tally(rest, if old <= 0 do acc else bump(acc, old) end)
    end
  end
  pfn bump(acc : List((Int, Int)), id : Int) : List((Int, Int)) do
    match acc do
      Nil -> Cons((id, 1), Nil)
      Cons((k, n), rest) -> if k == id do Cons((k, n + 1), rest) else Cons((k, n), bump(rest, id)) end
    end
  end

  doc "The block most of a blast's changes removed (0 if none): its spray takes that block's top texture."
  fn most_removed(cs : List(Strata.Edit.Change)) : Int do
    List.fold_left(tally(cs, Nil), (0, 0), fn (best, e) -> match (best, e) do ((_, bn), (k, n)) -> if n > bn do (k, n) else best end end) |> Tuple.first
  end

  doc "A blast at voxel (x, y, z) in [m]: a crater of radius 6 voxels shaped by a seed hashed from the world's seed and the place (salt 31), then 200 spray particles thrown upward in the colour of what it removed."
  fn blast_at(m : Sim, reg : Strata.Blocks.Registry, seed : Int, x : Int, y : Int, z : Int) : Sim do
    let o = Strata.Edit.blast(Strata.Stream.world(sim_stream(m)), x, y, z, 6, Strata.Seed.cell(seed, 31, x, y, z), 0)
    let id = most_removed(Strata.Edit.changes(o))
    let m2 = edit(m, o)
    if id > 0 && Strata.Render.spray(int_to_float(x) +. 0.5, int_to_float(y) +. 0.5, int_to_float(z) +. 0.5, 0.0, 7.0, 0.0, 200, 3.5, 1.4, Bk.face_tex(reg, id, 0)) do m2 else m2 end
  end

  -- Left click blasts, right click builds, each once per press. The camera is in voxels; the ray is cast in metres.
  pfn act(m : Sim, reg : Strata.Blocks.Registry, seed : Int, scale : Float, x : Float, y : Float, z : Float, fx : Float, fy : Float, fz : Float, dig : Bool, build : Bool, block : Int) : Sim do
    if !dig && !build do m
    else
      let w = Strata.Stream.world(sim_stream(m))
      let h = Strata.Query.raycast(w, x *. scale, y *. scale, z *. scale, fx, fy, fz, 250.0, Strata.Query.targetable(reg))
      if !Strata.Query.is_hit(h) do m
      else if dig do blast_at(m, reg, seed, Strata.Query.hit_x(h), Strata.Query.hit_y(h), Strata.Query.hit_z(h))
      else edit(m, Strata.Edit.fill_sphere(w, Strata.Query.hit_x(h), Strata.Query.hit_y(h) + 2, Strata.Query.hit_z(h), 2, block)) end end
    end
  end

  -- Sound. STRATA_AUDIO=0 off (the default for scripted runs), 1 the device
  -- (the default when playing), null the silent null device, wav:path the
  -- whole session rendered in game time to a file with no device.
  pfn audio_start(frames : Int) : Strata.Sound.Sound do
    let mode = Authority.must(Env.get("STRATA_AUDIO", if frames > 0 do "0" else "1" end))
    let opened = if mode == "1" do Strata.Ffi.Audio.open(false)
      else if mode == "null" do Strata.Ffi.Audio.open_null()
      else if String.starts_with(mode, "wav:") do Strata.Ffi.Audio.render(String.slice_bytes(mode, 4, String.byte_size(mode) - 4))
      else false end end end
    if mode != "0" do Authority.must(println("strata_viewer: sound " ++ (if opened do "on (" ++ mode ++ ")" else "unavailable; running silent" end))) else () end
    let loaded = if opened do load_all(sound_files(), 0) else 0 end
    if loaded > 0 do Authority.must(println("strata_viewer: " ++ int_to_string(loaded) ++ " recordings from viewer/sounds/; N plays one")) else () end
    -- the strike patch first (id 1), then a gust whose strength follows how open the sky is
    let s1 = match Strata.Sound.upload(Strata.Sound.new(), Strata.Sound.strike()) do (s, _) -> s end
    let level = start_level()
    if level < 1.0 do Authority.must(println("strata_viewer: main level " ++ ms2(level))) else () end
    match Strata.Sound.with_gust(if level < 1.0 do Strata.Sound.set_master(s1, level) else s1 end, true, 1) do (s2, _) -> s2 end
  end
  -- the main level at start, from STRATA_AUDIO_LEVEL, 0..1 (anything else clamped; unreadable is full)
  pfn start_level() : Float do
    match String.to_float(Authority.must(Env.get("STRATA_AUDIO_LEVEL", "1.0"))) do
      Ok(x) -> if x >= 0.0 do (if x > 1.0 do 1.0 else x end) else (if x < 0.0 do 0.0 else 1.0 end) end
      Err(_) -> 1.0
    end
  end
  doc "The viewer's key state for a main level: bits 8-11 hold it as tenths below full, rounded."
  fn level_bits(level : Float) : Int do
    let t = float_to_int(Math.round((if level < 0.0 do 0.0 else if level > 1.0 do 1.0 else level end end) *. 10.0))
    (10 - t) * 256
  end
  doc "The main level, in tenths (0..10), held in a key state."
  fn level_tenths(keys : Int) : Int do 10 - int_and(keys / 256, 15) end

  -- the WAV files in viewer/sounds/, in the order listed; loaded at start, so the nth has recording id 2048 + n
  pfn sound_files() : List(String) do
    match Authority.must(Dir.list("sounds")) do
      Ok(names) -> List.filter(names, fn n -> String.ends_with(n, ".wav") || String.ends_with(n, ".flac") || String.ends_with(n, ".mp3"))
      Err(_) -> Nil
    end
  end
  pfn load_all(names : List(String), n : Int) : Int do
    match names do
      Nil -> n
      Cons(h, t) -> load_all(t, if Strata.Ffi.Audio.load("sounds/" ++ h) > 0 do n + 1 else n end)
    end
  end
  pfn place_recording(snd : Strata.Sound.Sound, frame : Int, x : Float, y : Float, z : Float) : Strata.Sound.Sound do
    let n = List.length(sound_files())
    if n == 0 do
      Authority.must(println("strata_viewer: no recordings in viewer/sounds/"))
      snd
    else
      let id = 2048 + frame % n
      if !Strata.Ffi.Audio.ready(id) do
        Authority.must(println("strata_viewer: recording " ++ int_to_string(id - 2048) ++ " is not ready"))
        snd
      else match Strata.Sound.play(Strata.Sound.recorded(snd, id, Strata.Ffi.Audio.length(id)), id, 0, x, y, z, 0.9, 1.0, 1.0) do (s, v) -> Strata.Sound.with_range(s, v, 3.0, 150.0) end end
    end
  end
  -- the strike patch is the first uploaded
  pfn strike_patch() : Int do 1 end
  -- how the viewer's blocks sound underfoot: (hardness, size), its own table
  pfn underfoot(id : Int) : (Float, Float) do
    if id == 1 do (0.9, 0.4)
    else if id == 2 do (0.3, 0.6)
    else if id == 3 || id == 11 do (0.2, 0.5)
    else if id == 4 do (0.12, 0.7)
    else if id == 6 do (0.08, 0.6)
    else if id == 7 do (0.6, 0.6)
    else if id == 13 do (1.0, 0.3)
    else (0.5, 0.5) end end end end end end end
  end
  pfn footstep(snd : Strata.Sound.Sound, id : Int, x : Float, y : Float, z : Float, energy : Float) : Strata.Sound.Sound do
    match underfoot(id) do
      (hard, size) ->
        match Strata.Sound.play(snd, strike_patch(), 0, x, y, z, 0.5, 1.0, 0.5) do
          (s1, v) -> Strata.Sound.control(Strata.Sound.control(Strata.Sound.control(s1, v, 0, hard), v, 1, size), v, 2, energy)
        end
    end
  end
  -- a strike where the view's ray meets the world, or 3 m ahead when it meets nothing
  pfn strike_at(snd : Strata.Sound.Sound, w : Strata.World.World, reg : Strata.Blocks.Registry, x : Float, y : Float, z : Float, fx : Float, fy : Float, fz : Float, hardness : Float, size : Float) : Strata.Sound.Sound do
    let h = Strata.Query.raycast(w, x, y, z, fx, fy, fz, 250.0, Strata.Query.targetable(reg))
    let d = if Strata.Query.is_hit(h) do Strata.Query.hit_dist(h) else 3.0 end
    match Strata.Sound.play(snd, strike_patch(), 0, x +. fx *. d, y +. fy *. d, z +. fz *. d, 0.9, 1.0, 1.0) do
      (s1, v) -> Strata.Sound.control(Strata.Sound.control(Strata.Sound.control(Strata.Sound.with_range(s1, v, 4.0, 250.0), v, 0, hardness), v, 1, size), v, 2, 0.8)
    end
  end
  -- once a frame, last: hand over the frame's sound, mix it in game time if rendering, and with STRATA_AUDIO_METER=1 report once a second
  pfn audio_frame(snd : Strata.Sound.Sound, w : Strata.World.World, fl : Strata.Fluid.Fluid, dt : Float, frame : Int, scripted : Bool, now : Float, t_prev : Float) : Strata.Sound.Sound do
    match Strata.Sound.update(snd, w, fl, dt) do
      (s2, cmds) ->
        let took = Strata.Ffi.Audio.send(cmds)
        Strata.Ffi.Audio.advance(dt)
        let second = if scripted do frame % 60 == 59 else Math.floor(now) != Math.floor(t_prev) end
        if second && took >= 0 && Authority.must(Env.get_int("STRATA_AUDIO_METER", 0)) == 1 do
          Authority.must(println("audio: playing " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(0))) ++ " virtual " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(1))) ++ " refused " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(2)) + Strata.Sound.refused(s2)) ++ " ring " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(3))) ++ " underruns " ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(4))) ++ " cpu " ++ ms2(Strata.Ffi.Audio.stat(5) *. 100.0) ++ "% peak " ++ ms2(Strata.Ffi.Audio.stat(6)) ++ "dB rms " ++ ms2(Strata.Ffi.Audio.stat(7)) ++ "dB"))
        else () end
        s2
    end
  end

  -- the soak line's sound figures: the mixer's state, the worst frame's sound
  -- work on the main thread, and an acoustics update for 64 voices round
  -- the camera timed here on the real terrain
  pfn ring64(x : Float, y : Float, z : Float, i : Int, acc : List((Int, Float, Float, Float))) : List((Int, Float, Float, Float)) do
    if i >= 64 do acc
    else
      let a = int_to_float(i) *. 0.0981747704
      ring64(x, y, z, i + 1, Cons((i + 1, x +. 30.0 *. Math.cos(a), y -. 5.0 +. int_to_float(i % 8), z +. 30.0 *. Math.sin(a)), acc))
    end
  end
  pfn audio_summary(s : Strata.Stream.Stream, reg : Strata.Blocks.Registry, cam : Cam, aworst : Float) : String do
    match cam do
      Cam(x, y, z, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        let t0 = Strata.Ffi.Vk.time()
        let n = List.length(Strata.Acoustics.finish(Strata.Acoustics.begin(Strata.Stream.world(s), reg, (x, y, z), ring64(x, y, z, 0, Nil))))
        let acoustics_ms = (Strata.Ffi.Vk.time() -. t0) *. 1000.0
        " audio_underruns=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(4))) ++ " audio_ring_refused=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(3))) ++ " audio_refused=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(2))) ++ " audio_cpu=" ++ ms2(Strata.Ffi.Audio.stat(5) *. 100.0) ++ " audio_main_ms=" ++ ms2(aworst) ++ " audio_latency_ms=" ++ ms2(Strata.Ffi.Audio.stat(10)) ++ " audio_mem_kb=" ++ int_to_string(float_to_int(Strata.Ffi.Audio.stat(11)) / 1024) ++ " acoustics_ms=" ++ ms2(acoustics_ms) ++ " acoustics_voices=" ++ int_to_string(n)
    end
  end

  pfn ms2(v : Float) : String do float_to_string(Math.round(v *. 100.0) /. 100.0) end

  -- eye position, yaw, pitch, the chunk the camera was last in, mouse buttons
  -- last frame, flying or walking, vertical speed, on the ground, F last frame
  -- ..., then the sun's height in degrees, the light mode, and whether L was down,
  -- then the sound keys down last frame (bit 0 N, bit 1 H, bit 3 9, bit 4 0), bit 2 headphones,
  -- bits 8-11 the main level as tenths below full,
  -- then the metres walked since the last footstep, then the hotbar slot chosen,
  -- then whether R was down
  type Cam = Cam(Float, Float, Float, Float, Float, Int, Int, Int, Bool, Bool, Bool, Float, Bool, Bool, Float, Int, Bool, Int, Float, Int, Bool)

  -- the hotbar slot a number key held this frame asks for, else the one already chosen
  pfn slot_key(i : Int, chosen : Int) : Int do
    if i >= 9 do chosen else if Strata.Ffi.Vk.key(49 + i) do i else slot_key(i + 1, chosen) end end
  end
  -- is the display on? STRATA_UI says; otherwise it is on when a person is at the keys
  pfn ui_on(scripted : Bool) : Bool do Authority.must(Env.get_int("STRATA_UI", if scripted do 0 else 1 end)) != 0 end
  -- the display's scale: STRATA_UI_SCALE in hundredths, 100 by default
  pfn ui_scale() : Float do int_to_float(Authority.must(Env.get_int("STRATA_UI_SCALE", 100))) /. 100.0 end

  -- Put the sun [deg] degrees above the horizon, to the south-east, warmer and dimmer the lower it is.
  fn sun_at(deg : Float) : Unit do
    let h = deg *. 0.01745329
    let warm = clampf(Math.sin(h) /. 0.45, 0.0, 1.0)
    let bright = 0.55 +. 0.5 *. warm
    Strata.Render.set_sun(Math.cos(h) *. 0.789, Math.sin(h), Math.cos(h) *. 0.614, bright, bright *. (0.52 +. 0.44 *. warm), bright *. (0.24 +. 0.62 *. warm))
  end


  -- [frames] > 0 is a scripted run: no keyboard or mouse, a fixed time step,
  -- so the same script draws the same frames. [script] is 0 for a held pose,
  -- 1 to hold "forward" (the walk scene), 2 for the soak circuit. [worst] and
  -- [total] gather real frame times, in seconds, from frame 10 on.
  -- [script] 3 empties the chunk whose low corner is [hole] at frame 10, after
  -- the renderer has drawn it: its old quads must then disappear. [script] 4
  -- blasts a crater at voxel [hole] at frame 10 (scene 134).
  -- The soak's circuit: 40 m round the test lake (in voxels: [mid] is its
  -- centre x, radius, centre z), so the lake stays loaded at 0.25 m, where
  -- the stream reaches 80 m.
  pfn soak_x(turn : Float, mid : (Int, Int, Int)) : Float do match mid do (cx, rad, _) -> int_to_float(cx) +. int_to_float(rad) *. Math.cos(turn) end end
  pfn soak_z(turn : Float, mid : (Int, Int, Int)) : Float do match mid do (_, rad, cz) -> int_to_float(cz) +. int_to_float(rad) *. Math.sin(turn) end end

  -- What a run carries that does not change frame to frame: metres a voxel,
  -- the seed, for the soak each atlas lake's box in voxels (x0, y0, z0,
  -- x1, y1, z1) with its water in eighths at the start (-1 where the box was
  -- not wholly loaded), and the meadow's column and ground top (scenes 12 and 21).
  type Ctx = Ctx(Float, Int, List((Int, Int, Int, Int, Int, Int)), List(Int), (Int, Int, Int))

  doc "Each atlas lake's box in voxels of [scale] metres: its centre +- (lake_radius + 4 m) across, from 4 m under its bed to 1 m over its level."
  fn lake_boxes(a : Strata.Atlas.Atlas, scale : Float) : List((Int, Int, Int, Int, Int, Int)) do
    let r = Strata.Atlas.d_lake_radius(Strata.Atlas.def_of(a)) +. 4.0
    List.map(Strata.Atlas.lakes(a), fn l -> match l do
      (x, z, lv) -> (vox(x -. r, scale), vox(Strata.Atlas.height_at(a, x, z) -. 4.0, scale), vox(z -. r, scale), vox(x +. r, scale), vox(lv +. 1.0, scale), vox(z +. r, scale))
    end)
  end
  pfn box_loaded(w : Strata.World.World, b : (Int, Int, Int, Int, Int, Int)) : Bool do
    match b do
      (x0, y0, z0, x1, y1, z1) ->
        let kx0 = Strata.Coord.chunk_of(x0)
        let ky0 = Strata.Coord.chunk_of(y0)
        let kz0 = Strata.Coord.chunk_of(z0)
        let nx = Strata.Coord.chunk_of(x1) - kx0 + 1
        let ny = Strata.Coord.chunk_of(y1) - ky0 + 1
        let nz = Strata.Coord.chunk_of(z1) - kz0 + 1
        List.all(List.range(0, nx * ny * nz), fn i -> Strata.World.is_loaded(w, Strata.Coord.key(kx0 + i % nx, ky0 + (i / nx) % ny, kz0 + i / (nx * ny))))
    end
  end
  doc "The water in each box (eighths of a voxel, Strata.Fluid.amount), -1 for a box not wholly loaded."
  fn lake_amounts(w : Strata.World.World, reg : Strata.Blocks.Registry, bs : List((Int, Int, Int, Int, Int, Int))) : List(Int) do
    List.map(bs, fn b -> if !box_loaded(w, b) do 0 - 1 else match b do (x0, y0, z0, x1, y1, z1) -> Strata.Fluid.amount(w, reg, x0, y0, z0, x1, y1, z1) end end)
  end
  pfn lake_lines(i : Int, starts : List(Int), ends : List(Int)) : Unit do
    match (starts, ends) do
      (Cons(a0, r0), Cons(a1, r1)) ->
        Authority.must(println("soak-lake: " ++ int_to_string(i) ++ " start=" ++ int_to_string(a0) ++ " end=" ++ int_to_string(a1)))
        lake_lines(i + 1, r0, r1)
      _ -> ()
    end
  end

  doc "The fluid the viewer runs at settings g: lake water flows; sea water never runs out and, below the sea's top (settings g's sea, in voxels at [scale]), does not rise."
  fn new_fluid(reg : Strata.Blocks.Registry, g : Gp, scale : Float) : Strata.Fluid.Fluid do
    Strata.Fluid.with_limits(Strata.Fluid.with_sea_top(Strata.Fluid.new(reg, Cons((lake_base(), Strata.Fluid.flowing()), Cons((5, Strata.Fluid.sea()), Nil))), sea_v(g, scale)), Authority.must(Env.get_int("STRATA_FLUID_CAP", 4096)), Authority.must(Env.get_int("STRATA_FLUID_REACH", 16)), 4)
  end

  -- ── Regenerating ─────────────────────────────────────────────────────────
  -- The R key (or STRATA_REGEN=1 at frame 30) rereads the settings, makes
  -- the atlas they define (from the cache when it is there), the trees and
  -- ruins, and a new generator; the fluid step in flight is finished and the
  -- fluid is then started afresh (water already moving is left as it lies,
  -- and nothing wakes it), and the stream drops every chunk nobody edited
  -- and makes it again from the new generator.

  -- (Named functions, not lambdas: on March main a lambda that prints or reads a file is charged to no module and fails the capability check, GAPS S35.)
  pfn first_there(ps : List(String)) : Option(String) do
    match ps do
      Nil -> None
      Cons(p, t) -> if Authority.must(File.exists(p)) do Some(p) else first_there(t) end
    end
  end
  pfn say_lines(ls : List(String)) : Unit do
    match ls do
      Nil -> ()
      Cons(l, t) ->
        let _ = Authority.must(println(l))
        say_lines(t)
    end
  end

  doc "The path of the generator's settings: STRATA_PARAMS, else viewer/assets/island.gen found as the ruins are."
  fn params_path() : String do
    let given = Authority.must(Env.get("STRATA_PARAMS", ""))
    if !String.is_empty(given) do given
    else
      let ds = List.map(ruin_dirs(), fn d -> String.replace(d, "ruins/", "island.gen"))
      match first_there(ds) do
        Some(p) -> p
        None -> "viewer/assets/island.gen"
      end
    end
  end

  doc "Read the settings at [path] and say what they leave to default, set wrongly or could not read."
  fn load_params(path : String) : StrataViewer.Params.Params do
    let p = StrataViewer.Params.read(path)
    let _said = if !Authority.must(File.exists(path)) do Authority.must(println("strata_viewer: could not read " ++ path ++ "; every setting takes its default")) else say_lines(param_report(p)) end
    p
  end

  doc "The island atlas of settings g: from the cache in STRATA_ATLAS_DIR, or built and written there."
  fn load_atlas(g : Gp, seed : Int) : Strata.Atlas.Atlas do
    let dir = Authority.must(Env.get("STRATA_ATLAS_DIR", ".march/atlas"))
    let def = island_def_of(g)
    let cached = Authority.must(File.exists(dir ++ "/" ++ Strata.Atlas.cache_name(def, seed)))
    let t0 = unix_time_ms()
    let a = Strata.Atlas.load_or_build(dir, def, seed)
    Authority.must(println("strata_viewer: atlas " ++ int_to_string(Strata.Atlas.n(a)) ++ " x " ++ int_to_string(Strata.Atlas.n(a)) ++ (if cached do " read from the cache" else " built and cached" end) ++ " in " ++ int_to_string(unix_time_ms() - t0) ++ " ms"))
    a
  end

  -- scene 134's crater: a blast at [hole], on the ruin
  pfn crater(m : Sim, reg : Strata.Blocks.Registry, seed : Int, hole : (Int, Int, Int)) : Sim do
    match hole do (x, y, z) -> blast_at(m, reg, seed, x, y, z) end
  end

  -- a scripted run ([now]) waits for the stream to settle, so its frame count still names the same picture
  pfn regenerate(m : Sim, job : Option(Strata.Fluid.Job), reg : Strata.Blocks.Registry, seed : Int, scale : Float, now : Bool) : Sim do
    let t0 = unix_time_ms()
    let s1 = match job do
        Some(j) -> match Strata.Fluid.finish(j, sim_fluid(m), sim_stream(m)) do (_, sf) -> sf end
        None -> sim_stream(m)
      end
    let g = gp_of(load_params(params_path()))
    let a = load_atlas(g, seed)
    let d = decor_of(g, scale, seed)
    let s2a = Strata.Stream.regenerate(s1, island_gen(a, d, scale))
    let kept = Strata.Stream.loaded_count(s2a)
    let s2 = if now do Strata.Stream.run_until_settled(s2a, 1000000) else s2a end
    Authority.must(println("strata_viewer: regenerated in " ++ int_to_string(unix_time_ms() - t0) ++ " ms; " ++ int_to_string(kept) ++ " edited chunks kept"))
    Sim(s2, new_fluid(reg, g, scale), sim_phys(m))
  end

  pfn frame_loop(s : Strata.Stream.Stream, fl : Strata.Fluid.Fluid, job : Option(Strata.Fluid.Job), sl : Strata.Render.Render, reg : Strata.Blocks.Registry, cx : Ctx, cam : Cam, rig : PhysRig, frame : Int, frames : Int, script : Int, hole : (Int, Int, Int), tl : (Int, Int, Int, Int, Int, Int, Int), worst : Float, total : Float, fworst : Float, t_prev : Float, t_mark : Float, vp : NativeF32Arr, snd : Strata.Sound.Sound, aworst : Float, cr : StrataViewer.Figures.Crowd, mt : StrataViewer.Match.MtMatch, falls : Strata.Falls.FlFalls) : Unit do
    Strata.Ffi.Vk.poll()
    if Strata.Ffi.Vk.should_close() || Strata.Ffi.Vk.key(256) || (frames > 0 && frame >= frames) || (frames > 0 && StrataViewer.Match.won(mt) && Authority.must(Env.get_int("STRATA_COMBAT_HOLD", 0)) == 0) do
      match Strata.Render.light_pages() do (pu, pn, pr) -> Authority.must(println("strata_viewer: light pages " ++ int_to_string(pu) ++ " of " ++ int_to_string(pn) ++ " in use (" ++ int_to_string(pn / 32) ++ " MB), " ++ int_to_string(pr) ++ " chunks found none")) end
      Authority.must(println("strata_viewer: done after " ++ int_to_string(frame) ++ " frames; uploads refused " ++ int_to_string(Strata.Ffi.Vk.refused()) ++ ", still waiting " ++ int_to_string(Strata.Render.waiting(sl)) ++ "; rebuilds " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(6))) ++ "; draw calls " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(2)))))
      if Strata.Render.ui_dropped() > 0 do Authority.must(println("ui: dropped " ++ int_to_string(Strata.Render.ui_dropped()) ++ " quads")) else () end
      if StrataViewer.Match.is_on(mt) do Authority.must(println(StrataViewer.Match.report(mt, Strata.Stream.world(s)))) else () end
      if Strata.Falls.count(falls) > 0 || Authority.must(Env.get_int("STRATA_FALLS", 0)) == 1 do Authority.must(println("strata_viewer: " ++ int_to_string(Strata.Falls.count(falls)) ++ " river drops known")) else () end
      if script == 2 do
        Authority.must(println("soak: frames=" ++ int_to_string(frame) ++ " worst_ms=" ++ ms2(worst *. 1000.0) ++ " mean_ms=" ++ ms2(total *. 1000.0 /. int_to_float(if frame > 10 do frame - 10 else 1 end)) ++ " refused=" ++ int_to_string(Strata.Ffi.Vk.refused()) ++ " waiting=" ++ int_to_string(Strata.Render.waiting(sl)) ++ " slots=" ++ int_to_string(Strata.Render.used(sl)) ++ " live_quads=" ++ int_to_string(Strata.Ffi.Vk.live_quads()) ++ " leaked=" ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(7))) ++ " loaded=" ++ int_to_string(Strata.Stream.loaded_count(s)) ++ " levels=" ++ int_to_string(Strata.Stream.top_level(s)) ++ " retained=" ++ int_to_string(Strata.Render.retained(sl)) ++ " fluid_worst_ms=" ++ ms2(fworst) ++ " fluid_active=" ++ int_to_string(Strata.Fluid.active_count(fl)) ++ " fluid_waiting=" ++ int_to_string(Strata.Fluid.waiting_count(fl)) ++ " ui_dropped=" ++ int_to_string(Strata.Render.ui_dropped()) ++ " text_waiting=" ++ int_to_string(Strata.Text.waited_last_frame()) ++ " atlas_bytes=" ++ int_to_string(Strata.Text.atlas_bytes()) ++ audio_summary(s, reg, cam, aworst)))
        match cx do Ctx(_, _, bs, starts, _) -> lake_lines(0, starts, lake_amounts(Strata.Stream.world(s), reg, bs)) end
      else () end
      Strata.Stream.stop(s)
      Strata.Ffi.Audio.close()
    else
      match cam do
        Cam(x_c, y_c, z_c, yaw, pitch_c, kx0, ky0, kz0, lb0, rb0, fly0, vy0, ground0, f0, sun0, mode0, l0, keys0, stride0, slot0, r0) ->
          let scale = match cx do Ctx(sc, _, _, _, _) -> sc end
          -- a match sets the player down (at its start and after each death), and holds it lying, looking up, while it is dead
          let (placed, px_m, py_m, pz_m) = StrataViewer.Match.place(mt)
          let x = if placed do px_m else x_c end
          let y = if placed do py_m else y_c end
          let z = if placed do pz_m else z_c end
          let down = StrataViewer.Match.player_down(mt) > 0.0
          let pitch = if placed do -0.1 else if down do 1.2 else pitch_c end end
          let (scripted_view, yaw_m, pitch_m) = StrataViewer.Match.view(mt)
          let now = Strata.Ffi.Vk.time()
          let scripted = frames > 0
          let dt = if scripted do 0.016667 else clampf(now -. t_prev, 0.0, 0.1) end
          let live = if scripted do 0.0 else 1.0 end
          let yaw_in = if script == 2 do int_to_float(frame) *. 0.004 +. 3.14159265 else yaw end
          -- a scripted scene of the match sets the camera
          let cam_m = StrataViewer.Match.eye(mt)
          let yaw2 = if StrataViewer.Match.staged(mt) do (match cam_m do (_, _, _, a, _) -> a end) else if scripted_view do yaw_m else yaw_in +. live *. (Strata.Ffi.Vk.mouse_dx() *. 0.0025 +. axis(Strata.Ffi.Vk.key(262), Strata.Ffi.Vk.key(263)) *. dt *. 1.6) end end
          let pitch2 = if StrataViewer.Match.staged(mt) do (match cam_m do (_, _, _, _, a) -> a end) else if scripted_view do pitch_m else clampf(pitch -. live *. (Strata.Ffi.Vk.mouse_dy() *. 0.0025 -. axis(Strata.Ffi.Vk.key(265), Strata.Ffi.Vk.key(264)) *. dt *. 1.2), -1.5, 1.5) end end
          let fx = Math.sin(yaw2) *. Math.cos(pitch2)
          let fy = Math.sin(pitch2)
          let fz = 0.0 -. Math.cos(yaw2) *. Math.cos(pitch2)
          -- F switches between walking and flying, once per press
          let fkey = !scripted && Strata.Ffi.Vk.key(70)
          let fly = if StrataViewer.Match.is_on(mt) do false else if fkey && !f0 do !fly0 else fly0 end end
          -- [ and ] lower and raise the sun
          let sun_keys = clampf(sun0 +. live *. axis(Strata.Ffi.Vk.key(93), Strata.Ffi.Vk.key(91)) *. dt *. 20.0, -5.0, 90.0)
          -- a scripted run may move the sun once, to check that the light follows it
          let sun = if scripted && frame == Authority.must(Env.get_int("STRATA_SUN2_AT", -1)) do int_to_float(Authority.must(Env.get_int("STRATA_SUN2", 55))) else sun_keys end
          -- L steps through the light modes, once per press
          let lkey = !scripted && Strata.Ffi.Vk.key(76)
          let mode = if lkey && !l0 do (mode0 + 1) % 5 else mode0 end
          let go = if down do 0.0 else if script == 1 do 1.0 else live *. axis(Strata.Ffi.Vk.key(87), Strata.Ffi.Vk.key(83)) end end
          let strafe = if down do 0.0 else live *. axis(Strata.Ffi.Vk.key(68), Strata.Ffi.Vk.key(65)) end
          let space = !scripted && !down && Strata.Ffi.Vk.key(32)
          let w0 = Strata.Stream.world(s)
          let (ph_r, pjob, me, ck0, sc, tz) = match rig do PhysRig(a, b, c, d, e, f) -> (a, b, c, d, e, f) end
          -- set down by a match: the walker's driven body goes there too
          let ph = if placed do Strata.Physics.place_driven(ph_r, me, x, y -. 0.7, z) else ph_r end
          -- flying moves along the view at 40 m/s; walking moves on the ground at 5 m/s under gravity, as physics' driven body
          let (ph1, moved) = if fly do
              let rise = live *. axis(space, Strata.Ffi.Vk.key(340))
              let b = StrataViewer.Walker.body_with(x +. (fx *. go +. Math.cos(yaw2) *. strafe) *. 40.0 *. dt, y +. (fy *. go +. rise) *. 40.0 *. dt, z +. (fz *. go +. Math.sin(yaw2) *. strafe) *. 40.0 *. dt, 0.0, false)
              (Strata.Physics.place_driven(ph, me, StrataViewer.Walker.eye_x(b), StrataViewer.Walker.eye_y(b) -. 0.7, StrataViewer.Walker.eye_z(b)), b)
            else
              -- in a match the walk takes the match's word: sprinting, blocking and a chill change its speed; a hit's push and a dodge add to it; a dodge hops
              let (pace, push_x, push_z, hop) = StrataViewer.Match.move(mt)
              let mx = (Math.sin(yaw2) *. go +. Math.cos(yaw2) *. strafe) *. 5.0 *. pace +. push_x
              let mz = (Math.sin(yaw2) *. strafe -. Math.cos(yaw2) *. go) *. 5.0 *. pace +. push_z
              (if sc == 1.0 do StrataViewer.Walker.drive_in(ph, w0, fl, me, StrataViewer.Walker.body_with(x, y, z, vy0, ground0), mx, mz, space || hop, dt)
               else StrataViewer.Walker.drive(ph, w0, me, StrataViewer.Walker.body_with(x, y, z, vy0, ground0), mx, mz, space || hop, dt) end)
            end
          -- the soak circuit: a 150 m circle at about 36 m/s, looking along it and down
          let turn = int_to_float(frame) *. 0.004
          let x2 = if StrataViewer.Match.staged(mt) do (match cam_m do (v, _, _, _, _) -> v end) else if script == 2 do soak_x(turn, hole) else StrataViewer.Walker.eye_x(moved) end end
          let y2 = if StrataViewer.Match.staged(mt) do (match cam_m do (_, v, _, _, _) -> v end) else if script == 2 do y else StrataViewer.Walker.eye_y(moved) end end
          let z2 = if StrataViewer.Match.staged(mt) do (match cam_m do (_, _, v, _, _) -> v end) else if script == 2 do soak_z(turn, hole) else StrataViewer.Walker.eye_z(moved) end end
          -- the stream: refocus when the camera enters another chunk, then one tick
          let t_march = Strata.Ffi.Vk.time()
          -- STRATA_SLOW=1 names every slow frame and where its time went, in any run
          let slow_log = Authority.must(Env.get_int("STRATA_SLOW", 0)) == 1
          let kx = Strata.Coord.chunk_of(float_to_int(Math.floor(x2 /. sc)))
          let ky = Strata.Coord.chunk_of(float_to_int(Math.floor(y2 /. sc)))
          let kz = Strata.Coord.chunk_of(float_to_int(Math.floor(z2 /. sc)))
          -- the stream's focus is in metres; the camera is in voxels on the island (metres in the 10 cm world, where scale is 1)
          let s1a = if kx != kx0 || ky != ky0 || kz != kz0 do Strata.Stream.set_focus(s, Cons((x2 *. scale, y2 *. scale, z2 *. scale), Nil)) else s end
          let seed = match cx do Ctx(_, sd, _, _, _) -> sd end
          -- R rereads the settings and regenerates, once per press; STRATA_REGEN=1 does it at frame 30 (not in the 10 cm world)
          let rkey = !scripted && Strata.Ffi.Vk.key(82)
          let regen = sc == 1.0 && ((rkey && !r0) || (scripted && frame == 30 && Authority.must(Env.get_int("STRATA_REGEN", 0)) == 1))
          let m0 = if regen do regenerate(Sim(s1a, fl, ph1), job, reg, seed, scale, scripted) else Sim(s1a, fl, ph1) end
          let job0 = if regen do None else job end
          let m1 = if script == 3 && frame == 10 do
              match hole do
                (hx, hy, hz) -> edit(m0, Strata.Edit.fill_box(Strata.Stream.world(sim_stream(m0)), hx, hy, hz, hx + 31, hy + 31, hz + 31, 0))
              end
            else m0 end
          let (mx, mz, gy) = match cx do Ctx(_, _, _, _, mw) -> mw end
          let m2 = if scripted && frame == Authority.must(Env.get_int("STRATA_SLAB_AT", -1)) do edit(m1, slab_edit(Strata.Stream.world(sim_stream(m1)), mx, mz, gy, 1))
            else if scripted && frame == Authority.must(Env.get_int("STRATA_SLAB_OFF", -1)) do edit(m1, slab_edit(Strata.Stream.world(sim_stream(m1)), mx, mz, gy, 0)) else m1 end end
          let m2s = if scripted && frame == Authority.must(Env.get_int("STRATA_SPLASH", -1)) do
              let o1 = Strata.Edit.fill_box(Strata.Stream.world(sim_stream(m2)), mx - 3, gy + 16, mz - 1, mx - 2, gy + 17, mz, lake_base() + 7)
              let m2a = edit(m2, o1)
              edit(m2a, Strata.Edit.set_block(Strata.Stream.world(sim_stream(m2a)), mx + 3, gy + 8, mz, lake_base() + 7))
            else m2 end
          let m3 = if scripted && frame == Authority.must(Env.get_int("STRATA_BREACH", -1)) do breach(m2s, tl) else if scripted && frame == Authority.must(Env.get_int("STRATA_DRAIN", -1)) do drain_floor(m2s, tl) else m2s end end
          -- a scripted run holds the slot STRATA_SLOT names (0 to 8), for pictures of each weapon
          let slot = if scripted do (if Authority.must(Env.get_int("STRATA_SLOT", -1)) >= 0 do Authority.must(Env.get_int("STRATA_SLOT", -1)) else slot0 end) else slot_key(0, slot0) end
          let lb = !scripted && Strata.Ffi.Vk.mouse_button(0)
          let rb = !scripted && Strata.Ffi.Vk.mouse_button(1)
          let dig_now = (lb && !lb0) || (frame == 10 && Authority.must(Env.get_int("STRATA_DIG", 0)) == 1) || (script == 2 && frame % 100 == 50)
          let build_now = rb && !rb0
          let m3c = if scripted && frame == 10 && script == 4 do crater(m3, reg, seed, hole) else m3 end
          -- the match's frame: its fighters decide, move and are placed; what it burns comes back as one edit
          let (mt2, m3m) = match_frame(mt, m3c, { mi_x: x2, mi_y: y2, mi_z: z2, mi_yaw: Math.atan2(fx, fz), mi_pitch: Math.asin(clampf(fy, -1.0, 1.0)), mi_shoot: lb, mi_slot: slot, mi_table: !scripted && Strata.Ffi.Vk.key(258), mi_again: !scripted && Strata.Ffi.Vk.key(257), mi_block: rb, mi_sprint: !scripted && Strata.Ffi.Vk.key(340), mi_left: !scripted && Strata.Ffi.Vk.key(81), mi_right: !scripted && Strata.Ffi.Vk.key(69), mi_moving: go != 0.0 || strafe != 0.0 }, dt)
          -- in a match a dig or a build is one block, with the match's own hotbar
          let m4a = if StrataViewer.Match.is_on(mt2) do match_edit(m3m, x2, y2, z2, fx, fy, fz, dig_now, build_now, StrataViewer.Match.block_for(slot))
            else act(m3m, reg, seed, scale, x2, y2, z2, fx, fy, fz, dig_now, build_now, StrataViewer.Hud.slot_block(slot)) end
          -- sound: the camera is the listener; a carve or a build strikes where it lands
          let sndl = Strata.Sound.listener(snd, x2, y2, z2, fx, fy, fz, 0.0, 1.0, 0.0)
          let snd0 = if dig_now do strike_at(sndl, w0, reg, x2, y2, z2, fx, fy, fz, 0.55, 0.85) else if build_now do strike_at(sndl, w0, reg, x2, y2, z2, fx, fy, fz, 0.95, 0.3) else sndl end end
          -- footsteps every half metre walked on the ground, from the block underfoot; a landing, by how hard
          let walked = !fly && StrataViewer.Walker.grounded(moved)
          let dx_w = StrataViewer.Walker.eye_x(moved) -. x
          let dz_w = StrataViewer.Walker.eye_z(moved) -. z
          let stride1 = if walked do stride0 +. Math.sqrt(dx_w *. dx_w +. dz_w *. dz_w) else 0.0 end
          let step_now = stride1 >= 0.5
          let stride = if step_now do stride1 -. 0.5 else stride1 end
          let feet_y = y2 -. 1.6
          let under = Strata.World.get_block(w0, float_to_int(Math.floor(x2)), float_to_int(Math.floor(feet_y -. 0.1)), float_to_int(Math.floor(z2)))
          let landed = !fly && !ground0 && StrataViewer.Walker.grounded(moved) && vy0 < -3.0
          let snd_f = if step_now do footstep(snd0, under, x2, feet_y, z2, 0.45)
            else if landed do footstep(snd0, under, x2, feet_y, z2, clampf((0.0 -. vy0) /. 15.0, 0.4, 1.0)) else snd0 end end
          -- N plays the next recording from viewer/sounds/ 5 m ahead; H switches headphones and speakers
          let nkey = !scripted && Strata.Ffi.Vk.key(78)
          let hkey = !scripted && Strata.Ffi.Vk.key(72)
          let hp_was = int_and(keys0, 4) != 0
          let hp_now = if hkey && int_and(keys0, 2) == 0 do !hp_was else hp_was end
          -- 9 and 0 lower and raise the main level by a tenth (held in keys' bits 8-11, as tenths below full)
          let k9 = !scripted && Strata.Ffi.Vk.key(57)
          let k0 = !scripted && Strata.Ffi.Vk.key(48)
          let tenths0 = level_tenths(keys0)
          let tenths1 = if k9 && int_and(keys0, 8) == 0 do tenths0 - 1 else if k0 && int_and(keys0, 16) == 0 do tenths0 + 1 else tenths0 end end
          let tenths = if tenths1 < 0 do 0 else if tenths1 > 10 do 10 else tenths1 end end
          -- P saves a picture of the next frame, once per press
          let pkey = !scripted && Strata.Ffi.Vk.key(80)
          if pkey && int_and(keys0, 32) == 0 do take_picture(frame) else () end
          let keys = (if pkey do 32 else 0 end) + (if nkey do 1 else 0 end) + (if hkey do 2 else 0 end) + (if hp_now do 4 else 0 end) + (if k9 do 8 else 0 end) + (if k0 do 16 else 0 end) + (10 - tenths) * 256
          let snd_n = if nkey && int_and(keys0, 1) == 0 do place_recording(snd_f, frame, x2 +. fx *. 5.0, y2 +. fy *. 5.0, z2 +. fz *. 5.0) else snd_f end
          let snd_lv = if tenths != tenths0 do
              Authority.must(println("strata_viewer: main level " ++ ms2(int_to_float(tenths) /. 10.0)))
              Strata.Sound.set_master(snd_n, int_to_float(tenths) /. 10.0)
            else snd_n end
          let snd1 = if hkey && int_and(keys0, 2) == 0 do
              let hp = int_and(keys, 4) != 0
              Authority.must(println("strata_viewer: sound on " ++ (if hp do "headphones" else "speakers" end)))
              Strata.Sound.set_output(snd_lv, hp)
            else snd_lv end
          -- C drops a crate 6 m ahead and a little up, once per press
          let ckey = !scripted && Strata.Ffi.Vk.key(67)
          let drop = (ckey && !ck0) || (scripted && frame == Authority.must(Env.get_int("STRATA_CRATE", -1)))
          let m4c = if !drop do m4a
            else match m4a do Sim(ms, mf, mp) -> Sim(ms, mf, add_crate(mp, x2 +. Math.sin(yaw2) *. 6.0, y2 +. 2.0, z2 -. Math.cos(yaw2) *. 6.0, sc)) end end
          -- physics on the clock: the step begun last frame is finished, and the next begun; at most two steps a frame
          let tphys = if scripted do int_to_float(frame) /. 60.0 else now -. tz end
          let focus = Cons((x2, y2, z2), Nil)
          -- what physics did to the world (loose terrain, snapped rubble) wakes the water, as any edit does
          let (pa, sa, fa) = match pjob do
              Some(j) ->
                match Strata.Physics.finish_world(j, sim_phys(m4c), Strata.Stream.world(sim_stream(m4c))) do
                  (p5, o5) -> (p5, Strata.Stream.apply(sim_stream(m4c), o5), Strata.Fluid.wake(sim_fluid(m4c), Strata.Edit.world(o5), o5))
                end
              None -> (sim_phys(m4c), sim_stream(m4c), sim_fluid(m4c))
            end
          let owed = Strata.Physics.due(pa, tphys)
          let (pb, sb) = if owed >= 2 do Strata.Physics.step(pa, sa, focus) else (pa, sa) end
          let (pc, pjob2) = if owed >= 1 do
              match Strata.Physics.begin(pb, Strata.Stream.world(sb), focus) do (p4, j4) -> (p4, Some(j4)) end
            else (pb, None) end
          let m4 = Sim(sb, fa, pc)
          -- the fluid: STRATA_FLUID_HZ steps a second, 30 by default (a scripted run: one every 60 / hz frames)
          let t_fluid = Strata.Ffi.Vk.time()
          let hz = Authority.must(Env.get_int("STRATA_FLUID_HZ", 30))
          let due = Authority.must(Env.get_int("STRATA_FLUID", 1)) != 0 && hz > 0 && (if scripted do frame % (if hz >= 60 do 1 else 60 / hz end) == 0 else Math.floor(now *. int_to_float(hz)) != Math.floor(t_prev *. int_to_float(hz)) end)
          -- a step is worked out on a worker: the one begun last time is finished here, then the next begins
          let m5 = if !due do m4
            else if Authority.must(Env.get_int("STRATA_FLUID_SYNC", 0)) == 1 do
              match Strata.Fluid.step(sim_fluid(m4), sim_stream(m4), Cons((x2, y2, z2), Nil)) do (f2, sf) -> Sim(sf, f2, sim_phys(m4)) end
            else
              match job0 do
                Some(j) -> match Strata.Fluid.finish(j, sim_fluid(m4), sim_stream(m4)) do (f2, sf) -> Sim(sf, f2, sim_phys(m4)) end
                None -> m4
              end
            end end
          let begun = if due && Authority.must(Env.get_int("STRATA_FLUID_SYNC", 0)) != 1 do
              match Strata.Fluid.begin(sim_fluid(m5), Strata.Stream.world(sim_stream(m5)), Cons((x2, y2, z2), Nil)) do
                (f3, j2) -> (f3, Some(j2))
              end
            else (sim_fluid(m5), job0) end
          -- spray for what the step that just ended did, and a fountain if a timing run asks for one
          let _sprayed = if due && Authority.must(Env.get_int("STRATA_SPRAY", 1)) != 0 do spray_events(Strata.Fluid.events(sim_fluid(m5)), 0) else 0 end
          let fountain = Authority.must(Env.get_int("STRATA_FOUNTAIN", 0))
          if fountain > 0 && Strata.Render.spray(x2 +. fx *. 30.0, y2 +. fy *. 30.0 -. 4.0, z2 +. fz *. 30.0, 0.0, 9.0, 0.0, fountain, 4.0, 3.0, 13) do () else () end
          let fl2 = match begun do (f3, _) -> f3 end
          let job2 = match begun do (_, j3) -> j3 end
          let fluid_ms = (Strata.Ffi.Vk.time() -. t_fluid) *. 1000.0
          if due && scripted && frame % 240 == 0 && Strata.Fluid.active_count(fl2) > 0 do Authority.must(println("  fluid step at frame " ++ int_to_string(frame) ++ ": " ++ ms2(fluid_ms) ++ " ms on the main thread for " ++ int_to_string(Strata.Fluid.active_count(fl2)) ++ " active cells")) else () end
          let t_tick = Strata.Ffi.Vk.time()
          -- The stream waits for any task still running two ticks after it began (March has no way to ask whether a task is done: GAPS S12), and at 120 frames
          -- a second two ticks are 16 ms, less than a hard chunk takes. So the stream ticks at most once in each STRATA_TICK_MS of the clock (16 when playing;
          -- 0, every frame, in scripted runs, which stay as they were): its tasks then have 32 ms and more, and a frame that does not tick costs nothing.
          let tick_gap = int_to_float(Authority.must(Env.get_int("STRATA_TICK_MS", if scripted do 0 else 16 end))) /. 1000.0
          let ticks_now = tick_gap <= 0.0 || Math.floor(now /. tick_gap) != Math.floor(t_prev /. tick_gap)
          let s2 = if ticks_now do Strata.Stream.tick(sim_stream(m5)) else sim_stream(m5) end
          let tick_ms = (Strata.Ffi.Vk.time() -. t_tick) *. 1000.0
          match Strata.Render.sync(sl, s2) do
            (sl2, s3) ->
              let sync_ms = (Strata.Ffi.Vk.time() -. t_tick) *. 1000.0 -. tick_ms
              let (sl3, pd) = Strata.Render.bodies(sl2, sim_phys(m5), tphys -. 1.0 /. 60.0)
              let bodies_ms = (Strata.Ffi.Vk.time() -. t_tick) *. 1000.0 -. tick_ms -. sync_ms
              let rig2 = PhysRig(pd, pjob2, me, ckey, sc, tz)
              let march_ms = (Strata.Ffi.Vk.time() -. t_march) *. 1000.0
              let aspect = int_to_float(Strata.Ffi.Vk.fb_w()) /. int_to_float(if Strata.Ffi.Vk.fb_h() < 1 do 1 else Strata.Ffi.Vk.fb_h() end)
              let view = M4.look_at(V3.new(x2, y2, z2), V3.new(x2 +. fx, y2 +. fy, z2 +. fz), V3.new(0.0, 1.0, 0.0))
              let vp2 = M4.mul_into_f32(M4.perspective(1.15, aspect, 0.1, view_far(Strata.Stream.top_level(s3), sc)), view, vp)
              Strata.Ffi.Vk.set_camera(vp2)
              Strata.Ffi.Vk.set_eye(x2, y2, z2, sc)
              -- under water the world is seen through it
              let top = Strata.Fluid.surface(fl, Strata.Stream.world(s3), float_to_int(Math.floor(x2)), float_to_int(Math.floor(y2)), float_to_int(Math.floor(z2)))
              if sc == 1.0 && top > y2 do Strata.Render.set_underwater(top, 0.035, 0.17, 0.30, 0.055) else Strata.Render.clear_underwater() end
              -- the display, built afresh each frame
              if ui_on(scripted) do
                let shown = Authority.must(Env.get_int("STRATA_UI_SHOW", 0))
                let t_ui = Strata.Ffi.Vk.time()
                let u0 = Strata.Render.ui_begin(ui_scale())
                let fps = if scripted do 60.0 else Math.round(1.0 /. (if now -. t_prev > 0.0005 do now -. t_prev else 0.0005 end)) end
                let readout = (if script == 2 do "frame " ++ int_to_string(frame) ++ "\n" else "" end) ++ int_to_string(float_to_int(fps)) ++ " fps\n" ++ ms2(x2) ++ ", " ++ ms2(y2) ++ ", " ++ ms2(z2) ++ "\nlight mode " ++ int_to_string(mode)
                let u1 = if shown == 1 do StrataViewer.Hud.flood(u0, 0, 20000) else if shown == 2 do StrataViewer.Hud.frames(u0) else if shown == 3 do StrataViewer.Hud.sheet(u0) else if shown == 4 do StrataViewer.Hud.styles(u0) else if shown == 5 do StrataViewer.Hud.busy(u0, ":") else if shown == 6 do StrataViewer.Hud.busy(u0, int_to_string(frame)) else if shown == 7 do StrataViewer.Hud.scripts(u0) else if StrataViewer.Match.is_on(mt2) do StrataViewer.MatchHud.draw(StrataViewer.Hud.build_bar(u0, slot, readout, StrataViewer.MatchHud.icons()), mt2, !scripted && Strata.Ffi.Vk.key(258)) else StrataViewer.Hud.build(u0, slot, readout) end end end end end end end end
                if Strata.Render.draw_ui(u1) do () else () end
                if Authority.must(Env.get_int("STRATA_TEXT_LOG", 0)) == 1 && frame < 12 do Authority.must(println("text: frame " ++ int_to_string(frame) ++ ", " ++ int_to_string(Strata.Text.waiting()) ++ " glyph requests waited, " ++ int_to_string(float_to_int(Strata.Ffi.Text.stat(5))) ++ " us spent drawing glyphs, " ++ int_to_string(float_to_int(Strata.Ffi.Text.stat(0))) ++ " in the atlas")) else () end
                if (shown == 5 || shown == 6) && frame % 60 == 59 do Authority.must(println("ui: " ++ int_to_string(Strata.Ui.quad_count(u1)) ++ " quads built and handed over in " ++ int_to_string(float_to_int((Strata.Ffi.Vk.time() -. t_ui) *. 1000000.0)) ++ " us")) else () end
              else () end
              Strata.Render.set_time(if scripted do int_to_float(frame) /. 60.0 else now end)
              if sun != sun0 do sun_at(sun) else () end
              if mode != mode0 do Strata.Ffi.Vk.set_lighting(mode) else () end
              -- a soak takes no screenshot: reading the image back would be its slowest frame
              if scripted && script != 2 && frame == frames - 3 do Strata.Ffi.Vk.request_shot() else () end
              if scripted && frame == Authority.must(Env.get_int("STRATA_REBUILD_AT", -1)) do Strata.Ffi.Vk.force_rebuild() else () end
              -- the result is used, not dropped: a zero-argument extern bound to an unused name is optimised away (cube_forge GAPS G16)
              let t_audio = Strata.Ffi.Vk.time()
              let snd2 = audio_frame(snd1, Strata.Stream.world(s3), fl2, dt, frame, scripted, now, t_prev)
              let audio_ms = (Strata.Ffi.Vk.time() -. t_audio) *. 1000.0
              let aworst2 = if frame >= 10 && audio_ms > aworst do audio_ms else aworst end
              -- STRATA_STALL=n: hold the main thread 100 ms every n frames, as a hitch would (soak runs)
              let stall = Authority.must(Env.get_int("STRATA_STALL", 0))
              -- nested, not &&: both sides of && are evaluated (GAPS S16 on main), and frame % 0 panics
              if stall > 0 do (if frame % stall == stall - 1 do Strata.Ffi.Audio.debug_stall(100) else () end) else () end
              -- the figures: walkers moved and every figure advanced, then drawn at their last pose
              let cr2 = StrataViewer.Figures.step(cr, Strata.Stream.world(s3), tphys, dt, frame)
              -- spray where the island's rivers drop (Strata.Falls; the rivers are the sea's block, 5, above the sea): on when playing, off in scripted runs unless STRATA_FALLS=1
              let falls2 = if sc == 1.0 && Authority.must(Env.get_int("STRATA_FALLS", if scripted do 0 else 1 end)) == 1 do Strata.Falls.step(falls, Strata.Stream.world(s3), fn id -> id == 5, sea() + 1, sea() + 64, x2, z2, frame, 13) else falls end
              let next = if Strata.Render.draw(1.0) do frame + 1 else frame end
              let spent = now -. t_prev
              -- in a soak, name any frame slower than 25 ms and where its time went
              if (script == 2 || slow_log) && frame >= 10 && (spent > 0.025 || march_ms > (if slow_log do 12.0 else 4.0 end)) do Authority.must(println("  slow frame " ++ int_to_string(frame) ++ ": " ++ ms2(spent *. 1000.0) ++ " ms since the last; this frame's march " ++ ms2(march_ms) ++ " ms (to the stream tick " ++ ms2((t_tick -. t_march) *. 1000.0) ++ ", tick " ++ ms2(tick_ms) ++ ", sync " ++ ms2(sync_ms) ++ ", bodies " ++ ms2(bodies_ms) ++ "), last frame's shim " ++ ms2(Strata.Ffi.Vk.stat(0)) ++ " ms and waiting " ++ ms2(Strata.Ffi.Vk.stat(1)) ++ " ms")) else () end
              let worst2 = if frame >= 10 && spent > worst do spent else worst end
              let fworst2 = if fluid_ms > fworst do fluid_ms else fworst end
              let total2 = if frame >= 10 do total +. spent else total end
              let cam2 = Cam(x2, y2, z2, yaw2, pitch2, kx, ky, kz, lb, rb, fly, StrataViewer.Walker.speed_y(moved), StrataViewer.Walker.grounded(moved), fkey, sun, mode, lkey, keys, stride, slot, rkey)
              if next != frame && frame % 240 == 239 do
                Authority.must(println("  " ++ float_to_string(Math.round(240.0 /. (now -. t_mark))) ++ " fps; march " ++ ms2(march_ms) ++ " ms, shim " ++ ms2(Strata.Ffi.Vk.stat(0)) ++ " ms, waiting " ++ ms2(Strata.Ffi.Vk.stat(1)) ++ " ms, gpu " ++ ms2(Strata.Ffi.Vk.stat(3)) ++ " ms; " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(2))) ++ " draw calls, " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(4))) ++ " see-through chunks ordered in " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(5))) ++ " us, " ++ int_to_string(Strata.Ffi.Vk.drawn_chunks()) ++ " chunks, " ++ int_to_string(Strata.Ffi.Vk.drawn_quads()) ++ " quads; " ++ int_to_string(Strata.Stream.loaded_count(s3)) ++ " chunks loaded"))
                if scripted && script != 2 && (Authority.must(Env.get_int("STRATA_BREACH", -1)) >= 0 || Authority.must(Env.get_int("STRATA_DRAIN", -1)) >= 0) do
                  match tl do
                    (lcx, lcz, lrad, lline, _, lbed, lout) -> Authority.must(println("  lake: frame " ++ int_to_string(frame) ++ ", bed " ++ int_to_string(lbed) ++ ", ground outside " ++ int_to_string(lout) ++ ", " ++ int_to_string(Strata.Fluid.amount(Strata.Stream.world(s3), reg, lcx - lrad - 3, lline - 17, lcz - lrad - 3, lcx + lrad + 3, lline + 1, lcz + lrad + 3) / 8) ++ " voxels of water left in it; radius " ++ int_to_string(lrad) ++ ", water line " ++ int_to_string(lline)))
                  end
                else () end
                if StrataViewer.Figures.walking(cr2) > 0 || Strata.Render.figure_rigs(sl3) > 0 do Authority.must(println("  figures: " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(10))) ++ " parts drawn in " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(11))) ++ " draws; " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(12))) ++ " us preparing them, " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(13))) ++ " us of it the draw list; update " ++ ms2(Strata.Ffi.Anim.timing(0) *. 1000.0) ++ " ms; shadow map " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(15))) ++ " parts in " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(16))) ++ " draws, gpu " ++ ms2(Strata.Ffi.Vk.stat(14)) ++ " ms; traced " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(17))) ++ " figures, " ++ int_to_string(float_to_int(Strata.Ffi.Vk.stat(18))) ++ " parts")) else () end
                if Strata.Fluid.active_count(fl2) + Strata.Fluid.dormant_count(fl2) > 0 do Authority.must(println("  fluid: active " ++ int_to_string(Strata.Fluid.active_count(fl2)) ++ ", waiting " ++ int_to_string(Strata.Fluid.waiting_count(fl2)) ++ ", dormant " ++ int_to_string(Strata.Fluid.dormant_count(fl2)) ++ "; last step " ++ ms2(fluid_ms) ++ " ms")) else () end
                frame_loop(s3, fl2, job2, sl3, reg, cx, cam2, rig2, next, frames, script, hole, tl, worst2, total2, fworst2, now, now, vp2, snd2, aworst2, cr2, mt2, falls2)
              else frame_loop(s3, fl2, job2, sl3, reg, cx, cam2, rig2, next, frames, script, hole, tl, worst2, total2, fworst2, now, t_mark, vp2, snd2, aworst2, cr2, mt2, falls2) end
          end
      end
    end
  end

  -- The window size from STRATA_SIZE=WxH, or 1280 x 800.
  pfn window_size() : (Int, Int) do
    match String.split(Authority.must(Env.get("STRATA_SIZE", "1280x800")), "x") do
      Cons(a, Cons(b, Nil)) ->
        match (String.to_int(a), String.to_int(b)) do
          (Ok(w), Ok(h)) -> if w >= 64 && h >= 64 && w <= 8192 && h <= 8192 do (w, h) else (1280, 800) end
          _ -> (1280, 800)
        end
      _ -> (1280, 800)
    end
  end

  -- Fixed camera poses for scripted runs and golden images: (x, y, z, yaw, pitch).
  --   1 overview      high over the hills, the lake ahead
  --   2 shore         low over the sea, along the shore
  --   3 forest floor  among the trees of the most wooded chunk near the origin, looking level
  --   4 dug out       the overview, with one whole chunk of ground removed ahead
  --   5 bad ids       on the meadow, a wall of blocks whose texture does not exist and one block id nobody registered
  --   6 glass front   high in the air: a red glass wall with a water wall behind it, in another chunk
  --   7 glass back    the same two walls from the other side: the water wall is now the near one
  --   8 underwater    just under the sea's surface, looking up and out through it at the shore
  --   9 meadow        low over the meadow's grass, across the tall grass
  --   10 post         close to a lantern post stood on the meadow
  --   11 walk         standing on the ground at the origin; a scripted run walks forward
  --   12 slab         a stone slab hung over the meadow, its shadow on the grass
  --   13, 14          the sea, across it toward the sun (13) and steeply down at it (14)
  --   15 high ground  the island's highest ground with a patch of ice on it, from back and above, toward the sun
  --   16 cave mouth   a pit and a tunnel dug into the meadow
  --   17 lantern      the meadow's post with a stone block beside it, at dusk
  --   20, 21          water on a stone tray over the meadow: eighths (20), a splash (21)
  --   22 river mouth  the island's widest river where it meets the sea, from out at sea
  --   23 lake bank    the test lake from its bank opposite the outlet, looking down across it to the river leaving it
  --   26 forest border standing on a chunk border, looking along it through the trees either side
  --   27 ruin slope   the ruin on the steepest site, from down its slope
  --   28 crater       the same ruin close up; a scripted run blasts a crater in it at frame 10
  --   32..35 trees    an oak, a birch, a pine and a willow close up
  --   0  (the default) the same spot, for playing: walking, with the keyboard and mouse
  -- Scenes 18, 19 and 23 use the lake scene_lake picks (the island's deepest
  -- lake near the origin); 2, 8, 13 and 14 the sea off the coast toward the sun (`coast`). Scenes 5, 9, 10, 12, 16, 17, 20
  -- and 21 stand on the meadow (`meadow`): their edits are built on its ground.
  -- Any other number is the overview.

  -- The meadow, (144, 224) at seed 7: the first column, on a grid 16 m apart
  -- walked outward from the origin, of open grass between 46 and 70 m, off
  -- lakes, rivers and sites, whose ground 8 m round it lies within 2 m of its
  -- own, whose ground top 4 m round it lies within 1 m of its own, and with
  -- no tree's base within 10 m: somewhere flat and open to build the lighting
  -- and water scenes on. Found by a scripted search (a minute and a half of
  -- start-up if done every run), so it is fixed here, as the tree close-ups are.
  pfn meadow() : (Int, Int) do (144, 224) end

  -- The coast: walking out from the origin along direction d (see dir_x) 4 m at a time, the first
  -- column whose ground is 4 m or more under the sea. The scenes that look at water stand there,
  -- on the side of the island toward the sun (direction 6).
  pfn coast(land : Land, seed : Int, d : Int, t : Int) : (Int, Int) do
    if t >= 300 do (at_x(0, d, 4 * t), at_z(0, d, 4 * t))
    else
      let x = at_x(0, d, 4 * t)
      let z = at_z(0, d, 4 * t)
      if int_to_float(land_height(land, x, z, seed)) <= gen_sea(gp_default()) -. 4.0 do (x, z) else coast(land, seed, d, t + 1) end
    end
  end

  -- The forest, (144, 80) at seed 7: the middle of the chunk column, of the
  -- 12 x 12 about the origin, reached by the most trees standing between 46
  -- and 90 m (a scripted search, fixed here as the meadow is).
  pfn forest() : (Int, Int) do (144, 80) end

  -- Scene 20's water: three rows of cells at (x0 + i % 10, y, z0 + i / 10) running one eighth to full along x.
  pfn stairs(x0 : Int, z0 : Int, y : Int, i : Int, acc : List((Int, Int, Int, Int))) : List((Int, Int, Int, Int)) do
    if i >= 30 do acc
    else stairs(x0, z0, y, i + 1, Cons((x0 + i % 10, y, z0 + i / 10, lake_base() + (if i % 10 > 7 do 7 else i % 10 end)), acc)) end
  end

  -- Scene 12's stone slab, 7 x 7 and 5 m over the meadow's ground: put there ([id] 1) or taken away (0).
  pfn slab_edit(w : Strata.World.World, mx : Int, mz : Int, gy : Int, id : Int) : Strata.Edit.Outcome do
    Strata.Edit.fill_box(w, mx - 3, gy + 5, mz - 3, mx + 3, gy + 5, mz + 3, id)
  end

  -- The highest atlas ground on a walk of the 1200 m about the origin 8 m apart: snow country.
  pfn peak_go(a : Strata.Atlas.Atlas, i : Int, bx : Int, bz : Int, bh : Float) : (Int, Int, Float) do
    if i >= 22500 do (bx, bz, bh)
    else
      let x = (i % 150 - 75) * 8
      let z = (i / 150 - 75) * 8
      let h = Strata.Atlas.height_at(a, int_to_float(x), int_to_float(z))
      if h > bh do peak_go(a, i + 1, x, z, h) else peak_go(a, i + 1, bx, bz, bh) end
    end
  end

  -- The mouth of the island's widest river where it meets the sea: the
  -- last point of the polyline that ends in the sea at the greatest width,
  -- with the point four back for its direction.
  pfn mouth_go(a : Strata.Atlas.Atlas, rs : List(List((Float, Float, Float))), best : Option((Float, Float, Float, Float, Float))) : Option((Float, Float, Float, Float, Float)) do
    match rs do
      Nil -> best
      Cons(r, rest) ->
        let k = List.length(r)
        if k < 6 do mouth_go(a, rest, best)
        else
          match (List.nth_opt(r, k - 1), List.nth_opt(r, k - 5)) do
            (Some((mx, mz, w)), Some((px, pz, _))) ->
              let wider = match best do
                  None -> true
                  Some((_, _, bw, _, _)) -> w > bw
                end
              if Strata.Atlas.height_at(a, mx, mz) <= 40.0 && wider do mouth_go(a, rest, Some((mx, mz, w, px, pz))) else mouth_go(a, rest, best) end
            _ -> mouth_go(a, rest, best)
          end
        end
    end
  end

  -- A camera [dist] m from the column (tx, tz) along direction d (see dir_x),
  -- [up] m over the ground there, looking back at the ground of the column.
  pfn facing(land : Land, seed : Int, tx : Int, tz : Int, dist : Int, up : Int, d : Int) : (Float, Float, Float, Float, Float) do
    let cx = at_x(tx, d, dist)
    let cz = at_z(tz, d, dist)
    let ty = int_to_float(land_height(land, tx, tz, seed))
    let ey = int_to_float(land_height(land, cx, cz, seed) + up)
    (int_to_float(cx) +. 0.5, ey, int_to_float(cz) +. 0.5, int_to_float((d + 8) % 16) *. 0.39269908, 0.0 -. Math.atan2(ey -. ty, int_to_float(dist)))
  end

  -- scene 135: 14 m over the island's highest point (of an 8 m grid), looking toward the island's middle and beyond
  pfn hill_pose(land : Land, seed : Int) : (Float, Float, Float, Float, Float) do
    match land do
      Island(a) ->
        match peak_go(a, 0, 0, 0, -1000.0) do
          (px, pz, _) ->
            let dx = 0.0 -. int_to_float(px)
            let dz = 0.0 -. int_to_float(pz)
            let yaw = if dx *. dx +. dz *. dz < 2500.0 do 0.62 else Math.atan2(dx, 0.0 -. dz) end
            (int_to_float(px) +. 0.5, int_to_float(land_height(land, px, pz, seed)) +. 14.0, int_to_float(pz) +. 0.5, yaw, -0.1)
        end
    end
  end

  -- scene 22: 60 m out to sea from that mouth, 18 m over the water, looking back at it
  pfn mouth_pose(land : Land, seed : Int) : (Float, Float, Float, Float, Float) do
    match land do
      Island(a) ->
        match mouth_go(a, Strata.Atlas.rivers(a), None) do
          None -> overview_pose(land, seed)
          Some((mx, mz, _, px, pz)) ->
            let dx = mx -. px
            let dz = mz -. pz
            let len = fmax(0.001, Math.sqrt(dx *. dx +. dz *. dz))
            let ux = dx /. len
            let uz = dz /. len
            let out = 60.0
            (mx +. ux *. out, gen_sea(gp_default()) +. 18.0, mz +. uz *. out, Math.atan2(0.0 -. ux, uz), 0.0 -. Math.atan2(18.0, out))
        end
    end
  end

  -- The shore nearest the origin: a column 1 to 3 m above sea level with the
  -- open sea along x or z (water from within 12 m out to 48 m), searched ring by ring (8 m apart) out to
  -- 2 km. Answers the column and the step toward the sea; the origin, facing
  -- +x, if there is none.
  pfn sea_toward(land : Land, seed : Int, x : Int, z : Int, dx : Int, dz : Int) : Bool do
    -- open sea, not a river: water from within 12 m out to 48 m
    (land_height(land, x + 6 * dx, z + 6 * dz, seed) < sea() || land_height(land, x + 12 * dx, z + 12 * dz, seed) < sea()) && land_height(land, x + 24 * dx, z + 24 * dz, seed) < sea() && land_height(land, x + 48 * dx, z + 48 * dz, seed) < sea()
  end
  pfn shore_at(land : Land, seed : Int, x : Int, z : Int) : (Int, Int) do
    let h = land_height(land, x, z, seed)
    if h < sea() + 1 || h > sea() + 3 do (0, 0)
    else if sea_toward(land, seed, x, z, 1, 0) do (1, 0)
    else if sea_toward(land, seed, x, z, -1, 0) do (-1, 0)
    else if sea_toward(land, seed, x, z, 0, 1) do (0, 1)
    else if sea_toward(land, seed, x, z, 0, -1) do (0, -1)
    else (0, 0) end end end end end
  end
  pfn shore_go(land : Land, seed : Int, r : Int, k : Int) : (Int, Int, Int, Int) do
    let n = if r / 2 < 16 do 16 else r / 2 end
    if r > 2000 do (0, 0, 1, 0)
    else if k >= n do shore_go(land, seed, r + 8, 0)
    else
      let a = 6.2831853 *. int_to_float(k) /. int_to_float(n)
      let x = float_to_int(Math.round(int_to_float(r) *. Math.cos(a)))
      let z = float_to_int(Math.round(int_to_float(r) *. Math.sin(a)))
      match shore_at(land, seed, x, z) do
        (0, 0) -> shore_go(land, seed, r, k + 1)
        (dx, dz) -> (x, z, dx, dz)
      end
    end end
  end


  pfn overview_pose(land : Land, seed : Int) : (Float, Float, Float, Float, Float) do (-70.0, int_to_float(land_height(land, 0, 0, seed)) +. 46.0, 96.0, 0.62, -0.42) end

  -- the top of the ground at a whole-metre column: the island's density top (overhangs and the density noise included)
  pfn ground_top(land : Land, wx : Int, wz : Int, seed : Int) : Int do
    match land do
      Island(a) ->
        let g = gp_default()
        match area_n(g, a, 1.0, wx - 1, wz - 1, 3, seed) do
          Area(hs, cms, _, _, _) -> density_top(g, seed, wx, wz, NativeArray.get_f32(hs, 4), NativeArray.get_f32(cms, 4), 1.0)
        end
    end
  end

  -- the direction 0..15 in which the ground 12 m from (wx, wz) stands nearest the tree's ground top y: a level view of it
  pfn open_dir(land : Land, seed : Int, wx : Int, y : Int, wz : Int, i : Int, best : Int, bh : Int) : Int do
    if i >= 16 do best
    else
      let h = int_abs(ground_top(land, at_x(wx, i, 12), at_z(wz, i, 12), seed) - y)
      if h < bh do open_dir(land, seed, wx, y, wz, i + 1, i, h) else open_dir(land, seed, wx, y, wz, i + 1, best, bh) end
    end
  end

  -- a camera 12 m from a tree's base column (wx, wz) on its most level side, 4 m over the higher of
  -- the tree's ground top y and the ground under the camera, looking at the tree's middle
  pfn tree_pose(land : Land, seed : Int, wx : Int, y : Int, wz : Int) : (Float, Float, Float, Float, Float) do
    let d = open_dir(land, seed, wx, y, wz, 0, 0, 1000000)
    let cx = at_x(wx, d, 12)
    let cz = at_z(wz, d, 12)
    let ey = fmax(int_to_float(y), int_to_float(ground_top(land, cx, cz, seed))) +. 4.0
    (int_to_float(cx) +. 0.5, ey, int_to_float(cz) +. 0.5, int_to_float((d + 8) % 16) *. 0.39269908, 0.0 -. Math.atan2(ey -. (int_to_float(y) +. 5.0), 12.0))
  end

  doc "Scene 134's blast: the voxel of the slope site's ruin nearest the middle of its footprint, 3 voxels over its floor row; the site's centre there if the ruin is not found."
  fn crater_target(land : Land, d : Decor, seed : Int) : (Int, Int, Int) do
    match land do
      Island(a) ->
        match slope_site(a) do
          None -> (0, land_height(land, 0, 0, seed), 0)
          Some(s) ->
            match site_ruin(d, s, 1.0, seed) do
              None -> (float_to_int(Strata.Atlas.s_x(s)), vox(Strata.Atlas.s_floor(s), 1.0) + 3, float_to_int(Strata.Atlas.s_z(s)))
              Some((t, ox, oy, oz, rot)) ->
                match Strata.Template.bounds(t, ox, oy, oz, rot) do
                  (x0, y0, z0, x1, _, z1) ->
                    let mx = (x0 + x1) / 2
                    let mz = (z0 + z1) / 2
                    let y = y0 + 3
                    let st = island_stamps(a, d, 1.0, Strata.Coord.chunk_of(mx), Strata.Coord.chunk_of(y), Strata.Coord.chunk_of(mz), seed)
                    nearest_stamp(st, Strata.Coord.chunk_of(mx) * 32, Strata.Coord.chunk_of(y) * 32, Strata.Coord.chunk_of(mz) * 32, mx, y, mz, 0, (mx, y, mz), 1000000)
                end
            end
        end
    end
  end
  pfn nearest_stamp(st : NativeI32Arr, ox : Int, oy : Int, oz : Int, mx : Int, my : Int, mz : Int, i : Int, best : (Int, Int, Int), bd : Int) : (Int, Int, Int) do
    if i >= 32768 do best
    else if NativeArray.get_i32(st, i) == 0 do nearest_stamp(st, ox, oy, oz, mx, my, mz, i + 1, best, bd)
    else
      let x = ox + i % 32
      let y = oy + i / 1024
      let z = oz + (i / 32) % 32
      let dd = (x - mx) * (x - mx) + 4 * (y - my) * (y - my) + (z - mz) * (z - mz)
      if dd < bd do nearest_stamp(st, ox, oy, oz, mx, my, mz, i + 1, (x, y, z), dd) else nearest_stamp(st, ox, oy, oz, mx, my, mz, i + 1, best, bd) end
    end end
  end

  -- Scene 15's ice: the 10 x 10 columns centred 8 m short of the island's highest ground toward the
  -- camera (clear of the trees on the top), their ground top made ice (13)
  pfn ice_patch(land : Land, seed : Int) : List((Int, Int, Int, Int)) do
    match land do
      Island(a) ->
        match peak_go(a, 0, 0, 0, -1000.0) do
          (px, pz, _) -> List.map(List.range(0, 100), fn i -> (px - 11 + i % 10, ground_top(land, px - 11 + i % 10, pz - 10 + i / 10, seed), pz - 10 + i / 10, 13))
        end
    end
  end

  -- Scenes on the meadow (mw is the meadow's column) were placed about (-35, 53) on the old noise terrain;
  -- main's scenes from there (25, 26, 31, 33, 34, 36, 126, 127) keep their offsets from it.
  pfn pose(scene : Int, seed : Int, land : Land, tl : (Int, Int, Int, Int, Int, Int, Int), mw : (Int, Int), hole : (Int, Int, Int)) : (Float, Float, Float, Float, Float) do
    let (mx, mz) = mw
    if scene == 0 && Authority.must(Env.get_int("STRATA_SHORE", 0)) == 1 do
      match shore_go(land, seed, 8, 0) do
        (x, z, dx, dz) -> (int_to_float(x) +. 0.5, int_to_float(land_height(land, x, z, seed)) +. 2.7, int_to_float(z) +. 0.5, Math.atan2(int_to_float(dz), int_to_float(dx)), -0.1)
      end
    else if scene == 0 || scene == 11 do (0.5, int_to_float(land_height(land, 0, 0, seed)) +. 2.7, 0.5, 0.62, -0.1)
    else if scene == 2 || scene == 8 || scene == 13 || scene == 14 || scene == 28 || scene == 35 || scene == 124 do
      -- the sea off the coast toward the sun: low over it along the shore (2, and 28 with its crate), just under its
      -- surface looking back at the land (8) or steeply up at the surface (124), across it toward the sun to catch
      -- its glints (13), steeply down at it (14); 35 is scene 2's camera turned 0.32 rad left, toward the beach
      match coast(land, seed, 6, 0) do
        (wx, wz) ->
          let sea = gen_sea(gp_default())
          let y = if scene == 8 do sea -. 1.4 else if scene == 124 do sea -. 2.4 else sea +. 3.5 end end
          let yaw = if scene == 2 || scene == 28 do 11.0 *. 0.39269908 else if scene == 35 do 11.0 *. 0.39269908 -. 0.32 else if scene == 8 || scene == 124 do 14.0 *. 0.39269908 else 2.23 end end end
          let pitch = if scene == 13 do -0.12 else if scene == 14 do -0.75 else if scene == 8 do 0.22 else if scene == 124 do 1.05 else -0.15 end end end end
          let fwd = 0.0
          (int_to_float(wx) +. 0.5 +. Math.sin(yaw) *. fwd, y, int_to_float(wz) +. 0.5 -. Math.cos(yaw) *. fwd, yaw, pitch)
      end
    else if scene == 15 do
      -- high ground, from 30 m back and 14 m up, looking across the top toward the sun
      match land do
        Island(a) ->
          match peak_go(a, 0, 0, 0, -1000.0) do
            (px, pz, _) -> (int_to_float(px) -. 23.7, int_to_float(land_height(land, px, pz, seed)) +. 12.0, int_to_float(pz) -. 18.4, 2.23, -0.4)
          end
      end
    else if scene == 12 do (int_to_float(mx - 10), int_to_float(ground_top(land, mx, mz, seed)) +. 11.0, int_to_float(mz - 13), 2.5, -0.45)
    else if scene == 6 do (16.5, 150.0, -8.0, 3.14159265, 0.0)
    else if scene == 7 do (16.5, 150.0, 68.0, 0.0, 0.0)
    else if scene == 125 do
      -- in the test lake over its centre, two fifths of the way up from its bed, looking across it toward the breach
      match tl do
        (cx, cz, _, line, d, bed, _) -> (int_to_float(cx) +. 0.5, int_to_float(bed) +. int_to_float(line - bed) *. 0.4, int_to_float(cz) +. 0.5, int_to_float(d) *. 0.39269908, 0.12)
      end
    else if scene == 18 || scene == 19 do
      -- the test lake: from over its far side looking at the breach (18), or from the valley below looking back (19)
      match tl do
        (cx, cz, rad, line, d, _, _) ->
          if scene == 18 do (int_to_float(at_x(cx, d, 0 - (rad * 6) / 10)), int_to_float(line) +. 16.0, int_to_float(at_z(cz, d, 0 - (rad * 6) / 10)), int_to_float(d) *. 0.39269908, -0.5)
          else (int_to_float(at_x(cx, d, rad + 44)), int_to_float(land_height(land, at_x(cx, d, rad + 44), at_z(cz, d, rad + 44), seed)) +. 14.0, int_to_float(at_z(cz, d, rad + 44)), int_to_float(d) *. 0.39269908 +. 3.14159265, -0.25) end
      end
    else if scene == 126 do (int_to_float(mx) -. 5.5, int_to_float(ground_top(land, mx, mz, seed)) +. 6.0, int_to_float(mz) +. 0.5, 1.5708, -0.3)
    else if scene == 21 || scene == 127 do (int_to_float(mx - 10), int_to_float(ground_top(land, mx, mz, seed)) +. 10.0, int_to_float(mz - 13), 2.5, -0.4)
    else if scene == 25 || scene == 26 do (int_to_float(mx - 5), int_to_float(ground_top(land, mx - 5, mz + 7, seed)) +. 3.5, int_to_float(mz + 7), 0.0, -0.3)
    else if scene == 31 do (int_to_float(mx - 3), int_to_float(ground_top(land, mx - 8, mz - 1, seed)) +. 2.9, int_to_float(mz + 6), 0.0, -0.14)
    else if scene == 33 || scene == 34 do (int_to_float(mx - 3), int_to_float(ground_top(land, mx - 8, mz - 1, seed)) +. 7.0, int_to_float(mz) +. 7.5, 0.661, -0.7)
    else if scene == 20 do (int_to_float(mx) -. 0.5, int_to_float(ground_top(land, mx, mz, seed)) +. 12.0, int_to_float(mz) +. 7.5, 0.0, -0.95)
    else if scene == 16 || scene == 36 do (int_to_float(mx) +. 0.5, int_to_float(ground_top(land, mx, mz, seed)) -. 1.3, int_to_float(mz) +. 5.2, 0.0, -0.03)
    else if scene == 10 || scene == 17 do (int_to_float(mx) -. 2.7, int_to_float(ground_top(land, mx, mz, seed)) +. 2.3, int_to_float(mz) +. 2.9, 0.927, -0.22)
    else if scene == 9 do (int_to_float(mx) +. 0.5, int_to_float(ground_top(land, mx, mz, seed)) +. 1.9, int_to_float(mz) +. 0.5, 2.5, -0.12)
    else if scene == 5 do (int_to_float(mx - 7), int_to_float(ground_top(land, mx, mz, seed)) +. 7.0, int_to_float(mz - 9), 2.5, -0.25)
    -- 3: in the middle of the most wooded chunk near the origin, looking level; 32 walks a figure there
    else if scene == 3 || scene == 32 do (int_to_float(mx) +. 0.5, int_to_float(ground_top(land, mx, mz, seed)) +. 2.6, int_to_float(mz) +. 0.5, 2.5, -0.05)
    else if scene == 22 do mouth_pose(land, seed)
    -- 128: standing on the chunk border x = -32 at z = 8, looking along it (-z) through the trees
    -- either side (8 trees within 10 m of the line over z -32..-1, the most of 64 borders searched)
    else if scene == 128 do (-32.0, int_to_float(ground_top(land, -32, 8, seed)) +. 2.7, 8.0, 0.0, -0.08)
    -- 129: the site on the steepest ground, from 30 m down its slope and 10 m up
    -- 134: the same site from 16 m and 6 m up, looking at the voxel its blast is aimed at
    else if scene == 129 || scene == 134 do
      match land do
        Island(a) ->
          match slope_site(a) do
            Some(s) ->
              let sx = float_to_int(Strata.Atlas.s_x(s))
              let sz = float_to_int(Strata.Atlas.s_z(s))
              let d = low_dir(a, s, 0, 0, 1000000.0)
              if scene == 129 do facing(land, seed, sx, sz, 30, 10, d)
              else
                match hole do
                  (hx, hy, hz) ->
                    let ex = at_x(hx, d, 16)
                    let ez = at_z(hz, d, 16)
                    let ey = int_to_float(hy) +. 6.0
                    (int_to_float(ex) +. 0.5, ey, int_to_float(ez) +. 0.5, int_to_float((d + 8) % 16) *. 0.39269908, 0.0 -. Math.atan2(6.0, 16.0))
                end
              end
            None -> overview_pose(land, seed)
          end
      end
    -- 130 to 133: one tree close up from its most open side, an oak, a birch, a pine and a willow standing alone at seed 7
    -- (base column and ground top found by a scripted search of the island's trees)
    else if scene == 130 do tree_pose(land, seed, -2, 96, -11)
    else if scene == 131 do tree_pose(land, seed, -20, 83, -46)
    else if scene == 132 do tree_pose(land, seed, 82, 99, -28)
    else if scene == 133 do tree_pose(land, seed, -51, 68, -398)
    -- the steepest island slope found (a 6.6 m drop over 3 m at (-180, -200)) and a cavern
    -- the caves open on a snowy hill (its floor at 64 m under ground near 80 m, at (44, 78)):
    -- found by a scripted search of the island at seed 7
    else if scene == 24 do facing(land, seed, -180, -200, 45, 14, 2)
    else if scene == 29 do facing(land, seed, 44, 78, 20, 8, 8)
    -- the far field (STRATA_LEVELS): 135 the island from its highest hill, 14 m over the summit, looking over the
    -- island's middle to its far shore and the sea; 136 a ring boundary crossing the ground, 12 m over the meadow, looking toward that hill
    else if scene == 135 do hill_pose(land, seed)
    else if scene == 136 do
      match land do
        Island(a) ->
          match peak_go(a, 0, 0, 0, -1000.0) do
            (px, pz, _) -> (int_to_float(mx) +. 0.5, int_to_float(ground_top(land, mx, mz, seed)) +. 12.0, int_to_float(mz) +. 0.5, Math.atan2(int_to_float(px - mx), int_to_float(mz - pz)), -0.1)
          end
      end
    else if scene == 23 do
      -- the test lake from its bank opposite the outlet, looking across the water to the river leaving it
      match tl do
        (cx, cz, rad, line, d, _, _) ->
          let bx = at_x(cx, d, 0 - (rad + 8))
          let bz = at_z(cz, d, 0 - (rad + 8))
          let ey = int_to_float(land_height(land, bx, bz, seed)) +. 5.0
          (int_to_float(bx) +. 0.5, ey, int_to_float(bz) +. 0.5, int_to_float(d) *. 0.39269908, 0.0 -. Math.atan2(ey -. int_to_float(line), int_to_float(2 * rad + 8)))
      end
    else overview_pose(land, seed) end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end end
  end

  -- ── Timing the generator ─────────────────────────────────────────────────
  -- STRATA_CHUNK_TIMES=1: generate each of 200 surface chunks (10 x 20 about
  -- the origin, cy holding the ground at the chunk's middle) 10 times on one
  -- task with the generator in use (at STRATA_SCALE), print the median and
  -- worst time a chunk, then the early-outs, then run as usual.
  -- (at STRATA_CHUNK_LEVEL: chunks of that level, 32 voxels of scale * 2^level metres)
  pfn surface_key(land : Land, seed : Int, scale : Float, k : Int, dy : Int) : Strata.Coord.Key do
    let l = Authority.must(Env.get_int("STRATA_CHUNK_LEVEL", 0))
    let sc = scale *. pow2f(l)
    let cx = k % 10 - 5
    let cz = k / 10 - 10
    let hm = land_height(land, float_to_int(int_to_float(cx * 32 + 16) *. sc), float_to_int(int_to_float(cz * 32 + 16) *. sc), seed)
    Strata.Coord.key_at(cx, Strata.Coord.chunk_of(vox(int_to_float(hm), sc)) + dy, cz, l)
  end
  pfn time_go(gen : Strata.Terrain.Gen, land : Land, seed : Int, scale : Float, k : Int, acc : List(Int)) : List(Int) do
    if k >= 200 do acc
    else
      let key = surface_key(land, seed, scale, k, 0)
      let t0 = unix_time_ms()
      let forms = gen_n(gen, key, seed, 10, 0)
      -- hundredths of a millisecond a chunk; the forms are used so no call is dropped (GAPS S9)
      time_go(gen, land, seed, scale, k + 1, Cons((unix_time_ms() - t0) * 10 + (if forms < 0 do 1 else 0 end), acc))
    end
  end
  pfn gen_n(gen : Strata.Terrain.Gen, key : Strata.Coord.Key, seed : Int, left : Int, acc : Int) : Int do
    if left <= 0 do acc else gen_n(gen, key, seed, left - 1, acc + Ch.form(Strata.Terrain.run(gen, key, seed))) end
  end
  -- the early-outs: each of the 200 columns' chunk dy over (air) or under
  -- (stone) the ground chunk, made 100 times; (total ms, the forms seen summed)
  pfn early_go(gen : Strata.Terrain.Gen, land : Land, seed : Int, scale : Float, dy : Int, k : Int, ms : Int, forms : Int) : (Int, Int) do
    if k >= 200 do (ms, forms)
    else
      let t0 = unix_time_ms()
      let f = gen_n(gen, surface_key(land, seed, scale, k, dy), seed, 100, 0)
      early_go(gen, land, seed, scale, dy, k + 1, ms + unix_time_ms() - t0, forms + f)
    end
  end
  -- 20000 chunks in ms is twentieths of a microsecond each: as microseconds with two places
  pfn early_us(ms : Int) : String do hundredths(ms * 5) end
  pfn hundredths(v : Int) : String do int_to_string(v / 100) ++ "." ++ String.pad_left(int_to_string(v % 100), 2, "0") end
  pfn chunk_times(gen : Strata.Terrain.Gen, land : Land, seed : Int, scale : Float) : Unit do
    let ts = List.sort_by(time_go(gen, land, seed, scale, 0, Nil), fn (p, q) -> p < q)
    Authority.must(println("strata_viewer: island chunks at " ++ float_to_string(scale) ++ " m, level " ++ int_to_string(Authority.must(Env.get_int("STRATA_CHUNK_LEVEL", 0))) ++ ": median " ++ hundredths(unwrap_or(List.nth_opt(ts, 100), 0)) ++ " ms, worst " ++ hundredths(unwrap_or(List.nth_opt(ts, 199), 0)) ++ " ms over 200 surface chunks, 10 runs each on one task"))
    -- the early-outs 224 m over and under the ground: 7 chunks at 1 m, 28 at 0.25 m
    let dy = float_to_int(Math.round(7.0 /. scale))
    match early_go(gen, land, seed, scale, dy, 0, 0, 0) do
      (ms, forms) -> Authority.must(println("strata_viewer: air early-out " ++ early_us(ms) ++ " us a chunk over 200 chunks " ++ int_to_string(dy) ++ " over the ground, 100 runs each (" ++ int_to_string(forms) ++ " not uniform)"))
    end
    match early_go(gen, land, seed, scale, 0 - dy, 0, 0, 0) do
      (ms, forms) -> Authority.must(println("strata_viewer: stone early-out " ++ early_us(ms) ++ " us a chunk over 200 chunks " ++ int_to_string(dy) ++ " under the ground, 100 runs each (" ++ int_to_string(forms) ++ " not uniform)"))
    end
  end

  -- whether a scene builds on (or stands about) the meadow
  pfn on_meadow(scene : Int) : Bool do
    scene == 5 || scene == 9 || scene == 10 || scene == 12 || scene == 16 || scene == 17 || scene == 20 || scene == 21
      || scene == 25 || scene == 26 || scene == 31 || scene == 33 || scene == 34 || scene == 36 || scene == 126 || scene == 127 || scene == 136
  end
  pfn settle(s : Strata.Stream.Stream, o : Strata.Edit.Outcome) : Strata.Stream.Stream do Strata.Stream.run_until_settled(Strata.Stream.apply(s, o), 1000000) end

  -- The scenes' edits before the first frame, on the meadow (mx, mz) whose ground top is gy.
  pfn scene_edits(scene : Int, land : Land, seed : Int, s : Strata.Stream.Stream, mx : Int, mz : Int, gy : Int) : Strata.Stream.Stream do
    let w = Strata.Stream.world(s)
    -- 5: a wall of the bad-texture block ahead, topped by an unregistered id
    if scene == 5 do
      let o = Strata.Edit.fill_box(w, mx - 3, gy + 1, mz, mx + 3, gy + 2, mz, 9)
      settle(Strata.Stream.apply(s, o), Strata.Edit.set_block(Strata.Edit.world(o), mx, gy + 3, mz, 60000))
    -- 6 and 7: two see-through walls in the air, in different chunks: red glass at z = 20, water at z = 40
    else if scene == 6 || scene == 7 do
      let a1 = Strata.Stream.apply(s, Strata.Edit.fill_box(w, 8, 144, 20, 24, 156, 20, 10))
      settle(a1, Strata.Edit.fill_box(Strata.Stream.world(a1), 8, 144, 40, 24, 156, 40, 5))
    -- 16 (and 36, its torch-bearer): a pit and, from it, a tunnel 14 m into the ground: a cave mouth to look into
    else if scene == 16 || scene == 36 do
      let pit = Strata.Stream.apply(s, Strata.Edit.fill_box(w, mx - 1, gy - 3, mz + 2, mx + 1, gy + 6, mz + 7, 0))
      settle(pit, Strata.Edit.fill_box(Strata.Stream.world(pit), mx - 1, gy - 3, mz - 12, mx + 1, gy - 1, mz + 1, 0))
    -- 10 and 17: a lantern post on the meadow; 17 stands a stone block two steps from it
    else if scene == 10 || scene == 17 do
      let p = Strata.Stream.apply(s, Strata.Edit.set_block(w, mx, gy + 1, mz, 12))
      if scene == 10 do Strata.Stream.run_until_settled(p, 1000000)
      else settle(p, Strata.Edit.set_block(Strata.Stream.world(p), mx + 2, ground_top(land, mx + 2, mz - 1, seed) + 1, mz - 1, 1)) end
    -- 21: a stone tray over the meadow for the splash to land on; 127 puts a stone roof over it all, so the splash is in shade
    else if scene == 21 || scene == 127 do
      let tray = Strata.Stream.apply(s, Strata.Edit.fill_box(w, mx - 6, gy + 3, mz - 3, mx + 6, gy + 3, mz + 3, 1))
      if scene == 127 do settle(tray, Strata.Edit.fill_box(Strata.Stream.world(tray), mx - 11, gy + 20, mz - 9, mx + 11, gy + 20, mz + 9, 1))
      else Strata.Stream.run_until_settled(tray, 1000000) end
    -- 20 (and 126): a stone tray on the meadow holding a row of lake water, one eighth to full, beside a full block of it
    else if scene == 20 || scene == 126 do
      let tray = Strata.Stream.apply(s, Strata.Edit.fill_box(w, mx - 6, gy + 3, mz - 2, mx + 5, gy + 4, mz + 2, 1))
      let hollow = Strata.Stream.apply(tray, Strata.Edit.fill_box(Strata.Stream.world(tray), mx - 5, gy + 4, mz - 1, mx + 4, gy + 4, mz + 1, 0))
      settle(hollow, Strata.Edit.set_many(Strata.Stream.world(hollow), stairs(mx - 5, mz - 1, gy + 4, 0, Nil)))
    -- 12: the slab in place unless a run asks for it to appear later
    else if scene == 12 && Authority.must(Env.get_int("STRATA_SLAB_AT", -1)) < 0 do settle(s, slab_edit(w, mx, mz, gy, 1))
    -- 15: a patch of ice 10 x 10 on the high ground it looks at, its top voxel each column: a solid mirror
    else if scene == 15 do settle(s, Strata.Edit.set_many(w, ice_patch(land, seed)))
    else s end end end end end end end end
  end

  -- the 10 cm world's poses: 27 the overview (tower, wall and cliff); anything else stands near the middle
  pfn fine_pose(scene : Int) : (Float, Float, Float, Float, Float) do
    if scene == 27 do (2.0, 6.0, 12.0, 0.0, -0.12) else (2.0, 1.7, 8.0, 0.0, 0.0) end
  end

  -- ── Figures ──────────────────────────────────────────────────────────────
  -- scene 31: the seven clips frozen at their midpoints in a row 6 m ahead, each
  -- turned a little from facing the camera; scene 32: one humanoid walking
  -- across the view 7 m ahead, slowly; scene 33: a runner frozen mid-stride and a walker on
  -- scene 31's pad, for their shadows under a low sun; otherwise n walkers in rows of 32, 2.5 m apart,
  -- from 8 m ahead, each round a circle of 1 m. Heights from the world.
  pfn posed_go(c : StrataViewer.Figures.Crowd, w : Strata.World.World, ex : Float, ey : Float, ez : Float, yaw : Float, k : Int) : StrataViewer.Figures.Crowd do
    if k >= 7 do c
    else
      let side = (int_to_float(k) -. 3.0) *. 1.3
      let x = ex +. Math.sin(yaw) *. 6.0 +. Math.cos(yaw) *. side
      let z = ez -. Math.cos(yaw) *. 6.0 +. Math.sin(yaw) *. side
      let y = StrataViewer.Figures.ground_at(w, x, z, ey +. 1.0)
      posed_go(StrataViewer.Figures.add_posed(c, k, x, y, z, Math.atan2(0.0 -. Math.sin(yaw), Math.cos(yaw)) +. 0.45), w, ex, ey, ez, yaw, k + 1)
    end
  end
  pfn crowd_go(c : StrataViewer.Figures.Crowd, w : Strata.World.World, ex : Float, ey : Float, ez : Float, yaw : Float, i : Int, n : Int) : StrataViewer.Figures.Crowd do
    if i >= n do c
    else
      -- STRATA_FIG_ROW=r: r walkers a row (default 32), each row centred on the view
      let row0 = Authority.must(Env.get_int("STRATA_FIG_ROW", 32))
      let row = if n - (i / row0) * row0 < row0 do n - (i / row0) * row0 else row0 end
      let ahead = 8.0 +. int_to_float(i / row0) *. 3.0
      let side = (int_to_float(i % row0) -. int_to_float(row - 1) *. 0.5) *. 2.5
      let x = ex +. Math.sin(yaw) *. ahead +. Math.cos(yaw) *. side
      let z = ez -. Math.cos(yaw) *. ahead +. Math.sin(yaw) *. side
      -- the ground on the walker's circle, searched from well above the eye: the row crosses hills and hollows; no walker on water
      let y = StrataViewer.Figures.dry_ground_at(w, x +. 1.0, z, ey +. 40.0, 120.0)
      let c2 = if y < -999.0 do c else StrataViewer.Figures.add_walker(c, x, z, 1.0, int_to_float(i) *. 0.7, y, 1.0) end
      -- STRATA_TRACED=k: the first k walkers traced (64 at most are; the rest wait, drawn plain)
      crowd_go(if y > -999.0 && i < Authority.must(Env.get_int("STRATA_TRACED", 0)) do StrataViewer.Figures.trace_last(c2) else c2 end, w, ex, ey, ez, yaw, i + 1, n)
    end
  end
  -- the first ground above the sea straight ahead of the eye, from [d] m on (60 at most): (x, top, z)
  pfn shore_spot(w : Strata.World.World, ex : Float, ey : Float, ez : Float, yaw : Float, d : Float) : (Float, Float, Float) do
    let x = ex +. Math.sin(yaw) *. d
    let z = ez -. Math.cos(yaw) *. d
    let y = StrataViewer.Figures.ground_at(w, x, z, ey +. 2.0)
    -- ground_at answers 1.5 m under where it searched from when it found none (open water)
    if (y >= int_to_float(sea() + 1) && y < ey +. 0.4) || d > 60.0 do (x, y, z) else shore_spot(w, ex, ey, ez, yaw, d +. 0.5) end
  end
  pfn crowd_for(scene : Int, n : Int, w : Strata.World.World, ex : Float, ey : Float, ez : Float, yaw : Float) : StrataViewer.Figures.Crowd do
    if scene == 31 do posed_go(StrataViewer.Figures.open(16), w, ex, ey, ez, yaw, 0)
    else if scene == 34 do
      -- scene 33 with a second runner, traced, 4 m left of the plain one, and the walker traced: the
      -- traced shadows are soft-edged, the plain one's sharper; the walker's moving shadow leaves no trail
      let px = ex +. Math.sin(yaw) *. 7.0 +. Math.cos(yaw) *. 1.5
      let pz = ez -. Math.cos(yaw) *. 7.0 +. Math.sin(yaw) *. 1.5
      let posed = StrataViewer.Figures.add_posed(StrataViewer.Figures.open(16), 2, px, StrataViewer.Figures.ground_at(w, px, pz, ey -. 4.0), pz, 0.35 -. yaw)
      let tx = ex +. Math.sin(yaw) *. 7.0 -. Math.cos(yaw) *. 2.5
      let tz = ez -. Math.cos(yaw) *. 7.0 -. Math.sin(yaw) *. 2.5
      let traced = StrataViewer.Figures.trace_last(StrataViewer.Figures.add_posed(posed, 2, tx, StrataViewer.Figures.ground_at(w, tx, tz, ey -. 4.0), tz, 0.35 -. yaw))
      let wx = ex +. Math.sin(yaw) *. 4.0 -. Math.cos(yaw) *. 1.0
      let wz = ez -. Math.cos(yaw) *. 4.0 -. Math.sin(yaw) *. 1.0
      StrataViewer.Figures.trace_last(StrataViewer.Figures.add_walker(traced, wx, wz, 0.0, Math.atan2(Math.cos(yaw), Math.sin(yaw)), StrataViewer.Figures.ground_at(w, wx, wz, ey -. 4.0), 0.6))
    else if scene == 35 do
      -- on the first dry ground straight ahead (the beach), standing (the idle clip), facing the camera but for 0.3 rad, traced: seen in the water
      match shore_spot(w, ex, ey, ez, yaw, 4.0) do
        (x, y, z) -> StrataViewer.Figures.trace_last(StrataViewer.Figures.add_posed(StrataViewer.Figures.open(16), 0, x, y, z, Math.atan2(0.0 -. Math.sin(yaw), Math.cos(yaw)) +. 0.3))
      end
    else if scene == 36 do
      -- in scene 16's tunnel, walking in from 4 m ahead of the camera at 0.84 m/s (the walk at rate 0.6) near its right wall,
      -- a lit torch in its right hand (on that side, 0.45 m from the wall), both traced: the wall's glow follows the torch
      let x = ex +. 0.7
      let z = ez -. 4.2
      StrataViewer.Figures.add_torch(StrataViewer.Figures.trace_last(StrataViewer.Figures.add_walker(StrataViewer.Figures.open(16), x, z, 0.0, 3.14159265, StrataViewer.Figures.ground_at(w, x, z, ey), 0.6)))
    else if scene == 33 do
      -- on scene 31's pad, the camera looking across the sun's way (the sun on its right): a runner frozen
      -- mid-stride 5.5 m ahead, facing the camera but for 0.35 rad, so its stride and arm swing lie across
      -- the sun and a low sun throws them apart on the grass to its left; and a walker crossing 3.5 m ahead,
      -- rightward, at 0.84 m/s (the walk at rate 0.6), for its moving shadow
      let px = ex +. Math.sin(yaw) *. 7.0 +. Math.cos(yaw) *. 1.5
      let pz = ez -. Math.cos(yaw) *. 7.0 +. Math.sin(yaw) *. 1.5
      let posed = StrataViewer.Figures.add_posed(StrataViewer.Figures.open(16), 2, px, StrataViewer.Figures.ground_at(w, px, pz, ey -. 4.0), pz, 0.35 -. yaw)
      let wx = ex +. Math.sin(yaw) *. 4.0 -. Math.cos(yaw) *. 1.0
      let wz = ez -. Math.cos(yaw) *. 4.0 -. Math.sin(yaw) *. 1.0
      StrataViewer.Figures.add_walker(posed, wx, wz, 0.0, Math.atan2(Math.cos(yaw), Math.sin(yaw)), StrataViewer.Figures.ground_at(w, wx, wz, ey -. 4.0), 0.6)
    else if scene == 32 do
      -- on the level ground right of the view's centre, 5 m ahead, strolling right at 0.84 m/s (the walk at rate 0.6)
      let x = ex +. Math.sin(yaw) *. 5.0 +. Math.cos(yaw) *. 1.0
      let z = ez -. Math.cos(yaw) *. 5.0 +. Math.sin(yaw) *. 1.0
      StrataViewer.Figures.add_walker(StrataViewer.Figures.open(16), x, z, 0.0, Math.atan2(Math.cos(yaw), Math.sin(yaw)), StrataViewer.Figures.ground_at(w, x, z, ey +. 1.0), 0.6)
    else if n > 0 do crowd_go(StrataViewer.Figures.open(if n < 16 do 16 else n end), w, ex, ey, ez, yaw, 0, n)
    else StrataViewer.Figures.none() end end end end end end end
  end

  -- ── The far field ────────────────────────────────────────────────────────
  doc "How far each coarse level reaches, in its own chunks (Part F's 10)."
  fn far_radius() : Int do 10 end

  doc "Start streaming [w]: level 0 alone with [levels] 0 (the near field, as before the far field), else Part F's rings: levels 1..[levels] each far_radius() of its chunks out and 1 up and down. (A function returning the Config itself meets GAPS S19 in the viewer.)"
  fn stream_start(w : Strata.World.World, r : Int, levels : Int) : Strata.Stream.Stream do
    if levels > 0 do Strata.Stream.start(w, Strata.Stream.config_levels(r, 3, 8, 4, far_radius(), 1, levels)) else Strata.Stream.start(w, Strata.Stream.config(r, 3, 32, 8)) end
  end

  doc "Where the fog closes, in the renderer's units ([sc] a voxel): one chunk short of the near radius [r] without levels; with them, one chunk of the top level short of its ring's reach."
  fn fog_reach(r : Int, top : Int, sc : Float) : Float do
    if top > 0 do int_to_float(far_radius() - 1) *. 32.0 *. pow2f(top) *. sc else int_to_float(r - 1) *. 32.0 *. sc end
  end

  -- the far plane: the old 1200 for the near field, past the fog with levels
  pfn view_far(top : Int, sc : Float) : Float do
    if top > 0 do int_to_float(far_radius() + 1) *. 32.0 *. pow2f(top) *. sc else 1200.0 end
  end

  -- tick until settled, counting the ticks
  pfn settle_counted(s : Strata.Stream.Stream, n : Int) : (Strata.Stream.Stream, Int) do
    if n >= 1000000 do (s, n)
    else
      let s2 = Strata.Stream.tick(s)
      if Strata.Stream.settled(s2) do (s2, n + 1) else settle_counted(s2, n + 1) end
    end
  end

  -- how many chunks each level holds, "a/b/c/..." from level 0
  pfn per_level(w : Strata.World.World, top : Int) : String do
    let counts = List.map(List.range(0, top + 1), fn l -> Strata.Store.fold(Strata.World.chunks(w), 0, fn (n, k, _c) -> if Strata.Coord.level(k) == l do n + 1 else n end))
    List.fold_left(List.drop(counts, 1), match counts do
        Cons(h, _) -> int_to_string(h)
        Nil -> ""
      end, fn (acc, n) -> acc ++ "/" ++ int_to_string(n))
  end

  fn main(_cap : Cap(IO)) : Unit do
    let sc = if Authority.must(Env.get("STRATA_SCALE", "1")) == "0.1" do 0.1 else 1.0 end
    let fine = sc < 0.5
    let r = if fine do 8 else Authority.must(Env.get_int("STRATA_RADIUS", 10)) end
    let levels = Authority.must(Env.get_int("STRATA_LEVELS", 4))
    let soak = Authority.must(Env.get_int("STRATA_SOAK", 0))
    let frames = if soak > 0 do soak else Authority.must(Env.get_int("STRATA_FRAMES", 0)) end
    let seed = Authority.must(Env.get_int("STRATA_SEED", 7))
    let size = window_size()
    let scene = Authority.must(Env.get_int("STRATA_SCENE", 0))
    -- STRATA_SCALE=0.1 is the 10 cm world, its camera in metres; any other is the island's metres a voxel, its camera in voxels
    let scale = if fine do 1.0 else match String.to_float(Authority.must(Env.get("STRATA_SCALE", "1.0"))) do
        Ok(v) -> if v > 0.0 do v else 1.0 end
        Err(_) -> 1.0
      end end
    let g = gp_of(load_params(params_path()))
    let a = load_atlas(g, seed)
    let land = Island(a)
    let td = unix_time_ms()
    let dec = decor_of(g, scale, seed)
    Authority.must(println("strata_viewer: " ++ int_to_string(List.length(decor_trees(dec))) ++ " tree templates and " ++ int_to_string(List.length(decor_ruins(dec))) ++ " ruins built in " ++ int_to_string(unix_time_ms() - td) ++ " ms"))
    let gen = island_gen(a, dec, scale)
    if Authority.must(Env.get_int("STRATA_CHUNK_TIMES", 0)) == 1 do chunk_times(gen, land, seed, scale) else () end
    let tl = scene_lake(land, seed)
    let (mx, mz) = if on_meadow(scene) do meadow() else if scene == 3 || scene == 32 do forest() else (0, 0) end end
    let gy = if on_meadow(scene) do ground_top(land, mx, mz, seed) else 0 end
    if on_meadow(scene) || scene == 3 || scene == 32 do Authority.must(println("strata_viewer: scene " ++ int_to_string(scene) ++ " stands at (" ++ int_to_string(mx) ++ ", " ++ int_to_string(mz) ++ "), ground top " ++ int_to_string(ground_top(land, mx, mz, seed)))) else () end
    let target = if scene == 134 do crater_target(land, dec, seed) else (0, 0, 0) end
    -- the soak circles the test lake 40 m out, 12 m over its water, looking down a little; in voxels
    let mid = match tl do (lcx, lcz, _, _, _, _, _) -> (vox(int_to_float(lcx), scale), vox(40.0, scale), vox(int_to_float(lcz), scale)) end
    let soak_y = match tl do (_, _, _, line, _, _, _) -> int_to_float(vox(int_to_float(line) +. 12.0, scale)) end
    let start = if soak > 0 do (soak_x(0.0, mid), soak_y, soak_z(0.0, mid), 3.14159265, -0.35) else if fine do fine_pose(scene) else pose(scene, seed, land, tl, (mx, mz), target) end end
    if !Strata.Ffi.Vk.open(match size do (w, _) -> w end, match size do (_, h) -> h end, frames == 0, Authority.must(Env.get_int("STRATA_QUADS", 0))) do Authority.must(println("strata_viewer: could not open a Vulkan window"))
    else
      Strata.Ffi.Vk.set_vsync(Authority.must(Env.get_int("STRATA_VSYNC", 1)) != 0)
      Strata.Ffi.Vk.set_offscreen(Authority.must(Env.get_int("STRATA_OFFSCREEN", 0)) == 1)
      Strata.Ffi.Vk.pad_commands(Authority.must(Env.get_int("STRATA_PAD_CMDS", 0)))
      Strata.Ffi.Vk.set_lighting(Authority.must(Env.get_int("STRATA_LIGHT", 4)))
      let reg = registry()
      if Strata.Render.set_light_box(Authority.must(Env.get_int("STRATA_LIGHT_BOX", r)), 3) do () else Authority.must(println("strata_viewer: could not build the light volume")) end
      if textures(reg) do () else Authority.must(println("strata_viewer: could not upload textures")) end
      if Strata.Render.ui_atlas(StrataViewer.Hud.atlas_w(), StrataViewer.Hud.atlas_h(), StrataViewer.Hud.atlas()) do () else Authority.must(println("strata_viewer: could not upload the interface atlas")) end
      if Strata.Render.light_overflow(reg) > 0 do Authority.must(println("strata_viewer: " ++ int_to_string(Strata.Render.light_overflow(reg)) ++ " blocks share another block's light class")) else () end
      sun_at(int_to_float(Authority.must(Env.get_int("STRATA_SUN", 55))))
      let ex = match start do (x, _, _, _, _) -> x end
      let ey = match start do (_, y, _, _, _) -> y end
      let ez = match start do (_, _, z, _, _) -> z end
      let yaw0 = match start do (_, _, _, a3, _) -> a3 end
      let pitch0 = match start do (_, _, _, _, a4) -> a4 end
      let wgen = if fine do Strata.Terrain.gen(fn (k, sd) -> StrataViewer.Fine.terrain(Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), sd)) else gen end
      let world = Strata.World.new(reg, wgen, seed, if fine do sc else scale end)
      let t0 = Strata.Ffi.Vk.time()
      -- the stream's focus is in metres, the camera in voxels
      let (s0, ticks) = settle_counted(Strata.Stream.set_focus(stream_start(world, r, levels), Cons((ex *. scale, ey *. scale, ez *. scale), Nil)), 0)
      let t1 = Strata.Ffi.Vk.time()
      let top = Strata.Stream.top_level(s0)
      if top > 0 do Authority.must(println("strata_viewer: far field: " ++ int_to_string(top) ++ " levels, " ++ int_to_string(Strata.Stream.loaded_count(s0)) ++ " chunks (" ++ per_level(Strata.Stream.world(s0), top) ++ ") settled after " ++ int_to_string(ticks) ++ " ticks in " ++ float_to_string(Math.round((t1 -. t0) *. 1000.0)) ++ " ms")) else ()
      end
      -- chunks are meshed out to one short of the radius, so the fog closes there; with levels, the outermost ring's
      Strata.Ffi.Vk.set_fog(fog_reach(r, top, sc) *. 0.55, fog_reach(r, top, sc))
      -- scene 4 empties the chunk holding the ground 40 m ahead, but only at
      -- frame 10, once the renderer holds and has drawn its mesh
      let hpx = float_to_int(Math.floor(ex +. Math.sin(yaw0) *. 40.0))
      let hpz = float_to_int(Math.floor(ez -. Math.cos(yaw0) *. 40.0))
      let hole0 = (Strata.Coord.chunk_of(hpx) * 32, Strata.Coord.chunk_of(land_height(land, hpx, hpz, seed)) * 32, Strata.Coord.chunk_of(hpz) * 32)
      -- a soak has no hole to dig: its circuit's centre rides in that slot, as does scene 134's blast
      let hole = if soak > 0 do mid else if scene == 134 do target else hole0 end end
      let s0i = scene_edits(scene, land, seed, s0, mx, mz, gy)
      -- scenes 25 and 26 level a pad 14 x 10 m ahead for their crates and slab: clear above the ground there, fill below; scene 31 one for its figures
      let pad = if scene == 31 do (mx - 10, ground_top(land, mx - 8, mz - 1, seed) + 1, mz - 5) else (float_to_int(Math.floor(ex)) - 5, ground_top(land, float_to_int(Math.floor(ex)) - 3, float_to_int(Math.floor(ez)) - 8, seed) + 1, float_to_int(Math.floor(ez)) - 12) end
      let s0e = if (scene != 25 && scene != 26 && scene != 31 && scene != 32 && scene != 33 && scene != 34) || fine do s0i
        else if scene == 33 || scene == 34 do
          -- scene 31's ground, levelled 32 m on toward the sun (+x, +z) and cleared 14 m up, so a low sun reaches the figures' grass
          let py = ground_top(land, mx - 8, mz - 1, seed) + 1
          let cleared = Strata.Stream.apply(s0i, Strata.Edit.fill_box(Strata.Stream.world(s0i), mx - 11, py, mz - 9, mx + 21, py + 14, mz + 23, 0))
          Strata.Stream.run_until_settled(Strata.Stream.apply(cleared, Strata.Edit.fill_box(Strata.Stream.world(cleared), mx - 11, py - 4, mz - 9, mx + 21, py - 1, mz + 23, 3)), 1000000)
        else if scene == 32 do
          -- the ground the forest camera stands on, levelled under the figure's path (5 m ahead, 1 to 5 m right): cleared 4 m up, filled 2 m down
          let py = ground_top(land, mx, mz, seed) + 1
          let cleared = Strata.Stream.apply(s0i, Strata.Edit.fill_box(Strata.Stream.world(s0i), mx - 2, py, mz + 3, mx + 3, py + 3, mz + 8, 0))
          Strata.Stream.run_until_settled(Strata.Stream.apply(cleared, Strata.Edit.fill_box(Strata.Stream.world(cleared), mx - 2, py - 2, mz + 3, mx + 3, py - 1, mz + 8, 3)), 1000000)
        else
          match pad do
            (px, py, pz) ->
              let cleared = Strata.Stream.apply(s0i, Strata.Edit.fill_box(Strata.Stream.world(s0i), px, py, pz, px + 14, py + 8, pz + 10, 0))
              Strata.Stream.run_until_settled(Strata.Stream.apply(cleared, Strata.Edit.fill_box(Strata.Stream.world(cleared), px, py - 4, pz, px + 14, py - 1, pz + 10, 3)), 1000000)
          end
        end end end
      let boxes = if soak > 0 do lake_boxes(a, scale) else Nil end
      let starts = lake_amounts(Strata.Stream.world(s0e), reg, boxes)
      let cx = Ctx(scale, seed, boxes, starts, (mx, mz, gy))
      match Strata.Render.sync(Strata.Render.new(16384), s0e) do
        (sl, s1) ->
          Authority.must(println("strata_viewer: " ++ int_to_string(Strata.Stream.loaded_count(s1)) ++ " chunks streamed in " ++ float_to_string(Math.round((t1 -. t0) *. 1000.0)) ++ " ms; " ++ int_to_string(Strata.Ffi.Vk.live_quads()) ++ " quads, " ++ int_to_string(Strata.Ffi.Vk.live_quads() * 8 / 1024) ++ " KB on the GPU"))
          -- the fixed scenes fly, holding their pose; the default and the walk scene stand on the ground
          let cam = Cam(ex, ey, ez, yaw0, pitch0, Strata.Coord.chunk_of(float_to_int(Math.floor(ex /. sc))), Strata.Coord.chunk_of(float_to_int(Math.floor(ey /. sc))), Strata.Coord.chunk_of(float_to_int(Math.floor(ez /. sc))), false, false, soak > 0 || (scene != 0 && scene != 11), 0.0, false, false, int_to_float(Authority.must(Env.get_int("STRATA_SUN", 55))), Authority.must(Env.get_int("STRATA_LIGHT", 4)), false, level_bits(start_level()), 0.0, 0, false)
          -- physics: the walker is a driven body; scene 26 leans a slab on a crate
          -- support: on when playing and in a match, off in other scripted runs unless STRATA_SUPPORT=1 (the stored scenes dig and breach without it); anchored deep under the terrain
          let support = Authority.must(Env.get_int("STRATA_SUPPORT", if frames > 0 && Authority.must(Env.get_int("STRATA_COMBAT", 0)) != 1 do 0 else 1 end)) == 1
          let ph0 = Strata.Physics.new(reg, Strata.Physics.with_support(Strata.Physics.with_scale(Strata.Physics.config(), sc), support, if fine do -10 else 4 end))
          let ph1 = if scene != 26 || fine do ph0
            else
              -- the crate 8 m ahead and a little left; the slab runs to its right, across the view
              let ax = ex -. 3.0
              let az = ez -. 8.0
              let gy = match pad do (_, py, _) -> int_to_float(py) end
              let pc = add_crate(ph0, ax, gy, az, sc)
              -- its high end on the crate, its low end on the ground toward +x: tilted toward the sun
              -- 6 m long so it leans at 19.5 degrees: friction (0.6) holds it; at 30 degrees it slid off
              match Strata.Physics.add(pc, slab_body(0, Strata.Body.grid(6, 1, 2)), ax +. 1.9, gy +. 2.05, az, Strata.Math.Quat.from_axis_angle(0.0, 0.0, 1.0, -0.34), Strata.Physics.dynamic()) do
                (p2, _) -> p2
              end
            end
          -- scene 28 sets a crate on the first dry ground ahead of the shore camera; STRATA_CRATES=n drops n crates in view (timing)
          let ph1b = if scene == 28 && !fine do shore_crate(ph1, land, ex, ez, yaw0, seed, sc, 4) else ph1 end
          let ph1c = crates_in_view(ph1b, land, ex, ez, yaw0, seed, sc, Authority.must(Env.get_int("STRATA_CRATES", 0)), 0)
          let rig = match StrataViewer.Walker.add_to(ph1c, StrataViewer.Walker.body(ex, ey, ez)) do
              (p3, me) -> PhysRig(p3, None, me, false, sc, Strata.Ffi.Vk.time())
            end
          -- figures: scene 31 the humanoid's seven clips side by side, 32 one walking across the forest floor, STRATA_FIGURES=n a crowd
          let crowd = crowd_for(scene, Authority.must(Env.get_int("STRATA_FIGURES", 0)), Strata.Stream.world(s1), ex, ey, ez, yaw0)
          let _ = if Authority.must(Env.get_int("STRATA_FIGURES", 0)) > 0 do Authority.must(println("strata_viewer: " ++ int_to_string(StrataViewer.Figures.walking(crowd)) ++ " of " ++ int_to_string(Authority.must(Env.get_int("STRATA_FIGURES", 0))) ++ " figures on dry ground")) else () end
          -- STRATA_COMBAT=1: the free-for-all (StrataViewer.Match); its figures take the crowd's place
          let mt0 = if Authority.must(Env.get_int("STRATA_COMBAT", 0)) == 1 && !fine do StrataViewer.Match.with_nav(StrataViewer.Match.start(seed, Strata.Stream.world(s1), ex, ey, ez, r, Authority.must(Env.get_int("STRATA_COMBAT_PLAYER", 1)) == 1, combat_scene(Authority.must(Env.get("STRATA_COMBAT_SCENE", ""))), combat_script(Authority.must(Env.get("STRATA_COMBAT_SCRIPT", ""))), Authority.must(Env.get_int("STRATA_COMBAT_WIN", 30)), Authority.must(Env.get_int("STRATA_COMBAT_REPEAT", 0)), Authority.must(Env.get_int("STRATA_COMBAT_ARENA", 1)) == 1), Authority.must(Env.get_int("STRATA_COMBAT_NAV", 1)) == 1) else StrataViewer.Match.off() end
          let sl_f = if StrataViewer.Match.is_on(mt0) do Strata.Render.figures(sl, StrataViewer.Match.anim(mt0), StrataViewer.Match.rigs(mt0))
            else if StrataViewer.Figures.walking(crowd) > 0 || scene == 31 || scene == 35 do Strata.Render.figures(sl, StrataViewer.Figures.anim(crowd), StrataViewer.Figures.rigs(crowd)) else sl end end
          frame_loop(s1, new_fluid(reg, g, scale), None, sl_f, reg, cx, cam, rig, 0, frames, if soak > 0 do 2 else if scene == 11 && frames > 0 do 1 else if scene == 4 && frames > 0 do 3 else if scene == 134 && frames > 0 do 4 else 0 end end end end, hole, tl, 0.0, 0.0, 0.0, Strata.Ffi.Vk.time(), Strata.Ffi.Vk.time(), NativeArray.make_f32(16, 0.0), audio_start(frames), 0.0, crowd, mt0, Strata.Falls.none())
      end
      Strata.Ffi.Vk.close()
    end
  end
end
