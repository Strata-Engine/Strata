-- The viewer's display: a crosshair, a hotbar of nine block icons, and a
-- readout. Built afresh each frame with Strata.Ui.
mod StrataViewer.Hud do

  doc "The block each hotbar slot places."
  fn slot_block(slot : Int) : Int do
    if slot == 0 do 1 else if slot == 1 do 2 else if slot == 2 do 3 else if slot == 3 do 4 else if slot == 4 do 6
    else if slot == 5 do 7 else if slot == 6 do 8 else if slot == 7 do 10 else 13 end end end end end end end end
  end

  -- the texture layer shown for each slot
  pfn slot_icon(slot : Int) : Int do
    if slot == 0 do 1 else if slot == 1 do 2 else if slot == 2 do 3 else if slot == 3 do 4 else if slot == 4 do 6
    else if slot == 5 do 7 else if slot == 6 do 8 else if slot == 7 do 10 else 12 end end end end end end end end
  end

  doc "The interface atlas's size in pixels."
  fn atlas_w() : Int do 64 end
  fn atlas_h() : Int do 32 end
  -- its regions: a slot's dark plate, the bright ring round the chosen slot, a round-cornered panel
  fn plate() : (Int, Int, Int, Int) do (0, 0, 24, 24) end
  fn ring() : (Int, Int, Int, Int) do (24, 0, 24, 24) end

  pfn put(a : NativeU8Arr, x : Int, y : Int, r : Int, g : Int, b : Int, alpha : Int) : NativeU8Arr do
    let o = 4 * (y * atlas_w() + x)
    NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(a, o, r), o + 1, g), o + 2, b), o + 3, alpha)
  end

  -- how far a pixel of a 24 x 24 region is from the region's edge, 0 at the rim
  pfn inset(x : Int, y : Int) : Int do
    let a = if x < 23 - x do x else 23 - x end
    let b = if y < 23 - y do y else 23 - y end
    if a < b do a else b end
  end

  pfn pixel(a : NativeU8Arr, x : Int, y : Int) : NativeU8Arr do
    if x < 24 && y < 24 do
      let d = inset(x, y)
      -- the corner pixels are clear, so the plate's corners look cut
      if d == 0 && inset(y, x) == 0 && (x == 0 || x == 23) && (y == 0 || y == 23) do put(a, x, y, 0, 0, 0, 0)
      else if d == 0 do put(a, x, y, 12, 12, 16, 230)
      else if d == 1 do put(a, x, y, 96, 98, 108, 230)
      else put(a, x, y, 26, 27, 33, 150) end end end
    else if x < 48 && y < 24 do
      let d = inset(x - 24, y)
      if d == 0 || d == 3 do put(a, x, y, 10, 10, 12, 255)
      else if d < 3 do put(a, x, y, 250, 246, 225, 255)
      else put(a, x, y, 0, 0, 0, 0) end end
    else put(a, x, y, 255, 255, 255, 255) end end
  end

  pfn paint(a : NativeU8Arr, i : Int) : NativeU8Arr do
    if i >= atlas_w() * atlas_h() do a else paint(pixel(a, i % atlas_w(), i / atlas_w()), i + 1) end
  end

  doc "The viewer's interface art, painted in code: four bytes a pixel."
  fn atlas() : NativeU8Arr do paint(NativeArray.make_u8(atlas_w() * atlas_h() * 4, 0), 0) end

  pfn slots(u : Strata.Ui.Ui, i : Int, chosen : Int) : Strata.Ui.Ui do
    if i >= 9 do u
    else
      let x = int_to_float(i - 4) *. 48.0
      let plated = Strata.Ui.frame(u, Strata.Ui.bottom(), x, -12.0, 44.0, 44.0, plate(), 4, (1.0, 1.0, 1.0, 1.0))
      let iconed = Strata.Ui.icon(plated, Strata.Ui.bottom(), x, -18.0, 32.0, slot_icon(i))
      slots(if i == chosen do Strata.Ui.frame(iconed, Strata.Ui.bottom(), x, -10.0, 48.0, 48.0, ring(), 5, (1.0, 1.0, 1.0, 1.0)) else iconed end, i + 1, chosen)
    end
  end

  pfn crosshair(u : Strata.Ui.Ui) : Strata.Ui.Ui do
    let dark = (0.0, 0.0, 0.0, 0.45)
    let light = (1.0, 1.0, 1.0, 0.9)
    let a = Strata.Ui.rect(Strata.Ui.rect(u, Strata.Ui.centre(), 0.0, 0.0, 4.0, 18.0, dark), Strata.Ui.centre(), 0.0, 0.0, 18.0, 4.0, dark)
    Strata.Ui.rect(Strata.Ui.rect(a, Strata.Ui.centre(), 0.0, 0.0, 2.0, 16.0, light), Strata.Ui.centre(), 0.0, 0.0, 16.0, 2.0, light)
  end

  doc "The display for one frame: the crosshair and the hotbar with slot [chosen] ringed."
  fn build(u : Strata.Ui.Ui, chosen : Int) : Strata.Ui.Ui do
    slots(crosshair(u), 0, chosen)
  end

  doc "[n] one-pixel rects: more than the layer holds, to show that the extra are dropped and counted."
  fn flood(u : Strata.Ui.Ui, i : Int, n : Int) : Strata.Ui.Ui do
    if i >= n do u
    else flood(Strata.Ui.rect(u, Strata.Ui.top_left(), int_to_float(i % 400) *. 3.0, int_to_float(i / 400) *. 3.0, 2.0, 2.0, (1.0, 0.8, 0.2, 1.0)), i + 1, n) end
  end

  doc "Five frames of growing size, from smaller than twice the border to wide: what nine-slicing keeps and what it stretches."
  fn frames(u : Strata.Ui.Ui) : Strata.Ui.Ui do
    let w = (1.0, 1.0, 1.0, 1.0)
    let a = Strata.Ui.frame(u, Strata.Ui.top_left(), 20.0, 20.0, 6.0, 6.0, plate(), 4, w)
    let b = Strata.Ui.frame(a, Strata.Ui.top_left(), 40.0, 20.0, 24.0, 24.0, plate(), 4, w)
    let c = Strata.Ui.frame(b, Strata.Ui.top_left(), 80.0, 20.0, 120.0, 40.0, plate(), 4, w)
    let d = Strata.Ui.frame(c, Strata.Ui.top_left(), 220.0, 20.0, 40.0, 160.0, ring(), 5, w)
    let e = Strata.Ui.frame(d, Strata.Ui.top_left(), 280.0, 20.0, 300.0, 200.0, ring(), 5, w)
    Strata.Ui.image(e, Strata.Ui.top_left(), 600.0, 20.0, 96.0, 96.0, plate(), w)
  end
end
