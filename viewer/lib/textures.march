-- The viewer's block textures, painted in code so the repository ships no
-- image files: 16 x 16 RGBA tiles, deterministic, one per texture id.
--
--   0 missing (magenta and black checks: what a bad texture id shows)
--   1 stone   2 soil   3 grass top   4 sand   5 water   6 snow
--   7 bark    8 leaves (with holes)  9 grass side (soil with a green lip)
mod StrataViewer.Textures do

  doc "How many texture layers the viewer uses."
  fn count() : Int do 10 end
  doc "Pixels on a tile's side."
  fn size() : Int do 16 end

  -- a hash of a pixel and a salt, 0..255
  pfn noise(x : Int, y : Int, salt : Int) : Int do
    let h0 = int_and(x * 374761393 + y * 668265263 + salt * 1274126177, 2147483647)
    let h1 = int_xor(h0, h0 / 8192)
    let h2 = int_and(h1 * 1103515245 + 12345, 2147483647)
    int_and(int_xor(h2, h2 / 65536), 255)
  end

  pfn clamp8(v : Int) : Int do if v < 0 do 0 else if v > 255 do 255 else v end end end

  pfn put(a : NativeU8Arr, x : Int, y : Int, r : Int, g : Int, b : Int, alpha : Int) : NativeU8Arr do
    let i = 4 * (x + 16 * y)
    NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(a, i, clamp8(r)), i + 1, clamp8(g)), i + 2, clamp8(b)), i + 3, clamp8(alpha))
  end

  -- a colour jittered by the pixel's noise: [amount] is the spread of the jitter
  pfn speck(a : NativeU8Arr, x : Int, y : Int, r : Int, g : Int, b : Int, amount : Int, salt : Int, alpha : Int) : NativeU8Arr do
    let d = (noise(x, y, salt) - 128) * amount / 128
    put(a, x, y, r + d, g + d, b + d, alpha)
  end

  pfn pixel(a : NativeU8Arr, id : Int, x : Int, y : Int) : NativeU8Arr do
    if id == 1 do
      -- stone: grey with darker cracks along two noisy lines
      let crack = noise(x / 3, y / 2, 11) > 215
      speck(a, x, y, if crack do 92 else 132 end, if crack do 93 else 133 end, if crack do 98 else 138 end, 14, 1, 255)
    else if id == 2 do speck(a, x, y, 122, 86, 56, 20, 2, 255)
    else if id == 3 do speck(a, x, y, 88, 158, 60, 22, 3, 255)
    else if id == 4 do speck(a, x, y, 196, 180, 124, 12, 4, 255)
    else if id == 5 do speck(a, x, y, 44, 110, 186, 8, 5, 178)
    else if id == 6 do speck(a, x, y, 232, 236, 242, 6, 6, 255)
    else if id == 7 do
      -- bark: vertical streaks
      let streak = (noise(x, 0, 7) - 128) / 6
      speck(a, x, y, 104 + streak, 72 + streak, 42 + streak, 8, 8, 255)
    else if id == 8 do
      -- leaves: about a sixth of the tile is holes, in 2 x 2 clumps, the same green underneath so mips do not darken
      speck(a, x, y, 52, 122, 44, 26, 9, if noise(x / 2, y / 2, 10) < 44 do 0 else 255 end)
    else if id == 9 do
      -- grass side: a green lip three or four pixels deep over soil
      let lip = 3 + noise(x, 0, 12) / 128
      if y < lip do speck(a, x, y, 88, 158, 60, 22, 3, 255) else speck(a, x, y, 122, 86, 56, 20, 2, 255) end
    else
      -- missing: magenta and black checks
      if ((x / 4) + (y / 4)) % 2 == 0 do put(a, x, y, 255, 0, 255, 255) else put(a, x, y, 0, 0, 0, 255) end
    end end end end end end end end end
  end

  pfn fill(a : NativeU8Arr, id : Int, i : Int) : NativeU8Arr do
    if i >= 256 do a else fill(pixel(a, id, i % 16, i / 16), id, i + 1) end
  end

  doc "The 16 x 16 RGBA tile for texture id [id], rows running downward. An id outside 1..9 gives the 'missing' checks."
  fn tile(id : Int) : NativeU8Arr do fill(NativeArray.make_u8(1024, 0), id, 0) end
end
