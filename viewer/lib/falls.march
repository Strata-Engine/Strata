-- Falls — spray where a river drops. The island's rivers are still water
-- (the sea's block, set above sea level): no fluid moves in them, so the
-- fluid's own splashes never happen there. This finds the places a river's
-- surface steps down and keeps spray rising at each.
--
-- A drop: a surface cell of river water (nothing of it above) above sea
-- level with, beside it at its own height, a cell that is neither water nor
-- solid, and water again 1 to 8 cells lower in that neighbouring column.
-- The foot of the fall is the top of that lower water.
--
-- Finding them reads many blocks, so it is done on a worker: every 5 s a
-- search of the 128 x 128 columns about the eye, from the sea up 64 m, is
-- begun on the world as it stands; 2 s later its answer is taken. Each frame
-- a twelfth of the drops found (those within 96 m) throw a little spray.
mod StrataViewer.Falls do

  needs IO.Spawn

  -- The search in flight, the drops known (x, y, z of the foot in metres, the height fallen in cells), and the frame the last search began.
  type FlFalls = FlFalls(Option(Task(List((Float, Float, Float, Int)))), List((Float, Float, Float, Int)), Int)

  doc "No drops known, no search begun."
  fn none() : FlFalls do FlFalls(None, Nil, -100000) end
  doc "How many drops are known."
  fn count(f : FlFalls) : Int do match f do FlFalls(_, ds, _) -> List.length(ds) end end

  -- water [water] 1 to 8 cells under (x, y, z): the y of its top cell, or -1000000
  pfn water_below(w : Strata.World.World, water : Int, x : Int, y : Int, z : Int, k : Int) : Int do
    if k > 8 do -1000000
    else
      let id = Strata.World.get_block(w, x, y - k, z)
      if id == water do y - k
      else if id != 0 && Strata.Blocks.collides(Strata.World.registry(w), id) do -1000000
      else water_below(w, water, x, y, z, k + 1) end end
    end
  end
  -- a drop from a surface cell at height y into the neighbouring column (nx, nz), added to acc
  pfn drop_to(w : Strata.World.World, water : Int, y : Int, nx : Int, nz : Int, acc : List((Float, Float, Float, Int))) : List((Float, Float, Float, Int)) do
    let side = Strata.World.get_block(w, nx, y, nz)
    if side == water do acc
    else if side != 0 && Strata.Blocks.collides(Strata.World.registry(w), side) do acc
    else
      let foot = water_below(w, water, nx, y, nz, 1)
      if foot < -999999 do acc else Cons((int_to_float(nx) +. 0.5, int_to_float(foot) +. 1.0, int_to_float(nz) +. 0.5, y - foot), acc) end
    end end
  end
  pfn column(w : Strata.World.World, water : Int, x : Int, z : Int, y : Int, y1 : Int, acc : List((Float, Float, Float, Int))) : List((Float, Float, Float, Int)) do
    if y > y1 do acc
    else if Strata.World.get_block(w, x, y, z) != water do column(w, water, x, z, y + 1, y1, acc)
    else if Strata.World.get_block(w, x, y + 1, z) == water do column(w, water, x, z, y + 1, y1, acc)
    else column(w, water, x, z, y + 1, y1, drop_to(w, water, y, x + 1, z, drop_to(w, water, y, x - 1, z, drop_to(w, water, y, x, z + 1, drop_to(w, water, y, x, z - 1, acc))))) end end end
  end
  pfn search(w : Strata.World.World, water : Int, sea : Int, x0 : Int, z0 : Int, i : Int, acc : List((Float, Float, Float, Int))) : List((Float, Float, Float, Int)) do
    if i >= 128 * 128 do acc
    else if List.length(acc) >= 512 do acc
    else search(w, water, sea, x0, z0, i + 1, column(w, water, x0 + i % 128, z0 + i / 128, sea + 1, sea + 64, acc)) end end
  end

  doc "Every drop of river water (block [water], above [sea]) in the 128 x 128 columns about (cx, cz) in world [w]: (the foot's x, y, z in metres, the cells fallen), 512 at most."
  fn find(w : Strata.World.World, water : Int, sea : Int, cx : Int, cz : Int) : List((Float, Float, Float, Int)) do
    search(w, water, sea, cx - 64, cz - 64, 0, Nil)
  end

  -- the drops' spray: each drop within 96 m throws some every twelfth frame, the drops taking turns
  pfn throw(ds : List((Float, Float, Float, Int)), ex : Float, ez : Float, frame : Int, i : Int) : Unit do
    match ds do
      Nil -> ()
      Cons((x, y, z, h), rest) ->
        if (frame + i) % 12 == 0 && (x -. ex) *. (x -. ex) +. (z -. ez) *. (z -. ez) < 9216.0 do
          let speed = 1.2 +. 0.8 *. Math.sqrt(int_to_float(h))
          let _ = Strata.Render.spray(x, y +. 0.2, z, 0.0, speed *. 0.5, 0.0, 3 + 2 * h, speed *. 0.45, 0.7, 13)
          throw(rest, ex, ez, frame, i + 1)
        else throw(rest, ex, ez, frame, i + 1) end
    end
  end

  doc "One frame: the search begun every 300 frames on world [w] about the eye (ex, ez) and taken 120 frames later, and this frame's spray thrown from the drops known. [water] is the river's block, [sea] the sea's level."
  fn step(f : FlFalls, w : Strata.World.World, water : Int, sea : Int, ex : Float, ez : Float, frame : Int) : FlFalls do
    match f do
      FlFalls(job, ds, begun) ->
        throw(ds, ex, ez, frame, 0)
        match job do
          Some(t) ->
            if frame - begun < 120 do f
            else
              match task_await(t) do
                Ok(found) -> FlFalls(None, found, begun)
                Err(_) -> FlFalls(None, ds, begun)
              end
            end
          None ->
            if frame - begun < 300 do f
            else
              let cx = float_to_int(Math.floor(ex))
              let cz = float_to_int(Math.floor(ez))
              FlFalls(Some(task_spawn(fn _ -> find(w, water, sea, cx, cz))), ds, frame)
            end
        end
    end
  end
end
