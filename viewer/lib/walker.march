-- Walker — the viewer's body: gravity, jumping and collision, with no window
-- and no input in it, so it can be tested. Movement rules belong to a game,
-- not to Strata; this is the viewer's.
--
-- The body is a box 0.6 m wide and 1.8 m tall. Its eyes are 0.7 m above its
-- centre, so 1.6 m above its feet.
mod StrataViewer.Walker do

  -- eye position in metres, vertical speed in m/s (up positive), on the ground
  type Body = Body(Float, Float, Float, Float, Bool)

  pfn half_w() : Float do 0.3 end
  pfn half_h() : Float do 0.9 end
  pfn eye_up() : Float do 0.7 end
  pfn gravity() : Float do 28.0 end
  pfn jump_speed() : Float do 8.5 end
  pfn max_fall() : Float do 60.0 end

  doc "A body with its eyes at (x, y, z), at rest in the air."
  fn body(x : Float, y : Float, z : Float) : Body do Body(x, y, z, 0.0, false) end

  doc "A body with its eyes at (x, y, z), moving vertically at [vy] m/s, on the ground or not."
  fn body_with(x : Float, y : Float, z : Float, vy : Float, on_ground : Bool) : Body do Body(x, y, z, vy, on_ground) end
  doc "Vertical speed in m/s, up positive."
  fn speed_y(b : Body) : Float do match b do Body(_, _, _, vy, _) -> vy end end

  fn eye_x(b : Body) : Float do match b do Body(x, _, _, _, _) -> x end end
  fn eye_y(b : Body) : Float do match b do Body(_, y, _, _, _) -> y end end
  fn eye_z(b : Body) : Float do match b do Body(_, _, z, _, _) -> z end end
  doc "Is the body standing on something?"
  fn grounded(b : Body) : Bool do match b do Body(_, _, _, _, g) -> g end end

  doc "Advance the body by [dt] seconds (clamped to 0.05). [move_x] and [move_z] are the horizontal velocity wanted, in m/s. [jump] starts a jump if the body is on the ground."
  fn step(w : Strata.World.World, b : Body, move_x : Float, move_z : Float, jump : Bool, dt0 : Float) : Body do
    let dt = if dt0 < 0.0 do 0.0 else if dt0 > 0.05 do 0.05 else dt0 end end
    match b do
      Body(x, y, z, vy, on_ground) ->
        let v0 = if jump && on_ground do jump_speed() else vy -. gravity() *. dt end
        let v1 = if v0 < 0.0 -. max_fall() do 0.0 -. max_fall() else v0 end
        let s = Strata.Query.sweep(w, x, y -. eye_up(), z, half_w(), half_h(), half_w(), move_x *. dt, v1 *. dt, move_z *. dt)
        let hit = Strata.Query.blocked_y(s)
        Body(Strata.Query.swept_x(s), Strata.Query.swept_y(s) +. eye_up(), Strata.Query.swept_z(s), if hit do 0.0 else v1 end, hit && v1 <= 0.0)
    end
  end

  doc "Make the body a driven body of physics [p]: a box its size, centred where it is. Returns its id."
  fn add_to(p : Strata.Physics.Physics, b : Body) : (Strata.Physics.Physics, Int) do
    Strata.Physics.add_driven(p, eye_x(b), eye_y(b) -. eye_up(), eye_z(b), half_w(), half_h(), half_w())
  end

  doc "As `step`, but moved by physics as driven body [id]: it stands on bodies, is stopped by heavy ones, and is carried by what it stands on."
  fn drive(p : Strata.Physics.Physics, w : Strata.World.World, id : Int, b : Body, move_x : Float, move_z : Float, jump : Bool, dt0 : Float) : (Strata.Physics.Physics, Body) do
    let dt = if dt0 < 0.0 do 0.0 else if dt0 > 0.05 do 0.05 else dt0 end end
    match b do
      Body(_, _, _, vy, on_ground) ->
        let v0 = if jump && on_ground do jump_speed() else vy -. gravity() *. dt end
        let v1 = if v0 < 0.0 -. max_fall() do 0.0 -. max_fall() else v0 end
        match Strata.Physics.drive(p, w, id, move_x, v1, move_z, dt) do
          (p2, s) ->
            let hit = Strata.Query.blocked_y(s)
            (p2, Body(Strata.Query.swept_x(s), Strata.Query.swept_y(s) +. eye_up(), Strata.Query.swept_z(s), if hit do 0.0 else v1 end, hit && v1 <= 0.0))
        end
    end
  end
end
