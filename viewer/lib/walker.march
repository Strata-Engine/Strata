-- Walker — the viewer's body: gravity, jumping and collision, with no window
-- and no input in it, so it can be tested. Movement rules belong to a game,
-- not to Strata; this is the viewer's.
--
-- The body is a box 0.6 m wide and 1.8 m tall. Its eyes are 0.7 m above its
-- centre, so 1.6 m above its feet.
mod StrataViewer.Walker do

  -- eye position in metres, vertical speed in m/s (up positive), on the ground
  type Body = Body(Float, Float, Float, Float, Bool)

  pfn half_w() : Float do 0.3 end
  pfn half_h() : Float do 0.9 end
  pfn eye_up() : Float do 0.7 end
  pfn gravity() : Float do 28.0 end
  pfn jump_speed() : Float do 8.5 end
  pfn max_fall() : Float do 60.0 end

  doc "A body with its eyes at (x, y, z), at rest in the air."
  fn body(x : Float, y : Float, z : Float) : Body do Body(x, y, z, 0.0, false) end

  doc "A body with its eyes at (x, y, z), moving vertically at [vy] m/s, on the ground or not."
  fn body_with(x : Float, y : Float, z : Float, vy : Float, on_ground : Bool) : Body do Body(x, y, z, vy, on_ground) end
  doc "Vertical speed in m/s, up positive."
  fn speed_y(b : Body) : Float do match b do Body(_, _, _, vy, _) -> vy end end

  fn eye_x(b : Body) : Float do match b do Body(x, _, _, _, _) -> x end end
  fn eye_y(b : Body) : Float do match b do Body(_, y, _, _, _) -> y end end
  fn eye_z(b : Body) : Float do match b do Body(_, _, z, _, _) -> z end end
  doc "Is the body standing on something?"
  fn grounded(b : Body) : Bool do match b do Body(_, _, _, _, g) -> g end end

  doc "Advance the body by [dt] seconds (clamped to 0.05). [move_x] and [move_z] are the horizontal velocity wanted, in m/s. [jump] starts a jump if the body is on the ground."
  fn step(w : Strata.World.World, b : Body, move_x : Float, move_z : Float, jump : Bool, dt0 : Float) : Body do
    let dt = if dt0 < 0.0 do 0.0 else if dt0 > 0.05 do 0.05 else dt0 end end
    match b do
      Body(x, y, z, vy, on_ground) ->
        let v0 = if jump && on_ground do jump_speed() else vy -. gravity() *. dt end
        let v1 = if v0 < 0.0 -. max_fall() do 0.0 -. max_fall() else v0 end
        let s = Strata.Query.sweep(w, x, y -. eye_up(), z, half_w(), half_h(), half_w(), move_x *. dt, v1 *. dt, move_z *. dt)
        let hit = Strata.Query.blocked_y(s)
        Body(Strata.Query.swept_x(s), Strata.Query.swept_y(s) +. eye_up(), Strata.Query.swept_z(s), if hit do 0.0 else v1 end, hit && v1 <= 0.0)
    end
  end

  -- ── In water ─────────────────────────────────────────────────────────────
  -- The body floats with its eyes about at the surface: it is as heavy as
  -- water when eight ninths of it are under.
  pfn afloat() : Float do 0.89 end
  pfn water_gravity() : Float do 10.0 end
  pfn swim_up() : Float do 4.0 end
  pfn current() : Float do 3.0 end

  pfn exp_decay(rate : Float, dt : Float) : Float do
    let k = 1.0 -. rate *. dt
    if k < 0.0 do 0.0 else k end
  end

  doc "How much of the body, with its eyes at (x, y, z), is under liquid: 0 to 1."
  fn wet(w : Strata.World.World, f : Strata.Fluid.Fluid, x : Float, y : Float, z : Float) : Float do
    let cy = y -. eye_up()
    Strata.Fluid.depth_in(f, w, x -. half_w(), cy -. half_h(), z -. half_w(), x +. half_w(), cy +. half_h(), z +. half_w())
  end

  doc "`step` for a body that may be in water. Out of water it is `step`. In it, the body is slowed, buoyed up until it floats with its eyes at the surface, and carried by the water's flow; [jump] swims upward, and at a bank it can touch, kicks hard enough to climb out."
  fn step_in(w : Strata.World.World, f : Strata.Fluid.Fluid, b : Body, move_x : Float, move_z : Float, jump : Bool, dt0 : Float) : Body do
    let dt = if dt0 < 0.0 do 0.0 else if dt0 > 0.05 do 0.05 else dt0 end end
    match b do
      Body(x, y, z, vy, on_ground) ->
        let k = wet(w, f, x, y, z)
        if k <= 0.0 do step(w, b, move_x, move_z, jump, dt0)
        else
          -- the water's flow where the body's middle and its feet are, whichever moves
          let cy = y -. eye_up()
          let mid = Strata.Fluid.flow(f, w, float_to_int(Math.floor(x)), float_to_int(Math.floor(cy)), float_to_int(Math.floor(z)))
          let low = Strata.Fluid.flow(f, w, float_to_int(Math.floor(x)), float_to_int(Math.floor(cy -. half_h() +. 0.05)), float_to_int(Math.floor(z)))
          let fl = match mid do (a, bb, c) -> if a == 0.0 && bb == 0.0 && c == 0.0 do low else mid end end
          let push = current() *. (if k < 0.25 do k *. 4.0 else 1.0 end)
          let slow = 1.0 -. 0.45 *. k
          let mx = move_x *. slow +. (match fl do (a, _, _) -> a end) *. push
          let mz = move_z *. slow +. (match fl do (_, _, c) -> c end) *. push
          -- ankle-deep, the body still walks and jumps; deeper, the water takes its weight
          let deep = k > 0.3
          let lift = water_gravity() *. (k /. afloat() -. 1.0)
          let v_fall = if deep do (vy +. lift *. dt) *. exp_decay(5.0 *. k, dt) else vy -. gravity() *. dt end
          let v_flow = v_fall +. (match fl do (_, d, _) -> d end) *. 6.0 *. k *. dt
          let v_swim = if jump && deep do v_flow +. (swim_up() -. v_flow) *. (if 6.0 *. dt > 1.0 do 1.0 else 6.0 *. dt end)
            else if jump && on_ground do jump_speed() else v_flow end end
          let v1 = if v_swim < 0.0 -. max_fall() do 0.0 -. max_fall() else v_swim end
          let s = Strata.Query.sweep(w, x, y -. eye_up(), z, half_w(), half_h(), half_w(), mx *. dt, v1 *. dt, mz *. dt)
          let hit = Strata.Query.blocked_y(s)
          -- swimming up against a bank: one kick, enough to clear a block
          let kick = jump && deep && k < afloat() +. 0.05 && (Strata.Query.blocked_x(s) || Strata.Query.blocked_z(s))
          Body(Strata.Query.swept_x(s), Strata.Query.swept_y(s) +. eye_up(), Strata.Query.swept_z(s), if kick do jump_speed() else if hit do 0.0 else v1 end end, hit && v1 <= 0.0)
        end
    end
  end
end
