-- MatchHud — what a match shows on screen (docs/2026-11-12-combat-design.md):
-- the player's health, the count, the kills told, the weapons on the hotbar,
-- the table, and the end. Drawn over the viewer's own display each frame.
mod StrataViewer.MatchHud do

  needs IO.Foreign

  alias Strata.Ui as Ui
  alias Strata.Text as Tx
  alias StrataViewer.Match as Mt

  pfn outlined() : Strata.Text.TextStyle do Tx.with_outline(Tx.style(), 1.0, (0.0, 0.0, 0.0, 0.85)) end
  pfn white() : (Float, Float, Float, Float) do (1.0, 1.0, 1.0, 1.0) end

  doc "The hotbar's icons in a match, as texture layers: the two weapons' slots are left empty for `draw`; then stone, dirt, sand, wood, leaves, glass, ice."
  fn icons() : List(Int) do [-1, -1, 1, 2, 4, 7, 8, 10, 12] end

  -- a bow in slot 1 and a flame in slot 2, made of rectangles: the interface atlas is left as it is
  pfn weapons(u : Strata.Ui.Ui) : Strata.Ui.Ui do
    let wood = (0.55, 0.36, 0.18, 1.0)
    let pale = (0.92, 0.90, 0.82, 1.0)
    let stave = Ui.rect(Ui.rect(Ui.rect(u, Ui.bottom(), -200.0, -22.0, 3.0, 24.0, wood), Ui.bottom(), -197.0, -44.0, 3.0, 4.0, wood), Ui.bottom(), -197.0, -20.0, 3.0, 4.0, wood)
    let bow = Ui.rect(Ui.rect(Ui.rect(stave, Ui.bottom(), -193.0, -21.0, 1.5, 26.0, pale), Ui.bottom(), -189.0, -33.0, 22.0, 2.0, pale), Ui.bottom(), -178.0, -32.0, 4.0, 4.0, (0.6, 0.6, 0.65, 1.0))
    let fire = Ui.rect(Ui.rect(bow, Ui.bottom(), -144.0, -22.0, 16.0, 10.0, (0.95, 0.38, 0.08, 1.0)), Ui.bottom(), -144.0, -32.0, 11.0, 8.0, (1.0, 0.55, 0.10, 1.0))
    Ui.rect(Ui.rect(fire, Ui.bottom(), -144.0, -40.0, 6.0, 7.0, (1.0, 0.82, 0.30, 1.0)), Ui.bottom(), -144.0, -24.0, 6.0, 5.0, (1.0, 0.9, 0.5, 1.0))
  end

  -- the player's health, bottom left: red under 30
  pfn bar(u : Strata.Ui.Ui, health : Int) : Strata.Ui.Ui do
    let h = if health < 0 do 0 else if health > 100 do 100 else health end end
    let back = Ui.rect(u, Ui.bottom_left(), 12.0, -12.0, 204.0, 18.0, (0.05, 0.05, 0.06, 0.75))
    let fill = if h == 0 do back else Ui.rect(back, Ui.bottom_left(), 14.0, -14.0, int_to_float(h) *. 2.0, 14.0, if h < 30 do (0.85, 0.12, 0.10, 1.0) else (0.30, 0.78, 0.25, 1.0) end) end
    Tx.styled(fill, Ui.bottom_left(), 224.0, -13.0, Tx.default_font(), 14.0, white(), outlined(), int_to_string(h))
  end

  pfn first_row(t : List((String, Int, Int))) : String do
    match t do
      Nil -> ""
      Cons((name, k, _), _) -> name ++ " " ++ int_to_string(k)
    end
  end
  pfn lines(u : Strata.Ui.Ui, l : List(String), y : Float) : Strata.Ui.Ui do
    match l do
      Nil -> u
      Cons(s, rest) -> lines(Tx.styled(u, Ui.top_left(), 10.0, y, Tx.default_font(), 15.0, (1.0, 0.93, 0.75, 1.0), outlined(), s), rest, y +. 19.0)
    end
  end
  -- a red edge while the player is hurt
  pfn edge(u : Strata.Ui.Ui) : Strata.Ui.Ui do
    let red = (0.9, 0.05, 0.05, 0.55)
    let w = Ui.width(u)
    let h = Ui.height(u)
    Ui.rect(Ui.rect(Ui.rect(Ui.rect(u, Ui.top_left(), 0.0, 0.0, w, 10.0, red), Ui.bottom_left(), 0.0, 0.0, w, 10.0, red), Ui.top_left(), 0.0, 10.0, 10.0, h -. 20.0, red), Ui.top_right(), 0.0, 10.0, 10.0, h -. 20.0, red)
  end
  pfn rows(u : Strata.Ui.Ui, t : List((String, Int, Int)), x : Float, y : Float) : Strata.Ui.Ui do
    match t do
      Nil -> u
      Cons((name, k, d), rest) ->
        let a = Tx.text(u, Ui.top_left(), x, y, Tx.default_font(), 16.0, white(), name)
        let b = Tx.text(a, Ui.top_left(), x +. 150.0, y, Tx.default_font(), 16.0, white(), int_to_string(k))
        rows(Tx.text(b, Ui.top_left(), x +. 205.0, y, Tx.default_font(), 16.0, (0.8, 0.8, 0.8, 1.0), int_to_string(d)), rest, x, y +. 21.0)
    end
  end
  -- the table on a dark plate in the middle of the screen, under a heading
  pfn table(u : Strata.Ui.Ui, m : StrataViewer.Match.MtMatch, heading : String, foot : String) : Strata.Ui.Ui do
    let x = Ui.width(u) /. 2.0 -. 130.0
    let y = Ui.height(u) /. 2.0 -. 175.0
    let plate = Ui.rect(u, Ui.top_left(), x -. 20.0, y -. 16.0, 300.0, 372.0, (0.03, 0.03, 0.05, 0.78))
    let head = Tx.text(Tx.text(Tx.text(plate, Ui.top_left(), x, y, Tx.default_font(), 20.0, (1.0, 0.93, 0.75, 1.0), heading), Ui.top_left(), x +. 150.0, y +. 34.0, Tx.default_font(), 12.0, (0.7, 0.7, 0.7, 1.0), "kills"), Ui.top_left(), x +. 205.0, y +. 34.0, Tx.default_font(), 12.0, (0.7, 0.7, 0.7, 1.0), "deaths")
    Tx.text(rows(head, Mt.table(m), x, y +. 54.0), Ui.top_left(), x, y +. 318.0, Tx.default_font(), 14.0, (0.8, 0.8, 0.8, 1.0), foot)
  end

  doc "The match's part of the display, over [u] (built with `Hud.build_bar` and `icons`): the weapons' icons, the player's health, the player's kills and the leader's, the kills told, a red edge when the player is hurt; the table while [show_table]; the winner and the table when the match is won."
  fn draw(u : Strata.Ui.Ui, m : StrataViewer.Match.MtMatch, show_table : Bool) : Strata.Ui.Ui do
    let u1 = weapons(u)
    let u2 = if Mt.has_player(m) do bar(u1, Mt.health(m, 0)) else u1 end
    let count = (if Mt.has_player(m) do "You " ++ int_to_string(Mt.kills(m, 0)) ++ "\n" else "" end) ++ first_row(Mt.table(m)) ++ "\nfirst to " ++ int_to_string(Mt.goal(m))
    let u3 = Tx.styled(u2, Ui.top_right(), -10.0, 8.0, Tx.default_font(), 16.0, white(), Tx.with_align(outlined(), Tx.align_right()), count)
    let u4 = lines(u3, Mt.feed(m), 84.0)
    let u5 = if Mt.hurt(m) do edge(u4) else u4 end
    let u6 = if Mt.paused(m) do Tx.styled(u5, Ui.centre(), 0.0, -60.0, Tx.default_font(), 22.0, white(), Tx.with_align(outlined(), Tx.align_centre()), "Paused: return to the field") else u5 end
    if Mt.ended(m) do table(u6, m, (if Mt.winner_name(m) == "You" do "You win" else Mt.winner_name(m) ++ " wins" end), "Press Enter for another")
    else if show_table do table(u6, m, "First to " ++ int_to_string(Mt.goal(m)), "")
    else u6 end end
  end
end
