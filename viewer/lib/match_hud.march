-- MatchHud — what a match shows on screen (docs/2026-11-12-combat-design.md):
-- the player's health, the count, the kills told, the weapons on the hotbar,
-- the table, and the end. Drawn over the viewer's own display each frame.
mod StrataViewer.MatchHud do

  needs IO.Foreign

  alias Strata.Ui as Ui
  alias Strata.Text as Tx
  alias StrataViewer.Match as Mt

  pfn outlined() : Strata.Text.TextStyle do Tx.with_outline(Tx.style(), 1.0, (0.0, 0.0, 0.0, 0.85)) end
  pfn white() : (Float, Float, Float, Float) do (1.0, 1.0, 1.0, 1.0) end

  doc "The hotbar's icons in a match, as texture layers: the four weapons' slots are left empty for `draw`; then stone, dirt, sand, wood, leaves."
  fn icons() : List(Int) do [-1, -1, -1, -1, 1, 2, 4, 7, 8] end

  -- a bow in slot 1 and a flame in slot 2, made of rectangles: the interface atlas is left as it is
  pfn weapons(u : Strata.Ui.Ui) : Strata.Ui.Ui do
    let wood = (0.55, 0.36, 0.18, 1.0)
    let pale = (0.92, 0.90, 0.82, 1.0)
    let stave = Ui.rect(Ui.rect(Ui.rect(u, Ui.bottom(), -200.0, -22.0, 3.0, 24.0, wood), Ui.bottom(), -197.0, -44.0, 3.0, 4.0, wood), Ui.bottom(), -197.0, -20.0, 3.0, 4.0, wood)
    let bow = Ui.rect(Ui.rect(Ui.rect(stave, Ui.bottom(), -193.0, -21.0, 1.5, 26.0, pale), Ui.bottom(), -189.0, -33.0, 22.0, 2.0, pale), Ui.bottom(), -178.0, -32.0, 4.0, 4.0, (0.6, 0.6, 0.65, 1.0))
    -- a sword in slot 2: a pale blade, a dark guard and grip
    let blade = Ui.rect(Ui.rect(Ui.rect(bow, Ui.bottom(), -144.0, -27.0, 4.0, 26.0, (0.85, 0.87, 0.92, 1.0)), Ui.bottom(), -144.0, -24.0, 14.0, 3.0, (0.35, 0.30, 0.22, 1.0)), Ui.bottom(), -144.0, -17.0, 4.0, 8.0, (0.45, 0.30, 0.15, 1.0))
    let fire = Ui.rect(Ui.rect(blade, Ui.bottom(), -88.0, -22.0, 16.0, 10.0, (0.95, 0.38, 0.08, 1.0)), Ui.bottom(), -88.0, -32.0, 11.0, 8.0, (1.0, 0.55, 0.10, 1.0))
    let flame = Ui.rect(Ui.rect(fire, Ui.bottom(), -88.0, -40.0, 6.0, 7.0, (1.0, 0.82, 0.30, 1.0)), Ui.bottom(), -88.0, -24.0, 6.0, 5.0, (1.0, 0.9, 0.5, 1.0))
    -- an iceball in slot 4: a pale blue lump with a white heart
    Ui.rect(Ui.rect(Ui.rect(flame, Ui.bottom(), -32.0, -22.0, 18.0, 18.0, (0.40, 0.72, 0.95, 1.0)), Ui.bottom(), -32.0, -24.0, 12.0, 14.0, (0.62, 0.88, 1.0, 1.0)), Ui.bottom(), -32.0, -27.0, 6.0, 7.0, (0.95, 0.98, 1.0, 1.0))
  end

  -- the player's health, bottom left: red under 30
  pfn bar(u : Strata.Ui.Ui, health : Int) : Strata.Ui.Ui do
    let h = if health < 0 do 0 else if health > 100 do 100 else health end end
    let back = Ui.rect(u, Ui.bottom_left(), 12.0, -12.0, 204.0, 18.0, (0.05, 0.05, 0.06, 0.75))
    let fill = if h == 0 do back else Ui.rect(back, Ui.bottom_left(), 14.0, -14.0, int_to_float(h) *. 2.0, 14.0, if h < 30 do (0.85, 0.12, 0.10, 1.0) else (0.30, 0.78, 0.25, 1.0) end) end
    Tx.styled(fill, Ui.bottom_left(), 224.0, -13.0, Tx.default_font(), 14.0, white(), outlined(), int_to_string(h))
  end

  pfn first_row(t : List((String, Int, Int))) : String do
    match t do
      Nil -> ""
      Cons((name, k, _), _) -> name ++ " " ++ int_to_string(k)
    end
  end
  pfn lines(u : Strata.Ui.Ui, l : List(String), y : Float) : Strata.Ui.Ui do
    match l do
      Nil -> u
      Cons(s, rest) -> lines(Tx.styled(u, Ui.top_left(), 10.0, y, Tx.default_font(), 15.0, (1.0, 0.93, 0.75, 1.0), outlined(), s), rest, y +. 19.0)
    end
  end
  -- a red edge while the player is hurt
  pfn edge(u : Strata.Ui.Ui) : Strata.Ui.Ui do
    let red = (0.9, 0.05, 0.05, 0.55)
    let w = Ui.width(u)
    let h = Ui.height(u)
    Ui.rect(Ui.rect(Ui.rect(Ui.rect(u, Ui.top_left(), 0.0, 0.0, w, 10.0, red), Ui.bottom_left(), 0.0, 0.0, w, 10.0, red), Ui.top_left(), 0.0, 10.0, 10.0, h -. 20.0, red), Ui.top_right(), 0.0, 10.0, 10.0, h -. 20.0, red)
  end
  pfn rows(u : Strata.Ui.Ui, t : List((String, Int, Int)), x : Float, y : Float) : Strata.Ui.Ui do
    match t do
      Nil -> u
      Cons((name, k, d), rest) ->
        let a = Tx.text(u, Ui.top_left(), x, y, Tx.default_font(), 16.0, white(), name)
        let b = Tx.text(a, Ui.top_left(), x +. 150.0, y, Tx.default_font(), 16.0, white(), int_to_string(k))
        rows(Tx.text(b, Ui.top_left(), x +. 205.0, y, Tx.default_font(), 16.0, (0.8, 0.8, 0.8, 1.0), int_to_string(d)), rest, x, y +. 21.0)
    end
  end
  -- the table on a dark plate in the middle of the screen, under a heading
  pfn table(u : Strata.Ui.Ui, m : StrataViewer.Match.MtMatch, heading : String, foot : String) : Strata.Ui.Ui do
    let x = Ui.width(u) /. 2.0 -. 130.0
    let y = Ui.height(u) /. 2.0 -. 175.0
    let plate = Ui.rect(u, Ui.top_left(), x -. 20.0, y -. 16.0, 300.0, 372.0, (0.03, 0.03, 0.05, 0.78))
    let head = Tx.text(Tx.text(Tx.text(plate, Ui.top_left(), x, y, Tx.default_font(), 20.0, (1.0, 0.93, 0.75, 1.0), heading), Ui.top_left(), x +. 150.0, y +. 34.0, Tx.default_font(), 12.0, (0.7, 0.7, 0.7, 1.0), "kills"), Ui.top_left(), x +. 205.0, y +. 34.0, Tx.default_font(), 12.0, (0.7, 0.7, 0.7, 1.0), "deaths")
    Tx.text(rows(head, Mt.table(m), x, y +. 54.0), Ui.top_left(), x, y +. 318.0, Tx.default_font(), 14.0, (0.8, 0.8, 0.8, 1.0), foot)
  end

  -- A compass along the top: a strip standing for the whole turn (the middle is straight ahead, the ends behind), a mark for each living fighter in its shirt's
  -- colour where it stands, fainter the further off, and under the nearest its name and distance.
  pfn marks(u : Strata.Ui.Ui, bs : List((Float, Float, Int))) : Strata.Ui.Ui do
    match bs do
      Nil -> u
      Cons((rel, metres, i), rest) ->
        match Mt.shirt_of(i) do
          (r, g, b) ->
            let x = 0.0 -. rel /. 3.14159265 *. 210.0
            let near = if metres < 15.0 do 1.0 else if metres > 90.0 do 0.35 else 1.0 -. (metres -. 15.0) /. 75.0 *. 0.65 end end
            let outlined_ = Ui.rect(u, Ui.top(), x, 9.0, 9.0, 18.0, (0.0, 0.0, 0.0, near))
            marks(Ui.rect(outlined_, Ui.top(), x, 11.0, 6.0, 14.0, (r *. 1.6 +. 0.15, g *. 1.6 +. 0.15, b *. 1.6 +. 0.15, near)), rest)
        end
    end
  end
  pfn nearest_of(bs : List((Float, Float, Int)), best : (Float, Float, Int)) : (Float, Float, Int) do
    match bs do
      Nil -> best
      Cons((rel, metres, i), rest) -> match best do (_, bm, _) -> nearest_of(rest, if metres < bm do (rel, metres, i) else best end) end
    end
  end
  -- the pickups lying ready, under the strip: orange for fire, pale blue for ice, white with a red cross for health
  pfn pick_marks(u : Strata.Ui.Ui, ps : List((Int, Float, Float))) : Strata.Ui.Ui do
    match ps do
      Nil -> u
      Cons((kind, rel, _), rest) ->
        let x = 0.0 -. rel /. 3.14159265 *. 210.0
        let back = Ui.rect(u, Ui.top(), x, 29.0, 10.0, 10.0, (0.0, 0.0, 0.0, 0.9))
        let body_ = Ui.rect(back, Ui.top(), x, 30.0, 8.0, 8.0, if kind == 1 do (1.0, 0.55, 0.10, 1.0) else if kind == 2 do (0.55, 0.85, 1.0, 1.0) else (0.95, 0.95, 0.95, 1.0) end end)
        pick_marks(if kind != 0 do body_ else Ui.rect(Ui.rect(body_, Ui.top(), x, 33.0, 6.0, 2.0, (0.9, 0.08, 0.08, 1.0)), Ui.top(), x, 31.0, 2.0, 6.0, (0.9, 0.08, 0.08, 1.0)) end, rest)
    end
  end
  -- how many of a thrown weapon are held, on its slot; the slot is dimmed with none
  pfn count_on(u : Strata.Ui.Ui, x : Float, n : Int) : Strata.Ui.Ui do
    let dim = if n > 0 do u else Ui.rect(u, Ui.bottom(), x, -14.0, 40.0, 40.0, (0.0, 0.0, 0.0, 0.6)) end
    Tx.styled(dim, Ui.bottom(), x +. 14.0, -30.0, Tx.default_font(), 14.0, white(), outlined(), int_to_string(n))
  end
  pfn held(u : Strata.Ui.Ui, m : StrataViewer.Match.MtMatch) : Strata.Ui.Ui do
    if !Mt.has_arena(m) do u else count_on(count_on(u, -88.0, Mt.fireballs(m)), -32.0, Mt.iceballs(m)) end
  end
  pfn compass(u : Strata.Ui.Ui, m : StrataViewer.Match.MtMatch) : Strata.Ui.Ui do
    let bs = Mt.bearings(m)
    let strip = Ui.rect(Ui.rect(u, Ui.top(), 0.0, 8.0, 436.0, 20.0, (0.03, 0.03, 0.05, 0.55)), Ui.top(), 0.0, 8.0, 2.0, 20.0, (1.0, 1.0, 1.0, 0.7))
    let marked = marks(pick_marks(strip, Mt.pickups(m)), bs)
    match nearest_of(bs, (0.0, 1000000.0, -1)) do
      (rel, metres, i) ->
        if i < 0 do marked
        else Tx.styled(marked, Ui.top(), 0.0 -. rel /. 3.14159265 *. 210.0, 42.0, Tx.default_font(), 13.0, white(), Tx.with_align(outlined(), Tx.align_centre()), Mt.name_of(m, i) ++ " " ++ int_to_string(float_to_int(metres)) ++ " m") end
    end
  end

  -- the player's hits: a mark about the crosshair while one is fresh (red for a kill), and what each did, rising beside it
  pfn hit_marks(u : Strata.Ui.Ui, hs : List((Int, Float, Bool)), k : Int) : Strata.Ui.Ui do
    match hs do
      Nil -> u
      Cons((dmg, age, kill), rest) ->
        let fade = if age > 0.5 do 1.0 -. (age -. 0.5) /. 0.4 else 1.0 end
        let c = if kill do (1.0, 0.25, 0.2, fade) else (1.0, 1.0, 1.0, fade) end
        let marked = if k > 0 || age > 0.25 do u
          else Ui.rect(Ui.rect(Ui.rect(Ui.rect(u, Ui.centre(), -11.0, -11.0, 6.0, 6.0, c), Ui.centre(), 11.0, -11.0, 6.0, 6.0, c), Ui.centre(), -11.0, 11.0, 6.0, 6.0, c), Ui.centre(), 11.0, 11.0, 6.0, 6.0, c) end
        if k >= 4 do marked
        else hit_marks(Tx.styled(marked, Ui.centre(), 26.0 +. int_to_float(k) *. 30.0, -14.0 -. age *. 40.0, Tx.default_font(), if kill do 18.0 else 15.0 end, c, outlined(), int_to_string(dmg)), rest, k + 1) end
    end
  end
  -- under the crosshair: how far the bow is drawn; "BLOCK" while blocking; "CHILLED" while slowed
  pfn stance(u : Strata.Ui.Ui, m : StrataViewer.Match.MtMatch) : Strata.Ui.Ui do
    let d = Mt.drawn(m)
    let u1 = if d <= 0.0 do u
      else Ui.rect(Ui.rect(u, Ui.centre(), 0.0, 22.0, 64.0, 7.0, (0.0, 0.0, 0.0, 0.6)), Ui.centre(), 0.0, 22.0, 60.0 *. d, 3.0, if d >= 1.0 do (1.0, 0.85, 0.3, 1.0) else (1.0, 1.0, 1.0, 0.95) end) end
    let u2 = if Mt.blocking(m) do Tx.styled(u1, Ui.centre(), 0.0, 34.0, Tx.default_font(), 14.0, (0.8, 0.9, 1.0, 1.0), Tx.with_align(outlined(), Tx.align_centre()), "BLOCK") else u1 end
    if Mt.chilled(m) do Tx.styled(u2, Ui.centre(), 0.0, 50.0, Tx.default_font(), 13.0, (0.55, 0.85, 1.0, 1.0), Tx.with_align(outlined(), Tx.align_centre()), "CHILLED") else u2 end
  end
  -- the player's breath, a thin bar over its health
  pfn breath_bar(u : Strata.Ui.Ui, s : Float) : Strata.Ui.Ui do
    Ui.rect(Ui.rect(u, Ui.bottom_left(), 12.0, -34.0, 204.0, 6.0, (0.05, 0.05, 0.06, 0.75)), Ui.bottom_left(), 14.0, -35.0, 200.0 *. s, 4.0, (0.95, 0.85, 0.35, 1.0))
  end

  doc "The match's part of the display, over [u] (built with `Hud.build_bar` and `icons`): the weapons' icons, the player's health, a compass marking every living fighter, the player's kills and the leader's, the kills told, a red edge when the player is hurt; the table while [show_table]; the winner and the table when the match is won."
  fn draw(u : Strata.Ui.Ui, m : StrataViewer.Match.MtMatch, show_table : Bool) : Strata.Ui.Ui do
    let u1 = held(weapons(u), m)
    let u2 = if Mt.has_player(m) do stance(hit_marks(breath_bar(compass(bar(u1, Mt.health(m, 0)), m), Mt.breath(m)), Mt.hits(m), 0), m) else u1 end
    let count = (if Mt.has_player(m) do "You " ++ int_to_string(Mt.kills(m, 0)) ++ "\n" else "" end) ++ first_row(Mt.table(m)) ++ "\nfirst to " ++ int_to_string(Mt.goal(m))
    let u3 = Tx.styled(u2, Ui.top_right(), -10.0, 8.0, Tx.default_font(), 16.0, white(), Tx.with_align(outlined(), Tx.align_right()), count)
    let u4 = lines(u3, Mt.feed(m), 84.0)
    let u5 = if Mt.hurt(m) do edge(u4) else u4 end
    let u6 = if Mt.paused(m) do Tx.styled(u5, Ui.centre(), 0.0, -60.0, Tx.default_font(), 22.0, white(), Tx.with_align(outlined(), Tx.align_centre()), "Paused: return to the field") else u5 end
    if Mt.ended(m) do table(u6, m, (if Mt.winner_name(m) == "You" do "You win" else Mt.winner_name(m) ++ " wins" end), "Press Enter for another")
    else if show_table do table(u6, m, "First to " ++ int_to_string(Mt.goal(m)), "")
    else u6 end end
  end
end
