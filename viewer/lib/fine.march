-- Fine — the viewer's 10 cm world (STRATA_SCALE=0.1): flat ground with
-- things to knock down. All positions are voxels (10 cm), the ground's top
-- at y = 0.
--
--   a hollow stone tower, 3 x 3 m and 8 m tall, walls 30 cm thick
--   a free-standing stone wall, 8 m long, 3 m high, 30 cm thick
--   a stone cliff 13 m high, its face looking toward +z, 12 m wide and 8 m deep
--   a stream: a channel 1 m wide, 40 cm of still water in it, 20 m long
--
-- A pure function of the chunk and the seed (the seed is not used: the
-- layout is fixed so the scenes can find it).
mod StrataViewer.Fine do

  doc "The viewer's stone block id."
  fn stone() : Int do 1 end
  pfn dirt() : Int do 2 end
  pfn grass() : Int do 3 end
  -- a full voxel of lake water: StrataViewer.lake_base() + 7
  pfn water() : Int do 21 end

  doc "The tower: low corner x, z, its side and its height."
  fn tower() : (Int, Int, Int, Int) do (40, -15, 30, 80) end
  doc "The wall: low corner x, z, its length along x, height and thickness."
  fn wall() : (Int, Int, Int, Int, Int) do (-40, -50, 80, 30, 3) end
  doc "The cliff: the face's low x, the z of the plane in front of the face, its width along x, and its height."
  fn cliff() : (Int, Int, Int, Int) do (-60, -80, 120, 130) end
  doc "The stream: the channel's low x and its width."
  fn stream() : (Int, Int) do (100, 10) end

  pfn in_tower(x : Int, y : Int, z : Int) : Bool do
    match tower() do
      (x0, z0, side, tall) ->
        x >= x0 && x < x0 + side && z >= z0 && z < z0 + side && y >= 0 && y < tall &&
        (x < x0 + 3 || x >= x0 + side - 3 || z < z0 + 3 || z >= z0 + side - 3)
    end
  end
  pfn in_wall(x : Int, y : Int, z : Int) : Bool do
    match wall() do
      (x0, z0, long, high, thick) -> x >= x0 && x < x0 + long && z >= z0 && z < z0 + thick && y >= 0 && y < high
    end
  end
  pfn in_cliff(x : Int, y : Int, z : Int) : Bool do
    match cliff() do
      (x0, z0, long, high) -> x >= x0 && x < x0 + long && z < z0 && z >= z0 - 80 && y >= 0 && y < high
    end
  end

  doc "The block at world voxel (x, y, z)."
  fn block_at(x : Int, y : Int, z : Int) : Int do
    match stream() do
      (sx, wide) ->
        let channel = x >= sx && x < sx + wide && z >= -100 && z < 100
        if y >= 0 do (if in_tower(x, y, z) || in_wall(x, y, z) || in_cliff(x, y, z) do stone() else 0 end)
        else if channel && y >= -1 do 0
        else if channel && y >= -5 do water()
        else if y == -1 do grass()
        else if y >= -4 do dirt()
        else stone() end end end end end
    end
  end

  pfn fill_go(a : NativeI32Arr, ox : Int, oy : Int, oz : Int, i : Int) : NativeI32Arr do
    if i >= 32768 do a
    else fill_go(NativeArray.set_i32(a, i, block_at(ox + i % 32, oy + i / 1024, oz + (i / 32) % 32)), ox, oy, oz, i + 1) end
  end

  doc "Chunk (cx, cy, cz) of the 10 cm world."
  fn terrain(cx : Int, cy : Int, cz : Int, _seed : Int) : Strata.Chunk.Chunk do
    if cy * 32 >= 130 do Strata.Chunk.uniform(0)
    else if cy * 32 + 31 < -6 do Strata.Chunk.uniform(stone())
    else Strata.Chunk.compact(Strata.Chunk.from_flat(fill_go(NativeArray.make_i32(32768, 0), cx * 32, cy * 32, cz * 32, 0))) end end
  end
end
