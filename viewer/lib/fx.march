-- The viewer's particle effects (Strata.Particles), defined once a run, and
-- the two blocks a burning cell becomes while it burns: burning wood (for
-- wood and grass: opaque, charred, glowing in its cracks) and burning leaves
-- (cutout like leaves, its leaves glowing). Both give off light, so the
-- ray-traced light shows the ground about a fire.
--
-- Every effect is drawn as tiny cubes (Strata.Particles.cube), textured with
-- layer 13, near white, so their colour ramps carry their look. Layers 15
-- and 16 are burning wood and burning leaves (StrataViewer.Textures); 14,
-- the flame, is for a square-drawn flame (Strata.Particles.sprite).
mod StrataViewer.Fx do

  type FxIds = { fx_flame : Int, fx_ember : Int, fx_smoke : Int, fx_spark : Int, fx_steam : Int, fx_blaze : Int, fx_frost : Int }

  doc "The burning wood block: what wood and grass are while they burn."
  fn burning_wood() : Int do 25 end
  doc "The burning leaves block: what leaves are while they burn."
  fn burning_leaves() : Int do 26 end
  doc "What a cell of [block] is while it burns: wood (7) and grass (3) burning wood, leaves (8) burning leaves; -1 for one not swapped (tall grass burns as it stands, ice melts)."
  fn embers_for(block : Int) : Int do
    if block == 7 || block == 3 do burning_wood() else if block == 8 do burning_leaves() else 0 - 1 end end
  end

  doc "Flame: glowing cubes, yellow-white to orange to dark red, rising, shrinking as it goes."
  fn flame() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.glowing() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 1.0, 0.9, 0.5, 0.0), (0.15, 1.0, 0.6, 0.15, 0.9), (1.0, 0.6, 0.1, 0.0, 0.0)])
      |> Strata.Particles.size([(0.0, 0.16), (1.0, 0.04)])
      |> Strata.Particles.accel(0.0, 3.0, 0.0) |> Strata.Particles.drag(2.0) |> Strata.Particles.wobble(0.08, 1.5) |> Strata.Particles.spin(2.0)
  end
  doc "Blaze: a burning cell's flames, glowing, larger than a fireball's (0.4 m at first), so that from a cell's middle they reach past its faces."
  fn blaze() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.glowing() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 1.0, 0.85, 0.45, 0.0), (0.2, 1.0, 0.55, 0.12, 0.85), (1.0, 0.5, 0.08, 0.0, 0.0)])
      |> Strata.Particles.size([(0.0, 0.4), (1.0, 0.1)])
      |> Strata.Particles.accel(0.0, 2.5, 0.0) |> Strata.Particles.drag(2.0) |> Strata.Particles.wobble(0.1, 1.2) |> Strata.Particles.spin(1.5)
  end
  doc "Ember: glowing, small, orange, falling slowly."
  fn ember() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.glowing() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 1.0, 0.5, 0.1, 1.0), (1.0, 1.0, 0.5, 0.1, 0.0)])
      |> Strata.Particles.size([(0.0, 0.05)])
      |> Strata.Particles.accel(0.0, -2.0, 0.0) |> Strata.Particles.drag(0.5) |> Strata.Particles.spin(4.0)
  end
  doc "Smoke: shaded, grey, rising slowly, growing, fading in and out."
  fn smoke() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 0.25, 0.25, 0.25, 0.0), (0.2, 0.25, 0.25, 0.25, 0.3), (1.0, 0.25, 0.25, 0.25, 0.0)])
      |> Strata.Particles.size([(0.0, 0.25), (1.0, 0.7)])
      |> Strata.Particles.accel(0.0, 0.6, 0.0) |> Strata.Particles.drag(0.8) |> Strata.Particles.wobble(0.2, 0.3) |> Strata.Particles.spin(0.6)
  end
  doc "Spark: glowing, small, bright, fast and falling."
  fn spark() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.glowing() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 1.0, 0.9, 0.6, 1.0), (1.0, 1.0, 0.4, 0.1, 0.0)])
      |> Strata.Particles.size([(0.0, 0.06), (1.0, 0.02)])
      |> Strata.Particles.accel(0.0, -9.8, 0.0) |> Strata.Particles.drag(0.3) |> Strata.Particles.spin(6.0)
  end
  doc "Steam: shaded, white, rising, for ice that melts and fire over water."
  fn steam() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 0.9, 0.9, 0.9, 0.0), (0.25, 0.9, 0.9, 0.9, 0.35), (1.0, 0.9, 0.9, 0.9, 0.0)])
      |> Strata.Particles.size([(0.0, 0.2), (1.0, 0.6)])
      |> Strata.Particles.accel(0.0, 1.0, 0.0) |> Strata.Particles.drag(1.0) |> Strata.Particles.spin(0.6)
  end

  doc "Frost: shaded, pale blue cubes that drift up a little and hang, for ice: an iceball's burst, its trail and frozen ground."
  fn frost() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 0.75, 0.9, 1.0, 0.0), (0.15, 0.8, 0.92, 1.0, 0.8), (1.0, 0.9, 0.97, 1.0, 0.0)])
      |> Strata.Particles.size([(0.0, 0.09), (1.0, 0.03)])
      |> Strata.Particles.accel(0.0, 0.3, 0.0) |> Strata.Particles.drag(1.5) |> Strata.Particles.wobble(0.05, 0.8) |> Strata.Particles.spin(1.0)
  end

  -- ── Effects that meet the world (the STRATA_FX=2 scene) ──────────────────

  doc "Cinder: a glowing orange cube that falls and lies where it lands (Strata.Particles.rests_on_solid), dimming at the end of its life."
  fn cinder() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.glowing() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 1.0, 0.75, 0.3, 1.0), (0.3, 1.0, 0.4, 0.08, 1.0), (0.85, 0.8, 0.2, 0.03, 0.9), (1.0, 0.5, 0.1, 0.0, 0.0)])
      |> Strata.Particles.size([(0.0, 0.09)])
      |> Strata.Particles.accel(0.0, 0.0 -. 9.8, 0.0) |> Strata.Particles.drag(0.3) |> Strata.Particles.spin(5.0)
      |> Strata.Particles.rests_on_solid()
  end
  doc "Grit: a shaded pale cube that falls, bounces once off what it meets (restitution 0.45, friction 0.3) and lies where it lands next."
  fn grit() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 0.95, 0.95, 1.0, 1.0), (0.9, 0.95, 0.95, 1.0, 1.0), (1.0, 0.95, 0.95, 1.0, 0.0)])
      |> Strata.Particles.size([(0.0, 0.1)])
      |> Strata.Particles.accel(0.0, 0.0 -. 9.8, 0.0) |> Strata.Particles.drag(0.2) |> Strata.Particles.spin(6.0)
      |> Strata.Particles.bounces(0.45, 0.3)
  end
  doc "Drip: a shaded blue cube that falls and is gone where it meets the ground (Strata.Particles.dies_on_solid)."
  fn drip() : Strata.Particles.PtEffect do
    Strata.Particles.effect() |> Strata.Particles.layer(13)
      |> Strata.Particles.colour([(0.0, 0.35, 0.55, 1.0, 0.9)])
      |> Strata.Particles.size([(0.0, 0.07)])
      |> Strata.Particles.accel(0.0, 0.0 -. 9.8, 0.0) |> Strata.Particles.spin(3.0)
      |> Strata.Particles.dies_on_solid()
  end

  doc "STRATA_FX=2: at frame 10, three effects that meet the world are defined and left running 4.5 m ahead of the eye (x, y, z) looking along (dx, dz): on the left drips falling from 4 m up, gone at the ground; in the middle a fountain of cinders that lie where they land, and a jet of them thrown ahead at whatever stands there; on the right a fountain of grit that bounces once. [flies_free] defines the same three without the setting, to show and to time what it changes."
  fn showcase_meeting(r : FxRun, frame_no : Int, x : Float, y : Float, z : Float, dx : Float, dz : Float, flies_free : Bool) : FxRun do
    if frame_no != 10 do r
    else
      let l = Math.sqrt(dx *. dx +. dz *. dz)
      let ux = if l > 0.001 do dx /. l else 0.0 end
      let uz = if l > 0.001 do dz /. l else 1.0 end
      let cx = x +. ux *. 4.5
      let cz = z +. uz *. 4.5
      let cy = y -. 0.8
      let as_asked = fn e -> if flies_free do Strata.Particles.meets_nothing(e) else e end
      let (p1, cinder_id) = Strata.Particles.define(r.fr_p, as_asked(cinder()))
      let (p2, grit_id) = Strata.Particles.define(p1, as_asked(grit()))
      let (p3, drip_id) = Strata.Particles.define(p2, as_asked(drip()))
      -- across the view: left of the eye is (uz, -ux)
      let (p4, _) = Strata.Particles.emitter(p3, drip_id, Strata.Particles.box(cx +. uz *. 2.2, cy +. 4.0, cz -. ux *. 2.2, 0.6, 0.1, 0.6), (0.0, 0.0 -. 1.0, 0.0), 0.3, 80.0, 3.0, 0.1)
      let (p5, _) = Strata.Particles.emitter(p4, cinder_id, Strata.Particles.point(cx, cy +. 0.3, cz), (0.0, 5.0, 0.0), 1.2, 120.0, 3.5, 0.15)
      let (p6, _) = Strata.Particles.emitter(p5, cinder_id, Strata.Particles.point(cx +. uz *. 1.0, cy +. 0.3, cz -. ux *. 1.0), (ux *. 10.0, 0.0, uz *. 10.0), 0.5, 150.0, 3.5, 0.15)
      let (p7, _) = Strata.Particles.emitter(p6, grit_id, Strata.Particles.point(cx -. uz *. 2.2, cy +. 0.3, cz +. ux *. 2.2), (0.0, 5.0, 0.0), 1.2, 120.0, 3.5, 0.15)
      { r with fr_p: p7 }
    end
  end

  doc "Define the seven effects in [p]: call once a run (a match repeats; there are 63 ids)."
  fn define_all(p : Strata.Particles.Particles) : (Strata.Particles.Particles, FxIds) do
    let (p1, f) = Strata.Particles.define(p, flame())
    let (p2, e) = Strata.Particles.define(p1, ember())
    let (p3, s) = Strata.Particles.define(p2, smoke())
    let (p4, k) = Strata.Particles.define(p3, spark())
    let (p5, t) = Strata.Particles.define(p4, steam())
    let (p6, b) = Strata.Particles.define(p5, blaze())
    let (p7, fr) = Strata.Particles.define(p6, frost())
    (p7, { fx_flame: f, fx_ember: e, fx_smoke: s, fx_spark: k, fx_steam: t, fx_blaze: b, fx_frost: fr })
  end

  doc "No effects defined: every id -1."
  fn none() : FxIds do { fx_flame: 0 - 1, fx_ember: 0 - 1, fx_smoke: 0 - 1, fx_spark: 0 - 1, fx_steam: 0 - 1, fx_blaze: 0 - 1, fx_frost: 0 - 1 } end

  -- ── A run's particles ────────────────────────────────────────────────────

  -- A run's particles and the ids of its effects, threaded through the viewer's frame.
  type FxRun = { fr_p : Strata.Particles.Particles, fr_ids : FxIds }

  doc "A run's particles, every effect defined, from [seed]."
  fn start(seed : Int) : FxRun do
    match define_all(Strata.Particles.new(Strata.Seed.mix(seed, 41))) do (p, ids) -> { fr_p: p, fr_ids: ids } end
  end
  doc "The run's particles value."
  fn particles(r : FxRun) : Strata.Particles.Particles do r.fr_p end
  doc "The run's effect ids."
  fn ids(r : FxRun) : FxIds do r.fr_ids end
  doc "The run with its particles value replaced."
  fn with_particles(r : FxRun, p : Strata.Particles.Particles) : FxRun do { r with fr_p: p } end
  doc "The frame's end: step every emitter [dt] seconds and hand the bursts to the renderer."
  fn frame(r : FxRun, dt : Float) : FxRun do { r with fr_p: Strata.Render.particles(Strata.Particles.step(r.fr_p, dt)) } end

  doc "STRATA_FX=1: at frame 10, one of each effect 3 m ahead of the eye (x, y, z) looking along (dx, dz), side by side a metre apart: a burst of 40 each, and flame and smoke left burning at 120 and 20 a second."
  fn showcase(r : FxRun, frame_no : Int, x : Float, y : Float, z : Float, dx : Float, dz : Float) : FxRun do
    if frame_no != 10 do r
    else
      let l = Math.sqrt(dx *. dx +. dz *. dz)
      let ux = if l > 0.001 do dx /. l else 0.0 end
      let uz = if l > 0.001 do dz /. l else 1.0 end
      let cx = x +. ux *. 3.0
      let cz = z +. uz *. 3.0
      let cy = y -. 0.8
      -- across the view: right of the eye is (uz, -ux)
      let at = fn i -> (cx +. uz *. (int_to_float(i) -. 2.0), cz -. ux *. (int_to_float(i) -. 2.0))
      let ids0 = r.fr_ids
      let kinds = [(ids0.fx_flame, 0.6, 1.0), (ids0.fx_ember, 1.2, 1.5), (ids0.fx_smoke, 3.0, 0.5), (ids0.fx_spark, 0.5, 4.0), (ids0.fx_steam, 2.5, 0.5)]
      let p1 = List.fold_left(List.enumerate(kinds), r.fr_p, fn (p, ik) -> match ik do
          (i, (fx, life, spread)) -> match at(i) do (px, pz) -> Strata.Particles.burst(p, fx, Strata.Particles.sphere(px, cy, pz, 0.2), (0.0, 1.0, 0.0), spread, 40, life, 0.3) end
        end)
      let p2 = match at(0) do (px, pz) -> match Strata.Particles.emitter(p1, ids0.fx_flame, Strata.Particles.box(px, cy, pz, 0.3, 0.05, 0.3), (0.0, 0.5, 0.0), 0.4, 120.0, 0.6, 0.3) do (q, _) -> q end end
      let p3 = match at(2) do (px, pz) -> match Strata.Particles.emitter(p2, ids0.fx_smoke, Strata.Particles.sphere(px, cy, pz, 0.2), (0.0, 0.4, 0.0), 0.3, 20.0, 3.0, 0.3) do (q, _) -> q end end
      { r with fr_p: p3 }
    end
  end
end
