-- figures — the viewer's example rigs and clips (designer's call: example
-- content, not library), and the crowds the scripted scenes draw.
--
-- The humanoid: voxels of 1/16 m, about 1.8 m tall, facing +z, 15 parts:
--   0 pelvis (the root, 0.94 m up), 1 spine, 2 head,
--   3-5 the left arm (upper arm, forearm, hand; on the +x side), 6-8 the right,
--   9-11 the left leg (thigh, shin, foot), 12-14 the right.
-- A socket on each hand (0 left, 1 right), both legs declared for foot
-- placement, mask 0 the right arm. Palette: 1 skin, 2 shirt, 3 trousers,
-- 4 boots, 5 hair, 6 eyes (they glow), 7 belt.
--
-- Clips, in `clips` order: idle, walk, run, jump, crouch, swim, swing,
-- flinch, fall.
-- Marks: 1 left foot down, 2 right foot down (walk, run), 3 the blade's
-- arrival (swing).
mod StrataViewer.Figures do

  needs IO.Foreign
  needs Anim

  alias Strata.Rig as Rg
  alias Strata.Clip as Cl
  alias Strata.Anim as An
  alias Strata.Math.Quat as Qt

  pfn rad(d : Float) : Float do d *. 3.14159265 /. 180.0 end
  pfn rx(d : Float) : Strata.Math.Quat.Quat do Qt.from_axis_angle(1.0, 0.0, 0.0, rad(d)) end
  pfn ry(d : Float) : Strata.Math.Quat.Quat do Qt.from_axis_angle(0.0, 1.0, 0.0, rad(d)) end
  pfn rz(d : Float) : Strata.Math.Quat.Quat do Qt.from_axis_angle(0.0, 0.0, 1.0, rad(d)) end

  -- ── The humanoid ─────────────────────────────────────────────────────────
  -- the palette with the shirt (entry 2) in the colour given
  pfn palette_in(r : Strata.Rig.Rig, sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do
    let r1 = Rg.colour(Rg.colour(Rg.colour(r, 1, 0.72, 0.46, 0.32, 0.7, 0.0), 2, sr, sg, sb, 0.85, 0.0), 3, 0.24, 0.19, 0.14, 0.9, 0.0)
    Rg.colour(Rg.colour(Rg.colour(Rg.colour(r1, 4, 0.08, 0.06, 0.05, 0.6, 0.0), 5, 0.17, 0.10, 0.05, 0.9, 0.0), 6, 0.35, 0.9, 1.0, 0.3, 0.9), 7, 0.45, 0.32, 0.10, 0.5, 0.0)
  end

  -- an arm hanging from (x, 8.5, 2) of the spine's grid: upper arm 6 voxels (shirt), forearm 5 (skin), hand 2; a socket under the hand
  pfn arm(r : Strata.Rig.Rig, spine : Int, x : Float) : Strata.Rig.Rig do
    match Rg.part(r, spine, x, 8.5, 2.0, 2, 6, 2) do
      (r1, up) ->
        match Rg.part(Rg.box(Rg.anchor(r1, up, 1.0, 6.0, 1.0), up, 0, 0, 0, 1, 5, 1, 2), up, 1.0, 0.0, 1.0, 2, 5, 2) do
          (r2, fore) ->
            match Rg.part(Rg.box(Rg.anchor(r2, fore, 1.0, 5.0, 1.0), fore, 0, 0, 0, 1, 4, 1, 1), fore, 1.0, 0.0, 1.0, 2, 2, 2) do
              (r3, hand) -> Tuple.first(Rg.socket(Rg.box(Rg.anchor(r3, hand, 1.0, 2.0, 1.0), hand, 0, 0, 0, 1, 1, 1, 1), hand, 1.0, 0.5, 1.0, Qt.identity()))
            end
        end
    end
  end

  -- a leg from (x, 0, 2) of the pelvis's grid: thigh and shin of 7 voxels (trousers), a boot 5 long reaching forward
  pfn leg(r : Strata.Rig.Rig, pelvis : Int, x : Float) : (Strata.Rig.Rig, Int, Int, Int) do
    match Rg.part(r, pelvis, x, 0.0, 2.0, 3, 7, 3) do
      (r1, th) ->
        match Rg.part(Rg.box(Rg.anchor(r1, th, 1.5, 7.0, 1.5), th, 0, 0, 0, 2, 6, 2, 3), th, 1.5, 0.0, 1.5, 3, 7, 3) do
          (r2, sh) ->
            match Rg.part(Rg.box(Rg.anchor(r2, sh, 1.5, 7.0, 1.5), sh, 0, 0, 0, 2, 6, 2, 3), sh, 1.5, 0.0, 1.5, 3, 1, 5) do
              (r3, ft) -> (Rg.box(Rg.anchor(r3, ft, 1.5, 1.0, 1.5), ft, 0, 0, 0, 2, 0, 4, 4), th, sh, ft)
            end
        end
    end
  end

  -- the head: skin, hair over the top and back, two glowing eyes on the front (+z)
  pfn head_voxels(r : Strata.Rig.Rig, h : Int) : Strata.Rig.Rig do
    let r1 = Rg.box(Rg.box(Rg.box(r, h, 0, 0, 0, 4, 4, 4, 1), h, 0, 4, 0, 4, 4, 4, 5), h, 0, 1, 0, 4, 3, 0, 5)
    Rg.voxel(Rg.voxel(r1, h, 1, 2, 4, 6), h, 3, 2, 4, 6)
  end

  doc "The humanoid rig (see the module's head)."
  fn humanoid() : Strata.Rig.Rig do humanoid_in(0.12, 0.26, 0.62) end

  doc "The humanoid with its shirt in the colour (sr, sg, sb): a rig of its own, so its clips are its own too."
  fn humanoid_in(sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do
    match Rg.part(palette_in(Rg.new(0.0625), sr, sg, sb), -1, 0.0, 15.0, 0.0, 6, 3, 4) do
      (r1, pelvis) ->
        let r1b = Rg.box(Rg.box(Rg.anchor(r1, pelvis, 3.0, 0.0, 2.0), pelvis, 0, 0, 0, 5, 2, 3, 3), pelvis, 0, 2, 0, 5, 2, 3, 7)
        match Rg.part(r1b, pelvis, 3.0, 3.0, 2.0, 8, 9, 4) do
          (r2, spine) ->
            match Rg.part(Rg.box(Rg.anchor(r2, spine, 4.0, 0.0, 2.0), spine, 0, 0, 0, 7, 8, 3, 2), spine, 4.0, 9.0, 2.0, 5, 5, 5) do
              (r3, head) ->
                let r4 = head_voxels(Rg.anchor(r3, head, 2.5, 0.0, 2.5), head)
                -- the left arm on the +x side (the figure faces +z), then the right
                let r5 = arm(arm(r4, spine, 9.0), spine, -1.0)
                match leg(r5, pelvis, 4.5) do
                  (r6, lu, ll, lf) ->
                    match leg(r6, pelvis, 1.5) do
                      (r7, ru, rl, rf) -> Tuple.first(Rg.mask(Rg.leg(Rg.leg(r7, lu, ll, lf, 0.0625), ru, rl, rf, 0.0625), [6]))
                    end
                end
            end
        end
    end
  end

  -- ── Clips ────────────────────────────────────────────────────────────────
  -- a pose held over a whole clip: each (part, rotation) keyed at 0 and at the end
  pfn hold(c : Strata.Clip.Clip, d : Float, ks : List((Int, Float, Float, Float))) : Strata.Clip.Clip do
    match ks do
      Nil -> c
      Cons((p, ax, ay, az), t) ->
        let q = Qt.mul(Qt.mul(rx(ax), ry(ay)), rz(az))
        hold(Cl.turn(Cl.turn(c, p, 0.0, q, Cl.smooth()), p, d, q, Cl.smooth()), d, t)
    end
  end
  -- turn keys through a list of (time, degrees about x)
  pfn keys_x(c : Strata.Clip.Clip, p : Int, ks : List((Float, Float))) : Strata.Clip.Clip do
    match ks do
      Nil -> c
      Cons((t, d), rest) -> keys_x(Cl.turn(c, p, t, rx(d), Cl.smooth()), p, rest)
    end
  end

  -- standing, breathing: the spine and head sway, the arms hang a little out
  pfn idle(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c = Cl.swing(Cl.swing(Cl.new(r, 2.0, true), 1, 1.0, 0.0, 0.0, 3.0, 2.0, 0.0), 2, 0.0, 1.0, 0.0, 6.0, 2.0, 0.25)
    Cl.swing(Cl.swing(c, 3, 0.0, 0.0, 1.0, 5.0, 2.0, 0.0), 6, 0.0, 0.0, 1.0, -5.0, 2.0, 0.0)
  end

  -- a walk: one loop is two steps, 1.4 m; a positive turn about x carries a foot back
  pfn walk(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.swing(Cl.swing(Cl.new(r, 1.0, true), 9, 1.0, 0.0, 0.0, 25.0, 1.0, 0.25), 12, 1.0, 0.0, 0.0, 25.0, 1.0, 0.75)
    let c1 = Cl.swing(Cl.swing(c0, 10, 1.0, 0.0, 0.0, 18.0, 1.0, 0.375), 13, 1.0, 0.0, 0.0, 18.0, 1.0, 0.875)
    let c2 = Cl.swing(Cl.swing(c1, 3, 1.0, 0.0, 0.0, 20.0, 1.0, 0.75), 6, 1.0, 0.0, 0.0, 20.0, 1.0, 0.25)
    -- a foot is down when its leg is furthest forward: the left at 0.5, the right at 0
    Cl.stride(Cl.mark(Cl.mark(c2, 0.5, 1), 0.0, 2), 1.4)
  end

  -- a run: bigger swings, bent arms, the body leaning forward; one loop 0.6 s, 2.4 m
  pfn run(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.swing(Cl.swing(Cl.new(r, 0.6, true), 9, 1.0, 0.0, 0.0, 45.0, 0.6, 0.25), 12, 1.0, 0.0, 0.0, 45.0, 0.6, 0.75)
    let c1 = Cl.swing(Cl.swing(c0, 10, 1.0, 0.0, 0.0, 35.0, 0.6, 0.375), 13, 1.0, 0.0, 0.0, 35.0, 0.6, 0.875)
    let c2 = Cl.swing(Cl.swing(c1, 3, 1.0, 0.0, 0.0, 40.0, 0.6, 0.75), 6, 1.0, 0.0, 0.0, 40.0, 0.6, 0.25)
    let c3 = hold(c2, 0.6, [(1, 12.0, 0.0, 0.0), (4, -70.0, 0.0, 0.0), (7, -70.0, 0.0, 0.0)])
    Cl.stride(Cl.mark(Cl.mark(c3, 0.3, 1), 0.0, 2), 2.4)
  end

  -- a jump: crouch, up 0.5 m with the knees tucked and the arms raised, land; not looping
  pfn jump(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.move(Cl.move(Cl.new(r, 0.8, false), 0, 0.0, 0.0, 0.0, 0.0, Cl.smooth()), 0, 0.15, 0.0, -0.15, 0.0, Cl.smooth()), 0, 0.4, 0.0, 0.5, 0.0, Cl.smooth()), 0, 0.8, 0.0, 0.0, 0.0, Cl.smooth())
    let c1 = keys_x(keys_x(c0, 9, [(0.0, 0.0), (0.15, -40.0), (0.4, -55.0), (0.8, 0.0)]), 12, [(0.0, 0.0), (0.15, -40.0), (0.4, -55.0), (0.8, 0.0)])
    let c2 = keys_x(keys_x(c1, 10, [(0.0, 0.0), (0.15, 70.0), (0.4, 90.0), (0.8, 0.0)]), 13, [(0.0, 0.0), (0.15, 70.0), (0.4, 90.0), (0.8, 0.0)])
    let up_l = Cl.turn(Cl.turn(Cl.turn(c2, 3, 0.0, rz(0.0), Cl.smooth()), 3, 0.4, rz(150.0), Cl.smooth()), 3, 0.8, rz(0.0), Cl.smooth())
    Cl.turn(Cl.turn(Cl.turn(up_l, 6, 0.0, rz(0.0), Cl.smooth()), 6, 0.4, rz(-150.0), Cl.smooth()), 6, 0.8, rz(0.0), Cl.smooth())
  end

  -- a crouch held low, bobbing a little: knees forward, feet flat, the body leaning in
  pfn crouch(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.move(Cl.new(r, 2.0, true), 0, 0.0, 0.0, -0.36, 0.0, Cl.smooth()), 0, 1.0, 0.0, -0.39, 0.0, Cl.smooth()), 0, 2.0, 0.0, -0.36, 0.0, Cl.smooth())
    hold(c0, 2.0, [(9, -70.0, 0.0, 0.0), (12, -70.0, 0.0, 0.0), (10, 110.0, 0.0, 0.0), (13, 110.0, 0.0, 0.0), (11, -40.0, 0.0, 0.0), (14, -40.0, 0.0, 0.0), (1, 25.0, 0.0, 0.0), (2, -20.0, 0.0, 0.0), (3, -30.0, 0.0, 0.0), (6, -30.0, 0.0, 0.0), (4, -60.0, 0.0, 0.0), (7, -60.0, 0.0, 0.0)])
  end

  -- a swim: the body flat, face down, 0.5 m lower; the arms stroking, the legs kicking
  pfn swim(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.new(r, 1.2, true), 0, 0.0, 0.0, -0.5, 0.0, Cl.smooth()), 0, 1.2, 0.0, -0.5, 0.0, Cl.smooth())
    let c1 = hold(c0, 1.2, [(0, 80.0, 0.0, 0.0), (2, -50.0, 0.0, 0.0)])
    let c2 = Cl.swing(Cl.swing(c1, 3, 0.0, 0.0, 1.0, 60.0, 1.2, 0.0), 6, 0.0, 0.0, 1.0, -60.0, 1.2, 0.0)
    Cl.swing(Cl.swing(c2, 9, 1.0, 0.0, 0.0, 15.0, 0.6, 0.0), 12, 1.0, 0.0, 0.0, 15.0, 0.6, 0.5)
  end

  -- a sword swing of the right arm: raised over the head, brought down ahead, the body turning with it; the blade arrives at 0.5
  pfn swing(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = keys_x(Cl.new(r, 0.8, false), 6, [(0.0, -150.0), (0.25, -165.0), (0.5, -45.0), (0.8, -25.0)])
    let c1 = keys_x(c0, 7, [(0.0, -40.0), (0.25, -50.0), (0.5, -10.0), (0.8, -10.0)])
    let c2 = Cl.turn(Cl.turn(Cl.turn(c1, 1, 0.0, ry(20.0), Cl.smooth()), 1, 0.5, ry(-25.0), Cl.smooth()), 1, 0.8, ry(-15.0), Cl.smooth())
    Cl.mark(c2, 0.5, 3)
  end

  -- ── The torch ────────────────────────────────────────────────────────────
  doc "A torch: one part of voxels of 1/16 m, a wooden handle 10 voxels long under a 4 x 5 x 4 flame that glows (palette 1 wood, 2 flame); held by the grip 1 voxel up the handle (its anchor), to hang from a hand socket."
  fn torch() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.30, 0.18, 0.08, 0.9, 0.0), 2, 1.0, 0.55, 0.16, 0.9, 1.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 4, 15, 4) do
      (r1, p) -> Rg.box(Rg.box(Rg.anchor(r1, p, 2.0, 1.0, 2.0), p, 1, 0, 1, 2, 9, 2, 1), p, 0, 10, 0, 3, 14, 3, 2)
    end
  end

  -- a flinch: the spine and head thrown back and the arms out, then back; 0.25 s, the upper body only, so it layers over the legs
  pfn flinch(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = keys_x(keys_x(Cl.new(r, 0.25, false), 1, [(0.0, 0.0), (0.08, -18.0), (0.25, 0.0)]), 2, [(0.0, 0.0), (0.08, -25.0), (0.25, 0.0)])
    let c1 = Cl.turn(Cl.turn(Cl.turn(c0, 3, 0.0, rz(0.0), Cl.smooth()), 3, 0.08, rz(35.0), Cl.smooth()), 3, 0.25, rz(0.0), Cl.smooth())
    Cl.turn(Cl.turn(Cl.turn(c1, 6, 0.0, rz(0.0), Cl.smooth()), 6, 0.08, rz(-35.0), Cl.smooth()), 6, 0.25, rz(0.0), Cl.smooth())
  end

  -- a fall: over backward to lying on the ground, the knees giving first and the arms flung out; 0.6 s, the last pose held
  pfn fall(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.move(Cl.new(r, 0.6, false), 0, 0.0, 0.0, 0.0, 0.0, Cl.smooth()), 0, 0.25, 0.0, -0.3, -0.15, Cl.smooth()), 0, 0.6, 0.0, -0.8, -0.5, Cl.smooth())
    let c1 = keys_x(c0, 0, [(0.0, 0.0), (0.25, -25.0), (0.6, -90.0)])
    let c2 = keys_x(keys_x(c1, 9, [(0.0, 0.0), (0.25, -35.0), (0.6, -5.0)]), 12, [(0.0, 0.0), (0.25, -30.0), (0.6, 8.0)])
    let c3 = keys_x(keys_x(c2, 10, [(0.0, 0.0), (0.25, 60.0), (0.6, 12.0)]), 13, [(0.0, 0.0), (0.25, 55.0), (0.6, 4.0)])
    let c4 = Cl.turn(Cl.turn(c3, 3, 0.0, rz(0.0), Cl.smooth()), 3, 0.6, rz(75.0), Cl.smooth())
    keys_x(Cl.turn(Cl.turn(c4, 6, 0.0, rz(0.0), Cl.smooth()), 6, 0.6, rz(-60.0), Cl.smooth()), 2, [(0.0, 0.0), (0.6, -15.0)])
  end

  doc "The humanoid's clips, in order: idle, walk, run, jump, crouch, swim, swing, then flinch and fall."
  fn clips(r : Strata.Rig.Rig) : List(Strata.Clip.Clip) do [idle(r), walk(r), run(r), jump(r), crouch(r), swim(r), swing(r), flinch(r), fall(r)] end

  -- ── The match's small rigs ───────────────────────────────────────────────
  doc "A bow: one part of voxels of 1/16 m, a curved stave 14 voxels tall with its string (palette 1 wood, 2 string); held by its middle (its anchor), to hang from a hand socket."
  fn bow() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.36, 0.22, 0.10, 0.8, 0.0), 2, 0.85, 0.82, 0.74, 0.9, 0.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 1, 14, 3) do
      (r1, p) ->
        let stave = Rg.box(Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 0.5, 7.0, 0.5), p, 0, 3, 0, 0, 10, 0, 1), p, 0, 1, 1, 0, 2, 1, 1), p, 0, 11, 1, 0, 12, 1, 1), p, 0, 0, 2, 0, 0, 2, 1), p, 0, 13, 2, 0, 13, 2, 1)
        Rg.box(stave, p, 0, 1, 2, 0, 12, 2, 2)
    end
  end

  doc "An arrow: one part, 14 voxels of 1/16 m along +z (0.9 m), a wooden shaft with a grey head at its front and pale fletching (palette 1 wood, 2 head, 3 feather); its anchor is its middle."
  fn arrow() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.42, 0.28, 0.14, 0.8, 0.0), 2, 0.55, 0.56, 0.60, 0.4, 0.0), 3, 0.9, 0.9, 0.85, 0.9, 0.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 1, 1, 14) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 0.5, 0.5, 7.0), p, 0, 0, 2, 0, 0, 11, 1), p, 0, 0, 12, 0, 0, 13, 2), p, 0, 0, 0, 0, 0, 1, 3)
    end
  end

  doc "A fireball: one part, a rounded lump 6 voxels of 1/16 m across (0.4 m) that glows as the torch's flame does (palette 1 flame, 2 its bright heart); its anchor is its middle."
  fn fireball() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(0.0625), 1, 1.0, 0.45, 0.10, 0.9, 1.0), 2, 1.0, 0.85, 0.35, 0.9, 1.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 6, 6, 6) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 3.0, 3.0, 3.0), p, 0, 1, 1, 5, 4, 4, 1), p, 1, 0, 1, 4, 5, 4, 1), p, 1, 1, 0, 4, 4, 5, 1), p, 2, 2, 2, 3, 3, 3, 2)
    end
  end

  -- a humanoid part alone: its size in voxels and its main palette colour
  pfn piece_shape(part : Int) : (Int, Int, Int, Int) do
    if part == 0 do (6, 3, 4, 3)
    else if part == 1 do (8, 9, 4, 2)
    else if part == 2 do (5, 5, 5, 1)
    else if part == 3 || part == 6 do (2, 6, 2, 2)
    else if part == 4 || part == 7 do (2, 5, 2, 1)
    else if part == 5 || part == 8 do (2, 2, 2, 1)
    else if part == 11 || part == 14 do (3, 1, 5, 4)
    else (3, 7, 3, 3) end end end end end end end
  end
  doc "The humanoid's part [part] (0 to 14, as the module's head lists them) alone, as a rig of one part in the humanoid's palette, anchored at its middle: what a fallen fighter comes apart into."
  fn piece(part : Int) : Strata.Rig.Rig do piece_in(part, 0.12, 0.26, 0.62) end

  doc "`piece` with the shirt in the colour (sr, sg, sb): it shows on the spine (part 1) and the upper arms (3 and 6)."
  fn piece_in(part : Int, sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do
    match piece_shape(part) do
      (sx, sy, sz, col) ->
        match Rg.part(palette_in(Rg.new(0.0625), sr, sg, sb), -1, 0.0, 0.0, 0.0, sx, sy, sz) do
          (r1, p) ->
            let r2 = Rg.anchor(r1, p, int_to_float(sx) /. 2.0, int_to_float(sy) /. 2.0, int_to_float(sz) /. 2.0)
            if part == 2 do head_voxels(r2, p) else Rg.box(r2, p, 0, 0, 0, sx - 1, sy - 1, sz - 1, col) end
        end
    end
  end

  -- ── The sword ────────────────────────────────────────────────────────────
  doc "A sword: one part of voxels of 1/16 m, a grip 3 voxels long (palette 1 leather), a guard 3 wide (2 brass) and a blade 14 long (3 steel); held by the grip (its anchor), to hang from a hand socket."
  fn sword() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.20, 0.10, 0.05, 0.9, 0.0), 2, 0.75, 0.55, 0.20, 0.35, 0.0), 3, 0.80, 0.82, 0.86, 0.25, 0.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 3, 18, 1) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 1.5, 1.0, 0.5), p, 1, 0, 0, 1, 2, 0, 1), p, 0, 3, 0, 2, 3, 0, 2), p, 1, 4, 0, 1, 17, 0, 3)
    end
  end

  -- ── Creatures ────────────────────────────────────────────────────────────
  -- Each faces +z like the humanoid, so a walker's path turns it the same way.

  doc "A bird of voxels of 1/16 m, 0.6 m long with wings of 1.75 m: 0 body (the root, 0.25 m above the figure's origin), 1 head, 2 and 3 the left wing's inner and outer segments (+x), 4 and 5 the right's, 6 the tail. Palette: 1 body, 2 wings, 3 beak, 4 eyes, 5 wing tips."
  fn bird() : Strata.Rig.Rig do
    let pal = Rg.colour(Rg.colour(Rg.colour(Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.42, 0.38, 0.33, 0.8, 0.0), 2, 0.22, 0.20, 0.18, 0.8, 0.0), 3, 0.90, 0.55, 0.10, 0.6, 0.0), 4, 0.02, 0.02, 0.02, 0.3, 0.0), 5, 0.85, 0.85, 0.82, 0.8, 0.0)
    match Rg.part(pal, -1, 0.0, 4.0, 0.0, 4, 3, 8) do
      (r1, body) ->
        let r1b = Rg.box(Rg.anchor(r1, body, 2.0, 1.5, 4.0), body, 0, 0, 0, 3, 2, 7, 1)
        match Rg.part(r1b, body, 2.0, 1.5, 8.0, 3, 3, 4) do
          (r2, head) ->
            let r2b = Rg.voxel(Rg.voxel(Rg.voxel(Rg.box(Rg.anchor(r2, head, 1.5, 0.0, 0.0), head, 0, 0, 0, 2, 2, 2, 1), head, 1, 1, 3, 3), head, 0, 2, 1, 4), head, 2, 2, 1, 4)
            match Rg.part(r2b, body, 4.0, 2.0, 4.0, 6, 1, 4) do
              (r3, li) ->
                match Rg.part(Rg.box(Rg.anchor(r3, li, 0.0, 0.5, 2.0), li, 0, 0, 0, 5, 0, 3, 2), li, 6.0, 0.5, 2.0, 8, 1, 3) do
                  (r4, lo) ->
                    let r4b = Rg.box(Rg.box(Rg.anchor(r4, lo, 0.0, 0.5, 1.5), lo, 0, 0, 0, 5, 0, 2, 2), lo, 6, 0, 0, 7, 0, 2, 5)
                    match Rg.part(r4b, body, 0.0, 2.0, 4.0, 6, 1, 4) do
                      (r5, ri) ->
                        match Rg.part(Rg.box(Rg.anchor(r5, ri, 6.0, 0.5, 2.0), ri, 0, 0, 0, 5, 0, 3, 2), ri, 0.0, 0.5, 2.0, 8, 1, 3) do
                          (r6, ro) ->
                            let r6b = Rg.box(Rg.box(Rg.anchor(r6, ro, 8.0, 0.5, 1.5), ro, 2, 0, 0, 7, 0, 2, 2), ro, 0, 0, 0, 1, 0, 2, 5)
                            match Rg.part(r6b, body, 2.0, 1.5, 0.0, 4, 1, 4) do
                              (r7, tail) -> Rg.box(Rg.anchor(r7, tail, 2.0, 0.5, 4.0), tail, 0, 0, 0, 3, 0, 3, 2)
                            end
                        end
                    end
                end
            end
        end
    end
  end

  doc "The bird's flap, 0.5 s a loop: each inner wing swings 35 degrees about the body's length by `swing`, each outer segment 30 degrees a tenth of a beat behind it, the tail bobbing."
  fn flap(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.swing(Cl.swing(Cl.new(r, 0.5, true), 2, 0.0, 0.0, 1.0, 35.0, 0.5, 0.0), 4, 0.0, 0.0, 1.0, -35.0, 0.5, 0.0)
    let c1 = Cl.swing(Cl.swing(c0, 3, 0.0, 0.0, 1.0, 30.0, 0.5, -0.1), 5, 0.0, 0.0, 1.0, -30.0, 0.5, -0.1)
    Cl.swing(c1, 6, 1.0, 0.0, 0.0, 8.0, 0.5, 0.25)
  end

  doc "A fish of voxels of 1/16 m, 0.9 m long: 0 body (the root, at the figure's origin), then a tail of three segments, 1 to 3, each below the one before, the last a fin. Palette: 1 orange scales, 2 fin, 3 eyes, 4 belly."
  fn fish() : Strata.Rig.Rig do
    let pal = Rg.colour(Rg.colour(Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.85, 0.42, 0.10, 0.3, 0.0), 2, 0.70, 0.35, 0.15, 0.5, 0.0), 3, 0.02, 0.02, 0.02, 0.3, 0.0), 4, 0.80, 0.78, 0.65, 0.4, 0.0)
    match Rg.part(pal, -1, 0.0, 0.0, 0.0, 3, 4, 6) do
      (r1, body) ->
        let r1b = Rg.voxel(Rg.voxel(Rg.box(Rg.box(Rg.anchor(r1, body, 1.5, 2.0, 3.0), body, 0, 0, 0, 2, 3, 5, 1), body, 0, 0, 0, 2, 0, 5, 4), body, 0, 2, 4, 3), body, 2, 2, 4, 3)
        match Rg.part(r1b, body, 1.5, 2.0, 0.0, 3, 3, 3) do
          (r2, t1) ->
            match Rg.part(Rg.box(Rg.anchor(r2, t1, 1.5, 1.5, 3.0), t1, 0, 0, 0, 2, 2, 2, 1), t1, 1.5, 1.5, 0.0, 1, 3, 3) do
              (r3, t2) ->
                match Rg.part(Rg.box(Rg.anchor(r3, t2, 0.5, 1.5, 3.0), t2, 0, 0, 0, 0, 2, 2, 1), t2, 0.5, 1.5, 0.0, 1, 6, 2) do
                  (r4, t3) -> Rg.box(Rg.anchor(r4, t3, 0.5, 3.0, 2.0), t3, 0, 0, 0, 0, 5, 1, 2)
                end
            end
        end
    end
  end

  doc "The fish's swim, 0.8 s a loop: the body sways 6 degrees and the first tail segment 20, about y, by `swing`; the rest of the tail is left to its springs."
  fn swim_fish(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    Cl.swing(Cl.swing(Cl.new(r, 0.8, true), 0, 0.0, 1.0, 0.0, 6.0, 0.8, 0.0), 1, 0.0, 1.0, 0.0, 20.0, 0.8, -0.15)
  end

  -- a wheel of 2 x 8 x 8 voxels about its centre: a tyre round the rim, two spokes across
  pfn wheel_go(r : Strata.Rig.Rig, p : Int, i : Int) : Strata.Rig.Rig do
    if i >= 64 do r
    else
      let y = i / 8
      let z = i % 8
      let dy = int_to_float(y) -. 3.5
      let dz = int_to_float(z) -. 3.5
      let d2 = dy *. dy +. dz *. dz
      let col = if d2 > 16.5 do 0 else if d2 >= 8.5 do 2 else if y == 3 || y == 4 || z == 3 || z == 4 do 3 else 0 end end end
      wheel_go(if col == 0 do r else Rg.box(r, p, 0, y, z, 1, y, z, col) end, p, i + 1)
    end
  end
  pfn wheel(r : Strata.Rig.Rig, parent : Int, px : Float, py : Float, pz : Float) : Strata.Rig.Rig do
    match Rg.part(r, parent, px, py, pz, 2, 8, 8) do
      (r1, w) -> wheel_go(Rg.anchor(r1, w, 1.0, 4.0, 4.0), w, 0)
    end
  end

  doc "A cart of voxels of 1/8 m, 1.25 x 2 m: 0 the bed (the root, on the axles 0.5 m up), 1 the front-left steering knuckle (no voxels) and 2 its wheel, 3 and 4 the front right's, 5 the rear-left wheel, 6 the rear right. Wheels of 0.5 m radius turn about x. Palette: 1 boards, 2 tyres, 3 spokes."
  fn cart() : Strata.Rig.Rig do
    let pal = Rg.colour(Rg.colour(Rg.colour(Rg.new(0.125), 1, 0.45, 0.28, 0.12, 0.9, 0.0), 2, 0.05, 0.05, 0.05, 0.9, 0.0), 3, 0.60, 0.15, 0.10, 0.7, 0.0)
    match Rg.part(pal, -1, 0.0, 4.0, 0.0, 10, 4, 16) do
      (r1, bed) ->
        let r1b = Rg.box(Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, bed, 5.0, 0.0, 8.0), bed, 0, 0, 0, 9, 0, 15, 1), bed, 0, 1, 0, 0, 3, 15, 1), bed, 9, 1, 0, 9, 3, 15, 1), bed, 1, 1, 0, 8, 3, 0, 1), bed, 1, 1, 15, 8, 3, 15, 1)
        match Rg.part(r1b, bed, 11.0, 0.0, 13.0, 0, 0, 0) do
          (r2, kl) ->
            match Rg.part(wheel(r2, kl, 0.0, 0.0, 0.0), bed, -1.0, 0.0, 13.0, 0, 0, 0) do
              (r3, kr) -> wheel(wheel(wheel(r3, kr, 0.0, 0.0, 0.0), bed, 11.0, 0.0, 3.0), bed, -1.0, 0.0, 3.0)
            end
        end
    end
  end

  doc "The cart rolling: each wheel turns 0.625 times a second about x by `spin` (1.6 s, one turn, a loop), carrying the cart 1.96 m a second."
  fn roll(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    Cl.spin(Cl.spin(Cl.spin(Cl.spin(Cl.new(r, 1.6, true), 2, 1.0, 0.0, 0.0, 0.625), 4, 1.0, 0.0, 0.0, 0.625), 5, 1.0, 0.0, 0.0, 0.625), 6, 1.0, 0.0, 0.0, 0.625)
  end

  doc "The cart's speed when rolling at rate 1, metres a second: the wheels' 0.625 turns a second round 0.5 m."
  fn cart_speed() : Float do 0.625 *. 2.0 *. 3.14159265 *. 0.5 end

  -- the humanoid's sword stroke as a loop for the arena's layer over the right arm: the swing's keys, and back up over 0.4 s
  pfn slash(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = keys_x(Cl.new(r, 1.2, true), 6, [(0.0, -150.0), (0.25, -165.0), (0.5, -45.0), (0.8, -25.0), (1.2, -150.0)])
    keys_x(c0, 7, [(0.0, -40.0), (0.25, -50.0), (0.5, -10.0), (0.8, -10.0), (1.2, -40.0)])
  end

  -- ── Crowds ───────────────────────────────────────────────────────────────
  -- The figures a scene draws: the world, the humanoid, its id and its clips'
  -- ids (in `clips` order), and the walkers: (figure, x, z, radius, angle,
  -- height, speed, kind). A walker with a radius goes round the circle about
  -- (x, z), from that angle at time 0; one of radius 0 goes in a straight line
  -- from (x, z) toward that yaw. Speed in m/s. Kind: 0 a humanoid that finds
  -- the ground under it every eighth frame, 1 a humanoid on flat ground (its
  -- height kept), 2 a creature in the air or water (its height kept), 3 a
  -- creature on the ground (found every frame), 4 a humanoid with foot
  -- placement that finds the ground every frame.
  -- The torch rig and its id ride along (`add_torch`), and the last figure added (`trace_last`).
  -- `with_creatures` adds the sword, bird, fish and cart rigs and their clips
  -- (ids -1 until then). [feet] are the figures given foot placement each frame
  -- while [feet_on]; [springy] the (figure, part, stiffness, damping) springs,
  -- set while [springs_on]; [near] the figures `toggle_near` switched to traced; [lit] those
  -- traced otherwise (by the scene, or a torch); [torched] the humanoids holding a torch; [clock]
  -- the time of the last step; [ground_ms] what the last step's foot placement took.
  type Crowd = { anim : Strata.Anim.Anim, body : Strata.Rig.Rig, rig_id : Int, clip_ids : List(Int), walkers : List((Int, Float, Float, Float, Float, Float, Float, Int)), flame : Strata.Rig.Rig, torch_id : Int, last : Int, extra : List(Strata.Rig.Rig), sword_id : Int, bird_id : Int, fish_id : Int, cart_id : Int, flap_id : Int, fswim_id : Int, roll_id : Int, slash_id : Int, feet : List(Int), feet_on : Bool, springy : List((Int, Int, Float, Float)), springs_on : Bool, near : List(Int), lit : List(Int), torched : List(Int), clock : Float, ground_ms : Float }

  pfn crowd_of(a : Strata.Anim.Anim, r : Strata.Rig.Rig, id : Int, ids : List(Int), t : Strata.Rig.Rig, tid : Int) : Crowd do
    { anim: a, body: r, rig_id: id, clip_ids: ids, walkers: Nil, flame: t, torch_id: tid, last: -1, extra: Nil, sword_id: -1, bird_id: -1, fish_id: -1, cart_id: -1, flap_id: -1, fswim_id: -1, roll_id: -1, slash_id: -1, feet: Nil, feet_on: true, springy: Nil, springs_on: true, near: Nil, lit: Nil, torched: Nil, clock: 0.0, ground_ms: 0.0 }
  end

  doc "No figures: nothing is opened, nothing drawn."
  fn none() : Crowd do crowd_of({ rigs: Nil, capacity: 0 }, Rg.new(0.0625), -1, Nil, Rg.new(0.0625), -1) end

  doc "How many figures walk (creatures and runners included)."
  fn walking(c : Crowd) : Int do List.length(c.walkers) end
  doc "Whether any figure was added."
  fn any(c : Crowd) : Bool do c.last >= 0 end
  doc "Whether the crowd's figure world is open."
  fn is_open(c : Crowd) : Bool do c.rig_id >= 0 end

  pfn finish_clips(a : Strata.Anim.Anim, cs : List(Strata.Clip.Clip), acc : List(Int)) : (Strata.Anim.Anim, List(Int)) do
    match cs do
      Nil -> (a, List.reverse(acc))
      Cons(c, t) -> match An.finish_clip(a, c) do (a2, id) -> finish_clips(a2, t, Cons(id, acc)) end
    end
  end

  doc "Open a figure world for [capacity] figures with the humanoid, its clips and the torch finished in it. The renderer still needs `Strata.Render.figures` with `rigs`."
  fn open(capacity : Int) : Crowd do
    let r = humanoid()
    let t = torch()
    match An.finish_rig(An.open(capacity), r) do
      (a1, id) ->
        match finish_clips(a1, clips(r), Nil) do
          (a2, ids) ->
            match An.finish_rig(a2, t) do
              (a3, tid) -> crowd_of(a3, r, id, ids, t, tid)
            end
        end
    end
  end

  doc "Finish the sword, the bird, the fish and the cart in the crowd's world, with the flap, the fish's swim, the roll and the humanoid's looping slash. Once; a closed crowd is left as it is."
  fn with_creatures(c : Crowd) : Crowd do
    if c.rig_id < 0 || c.bird_id >= 0 do c
    else
      let sw = sword()
      let bd = bird()
      let fs = fish()
      let ct = cart()
      match An.finish_rig(c.anim, sw) do
        (a1, swid) ->
          match An.finish_rig(a1, bd) do
            (a2, bid) ->
              match An.finish_rig(a2, fs) do
                (a3, fid) ->
                  match An.finish_rig(a3, ct) do
                    (a4, cid) ->
                      match finish_clips(a4, [flap(bd), swim_fish(fs), roll(ct), slash(c.body)], Nil) do
                        (a5, ids) ->
                          { c with anim: a5, extra: [sw, bd, fs, ct], sword_id: swid, bird_id: bid, fish_id: fid, cart_id: cid, flap_id: unwrap_or(List.nth_opt(ids, 0), -1), fswim_id: unwrap_or(List.nth_opt(ids, 1), -1), roll_id: unwrap_or(List.nth_opt(ids, 2), -1), slash_id: unwrap_or(List.nth_opt(ids, 3), -1) }
                      end
                  end
              end
          end
      end
    end
  end

  doc "The humanoid rig the crowd was opened with (for `Strata.Render.figures`)."
  fn rig(c : Crowd) : Strata.Rig.Rig do c.body end
  doc "The crowd's rigs: the humanoid and the torch, then the sword, bird, fish and cart once added (for `Strata.Render.figures`)."
  fn rigs(c : Crowd) : List(Strata.Rig.Rig) do Cons(c.body, Cons(c.flame, c.extra)) end

  doc "Draw the figure added last traced (Strata.Anim.traced): its shadow, reflections, sky darkening and glow come from the rays."
  fn trace_last(c : Crowd) : Crowd do
    if c.last < 0 do c else { c with anim: An.traced(c.anim, c.last, true), lit: Cons(c.last, c.lit) } end
  end

  doc "Hand the animation the camera (`Strata.Anim.view`): [planes] 24 floats, the eye (ex, ey, ez), no far distance."
  fn with_view(c : Crowd, planes : NativeF32Arr, ex : Float, ey : Float, ez : Float) : Crowd do
    { c with anim: An.view(c.anim, planes, ex, ey, ez, 0.0) }
  end

  -- hang a new figure of [rig] from figure f's socket s at (x, y, z) turned by q, traced like its holder when [traced]; it becomes the figure added last
  pfn hang(c : Crowd, rig : Int, f : Int, s : Int, x : Float, y : Float, z : Float, q : Strata.Math.Quat.Quat, traced : Bool) : Crowd do
    if f < 0 || rig < 0 do c
    else
      match An.spawn_at(c.anim, rig, 0.0, 0.0, 0.0, Qt.identity()) do
        (a1, t) ->
          if t < 0 do c
          else
            let a2 = An.attach(a1, t, f, s, x, y, z, q)
            if traced do { c with anim: An.traced(a2, t, true), last: t, lit: Cons(t, c.lit) } else { c with anim: a2, last: t } end
          end
      end
    end
  end

  doc "Put a lit torch in the right hand (socket 1) of figure [f], held 0.1 m in front of the hand and leaning 25 degrees forward, traced; the torch becomes the figure added last. A figure already holding one is left as it is."
  fn add_torch_to(c : Crowd, f : Int) : Crowd do
    if List.any(c.torched, fn g -> g == f) do c
    else
      let c2 = hang(c, c.torch_id, f, 1, 0.0, 0.0, 0.1, rx(25.0), true)
      if c2.last == c.last do c2 else { c2 with torched: Cons(f, c2.torched) } end
    end
  end

  doc "Put a lit torch in the right hand of the figure added last (`add_torch_to`)."
  fn add_torch(c : Crowd) : Crowd do add_torch_to(c, c.last) end

  doc "Put the sword in the right hand (socket 1) of the figure added last, its blade along the hand's forward (+z) side; drawn plain. Needs `with_creatures`."
  fn add_sword(c : Crowd) : Crowd do hang(c, c.sword_id, c.last, 1, 0.0, 0.0, 0.05, rx(90.0), false) end

  pfn piece_quads(m : (Int, Int, Int, Int, NativeI32Arr)) : Int do match m do (_, _, _, _, q) -> NativeArray.length_i32(q) / 2 end end
  doc "The quads the renderer holds for the crowd's rigs (each once, shared by every figure of it): 8 bytes each on the GPU."
  fn quads(c : Crowd) : Int do List.fold_left(List.map(rigs(c), fn r -> List.fold_left(List.map(Strata.Rig.meshes(r), piece_quads), 0, fn (a, b) -> a + b)), 0, fn (a, b) -> a + b) end

  doc "The humanoid's rig id in the crowd's figure world, and its clips' ids in `clips` order."
  fn body_id(c : Crowd) : Int do c.rig_id end
  fn clip_ids(c : Crowd) : List(Int) do c.clip_ids end
  doc "The crowd's figure world."
  fn anim(c : Crowd) : Strata.Anim.Anim do c.anim end

  pfn clip_id(c : Crowd, k : Int) : Int do unwrap_or(List.nth_opt(c.clip_ids, k), -1) end

  -- where a walker is at time t: (x, z, yaw); a circle when its radius is above 0, else a line along the yaw
  pfn walker_at(w : (Int, Float, Float, Float, Float, Float, Float, Int), t : Float) : (Float, Float, Float) do
    match w do
      (_, cx, cz, rad, a0, _, v, _) ->
        if rad > 0.0 do
          let th = a0 +. t *. v /. rad
          (cx +. rad *. Math.cos(th), cz +. rad *. Math.sin(th), 0.0 -. th)
        else (cx +. Math.sin(a0) *. v *. t, cz +. Math.cos(a0) *. v *. t, a0) end
    end
  end

  doc "The ground's top under (x, z) in metres, searching down from [from] for 6 m (plants are not ground); [from] - 1.5 if there is none."
  fn ground_at(w : Strata.World.World, x : Float, z : Float, from : Float) : Float do ground_below(w, x, z, from, 6.0) end

  doc "The ground's top under (x, z) in metres, searching down from [from] for [reach] m (plants are not ground); [from] - 1.5 if there is none."
  fn ground_below(w : Strata.World.World, x : Float, z : Float, from : Float, reach : Float) : Float do
    let reg = Strata.World.registry(w)
    let h = Strata.Query.raycast(w, x, from, z, 0.0, -1.0, 0.0, reach, fn id -> id != 0 && Strata.Blocks.collides(reg, id) && Strata.Blocks.style_index(reg, id) != 1)
    if Strata.Query.is_hit(h) do from -. Strata.Query.hit_dist(h) else from -. 1.5 end
  end

  -- a figure of [rig] playing [clip] at [rate] on layer 0, going round (or along) its path at [speed] m/s; kind as the walkers'
  pfn add_mover(c : Crowd, rig : Int, clip : Int, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float, speed : Float, rate : Float, kind : Int) : Crowd do
    let w0 = (0, cx, cz, radius, a0, y, speed, kind)
    match walker_at(w0, 0.0) do
      (x, z, yaw) ->
        if rig < 0 do c
        else
          match An.spawn_at(c.anim, rig, x, y, z, ry(yaw *. 180.0 /. 3.14159265)) do
            (a1, f) ->
              if f < 0 do c
              else
                let a2 = An.play(a1, f, 0, clip, 0.0, rate, 1.0, -1, false)
                { c with anim: a2, walkers: Cons((f, cx, cz, radius, a0, y, speed, kind), c.walkers), last: f }
              end
          end
        end
    end
  end

  -- is the block liquid: a flowing fluid's state, or the viewer's sea (block 5: a plain block that does not collide, which Strata.Fluid treats as a sea by its id)
  pfn liquid(reg : Strata.Blocks.Registry, id : Int) : Bool do
    if id == 5 do true else Strata.Blocks.is_fluid(reg, id) end
  end
  doc "Is block [id] liquid in the viewer's world: a flowing fluid's state, or the sea?"
  fn is_liquid(reg : Strata.Blocks.Registry, id : Int) : Bool do liquid(reg, id) end
  doc "The top of dry ground under (x, z) in metres, searching down from [from] for [reach] m (plants are not ground); -1000.0 when nothing is found or the first thing below is water, the sea included."
  fn dry_ground_at(w : Strata.World.World, x : Float, z : Float, from : Float, reach : Float) : Float do
    let reg = Strata.World.registry(w)
    let h = Strata.Query.raycast(w, x, from, z, 0.0, -1.0, 0.0, reach, fn id -> id != 0 && (liquid(reg, id) || (Strata.Blocks.collides(reg, id) && Strata.Blocks.style_index(reg, id) != 1)))
    if !Strata.Query.is_hit(h) do -1000.0
    else if liquid(reg, Strata.World.get_block(w, Strata.Query.hit_x(h), Strata.Query.hit_y(h), Strata.Query.hit_z(h))) do -1000.0
    else from -. Strata.Query.hit_dist(h) end end
  end

  doc "Add a walker of the walk clip at [rate] (1.4 m/s at rate 1): round a circle of [radius] m about (cx, cz) starting at angle [a0], or (radius 0) along a straight line from (cx, cz) toward yaw [a0]; standing at height [y], found again from the world as it goes."
  fn add_walker(c : Crowd, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float, rate : Float) : Crowd do
    add_mover(c, c.rig_id, clip_id(c, 1), cx, cz, radius, a0, y, 1.4 *. rate, rate, 0)
  end

  doc "Add a walker as `add_walker` does, with foot placement: it finds the ground every frame and its legs reach for it (`Strata.Anim.ground`)."
  fn add_climber(c : Crowd, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float, rate : Float) : Crowd do
    let c2 = add_mover(c, c.rig_id, clip_id(c, 1), cx, cz, radius, a0, y, 1.4 *. rate, rate, 4)
    if c2.last == c.last do c2 else { c2 with feet: Cons(c2.last, c2.feet) } end
  end

  doc "Add an arena runner on flat ground at height [y]: the run (4 m/s at rate 1) round a circle of [radius] m about (cx, cz) from angle [a0]; over it, on layer 1 masked to the right arm, the looping sword stroke (`with_creatures` first); its spine and head aiming 30 degrees at most toward (tx, ty, tz); foot placement when [feet]."
  fn add_runner(c : Crowd, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float, rate : Float, tx : Float, ty : Float, tz : Float, feet : Bool) : Crowd do
    let c2 = add_mover(c, c.rig_id, clip_id(c, 2), cx, cz, radius, a0, y, 4.0 *. rate, rate, 1)
    if c2.last == c.last do c2
    else
      let f = c2.last
      let a1 = if c2.slash_id < 0 do c2.anim else An.play(c2.anim, f, 1, c2.slash_id, 0.0, rate, 1.0, 0, false) end
      let a2 = An.aim(a1, f, 0, [1, 2], 0.0, 0.0, 1.0, tx, ty, tz, 30.0, 1.0)
      { c2 with anim: a2, feet: if feet do Cons(f, c2.feet) else c2.feet end }
    end
  end

  doc "Add the bird flapping round a circle of [radius] m about (cx, cz) at height [y], 5 m/s, from angle [a0] (`with_creatures` first)."
  fn add_bird(c : Crowd, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float) : Crowd do
    add_mover(c, c.bird_id, c.flap_id, cx, cz, radius, a0, y, 5.0, 1.0, 2)
  end

  doc "Add the fish swimming round a circle of [radius] m about (cx, cz) at height [y] (under the water), 0.8 m/s, from angle [a0], its three tail segments on springs (`with_creatures` first)."
  fn add_fish(c : Crowd, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float) : Crowd do
    let c2 = add_mover(c, c.fish_id, c.fswim_id, cx, cz, radius, a0, y, 0.8, 1.0, 2)
    if c2.last == c.last do c2
    else
      let f = c2.last
      let sp = [(f, 1, 40.0, 5.0), (f, 2, 30.0, 4.0), (f, 3, 20.0, 3.0)]
      { c2 with anim: springs_go(c2.anim, sp, c2.springs_on), springy: List.append(sp, c2.springy) }
    end
  end

  doc "Add the cart rolling round a circle of [radius] m about (cx, cz) from angle [a0], on the ground (found every frame from [y]); its front wheels steered into the turn by an override on their knuckles (`with_creatures` first)."
  fn add_cart(c : Crowd, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float) : Crowd do
    let c2 = add_mover(c, c.cart_id, c.roll_id, cx, cz, radius, a0, y, cart_speed(), 1.0, 3)
    if c2.last == c.last do c2
    else
      -- the centre of the circle is on the cart's right (-x): the wheels turn toward it by the angle a 1.25 m wheelbase needs
      let steer = 0.0 -. Math.atan2(1.25, radius) *. 180.0 /. 3.14159265
      let f = c2.last
      { c2 with anim: An.override(An.override(c2.anim, f, 1, ry(steer), 0.0, 0.0, 0.0, 1.0), f, 3, ry(steer), 0.0, 0.0, 0.0, 1.0) }
    end
  end

  doc "Add a figure frozen in clip [k] (in `clips` order) at its midpoint, at (x, y, z) turned [yaw] radians about y."
  fn add_posed(c : Crowd, k : Int, x : Float, y : Float, z : Float, yaw : Float) : Crowd do
    add_posed_at(c, k, 0.5 *. Strata.Clip.duration(unwrap_or(List.nth_opt(clips(c.body), k), idle(c.body))), x, y, z, yaw)
  end

  doc "Add a figure frozen in clip [k] (in `clips` order) at [time] seconds, at (x, y, z) turned [yaw] radians about y."
  fn add_posed_at(c : Crowd, k : Int, time : Float, x : Float, y : Float, z : Float, yaw : Float) : Crowd do
    match An.spawn_at(c.anim, c.rig_id, x, y, z, ry(yaw *. 180.0 /. 3.14159265)) do
      (a1, f) ->
        if f < 0 do c
        else { c with anim: An.set_time(An.play(a1, f, 0, clip_id(c, k), 0.0, 0.0, 1.0, -1, false), f, 0, time, 0.0), last: f } end
    end
  end

  -- ── What the viewer's keys do ────────────────────────────────────────────
  pfn springs_go(a : Strata.Anim.Anim, sp : List((Int, Int, Float, Float)), yes : Bool) : Strata.Anim.Anim do
    match sp do
      Nil -> a
      Cons((f, p, k, d), t) -> springs_go(if yes do An.spring(a, f, p, k, d) else An.spring(a, f, p, 0.0, 0.0) end, t, yes)
    end
  end
  pfn unground(a : Strata.Anim.Anim, fs : List(Int), w : Strata.World.World) : Strata.Anim.Anim do
    match fs do
      Nil -> a
      Cons(f, t) -> unground(An.ground(a, f, w, 0.0), t, w)
    end
  end

  doc "Switch foot placement and springs together: off clears every foot-placement reach (the drop eases back to 0) and every spring; on sets them again."
  fn toggle_feet(c : Crowd, w : Strata.World.World) : Crowd do
    let on2 = !c.feet_on
    let a1 = if on2 do c.anim else unground(c.anim, c.feet, w) end
    { c with anim: springs_go(a1, c.springy, on2), feet_on: on2, springs_on: on2 }
  end

  -- every humanoid walker (kinds 0, 1 and 4) by its distance from (ex, ez), nearest first
  pfn humans_by_distance(c : Crowd, ex : Float, ez : Float) : List(Int) do
    let ds = List.filter_map(c.walkers, fn wk -> human_distance(wk, c.clock, ex, ez))
    List.map(List.sort_by(ds, nearer), fn p -> Tuple.second(p))
  end
  pfn nearer(a : (Float, Int), b : (Float, Int)) : Bool do Tuple.first(a) <= Tuple.first(b) end
  pfn human_distance(wk : (Int, Float, Float, Float, Float, Float, Float, Int), t : Float, ex : Float, ez : Float) : Option((Float, Int)) do
    match wk do
      (f, _, _, _, _, _, _, kind) ->
        if kind == 2 || kind == 3 do None
        else
          match walker_at(wk, t) do
            (x, z, _) -> Some(((x -. ex) *. (x -. ex) +. (z -. ez) *. (z -. ez), f))
          end
        end
    end
  end
  pfn trace_all(a : Strata.Anim.Anim, fs : List(Int), yes : Bool) : Strata.Anim.Anim do
    match fs do
      Nil -> a
      Cons(f, t) -> trace_all(An.traced(a, f, yes), t, yes)
    end
  end

  doc "Switch the plain ones among the 8 humanoids nearest (ex, ez) to traced, or, when it did so last time, those back to plain. Figures traced otherwise (the scene's, a torch's) are left traced."
  fn toggle_near(c : Crowd, ex : Float, ez : Float) : Crowd do
    match c.near do
      Nil ->
        let ns = List.filter(List.take(humans_by_distance(c, ex, ez), 8), fn f -> !List.any(c.lit, fn g -> g == f))
        { c with anim: trace_all(c.anim, ns, true), near: ns }
      Cons(_, _) -> { c with anim: trace_all(c.anim, c.near, false), near: Nil }
    end
  end

  doc "Give the humanoid nearest (ex, ez) a lit torch (`add_torch_to`)."
  fn torch_nearest(c : Crowd, ex : Float, ez : Float) : Crowd do
    match humans_by_distance(c, ex, ez) do
      Nil -> c
      Cons(f, _) -> add_torch_to(c, f)
    end
  end

  pfn wander_go(c : Crowd, w : Strata.World.World, ex : Float, ey : Float, ez : Float, yaw : Float, i : Int, n : Int) : Crowd do
    if i >= n do c
    else
      let ahead = 6.0 +. int_to_float(i / 8) *. 3.5
      let side = (int_to_float(i % 8) -. 3.5) *. 3.5
      let x = ex +. Math.sin(yaw) *. ahead +. Math.cos(yaw) *. side
      let z = ez -. Math.cos(yaw) *. ahead +. Math.sin(yaw) *. side
      let radius = 1.0 +. int_to_float((i * 7) % 5) *. 0.5
      let rate = 0.7 +. int_to_float(i % 4) *. 0.15
      let a0 = int_to_float(i) *. 0.9
      -- the ground under the circle's start, where the walker begins: searched from 30 m above the eye down 90 m, the land ahead may be far below or above it
      let y = ground_below(w, x +. radius *. Math.cos(a0), z +. radius *. Math.sin(a0), ey +. 30.0, 90.0)
      wander_go(add_climber(c, x, z, radius, a0, y, rate), w, ex, ey, ez, yaw, i + 1, n)
    end
  end

  doc "Add [n] humanoids wandering ahead of the eye (ex, ey, ez) looking along [yaw]: in rows of 8, 3.5 m apart from 6 m ahead, each walking its own circle of 1 to 3 m at its own pace, on the ground, with foot placement (`add_climber`)."
  fn wander(c : Crowd, w : Strata.World.World, ex : Float, ey : Float, ez : Float, yaw : Float, n : Int) : Crowd do
    wander_go(c, w, ex, ey, ez, yaw, 0, n)
  end

  -- ── Each frame ───────────────────────────────────────────────────────────
  pfn step_walkers(a : Strata.Anim.Anim, ws : List((Int, Float, Float, Float, Float, Float, Float, Int)), w : Strata.World.World, t : Float, frame : Int, i : Int, acc : List((Int, Float, Float, Float, Float, Float, Float, Int))) : (Strata.Anim.Anim, List((Int, Float, Float, Float, Float, Float, Float, Int))) do
    match ws do
      Nil -> (a, List.reverse(acc))
      Cons(wk, rest) ->
        match wk do
          (f, cx, cz, rad, a0, y0, v, kind) ->
            match walker_at(wk, t) do
              (x, z, yaw) ->
                -- kind 0 finds the ground under it every eighth frame, the crowd staggered over the eight; 3 and 4 every frame; 1 and 2 keep their height
                let every = kind == 3 || kind == 4
                let y = if every || (kind == 0 && (frame + i) % 8 == 0) do ground_at(w, x, z, y0 +. 1.5) else y0 end
                let a2 = An.place(a, f, x, y, z, ry(yaw *. 180.0 /. 3.14159265))
                step_walkers(a2, rest, w, t, frame, i + 1, Cons((f, cx, cz, rad, a0, y, v, kind), acc))
            end
        end
    end
  end

  pfn feet_go(a : Strata.Anim.Anim, fs : List(Int), w : Strata.World.World) : Strata.Anim.Anim do
    match fs do
      Nil -> a
      Cons(f, t) -> feet_go(An.ground(a, f, w, 1.0), t, w)
    end
  end

  doc "Move every walker to where it is at time [t] (seconds), on the ground of [w]; give the foot-placement figures their feet (timed in `ground_ms`); then advance the figures by [dt]."
  fn step(c : Crowd, w : Strata.World.World, t : Float, dt : Float, frame : Int) : Crowd do
    if c.rig_id < 0 do c
    else
      match step_walkers(c.anim, c.walkers, w, t, frame, 0, Nil) do
        (a1, ws) ->
          let t0 = Strata.Ffi.Vk.time()
          let a2 = if c.feet_on do feet_go(a1, c.feet, w) else a1 end
          let gms = (Strata.Ffi.Vk.time() -. t0) *. 1000.0
          { c with anim: An.update(a2, dt), walkers: ws, clock: t, ground_ms: gms }
      end
    end
  end
end
