-- figures — the viewer's example rigs and clips (designer's call: example
-- content, not library), and the crowds the scripted scenes draw.
--
-- The humanoid: voxels of 1/16 m, about 1.8 m tall, facing +z, 15 parts:
--   0 pelvis (the root, 0.94 m up), 1 spine, 2 head,
--   3-5 the left arm (upper arm, forearm, hand; on the +x side), 6-8 the right,
--   9-11 the left leg (thigh, shin, foot), 12-14 the right.
-- A socket on each hand (0 left, 1 right), both legs declared for foot
-- placement, mask 0 the right arm. Palette: 1 skin, 2 shirt, 3 trousers,
-- 4 boots, 5 hair, 6 eyes (they glow), 7 belt.
--
-- Clips, in `clips` order: idle, walk, run, jump, crouch, swim, swing,
-- flinch, fall.
-- Marks: 1 left foot down, 2 right foot down (walk, run), 3 the blade's
-- arrival (swing).
mod StrataViewer.Figures do

  needs IO.Foreign
  needs Anim

  alias Strata.Rig as Rg
  alias Strata.Clip as Cl
  alias Strata.Anim as An
  alias Strata.Math.Quat as Qt

  pfn rad(d : Float) : Float do d *. 3.14159265 /. 180.0 end
  pfn rx(d : Float) : Strata.Math.Quat.Quat do Qt.from_axis_angle(1.0, 0.0, 0.0, rad(d)) end
  pfn ry(d : Float) : Strata.Math.Quat.Quat do Qt.from_axis_angle(0.0, 1.0, 0.0, rad(d)) end
  pfn rz(d : Float) : Strata.Math.Quat.Quat do Qt.from_axis_angle(0.0, 0.0, 1.0, rad(d)) end

  -- ── The humanoid ─────────────────────────────────────────────────────────
  -- the palette with the shirt (entry 2) in the colour given
  pfn palette_in(r : Strata.Rig.Rig, sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do
    let r1 = Rg.colour(Rg.colour(Rg.colour(r, 1, 0.72, 0.46, 0.32, 0.7, 0.0), 2, sr, sg, sb, 0.85, 0.0), 3, 0.24, 0.19, 0.14, 0.9, 0.0)
    Rg.colour(Rg.colour(Rg.colour(Rg.colour(r1, 4, 0.08, 0.06, 0.05, 0.6, 0.0), 5, 0.17, 0.10, 0.05, 0.9, 0.0), 6, 0.35, 0.9, 1.0, 0.3, 0.9), 7, 0.45, 0.32, 0.10, 0.5, 0.0)
  end

  -- an arm hanging from (x, 8.5, 2) of the spine's grid: upper arm 6 voxels (shirt), forearm 5 (skin), hand 2; a socket under the hand
  pfn arm(r : Strata.Rig.Rig, spine : Int, x : Float) : Strata.Rig.Rig do
    match Rg.part(r, spine, x, 8.5, 2.0, 2, 6, 2) do
      (r1, up) ->
        match Rg.part(Rg.box(Rg.anchor(r1, up, 1.0, 6.0, 1.0), up, 0, 0, 0, 1, 5, 1, 2), up, 1.0, 0.0, 1.0, 2, 5, 2) do
          (r2, fore) ->
            match Rg.part(Rg.box(Rg.anchor(r2, fore, 1.0, 5.0, 1.0), fore, 0, 0, 0, 1, 4, 1, 1), fore, 1.0, 0.0, 1.0, 2, 2, 2) do
              (r3, hand) -> Tuple.first(Rg.socket(Rg.box(Rg.anchor(r3, hand, 1.0, 2.0, 1.0), hand, 0, 0, 0, 1, 1, 1, 1), hand, 1.0, 0.5, 1.0, Qt.identity()))
            end
        end
    end
  end

  -- a leg from (x, 0, 2) of the pelvis's grid: thigh and shin of 7 voxels (trousers), a boot 5 long reaching forward
  pfn leg(r : Strata.Rig.Rig, pelvis : Int, x : Float) : (Strata.Rig.Rig, Int, Int, Int) do
    match Rg.part(r, pelvis, x, 0.0, 2.0, 3, 7, 3) do
      (r1, th) ->
        match Rg.part(Rg.box(Rg.anchor(r1, th, 1.5, 7.0, 1.5), th, 0, 0, 0, 2, 6, 2, 3), th, 1.5, 0.0, 1.5, 3, 7, 3) do
          (r2, sh) ->
            match Rg.part(Rg.box(Rg.anchor(r2, sh, 1.5, 7.0, 1.5), sh, 0, 0, 0, 2, 6, 2, 3), sh, 1.5, 0.0, 1.5, 3, 1, 5) do
              (r3, ft) -> (Rg.box(Rg.anchor(r3, ft, 1.5, 1.0, 1.5), ft, 0, 0, 0, 2, 0, 4, 4), th, sh, ft)
            end
        end
    end
  end

  -- the head: skin, hair over the top and back, two glowing eyes on the front (+z)
  pfn head_voxels(r : Strata.Rig.Rig, h : Int) : Strata.Rig.Rig do
    let r1 = Rg.box(Rg.box(Rg.box(r, h, 0, 0, 0, 4, 4, 4, 1), h, 0, 4, 0, 4, 4, 4, 5), h, 0, 1, 0, 4, 3, 0, 5)
    Rg.voxel(Rg.voxel(r1, h, 1, 2, 4, 6), h, 3, 2, 4, 6)
  end

  doc "The humanoid rig (see the module's head)."
  fn humanoid() : Strata.Rig.Rig do humanoid_in(0.12, 0.26, 0.62) end

  doc "The humanoid with its shirt in the colour (sr, sg, sb): a rig of its own, so its clips are its own too."
  fn humanoid_in(sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do
    match Rg.part(palette_in(Rg.new(0.0625), sr, sg, sb), -1, 0.0, 15.0, 0.0, 6, 3, 4) do
      (r1, pelvis) ->
        let r1b = Rg.box(Rg.box(Rg.anchor(r1, pelvis, 3.0, 0.0, 2.0), pelvis, 0, 0, 0, 5, 2, 3, 3), pelvis, 0, 2, 0, 5, 2, 3, 7)
        match Rg.part(r1b, pelvis, 3.0, 3.0, 2.0, 8, 9, 4) do
          (r2, spine) ->
            match Rg.part(Rg.box(Rg.anchor(r2, spine, 4.0, 0.0, 2.0), spine, 0, 0, 0, 7, 8, 3, 2), spine, 4.0, 9.0, 2.0, 5, 5, 5) do
              (r3, head) ->
                let r4 = head_voxels(Rg.anchor(r3, head, 2.5, 0.0, 2.5), head)
                -- the left arm on the +x side (the figure faces +z), then the right
                let r5 = arm(arm(r4, spine, 9.0), spine, -1.0)
                match leg(r5, pelvis, 4.5) do
                  (r6, lu, ll, lf) ->
                    match leg(r6, pelvis, 1.5) do
                      (r7, ru, rl, rf) -> Tuple.first(Rg.mask(Rg.leg(Rg.leg(r7, lu, ll, lf, 0.0625), ru, rl, rf, 0.0625), [6]))
                    end
                end
            end
        end
    end
  end

  -- ── Clips ────────────────────────────────────────────────────────────────
  -- a pose held over a whole clip: each (part, rotation) keyed at 0 and at the end
  pfn hold(c : Strata.Clip.Clip, d : Float, ks : List((Int, Float, Float, Float))) : Strata.Clip.Clip do
    match ks do
      Nil -> c
      Cons((p, ax, ay, az), t) ->
        let q = Qt.mul(Qt.mul(rx(ax), ry(ay)), rz(az))
        hold(Cl.turn(Cl.turn(c, p, 0.0, q, Cl.smooth()), p, d, q, Cl.smooth()), d, t)
    end
  end
  -- turn keys through a list of (time, degrees about x)
  pfn keys_x(c : Strata.Clip.Clip, p : Int, ks : List((Float, Float))) : Strata.Clip.Clip do
    match ks do
      Nil -> c
      Cons((t, d), rest) -> keys_x(Cl.turn(c, p, t, rx(d), Cl.smooth()), p, rest)
    end
  end

  -- standing, breathing: the spine and head sway, the arms hang a little out
  pfn idle(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c = Cl.swing(Cl.swing(Cl.new(r, 2.0, true), 1, 1.0, 0.0, 0.0, 3.0, 2.0, 0.0), 2, 0.0, 1.0, 0.0, 6.0, 2.0, 0.25)
    Cl.swing(Cl.swing(c, 3, 0.0, 0.0, 1.0, 5.0, 2.0, 0.0), 6, 0.0, 0.0, 1.0, -5.0, 2.0, 0.0)
  end

  -- a walk: one loop is two steps, 1.4 m; a positive turn about x carries a foot back
  pfn walk(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.swing(Cl.swing(Cl.new(r, 1.0, true), 9, 1.0, 0.0, 0.0, 25.0, 1.0, 0.25), 12, 1.0, 0.0, 0.0, 25.0, 1.0, 0.75)
    let c1 = Cl.swing(Cl.swing(c0, 10, 1.0, 0.0, 0.0, 18.0, 1.0, 0.375), 13, 1.0, 0.0, 0.0, 18.0, 1.0, 0.875)
    let c2 = Cl.swing(Cl.swing(c1, 3, 1.0, 0.0, 0.0, 20.0, 1.0, 0.75), 6, 1.0, 0.0, 0.0, 20.0, 1.0, 0.25)
    -- a foot is down when its leg is furthest forward: the left at 0.5, the right at 0
    Cl.stride(Cl.mark(Cl.mark(c2, 0.5, 1), 0.0, 2), 1.4)
  end

  -- a run: bigger swings, bent arms, the body leaning forward; one loop 0.6 s, 2.4 m
  pfn run(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.swing(Cl.swing(Cl.new(r, 0.6, true), 9, 1.0, 0.0, 0.0, 45.0, 0.6, 0.25), 12, 1.0, 0.0, 0.0, 45.0, 0.6, 0.75)
    let c1 = Cl.swing(Cl.swing(c0, 10, 1.0, 0.0, 0.0, 35.0, 0.6, 0.375), 13, 1.0, 0.0, 0.0, 35.0, 0.6, 0.875)
    let c2 = Cl.swing(Cl.swing(c1, 3, 1.0, 0.0, 0.0, 40.0, 0.6, 0.75), 6, 1.0, 0.0, 0.0, 40.0, 0.6, 0.25)
    let c3 = hold(c2, 0.6, [(1, 12.0, 0.0, 0.0), (4, -70.0, 0.0, 0.0), (7, -70.0, 0.0, 0.0)])
    Cl.stride(Cl.mark(Cl.mark(c3, 0.3, 1), 0.0, 2), 2.4)
  end

  -- a jump: crouch, up 0.5 m with the knees tucked and the arms raised, land; not looping
  pfn jump(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.move(Cl.move(Cl.new(r, 0.8, false), 0, 0.0, 0.0, 0.0, 0.0, Cl.smooth()), 0, 0.15, 0.0, -0.15, 0.0, Cl.smooth()), 0, 0.4, 0.0, 0.5, 0.0, Cl.smooth()), 0, 0.8, 0.0, 0.0, 0.0, Cl.smooth())
    let c1 = keys_x(keys_x(c0, 9, [(0.0, 0.0), (0.15, -40.0), (0.4, -55.0), (0.8, 0.0)]), 12, [(0.0, 0.0), (0.15, -40.0), (0.4, -55.0), (0.8, 0.0)])
    let c2 = keys_x(keys_x(c1, 10, [(0.0, 0.0), (0.15, 70.0), (0.4, 90.0), (0.8, 0.0)]), 13, [(0.0, 0.0), (0.15, 70.0), (0.4, 90.0), (0.8, 0.0)])
    let up_l = Cl.turn(Cl.turn(Cl.turn(c2, 3, 0.0, rz(0.0), Cl.smooth()), 3, 0.4, rz(150.0), Cl.smooth()), 3, 0.8, rz(0.0), Cl.smooth())
    Cl.turn(Cl.turn(Cl.turn(up_l, 6, 0.0, rz(0.0), Cl.smooth()), 6, 0.4, rz(-150.0), Cl.smooth()), 6, 0.8, rz(0.0), Cl.smooth())
  end

  -- a crouch held low, bobbing a little: knees forward, feet flat, the body leaning in
  pfn crouch(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.move(Cl.new(r, 2.0, true), 0, 0.0, 0.0, -0.36, 0.0, Cl.smooth()), 0, 1.0, 0.0, -0.39, 0.0, Cl.smooth()), 0, 2.0, 0.0, -0.36, 0.0, Cl.smooth())
    hold(c0, 2.0, [(9, -70.0, 0.0, 0.0), (12, -70.0, 0.0, 0.0), (10, 110.0, 0.0, 0.0), (13, 110.0, 0.0, 0.0), (11, -40.0, 0.0, 0.0), (14, -40.0, 0.0, 0.0), (1, 25.0, 0.0, 0.0), (2, -20.0, 0.0, 0.0), (3, -30.0, 0.0, 0.0), (6, -30.0, 0.0, 0.0), (4, -60.0, 0.0, 0.0), (7, -60.0, 0.0, 0.0)])
  end

  -- a swim: the body flat, face down, 0.5 m lower; the arms stroking, the legs kicking
  pfn swim(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.new(r, 1.2, true), 0, 0.0, 0.0, -0.5, 0.0, Cl.smooth()), 0, 1.2, 0.0, -0.5, 0.0, Cl.smooth())
    let c1 = hold(c0, 1.2, [(0, 80.0, 0.0, 0.0), (2, -50.0, 0.0, 0.0)])
    let c2 = Cl.swing(Cl.swing(c1, 3, 0.0, 0.0, 1.0, 60.0, 1.2, 0.0), 6, 0.0, 0.0, 1.0, -60.0, 1.2, 0.0)
    Cl.swing(Cl.swing(c2, 9, 1.0, 0.0, 0.0, 15.0, 0.6, 0.0), 12, 1.0, 0.0, 0.0, 15.0, 0.6, 0.5)
  end

  -- a sword swing of the right arm: raised over the head, brought down ahead, the body turning with it; the blade arrives at 0.5
  pfn swing(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = keys_x(Cl.new(r, 0.8, false), 6, [(0.0, -150.0), (0.25, -165.0), (0.5, -45.0), (0.8, -25.0)])
    let c1 = keys_x(c0, 7, [(0.0, -40.0), (0.25, -50.0), (0.5, -10.0), (0.8, -10.0)])
    let c2 = Cl.turn(Cl.turn(Cl.turn(c1, 1, 0.0, ry(20.0), Cl.smooth()), 1, 0.5, ry(-25.0), Cl.smooth()), 1, 0.8, ry(-15.0), Cl.smooth())
    Cl.mark(c2, 0.5, 3)
  end

  -- ── The torch ────────────────────────────────────────────────────────────
  doc "A torch: one part of voxels of 1/16 m, a wooden handle 10 voxels long under a 4 x 5 x 4 flame that glows (palette 1 wood, 2 flame); held by the grip 1 voxel up the handle (its anchor), to hang from a hand socket."
  fn torch() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.30, 0.18, 0.08, 0.9, 0.0), 2, 1.0, 0.55, 0.16, 0.9, 1.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 4, 15, 4) do
      (r1, p) -> Rg.box(Rg.box(Rg.anchor(r1, p, 2.0, 1.0, 2.0), p, 1, 0, 1, 2, 9, 2, 1), p, 0, 10, 0, 3, 14, 3, 2)
    end
  end

  -- a flinch: the spine and head thrown back and the arms out, then back; 0.25 s, the upper body only, so it layers over the legs
  pfn flinch(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = keys_x(keys_x(Cl.new(r, 0.25, false), 1, [(0.0, 0.0), (0.08, -18.0), (0.25, 0.0)]), 2, [(0.0, 0.0), (0.08, -25.0), (0.25, 0.0)])
    let c1 = Cl.turn(Cl.turn(Cl.turn(c0, 3, 0.0, rz(0.0), Cl.smooth()), 3, 0.08, rz(35.0), Cl.smooth()), 3, 0.25, rz(0.0), Cl.smooth())
    Cl.turn(Cl.turn(Cl.turn(c1, 6, 0.0, rz(0.0), Cl.smooth()), 6, 0.08, rz(-35.0), Cl.smooth()), 6, 0.25, rz(0.0), Cl.smooth())
  end

  -- a fall: over backward to lying on the ground, the knees giving first and the arms flung out; 0.6 s, the last pose held
  pfn fall(r : Strata.Rig.Rig) : Strata.Clip.Clip do
    let c0 = Cl.move(Cl.move(Cl.move(Cl.new(r, 0.6, false), 0, 0.0, 0.0, 0.0, 0.0, Cl.smooth()), 0, 0.25, 0.0, -0.3, -0.15, Cl.smooth()), 0, 0.6, 0.0, -0.8, -0.5, Cl.smooth())
    let c1 = keys_x(c0, 0, [(0.0, 0.0), (0.25, -25.0), (0.6, -90.0)])
    let c2 = keys_x(keys_x(c1, 9, [(0.0, 0.0), (0.25, -35.0), (0.6, -5.0)]), 12, [(0.0, 0.0), (0.25, -30.0), (0.6, 8.0)])
    let c3 = keys_x(keys_x(c2, 10, [(0.0, 0.0), (0.25, 60.0), (0.6, 12.0)]), 13, [(0.0, 0.0), (0.25, 55.0), (0.6, 4.0)])
    let c4 = Cl.turn(Cl.turn(c3, 3, 0.0, rz(0.0), Cl.smooth()), 3, 0.6, rz(75.0), Cl.smooth())
    keys_x(Cl.turn(Cl.turn(c4, 6, 0.0, rz(0.0), Cl.smooth()), 6, 0.6, rz(-60.0), Cl.smooth()), 2, [(0.0, 0.0), (0.6, -15.0)])
  end

  doc "The humanoid's clips, in order: idle, walk, run, jump, crouch, swim, swing, then flinch and fall."
  fn clips(r : Strata.Rig.Rig) : List(Strata.Clip.Clip) do [idle(r), walk(r), run(r), jump(r), crouch(r), swim(r), swing(r), flinch(r), fall(r)] end

  -- ── The match's small rigs ───────────────────────────────────────────────
  doc "A bow: one part of voxels of 1/16 m, a curved stave 14 voxels tall with its string (palette 1 wood, 2 string); held by its middle (its anchor), to hang from a hand socket."
  fn bow_of(voxel : Float) : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(voxel), 1, 0.36, 0.22, 0.10, 0.8, 0.0), 2, 0.85, 0.82, 0.74, 0.9, 0.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 1, 14, 3) do
      (r1, p) ->
        let stave = Rg.box(Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 0.5, 7.0, 0.5), p, 0, 3, 0, 0, 10, 0, 1), p, 0, 1, 1, 0, 2, 1, 1), p, 0, 11, 1, 0, 12, 1, 1), p, 0, 0, 2, 0, 0, 2, 1), p, 0, 13, 2, 0, 13, 2, 1)
        Rg.box(stave, p, 0, 1, 2, 0, 12, 2, 2)
    end
  end
  doc "`bow` with voxels of [voxel] metres: a smaller one is what the player holds before its eye."
  fn bow() : Strata.Rig.Rig do bow_of(0.0625) end

  doc "An arrow: one part, 14 voxels of 1/16 m along +z (0.9 m), a wooden shaft with a grey head at its front and pale fletching (palette 1 wood, 2 head, 3 feather); its anchor is its middle."
  fn arrow() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.colour(Rg.new(0.0625), 1, 0.42, 0.28, 0.14, 0.8, 0.0), 2, 0.55, 0.56, 0.60, 0.4, 0.0), 3, 0.9, 0.9, 0.85, 0.9, 0.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 1, 1, 14) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 0.5, 0.5, 7.0), p, 0, 0, 2, 0, 0, 11, 1), p, 0, 0, 12, 0, 0, 13, 2), p, 0, 0, 0, 0, 0, 1, 3)
    end
  end

  doc "A fireball: one part, a rounded lump 6 voxels of 1/16 m across (0.4 m) that glows as the torch's flame does (palette 1 flame, 2 its bright heart); its anchor is its middle."
  fn fireball_of(voxel : Float) : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(voxel), 1, 1.0, 0.45, 0.10, 0.9, 1.0), 2, 1.0, 0.85, 0.35, 0.9, 1.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 6, 6, 6) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 3.0, 3.0, 3.0), p, 0, 1, 1, 5, 4, 4, 1), p, 1, 0, 1, 4, 5, 4, 1), p, 1, 1, 0, 4, 4, 5, 1), p, 2, 2, 2, 3, 3, 3, 2)
    end
  end
  doc "`fireball` with voxels of [voxel] metres: a smaller one is what the player holds before its eye."
  fn fireball() : Strata.Rig.Rig do fireball_of(0.0625) end

  doc "A sword: one part of 1/16 m voxels standing along +y, a brown grip, a dark guard and a pale blade 12 long (palette 1 blade, 2 guard, 3 grip); its anchor is the grip, where a hand holds it."
  fn sword_of(voxel : Float) : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.colour(Rg.new(voxel), 1, 0.82, 0.84, 0.90, 0.25, 0.0), 2, 0.30, 0.26, 0.20, 0.6, 0.0), 3, 0.45, 0.30, 0.15, 0.8, 0.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 6, 16, 2) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 3.0, 1.5, 1.0), p, 2, 0, 0, 3, 2, 1, 3), p, 0, 3, 0, 5, 3, 1, 2), p, 2, 4, 0, 3, 15, 1, 1)
    end
  end
  doc "`sword` with voxels of [voxel] metres: a smaller one is what the player holds before its eye."
  fn sword() : Strata.Rig.Rig do sword_of(0.0625) end

  doc "An iceball: the fireball's lump in pale blue, glowing (palette 1 ice, 2 its white heart); its anchor is its middle."
  fn iceball_of(voxel : Float) : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(voxel), 1, 0.45, 0.80, 1.0, 0.3, 0.8), 2, 0.92, 0.98, 1.0, 0.3, 1.0)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 6, 6, 6) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 3.0, 3.0, 3.0), p, 0, 1, 1, 5, 4, 4, 1), p, 1, 0, 1, 4, 5, 4, 1), p, 1, 1, 0, 4, 4, 5, 1), p, 2, 2, 2, 3, 3, 3, 2)
    end
  end
  doc "`iceball` with voxels of [voxel] metres: a smaller one is what the player holds before its eye."
  fn iceball() : Strata.Rig.Rig do iceball_of(0.0625) end

  -- ── The player's own body, seen from its own eyes ────────────────────────
  pfn emptied(r : Strata.Rig.Rig, part : Int, last : Int) : Strata.Rig.Rig do
    if part > last do r
    else
      match piece_shape(part) do
        (sx, sy, sz, _) -> emptied(Rg.box(r, part, 0, 0, 0, sx - 1, sy - 1, sz - 1, 0), part + 1, last)
      end
    end
  end
  doc "The humanoid as the player sees its own: every part and joint as `humanoid_in`, so the same clips move it, but its head and arms hold no voxels: the eye sits where the head was, and the arms it sees are `forearm`s."
  fn body_in(sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do emptied(humanoid_in(sr, sg, sb), 2, 8) end
  doc "A forearm and hand for the player's view: 30 voxels of 1.2 cm along +z (36 cm), a sleeve in the shirt's colour (sr, sg, sb) with a darker cuff, and a hand (palette 1 the sleeve, 2 skin, 3 the cuff); its anchor is the palm, where what it holds is."
  fn forearm(sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do
    let c = Rg.colour(Rg.colour(Rg.colour(Rg.new(0.012), 1, sr, sg, sb, 0.85, 0.0), 2, 0.72, 0.46, 0.32, 0.7, 0.0), 3, sr *. 0.55, sg *. 0.55, sb *. 0.55, 0.85, 0.0)
    match Rg.part(c, -1, 0.0, 0.0, 0.0, 7, 7, 30) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 3.5, 3.5, 26.0), p, 0, 0, 0, 6, 6, 19, 1), p, 0, 0, 20, 6, 6, 21, 3), p, 1, 1, 22, 5, 5, 28, 2), p, 1, 5, 23, 2, 6, 26, 2)
    end
  end

  -- ── What the player holds before its eye: fine voxels, since they are seen from half a metre ──
  pfn isqrt_go(n : Int, r : Int) : Int do if (r + 1) * (r + 1) > n do r else isqrt_go(n, r + 1) end end
  -- one row of a ball 2 r voxels across: the cells of row (y, z) inside it, its heart in the bright colour
  pfn ball_go(r0 : Strata.Rig.Rig, p : Int, r : Int, i : Int) : Strata.Rig.Rig do
    if i >= 4 * r * r do r0
    else
      let y = i % (2 * r)
      let z = i / (2 * r)
      -- twice the distance from the middle, so the middle falls between cells
      let dy = 2 * y + 1 - 2 * r
      let dz = 2 * z + 1 - 2 * r
      let left = 4 * r * r - dy * dy - dz * dz
      if left <= 0 do ball_go(r0, p, r, i + 1)
      else
        let w = (isqrt_go(left, 0) + 1) / 2
        let shell = Rg.box(r0, p, r - w, y, z, r + w - 1, y, z, 1)
        let core = 4 * (r / 2) * (r / 2) - dy * dy - dz * dz
        let cw = if core <= 0 do 0 else (isqrt_go(core, 0) + 1) / 2 end
        let filled = if cw <= 0 do shell else Rg.box(shell, p, r - cw, y, z, r + cw - 1, y, z, 2) end
        ball_go(filled, p, r, i + 1)
      end
    end
  end
  doc "A ball of fire (or with [ice], of ice) for the hand: round, 14 voxels of 1.2 cm across, glowing, its heart brighter (palette 1 its body, 2 its heart); its anchor is its middle."
  fn held_ball(ice : Bool) : Strata.Rig.Rig do
    let r0 = if ice do Rg.colour(Rg.colour(Rg.new(0.012), 1, 0.45, 0.80, 1.0, 0.3, 0.8), 2, 0.92, 0.98, 1.0, 0.3, 1.0)
      else Rg.colour(Rg.colour(Rg.new(0.012), 1, 1.0, 0.45, 0.10, 0.9, 1.0), 2, 1.0, 0.85, 0.35, 0.9, 1.0) end
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 14, 14, 14) do
      (r1, p) -> ball_go(Rg.anchor(r1, p, 7.0, 7.0, 7.0), p, 7, 0)
    end
  end

  doc "A sword for the hand: 54 voxels of 8 mm standing along +y (43 cm). A pommel, a grip bound in two places, a cross guard, and a blade with a bright edge and a dark fuller that narrows to its point (palette 1 the blade, 2 its edge, 3 the fuller, 4 the guard and pommel, 5 the grip, 6 its binding); its anchor is the grip."
  fn held_sword() : Strata.Rig.Rig do
    let c1 = Rg.colour(Rg.colour(Rg.colour(Rg.new(0.008), 1, 0.74, 0.77, 0.84, 0.25, 0.0), 2, 0.93, 0.95, 1.0, 0.15, 0.0), 3, 0.50, 0.53, 0.60, 0.3, 0.0)
    let c2 = Rg.colour(Rg.colour(Rg.colour(c1, 4, 0.62, 0.50, 0.22, 0.35, 0.0), 5, 0.36, 0.22, 0.12, 0.85, 0.0), 6, 0.20, 0.13, 0.08, 0.85, 0.0)
    match Rg.part(c2, -1, 0.0, 0.0, 0.0, 13, 54, 3) do
      (r1, p) ->
        let hilt = Rg.box(Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 6.5, 6.0, 1.5), p, 5, 0, 0, 7, 1, 2, 4), p, 5, 2, 0, 7, 10, 2, 5), p, 5, 4, 0, 7, 4, 2, 6), p, 5, 8, 0, 7, 8, 2, 6), p, 0, 11, 0, 12, 12, 2, 4)
        let guard = Rg.box(Rg.box(hilt, p, 0, 13, 1, 0, 13, 1, 4), p, 12, 13, 1, 12, 13, 1, 4)
        -- the blade: a thin bright edge either side of a thicker middle, the fuller down both faces
        let blade = Rg.box(Rg.box(Rg.box(Rg.box(Rg.box(guard, p, 4, 13, 1, 8, 45, 1, 2), p, 5, 13, 0, 7, 45, 2, 1), p, 6, 15, 0, 6, 40, 0, 3), p, 6, 15, 2, 6, 40, 2, 3), p, 4, 46, 1, 8, 47, 1, 2)
        Rg.box(Rg.box(Rg.box(Rg.box(blade, p, 5, 46, 0, 7, 47, 2, 1), p, 5, 48, 1, 7, 50, 1, 2), p, 6, 48, 0, 6, 49, 2, 1), p, 6, 51, 1, 6, 53, 1, 2)
    end
  end

  -- the bow's stave at height y of 64: it bows away from the string, which hangs at x 11
  pfn stave_x(y : Int) : Int do
    let d = 2 * y - 63
    11 - (9 * (3969 - d * d) + 1984) / 3969
  end
  pfn stave_go(r : Strata.Rig.Rig, p : Int, y : Int) : Strata.Rig.Rig do
    if y >= 64 do r
    else
      let x = stave_x(y)
      -- two wide and two deep; the grip in the middle is bound and a little thicker; the tips are a paler horn
      let cell = if y >= 28 && y <= 35 do Rg.box(r, p, x - 1, y, 0, x + 1, y, 2, 3) else if y < 3 || y > 60 do Rg.box(r, p, x, y, 0, x + 1, y, 2, 4) else Rg.box(Rg.box(r, p, x, y, 0, x + 1, y, 2, 1), p, x, y, 1, x, y, 1, 5) end end
      stave_go(cell, p, y + 1)
    end
  end
  doc "A bow for the hand: 64 voxels of 1 cm tall, a stave that curves away from a straight string, a bound grip and horn tips (palette 1 the wood, 2 the string, 3 the grip, 4 the tips, 5 the wood's darker belly); its anchor is the grip. The string is at +x of the stave."
  fn held_bow() : Strata.Rig.Rig do
    let c1 = Rg.colour(Rg.colour(Rg.colour(Rg.new(0.01), 1, 0.50, 0.30, 0.12, 0.95, 0.0), 2, 0.90, 0.88, 0.80, 0.95, 0.0), 3, 0.20, 0.12, 0.08, 0.95, 0.0)
    let c2 = Rg.colour(Rg.colour(c1, 4, 0.86, 0.80, 0.66, 0.9, 0.0), 5, 0.38, 0.22, 0.09, 0.95, 0.0)
    match Rg.part(c2, -1, 0.0, 0.0, 0.0, 14, 64, 3) do
      (r1, p) -> Rg.box(stave_go(Rg.anchor(r1, p, 3.0, 32.0, 1.5), p, 0), p, 12, 1, 1, 12, 62, 1, 2)
    end
  end

  -- a shield's row y of 30: how far it is from each side, so its top is square and its foot comes to a point
  pfn shield_in(y : Int) : Int do if y >= 12 do 0 else (12 - y) * 11 / 12 end end
  pfn shield_go(r : Strata.Rig.Rig, p : Int, y : Int) : Strata.Rig.Rig do
    if y >= 30 do r
    else
      let i = shield_in(y)
      -- a steel rim round a painted face
      let row = Rg.box(r, p, i, y, 0, 23 - i, y, 1, 2)
      shield_go(if y == 0 || y == 29 || 23 - i - 1 < i + 1 do row else Rg.box(row, p, i + 1, y, 0, 22 - i, y, 1, 1) end, p, y + 1)
    end
  end
  doc "A shield of voxels of [voxel] metres: 24 wide and 30 tall in the x-y plane, square at the top and pointed at the foot, a painted face in a steel rim with a boss and a bar across it (palette 1 the face, 2 steel, 3 the bar); its anchor is its middle. At 0.012 it is what the player holds; at 0.03 what lies on the ground and hangs on an arm."
  fn shield_of(voxel : Float) : Strata.Rig.Rig do
    let c = Rg.colour(Rg.colour(Rg.colour(Rg.new(voxel), 1, 0.16, 0.30, 0.58, 0.6, 0.0), 2, 0.70, 0.72, 0.78, 0.3, 0.0), 3, 0.90, 0.78, 0.30, 0.5, 0.0)
    match Rg.part(c, -1, 0.0, 0.0, 0.0, 24, 30, 3) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(shield_go(Rg.anchor(r1, p, 12.0, 15.0, 1.0), p, 0), p, 2, 19, 0, 21, 20, 1, 3), p, 11, 3, 0, 12, 27, 1, 3), p, 10, 18, 2, 13, 21, 2, 2)
    end
  end

  doc "A health pickup: one part, a white box 5 voxels of 1/8 m across (0.6 m) with a red cross on its four sides, glowing a little (palette 1 white, 2 red); its anchor is its middle."
  fn medkit() : Strata.Rig.Rig do
    let r0 = Rg.colour(Rg.colour(Rg.new(0.125), 1, 0.95, 0.95, 0.95, 0.6, 0.35), 2, 0.9, 0.08, 0.08, 0.6, 0.6)
    match Rg.part(r0, -1, 0.0, 0.0, 0.0, 5, 5, 5) do
      (r1, p) -> Rg.box(Rg.box(Rg.box(Rg.box(Rg.box(Rg.anchor(r1, p, 2.5, 2.5, 2.5), p, 0, 0, 0, 4, 4, 4, 1), p, 2, 1, 0, 2, 3, 4, 2), p, 1, 2, 0, 3, 2, 4, 2), p, 0, 1, 2, 4, 3, 2, 2), p, 0, 2, 1, 4, 2, 3, 2)
    end
  end

  -- a humanoid part alone: its size in voxels and its main palette colour
  pfn piece_shape(part : Int) : (Int, Int, Int, Int) do
    if part == 0 do (6, 3, 4, 3)
    else if part == 1 do (8, 9, 4, 2)
    else if part == 2 do (5, 5, 5, 1)
    else if part == 3 || part == 6 do (2, 6, 2, 2)
    else if part == 4 || part == 7 do (2, 5, 2, 1)
    else if part == 5 || part == 8 do (2, 2, 2, 1)
    else if part == 11 || part == 14 do (3, 1, 5, 4)
    else (3, 7, 3, 3) end end end end end end end
  end
  doc "The humanoid's part [part] (0 to 14, as the module's head lists them) alone, as a rig of one part in the humanoid's palette, anchored at its middle: what a fallen fighter comes apart into."
  fn piece(part : Int) : Strata.Rig.Rig do piece_in(part, 0.12, 0.26, 0.62) end

  doc "`piece` with the shirt in the colour (sr, sg, sb): it shows on the spine (part 1) and the upper arms (3 and 6)."
  fn piece_in(part : Int, sr : Float, sg : Float, sb : Float) : Strata.Rig.Rig do
    match piece_shape(part) do
      (sx, sy, sz, col) ->
        match Rg.part(palette_in(Rg.new(0.0625), sr, sg, sb), -1, 0.0, 0.0, 0.0, sx, sy, sz) do
          (r1, p) ->
            let r2 = Rg.anchor(r1, p, int_to_float(sx) /. 2.0, int_to_float(sy) /. 2.0, int_to_float(sz) /. 2.0)
            if part == 2 do head_voxels(r2, p) else Rg.box(r2, p, 0, 0, 0, sx - 1, sy - 1, sz - 1, col) end
        end
    end
  end

  -- ── Crowds ───────────────────────────────────────────────────────────────
  -- The figures a scene draws: the world, the humanoid, its id and its clips'
  -- ids (in `clips` order), and the walkers: (figure, x, z, radius, angle,
  -- height, speed). A walker with a radius walks round the circle about
  -- (x, z), from that angle at time 0; one of radius 0 walks a straight line
  -- from (x, z) toward that yaw. Speed: the walk's 1.4 m/s times its rate.
  -- The torch rig and its id ride along (`add_torch`), and the last figure added (`trace_last`).
  type Crowd = { anim : Strata.Anim.Anim, body : Strata.Rig.Rig, rig_id : Int, clip_ids : List(Int), walkers : List((Int, Float, Float, Float, Float, Float, Float)), flame : Strata.Rig.Rig, torch_id : Int, last : Int }

  doc "No figures: nothing is opened, nothing drawn."
  fn none() : Crowd do { anim: { rigs: Nil, capacity: 0 }, body: Rg.new(0.0625), rig_id: -1, clip_ids: Nil, walkers: Nil, flame: Rg.new(0.0625), torch_id: -1, last: -1 } end

  doc "How many figures walk."
  fn walking(c : Crowd) : Int do List.length(c.walkers) end

  pfn finish_clips(a : Strata.Anim.Anim, cs : List(Strata.Clip.Clip), acc : List(Int)) : (Strata.Anim.Anim, List(Int)) do
    match cs do
      Nil -> (a, List.reverse(acc))
      Cons(c, t) -> match An.finish_clip(a, c) do (a2, id) -> finish_clips(a2, t, Cons(id, acc)) end
    end
  end

  doc "Open a figure world for [capacity] figures with the humanoid, its clips and the torch finished in it. The renderer still needs `Strata.Render.figures` with `rigs`."
  fn open(capacity : Int) : Crowd do
    let r = humanoid()
    let t = torch()
    match An.finish_rig(An.open(capacity), r) do
      (a1, id) ->
        match finish_clips(a1, clips(r), Nil) do
          (a2, ids) ->
            match An.finish_rig(a2, t) do
              (a3, tid) -> { anim: a3, body: r, rig_id: id, clip_ids: ids, walkers: Nil, flame: t, torch_id: tid, last: -1 }
            end
        end
    end
  end

  doc "The humanoid rig the crowd was opened with (for `Strata.Render.figures`)."
  fn rig(c : Crowd) : Strata.Rig.Rig do c.body end
  doc "The crowd's rigs, the humanoid and the torch (for `Strata.Render.figures`)."
  fn rigs(c : Crowd) : List(Strata.Rig.Rig) do [c.body, c.flame] end

  doc "Draw the figure added last traced (Strata.Anim.traced): its shadow, reflections, sky darkening and glow come from the rays."
  fn trace_last(c : Crowd) : Crowd do
    if c.last < 0 do c else { c with anim: An.traced(c.anim, c.last, true) } end
  end

  doc "Put a lit torch in the right hand (socket 1) of the figure added last, held 0.1 m in front of the hand and leaning 25 degrees forward, traced like its holder; the torch becomes the figure added last."
  fn add_torch(c : Crowd) : Crowd do
    if c.last < 0 || c.torch_id < 0 do c
    else
      match An.spawn_at(c.anim, c.torch_id, 0.0, 0.0, 0.0, Qt.identity()) do
        (a1, t) ->
          if t < 0 do c
          else { c with anim: An.traced(An.attach(a1, t, c.last, 1, 0.0, 0.0, 0.1, rx(25.0)), t, true), last: t } end
      end
    end
  end
  doc "The humanoid's rig id in the crowd's figure world, and its clips' ids in `clips` order."
  fn body_id(c : Crowd) : Int do c.rig_id end
  fn clip_ids(c : Crowd) : List(Int) do c.clip_ids end
  doc "The crowd's figure world."
  fn anim(c : Crowd) : Strata.Anim.Anim do c.anim end

  pfn clip_id(c : Crowd, k : Int) : Int do unwrap_or(List.nth_opt(c.clip_ids, k), -1) end

  -- where a walker is at time t: (x, z, yaw); a circle when its radius is above 0, else a line along the yaw
  pfn walker_at(w : (Int, Float, Float, Float, Float, Float, Float), t : Float) : (Float, Float, Float) do
    match w do
      (_, cx, cz, rad, a0, _, v) ->
        if rad > 0.0 do
          let th = a0 +. t *. v /. rad
          (cx +. rad *. Math.cos(th), cz +. rad *. Math.sin(th), 0.0 -. th)
        else (cx +. Math.sin(a0) *. v *. t, cz +. Math.cos(a0) *. v *. t, a0) end
    end
  end

  doc "The ground's top under (x, z) in metres, searching down from [from] for 6 m (plants are not ground); [from] - 1.5 if there is none."
  fn ground_at(w : Strata.World.World, x : Float, z : Float, from : Float) : Float do
    let reg = Strata.World.registry(w)
    let h = Strata.Query.raycast(w, x, from, z, 0.0, -1.0, 0.0, 6.0, fn id -> id != 0 && Strata.Blocks.collides(reg, id) && Strata.Blocks.style_index(reg, id) != 1)
    if Strata.Query.is_hit(h) do from -. Strata.Query.hit_dist(h) else from -. 1.5 end
  end

  -- is the block liquid: a flowing fluid's state, or the viewer's sea (block 5: a plain block that does not collide, which Strata.Fluid treats as a sea by its id)
  pfn liquid(reg : Strata.Blocks.Registry, id : Int) : Bool do
    if id == 5 do true else Strata.Blocks.is_fluid(reg, id) end
  end
  doc "Is block [id] liquid in the viewer's world: a flowing fluid's state, or the sea?"
  fn is_liquid(reg : Strata.Blocks.Registry, id : Int) : Bool do liquid(reg, id) end
  doc "The top of dry ground under (x, z) in metres, searching down from [from] for [reach] m (plants are not ground); -1000.0 when nothing is found or the first thing below is water, the sea included."
  fn dry_ground_at(w : Strata.World.World, x : Float, z : Float, from : Float, reach : Float) : Float do
    let reg = Strata.World.registry(w)
    let h = Strata.Query.raycast(w, x, from, z, 0.0, -1.0, 0.0, reach, fn id -> id != 0 && (liquid(reg, id) || (Strata.Blocks.collides(reg, id) && Strata.Blocks.style_index(reg, id) != 1)))
    if !Strata.Query.is_hit(h) do -1000.0
    else if liquid(reg, Strata.World.get_block(w, Strata.Query.hit_x(h), Strata.Query.hit_y(h), Strata.Query.hit_z(h))) do -1000.0
    else from -. Strata.Query.hit_dist(h) end end
  end

  doc "Add a walker of the walk clip at [rate] (1.4 m/s at rate 1): round a circle of [radius] m about (cx, cz) starting at angle [a0], or (radius 0) along a straight line from (cx, cz) toward yaw [a0]; standing at height [y], found again from the world as it goes."
  fn add_walker(c : Crowd, cx : Float, cz : Float, radius : Float, a0 : Float, y : Float, rate : Float) : Crowd do
    let w0 = (0, cx, cz, radius, a0, y, 1.4 *. rate)
    match walker_at(w0, 0.0) do
      (x, z, yaw) ->
        match An.spawn_at(c.anim, c.rig_id, x, y, z, ry(yaw *. 180.0 /. 3.14159265)) do
          (a1, f) ->
            if f < 0 do c
            else
              let a2 = An.play(a1, f, 0, clip_id(c, 1), 0.0, rate, 1.0, -1, false)
              { c with anim: a2, walkers: Cons((f, cx, cz, radius, a0, y, 1.4 *. rate), c.walkers), last: f }
            end
        end
    end
  end

  doc "Add a figure frozen in clip [k] (in `clips` order) at its midpoint, at (x, y, z) turned [yaw] radians about y."
  fn add_posed(c : Crowd, k : Int, x : Float, y : Float, z : Float, yaw : Float) : Crowd do
    match An.spawn_at(c.anim, c.rig_id, x, y, z, ry(yaw *. 180.0 /. 3.14159265)) do
      (a1, f) ->
        if f < 0 do c
        else
          let mid = 0.5 *. Strata.Clip.duration(unwrap_or(List.nth_opt(clips(c.body), k), idle(c.body)))
          { c with anim: An.set_time(An.play(a1, f, 0, clip_id(c, k), 0.0, 0.0, 1.0, -1, false), f, 0, mid, 0.0), last: f }
        end
    end
  end

  pfn step_walkers(a : Strata.Anim.Anim, ws : List((Int, Float, Float, Float, Float, Float, Float)), w : Strata.World.World, t : Float, frame : Int, i : Int, acc : List((Int, Float, Float, Float, Float, Float, Float))) : (Strata.Anim.Anim, List((Int, Float, Float, Float, Float, Float, Float))) do
    match ws do
      Nil -> (a, List.reverse(acc))
      Cons(wk, rest) ->
        match wk do
          (f, cx, cz, rad, a0, y0, v) ->
            match walker_at(wk, t) do
              (x, z, yaw) ->
                -- each walker finds the ground under it every eighth frame, the crowd staggered over the eight
                let y = if (frame + i) % 8 == 0 do ground_at(w, x, z, y0 +. 1.5) else y0 end
                let a2 = An.place(a, f, x, y, z, ry(yaw *. 180.0 /. 3.14159265))
                step_walkers(a2, rest, w, t, frame, i + 1, Cons((f, cx, cz, rad, a0, y, v), acc))
            end
        end
    end
  end

  doc "Move every walker to where it is at time [t] (seconds), on the ground of [w], then advance the figures by [dt]."
  fn step(c : Crowd, w : Strata.World.World, t : Float, dt : Float, frame : Int) : Crowd do
    if c.rig_id < 0 do c
    else
      match step_walkers(c.anim, c.walkers, w, t, frame, 0, Nil) do
        (a1, ws) -> { c with anim: An.update(a1, dt), walkers: ws }
      end
    end
  end
end
