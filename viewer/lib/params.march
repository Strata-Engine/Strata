-- Params — the viewer's generator settings read from a text file.
--
-- One setting a line, `name = value`, the value a number; `#` starts a
-- comment, blank lines are skipped. A line that is not of that form is
-- reported by `bad_lines` and otherwise ignored, so a typo never stops the
-- viewer. Which names exist and what they default to is the caller's
-- business (StrataViewer's table); this module only reads.
mod StrataViewer.Params do

  needs IO.FileSystem

  -- the settings in file order, and the lines that could not be read
  type Params = Params(List((String, Float)), List(String))

  doc "No settings."
  fn empty() : Params do Params(Nil, Nil) end

  pfn number(s : String) : Option(Float) do
    match String.to_float(s) do
      Ok(v) -> Some(v)
      Err(_) ->
        match String.to_int(s) do
          Ok(n) -> Some(int_to_float(n))
          Err(_) -> None
        end
    end
  end

  -- a line without its comment, trimmed
  pfn bare(line : String) : String do
    match String.split_first(line, "#") do
      Some((before, _)) -> String.trim(before)
      None -> String.trim(line)
    end
  end

  pfn line_go(lines : List(String), vals : List((String, Float)), bad : List(String)) : Params do
    match lines do
      Nil -> Params(List.reverse(vals), List.reverse(bad))
      Cons(l, rest) ->
        let b = bare(l)
        if String.is_empty(b) do line_go(rest, vals, bad)
        else
          match String.split_first(b, "=") do
            None -> line_go(rest, vals, Cons(l, bad))
            Some((k, v)) ->
              let name = String.trim(k)
              match number(String.trim(v)) do
                Some(x) -> if String.is_empty(name) do line_go(rest, vals, Cons(l, bad)) else line_go(rest, Cons((name, x), vals), bad) end
                None -> line_go(rest, vals, Cons(l, bad))
              end
          end
        end
    end
  end

  doc "The settings in a text: `name = value` lines."
  fn parse(text : String) : Params do line_go(String.split(text, "\n"), Nil, Nil) end

  doc "The settings in the file at [path]; none if it cannot be read."
  fn read(path : String) : Params do
    match Authority.must(File.read(path)) do
      Ok(text) -> parse(text)
      Err(_) -> empty()
    end
  end

  pfn find(vals : List((String, Float)), name : String) : Option(Float) do
    match vals do
      Nil -> None
      -- a name given twice: the later line wins
      Cons((k, v), rest) ->
        match find(rest, name) do
          Some(w) -> Some(w)
          None -> if k == name do Some(v) else None end
        end
    end
  end

  doc "The value of [name], if the file sets it (the last line naming it wins)."
  fn get(p : Params, name : String) : Option(Float) do match p do Params(vals, _) -> find(vals, name) end end

  doc "The names set, in file order (a repeated name more than once)."
  fn names(p : Params) : List(String) do match p do Params(vals, _) -> List.map(vals, fn kv -> match kv do (k, _) -> k end) end end

  doc "The lines that were neither blank, a comment nor `name = number`."
  fn bad_lines(p : Params) : List(String) do match p do Params(_, bad) -> bad end end
end
