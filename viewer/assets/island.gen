# The viewer's island: the generator's tunable settings (the atlas, the
# noise, the caves, the surface, the trees and the regions), read at start
# and again on R (or STRATA_REGEN=1). Some numbers stay in the code: see the
# README's parameter file. One `name = value` a line; `#` starts a
# comment. A name left out takes the default in viewer/lib/strata_viewer.march
# (`param_table`) and is said once a load. Lengths, heights and periods are
# metres (a noise's frequency is 1 / its period); angles are degrees.
# Changing an atlas setting builds a new atlas (cached by its settings).

# ── The atlas (Strata.Atlas.Def) ─────────────────────────────────────────
atlas_samples = 512          # n x n samples
atlas_step = 4               # metres between samples
island_radius = 800
region_size = 160            # regions about this many metres across
region_count = 5
sea = 40                     # the sea level

# erosion (Strata.Erosion.params)
erosion_iterations = 50
erosion_dt = 250000
erosion_k = 0.000000561
erosion_m = 0.4
erosion_uplift = 0.000005
erosion_talus_lo = 15
erosion_talus_hi = 60

river_min_area = 2000        # square metres of drainage that make a river
lake_margin = 0.3            # a lake stands this far under its spill
site_count = 8
site_spacing = 150
site_flat = 2                # most height a site's 3 x 3 samples may span
lake_count = 6               # lakes carved before the flood
lake_radius = 30
lake_depth = 5

# ── Detail and density ───────────────────────────────────────────────────
detail_amplitude = 6         # fBm over the atlas height, damped by water
detail_period = 40
detail_octaves = 4
density_amplitude = 12       # A: the 3D noise's reach over and under H
density_squash = 1
density_period = 60
density_octaves = 3
density_stretch = 4          # the density noise stretched this many times upright

# ── Caves ────────────────────────────────────────────────────────────────
tunnel_period = 25
tunnel_width = 0.08          # times the region's cave factor
cavern_period = 90
cavern_open = 0.45           # times the region's cave factor
cave_roof = 6                # caves stay under this much density...
entrance_period = 120
entrance_threshold = 0.6     # ...except where the entrance noise passes this
cave_depth = 40              # and reach no deeper than this under H - A

# ── The surface ──────────────────────────────────────────────────────────
rock_period = 80             # rock strength: talus_mid +- talus_spread degrees
talus_mid = 40
talus_spread = 15
thermal_passes = 4
sand_below = 42
snow_above = 95
grass_below = 72             # tall grass and posts only below this
post_chance = 0.006          # of a one-metre cell of grass
tall_grass_chance = 0.14
beard_margin = 3             # a site's ground pulled to its floor this far past its radius

# ── Trees ────────────────────────────────────────────────────────────────
tree_cell = 6
tree_jitter = 0.6
tree_chance = 0.35           # times the region's density
tree_min_height = 41.5
tree_max_slope = 35

# ── Regions: tree density, the species' shares of the trees, cave factor ─
region0_trees = 0.9
region0_oak = 0.55
region0_birch = 0.25
region0_pine = 0.10
region0_willow = 0.10
region0_caves = 1
region1_trees = 1
region1_oak = 0.10
region1_birch = 0.20
region1_pine = 0.70
region1_willow = 0
region1_caves = 1
region2_trees = 0.6
region2_oak = 0.40
region2_birch = 0.40
region2_pine = 0.20
region2_willow = 0
region2_caves = 1
region3_trees = 0.8
region3_oak = 0.20
region3_birch = 0.50
region3_pine = 0.30
region3_willow = 0
region3_caves = 1
region4_trees = 0.5
region4_oak = 0.35
region4_birch = 0.15
region4_pine = 0.20
region4_willow = 0.30
region4_caves = 1
