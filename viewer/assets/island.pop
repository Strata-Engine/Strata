# The viewer's island: what stands on it, declared for Strata.Population and
# read by Strata.PopulationFile at start and again on R (or STRATA_REGEN=1),
# with island.gen. A {name} is an island.gen setting, or a number the viewer
# works out from the settings (pop_tokens in viewer/lib/strata_viewer.march):
#   tree_base        tree_chance / tree_cell^2: trees a square metre at density 1
#   tree_slope_tan   tan(tree_max_slope)
#   grass_lo         sea + 1 (tall grass and posts stand on floors above it)
#   beard_outer      the widest site radius + beard_margin
#   region_curve     region id : the region's tree density, -1 (the sea) and 4 read region 4
#   regionN_w        the twelve tree templates' weights in region N: each species' share, a third to each of its three
# The game supplies the template lists `trees` (12: oak, birch, pine,
# willow, three each) and `ruins` (wall, tower, arch), the site list `sites`
# (the atlas's), and per column the ground fields below.

# ── Fields the game supplies ─────────────────────────────────────────────
# (each is supplied, and evaluated, only at the columns where a layer reads
# it: a cover layer at the chunk's columns, a scatter layer at its
# candidates' columns; Strata.Populate.slots_read and fields_for)
[field slope]     kind = ground  slot = 1      # rise over run of H, a metre each side
[field water_depth] kind = ground  slot = 2    # 1 on a lake or river column
[field region]    kind = ground  slot = 7
[field entrance]  kind = ground  slot = 10     # the cave-entrance noise at the column
[field stand]     kind = ground  slot = 11     # the height (m) of the ground top a tree would stand on

# ── Zones ────────────────────────────────────────────────────────────────
[zone wet]        kind = band   field = water_depth   lo = 0.5               hi = 1e30
[zone steep]      kind = band   field = slope         lo = {tree_slope_tan}  hi = 1e30
[zone low]        kind = band   field = stand         lo = -1e30             hi = {tree_min_height}
[zone opening]    kind = band   field = entrance      lo = {entrance_threshold}  hi = 1e30
[zone beard]      kind = ring   sites = sites         inner = 0              outer = {beard_outer}
[zone r0]         kind = regions  ids = 0
[zone r1]         kind = regions  ids = 1
[zone r2]         kind = regions  ids = 2
[zone r3]         kind = regions  ids = 3
[zone r0to3]      kind = any    of = r0 r1 r2 r3
[zone r4]         kind = not    of = r0to3              # region 4, any later one, and the sea

# ── Shapes ───────────────────────────────────────────────────────────────
[shapes trees]    kind = templates  from = trees
                  ranks = 0 0 0 0 0 0 0 2 1           # coarser levels: wood (7) over leaves (8)
[weights trees r0]  w = {region0_w}
[weights trees r1]  w = {region1_w}
[weights trees r2]  w = {region2_w}
[weights trees r3]  w = {region3_w}
[weights trees r4]  w = {region4_w}
[shapes ruins]    kind = templates  from = ruins
[shapes post]     kind = blocks     ids = 12
[shapes tall_grass] kind = blocks   ids = 11

# ── Layers, in the order they run ────────────────────────────────────────
# trees: one a 6 m cell at most, never on water, within a site's beard, too
# steep, too low or where the caves open; seen at levels 0 to 2
# with STRATA_PROPS=1 the viewer puts the trees again at 0.25 m here, and the forest's instances stand as props of them
{props_shapes}
[layer forest]    kind = scatter  shapes = trees  salt = 21
                  {forest_props}
                  base = {tree_base}  by = region:{region_curve}
                  cell = {tree_cell}  jitter = {tree_jitter}
                  outside = wet beard steep low opening
                  seen_to = 2
# ruins: one on each site, the ground drawn to its floor over the beard margin; level 0 only
[layer ruins]     kind = site  shapes = ruins  sites = sites  margin = {beard_margin}  salt = 28  seen_to = 0
# posts, then tall grass, on a grass floor above a metre over the sea and at most grass_below; a post keeps its floor
[layer posts]     kind = cover  shapes = post        base = {post_chance}        outside = wet  on = 3  between = {grass_lo} {grass_below}  salt = 25
[layer grass]     kind = cover  shapes = tall_grass  base = {tall_grass_chance}  outside = wet  on = 3  between = {grass_lo} {grass_below}  salt = 26
