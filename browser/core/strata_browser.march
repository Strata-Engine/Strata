mod StrataBrowser do
  needs IO.Foreign
  alias Strata.Blocks as B
  alias Strata.Chunk as C
  alias Strata.Ffi.Noise as N
  alias Strata.Mesh as BrowserMesh

  extern "browser_fixture" : Cap(IO.Foreign) do
    fn seed() : Int = "strata_browser_seed"
    fn origin_x() : Int = "strata_browser_origin_x"
    fn origin_y() : Int = "strata_browser_origin_y"
    fn origin_z() : Int = "strata_browser_origin_z"
    fn editing() : Bool = "strata_browser_editing"
    fn sync_cells(cells : NativeI32Arr) : Unit = "strata_browser_sync_cells"
    fn padded(ids : NativeIntArr) : Bool = "strata_browser_padded"
    fn publish(quads : NativeI32Arr, count : Int, a : Float, b : Float, c : Float) : Unit = "strata_browser_publish"
  end

  fn noise(s : Int, x : Float, z : Float) : Float do
    N.sample2(0, 3, 2.0, 0.5, 1, 0.0, s, 0.125, x, z)
  end

  fn terrain_voxel(cells : NativeI32Arr, column : Int, height : Int) : NativeI32Arr do
    if height < 0 || height >= 32 do cells
    else NativeArray.set_i32(cells, column + 1024 * height, 1) end
  end

  fn fill(s : Int, ox : Int, oy : Int, oz : Int, cells : NativeI32Arr, i : Int) : NativeI32Arr do
    if i == 1024 || oy < 0 || oy > 32 do cells
    else
      let v = noise(s, int_to_float(ox + i % 32 - 32), int_to_float(oz + i / 32 - 16))
      let h = 4 + float_to_int(v *. 4.0)
      let base = terrain_voxel(cells, i, h - oy)
      let high = if ox >= 64 || ox <= -64 || oz >= 64 || oz <= -64 do terrain_voxel(base, i, 28 + h - oy)
        else base end
      fill(s, ox, oy, oz, high, i + 1)
    end
  end

  fn main(_cap : Cap(IO.Foreign)) : Unit do
    let s = seed()
    let empty = NativeArray.make_i32(32768, 0)
    let cells = if editing() do empty else fill(s, origin_x(), origin_y(), origin_z(), empty, 0) end
    sync_cells(cells)
    let chunk = C.from_flat(cells)
    let r = match B.register(B.empty(), B.with_faces(B.def(), 10, 11, 12)) do
      Ok((reg, _)) -> reg
      Err(_) -> B.empty()
    end
    let ids = NativeArray.make_int(39304, 0)
    let m = if padded(ids) do BrowserMesh.build_padded(r, chunk, ids)
      else BrowserMesh.build(r, BrowserMesh.around_from(fn (x, y, z) -> if x == 0 && y == 0 && z == 0 do chunk else C.uniform(0) end)) end
    publish(BrowserMesh.quads_at(m, 0), BrowserMesh.quad_count_at(m, 0), noise(s, -31.0, -15.0), noise(s, -3.0, 7.0), noise(s, 12.0, -8.0))
  end
end
