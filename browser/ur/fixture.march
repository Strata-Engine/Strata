mod Ur.BrowserFixture do
  alias Ur.Sim as S

  pfn preview_street(c : Ur.Sim.City, x : Int) : Ur.Sim.City do
    if x > 15 do c else
      let lot = S.index(x, 18)
      let c = S.act(c, lot, 1)
      preview_street(S.act(c, lot, 18), x + 1)
    end
  end

  pfn preview_building(c : Ur.Sim.City, x : Int, z : Int, zone : Int, floors : Int) : Ur.Sim.City do
    let lot = S.index(x, z)
    let c = S.act(c, lot, zone + 1)
    { c with buildings: NativeArray.set_int(c.buildings, lot, floors) }
  end

  fn city() : Ur.Sim.City do
    let c = preview_street(S.new(), 10)
    let c = preview_building(preview_building(c, 11, 19, 1, 2), 12, 19, 1, 2)
    let c = preview_building(preview_building(c, 14, 17, 2, 2), 15, 17, 2, 2)
    let c = S.build_grade(c, S.index(9, 18), S.index(9, 20), 50)
    { c with clock_ms: 675 }
  end
end
