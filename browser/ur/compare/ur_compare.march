mod UrCompare do
  needs IO
  needs IO.Foreign
  needs IO.Process
  needs Window
  alias Strata.Ffi.Vk as Vk
  alias Ur.Sim as S
  alias Ur.Scene as Scene

  fn draw(remaining : Int) : Unit do
    if remaining <= 0 do () else
      Vk.poll()
      if remaining == 1 do Vk.request_shot() else () end
      if Vk.frame() do () else Ur.AppError.stop("Comparison frame failed") end
      draw(remaining - 1)
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    if Vk.open(900, 660, false, 524288) do
      Vk.set_offscreen(true)
      Scene.setup()
      let city = Ur.BrowserFixture.city()
      let st = S.stats(city)
      let night = Authority.must(Env.get_int("UR_COMPARE_NIGHT", 0)) == 1
      let phase = if night do S.day_seconds() *. 20.0 /. 24.0 else int_to_float(city.clock_ms) /. 1000.0 end
      let hour = S.street_hour(phase)
      let weather = S.weather(city.month, city.calendar_day)
      let tick = S.signal_tick(0.0)
      Scene.sync(city, city, 0, true, false, hour, hour,
        { before: st.junctions, after: st.junctions, before_tick: tick, after_tick: tick },
        st.utilities.electric, st.utilities.electric)
      Scene.begin_vehicle_lights(hour)
      let _ = Scene.vehicles(city, city, st.running_transit, NativeArray.make_f32(S.count(), 0.0), 0.0, phase, 0.0, true, 0)
      let routes = Ur.Fleet.routes_with(city, st.running_transit, st.buses)
      let fleet = Ur.Fleet.step_at(city, st.traffic, Nil, routes, phase, 0.0, true, st.junctions, tick)
      Scene.fleet(city, fleet, Nil)
      Scene.food_vehicles(city, Ur.Food.producer_traffic(city, st), Nil, 0.0, 0)
      let citizens = Ur.Citizens.refresh_with(city, Nil, st.routes, st.people, st.job_matches)
      Scene.citizen_vehicles(city, citizens, Nil, hour >= 18 || hour < 6, 0)
      Scene.camera(94.0, 147.0, 38.0, 900.0 /. 660.0, 0.55)
      Scene.daylight(phase, weather)
      Scene.clouds(weather, (0.0, 0.0), 0)
      draw(64)
      Vk.close()
    else Ur.AppError.stop("Could not open the native comparison renderer") end
  end
end
