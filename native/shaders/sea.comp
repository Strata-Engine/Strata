// The sea's height tile: one invocation a cell of a 512 x 512 grid of 0.5 m
// cells (256 m square), the height of the sea state's nine waves there at
// this frame's time, for unit amplitude. sv_set_sea snaps each wave's
// wavevector to whole cycles across the tile, so it repeats without a seam;
// water.frag reads a column's height here instead of summing the waves in
// every pixel.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 45) writeonly buffer SeaTileOut { float h[]; } tile;

const int SEA_TILE = 512;
const float SEA_CELL = 0.5;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(SEA_TILE * SEA_TILE)) return;
    vec2 p = (vec2(float(i % uint(SEA_TILE)), float(i / uint(SEA_TILE))) + 0.5) * SEA_CELL;
    float t = u.light.y;
    float q = 1.0 + 1.5 * clamp(u.sea.w, 0.0, 1.0);
    float h = 0.0;
    // with a refracted swell (sv_set_sea_field) the three swell waves come from it in water.frag; the tile keeps the chop
    for (int k = u.sea_fgrid.x > 0.5 ? 3 : 0; k < 9; k++) {
        vec4 wv = u.sea_waves[k];
        float s = sin(dot(p, wv.xy) - wv.w * t + float(k) * 2.399);   // golden-angle phases, never in step
        h += u.sea_amps[k >> 2][k & 3] * (2.0 * pow(0.5 * s + 0.5, q) - 1.0);   // sharper crests, wider troughs
    }
    tile.h[i] = h;
}
