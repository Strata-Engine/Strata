-- What a physics step costs in the two cases a game met (Task 10): a pinned
-- fine tree cut through its trunk, and a slab of 1 m land left with nothing
-- under it. Built as a release program by `forge bench`. Prints each step's
-- milliseconds over 25 ms, then the worst, the total and how many bodies.
--   PHYS_CASE=1  the tree (default); 2 the slab; 3 eight trees planted at once
--   PHYS_STEPS=n steps after the cut or the edit (default 150)
mod PhysicsCost do
  needs IO
  needs IO.Clock
  needs IO.Process
  needs IO.Spawn
  alias Strata.World as Wc
  alias Strata.Edit as Ec
  alias Strata.Coord as Cc
  alias Strata.Chunk as Chc
  alias Strata.Blocks as Bc
  alias Strata.Body as Bg
  alias Strata.Physics as Ph
  alias Strata.Math.Quat as Qt

  pfn flat() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) -> if Cc.ky(k) < 0 do Chc.uniform(1) else Chc.uniform(0) end)
  end
  -- 1 stone, 2 wood, 3 leaves: PHYS_MAT=1 strong light wood and leaves; 0 (default) every block the
  -- default (2000 kg/m3, breaking past 50 000 N s/m2 into 50 cm pieces), as the viewer's are
  -- PHYS_MAT=2: the viewer's values, rock ground (2600 kg/m3, 2 000 000 N s/m2), wood (600, 400 000), leaves (60, 20 000);
  -- 3: the same with soil ground (1500, 300 000)
  pfn reg(mat : Int) : Strata.Blocks.Registry do
    let add = fn (r, d) -> match Bc.register(r, d) do
        Ok((r2, _)) -> r2
        Err(_) -> r
      end
    let wood = Bc.with_physics(Bc.def(), 600, 400000, 400, 50, false)
    let leaves = Bc.with_physics(Bc.def(), 60, 20000, 100, 50, false)
    if mat == 1 do add(add(add(Bc.empty(), Bc.def()), Bc.with_physics(Bc.def(), 700, 1000000, 400, 50, false)), Bc.with_physics(Bc.def(), 200, 1000000, 400, 50, false))
    else if mat == 2 do add(add(add(Bc.empty(), Bc.with_physics(Bc.def(), 2600, 2000000, 400, 50, false)), wood), leaves)
    else if mat == 3 do add(add(add(Bc.empty(), Bc.with_physics(Bc.def(), 1500, 300000, 200, 50, false)), wood), leaves)
    else add(add(add(Bc.empty(), Bc.def()), Bc.def()), Bc.def()) end end end
  end
  -- chunks x -2..1, y -1..2, z -2..1
  pfn load(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 64 do w
    else
      let k = Cc.key(i % 4 - 2, (i / 4) % 4 - 1, i / 16 - 2)
      load(Wc.insert(w, k, Strata.Terrain.run(Wc.terrain(w), k, Wc.seed(w))), i + 1)
    end
  end

  -- a 40 x 50 x 40 tree: a 6 x 30 x 6 trunk of wood, a ball of leaves round (20, 35, 20), radius squared rr
  pfn tree_go(g : Strata.Body.Grid, rr : Int, i : Int) : Strata.Body.Grid do
    if i >= 40 * 50 * 40 do g
    else
      let x = i % 40
      let y = (i / 40) % 50
      let z = i / 2000
      let trunk = x >= 17 && x <= 22 && z >= 17 && z <= 22 && y < 30
      let dx = x - 20
      let dy = y - 35
      let dz = z - 20
      let crown = dx * dx + dy * dy + dz * dz <= rr
      tree_go(if trunk do Bg.grid_set(g, x, y, z, 2) else if crown do Bg.grid_set(g, x, y, z, 3) else g end end, rr, i + 1)
    end
  end

  type Run = Run(Strata.Physics.Physics, Strata.World.World, Int, Int, Int)
  -- n steps; the worst step, the total (ms) and how many went over 25 ms
  pfn steps(p : Strata.Physics.Physics, w : Strata.World.World, n : Int, i : Int, worst : Int, total : Int, over : Int) : Run do
    if i >= n do Run(p, w, worst, total, over)
    else
      let t0 = System.monotonic_time()
      match Ph.step_world(p, w, Nil) do
        (p2, o) ->
          let ms = System.monotonic_time() - t0
          if ms > 25 do Authority.must(println("  step " ++ int_to_string(i) ++ ": " ++ int_to_string(ms) ++ " ms, " ++ int_to_string(Ph.count(p2)) ++ " bodies, " ++ int_to_string(Ph.awake_count(p2)) ++ " awake")) else () end
          steps(p2, Ec.world(o), n, i + 1, if ms > worst do ms else worst end, total + ms, if ms > 25 do over + 1 else over end)
      end
    end
  end
  -- air cells in the ground (y -3..-1) over x, z in x0..x0+39, z0..z0+39
  pfn holes(w : Strata.World.World, x0 : Int, y0 : Int, z0 : Int, i : Int, acc : Int) : Int do
    if i >= 40 * 3 * 40 do acc
    else holes(w, x0, y0, z0, i + 1, acc + (if Wc.get_block(w, x0 + i % 40, y0 + (i / 40) % 3, z0 + i / 120) == 0 do 1 else 0 end)) end
  end
  pfn plant(p : Strata.Physics.Physics, g : Strata.Body.Grid, i : Int) : Strata.Physics.Physics do
    if i >= 8 do p
    else match Ph.add_fine(p, g, 4, int_to_float(i % 4) *. 12.0 -. 20.0, 0.0, int_to_float(i / 4) *. 12.0 -. 20.0, Qt.identity(), Ph.pinned()) do (p2, _) -> plant(p2, g, i + 1) end end
  end
  -- the same step from the same state m times: the worst and the total
  pfn again(p : Strata.Physics.Physics, w : Strata.World.World, m : Int, worst : Int, total : Int) : Run do
    if m <= 0 do Run(p, w, worst, total, 0)
    else
      let t0 = System.monotonic_time()
      match Ph.step_world(p, w, Nil) do
        (p2, _) ->
          let ms = System.monotonic_time() - t0
          again(if Ph.count(p2) < 0 do p2 else p end, w, m - 1, if ms > worst do ms else worst end, total + ms)
      end
    end
  end
  pfn report(name : String, r : Run, n : Int) : Unit do
    match r do
      Run(p, _, worst, total, over) ->
        Authority.must(println(name ++ ": " ++ int_to_string(n) ++ " steps, worst " ++ int_to_string(worst) ++ " ms, total " ++ int_to_string(total) ++ " ms, " ++ int_to_string(over) ++ " over 25 ms; " ++ int_to_string(Ph.count(p)) ++ " bodies at the end"))
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let r = reg(Authority.must(Env.get_int("PHYS_MAT", 0)))
    -- PHYS_CROWN: the crown's radius in voxels (15 by default; at most 19)
    let cr = Authority.must(Env.get_int("PHYS_CROWN", 15))
    let w0 = load(Wc.new(r, flat(), 7, 1.0), 0)
    let n = Authority.must(Env.get_int("PHYS_STEPS", 150))
    if Authority.must(Env.get_int("PHYS_CASE", 1)) == 1 do
      match Ph.add_fine(Ph.new(r, Ph.config()), tree_go(Bg.grid(40, 50, 40), cr * cr, 0), 4, 0.0, 0.0, 0.0, Qt.identity(), Ph.pinned()) do
        (p0, _) ->
          let r0 = steps(p0, w0, 2, 0, 0, 0, 0)
          match r0 do
            Run(p1, w1, _, _, _) ->
              -- through the trunk at 1.5 m, from its middle (5 m, 5 m)
              let t0 = System.monotonic_time()
              let p2 = Ph.cut(p1, 5.0, 1.5, 5.0, 2.0)
              -- PHYS_AT=k PHYS_REPS=m: run k steps once, then step k again m times from there (to sample one step)
              let at = Authority.must(Env.get_int("PHYS_AT", -1))
              if at >= 0 do
                match steps(p2, w1, at, 0, 0, 0, 0) do
                  Run(pk, wk, _, _, _) -> report("step " ++ int_to_string(at) ++ " again", again(pk, wk, Authority.must(Env.get_int("PHYS_REPS", 20)), 0, 0), 1)
                end
              else
                let rr = steps(p2, w1, n, 0, 0, 0, 0)
                report("tree cut", rr, n)
                match rr do
                  Run(_, wn, _, _, _) -> Authority.must(println("  ground cells broken under it: " ++ int_to_string(holes(wn, -20, -3, -20, 0, 0))))
                end
                Authority.must(println("  (cut queued in " ++ int_to_string(System.monotonic_time() - t0) ++ " ms)"))
              end
          end
      end
    else if Authority.must(Env.get_int("PHYS_CASE", 1)) == 3 do
      -- eight pinned trees planted at once, 12 m apart (a round's grove), then stepped
      let t0 = System.monotonic_time()
      let p8 = plant(Ph.new(r, Ph.config()), tree_go(Bg.grid(40, 50, 40), cr * cr, 0), 0)
      Authority.must(println("  planted 8 in " ++ int_to_string(System.monotonic_time() - t0) ++ " ms"))
      let t1 = System.monotonic_time()
      let m = Ph.marks(p8)
      let t2 = System.monotonic_time()
      let fl = Strata.Fluid.new(r, Nil)
      let t3 = System.monotonic_time()
      match Strata.Fluid.set_marks(fl, w0, m) do
        (f2, _) ->
          let t4 = System.monotonic_time()
          match Strata.Fluid.set_marks(f2, w0, Ph.marks(p8)) do
            (_, _) -> Authority.must(println("  marks of eight trees " ++ int_to_string(t2 - t1) ++ " ms; set_marks first " ++ int_to_string(t4 - t3) ++ " ms, again (marks and set) " ++ int_to_string(System.monotonic_time() - t4) ++ " ms"))
          end
      end
      report("eight trees", steps(p8, w0, n, 0, 0, 0, 0), n)
    else
      -- a 31 x 3 x 31 slab at y 8..10 on a 1 x 8 x 1 column; the column taken away
      let built = Ec.world(Ec.fill_box(Ec.world(Ec.fill_box(w0, -15, 8, -15, 15, 10, 15, 1)), 0, 0, 0, 0, 7, 0, 1))
      let p0 = Ph.new(r, Ph.with_support(Ph.config(), true, -64))
      let o = Ec.fill_box(built, 0, 0, 0, 0, 7, 0, 0)
      report("slab collapse", steps(Ph.wake(p0, o), Ec.world(o), n, 0, 0, 0, 0), n)
    end end
  end
end
