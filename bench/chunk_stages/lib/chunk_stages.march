-- chunk_stages: one stage of an island surface chunk, repeated.
--
-- For each of the 200 surface chunks STRATA_CHUNK_TIMES uses (10 x 20 about
-- the origin, the chunk holding the ground), everything a stage needs is
-- prepared once and the stage is then run REPS times. A run with REPS=0 is
-- the preparation alone, so (REPS=10 run) - (REPS=0 run), over 2000, is the
-- stage's cost a chunk; run.sh takes the difference of CPU time and of
-- instructions retired, which a loaded machine does not disturb the way it
-- disturbs the wall clock.
--
-- The stages are the pieces of StrataViewer.island_full, called in its
-- order with its arguments. lib/strata_viewer.march here is a generated copy
-- of the viewer's (build.sh), with its private functions made public.
--
--   STAGE=n   which stage (see `stage` below)
--   REPS=n    how many times each chunk's stage is run (default 10)
mod ChunkStages do

  needs IO
  needs IO.Process
  needs IO.Spawn
  needs IO.FileSystem


  pfn rep(left : Int, f : Int -> Int, acc : Int) : Int do
    if left <= 0 do acc else rep(left - 1, f, acc + f(left)) end
  end

  pfn f32_at(a : NativeF32Arr, i : Int) : Int do float_to_int(NativeArray.get_f32(a, i)) end

  -- one chunk's stage, prepared once and run reps times; a checksum so nothing is dropped
  pfn stage(mode : Int, a : Strata.Atlas.Atlas, d : StrataViewer.Decor, scale : Float, cx : Int, cy : Int, cz : Int, seed : Int, reps : Int) : Int do
    let g = StrataViewer.decor_gp(d)
    let x0 = cx * 32
    let y0 = cy * 32
    let z0 = cz * 32
    let sv = StrataViewer.sea_v(g, scale)
    let x0m = int_to_float(x0) *. scale
    let y0m = int_to_float(y0) *. scale
    let z0m = int_to_float(z0) *. scale
    -- the population's pad and a metre's worth of columns for its slope: the area island_shared makes
    let pad = pop_pad(d, scale)
    let n = 32 + 2 * pad
    let hl = StrataViewer.halo(g)
    let side = n + 2 * hl
    let cnt = side * side
    let ax0 = x0 - pad
    let az0 = z0 - pad
    let ax0m = int_to_float(ax0) *. scale
    let az0m = int_to_float(az0) *. scale
    let hw = int_to_float(hl) *. scale
    let far = int_to_float(n - 1) *. scale
    if mode == 1 do rep(reps, fn _ -> Strata.Chunk.form(StrataViewer.island_full(a, d, scale, 0, cx, cy, cz, seed)), 0)
    else if mode == 20 do rep(reps, fn _ -> StrataViewer.island_early_of(g, a, scale, cx, cy + 7, cz), 0)
    else if mode == 21 do rep(reps, fn _ -> StrataViewer.island_early_of(g, a, scale, cx, cy - 7, cz), 0)
    -- 31: no timing: how many of the 17 chunks cy - 8 .. cy + 8 of this chunk column are generated in full
    else if mode == 31 do full_go(g, a, scale, cx, cy, cz, 0 - 8, 0)
    -- 33, 34: the chunks of this column that are generated in full among cy - 8 .. cy + 8, made one by one
    --         (Strata.Terrain.run) and in one call (Strata.Terrain.run_column, the island's column function)
    else if mode == 33 do
      let gen = StrataViewer.island_gen(a, d, scale)
      let ks = full_keys(g, a, scale, cx, cy, cz, 8, Nil)
      rep(reps, fn _ -> List.fold_left(ks, 0, fn (n, k) -> n + Strata.Chunk.form(Strata.Terrain.run(gen, k, seed))), 0)
    else if mode == 34 do
      let gen = StrataViewer.island_gen(a, d, scale)
      let ks = full_keys(g, a, scale, cx, cy, cz, 8, Nil)
      rep(reps, fn _ -> List.fold_left(Strata.Terrain.run_column(gen, ks, seed), 0, fn (n, c) -> n + Strata.Chunk.form(c)), 0)
    -- 35: the same chunks as 34, two keys a call (Strata.Terrain.run_column over pairs, bottom up), as the stream
    --     makes them at STRATA_BATCH 2
    else if mode == 35 do
      let gen = StrataViewer.island_gen(a, d, scale)
      let ps = pairs(full_keys(g, a, scale, cx, cy, cz, 8, Nil), Nil)
      rep(reps, fn _ -> List.fold_left(ps, 0, fn (n, ks) -> List.fold_left(Strata.Terrain.run_column(gen, ks, seed), n, fn (m, c) -> m + Strata.Chunk.form(c))), 0)
    else if mode == 22 do rep(reps, fn _ -> match StrataViewer.area_n(g, a, scale, x0, z0, 32, seed) do StrataViewer.Area(hs, _, _, _, _) -> f32_at(hs, 0) end, 0)
    else if mode == 23 do
      let bare = StrataViewer.bare_decor_of(g, a)
      rep(reps, fn _ -> Strata.Chunk.form(StrataViewer.island_full(a, bare, scale, 0, cx, cy, cz, seed)), 0)
    else if mode == 2 do rep(reps, fn _ -> match StrataViewer.island_window(a, ax0m -. hw, az0m -. hw, ax0m +. far +. hw, az0m +. far +. hw) do StrataViewer.Win(_, _, sd, _, _, _, _, _, _, _) -> sd end, 0)
    else if mode == 6 do rep(reps, fn _ -> match StrataViewer.area_lv(g, a, scale, scale, ax0, az0, n, seed, StrataViewer.decor_ground(d)) do StrataViewer.Area(hs, _, _, _, _) -> f32_at(hs, 0) end, 0)
    else
      let wn = StrataViewer.island_window(a, ax0m -. hw, az0m -. hw, ax0m +. far +. hw, az0m +. far +. hw)
      -- 26, 27, 28: the columns with the window's river list emptied, its lake flag cleared, or both
      --             (what river_damp and the lake-rim search cost; the columns made are then not the island's)
      -- 30: no timing: the river samples in the window and whether it holds a lake
      if mode == 30 do match wn do StrataViewer.Win(_, _, _, _, _, _, _, _, rs, wet) -> List.length(rs) * 1000 + (if wet do 1 else 0 end) end
      else if mode >= 26 && mode <= 28 do
        let wn2 = match wn do StrataViewer.Win(i0, j0, sd, st, nn, hs, ls, ws, rs, wet) -> StrataViewer.Win(i0, j0, sd, st, nn, hs, ls, ws, if mode == 27 do rs else Nil end, if mode == 26 do wet else false end) end
        rep(reps, fn _ -> match StrataViewer.cols3_go(g, hl, wn2, ax0, az0, n, seed, scale, scale, 0, NativeArray.make_f32(cnt, 0.0), NativeArray.make_f32(cnt, 0.0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0)) do StrataViewer.Cols3(hm, _, _, _, _) -> f32_at(hm, 0) end, 0)
      else if mode == 3 do rep(reps, fn _ -> match StrataViewer.cols3_go(g, hl, wn, ax0, az0, n, seed, scale, scale, 0, NativeArray.make_f32(cnt, 0.0), NativeArray.make_f32(cnt, 0.0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0)) do StrataViewer.Cols3(hm, _, _, _, _) -> f32_at(hm, 0) end, 0)
      else if mode == 4 do rep(reps, fn _ ->
          let tal = NativeArray.make_f32(cnt, 0.0)
          let tal2 = if Strata.Noise.field2(StrataViewer.rock_s(), Strata.Seed.mix(seed, 10), StrataViewer.p_rock_freq(g), ax0m -. hw, az0m -. hw, scale, side, side, tal) == cnt do StrataViewer.talus_go(tal, StrataViewer.p_talus_mid(g), StrataViewer.p_talus_spread(g), 0, cnt) else tal end
          f32_at(tal2, 0), 0)
      else
        match StrataViewer.cols3_go(g, hl, wn, ax0, az0, n, seed, scale, scale, 0, NativeArray.make_f32(cnt, 0.0), NativeArray.make_f32(cnt, 0.0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0), NativeArray.make_int(n * n, 0)) do
          StrataViewer.Cols3(hm, _, _, _, _) ->
            let tal = NativeArray.make_f32(cnt, 0.0)
            let tal2 = if Strata.Noise.field2(StrataViewer.rock_s(), Strata.Seed.mix(seed, 10), StrataViewer.p_rock_freq(g), ax0m -. hw, az0m -. hw, scale, side, side, tal) == cnt do StrataViewer.talus_go(tal, StrataViewer.p_talus_mid(g), StrataViewer.p_talus_spread(g), 0, cnt) else tal end
            if mode == 5 do rep(reps, fn _ -> f32_at(Strata.Thermal.relax(hm, side, scale, tal2, StrataViewer.p_passes(g)), 0), 0)
            else after_area(mode, a, d, scale, cx, cy, cz, seed, reps) end
        end
      end end end end
    end end end end end end end end end end end
  end

  -- keys two by two, in order (the last alone when they are odd)
  pfn pairs(ks : List(Strata.Coord.Key), acc : List(List(Strata.Coord.Key))) : List(List(Strata.Coord.Key)) do
    match ks do
      Nil -> List.reverse(acc)
      Cons(k1, rest) ->
        match rest do
          Nil -> List.reverse(Cons(Cons(k1, Nil), acc))
          Cons(k2, rest2) -> pairs(rest2, Cons(Cons(k1, Cons(k2, Nil)), acc))
        end
    end
  end
  pfn full_keys(g : StrataViewer.Gp, a : Strata.Atlas.Atlas, scale : Float, cx : Int, cy : Int, cz : Int, dy : Int, acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    if dy < 0 - 8 do acc
    else full_keys(g, a, scale, cx, cy, cz, dy - 1, if StrataViewer.island_early_of(g, a, scale, cx, cy + dy, cz) < 0 do Cons(Strata.Coord.key(cx, cy + dy, cz), acc) else acc end) end
  end
  pfn full_go(g : StrataViewer.Gp, a : Strata.Atlas.Atlas, scale : Float, cx : Int, cy : Int, cz : Int, dy : Int, acc : Int) : Int do
    if dy > 8 do acc else full_go(g, a, scale, cx, cy, cz, dy + 1, if StrataViewer.island_early_of(g, a, scale, cx, cy + dy, cz) < 0 do acc + 1 else acc end) end
  end

  -- the area island_shared makes for the population: its pad and a metre's worth of columns each side for the slope
  pfn pop_pad(d : StrataViewer.Decor, scale : Float) : Int do
    match StrataViewer.decor_pop(d) do
      Some(StrataViewer.DecorPop(f, p)) -> Strata.Populate.plan_pad(p, scale) + StrataViewer.ring_cols(f, Strata.Populate.plan_pad(p, scale), scale)
      None -> 0
    end
  end

  pfn ring_of(d : StrataViewer.Decor, scale : Float) : Int do
    match StrataViewer.decor_pop(d) do
      Some(StrataViewer.DecorPop(f, p)) -> StrataViewer.ring_cols(f, Strata.Populate.plan_pad(p, scale), scale)
      None -> 0
    end
  end

  -- the stages after the area: island_full's body from island_shared on
  pfn after_area(mode : Int, a : Strata.Atlas.Atlas, d : StrataViewer.Decor, scale : Float, cx : Int, cy : Int, cz : Int, seed : Int, reps : Int) : Int do
    let g = StrataViewer.decor_gp(d)
    let x0 = cx * 32
    let y0 = cy * 32
    let z0 = cz * 32
    let sv = StrataViewer.sea_v(g, scale)
    let x0m = int_to_float(x0) *. scale
    let y0m = int_to_float(y0) *. scale
    let z0m = int_to_float(z0) *. scale
    if mode == 7 do rep(reps, fn _ -> match StrataViewer.island_shared(a, d, scale, 0, cx, cz, seed) do StrataViewer.IslandCol(hs, _, _, _, _, _, _, _) -> f32_at(hs, 0) end, 0)
    else if mode == 19 do
      let bare = StrataViewer.bare_decor_of(g, a)
      rep(reps, fn _ -> match StrataViewer.island_shared(a, bare, scale, 0, cx, cz, seed) do StrataViewer.IslandCol(hs, _, _, _, _, _, _, _) -> f32_at(hs, 0) end, 0)
    else
      match StrataViewer.island_shared(a, d, scale, 0, cx, cz, seed) do
        StrataViewer.IslandCol(hs, cms, gs, ls, rs, ens, fs, ip) ->
          if mode == 17 do
            let m = pop_pad(d, scale)
            let k = ring_of(d, scale)
            let na = 32 + 2 * m
            match (StrataViewer.decor_pop(d), StrataViewer.area_lv(g, a, scale, scale, x0 - m, z0 - m, na, seed, StrataViewer.decor_ground(d))) do
              (Some(StrataViewer.DecorPop(f, p)), StrataViewer.Area(hp, cp, _, lp, rp)) ->
                rep(reps, fn _ -> match StrataViewer.pop_ground(a, g, f, p, hp, cp, lp, rp, ens, na, k, x0 - m + k, z0 - m + k, scale, 0, scale, seed, false) do StrataViewer.IslandPop(_, _, pd) -> pd end, 0)
              _ -> 0
            end
          else if mode == 8 do rep(reps, fn _ ->
              let ens0 = NativeArray.make_f32(1024, 0.0)
              let e = Strata.Noise.field2(StrataViewer.single_s(), Strata.Seed.mix(seed, 9), StrataViewer.p_entrance_freq(g), x0m, z0m, scale, 32, 32, ens0)
              let ns = StrataViewer.dens_field(g, seed, x0m, y0m, z0m, scale)
              let ta = StrataViewer.lattice_field(StrataViewer.tunnel_s(), Strata.Seed.mix(seed, 6), StrataViewer.p_tunnel_freq(g), x0m, y0m, z0m, scale)
              let tb = StrataViewer.lattice_field(StrataViewer.tunnel_s(), Strata.Seed.mix(seed, 7), StrataViewer.p_tunnel_freq(g), x0m, y0m, z0m, scale)
              let cav = StrataViewer.lattice_field(StrataViewer.single_s(), Strata.Seed.mix(seed, 8), StrataViewer.p_cavern_freq(g), x0m, y0m, z0m, scale)
              e + f32_at(ens0, 0) + f32_at(ns, 0) + f32_at(ta, 0) + f32_at(tb, 0) + f32_at(cav, 0), 0)
          else
            let ns = StrataViewer.dens_field(g, seed, x0m, y0m, z0m, scale)
            let ta = StrataViewer.lattice_field(StrataViewer.tunnel_s(), Strata.Seed.mix(seed, 6), StrataViewer.p_tunnel_freq(g), x0m, y0m, z0m, scale)
            let tb = StrataViewer.lattice_field(StrataViewer.tunnel_s(), Strata.Seed.mix(seed, 7), StrataViewer.p_tunnel_freq(g), x0m, y0m, z0m, scale)
            let cav = StrataViewer.lattice_field(StrataViewer.single_s(), Strata.Seed.mix(seed, 8), StrataViewer.p_cavern_freq(g), x0m, y0m, z0m, scale)
            if mode == 9 do rep(reps, fn _ -> f32_at(StrataViewer.factor_cols(StrataViewer.factors_go(a, g, x0m, z0m, scale, NativeArray.make_f32(81, 0.0), 0), NativeArray.make_f32(1024, 0.0), 0), 0), 0)
            else if mode == 10 do rep(reps, fn _ -> f32_at(StrataViewer.lattice_fill(ns), 0) + f32_at(StrataViewer.lattice_fill(ta), 0) + f32_at(StrataViewer.lattice_fill(tb), 0) + f32_at(StrataViewer.lattice_fill(cav), 0), 0)
            else
              let seam = StrataViewer.p_sea(g) +. 1.0
              let cv = StrataViewer.cave_vals(g)
              let sand = StrataViewer.p_sand_below(g)
              let snow = StrataViewer.p_snow_above(g)
              let fl = StrataViewer.Fields(hs, cms, ens, fs, StrataViewer.lattice_fill(ns), StrataViewer.lattice_fill(ta), StrataViewer.lattice_fill(tb), StrataViewer.lattice_fill(cav))
              if mode == 11 do rep(reps, fn _ -> f32_at(StrataViewer.dens_go(cv, fl, NativeArray.make_f32(32768, 0.0), y0m, scale, seam), 0), 0)
              else
                let dens0 = StrataViewer.dens_go(cv, fl, NativeArray.make_f32(32768, 0.0), y0m, scale, seam)
                if mode == 12 do rep(reps, fn _ -> f32_at(if StrataViewer.any_cut(dens0, 0) do StrataViewer.drop_islands(dens0) else dens0 end, 0), 0)
                else if mode == 24 do rep(reps, fn _ -> if StrataViewer.any_cut(dens0, 0) do 1 else 0 end, 0)
                else
                  let dens = if StrataViewer.any_cut(dens0, 0) do StrataViewer.drop_islands(dens0) else dens0 end
                  if mode == 13 do rep(reps, fn _ -> f32_at(StrataViewer.above_go(cv, hs, cms, ens, fs, ns, ta, tb, cav, NativeArray.make_f32(1024, 0.0), y0m +. 32.0 *. scale, seam, 0), 0), 0)
                  else
                    let above = StrataViewer.above_go(cv, hs, cms, ens, fs, ns, ta, tb, cav, NativeArray.make_f32(1024, 0.0), y0m +. 32.0 *. scale, seam, 0)
                    let scan = fn _ -> Strata.Surface.scan_wet(dens, above, NativeArray.make_int(1024, sv - y0), fn (depth, yl, wet) -> StrataViewer.material(sand, snow, depth, y0 + yl, sv, scale, wet, 3))
                    if mode == 14 do rep(reps, fn _ -> NativeArray.get_i32(scan(0), 0), 0)
                    else if mode == 15 do rep(reps, fn _ -> match StrataViewer.finish_go(true, true, scan(0), gs, ls, rs, y0, sv, scale, NativeArray.make_int(1024, 0), NativeArray.make_int(16384, 0), 32767) do (m, _, _) -> NativeArray.get_i32(m, 0) end, 0)
                    else
                      match StrataViewer.finish_go(true, true, scan(0), gs, ls, rs, y0, sv, scale, NativeArray.make_int(1024, 0), NativeArray.make_int(16384, 0), 32767) do
                        (mats, cnt, buf) ->
                          if mode == 16 do rep(reps, fn _ -> Strata.Chunk.form(Strata.Chunk.from_flat(mats)), 0)
                          else
                            let land = Strata.Chunk.from_flat(mats)
                            match (ip, StrataViewer.decor_pop(d)) do
                              (Some(StrataViewer.IslandPop(gr, t, pad)), Some(StrataViewer.DecorPop(_, p))) ->
                                if mode == 18 do rep(reps, fn _ -> Strata.Chunk.form(Strata.Populate.place_with(p, seed, Strata.Coord.key(cx, cy, cz), land, StrataViewer.with_floors(gr, cnt, buf, pad), t)), 0)
                                else if mode == 25 do rep(reps, fn _ -> Strata.Chunk.form(Strata.Populate.place_with(p, seed, Strata.Coord.key(cx, cy, cz), land, gr, t)), 0)
                                else 0 end end
                              _ -> 0
                            end
                          end
                      end
                    end end
                  end
                end end
              end
            end end
          end end
      end
    end end
  end

  pfn keys_go(mode : Int, a : Strata.Atlas.Atlas, d : StrataViewer.Decor, scale : Float, seed : Int, reps : Int, k : Int, acc : Int) : Int do
    if k >= 200 do acc
    else
      let key = StrataViewer.surface_key(StrataViewer.Island(a), seed, scale, k, 0)
      keys_go(mode, a, d, scale, seed, reps, k + 1, acc + stage(mode, a, d, scale, Strata.Coord.kx(key), Strata.Coord.ky(key), Strata.Coord.kz(key), seed, reps))
    end
  end

  -- ── Stage 32: how many keys of a column would start together ────────────
  -- With batching, when the first key of a chunk column starts, every other
  -- key of that column that is wanted and not loaded goes with it. So a
  -- batch is the keys of a column that become wanted at once: a whole
  -- column of the box (2 radius_v + 1 keys) at start-up and for a column
  -- entering the box in level flight; one key a column when the focus
  -- climbs a chunk. This counts, per column, how many of those keys are
  -- generated in full (not early-outs, not open sea).
  pfn fdiv32(v : Int, side : Int) : Int do if v >= 0 do v / side else 0 - ((side - 1 - v) / side) end end
  pfn full_key(g : StrataViewer.Gp, a : Strata.Atlas.Atlas, scale : Float, lvl : Int, cx : Int, cy : Int, cz : Int) : Bool do
    let sc = scale *. StrataViewer.pow2f(lvl)
    if StrataViewer.beyond(g, a, sc, cx, cz) do false
    else StrataViewer.island_early_lift(g, a, sc, if lvl == 0 do 0.0 else StrataViewer.level_lift(sc) end, cx, cy, cz) < 0 end
  end
  pfn col_full(g : StrataViewer.Gp, a : Strata.Atlas.Atlas, scale : Float, lvl : Int, cx : Int, cz : Int, cy : Int, cy1 : Int, acc : Int) : Int do
    if cy > cy1 do acc else col_full(g, a, scale, lvl, cx, cz, cy + 1, cy1, if full_key(g, a, scale, lvl, cx, cy, cz) do acc + 1 else acc end) end
  end
  -- the columns x0..x1, z0..z1 of level lvl, keys cyf - rv .. cyf + rv: hist[n] counts the columns with n full keys
  pfn hist_go(g : StrataViewer.Gp, a : Strata.Atlas.Atlas, scale : Float, lvl : Int, x0 : Int, x1 : Int, z0 : Int, z1 : Int, cyf : Int, rv : Int, x : Int, z : Int, h : NativeIntArr) : NativeIntArr do
    if z > z1 do h
    else if x > x1 do hist_go(g, a, scale, lvl, x0, x1, z0, z1, cyf, rv, x0, z + 1, h)
    else
      let n = col_full(g, a, scale, lvl, x, z, cyf - rv, cyf + rv, 0)
      hist_go(g, a, scale, lvl, x0, x1, z0, z1, cyf, rv, x + 1, z, NativeArray.set_int(h, n, NativeArray.get_int(h, n) + 1))
    end end
  end
  pfn hist_line(name : String, h : NativeIntArr, keys : Int) : String do
    let cols = hist_sum(h, 0, 0, false)
    let full = hist_sum(h, 0, 0, true)
    let with_full = cols - NativeArray.get_int(h, 0)
    name ++ ": " ++ int_to_string(cols) ++ " columns of " ++ int_to_string(keys) ++ " keys; full keys a column 0.." ++ int_to_string(keys) ++ ":" ++ hist_text(h, 0, keys) ++ "; " ++ int_to_string(full) ++ " full keys in " ++ int_to_string(with_full) ++ " columns that hold any"
  end
  pfn hist_sum(h : NativeIntArr, i : Int, acc : Int, weighted : Bool) : Int do
    if i >= NativeArray.length_int(h) do acc else hist_sum(h, i + 1, acc + NativeArray.get_int(h, i) * (if weighted do i else 1 end), weighted) end
  end
  pfn hist_text(h : NativeIntArr, i : Int, keys : Int) : String do hist_acc(h, i, keys, "") end
  pfn hist_acc(h : NativeIntArr, i : Int, keys : Int, acc : String) : String do
    if i > keys do acc else hist_acc(h, i + 1, keys, acc ++ " " ++ int_to_string(NativeArray.get_int(h, i))) end
  end
  -- the viewer's boxes about its overview pose (-70, ground + 46, 96): level 0 radius 10 x 3, levels 1..4 radius 10 x 1
  pfn batches(g : StrataViewer.Gp, a : Strata.Atlas.Atlas, scale : Float, seed : Int, lvl : Int) : Unit do
    let side = 32 * float_to_int(StrataViewer.pow2f(lvl))
    let fy = StrataViewer.land_height(StrataViewer.Island(a), 0, 0, seed) + 46
    let cxf = fdiv32(0 - 70, side)
    let cyf = fdiv32(fy, side)
    let czf = fdiv32(96, side)
    let rv = if lvl == 0 do 3 else 1 end
    let keys = 2 * rv + 1
    let start = hist_go(g, a, scale, lvl, cxf - 10, cxf + 10, czf - 10, czf + 10, cyf, rv, cxf - 10, czf - 10, NativeArray.make_int(keys + 1, 0))
    Authority.must(println(hist_line("level " ++ int_to_string(lvl) ++ " start-up", start, keys)))
    -- level flight: 13 chunks along +x, the columns that enter the box
    let flight = hist_go(g, a, scale, lvl, cxf + 11, cxf + 23, czf - 10, czf + 10, cyf, rv, cxf + 11, czf - 10, NativeArray.make_int(keys + 1, 0))
    Authority.must(println(hist_line("level " ++ int_to_string(lvl) ++ " flight +x 13 chunks", flight, keys)))
    -- a climb of one chunk: each column gets one new key, the layer cyf + rv + 1
    let climb = hist_go(g, a, scale, lvl, cxf - 10, cxf + 10, czf - 10, czf + 10, cyf + rv + 1, 0, cxf - 10, czf - 10, NativeArray.make_int(2, 0))
    Authority.must(println(hist_line("level " ++ int_to_string(lvl) ++ " climb one chunk", climb, 1)))
  end
  pfn batches_all(g : StrataViewer.Gp, a : Strata.Atlas.Atlas, scale : Float, seed : Int, lvl : Int) : Unit do
    if lvl > 4 do ()
    else
      batches(g, a, scale, seed, lvl)
      batches_all(g, a, scale, seed, lvl + 1)
    end
  end

  -- start-up, repeated reps times (run the binary directly; a REPS=0 run is the preparation):
  -- 36 the population alone (island.pop substituted, read, frozen, fitted, planned: pop_of),
  -- 37 the whole Decor (the 12 tree templates built, the ruins read and fitted, then 36),
  -- 38 the 12 tree templates alone, 39 the {name}s of island.pop worked out and substituted alone
  pfn startup(mode : Int, g : StrataViewer.Gp, a : Strata.Atlas.Atlas, d : StrataViewer.Decor, scale : Float, seed : Int, text : String, reps : Int) : Int do
    if mode == 36 do
      rep(reps, fn _ -> match StrataViewer.pop_of(g, a, StrataViewer.decor_trees(d), StrataViewer.decor_ruins(d), scale, text) do
          Ok(_) -> 1
          Err(_) -> 0
        end, 0)
    else if mode == 37 do
      rep(reps, fn _ -> List.length(StrataViewer.decor_trees(StrataViewer.decor_of(StrataViewer.decor_gp(d), a, scale, seed))), 0)
    else if mode == 38 do
      rep(reps, fn _ -> List.length(StrataViewer.trees_go(scale, seed, 11, Nil)), 0)
    else
      rep(reps, fn _ -> String.byte_size(StrataViewer.substitute(text, StrataViewer.pop_tokens(g, a))), 0)
    end end end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let mode = Authority.must(Env.get_int("STAGE", 1))
    let reps = Authority.must(Env.get_int("REPS", 10))
    let seed = 7
    -- QUARTER=1: a world of 0.25 m a voxel (start-up stages only; the chunk stages are posed at 1 m)
    let scale = if Authority.must(Env.get_int("QUARTER", 0)) == 1 do 0.25 else 1.0 end
    let g = StrataViewer.gp_of(StrataViewer.load_params(StrataViewer.params_path()))
    let a = StrataViewer.load_atlas(g, seed)
    let d = StrataViewer.decor_of(g, a, scale, seed)
    if mode >= 36 do
      let text = match Authority.must(File.read(StrataViewer.pop_path())) do
          Ok(t) -> t
          Err(_) -> ""
        end
      let n = startup(mode, g, a, d, scale, seed, text, reps)
      Authority.must(println("chunk_stages: start-up stage " ++ int_to_string(mode) ++ " reps " ++ int_to_string(reps) ++ " scale " ++ float_to_string(scale) ++ " checksum " ++ int_to_string(n)))
    else
      let pad = pop_pad(d, scale)
      Authority.must(println("chunk_stages: stage " ++ int_to_string(mode) ++ " reps " ++ int_to_string(reps) ++ "; pad " ++ int_to_string(pad) ++ ", halo " ++ int_to_string(StrataViewer.halo(g)) ++ ", patch side " ++ int_to_string(32 + 2 * pad + 2 * StrataViewer.halo(g))))
      let sum = if mode == 32 do 0 else keys_go(mode, a, d, scale, seed, reps, 0, 0) end
      if mode == 32 do batches_all(g, a, scale, seed, 0) else () end
      if mode == 30 do Authority.must(println("chunk_stages: over 200 chunks, river samples in the window " ++ int_to_string(sum / 1000) ++ " in all; windows holding a lake sample " ++ int_to_string(sum % 1000)))
      else if mode == 31 do Authority.must(println("chunk_stages: over 200 chunk columns, " ++ int_to_string(sum) ++ " chunks are generated in full (not early-outs)"))
      else Authority.must(println("chunk_stages: checksum " ++ int_to_string(sum))) end end
    end
  end
end
