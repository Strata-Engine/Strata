-- A list captured by a task and still used by the thread that spawned it.
-- VARIANT 0: the spawner starts a task that walks the list, then walks the
--            list itself (List.length) while the task runs.
-- VARIANT 1: the spawner takes the length first and hands the list to the
--            task as its last use.
-- Each rep builds a list of 64 tuples holding a small list each, spawns 8
-- tasks over 8 such lists, and awaits them. The program prints a sum; with
-- VARIANT 0 it can die with a segmentation fault or a bus error instead.
mod TaskSharedList do
  needs IO
  needs IO.Spawn

  pfn build(n : Int, acc : List((Int, Int, List(Int)))) : List((Int, Int, List(Int))) do
    if n <= 0 do acc else build(n - 1, Cons((n, n * 3, Cons(n, Cons(n + 1, Nil))), acc)) end
  end

  pfn walk(items : List((Int, Int, List(Int))), acc : Int) : Int do
    match items do
      Nil -> acc
      Cons((a, b, l), t) -> walk(t, acc + a + b + List.length(l))
    end
  end

  pfn start(variant : Int, left : Int, acc : List((Int, Task(Int)))) : List((Int, Task(Int))) do
    if left <= 0 do acc
    else
      let items = build(64, Nil)
      if variant == 0 do
        let t = Authority.must(Task.async(fn () -> walk(items, 0)))
        start(variant, left - 1, Cons((List.length(items), t), acc))
      else
        let n = List.length(items)
        let t = Authority.must(Task.async(fn () -> walk(items, 0)))
        start(variant, left - 1, Cons((n, t), acc))
      end
    end
  end

  pfn collect(ts : List((Int, Task(Int))), acc : Int) : Int do
    match ts do
      Nil -> acc
      Cons((n, t), rest) -> collect(rest, acc + n + Result.unwrap_or(task_await(t), 0))
    end
  end

  pfn rep(variant : Int, left : Int, acc : Int) : Int do
    if left <= 0 do acc else rep(variant, left - 1, int_and(acc + collect(start(variant, 8, Nil), 0), 1048575)) end
  end

  fn main(_cap : Cap(IO)) : Unit do
    Authority.must(println(int_to_string(rep(Authority.must(Env.get_int("VARIANT", 0)), Authority.must(Env.get_int("REPS", 1)), 0))))
  end
end
