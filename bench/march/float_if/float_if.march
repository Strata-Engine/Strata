-- An `if` (or `match`) whose value is a Float, in a hot loop.
-- VARIANT 0: the largest clamped step down a row, with `if` for the clamp and the max.
-- VARIANT 1: the same numbers with no Float-valued `if`: the clamp and the max by arithmetic.
mod FloatIf do
  needs IO

  pfn fill(h : NativeF32Arr, k : Int, n : Int) : NativeF32Arr do
    if k >= n do h else fill(NativeArray.set_f32(h, k, int_to_float((k * 7) % 17) *. 0.5), k + 1, n) end
  end

  pfn with_if(h : NativeF32Arr, k : Int, n : Int, acc : Float) : Float do
    if k >= n - 1 do acc
    else
      let e = NativeArray.get_f32(h, k) -. NativeArray.get_f32(h, k + 1) -. 0.25
      let c = if e > 0.0 do e else 0.0 end
      with_if(h, k + 1, n, if acc > c do acc else c end)
    end
  end

  pfn no_if(h : NativeF32Arr, k : Int, n : Int, acc : Float) : Float do
    if k >= n - 1 do acc
    else
      let e = NativeArray.get_f32(h, k) -. NativeArray.get_f32(h, k + 1) -. 0.25
      let c = 0.5 *. (e +. Math.abs(e))
      no_if(h, k + 1, n, 0.5 *. (acc +. c +. Math.abs(acc -. c)))
    end
  end

  pfn rep(h : NativeF32Arr, variant : Int, left : Int, acc : Float) : Float do
    if left <= 0 do acc
    else if variant == 0 do rep(h, variant, left - 1, acc +. with_if(h, 0, 4096, 0.0))
    else rep(h, variant, left - 1, acc +. no_if(h, 0, 4096, 0.0)) end end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let h = fill(NativeArray.make_f32(4096, 0.0), 0, 4096)
    Authority.must(println(float_to_string(rep(h, Authority.must(Env.get_int("VARIANT", 0)), Authority.must(Env.get_int("REPS", 1)), 0.0))))
  end
end
