-- A callee filling an array its caller made (GAPS S18).
-- VARIANT 0: fill_into(out) returns a count; the caller then reads out.
-- VARIANT 1: fill(out) returns the array; the caller reads what came back.
-- Each rep prints nothing; the last line printed is the sum of out[100] over
-- the reps: 100 a rep when the fill reached the caller's array, 0 when not.
mod CalleeFill do
  needs IO

  pfn fill_into(out : NativeF32Arr, i : Int) : Int do
    if i >= 32768 do i else fill_into(NativeArray.set_f32(out, i, int_to_float(i)), i + 1) end
  end

  pfn fill(out : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= 32768 do out else fill(NativeArray.set_f32(out, i, int_to_float(i)), i + 1) end
  end

  pfn rep(variant : Int, left : Int, acc : Float) : Float do
    if left <= 0 do acc
    else
      let out = NativeArray.make_f32(32768, 0.0)
      if variant == 0 do
        let n = fill_into(out, 0)
        rep(variant, left - 1, acc +. NativeArray.get_f32(out, 100) +. int_to_float(n - 32768))
      else
        rep(variant, left - 1, acc +. NativeArray.get_f32(fill(out, 0), 100))
      end
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    println(float_to_string(rep(Env.get_int("VARIANT", 0), Env.get_int("REPS", 1), 0.0)))
  end
end
