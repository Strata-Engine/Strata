-- The accessor bench with the template type, t_sx and the loop in AccLib
-- (acc_lib.march, found on MARCH_LIB_PATH), as stamp_two.march has them.
-- VARIANT as in AccLib.spin; REPS turns of the loop.
mod AccTwo do
  needs IO

  fn main(_cap : Cap(IO)) : Unit do
    let t = AccLib.Stamp(9, 12, 9, NativeArray.make_i32(972, 0), NativeArray.make_u8(972, 255), NativeArray.make_u8(12, 255), 1.0)
    let r = AccLib.spin(t, Authority.must(Env.get_int("VARIANT", 0)), 0, Authority.must(Env.get_int("REPS", 1)), 1)
    Authority.must(println(int_to_string(r)))
  end
end
