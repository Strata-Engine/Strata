-- stamp_loop.march's template and loop as a module of their own, for
-- stamp_two.march: the same code, reached across a module boundary as
-- Strata.Template.blit is from Strata.Populate.
mod StampLib do
  type Stamp = Stamp(Int, Int, Int, NativeI32Arr, NativeU8Arr, NativeU8Arr, Float)

  fn t_sx(t : Stamp) : Int do match t do Stamp(v, _, _, _, _, _, _) -> v end end
  fn t_sy(t : Stamp) : Int do match t do Stamp(_, v, _, _, _, _, _) -> v end end
  fn t_sz(t : Stamp) : Int do match t do Stamp(_, _, v, _, _, _, _) -> v end end
  fn t_ids(t : Stamp) : NativeI32Arr do match t do Stamp(_, _, _, v, _, _, _) -> v end end

  fn quarter(rot : Int) : Int do int_and(rot, 3) end

  fn unturn(t : Stamp, rot : Int, rx : Int, rz : Int) : (Int, Int) do
    let r = quarter(rot)
    if r == 0 do (rx, rz)
    else if r == 1 do (rz, t_sz(t) - 1 - rx)
    else if r == 2 do (t_sx(t) - 1 - rx, t_sz(t) - 1 - rz)
    else (t_sx(t) - 1 - rz, rx) end end end
  end
  fn unturn_x(t : Stamp, rot : Int, rx : Int, rz : Int) : Int do
    let r = quarter(rot)
    if r == 0 do rx else if r == 1 do rz else if r == 2 do t_sx(t) - 1 - rx else t_sx(t) - 1 - rz end end end
  end
  fn unturn_z(t : Stamp, rot : Int, rx : Int, rz : Int) : Int do
    let r = quarter(rot)
    if r == 0 do rz else if r == 1 do t_sz(t) - 1 - rx else if r == 2 do t_sz(t) - 1 - rz else rx end end end
  end

  fn drawn(t : Stamp, x : Int, y : Int, z : Int) : Int do NativeArray.get_i32(t_ids(t), x + t_sx(t) * (y + t_sy(t) * z)) end

  fn blit_x(c : NativeI32Arr, t : Stamp, ox : Int, oy : Int, oz : Int, rot : Int, split : Int, base_x : Int, base_y : Int, base_z : Int, x : Int, x1 : Int, y : Int, z : Int) : NativeI32Arr do
    if x > x1 do c
    else
      let id = if split == 0 do
        let (tx, tz) = unturn(t, rot, x - ox, z - oz)
        drawn(t, tx, y - oy, tz)
      else drawn(t, unturn_x(t, rot, x - ox, z - oz), y - oy, unturn_z(t, rot, x - ox, z - oz)) end
      let i = (x - base_x) + 32 * ((z - base_z) + 32 * (y - base_y))
      let c2 = if id == 0 do c else if i < 0 do c else if i >= 32768 do c else NativeArray.set_i32(c, i, id) end end end
      blit_x(c2, t, ox, oy, oz, rot, split, base_x, base_y, base_z, x + 1, x1, y, z)
    end
  end
  fn blit_z(c : NativeI32Arr, t : Stamp, ox : Int, oy : Int, oz : Int, rot : Int, split : Int, base_x : Int, base_y : Int, base_z : Int, x0 : Int, x1 : Int, y : Int, z : Int, z1 : Int) : NativeI32Arr do
    if z > z1 do c
    else blit_z(blit_x(c, t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y, z), t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y, z + 1, z1) end
  end
  fn blit_y(c : NativeI32Arr, t : Stamp, ox : Int, oy : Int, oz : Int, rot : Int, split : Int, base_x : Int, base_y : Int, base_z : Int, x0 : Int, x1 : Int, y : Int, y1 : Int, z0 : Int, z1 : Int) : NativeI32Arr do
    if y > y1 do c
    else blit_y(blit_z(c, t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y, z0, z1), t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y + 1, y1, z0, z1) end
  end

end
