-- The loop of Strata.Template.blit without its probability draws and without
-- the chunk: a 9 x 12 x 9 template of block ids stamped, turned a quarter
-- turn, into a flat 32 x 32 x 32 array, hole ids skipped. The loop is blit's
-- own, copied: three nested tail calls of fourteen arguments, the template a
-- seven-field constructor read through accessors, the turn undone per voxel
-- by a function that answers a tuple.
--
--   VARIANT=0   as Strata.Template.blit has it (unturn answers a tuple)
--   VARIANT=1   the turn undone by two functions answering an Int each
mod StampLoop do
  needs IO

  type Stamp = Stamp(Int, Int, Int, NativeI32Arr, NativeU8Arr, NativeU8Arr, Float)

  pfn t_sx(t : Stamp) : Int do match t do Stamp(v, _, _, _, _, _, _) -> v end end
  pfn t_sy(t : Stamp) : Int do match t do Stamp(_, v, _, _, _, _, _) -> v end end
  pfn t_sz(t : Stamp) : Int do match t do Stamp(_, _, v, _, _, _, _) -> v end end
  pfn t_ids(t : Stamp) : NativeI32Arr do match t do Stamp(_, _, _, v, _, _, _) -> v end end

  pfn quarter(rot : Int) : Int do int_and(rot, 3) end

  pfn unturn(t : Stamp, rot : Int, rx : Int, rz : Int) : (Int, Int) do
    let r = quarter(rot)
    if r == 0 do (rx, rz)
    else if r == 1 do (rz, t_sz(t) - 1 - rx)
    else if r == 2 do (t_sx(t) - 1 - rx, t_sz(t) - 1 - rz)
    else (t_sx(t) - 1 - rz, rx) end end end
  end
  pfn unturn_x(t : Stamp, rot : Int, rx : Int, rz : Int) : Int do
    let r = quarter(rot)
    if r == 0 do rx else if r == 1 do rz else if r == 2 do t_sx(t) - 1 - rx else t_sx(t) - 1 - rz end end end
  end
  pfn unturn_z(t : Stamp, rot : Int, rx : Int, rz : Int) : Int do
    let r = quarter(rot)
    if r == 0 do rz else if r == 1 do t_sz(t) - 1 - rx else if r == 2 do t_sz(t) - 1 - rz else rx end end end
  end

  pfn drawn(t : Stamp, x : Int, y : Int, z : Int) : Int do NativeArray.get_i32(t_ids(t), x + t_sx(t) * (y + t_sy(t) * z)) end

  pfn blit_x(c : NativeI32Arr, t : Stamp, ox : Int, oy : Int, oz : Int, rot : Int, split : Int, base_x : Int, base_y : Int, base_z : Int, x : Int, x1 : Int, y : Int, z : Int) : NativeI32Arr do
    if x > x1 do c
    else
      let id = if split == 0 do
        let (tx, tz) = unturn(t, rot, x - ox, z - oz)
        drawn(t, tx, y - oy, tz)
      else drawn(t, unturn_x(t, rot, x - ox, z - oz), y - oy, unturn_z(t, rot, x - ox, z - oz)) end
      let i = (x - base_x) + 32 * ((z - base_z) + 32 * (y - base_y))
      let c2 = if id == 0 do c else if i < 0 do c else if i >= 32768 do c else NativeArray.set_i32(c, i, id) end end end
      blit_x(c2, t, ox, oy, oz, rot, split, base_x, base_y, base_z, x + 1, x1, y, z)
    end
  end
  pfn blit_z(c : NativeI32Arr, t : Stamp, ox : Int, oy : Int, oz : Int, rot : Int, split : Int, base_x : Int, base_y : Int, base_z : Int, x0 : Int, x1 : Int, y : Int, z : Int, z1 : Int) : NativeI32Arr do
    if z > z1 do c
    else blit_z(blit_x(c, t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y, z), t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y, z + 1, z1) end
  end
  pfn blit_y(c : NativeI32Arr, t : Stamp, ox : Int, oy : Int, oz : Int, rot : Int, split : Int, base_x : Int, base_y : Int, base_z : Int, x0 : Int, x1 : Int, y : Int, y1 : Int, z0 : Int, z1 : Int) : NativeI32Arr do
    if y > y1 do c
    else blit_y(blit_z(c, t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y, z0, z1), t, ox, oy, oz, rot, split, base_x, base_y, base_z, x0, x1, y + 1, y1, z0, z1) end
  end

  pfn lump(a : NativeI32Arr, i : Int) : NativeI32Arr do
    if i >= 972 do a
    else
      let x = i % 9
      let y = (i / 9) % 12
      let z = i / 108
      lump(NativeArray.set_i32(a, i, if (3 * x + y + 5 * z) % 4 == 0 do 0 else 2 + (x + 2 * y + 3 * z) % 5 end), i + 1)
    end
  end

  pfn rep(c : NativeI32Arr, t : Stamp, split : Int, left : Int) : NativeI32Arr do
    if left <= 0 do c
    else rep(blit_y(c, t, 10, 11, 10, left, split, 0, 0, 0, 10, 18, 11, 22, 10, 18), t, split, left - 1) end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let t = Stamp(9, 12, 9, lump(NativeArray.make_i32(972, 0), 0), NativeArray.make_u8(972, 255), NativeArray.make_u8(12, 255), 1.0)
    let c = rep(NativeArray.make_i32(32768, 0), t, Authority.must(Env.get_int("VARIANT", 0)), Authority.must(Env.get_int("REPS", 1)))
    Authority.must(println(int_to_string(NativeArray.get_i32(c, 15 + 32 * (14 + 32 * 15)))))
  end
end
