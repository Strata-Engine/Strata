-- stamp_loop.march with its template type, accessors and loop moved into
-- StampLib (stamp_lib.march, found on MARCH_LIB_PATH), as a game reaches
-- Strata.Template.blit in the library. Nothing else differs. VARIANT as in
-- stamp_loop.march.
mod StampTwo do
  needs IO

  pfn lump(a : NativeI32Arr, i : Int) : NativeI32Arr do
    if i >= 972 do a
    else
      let x = i % 9
      let y = (i / 9) % 12
      let z = i / 108
      lump(NativeArray.set_i32(a, i, if (3 * x + y + 5 * z) % 4 == 0 do 0 else 2 + (x + 2 * y + 3 * z) % 5 end), i + 1)
    end
  end

  pfn rep(c : NativeI32Arr, t : StampLib.Stamp, split : Int, left : Int) : NativeI32Arr do
    if left <= 0 do c
    else rep(StampLib.blit_y(c, t, 10, 11, 10, left, split, 0, 0, 0, 10, 18, 11, 22, 10, 18), t, split, left - 1) end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let t = StampLib.Stamp(9, 12, 9, lump(NativeArray.make_i32(972, 0), 0), NativeArray.make_u8(972, 255), NativeArray.make_u8(12, 255), 1.0)
    let c = rep(NativeArray.make_i32(32768, 0), t, Authority.must(Env.get_int("VARIANT", 0)), Authority.must(Env.get_int("REPS", 1)))
    Authority.must(println(int_to_string(NativeArray.get_i32(c, 15 + 32 * (14 + 32 * 15)))))
  end
end
