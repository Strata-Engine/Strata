-- acc_lib.march and acc_two.march as one module, as stamp_loop.march is:
-- the per-call cost of the same accessor compiled in the program's module.
mod AccOne do
  needs IO

  type Stamp = Stamp(Int, Int, Int, NativeI32Arr, NativeU8Arr, NativeU8Arr, Float)

  fn t_sx(t : Stamp) : Int do match t do Stamp(v, _, _, _, _, _, _) -> v end end
  fn t_sy(t : Stamp) : Int do match t do Stamp(_, v, _, _, _, _, _) -> v end end
  fn t_sz(t : Stamp) : Int do match t do Stamp(_, _, v, _, _, _, _) -> v end end
  fn pass(_t : Stamp, i : Int) : Int do i end

  fn spin(t : Stamp, variant : Int, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc
    else
      let v = if variant == 0 do i else if variant == 1 do t_sx(t) else if variant == 2 do pass(t, i) else t_sx(t) + t_sy(t) * t_sz(t) end end end
      spin(t, variant, i + 1, n, int_and(int_xor(acc * 3, v), 16777215))
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let t = Stamp(9, 12, 9, NativeArray.make_i32(972, 0), NativeArray.make_u8(972, 255), NativeArray.make_u8(12, 255), 1.0)
    let r = spin(t, Authority.must(Env.get_int("VARIANT", 0)), 0, Authority.must(Env.get_int("REPS", 1)), 1)
    Authority.must(println(int_to_string(r)))
  end
end
