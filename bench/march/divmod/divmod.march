-- Integer / and % by a constant, as every flat-index loop does to recover
-- (x, y, z). VARIANT 0: / and %. VARIANT 1: int_shr and int_and.
mod DivMod do
  needs IO

  pfn with_div(i : Int, acc : Int) : Int do
    if i >= 32768 do acc else with_div(i + 1, acc + i % 32 + (i / 32) % 32 + i / 1024) end
  end

  pfn with_shift(i : Int, acc : Int) : Int do
    if i >= 32768 do acc else with_shift(i + 1, acc + int_and(i, 31) + int_and(int_shr(i, 5), 31) + int_shr(i, 10)) end
  end

  pfn rep(variant : Int, left : Int, acc : Int) : Int do
    if left <= 0 do acc
    else rep(variant, left - 1, int_and(acc + (if variant == 0 do with_div(left % 3, 0) else with_shift(left % 3, 0) end), 1048575)) end
  end

  fn main(_cap : Cap(IO)) : Unit do
    println(int_to_string(rep(Env.get_int("VARIANT", 0), Env.get_int("REPS", 1), 0)))
  end
end
