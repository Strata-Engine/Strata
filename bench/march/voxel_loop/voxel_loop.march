-- A per-voxel loop that reads two arrays and writes one: the density without
-- its caves, out[i] = (h[i % 1024] - y) * squash + amp * n[i], y the voxel's row.
-- No Float-valued `if` (see ../float_if), no call but the array reads and write.
mod VoxelLoop do
  needs IO

  pfn ramp(a : NativeF32Arr, k : Int, n : Int, m : Int) : NativeF32Arr do
    if k >= n do a else ramp(NativeArray.set_f32(a, k, int_to_float((k * 31) % m) *. 0.125), k + 1, n, m) end
  end

  pfn dens(hs : NativeF32Arr, ns : NativeF32Arr, out : NativeF32Arr, y0 : Float, sq : Float, amp : Float, i : Int) : NativeF32Arr do
    if i >= 32768 do out
    else
      let d = (NativeArray.get_f32(hs, i % 1024) -. (y0 +. int_to_float(i / 1024))) *. sq +. amp *. NativeArray.get_f32(ns, i)
      dens(hs, ns, NativeArray.set_f32(out, i, d), y0, sq, amp, i + 1)
    end
  end

  pfn rep(hs : NativeF32Arr, ns : NativeF32Arr, left : Int, acc : Float) : Float do
    if left <= 0 do acc
    else rep(hs, ns, left - 1, acc +. NativeArray.get_f32(dens(hs, ns, NativeArray.make_f32(32768, 0.0), 8.0, 1.0, 12.0, 0), 12345 + left % 7)) end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let hs = ramp(NativeArray.make_f32(1024, 0.0), 0, 1024, 257)
    let ns = ramp(NativeArray.make_f32(32768, 0.0), 0, 32768, 17)
    Authority.must(println(float_to_string(rep(hs, ns, Authority.must(Env.get_int("REPS", 1)), 0.0))))
  end
end
