-- A hash of a cell (x, y, z) under a seed, two ways.
-- VARIANT 0: Strata.Seed.cell as it is: 32-bit lanes, every product masked
--            back under 2^32 so no multiply can leave the 63-bit Int range.
-- VARIANT 1: one 63-bit lane with int_wrapping_mul (march-main only; March
--            0.5.0 has no wrapping arithmetic and this file does not compile there).
mod Hash64 do
  needs IO

  pfn low32(v : Int) : Int do int_and(v, 4294967295) end
  pfn high32(v : Int) : Int do int_and(int_shr(v, 32), 4294967295) end
  pfn h32(x0 : Int) : Int do
    let x1 = int_xor(x0, int_shr(x0, 16))
    let x2 = low32(x1 * 73244475)
    let x3 = int_xor(x2, int_shr(x2, 16))
    let x4 = low32(x3 * 73244475)
    int_xor(x4, int_shr(x4, 16))
  end
  pfn mix(seed : Int, salt : Int) : Int do
    let a = h32(int_xor(low32(seed), h32(low32(salt + 2654435769))))
    let b = h32(int_xor(int_xor(high32(seed), h32(high32(salt) + 1013904223)), a + 1640531527))
    int_and(b, 1073741823) * 4294967296 + a
  end
  pfn cell(seed : Int, salt : Int, x : Int, y : Int, z : Int) : Int do
    let s = mix(seed, salt)
    let a0 = h32(int_xor(low32(s), h32(low32(x + 2246822519))))
    let a1 = h32(int_xor(a0, h32(low32(y + 3266489917))))
    let a2 = h32(int_xor(a1, h32(low32(z + 668265263))))
    let b = h32(int_xor(int_xor(high32(s), a2), 374761393))
    int_and(b, 1073741823) * 4294967296 + a2
  end

  -- splitmix-style: xorshift, wrapping multiply, twice, in one 63-bit lane
  pfn m63(v : Int) : Int do
    let m = int_and(v, 4611686018427387903)
    let a = int_wrapping_mul(int_xor(m, int_shr(m, 30)), 2685821657736338717)
    let b = int_and(a, 4611686018427387903)
    let c = int_wrapping_mul(int_xor(b, int_shr(b, 27)), 1181783497276652981)
    let d = int_and(c, 4611686018427387903)
    int_xor(d, int_shr(d, 31))
  end
  pfn cell63(seed : Int, salt : Int, x : Int, y : Int, z : Int) : Int do
    m63(int_xor(m63(int_xor(m63(int_xor(m63(int_xor(seed, salt)), x)), y)), z))
  end

  pfn go(variant : Int, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc
    else if variant == 0 do go(variant, i + 1, n, int_xor(acc, cell(7, 21, i, 0, n - i)))
    else go(variant, i + 1, n, int_xor(acc, cell63(7, 21, i, 0, n - i))) end end
  end

  pfn rep(variant : Int, left : Int, acc : Int) : Int do
    if left <= 0 do acc else rep(variant, left - 1, int_xor(acc, go(variant, left % 3, 4096, 0))) end
  end

  fn main(_cap : Cap(IO)) : Unit do
    println(int_to_string(rep(Env.get_int("VARIANT", 0), Env.get_int("REPS", 1), 0)))
  end
end
