-- A function value called once per element, as Strata.Surface's scan calls
-- its rule. VARIANT 0: the rule is a closure (it captures three values) passed
-- down the loop. VARIANT 1: the same rule called directly by name.
mod Closure do
  needs IO

  pfn material(sand : Int, snow : Int, depth : Int, y : Int, wet : Bool) : Int do
    if depth < 0 do (if wet do 5 else 0 end)
    else if depth == 0 do (if y < sand do 4 else if y > snow do 6 else 3 end end)
    else if depth <= 3 do 2 else 1 end end end
  end

  pfn scan(out : NativeI32Arr, rule : Int -> Int -> Bool -> Int, i : Int) : NativeI32Arr do
    if i >= 32768 do out
    else scan(NativeArray.set_i32(out, i, rule(int_and(i, 7) - 1, int_shr(i, 10), int_and(i, 16) == 0)), rule, i + 1) end
  end

  pfn scan_direct(out : NativeI32Arr, sand : Int, snow : Int, base : Int, i : Int) : NativeI32Arr do
    if i >= 32768 do out
    else scan_direct(NativeArray.set_i32(out, i, material(sand, snow, int_and(i, 7) - 1, base + int_shr(i, 10), int_and(i, 16) == 0)), sand, snow, base, i + 1) end
  end

  pfn rep(variant : Int, left : Int, acc : Int) : Int do
    if left <= 0 do acc
    else
      let sand = 10
      let snow = 25
      let base = left % 3
      let out = if variant == 0 do scan(NativeArray.make_i32(32768, 0), fn (depth, y, wet) -> material(sand, snow, depth, base + y, wet), 0)
        else scan_direct(NativeArray.make_i32(32768, 0), sand, snow, base, 0) end
      rep(variant, left - 1, acc + NativeArray.get_i32(out, 12345 + left % 7))
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    Authority.must(println(int_to_string(rep(Authority.must(Env.get_int("VARIANT", 0)), Authority.must(Env.get_int("REPS", 1)), 0))))
  end
end
