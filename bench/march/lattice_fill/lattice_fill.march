-- Strata.Lattice's fill written in March: 9 x 5 x 9 samples (one every 4, 8, 4
-- voxels, index i + 9 * (j + 5 * k)) filled trilinearly to a chunk's 32768
-- voxels at x + 32 * (z + 32 * y). The array is made here and returned, so
-- every write is in place (no copy-on-write; see ../callee_fill for that).
-- VARIANT 0: index arithmetic with / and %. VARIANT 1: with shifts and masks.
mod LatticeFill do
  needs IO

  pfn samples(s : NativeF32Arr, k : Int) : NativeF32Arr do
    if k >= 405 do s else samples(NativeArray.set_f32(s, k, int_to_float((k * 37) % 101) *. 0.01), k + 1) end
  end

  pfn lerp(a : Float, b : Float, t : Float) : Float do a +. (b -. a) *. t end

  pfn voxel(s : NativeF32Arr, ci : Int, cj : Int, ck : Int, tx : Float, ty : Float, tz : Float) : Float do
    let b = ci + 9 * (cj + 5 * ck)
    let c00 = lerp(NativeArray.get_f32(s, b), NativeArray.get_f32(s, b + 1), tx)
    let c10 = lerp(NativeArray.get_f32(s, b + 9), NativeArray.get_f32(s, b + 10), tx)
    let c01 = lerp(NativeArray.get_f32(s, b + 45), NativeArray.get_f32(s, b + 46), tx)
    let c11 = lerp(NativeArray.get_f32(s, b + 54), NativeArray.get_f32(s, b + 55), tx)
    lerp(lerp(c00, c10, ty), lerp(c01, c11, ty), tz)
  end

  pfn fill_div(s : NativeF32Arr, out : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= 32768 do out
    else
      let x = i % 32
      let z = (i / 32) % 32
      let y = i / 1024
      let v = voxel(s, x / 4, y / 8, z / 4, int_to_float(x % 4) *. 0.25, int_to_float(y % 8) *. 0.125, int_to_float(z % 4) *. 0.25)
      fill_div(s, NativeArray.set_f32(out, i, v), i + 1)
    end
  end

  pfn fill_shift(s : NativeF32Arr, out : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= 32768 do out
    else
      let x = int_and(i, 31)
      let z = int_and(int_shr(i, 5), 31)
      let y = int_shr(i, 10)
      let v = voxel(s, int_shr(x, 2), int_shr(y, 3), int_shr(z, 2), int_to_float(int_and(x, 3)) *. 0.25, int_to_float(int_and(y, 7)) *. 0.125, int_to_float(int_and(z, 3)) *. 0.25)
      fill_shift(s, NativeArray.set_f32(out, i, v), i + 1)
    end
  end

  pfn rep(s : NativeF32Arr, variant : Int, left : Int, acc : Float) : Float do
    if left <= 0 do acc
    else
      let out = if variant == 0 do fill_div(s, NativeArray.make_f32(32768, 0.0), 0) else fill_shift(s, NativeArray.make_f32(32768, 0.0), 0) end
      rep(s, variant, left - 1, acc +. NativeArray.get_f32(out, 12345 + left % 7))
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let s = samples(NativeArray.make_f32(405, 0.0), 0)
    println(float_to_string(rep(s, Env.get_int("VARIANT", 0), Env.get_int("REPS", 1), 0.0)))
  end
end
