-- `&&` and `||` with a call on the right (GAPS S16).
-- VARIANT 0: `i < 0 && costly(i)`: the left is always false, so costly should never run.
-- VARIANT 1: the same test as a nested `if`.
-- The line printed is how many times costly ran (through its result), then a
-- check that a guarded read does not trap.
mod ShortCircuit do
  needs IO

  -- a call with work in it: 16 array reads
  pfn costly(a : NativeIntArr, i : Int, k : Int, acc : Int) : Bool do
    if k >= 16 do acc > 0 else costly(a, i, k + 1, acc + NativeArray.get_int(a, int_and(i + k, 1023))) end
  end

  pfn with_and(a : NativeIntArr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc
    else with_and(a, i + 1, n, if i < 0 && costly(a, i, 0, 0) do acc + 1 else acc end) end
  end

  pfn with_if(a : NativeIntArr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc
    else with_if(a, i + 1, n, if (if i < 0 do costly(a, i, 0, 0) else false end) do acc + 1 else acc end) end
  end

  pfn rep(a : NativeIntArr, variant : Int, left : Int, acc : Int) : Int do
    if left <= 0 do acc
    else rep(a, variant, left - 1, acc + (if variant == 0 do with_and(a, left % 3, 4096, 0) else with_if(a, left % 3, 4096, 0) end)) end
  end

  pfn said(k : Int) : Bool do
    println("the right side of `false && ...` ran")
    k > 0
  end

  fn main(_cap : Cap(IO)) : Unit do
    let a = NativeArray.make_int(1024, 1)
    println(int_to_string(rep(a, Env.get_int("VARIANT", 0), Env.get_int("REPS", 1), 0)))
    if Env.get_int("PROBE", 0) == 1 do
      let t = false && said(1)
      println(if t do "true" else "false" end)
    else () end
  end
end
