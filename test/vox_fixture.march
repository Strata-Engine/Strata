-- VoxFixture: MagicaVoxel files built byte by byte for the tests of
-- Strata.Vox and Strata.Character. Test code, not library.
mod Strata.Test.VoxFixture do

  -- a little-endian 32-bit integer
  fn i32(v : Int) : List(Int) do
    let u = if v < 0 do v + 4294967296 else v end
    [int_and(u, 255), int_and(int_shr(u, 8), 255), int_and(int_shr(u, 16), 255), int_and(int_shr(u, 24), 255)]
  end
  fn str(s : String) : List(Int) do
    let a = Bytes.to_u8_arr(Bytes.from_string(s))
    List.append(i32(NativeArray.length_u8(a)), List.map(List.range(0, NativeArray.length_u8(a)), fn i -> NativeArray.get_u8(a, i)))
  end
  fn dict(kvs : List((String, String))) : List(Int) do
    List.append(i32(List.length(kvs)), List.flat_map(kvs, fn kv -> match kv do (k, v) -> List.append(str(k), str(v)) end))
  end
  fn tag(s : String) : List(Int) do List.take(List.drop(str(s), 4), 4) end
  -- a chunk with no children
  fn chunk(id : String, content : List(Int)) : List(Int) do List.concat([tag(id), i32(List.length(content)), i32(0), content]) end
  -- a whole file: "VOX ", version 150, MAIN holding the chunks
  fn file(chunks : List(List(Int))) : List(Int) do
    let body = List.concat(chunks)
    List.concat([tag("VOX "), i32(150), tag("MAIN"), i32(0), i32(List.length(body)), body])
  end
  fn size(x : Int, y : Int, z : Int) : List(Int) do chunk("SIZE", List.concat([i32(x), i32(y), i32(z)])) end
  fn xyzi(vs : List((Int, Int, Int, Int))) : List(Int) do
    chunk("XYZI", List.append(i32(List.length(vs)), List.flat_map(vs, fn q -> match q do (x, y, z, c) -> [x, y, z, c] end)))
  end
  -- a model: SIZE then XYZI
  fn model(x : Int, y : Int, z : Int, vs : List((Int, Int, Int, Int))) : List(Int) do List.append(size(x, y, z), xyzi(vs)) end
  -- a transform node: its id, attributes, its child, and one frame with translation t
  fn trn(id : Int, attrs : List((String, String)), child : Int, t : String) : List(Int) do
    chunk("nTRN", List.concat([i32(id), dict(attrs), i32(child), i32(-1), i32(0), i32(1), dict([("_t", t)])]))
  end
  fn grp(id : Int, children : List(Int)) : List(Int) do
    chunk("nGRP", List.concat([i32(id), dict([]), i32(List.length(children)), List.flat_map(children, fn c -> i32(c))]))
  end
  fn shp(id : Int, model_id : Int) : List(Int) do chunk("nSHP", List.concat([i32(id), dict([]), i32(1), i32(model_id), dict([])])) end
  fn rgba(cs : List((Int, Int, Int))) : List(Int) do
    let given = List.flat_map(cs, fn c -> match c do (r, g, b) -> [r, g, b, 255] end)
    chunk("RGBA", List.append(given, List.repeat(0, 1024 - List.length(given))))
  end
  fn matl(id : Int, kvs : List((String, String))) : List(Int) do chunk("MATL", List.append(i32(id), dict(kvs))) end

  -- a scene of named models at translations: root transform 0 -> group 1 -> per model a transform (2 + 2k) named and placed, and a shape (3 + 2k)
  fn scene(parts : List((String, String))) : List(Int) do scene_with([], parts) end
  -- the same, the root transform carrying attributes
  fn scene_with(root : List((String, String)), parts : List((String, String))) : List(Int) do
    let n = List.length(parts)
    let ids = List.range(0, n)
    let kids = List.map(ids, fn k -> 2 + 2 * k)
    List.concat(Cons(trn(0, root, 1, "0 0 0"), Cons(grp(1, kids), List.map(List.zip(ids, parts), fn kp -> match kp do (k, pt) -> part_nodes(k, pt) end))))
  end

  fn part_nodes(k : Int, pt : (String, String)) : List(Int) do
    match pt do (name, t) -> List.append(trn(2 + 2 * k, [("_name", name)], 3 + 2 * k, t), shp(3 + 2 * k, k)) end
  end

  fn bytes(l : List(Int)) : NativeU8Arr do
    fill(NativeArray.make_u8(Strata.Size.of(List.length(l)), 0), l, 0)
  end
  pfn fill(a : NativeU8Arr, l : List(Int), i : Int) : NativeU8Arr do
    match l do
      Nil -> a
      Cons(v, rest) -> fill(NativeArray.set_u8(a, i, v), rest, i + 1)
    end
  end
end
