-- Ui: the 2D layer's quad list, placed by anchor and snapped to device pixels.
mod Strata.Test.Ui do

  needs IO.Clock
  needs IO.Process
  import Test
  alias Strata.Ui as Uq

  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.001 end
  pfn white() : (Float, Float, Float, Float) do (1.0, 1.0, 1.0, 1.0) end
  -- float [i] of quad [q]
  pfn at(u : Strata.Ui.Ui, q : Int, i : Int) : Float do NativeArray.get_f32(Uq.quads(u), 16 * q + i) end
  pfn rect_is(u : Strata.Ui.Ui, q : Int, x0 : Float, y0 : Float, x1 : Float, y1 : Float) : Bool do
    near(at(u, q, 0), x0) && near(at(u, q, 1), y0) && near(at(u, q, 2), x1) && near(at(u, q, 3), y1)
  end
  pfn one(anchor : Int) : Strata.Ui.Ui do Uq.rect(Uq.begin(800.0, 600.0, 1.0, 1.0), anchor, 0.0, 0.0, 10.0, 10.0, white()) end
  pfn whole(v : Float) : Bool do near(v, Math.floor(v +. 0.5)) end
  pfn all_whole(u : Strata.Ui.Ui, q : Int) : Bool do
    if q >= Uq.quad_count(u) do true
    else if whole(at(u, q, 0)) && whole(at(u, q, 1)) && whole(at(u, q, 2)) && whole(at(u, q, 3)) do all_whole(u, q + 1)
    else false end end
  end

  describe "Ui anchors" do
    test "each of the nine anchors places a rect by its own matching point" do
      Test.assert_true(rect_is(one(Uq.top_left()), 0, 0.0, 0.0, 10.0, 10.0), "holds")
      Test.assert_true(rect_is(one(Uq.top()), 0, 395.0, 0.0, 405.0, 10.0), "holds")
      Test.assert_true(rect_is(one(Uq.top_right()), 0, 790.0, 0.0, 800.0, 10.0), "holds")
      Test.assert_true(rect_is(one(Uq.left()), 0, 0.0, 295.0, 10.0, 305.0), "holds")
      Test.assert_true(rect_is(one(Uq.centre()), 0, 395.0, 295.0, 405.0, 305.0), "holds")
      Test.assert_true(rect_is(one(Uq.right()), 0, 790.0, 295.0, 800.0, 305.0), "holds")
      Test.assert_true(rect_is(one(Uq.bottom_left()), 0, 0.0, 590.0, 10.0, 600.0), "holds")
      Test.assert_true(rect_is(one(Uq.bottom()), 0, 395.0, 590.0, 405.0, 600.0), "holds")
      Test.assert_true(rect_is(one(Uq.bottom_right()), 0, 790.0, 590.0, 800.0, 600.0), "holds")
    end
    test "an offset moves right and down from the anchor" do
      let u = Uq.rect(Uq.begin(800.0, 600.0, 1.0, 1.0), Uq.bottom(), 20.0, -30.0, 10.0, 10.0, white())
      Test.assert_true(rect_is(u, 0, 415.0, 560.0, 425.0, 570.0), "holds")
    end
    test "scale 2 doubles sizes and offsets" do
      let u = Uq.rect(Uq.begin(800.0, 600.0, 2.0, 1.0), Uq.top_left(), 5.0, 7.0, 10.0, 10.0, white())
      Test.assert_true(rect_is(u, 0, 10.0, 14.0, 30.0, 34.0), "holds")
    end
    test "a retina display doubles device pixels and keeps the layout" do
      let u = Uq.rect(Uq.begin(800.0, 600.0, 1.0, 2.0), Uq.bottom_right(), 0.0, 0.0, 10.0, 10.0, white())
      Test.assert_true(rect_is(u, 0, 1580.0, 1180.0, 1600.0, 1200.0), "holds")
    end
    test "scale 1.5 puts every edge on a whole device pixel" do
      let u = Uq.rect(Uq.rect(Uq.begin(800.0, 600.0, 1.5, 1.0), Uq.centre(), 3.0, 5.0, 7.0, 11.0, white()), Uq.top(), 1.0, 1.0, 5.0, 5.0, white())
      Test.assert_true(all_whole(u, 0), "holds")
    end
  end

  describe "Ui quad list" do
    test "it starts empty and counts what is added, in call order" do
      let u0 = Uq.begin(800.0, 600.0, 1.0, 1.0)
      Test.assert_eq_int(Uq.quad_count(u0), 0, "count")
      let u = Uq.icon(Uq.rect(u0, Uq.top_left(), 0.0, 0.0, 4.0, 4.0, (1.0, 0.0, 0.0, 0.5)), Uq.top_left(), 50.0, 0.0, 16.0, 7)
      Test.assert_eq_int(Uq.quad_count(u), 2, "count")
      Test.assert_true(rect_is(u, 0, 0.0, 0.0, 4.0, 4.0), "holds")
      Test.assert_true(rect_is(u, 1, 50.0, 0.0, 66.0, 16.0), "holds")
    end
    test "a rect carries its colour and the plain kind; an icon its texture layer" do
      let u = Uq.icon(Uq.rect(Uq.begin(800.0, 600.0, 1.0, 1.0), Uq.top_left(), 0.0, 0.0, 4.0, 4.0, (1.0, 0.25, 0.0, 0.5)), Uq.top_left(), 50.0, 0.0, 16.0, 7)
      Test.assert_true(near(at(u, 0, 8), 1.0) && near(at(u, 0, 9), 0.25) && near(at(u, 0, 10), 0.0) && near(at(u, 0, 11), 0.5), "holds")
      Test.assert_true(near(at(u, 0, 12), 0.0), "holds")
      Test.assert_true(near(at(u, 1, 12), 1.0) && near(at(u, 1, 13), 7.0), "holds")
      Test.assert_true(near(at(u, 1, 4), 0.0) && near(at(u, 1, 6), 1.0) && near(at(u, 1, 7), 1.0), "holds")
    end
    test "many quads grow the list without losing any" do
      let u = many(Uq.begin(800.0, 600.0, 1.0, 1.0), 0, 300)
      Test.assert_eq_int(Uq.quad_count(u), 300, "count")
      Test.assert_true(rect_is(u, 299, 299.0, 0.0, 300.0, 1.0), "holds")
      Test.assert_true(rect_is(u, 0, 0.0, 0.0, 1.0, 1.0), "holds")
    end
  end

  pfn many(u : Strata.Ui.Ui, i : Int, n : Int) : Strata.Ui.Ui do
    if i >= n do u else many(Uq.rect(u, Uq.top_left(), int_to_float(i), 0.0, 1.0, 1.0, white()), i + 1, n) end
  end

  describe "Ui frames" do
    -- an 8-pixel border from a 24 x 24 region at (32, 0)
    test "a frame is nine quads: corners keep the border, the middle stretches" do
      let u = Uq.frame(Uq.begin(800.0, 600.0, 1.0, 1.0), Uq.top_left(), 100.0, 100.0, 60.0, 40.0, (32, 0, 24, 24), 8, white())
      Test.assert_eq_int(Uq.quad_count(u), 9, "count")
      Test.assert_true(rect_is(u, 0, 100.0, 100.0, 108.0, 108.0), "holds")
      Test.assert_true(rect_is(u, 4, 108.0, 108.0, 152.0, 132.0), "holds")
      Test.assert_true(rect_is(u, 8, 152.0, 132.0, 160.0, 140.0), "holds")
      -- texture regions, in atlas pixels: the corner is the region's corner, the middle its middle
      Test.assert_true(near(at(u, 0, 4), 32.0) && near(at(u, 0, 5), 0.0) && near(at(u, 0, 6), 40.0) && near(at(u, 0, 7), 8.0), "holds")
      Test.assert_true(near(at(u, 4, 4), 40.0) && near(at(u, 4, 5), 8.0) && near(at(u, 4, 6), 48.0) && near(at(u, 4, 7), 16.0), "holds")
      Test.assert_true(near(at(u, 8, 4), 48.0) && near(at(u, 8, 6), 56.0) && near(at(u, 8, 7), 24.0), "holds")
    end
    test "a frame smaller than twice its border has no negative sizes" do
      let u = Uq.frame(Uq.begin(800.0, 600.0, 1.0, 1.0), Uq.top_left(), 0.0, 0.0, 10.0, 6.0, (0, 0, 24, 24), 8, white())
      Test.assert_true(no_negative(u, 0), "holds")
      Test.assert_true(near(at(u, 8, 2), 10.0) && near(at(u, 8, 3), 6.0), "holds")
    end
    test "a frame's seams fall on whole device pixels at scale 1.5" do
      let u = Uq.frame(Uq.begin(800.0, 600.0, 1.5, 1.0), Uq.centre(), 3.0, 1.0, 61.0, 41.0, (0, 0, 24, 24), 7, white())
      Test.assert_true(all_whole(u, 0), "holds")
      -- and neighbours share their seam exactly
      Test.assert_true(near(at(u, 0, 2), at(u, 1, 0)) && near(at(u, 1, 2), at(u, 2, 0)) && near(at(u, 0, 3), at(u, 3, 1)), "holds")
    end
    test "an image carries its region and the image kind" do
      let u = Uq.image(Uq.begin(800.0, 600.0, 1.0, 1.0), Uq.top_left(), 0.0, 0.0, 20.0, 20.0, (8, 16, 10, 12), white())
      Test.assert_true(near(at(u, 0, 12), 2.0), "holds")
      Test.assert_true(near(at(u, 0, 4), 8.0) && near(at(u, 0, 5), 16.0) && near(at(u, 0, 6), 18.0) && near(at(u, 0, 7), 28.0), "holds")
    end
  end

  pfn no_negative(u : Strata.Ui.Ui, q : Int) : Bool do
    if q >= Uq.quad_count(u) do true
    else if at(u, q, 2) >= at(u, q, 0) && at(u, q, 3) >= at(u, q, 1) do no_negative(u, q + 1) else false end end
  end
end
