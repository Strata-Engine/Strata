-- Heights: height grids and ground adaptation.
mod Strata.Test.Heights do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias Strata.Heights as Hgt

  describe "Heights" do
    test "get outside answers the nearest edge" do
      let g = Hgt.set(Hgt.set(Hgt.grid(10, 20, 4, 5), 10, 20, 7), 13, 23, 9)
      Test.assert_true(Hgt.get(g, 0, 0) == 7 && Hgt.get(g, 50, 50) == 9 && Hgt.get(g, 11, 21) == 5, "edges and inside")
    end
    test "flatten sets the footprint and eases its margin within the grade" do
      let g0 = Hgt.grid(0, 0, 20, 0)
      let cells = List.flat_map(List.range(8, 12), fn z -> List.map(List.range(8, 12), fn x -> (x, z)))
      let g = Hgt.flatten(g0, cells, 6, 3, 2.0)
      Test.assert_true(Hgt.get(g, 9, 9) == 6 && Hgt.get(g, 11, 11) == 6, "footprint at 6")
      Test.assert_true(Hgt.get(g, 7, 9) == 4 && Hgt.get(g, 6, 9) == 2 && Hgt.get(g, 5, 9) == 0 && Hgt.get(g, 3, 9) == 0, "eased by 2 a column")
    end
    test "quantise rounds down to the step" do
      let g = Hgt.quantise(Hgt.set(Hgt.set(Hgt.grid(0, 0, 4, 0), 1, 1, 7), 2, 2, -3), 2)
      Test.assert_true(Hgt.get(g, 1, 1) == 6 && Hgt.get(g, 2, 2) == -4 && Hgt.get(g, 0, 0) == 0, "down to multiples of 2")
    end
    test "slope of a step of 3 is 3" do
      let g = Hgt.set(Hgt.grid(0, 0, 4, 0), 1, 1, 3)
      Test.assert_true(Hgt.slope(g, 1, 1) == 3 && Hgt.slope(g, 0, 1) == 3 && Hgt.slope(g, 3, 3) == 0, "slope")
    end
  end
end
