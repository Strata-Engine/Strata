-- Lots: the buildable land between roads cut into lots that face a street.
mod Strata.Test.Lots do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias Strata.Lots as Lts
  alias Strata.Roads as LtsR

  -- at 1 m a voxel: roads 4 m wide along z = 0 and z = 40 (x -10..70) and x = 0 and x = 60 (z -10..50)
  pfn road(g : Strata.Roads.RoadGraph, ax : Float, az : Float, bx : Float, bz : Float) : Strata.Roads.RoadGraph do
    match LtsR.add_node(g, ax, az) do (g1, a) -> match LtsR.add_node(g1, bx, bz) do (g2, b) -> LtsR.add_segment(g2, a, b, 4.0, 5) end end
  end
  pfn town() : Strata.Roads.RoadGraph do
    road(road(road(road(LtsR.graph(), -10.0, 0.0, 70.0, 0.0), -10.0, 40.0, 70.0, 40.0), 0.0, -10.0, 0.0, 50.0), 60.0, -10.0, 60.0, 50.0)
  end
  pfn on_road(x : Int, z : Int) : Bool do Option.is_some(LtsR.at(town(), int_to_float(x) +. 0.5, int_to_float(z) +. 0.5)) end
  pfn lots(seed : Int) : List(Strata.Lots.Lot) do
    List.flat_map(Lts.blocks(town(), -10, -10, 80, 1.0, fn (x, z) -> true), fn b -> Lts.split(b, town(), 1.0, 6, 16, seed))
  end
  pfn cols(l : Strata.Lots.Lot) : List((Int, Int)) do
    match Lts.lot_box(l) do (x0, z0, x1, z1) -> List.map(List.range(0, (x1 - x0 + 1) * (z1 - z0 + 1)), fn i -> (x0 + i % (x1 - x0 + 1), z0 + i / (x1 - x0 + 1))) end
  end
  -- the columns just beyond the lot's street side
  pfn front(l : Strata.Lots.Lot) : List((Int, Int)) do
    match Lts.lot_box(l) do
      (x0, z0, x1, z1) ->
        let s = Lts.lot_street(l)
        if s == 0 do List.map(List.range(z0, z1 + 1), fn z -> (x1 + 1, z)) else if s == 1 do List.map(List.range(z0, z1 + 1), fn z -> (x0 - 1, z))
        else if s == 2 do List.map(List.range(x0, x1 + 1), fn x -> (x, z1 + 1)) else List.map(List.range(x0, x1 + 1), fn x -> (x, z0 - 1)) end end end
    end
  end
  pfn apart(a : Strata.Lots.Lot, b : Strata.Lots.Lot) : Bool do
    match (Lts.lot_box(a), Lts.lot_box(b)) do ((ax0, az0, ax1, az1), (bx0, bz0, bx1, bz1)) -> ax1 < bx0 || bx1 < ax0 || az1 < bz0 || bz1 < az0 end
  end

  describe "Lots" do
    test "every lot touches a road on its street side" do
      let ls = lots(3)
      Test.assert_true(List.length(ls) >= 8, "a town's worth of lots")
      Test.assert_true(List.all(ls, fn l -> List.any(front(l), fn c -> match c do (x, z) -> on_road(x, z) end)), "each faces a road")
    end
    test "lots never overlap each other or a road" do
      let ls = lots(3)
      Test.assert_true(List.all(ls, fn l -> List.all(cols(l), fn c -> match c do (x, z) -> !on_road(x, z) end)), "no road under a lot")
      Test.assert_true(List.all(List.range(0, List.length(ls)), fn i -> List.all(List.range(i + 1, List.length(ls)), fn j -> apart(List.nth(ls, i), List.nth(ls, j)))), "disjoint")
    end
    test "no lot is smaller than min_side" do
      Test.assert_true(List.all(lots(3), fn l -> match Lts.lot_box(l) do (x0, z0, x1, z1) -> x1 - x0 + 1 >= 6 && z1 - z0 + 1 >= 6 end), "6 by 6 at least")
    end
    test "the same seed splits the same way" do
      let a = List.map(lots(9), fn l -> Lts.lot_box(l))
      let b = List.map(lots(9), fn l -> Lts.lot_box(l))
      Test.assert_true(a == b && Lts.lot_area(List.head(lots(9))) > 0, "equal boxes")
    end
  end

  describe "Lots (review)" do
    test "a block with a road on one side only still splits under max_side" do
      -- a 40 x 40 block, the only road along its +x side
      let g = road(LtsR.graph(), 42.0, -5.0, 42.0, 45.0)
      let ls = Lts.split((0, 0, 39, 39), g, 1.0, 6, 16, 5)
      Test.assert_true(List.length(ls) >= 2 && List.all(ls, fn l -> match Lts.lot_box(l) do (x0, z0, x1, z1) -> z1 - z0 + 1 <= 16 end), "cut along the street into lots no wider than 16")
    end
  end

  describe "Lots.blocks shapes" do
    test "a cross of roads over a disc of land gives four wide blocks, not strips" do
      -- two roads crossing at (40, 40) metres, 4 m wide, over a disc of buildable land 36 m across
      let g = road(road(LtsR.graph(), 0.0, 40.0, 80.0, 40.0), 40.0, 0.0, 40.0, 80.0)
      let bs = Lts.blocks(g, 0, 0, 80, 1.0, fn (x, z) -> (x - 40) * (x - 40) + (z - 40) * (z - 40) <= 36 * 36)
      let wide = List.filter(bs, fn b -> match b do (x0, z0, x1, z1) -> x1 - x0 + 1 >= 20 && z1 - z0 + 1 >= 20 end)
      Test.assert_true(List.length(wide) >= 4, "a wide block in each quarter")
    end
  end
end
