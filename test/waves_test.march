-- Waves: dispersion, and a swell refracting over a beach and round an island.
mod Strata.Test.Waves do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias Strata.Waves as W

  -- the test seas' depths: 0 a sloping beach (land below z = 4, deepening 0.3 m a cell to 12 m),
  -- 1 deep water round a 12 x 12-cell island, 2 a bed rising steadily from 20 m eastward
  pfn depth_of(kind : Int, x : Int, z : Int) : Float do
    if kind == 0 do (if z < 4 do 0.0 else beach(0.3 *. int_to_float(z - 4)) end)
    else if kind == 1 do (if x >= 24 && x < 36 && z >= 24 && z < 36 do 0.0 else 20.0 end)
    else if kind == 2 do 20.0 -. 0.32 *. int_to_float(x)
    -- 3 a breakwater: one solid cell thick across the swell at x = 30, z 20..39, in 20 m of water
    else if kind == 3 do (if x == 30 && z >= 20 && z < 40 do 0.0 else 20.0 end)
    -- 4 a reef across the swell: a face from 20 m at x = 30 to 1 m at x = 40, a top 0.4 m deep at x 42..45, back to 20 m by x = 50
    else reef(x) end end end end
  end
  pfn reef(x : Int) : Float do
    if x < 30 do 20.0 else if x < 40 do 20.0 -. 1.9 *. int_to_float(x - 30)
    else if x < 42 do 1.0 else if x < 46 do 0.4 else if x < 50 do 0.4 +. 4.9 *. int_to_float(x - 45) else 20.0 end end end end end
  end
  pfn beach(d : Float) : Float do if d > 12.0 do 12.0 else d end end
  -- a w x h grid of 2 m cells of sea [kind]
  pfn grid(w : Int, h : Int, kind : Int, a : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= w * h do a else grid(w, h, kind, NativeArray.set_f32(a, i, depth_of(kind, i % w, i / w)), i + 1) end
  end
  pfn angle(f : Strata.Waves.Swell, x : Int, z : Int) : Float do
    let (pe, _) = W.sample(f, x + 1, z)
    let (pw, _) = W.sample(f, x - 1, z)
    let (ps, _) = W.sample(f, x, z + 1)
    let (pn, _) = W.sample(f, x, z - 1)
    Math.atan2(ps -. pn, pe -. pw)
  end

  describe "Waves.wavenumber" do
    test "deep water keeps k0 = w^2 / g and shallow water k = w / sqrt(g d)" do
      let omega = Math.sqrt(9.81 *. 6.283185307 /. 50.0)
      let deep = W.wavenumber(omega, 1000.0)
      Test.assert_true(Math.abs(deep -. 6.283185307 /. 50.0) < 0.0001, "deep water: the deep-water wavenumber")
      let shallow = W.wavenumber(omega, 0.5)
      let expect = omega /. Math.sqrt(9.81 *. 0.5)
      Test.assert_true(Math.abs(shallow -. expect) /. expect < 0.03, "half a metre: the shallow-water wavenumber, within 3%")
    end
  end

  describe "Waves.solve" do
    test "on a sloping beach the crests swing round to face the shore" do
      -- the swell comes in at 45 degrees toward the beach
      let d = grid(60, 60, 0, NativeArray.make_f32(3600, 0.0), 0)
      let f = W.solve(d, 60, 60, 0.0, 0.0, 2.0, 1.0, -1.0, 40.0)
      let off_shore = Math.abs(angle(f, 30, 50) +. 1.5708)
      let near_shore = Math.abs(angle(f, 30, 6) +. 1.5708)
      Test.assert_true(near_shore < off_shore, "the crests' normal turns toward straight onshore as the water shoals")
    end
    test "a swell wraps round an island into its lee, later and weaker" do
      -- the swell comes from the west
      let d = grid(60, 60, 1, NativeArray.make_f32(3600, 0.0), 0)
      let f = W.solve(d, 60, 60, 0.0, 0.0, 2.0, 1.0, 0.0, 40.0)
      let k0 = 6.283185307 /. 40.0
      let (lee_p, lee_a) = W.sample(f, 40, 30)
      let (open_p, open_a) = W.sample(f, 40, 5)
      Test.assert_true(lee_p < 1.0e29, "the lee is reached")
      Test.assert_true(lee_p > open_p +. 0.5, "the lee's crests arrive later than the open sea's, having gone round")
      Test.assert_true(lee_a < open_a, "the lee's sea is lower")
      Test.assert_true(Math.abs(open_p -. k0 *. (81.0)) < 1.5, "the open sea stays the plane wave")
      let (_, land_a) = W.sample(f, 30, 30)
      Test.assert_true(land_a == 0.0, "land has no sea")
      let (land_p, _) = W.sample(f, 30, 30)
      Test.assert_true(Math.abs(land_p -. k0 *. 61.0) < 0.001, "land carries the plane wave's phase, not a far marker")
    end
    test "shoaling raises the swell in shallow water" do
      -- a low swell, 0.3 m: one as high as a 40 m wavelength implies (1.3 m) breaks before it reaches 1.4 m of water
      let d = grid(60, 10, 2, NativeArray.make_f32(600, 0.0), 0)
      let f = W.solve_sea(d, 60, 10, 0.0, 0.0, 2.0, 1.0, 0.0, 40.0, 0.3)
      let (_, deep_a) = W.sample(f, 5, 5)
      let (_, shallow_a) = W.sample(f, 58, 5)
      Test.assert_true(shallow_a > deep_a, "a swell running into shallow water grows")
    end
  end

  -- Obstacles are depth: a breakwater, mole or solid pier is land (depth 0), a reef or bar is shallow water.
  describe "Waves obstacles" do
    test "a breakwater casts a calm shadow behind it, and the swell wraps round its ends" do
      let d = grid(80, 60, 3, NativeArray.make_f32(4800, 0.0), 0)
      let f = W.solve(d, 80, 60, 0.0, 0.0, 2.0, 1.0, 0.0, 20.0)
      let k0 = 6.283185307 /. 20.0
      let (_, open_a) = W.sample(f, 40, 5)
      let (mid_p, mid_a) = W.sample(f, 40, 30)
      let (_, tip_a) = W.sample(f, 40, 21)
      let (_, wall_a) = W.sample(f, 30, 30)
      Test.assert_true(wall_a == 0.0, "the wall itself has no sea")
      Test.assert_true(mid_a < 0.6 *. open_a, "straight behind the wall the sea is calm")
      Test.assert_true(mid_a > 0.0, "but not dead: the swell reaches it round the ends")
      Test.assert_true(mid_p > k0 *. 81.0 +. 0.5, "it arrives late, having gone round")
      Test.assert_true(tip_a > mid_a +. 0.05, "toward the ends the shadow fills in")
      let (_, beyond_a) = W.sample(f, 40, 10)
      Test.assert_true(beyond_a > 0.85 *. open_a, "clear of the wall's ends the sea is open")
      let (_, front_a) = W.sample(f, 25, 30)
      Test.assert_true(front_a > 0.85 *. open_a, "in front of the wall the sea is not sheltered")
    end
    test "a reef raises the swell on its face and lowers it behind" do
      let d = grid(100, 10, 4, NativeArray.make_f32(1000, 0.0), 0)
      -- a long, low groundswell: 40 m crests half a metre high
      let f = W.solve_sea(d, 100, 10, 0.0, 0.0, 2.0, 1.0, 0.0, 40.0, 0.6)
      let (_, open_a) = W.sample(f, 10, 5)
      let (_, face_a) = W.sample(f, 40, 5)
      let (_, top_a) = W.sample(f, 44, 5)
      let (_, behind_a) = W.sample(f, 65, 5)
      Test.assert_true(face_a > open_a, "the swell steepens and grows as it climbs the reef's face")
      Test.assert_true(top_a < face_a, "on the reef's top it breaks")
      Test.assert_true(behind_a < 0.8 *. open_a, "behind the reef, in deep water again, the sea is lower")
      Test.assert_true(behind_a > 0.3, "but a broken swell still comes over")
    end
    test "a sea high enough breaks on a shoal it would roll over were it low" do
      let d = grid(100, 10, 4, NativeArray.make_f32(1000, 0.0), 0)
      let low = W.solve_sea(d, 100, 10, 0.0, 0.0, 2.0, 1.0, 0.0, 40.0, 0.1)
      let high = W.solve_sea(d, 100, 10, 0.0, 0.0, 2.0, 1.0, 0.0, 40.0, 2.0)
      let (_, low_behind) = W.sample(low, 65, 5)
      let (_, high_behind) = W.sample(high, 65, 5)
      Test.assert_true(high_behind < low_behind, "the higher sea loses more over the reef")
    end
  end

  -- reference values: worked by hand from sv_set_sea's table (python, doubles)
  pfn near(a : Float, b : Float, tol : Float) : Bool do Math.abs(a -. b) < tol end
  describe "Waves sea surface" do
    test "sea_state mirrors sv_set_sea's spectrum" do
      let s = W.sea_state(2.0, 0.0, 1.0, 0.0)
      let (kx0, kz0, w0, a0) = W.wave(s, 0)
      -- 29.9 m swell: 2 pi / 29.9 a metre, snapped to 9 cycles across 256 m
      Test.assert_true(near(kx0, 0.2208932, 1.0e-5) && near(kz0, 0.0, 1.0e-9), "the swell's wavevector, snapped")
      Test.assert_true(near(w0, 1.4720607, 1.0e-5) && near(a0, 0.5, 1.0e-7), "its speed sqrt(g k) and share")
      let (kx4, kz4, w4, a4) = W.wave(s, 4)
      Test.assert_true(near(kx4, 0.6135923, 1.0e-5) && near(kz4, -0.4663302, 1.0e-5) && near(w4, 2.7496264, 1.0e-4) && near(a4, 0.1, 1.0e-7), "a chop wave, 0.66 rad off the wind")
      let (kx8, kz8, _, a8) = W.wave(s, 8)
      Test.assert_true(near(kx8, 1.3253594, 1.0e-5) && near(kz8, 0.4908739, 1.0e-5) && near(a8, 0.03, 1.0e-7), "a ripple")
      let t = W.sea_state(0.3, -0.8, 2.0, 0.0)
      let (tx, tz, tw, _) = W.wave(t, 0)
      Test.assert_true(near(tx, 0.0490874, 1.0e-5) && near(tz, -0.0981748, 1.0e-5) && near(tw, 1.0376764, 1.0e-4), "the swell clamped to 60 m, turned with the wind")
      let calm = W.sea_state(1.0, 0.0, 0.05, 0.0)
      let (cx, _, _, _) = W.wave(calm, 0)
      Test.assert_true(near(cx, 1.0553788, 1.0e-4), "a calm sea's swell kept to 6 m: 43 cycles across 256 m")
    end
    test "surface sums the nine waves as the shader does" do
      let s = W.sea_state(1.0, 0.0, 1.0, 0.0)
      Test.assert_true(near(W.surface(s, None, 0.0, 0.0, 0.0), -0.0043529, 1.0e-4), "at the origin at t 0, chop 0")
      let sharp = W.sea_state(1.0, 0.0, 1.0, 1.0)
      Test.assert_true(near(W.surface(sharp, None, 3.0, -2.0, 1.5), -0.6217198, 1.0e-4), "sharpened crests at (3, -2), t 1.5")
      let u = W.sea_state(0.3, -0.8, 2.0, 0.4)
      Test.assert_true(near(W.surface(u, None, 10.0, 20.0, 3.0), 0.5728290, 1.0e-4), "another wind, chop 0.4")
    end
    test "height scales the surface by the shader's amplitude" do
      let s = W.sea_state(1.0, 0.0, 1.0, 0.0)
      Test.assert_true(near(W.patch(0.0, 0.0), 0.7481057, 1.0e-4) && near(W.patch(100.0, -50.0), 0.7094274, 1.0e-4), "the swell patches")
      Test.assert_true(near(W.height(s, None, 0.6, 100.0, -50.0, 2.0), 0.1513605, 1.0e-4), "half a metre's amplitude, sheltered to 0.6, patched")
      let flat = W.sea_state(1.0, 0.0, 0.0, 0.0)
      Test.assert_true(W.height(flat, None, 1.0, 12.0, 7.0, 3.0) == 0.0, "no sea state is a flat sea")
    end
    test "slope and normal follow the height" do
      let s = W.sea_state(1.0, 0.0, 1.0, 0.0)
      -- with no chop the surface is sum a_i sin(k_i . p - w_i t + 2.399 i): its gradient by hand, times the amplitude, plus the patches' gradient
      let (sx, sz) = W.slope(s, None, 1.0, 40.0, 25.0, 1.0)
      let e = 0.001
      let hx = (W.height(s, None, 1.0, 40.0 +. e, 25.0, 1.0) -. W.height(s, None, 1.0, 40.0 -. e, 25.0, 1.0)) /. (2.0 *. e)
      let hz = (W.height(s, None, 1.0, 40.0, 25.0 +. e, 1.0) -. W.height(s, None, 1.0, 40.0, 25.0 -. e, 1.0)) /. (2.0 *. e)
      Test.assert_true(near(sx, hx, 0.01) && near(sz, hz, 0.01), "the slope is the height's gradient")
      let (nx, ny, nz) = W.normal_at(s, None, 1.0, 40.0, 25.0, 1.0)
      Test.assert_true(near(nx *. nx +. ny *. ny +. nz *. nz, 1.0, 1.0e-9) && ny > 0.0, "a unit normal, up")
      Test.assert_true(near(0.0 -. nx /. ny, sx, 1.0e-9), "tilted along the slope")
    end
    test "with a refracted swell: open sea like the plane waves, continuous across the field's edge" do
      let d = grid(60, 60, 1, NativeArray.make_f32(3600, 0.0), 0)
      let s = W.sea_state(1.0, 0.0, 1.0, 0.3)
      let f = W.solve(d, 60, 60, 0.0, 0.0, 2.0, 1.0, 0.0, W.swell_wavelength(1.0))
      -- in open water inside a field the swell is the plane wave it fades to outside one
      let open = NativeArray.make_f32(3600, 20.0)
      let here = W.solve(open, 60, 60, 0.0, 0.0, 2.0, 1.0, 0.0, W.swell_wavelength(1.0))
      let away = W.solve(open, 60, 60, -10000.0, 0.0, 2.0, 1.0, 0.0, W.swell_wavelength(1.0))
      Test.assert_true(near(W.surface(s, Some(here), 60.0, 61.0, 2.0), W.surface(s, Some(away), 60.0, 61.0, 2.0), 0.03), "open water in the field: the plane swell the solve began from")
      Test.assert_true(near(W.surface(s, Some(here), 70.0, 33.0, 0.7), W.surface(s, Some(away), 70.0, 33.0, 0.7), 0.03), "and at another place and time")
      -- walking across the field's west edge (x = 0) and its north edge (z = 0) in 5 cm steps, no jumps
      Test.assert_true(smooth_walk(s, f, -20.0, 30.0, 0.05, 0.0, 800, 0.03), "across the west edge")
      Test.assert_true(smooth_walk(s, f, 60.0, -20.0, 0.0, 0.05, 800, 0.03), "across the north edge")
      Test.assert_true(smooth_walk(s, f, 100.0, 60.0, 0.05, 0.0, 800, 0.03), "across the east edge, in the island's lee")
    end
  end
  pfn smooth_walk(s : Strata.Waves.SeaWaves, f : Strata.Waves.Swell, x : Float, z : Float, dx : Float, dz : Float, n : Int, tol : Float) : Bool do
    if n <= 0 do true else
      let a = W.surface(s, Some(f), x, z, 1.25)
      let b = W.surface(s, Some(f), x +. dx, z +. dz, 1.25)
      if Math.abs(b -. a) > tol do false else smooth_walk(s, f, x +. dx, z +. dz, dx, dz, n - 1, tol) end
    end
  end
end
