-- Unit tests for the math and buffer stdlib candidates.
mod Strata.Test.Math do

  import Test
  alias Strata.Math.Vec3 as V
  alias Strata.Math.Mat4 as M

  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.0001 end

  describe "Vec3" do
    test "cross of x and y is z" do
      let c = V.cross(V.new(1.0, 0.0, 0.0), V.new(0.0, 1.0, 0.0))
      Test.assert_true(near(V.z(c), 1.0), "z component")
      Test.assert_true(near(V.x(c), 0.0) && near(V.y(c), 0.0), "x/y components")
    end
    test "normalize gives unit length" do
      Test.assert_true(near(V.length(V.normalize(V.new(3.0, 4.0, 0.0))), 1.0), "unit")
    end
  end

  describe "Mat4" do
    test "identity times identity is identity" do
      let m = M.mul(M.identity(), M.identity())
      Test.assert_true(near(M.get(m, 0, 0), 1.0) && near(M.get(m, 1, 0), 0.0) && near(M.get(m, 3, 3), 1.0), "diag")
    end
    test "invert of a look_at times perspective, times the matrix, is the identity" do
      let vp = M.mul(M.perspective(1.0, 1.5, 0.1, 100.0), M.look_at(V.new(3.0, 5.0, 7.0), V.new(0.0, 0.0, 0.0), V.new(0.0, 1.0, 0.0)))
      match M.invert(vp) do
        Some(inv) ->
          let p = M.mul(inv, vp)
          let id = M.identity()
          Test.assert_true(List.all(List.range(0, 16), fn i -> Math.abs(NativeArray.get_float(p, i) -. NativeArray.get_float(id, i)) < 0.00001), "inverse times matrix")
        None -> Test.fail("no inverse")
      end
    end
    test "invert of a singular matrix is None" do
      Test.assert_true(Option.is_none(M.invert(NativeArray.make_float(16, 0.0))), "all zero")
    end
    test "the centre pixel's ray runs along the camera's view" do
      let vp = M.mul(M.perspective(Math.pi() /. 3.0, 800.0 /. 600.0, 0.1, 100.0), M.look_at(V.new(0.0, 10.0, 10.0), V.new(0.0, 0.0, 0.0), V.new(0.0, 1.0, 0.0)))
      match Strata.Math.Ray.from_screen(vp, 400.0, 300.0, 800.0, 600.0) do
        Some(((ox, oy, oz), (dx, dy, dz))) ->
          let k = 1.0 /. Math.sqrt(200.0)
          Test.assert_true(Math.abs(dx) < 0.0001 && Math.abs(dy +. 10.0 *. k) < 0.0001 && Math.abs(dz +. 10.0 *. k) < 0.0001, "direction")
          Test.assert_true(Math.sqrt(ox *. ox +. (oy -. 10.0) *. (oy -. 10.0) +. (oz -. 10.0) *. (oz -. 10.0)) < 0.2, "origin near the eye")
        None -> Test.fail("no ray")
      end
    end
    test "the top-left pixel's ray leans up and left" do
      let vp = M.mul(M.perspective(Math.pi() /. 3.0, 800.0 /. 600.0, 0.1, 100.0), M.look_at(V.new(0.0, 10.0, 10.0), V.new(0.0, 0.0, 0.0), V.new(0.0, 1.0, 0.0)))
      match (Strata.Math.Ray.from_screen(vp, 0.0, 0.0, 800.0, 600.0), Strata.Math.Ray.from_screen(vp, 400.0, 300.0, 800.0, 600.0)) do
        (Some((_, (dx, dy, _))), Some((_, (_, cy, _)))) -> Test.assert_true(dx < 0.0 && dy > cy, "up and left")
        _ -> Test.fail("no ray")
      end
    end
    test "translation moves a point" do
      -- accessors, not a constructor pattern: 3-segment constructor paths do not parse (GAPS.md G24)
      let r = M.transform_point(M.translation(V.new(1.0, 2.0, 3.0)), V.new(1.0, 1.0, 1.0))
      Test.assert_true(near(M.x4(r), 2.0) && near(M.y4(r), 3.0) && near(M.z4(r), 4.0) && near(M.w4(r), 1.0), "translated")
    end
    test "look_at maps the target to the view axis" do
      let view = M.look_at(V.new(-12.0, 80.0, -12.0), V.new(8.0, 64.0, 8.0), V.new(0.0, 1.0, 0.0))
      let r = M.transform_point(view, V.new(8.0, 64.0, 8.0))
      Test.assert_true(near(M.x4(r), 0.0) && near(M.y4(r), 0.0) && M.z4(r) < 0.0, "target on -z axis")
    end
    test "perspective puts a point at -near on the near plane" do
      let p = M.perspective(1.0, 1.0, 0.1, 100.0)
      let r = M.transform_point(p, V.new(0.0, 0.0, -0.1))
      Test.assert_true(near(M.z4(r) /. M.w4(r), -1.0), "near plane -> -1")
    end
  end

end
