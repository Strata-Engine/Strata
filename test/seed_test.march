-- Seeds: derived seeds differ, per-cell streams are spread and do not repeat.
mod Strata.Test.Seed do

  import Test
  alias Strata.Seed as S

  -- count how many of n cells fall into each tenth of [0, 1): bins is a 10-slot array
  pfn bin_go(bins : NativeIntArr, i : Int, n : Int) : NativeIntArr do
    if i >= n do bins
    else
      let u = S.unit(S.cell(7, 3, i % 317 - 100, i / 317 - 50, i % 13))
      let b = float_to_int(u *. 10.0)
      bin_go(NativeArray.set_int(bins, b, NativeArray.get_int(bins, b) + 1), i + 1, n)
    end
  end

  pfn bins_ok(bins : NativeIntArr, i : Int, n : Int) : Bool do
    if i >= 10 do true
    else
      let want = n / 10
      let c = NativeArray.get_int(bins, i)
      if c * 100 >= want * 98 && c * 100 <= want * 102 do bins_ok(bins, i + 1, n) else false end
    end
  end

  pfn in_unit_go(i : Int) : Bool do
    if i >= 5000 do true
    else
      let u = S.unit(S.cell(-9, 4, i - 2500, i * 3, -i))
      if u >= 0.0 && u < 1.0 do in_unit_go(i + 1) else false end
    end
  end

  -- the first n values of a stream from h, written into vals
  pfn fill_go(vals : NativeIntArr, h : Int, i : Int, n : Int) : NativeIntArr do
    if i >= n do vals else fill_go(NativeArray.set_int(vals, i, h), S.next(h), i + 1, n) end
  end

  -- true when vals[i] differs from every later value
  pfn clear_of(vals : NativeIntArr, i : Int, j : Int, n : Int) : Bool do
    if j >= n do true
    else if NativeArray.get_int(vals, i) == NativeArray.get_int(vals, j) do false
    else clear_of(vals, i, j + 1, n) end end
  end
  pfn distinct_go(vals : NativeIntArr, i : Int, n : Int) : Bool do
    if i >= n do true else if clear_of(vals, i, i + 1, n) do distinct_go(vals, i + 1, n) else false end end
  end

  describe "Seed" do
    test "derived seeds with different salts differ, and the same salt repeats" do
      Test.assert_true(S.mix(7, 1) != S.mix(7, 2), "salts")
      Test.assert_true(S.mix(7, 1) != S.mix(8, 1), "seeds")
      Test.assert_true(S.mix(7, 1) == S.mix(7, 1), "repeat")
    end
    test "cells either side of the origin differ on every axis" do
      Test.assert_true(S.cell(7, 1, -1, 0, 0) != S.cell(7, 1, 1, 0, 0), "x")
      Test.assert_true(S.cell(7, 1, -1, 0, 0) != S.cell(7, 1, 0, 0, -1), "x against z")
      Test.assert_true(S.cell(7, 1, 0, -1, 0) != S.cell(7, 1, 0, 1, 0), "y")
      Test.assert_true(S.cell(7, 1, 0, 0, -1) != S.cell(7, 1, 0, 0, 1), "z")
    end
    test "unit is in [0, 1) and spreads evenly over 100 000 cells" do
      Test.assert_true(in_unit_go(0), "range")
      Test.assert_true(bins_ok(bin_go(NativeArray.make_int(10, 0), 0, 100000), 0, 100000), "ten bins each within 2% of a tenth")
    end
    test "a stream of 1000 values has no repeats" do
      Test.assert_true(distinct_go(fill_go(NativeArray.make_int(1000, 0), S.cell(7, 1, 0, 0, 0), 0, 1000), 0, 1000), "no value twice")
    end
  end
end
