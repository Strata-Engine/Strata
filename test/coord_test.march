-- Coordinates: chunk and local split (floor division), flat index, scale.
mod Strata.Test.Coord do

  needs IO.Clock      -- Check.all seeds from the clock
  needs IO.Process    -- and reads MARCH_PROP_SEED
  import Test
  alias Strata.Coord as Co

  describe "Coord.chunk_of / local_of" do
    test "split by floor division, so negatives land in negative chunks" do
      Test.assert_eq_int(Co.chunk_of(-1), -1, "voxel -1 is in chunk -1")
      Test.assert_eq_int(Co.local_of(-1), 31, "at local 31")
      Test.assert_eq_int(Co.chunk_of(31), 0, "31 is the last of chunk 0")
      Test.assert_eq_int(Co.chunk_of(32), 1, "32 opens chunk 1")
      Test.assert_eq_int(Co.chunk_of(-32), -1, "-32 opens chunk -1")
      Test.assert_eq_int(Co.chunk_of(-33), -2, "-33 is in chunk -2")
      Test.assert_eq_int(Co.local_of(-33), 31, "at local 31")
      Test.assert_eq_int(Co.local_of(0), 0, "origin")
    end

    test "chunk * 32 + local rebuilds any voxel coordinate" do
      Check.all(Gen.int(-100000, 100000), fn v -> Co.chunk_of(v) * 32 + Co.local_of(v) == v)
    end
  end

  describe "Coord.index" do
    test "is x + 32 * (z + 32 * y)" do
      Test.assert_eq_int(Co.index(0, 0, 0), 0, "origin")
      Test.assert_eq_int(Co.index(1, 0, 0), 1, "x is the fastest axis")
      Test.assert_eq_int(Co.index(0, 0, 1), 32, "then z")
      Test.assert_eq_int(Co.index(0, 1, 0), 1024, "then y")
      Test.assert_eq_int(Co.index(31, 31, 31), 32767, "the last voxel")
      Test.assert_eq_int(Co.side(), 32, "side")
      Test.assert_eq_int(Co.volume(), 32768, "volume")
    end
  end

  describe "Coord.Key" do
    test "names a chunk; level is 0" do
      let k = Co.key(3, -4, 5)
      Test.assert_eq_int(Co.kx(k), 3, "x")
      Test.assert_eq_int(Co.ky(k), -4, "y")
      Test.assert_eq_int(Co.kz(k), 5, "z")
      Test.assert_eq_int(Co.level(k), 0, "level")
    end
    test "key_of_voxel floors each axis" do
      let k = Co.key_of_voxel(-1, 32, 63)
      Test.assert_true(Co.key_eq(k, Co.key(-1, 1, 1)), "(-1, 32, 63) is in chunk (-1, 1, 1)")
    end
    test "equality and hash tell sign and axis apart" do
      Test.assert_true(Co.key_eq(Co.key(1, 2, 3), Co.key(1, 2, 3)), "equal")
      Test.assert_false(Co.key_eq(Co.key(1, 2, 3), Co.key(-1, 2, 3)), "sign differs")
      Test.assert_false(Co.key_eq(Co.key(1, 2, 3), Co.key(3, 2, 1)), "axes differ")
      Test.assert_true(Co.key_hash(Co.key(1, 2, 3)) == Co.key_hash(Co.key(1, 2, 3)), "hash is a function of the key")
      Test.assert_true(Co.key_hash(Co.key(1, 2, 3)) != Co.key_hash(Co.key(3, 2, 1)), "and spreads axes")
      Test.assert_true(Co.key_hash(Co.key(1, 0, 0)) != Co.key_hash(Co.key(-1, 0, 0)), "and signs")
    end
  end

  describe "Coord scale" do
    test "to_voxel floors metres / scale" do
      Test.assert_eq_int(Co.to_voxel(0.1, -0.05), -1, "just below zero is voxel -1")
      Test.assert_eq_int(Co.to_voxel(1.0, 2.99), 2, "2.99 m at 1 m voxels")
      Test.assert_eq_int(Co.to_voxel(0.5, 2.0), 4, "2 m at half-metre voxels")
    end
    test "to_metres is the voxel's low corner" do
      Test.assert_true(Math.abs(Co.to_metres(0.5, 4) -. 2.0) < 0.000001, "voxel 4 at 0.5 m")
      Test.assert_true(Math.abs(Co.to_metres(0.1, -1) +. 0.1) < 0.000001, "voxel -1 at 0.1 m")
    end
  end

  describe "Coord levels" do
    test "key_at carries a level; parent floors each axis by 2, negatives included" do
      let k = Co.key_at(3, -4, 5, 2)
      Test.assert_eq_int(Co.level(k), 2, "level")
      let p = Co.parent(Co.key_at(-1, 3, -4, 0))
      Test.assert_true(Co.key_eq(p, Co.key_at(-1, 1, -2, 1)), "(-1, 3, -4) at 0 is in (-1, 1, -2) at 1")
      Test.assert_true(Co.key_eq(Co.parent(Co.key_at(-3, 0, 1, 1)), Co.key_at(-2, 0, 0, 2)), "-3 / 2 floors to -2")
    end
    test "children are the eight keys a level down whose parent it is" do
      let k = Co.key_at(-1, 2, 0, 1)
      let cs = Co.children(k)
      Test.assert_eq_int(List.length(cs), 8, "eight")
      Test.assert_true(List.all(cs, fn c -> Co.key_eq(Co.parent(c), k) && Co.level(c) == 0), "each a child")
      Test.assert_true(List.any(cs, fn c -> Co.key_eq(c, Co.key_at(-2, 4, 0, 0))), "the low corner")
      Test.assert_true(List.any(cs, fn c -> Co.key_eq(c, Co.key_at(-1, 5, 1, 0))), "the high corner")
      Test.assert_eq_int(List.length(Co.children(Co.key(0, 0, 0))), 0, "level 0 has none")
    end
  end
end
