-- Quad packing: every field round-trips at its extremes, also through an i32 array.
mod Strata.Test.Quad do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  import Test
  alias Strata.Quad as Q

  describe "Quad.pack0" do
    test "round-trips position, size and face at their extremes" do
      let lo = Q.pack0(0, 0, 0, 1, 1, 0)
      Test.assert_eq_int(Q.x_of(lo), 0, "x 0")
      Test.assert_eq_int(Q.y_of(lo), 0, "y 0")
      Test.assert_eq_int(Q.z_of(lo), 0, "z 0")
      Test.assert_eq_int(Q.w_of(lo), 1, "w 1")
      Test.assert_eq_int(Q.h_of(lo), 1, "h 1")
      Test.assert_eq_int(Q.face_of(lo), 0, "face 0")
      let hi = Q.pack0(31, 31, 31, 32, 32, 5)
      Test.assert_eq_int(Q.x_of(hi), 31, "x 31")
      Test.assert_eq_int(Q.y_of(hi), 31, "y 31")
      Test.assert_eq_int(Q.z_of(hi), 31, "z 31")
      Test.assert_eq_int(Q.w_of(hi), 32, "w 32")
      Test.assert_eq_int(Q.h_of(hi), 32, "h 32")
      Test.assert_eq_int(Q.face_of(hi), 5, "face 5")
    end
    test "keeps the axes apart" do
      let q = Q.pack0(1, 2, 3, 4, 5, 2)
      Test.assert_eq_int(Q.x_of(q), 1, "x")
      Test.assert_eq_int(Q.y_of(q), 2, "y")
      Test.assert_eq_int(Q.z_of(q), 3, "z")
      Test.assert_eq_int(Q.w_of(q), 4, "w")
      Test.assert_eq_int(Q.h_of(q), 5, "h")
      Test.assert_eq_int(Q.face_of(q), 2, "face")
    end
  end

  describe "Quad.pack1" do
    test "round-trips texture, corner shading and flags" do
      let q = Q.pack1(65535, Q.ao4(3, 0, 1, 2), 255)
      Test.assert_eq_int(Q.tex_of(q), 65535, "tex at its ceiling")
      Test.assert_eq_int(Q.ao_corner(Q.ao_of(q), 0), 3, "corner 0")
      Test.assert_eq_int(Q.ao_corner(Q.ao_of(q), 1), 0, "corner 1")
      Test.assert_eq_int(Q.ao_corner(Q.ao_of(q), 2), 1, "corner 2")
      Test.assert_eq_int(Q.ao_corner(Q.ao_of(q), 3), 2, "corner 3")
      Test.assert_eq_int(Q.flags_of(q), 255, "flags at their ceiling")
      Test.assert_eq_int(Q.tex_of(Q.pack1(0, 0, 0)), 0, "zero")
    end
    test "survives a NativeI32Arr, whose entries read back sign-extended" do
      let w1 = Q.pack1(65535, 255, 255)
      let a = NativeArray.set_i32(NativeArray.make_i32(2, 0), 1, w1)
      let back = NativeArray.get_i32(a, 1)
      Test.assert_eq_int(Q.tex_of(back), 65535, "tex")
      Test.assert_eq_int(Q.ao_of(back), 255, "ao")
      Test.assert_eq_int(Q.flags_of(back), 255, "flags")
    end
  end

  describe "Quad instances" do
    test "an instance carries its cell, its model (-1 for a cross) and its block id" do
      let i0 = Q.pack_instance0(31, 0, 17, -1)
      Test.assert_eq_int(Q.x_of(i0), 31, "x")
      Test.assert_eq_int(Q.y_of(i0), 0, "y")
      Test.assert_eq_int(Q.z_of(i0), 17, "z")
      Test.assert_eq_int(Q.instance_model(i0), -1, "a cross")
      Test.assert_eq_int(Q.instance_model(Q.pack_instance0(1, 2, 3, 40)), 40, "model 40")
      Test.assert_eq_int(Q.instance_id(Q.pack_instance1(60001)), 60001, "block id")
    end
  end
end
