-- The greedy mesher, checked case by case and against a naive per-face oracle.
mod Strata.Test.Mesh do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias Strata.Chunk as C
  alias Strata.Blocks as B
  alias Strata.Mesh as Ms
  alias Strata.Quad as Q

  pfn add(r : Strata.Blocks.Registry, d : Strata.Blocks.Def) : Strata.Blocks.Registry do
    match B.register(r, d) do
      Ok((r2, _)) -> r2
      Err(_) -> r
    end
  end

  -- 1 stone: opaque cube.  2 leaf: see-through cube on the cutout layer.
  -- 3 water, 4 glass: see-through cubes on the translucent layer.
  -- 5 plant: a cross.  6 lamp: a model.  Texture id = block id * 10.
  pfn reg() : Strata.Blocks.Registry do
    let stone = B.with_faces(B.def(), 10, 10, 10)
    let leaf = B.with_faces(B.with_layer(B.with_opacity(B.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Cutout), 20, 20, 20)
    let water = B.with_faces(B.with_collide(B.with_layer(B.with_opacity(B.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false), 30, 30, 30)
    let glass = B.with_faces(B.with_layer(B.with_opacity(B.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), 40, 40, 40)
    let plant = B.with_collide(B.with_style(B.with_opacity(B.def(), Strata.Blocks.Clear), Strata.Blocks.Cross), false)
    let lamp = B.with_style(B.with_opacity(B.def(), Strata.Blocks.Clear), Strata.Blocks.Model(0))
    add(add(add(add(add(add(B.empty(), stone), leaf), water), glass), plant), lamp)
  end

  pfn air() : Strata.Chunk.Chunk do C.uniform(0) end
  pfn alone(c : Strata.Chunk.Chunk) : Strata.Mesh.Around do
    Ms.around_from(fn (dx, dy, dz) -> if dx == 0 && dy == 0 && dz == 0 do c else C.uniform(0) end)
  end
  pfn total(m : Strata.Mesh.Meshed) : Int do Ms.quad_count_at(m, 0) + Ms.quad_count_at(m, 1) + Ms.quad_count_at(m, 2) end

  -- ── Reading a mesh ───────────────────────────────────────────────────────
  pfn w0_at(m : Strata.Mesh.Meshed, l : Int, k : Int) : Int do NativeArray.get_i32(Ms.quads_at(m, l), 2 * k) end
  pfn w1_at(m : Strata.Mesh.Meshed, l : Int, k : Int) : Int do NativeArray.get_i32(Ms.quads_at(m, l), 2 * k + 1) end

  -- index of the first quad on layer l with face f, or -1
  pfn find_face(m : Strata.Mesh.Meshed, l : Int, f : Int, k : Int) : Int do
    if k >= Ms.quad_count_at(m, l) do -1
    else if Q.face_of(w0_at(m, l, k)) == f do k
    else find_face(m, l, f, k + 1) end end
  end
  pfn count_face(m : Strata.Mesh.Meshed, l : Int, f : Int, k : Int, acc : Int) : Int do
    if k >= Ms.quad_count_at(m, l) do acc
    else count_face(m, l, f, k + 1, if Q.face_of(w0_at(m, l, k)) == f do acc + 1 else acc end) end
  end
  pfn all_unit_lit(m : Strata.Mesh.Meshed, k : Int) : Bool do
    if k >= Ms.quad_count_at(m, 0) do true
    else if Q.w_of(w0_at(m, 0, k)) == 1 && Q.h_of(w0_at(m, 0, k)) == 1 && Q.ao_of(w1_at(m, 0, k)) == 255 do all_unit_lit(m, k + 1)
    else false end end
  end

  -- ── The oracle: the face rule applied voxel by voxel ─────────────────────
  pfn nx(f : Int) : Int do if f == 2 do 1 else if f == 3 do -1 else 0 end end end
  pfn ny(f : Int) : Int do if f == 0 do 1 else if f == 1 do -1 else 0 end end end
  pfn nz(f : Int) : Int do if f == 4 do 1 else if f == 5 do -1 else 0 end end end
  -- in-plane axes: +-y (x, z), +-x (z, y), +-z (x, y)
  pfn ux(f : Int) : Int do if f == 2 || f == 3 do 0 else 1 end end
  pfn uz(f : Int) : Int do if f == 2 || f == 3 do 1 else 0 end end
  pfn vy(f : Int) : Int do if f < 2 do 0 else 1 end end
  pfn vz(f : Int) : Int do if f < 2 do 1 else 0 end end

  pfn solid(r : Strata.Blocks.Registry, a : Strata.Mesh.Around, x : Int, y : Int, z : Int) : Bool do
    B.is_solid_opaque(r, Ms.around_get(a, x, y, z))
  end

  pfn corner(r : Strata.Blocks.Registry, a : Strata.Mesh.Around, fx : Int, fy : Int, fz : Int, f : Int, cu : Int, cv : Int) : Int do
    let du = if cu == 1 do 1 else -1 end
    let dv = if cv == 1 do 1 else -1 end
    let s1 = solid(r, a, fx + du * ux(f), fy, fz + du * uz(f))
    let s2 = solid(r, a, fx, fy + dv * vy(f), fz + dv * vz(f))
    let cn = solid(r, a, fx + du * ux(f), fy + dv * vy(f), fz + du * uz(f) + dv * vz(f))
    if s1 && s2 do 0
    else 3 - ((if s1 do 1 else 0 end) + (if s2 do 1 else 0 end) + (if cn do 1 else 0 end)) end
  end

  -- -1 for no face, else layer * 1000 + ao byte
  pfn oracle(r : Strata.Blocks.Registry, a : Strata.Mesh.Around, x : Int, y : Int, z : Int, f : Int) : Int do
    let id = Ms.around_get(a, x, y, z)
    let fx = x + nx(f)
    let fy = y + ny(f)
    let fz = z + nz(f)
    let nb = Ms.around_get(a, fx, fy, fz)
    if B.style_index(r, id) != 0 || B.is_solid_opaque(r, nb) || nb == id do -1
    else
      let ao = corner(r, a, fx, fy, fz, f, 0, 0) + 4 * corner(r, a, fx, fy, fz, f, 1, 0) + 16 * corner(r, a, fx, fy, fz, f, 0, 1) + 64 * corner(r, a, fx, fy, fz, f, 1, 1)
      B.layer_index(r, id) * 1000 + ao
    end
  end

  -- ── Rasterising the greedy quads back to unit faces ──────────────────────
  -- cover[(l * 6 + f) * 32768 + voxel index] = 0 uncovered, 1000 + ao covered
  -- once, -1 covered twice or outside the chunk.
  pfn mark_row(cov : NativeIntArr, base : Int, x : Int, y : Int, z : Int, f : Int, i : Int, w : Int, ao : Int) : NativeIntArr do
    if i >= w do cov
    else
      let px = x + i * ux(f)
      let pz = z + i * uz(f)
      if px < 0 || px > 31 || y < 0 || y > 31 || pz < 0 || pz > 31 do NativeArray.set_int(cov, 0, -1)
      else
        let at = base + px + 32 * (pz + 32 * y)
        let v = if NativeArray.get_int(cov, at) == 0 do 1000 + ao else -1 end
        mark_row(NativeArray.set_int(cov, at, v), base, x, y, z, f, i + 1, w, ao)
      end
    end
  end
  pfn mark_quad(cov : NativeIntArr, base : Int, x : Int, y : Int, z : Int, f : Int, j : Int, w : Int, h : Int, ao : Int) : NativeIntArr do
    if j >= h do cov
    else mark_quad(mark_row(cov, base, x, y + j * vy(f), z + j * vz(f), f, 0, w, ao), base, x, y, z, f, j + 1, w, h, ao) end
  end
  pfn mark_layer(cov : NativeIntArr, m : Strata.Mesh.Meshed, l : Int, k : Int) : NativeIntArr do
    if k >= Ms.quad_count_at(m, l) do cov
    else
      let w0 = w0_at(m, l, k)
      let f = Q.face_of(w0)
      let c2 = mark_quad(cov, (l * 6 + f) * 32768, Q.x_of(w0), Q.y_of(w0), Q.z_of(w0), f, 0, Q.w_of(w0), Q.h_of(w0), Q.ao_of(w1_at(m, l, k)))
      mark_layer(c2, m, l, k + 1)
    end
  end
  pfn raster(m : Strata.Mesh.Meshed) : NativeIntArr do
    mark_layer(mark_layer(mark_layer(NativeArray.make_int(Strata.Size.of(3 * 6 * 32768), 0), m, 0, 0), m, 1, 0), m, 2, 0)
  end

  -- does the raster hold exactly the oracle's faces, with the oracle's shading?
  pfn same_at(r : Strata.Blocks.Registry, a : Strata.Mesh.Around, cov : NativeIntArr, i : Int, f : Int) : Bool do
    let want = oracle(r, a, i % 32, i / 1024, (i / 32) % 32, f)
    let wl = if want < 0 do -1 else want / 1000 end
    let wv = if want < 0 do 0 else 1000 + want % 1000 end
    let g0 = NativeArray.get_int(cov, (0 * 6 + f) * 32768 + i)
    let g1 = NativeArray.get_int(cov, (1 * 6 + f) * 32768 + i)
    let g2 = NativeArray.get_int(cov, (2 * 6 + f) * 32768 + i)
    g0 == (if wl == 0 do wv else 0 end) && g1 == (if wl == 1 do wv else 0 end) && g2 == (if wl == 2 do wv else 0 end)
  end
  pfn same_go(r : Strata.Blocks.Registry, a : Strata.Mesh.Around, cov : NativeIntArr, i : Int, f : Int) : Bool do
    if i >= 32768 do true
    else if f >= 6 do same_go(r, a, cov, i + 1, 0)
    else if same_at(r, a, cov, i, f) do same_go(r, a, cov, i, f + 1)
    else false end end end
  end
  pfn matches_oracle(r : Strata.Blocks.Registry, a : Strata.Mesh.Around) : Bool do
    same_go(r, a, raster(Ms.build(r, a)), 0, 0)
  end

  -- every texture id is the block's (id * 10 here), read back through the quad
  pfn tex_ok(r : Strata.Blocks.Registry, a : Strata.Mesh.Around, m : Strata.Mesh.Meshed, l : Int, k : Int) : Bool do
    if k >= Ms.quad_count_at(m, l) do true
    else
      let w0 = w0_at(m, l, k)
      let id = Ms.around_get(a, Q.x_of(w0), Q.y_of(w0), Q.z_of(w0))
      if Q.tex_of(w1_at(m, l, k)) == id * 10 do tex_ok(r, a, m, l, k + 1) else false end
    end
  end

  -- ── Chunks for the tests ─────────────────────────────────────────────────
  -- a deterministic scatter: about half air, the rest every kind of block,
  -- with an unregistered id thrown in
  pfn pick(n : Int) : Int do
    let k = n % 16
    if k < 7 do 0 else if k < 11 do 1 else if k == 11 do 2 else if k == 12 do 3 else if k == 13 do 4 else if k == 14 do 5 else 60000 end end end end end end
  end
  pfn lcg(s : Int) : Int do int_and(s * 1103515245 + 12345, 2147483647) end
  pfn noise_go(a : NativeI32Arr, i : Int, s : Int) : NativeI32Arr do
    if i >= 32768 do a else noise_go(NativeArray.set_i32(a, i, pick(s / 65536)), i + 1, lcg(s)) end
  end
  pfn noise(seed : Int) : Strata.Chunk.Chunk do C.from_flat(noise_go(NativeArray.make_i32(32768, 0), 0, lcg(seed + 77))) end
  pfn noise_around(seed : Int) : Strata.Mesh.Around do
    Ms.around_from(fn (dx, dy, dz) -> noise(seed + (dx + 1) + 3 * (dy + 1) + 9 * (dz + 1)))
  end

  pfn edits(c : Strata.Chunk.Chunk, es : List((Int, Int))) : Strata.Chunk.Chunk do
    match es do
      Nil -> c
      Cons((i, id), t) -> edits(C.set_idx(c, C.index(i), id), t)
    end
  end

  describe "Mesh.build, case by case" do
    test "one block alone in air is six unit quads, fully lit" do
      let m = Ms.build(reg(), alone(C.set(air(), 4, 5, 6, 1)))
      Test.assert_eq_int(Ms.quad_count_at(m, 0), 6, "six faces on the opaque layer")
      Test.assert_eq_int(total(m), 6, "and nowhere else")
      Test.assert_true(all_unit_lit(m, 0), "each 1 by 1 with every corner at 3")
      Test.assert_eq_int(Q.x_of(w0_at(m, 0, 0)), 4, "at the block: x")
      Test.assert_eq_int(Q.y_of(w0_at(m, 0, 0)), 5, "y")
      Test.assert_eq_int(Q.z_of(w0_at(m, 0, 0)), 6, "z")
      Test.assert_eq_int(Q.tex_of(w1_at(m, 0, 0)), 10, "carrying the block's texture")
    end

    test "a floor one block thick merges its top and its bottom into one quad each" do
      let m = Ms.build(reg(), alone(C.fill_box(air(), 0, 3, 0, 31, 3, 31, 1)))
      Test.assert_eq_int(count_face(m, 0, 0, 0, 0), 1, "one top quad")
      Test.assert_eq_int(count_face(m, 0, 1, 0, 0), 1, "one bottom quad")
      let t = find_face(m, 0, 0, 0)
      Test.assert_eq_int(Q.w_of(w0_at(m, 0, t)), 32, "the top is 32 wide")
      Test.assert_eq_int(Q.h_of(w0_at(m, 0, t)), 32, "and 32 deep")
      Test.assert_eq_int(Q.y_of(w0_at(m, 0, t)), 3, "at the floor's height")
      Test.assert_eq_int(count_face(m, 0, 2, 0, 0), 1, "each side is one strip")
    end

    test "stone buried in stone has no faces" do
      let m = Ms.build(reg(), Ms.around_from(fn (dx, dy, dz) -> C.uniform(1)))
      Test.assert_eq_int(total(m), 0, "nothing to draw")
    end

    test "stone with air above shows exactly one top quad" do
      let m = Ms.build(reg(), Ms.around_from(fn (dx, dy, dz) -> if dy == 1 do C.uniform(0) else C.uniform(1) end))
      Test.assert_eq_int(total(m), 1, "one quad")
      Test.assert_eq_int(Q.face_of(w0_at(m, 0, 0)), 0, "facing up")
      Test.assert_eq_int(Q.w_of(w0_at(m, 0, 0)) * Q.h_of(w0_at(m, 0, 0)), 1024, "covering the chunk")
      Test.assert_eq_int(Q.y_of(w0_at(m, 0, 0)), 31, "on the top layer")
    end

    test "an air chunk has no faces whatever surrounds it" do
      let m = Ms.build(reg(), Ms.around_from(fn (dx, dy, dz) -> if dx == 0 && dy == 0 && dz == 0 do C.uniform(0) else C.uniform(1) end))
      Test.assert_eq_int(total(m), 0, "the neighbours draw their own faces")
    end

    test "two see-through blocks of one id share no face; of two ids, a face each" do
      let same = Ms.build(reg(), alone(C.set(C.set(air(), 4, 4, 4, 3), 5, 4, 4, 3)))
      Test.assert_eq_int(Ms.quad_count_at(same, 2), 6, "water beside water: the outside of the pair, merged")
      Test.assert_eq_int(count_face(same, 2, 2, 0, 0), 1, "one +x face, at the end of the pair")
      let mixed = Ms.build(reg(), alone(C.set(C.set(air(), 4, 4, 4, 3), 5, 4, 4, 4)))
      Test.assert_eq_int(count_face(mixed, 2, 2, 0, 0), 2, "water beside glass: both blocks keep their +x face")
      Test.assert_eq_int(count_face(mixed, 2, 3, 0, 0), 2, "and their -x face")
    end

    test "a see-through block does not hide the stone behind it" do
      let m = Ms.build(reg(), alone(C.set(C.set(air(), 4, 4, 4, 1), 5, 4, 4, 4)))
      Test.assert_eq_int(count_face(m, 0, 2, 0, 0), 1, "stone keeps its +x face behind glass")
      Test.assert_eq_int(count_face(m, 2, 3, 0, 0), 0, "glass drops its face against the stone")
    end

    test "layers follow the block" do
      let m = Ms.build(reg(), alone(C.set(C.set(C.set(air(), 1, 1, 1, 1), 5, 5, 5, 2), 9, 9, 9, 3)))
      Test.assert_eq_int(Ms.quad_count_at(m, 0), 6, "stone on the opaque layer")
      Test.assert_eq_int(Ms.quad_count_at(m, 1), 6, "leaf on the cutout layer")
      Test.assert_eq_int(Ms.quad_count_at(m, 2), 6, "water on the translucent layer")
      Test.assert_eq_int(Q.tex_of(w1_at(m, 1, 0)), 20, "leaf texture")
    end

    test "cross and model blocks are instances, not quads" do
      let m = Ms.build(reg(), alone(C.set(C.set(air(), 4, 5, 6, 5), 7, 8, 9, 6)))
      Test.assert_eq_int(total(m), 0, "no quads")
      Test.assert_eq_int(Ms.instance_count(m), 2, "two instances")
      let i0 = NativeArray.get_i32(Ms.instances(m), 0)
      Test.assert_eq_int(Q.x_of(i0), 4, "the plant's cell: x")
      Test.assert_eq_int(Q.y_of(i0), 5, "y")
      Test.assert_eq_int(Q.z_of(i0), 6, "z")
      Test.assert_eq_int(Q.instance_model(i0), -1, "a cross has no model")
      Test.assert_eq_int(Q.instance_id(NativeArray.get_i32(Ms.instances(m), 1)), 5, "and carries its block id")
      Test.assert_eq_int(Q.instance_model(NativeArray.get_i32(Ms.instances(m), 2)), 0, "the lamp is model 0")
    end

    test "a block in a diagonal neighbour chunk darkens the shared corner" do
      -- stone at local (0, 0, 0); stone in the (-1, +0, -1) chunk at its (31, 1, 31): diagonal to the top face's low corner
      let a = Ms.around_from(fn (dx, dy, dz) ->
        if dx == 0 && dy == 0 && dz == 0 do C.set(C.uniform(0), 0, 0, 0, 1)
        else if dx == -1 && dy == 0 && dz == -1 do C.set(C.uniform(0), 31, 1, 31, 1)
        else C.uniform(0) end end)
      let m = Ms.build(reg(), a)
      let t = find_face(m, 0, 0, 0)
      Test.assert_true(t >= 0, "the top face exists")
      Test.assert_eq_int(Q.ao_corner(Q.ao_of(w1_at(m, 0, t)), 0), 2, "its (0, 0) corner sees the diagonal block")
      Test.assert_eq_int(Q.ao_corner(Q.ao_of(w1_at(m, 0, t)), 3), 3, "the far corner does not")
    end

    test "a chunk of an unregistered id draws nothing" do
      let m = Ms.build(reg(), alone(C.uniform(60000)))
      Test.assert_eq_int(total(m), 0, "no quads")
      Test.assert_eq_int(Ms.instance_count(m), 0, "no instances")
    end

    test "the mesh carries the centre chunk's occupancy and level 0" do
      let m = Ms.build(reg(), alone(C.set(air(), 4, 5, 6, 1)))
      Test.assert_eq_int(Strata.Occupancy.count(Ms.occupancy(m)), 1, "one solid voxel")
      Test.assert_true(Strata.Occupancy.bit(Ms.occupancy(m), 4, 5, 6), "where the block is")
      Test.assert_eq_int(Ms.level(m), 0, "level")
      Test.assert_eq_int(Ms.bytes(m), 6 * 8, "eight bytes a quad")
    end
  end

  pfn box_go(s : Strata.Store.Store(Strata.Chunk.Chunk), i : Int, skip : Int) : Strata.Store.Store(Strata.Chunk.Chunk) do
    if i >= 27 do s
    else if i == skip do box_go(s, i + 1, skip)
    else box_go(Strata.Store.put(s, Strata.Coord.key(10 + i % 3 - 1, -4 + i / 9 - 1, 7 + (i / 3) % 3 - 1), C.uniform(i + 1)), i + 1, skip) end end
  end

  describe "Mesh.around_of / has_all" do
    test "around_of gathers the 27 chunks about a key from a store" do
      let s = box_go(Strata.Store.empty(C.uniform(0)), 0, -1)
      let a = Ms.around_of(s, Strata.Coord.key(10, -4, 7))
      Test.assert_eq_int(C.uniform_id(Ms.around_chunk(a, 0, 0, 0)), 14, "the centre is entry 13")
      Test.assert_eq_int(C.uniform_id(Ms.around_chunk(a, -1, -1, -1)), 1, "the low corner is entry 0")
      Test.assert_eq_int(C.uniform_id(Ms.around_chunk(a, 1, 1, 1)), 27, "the high corner is entry 26")
      Test.assert_eq_int(C.uniform_id(Ms.around_chunk(a, 1, 0, 0)), 15, "+x is the next entry")
      Test.assert_eq_int(C.uniform_id(Ms.around_chunk(a, 0, 0, 1)), 17, "+z is three on")
      Test.assert_eq_int(C.uniform_id(Ms.around_chunk(a, 0, 1, 0)), 23, "+y is nine on")
    end
    test "has_all is true only when all 27 are in the store" do
      let k = Strata.Coord.key(10, -4, 7)
      Test.assert_true(Ms.has_all(box_go(Strata.Store.empty(C.uniform(0)), 0, -1), k), "a full box")
      Test.assert_false(Ms.has_all(box_go(Strata.Store.empty(C.uniform(0)), 0, 26), k), "missing a corner")
      Test.assert_false(Ms.has_all(box_go(Strata.Store.empty(C.uniform(0)), 0, 13), k), "missing the centre")
      Test.assert_false(Ms.has_all(Strata.Store.empty(C.uniform(0)), k), "an empty store")
    end
  end

  describe "Mesh.build against the oracle" do
    test "a scatter of every block kind, in a scattered neighbourhood" do
      let a = noise_around(1)
      Test.assert_true(matches_oracle(reg(), a), "same unit faces, same layers, same corner shading, none twice")
      let m = Ms.build(reg(), a)
      Test.assert_true(tex_ok(reg(), a, m, 0, 0) && tex_ok(reg(), a, m, 1, 0) && tex_ok(reg(), a, m, 2, 0), "every quad carries its block's texture")
    end
    test "a second scatter" do
      Test.assert_true(matches_oracle(reg(), noise_around(9001)), "matches")
    end
    test "terrain-like: a stone half with a pond, air above, stone below and beside" do
      let c = C.fill_box(C.fill_box(C.uniform(0), 0, 0, 0, 31, 15, 31, 1), 8, 14, 8, 20, 15, 20, 3)
      let a = Ms.around_from(fn (dx, dy, dz) -> if dx == 0 && dy == 0 && dz == 0 do c else if dy < 0 do C.uniform(1) else if dy > 0 do C.uniform(0) else c end end end)
      Test.assert_true(matches_oracle(reg(), a), "matches")
    end
    test "random edits over a half-stone chunk" do
      Check.all(Gen.list(Gen.tuple2(Gen.int(0, 32767), Gen.int(0, 6))), fn es ->
        let c = edits(C.fill_box(C.uniform(0), 0, 0, 0, 31, 15, 31, 1), es)
        matches_oracle(reg(), Ms.around_from(fn (dx, dy, dz) -> if dx == 0 && dy == 0 && dz == 0 do c else if dy < 0 do C.uniform(1) else C.uniform(0) end end))
      )
    end
  end

  -- reg() plus a fluid family: ids 7 (one eighth) .. 14 (full)
  pfn wreg() : Strata.Blocks.Registry do
    match B.register_fluid(reg(), B.with_faces(B.with_collide(B.with_layer(B.with_opacity(B.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false), 50, 50, 50)) do
      Ok((r, _)) -> r
      Err(_) -> reg()
    end
  end
  pfn drops_all(m : Strata.Mesh.Meshed, d : Int, k : Int) : Bool do
    if k >= Ms.quad_count_at(m, 2) do true else if Q.drop_of(w0_at(m, 2, k)) != d do false else drops_all(m, d, k + 1) end end
  end
  -- the quad of layer 2 on face f whose lowest voxel is (x, y, z), or -1
  pfn face_at(m : Strata.Mesh.Meshed, f : Int, x : Int, y : Int, z : Int, k : Int) : Int do
    if k >= Ms.quad_count_at(m, 2) do -1
    else
      let w = w0_at(m, 2, k)
      if Q.face_of(w) == f && Q.x_of(w) == x && Q.y_of(w) == y && Q.z_of(w) == z do k else face_at(m, f, x, y, z, k + 1) end
    end
  end

  describe "Mesh.build with fluids" do
    test "a lone partly full voxel has six faces, each carrying its drop" do
      let m = Ms.build(wreg(), alone(C.set(air(), 5, 5, 5, 9)))
      Test.assert_eq_int(Ms.quad_count_at(m, 2), 6, "six faces")
      Test.assert_true(drops_all(m, 5, 0), "level 3 is a drop of 5 eighths")
    end
    test "a big step between two levels of one fluid draws a side from the higher; a small one does not" do
      let big = Ms.build(wreg(), alone(C.set(C.set(air(), 5, 5, 5, 14), 6, 5, 5, 9)))
      Test.assert_true(face_at(big, 2, 5, 5, 5, 0) >= 0, "full beside three eighths: a side")
      Test.assert_eq_int(face_at(big, 3, 6, 5, 5, 0), -1, "none from the lower one")
      Test.assert_eq_int(Ms.quad_count_at(big, 2), 11, "eleven faces in all")
      let small = Ms.build(wreg(), alone(C.set(C.set(air(), 5, 5, 5, 14), 6, 5, 5, 12)))
      Test.assert_eq_int(face_at(small, 2, 5, 5, 5, 0), -1, "full beside six eighths: none, the corners take it up")
      Test.assert_eq_int(Ms.quad_count_at(small, 2), 10, "ten faces in all")
    end
    test "a top face's corners dip to meet a lower neighbour of the same fluid" do
      -- (5,5,5) full, (6,5,5) at six eighths: the full one's two +x corners dip by two
      let m = Ms.build(wreg(), alone(C.set(C.set(air(), 5, 5, 5, 14), 6, 5, 5, 12)))
      let hi = Q.ao_of(w1_at(m, 2, face_at(m, 0, 5, 5, 5, 0)))
      Test.assert_eq_int(Q.ao_corner(hi, 0), 0, "its -x -z corner stays")
      Test.assert_eq_int(Q.ao_corner(hi, 1), 2, "its +x -z corner dips two eighths")
      Test.assert_eq_int(Q.ao_corner(hi, 2), 0, "its -x +z corner stays")
      Test.assert_eq_int(Q.ao_corner(hi, 3), 2, "its +x +z corner dips two eighths")
      Test.assert_eq_int(Q.ao_of(w1_at(m, 2, face_at(m, 0, 6, 5, 5, 0))), 0, "the lower one's corners stay where they are")
      Test.assert_true(Q.is_fluid(w0_at(m, 2, 0)), "fluid quads are marked")
    end
    test "a level sheet of fluid merges into one top face; a tilted one does not" do
      let flat = Ms.build(wreg(), alone(C.set(C.set(C.set(air(), 5, 5, 5, 12), 6, 5, 5, 12), 7, 5, 5, 12)))
      Test.assert_eq_int(Q.w_of(w0_at(flat, 2, face_at(flat, 0, 5, 5, 5, 0))), 3, "three cells, one quad")
      let tilt = Ms.build(wreg(), alone(C.set(C.set(C.set(air(), 5, 5, 5, 12), 6, 5, 5, 12), 7, 5, 5, 11)))
      Test.assert_eq_int(Q.w_of(w0_at(tilt, 2, face_at(tilt, 0, 6, 5, 5, 0))), 1, "the cell beside the lower one keeps its own quad")
    end
    test "a covered voxel beside a shallow one shows its side" do
      -- (5,5,5) has water above it, so it stands full; (6,5,5) at three eighths does not
      let m = Ms.build(wreg(), alone(C.set(C.set(C.set(air(), 5, 5, 5, 9), 5, 6, 5, 9), 6, 5, 5, 9)))
      Test.assert_true(face_at(m, 2, 5, 5, 5, 0) >= 0, "the full-standing one draws toward the lower")
    end
    test "two voxels at one level have no face between them" do
      let m = Ms.build(wreg(), alone(C.set(C.set(air(), 5, 5, 5, 9), 6, 5, 5, 9)))
      Test.assert_eq_int(face_at(m, 2, 5, 5, 5, 0), -1, "none from one")
      Test.assert_eq_int(face_at(m, 3, 6, 5, 5, 0), -1, "none from the other")
    end
    test "fluid under the same fluid draws full height and has no top" do
      let m = Ms.build(wreg(), alone(C.set(C.set(air(), 5, 5, 5, 9), 5, 6, 5, 8)))
      Test.assert_eq_int(face_at(m, 0, 5, 5, 5, 0), -1, "no top face inside the column")
      Test.assert_eq_int(face_at(m, 1, 5, 6, 5, 0), -1, "no bottom face inside it either")
      Test.assert_eq_int(Q.drop_of(w0_at(m, 2, face_at(m, 2, 5, 5, 5, 0))), 0, "the lower voxel's side is full height")
      Test.assert_eq_int(Q.drop_of(w0_at(m, 2, face_at(m, 2, 5, 6, 5, 0))), 6, "the upper one's is at its level")
    end
    test "a covered voxel shows its whole side to any lower neighbour of its fluid" do
      -- (5,5,5) has water above it and stands full; its neighbour holds six eighths, then three
      let near = Ms.build(wreg(), alone(C.set(C.set(C.set(air(), 5, 5, 5, 9), 5, 6, 5, 9), 6, 5, 5, 12)))
      Test.assert_true(face_at(near, 2, 5, 5, 5, 0) >= 0, "a side even across two eighths: it has no top face to dip")
      Test.assert_eq_int(Q.ao_of(w1_at(near, 2, face_at(near, 2, 5, 5, 5, 0))), 0, "drawn to its full height")
      let far = Ms.build(wreg(), alone(C.set(C.set(C.set(air(), 5, 5, 5, 9), 5, 6, 5, 9), 6, 5, 5, 9)))
      Test.assert_eq_int(Q.ao_of(w1_at(far, 2, face_at(far, 2, 5, 5, 5, 0))), 0, "and across five, to its full height too")
    end
    test "everything that is not a fluid has no drop" do
      let m = Ms.build(wreg(), alone(C.set(C.set(air(), 1, 1, 1, 1), 3, 3, 3, 3)))
      Test.assert_eq_int(Q.drop_of(w0_at(m, 0, 0)), 0, "stone")
      Test.assert_eq_int(Q.drop_of(w0_at(m, 2, 0)), 0, "a plain see-through block")
    end
  end
  -- ── The order of the translucent layer ───────────────────────────────────
  -- The mesher promises eight lists, one for each way a ray can run, in
  -- which no quad is before one it covers. Checked with rays: from each eye
  -- to points on each quad of each list, where the ray runs that list's way,
  -- every other quad of the list the ray passes through first must come later.
  pfn tw0(m : Strata.Mesh.Meshed, off : Int, k : Int) : Int do NativeArray.get_i32(Ms.quads_at(m, 2), 2 * (off + k)) end
  pfn fi(n : Int) : Float do int_to_float(n) end
  pfn normal_of(w0 : Int) : Int do if Q.face_of(w0) < 2 do 1 else if Q.face_of(w0) < 4 do 0 else 2 end end end
  -- a quad's box: low and high along axis ax (0 x, 1 y, 2 z); both its plane along its normal
  pfn q_lo(w0 : Int, ax : Int) : Float do
    let f = Q.face_of(w0)
    let c = if ax == 0 do Q.x_of(w0) else if ax == 1 do Q.y_of(w0) else Q.z_of(w0) end end
    if ax == normal_of(w0) && (f == 0 || f == 2 || f == 4) do fi(c + 1) else fi(c) end
  end
  pfn q_hi(w0 : Int, ax : Int) : Float do
    let f = Q.face_of(w0)
    if ax == normal_of(w0) do q_lo(w0, ax)
    else if f < 2 do q_lo(w0, ax) +. fi(if ax == 0 do Q.w_of(w0) else Q.h_of(w0) end)
    else if f < 4 do q_lo(w0, ax) +. fi(if ax == 2 do Q.w_of(w0) else Q.h_of(w0) end)
    else q_lo(w0, ax) +. fi(if ax == 0 do Q.w_of(w0) else Q.h_of(w0) end) end end end
  end
  pfn pick3(ax : Int, x : Float, y : Float, z : Float) : Float do if ax == 0 do x else if ax == 1 do y else z end end end
  pfn q_holds(w0 : Int, ax : Int, v : Float) : Bool do v > q_lo(w0, ax) +. 0.001 && v < q_hi(w0, ax) -. 0.001 end
  -- does the ray from the eye to (px, py, pz) pass through the quad before it arrives?
  pfn covers(w0 : Int, ex : Float, ey : Float, ez : Float, px : Float, py : Float, pz : Float) : Bool do
    let normal = normal_of(w0)
    let e = pick3(normal, ex, ey, ez)
    let d = pick3(normal, px, py, pz) -. e
    if d == 0.0 do false
    else
      let t = (q_lo(w0, normal) -. e) /. d
      if t <= 0.001 || t >= 0.999 do false
      else
        let hx = ex +. t *. (px -. ex)
        let hy = ey +. t *. (py -. ey)
        let hz = ez +. t *. (pz -. ez)
        (normal == 0 || q_holds(w0, 0, hx)) && (normal == 1 || q_holds(w0, 1, hy)) && (normal == 2 || q_holds(w0, 2, hz))
      end
    end
  end
  -- the octant of the ray from the eye to a point: bit 0 it runs down x, bit 1 down y, bit 2 down z
  pfn octant_of(ex : Float, ey : Float, ez : Float, px : Float, py : Float, pz : Float) : Int do
    (if ex > px do 1 else 0 end) + (if ey > py do 2 else 0 end) + (if ez > pz do 4 else 0 end)
  end
  -- (covering pairs seen, pairs in the wrong order) for the ray to one point of quad k of the list at off
  pfn ray_go(m : Strata.Mesh.Meshed, off : Int, n : Int, k : Int, j : Int, ex : Float, ey : Float, ez : Float, px : Float, py : Float, pz : Float, seen : Int, bad : Int) : (Int, Int) do
    if j >= n do (seen, bad)
    else if j != k && covers(tw0(m, off, j), ex, ey, ez, px, py, pz) do
      ray_go(m, off, n, k, j + 1, ex, ey, ez, px, py, pz, seen + 1, if j < k do bad + 1 else bad end)
    else ray_go(m, off, n, k, j + 1, ex, ey, ez, px, py, pz, seen, bad) end end
  end
  -- the centre of unit face (a, b) of a quad
  pfn point_of(w0 : Int, a : Int, b : Int, ax : Int) : Float do
    let f = Q.face_of(w0)
    let ua = if f == 2 || f == 3 do 2 else 0 end
    if ax == normal_of(w0) do q_lo(w0, ax)
    else if ax == ua do q_lo(w0, ax) +. fi(a) +. 0.5
    else q_lo(w0, ax) +. fi(b) +. 0.5 end end
  end
  pfn points_go(m : Strata.Mesh.Meshed, o : Int, k : Int, a : Int, b : Int, step : Int, ex : Float, ey : Float, ez : Float, seen : Int, bad : Int) : (Int, Int) do
    let off = Ms.order_first(m, o)
    let wk = tw0(m, off, k)
    if b >= Q.h_of(wk) do (seen, bad)
    else if a >= Q.w_of(wk) do points_go(m, o, k, 0, b + step, step, ex, ey, ez, seen, bad)
    else
      let px = point_of(wk, a, b, 0)
      let py = point_of(wk, a, b, 1)
      let pz = point_of(wk, a, b, 2)
      -- where the ray runs another way, the renderer does not draw this list
      if octant_of(ex, ey, ez, px, py, pz) != o do points_go(m, o, k, a + step, b, step, ex, ey, ez, seen, bad)
      else
        match ray_go(m, off, Ms.order_count(m, o), k, 0, ex, ey, ez, px, py, pz, seen, bad) do
          (s2, b2) -> points_go(m, o, k, a + step, b, step, ex, ey, ez, s2, b2)
        end
      end
    end end
  end
  pfn list_go(m : Strata.Mesh.Meshed, o : Int, k : Int, ex : Float, ey : Float, ez : Float, seen : Int, bad : Int) : (Int, Int) do
    if k >= Ms.order_count(m, o) do (seen, bad)
    else
      let wk = tw0(m, Ms.order_first(m, o), k)
      match points_go(m, o, k, 0, 0, if Q.w_of(wk) * Q.h_of(wk) > 60 do 3 else 1 end, ex, ey, ez, seen, bad) do
        (s2, b2) -> list_go(m, o, k + 1, ex, ey, ez, s2, b2)
      end
    end
  end
  pfn lists_go(m : Strata.Mesh.Meshed, o : Int, ex : Float, ey : Float, ez : Float, seen : Int, bad : Int) : (Int, Int) do
    if o >= 8 do (seen, bad)
    else
      match list_go(m, o, 0, ex, ey, ez, seen, bad) do
        (s2, b2) -> lists_go(m, o + 1, ex, ey, ez, s2, b2)
      end
    end
  end
  pfn eyes_go(m : Strata.Mesh.Meshed, eyes : List((Float, Float, Float)), seen : Int, bad : Int) : (Int, Int) do
    match eyes do
      Nil -> (seen, bad)
      Cons((ex, ey, ez), t) ->
        match lists_go(m, 0, ex, ey, ez, seen, bad) do
          (s2, b2) -> eyes_go(m, t, s2, b2)
        end
    end
  end
  -- is every quad of list o one that rays running its way can meet: a fluid's, or one facing against them?
  pfn list_faces(m : Strata.Mesh.Meshed, o : Int, k : Int) : Bool do
    if k >= Ms.order_count(m, o) do true
    else
      let w = tw0(m, Ms.order_first(m, o), k)
      let f = Q.face_of(w)
      let bit = int_and(o / (if normal_of(w) == 0 do 1 else if normal_of(w) == 1 do 2 else 4 end end), 1)
      if both_sides(m, Ms.order_first(m, o), k) || (bit == 1) == (f == 0 || f == 2 || f == 4) do list_faces(m, o, k + 1) else false end
    end
  end
  -- is the quad one of a block the eye can be inside: the plain see-through block (texture 30) or the fluid (50)?
  pfn both_sides(m : Strata.Mesh.Meshed, off : Int, k : Int) : Bool do
    let tex = Q.tex_of(NativeArray.get_i32(Ms.quads_at(m, 2), 2 * (off + k) + 1))
    tex == 30 || tex == 50
  end
  pfn fluids(m : Strata.Mesh.Meshed, k : Int, acc : Int) : Int do
    if k >= Ms.quad_count_at(m, 2) do acc else fluids(m, k + 1, if both_sides(m, 0, k) do acc + 1 else acc end) end
  end

  -- a pool two voxels deep of the plain see-through block, three glass panes
  -- standing through it one behind another, and a fourth across their ends
  pfn panes() : Strata.Chunk.Chunk do
    let pool = C.fill_box(air(), 4, 10, 4, 26, 11, 26, 3)
    let p1 = C.fill_box(pool, 10, 6, 8, 20, 18, 8, 4)
    let p2 = C.fill_box(p1, 10, 6, 12, 20, 18, 12, 4)
    let p3 = C.fill_box(p2, 10, 6, 16, 20, 18, 16, 4)
    C.fill_box(p3, 24, 6, 2, 24, 18, 28, 4)
  end
  -- a pool of the fluid, five deep, with two glass panes standing through it
  pfn fluid_panes() : Strata.Chunk.Chunk do
    let pool = C.fill_box(air(), 4, 8, 4, 26, 12, 26, 14)
    let p1 = C.fill_box(pool, 10, 6, 10, 20, 18, 10, 4)
    C.fill_box(p1, 10, 6, 16, 20, 18, 16, 4)
  end
  pfn all_round() : List((Float, Float, Float)) do
    Cons((-10.0, 14.3, -9.0), Cons((40.0, 30.0, 41.0), Cons((15.5, 30.0, 14.3), Cons((15.4, -6.0, 10.3), Cons((-8.0, 2.0, 35.0),
    Cons((13.3, 14.5, 10.4), Cons((13.3, 8.5, 14.4), Cons((29.5, 13.0, 15.2), Cons((2.5, 9.5, 15.3), Cons((50.0, 12.6, 15.3),
    Cons((22.4, 15.2, 5.3), Cons((7.2, 3.1, 20.6), Nil))))))))))))
  end

  describe "Mesh.build, the translucent layer's order" do
    test "in every list no quad is before one it covers, from eyes all round and inside the chunk" do
      let m = Ms.build(reg(), alone(panes()))
      match eyes_go(m, all_round(), 0, 0) do
        (seen, bad) ->
          Test.assert_true(seen > 1000, "the rays do pass through other quads")
          Test.assert_eq_int(bad, 0, "and never through one drawn earlier")
      end
    end
    test "a list holds the quads facing against its rays, and from either side those of a block the eye can be inside" do
      let m = Ms.build(reg(), alone(panes()))
      let n = Ms.quad_count_at(m, 2)
      let wet = fluids(m, 0, 0)
      Test.assert_true(wet > 0 && wet < n, "pool and glass both")
      Test.assert_eq_int(Ms.order_total(m), 4 * (n - wet) + 8 * wet, "four lists a glass quad, eight one of the pool's, which does not collide")
      Test.assert_eq_int(Ms.order_total(Ms.build(reg(), alone(C.set(air(), 4, 4, 4, 4)))), 24, "a lone glass block: each face in four lists, so that its far faces are left out")
      Test.assert_true(list_faces(m, 0, 0) && list_faces(m, 3, 0) && list_faces(m, 5, 0) && list_faces(m, 7, 0), "each facing its list's rays")
    end
    test "the lists follow the quads, which are still exactly the oracle's faces" do
      Test.assert_true(matches_oracle(reg(), alone(panes())), "the panes and the pool")
    end
    test "quads in one plane, all seen from both sides, carry no lists" do
      let pond = Ms.build(reg(), alone(C.fill_box(C.fill_box(air(), 0, 0, 0, 31, 9, 31, 1), 3, 9, 3, 20, 9, 20, 3)))
      Test.assert_eq_int(Ms.order_total(pond), 0, "a pond in stone: tops in one plane")
      Test.assert_eq_int(Ms.order_total(Ms.build(reg(), alone(C.set(air(), 4, 4, 4, 1)))), 0, "nothing translucent at all")
    end
    test "a fluid's quads are in all eight lists, and the order holds from inside it and from the air" do
      let m = Ms.build(wreg(), alone(fluid_panes()))
      let n = Ms.quad_count_at(m, 2)
      let wet = fluids(m, 0, 0)
      Test.assert_true(wet > 0 && wet < n, "fluid and glass both")
      Test.assert_eq_int(Ms.order_total(m), 4 * (n - wet) + 8 * wet, "four lists a glass quad, eight a fluid's")
      let eyes = Cons((7.3, 10.4, 13.2), Cons((22.6, 9.3, 6.4), Cons((15.3, 11.2, 13.4), Cons((15.6, 8.4, 22.3),
                 Cons((-10.0, 14.3, -9.0), Cons((15.5, 30.0, 14.3), Cons((40.0, 20.0, 13.2), Nil)))))))
      match eyes_go(m, eyes, 0, 0) do
        (seen, bad) ->
          Test.assert_true(seen > 200, "the rays do pass through other quads")
          Test.assert_eq_int(bad, 0, "and never through one drawn earlier")
      end
    end
  end
end
