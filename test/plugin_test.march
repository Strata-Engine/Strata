-- Plugin: the frame a plugin reads, and requests applied in order.
mod Strata.Test.Plugin do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias Strata.Plugin as Plg
  alias Strata.World as PlgW
  alias Strata.Coord as PlgC
  alias Strata.Chunk as PlgCh

  pfn flat() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) -> if PlgC.ky(k) < 0 do PlgCh.uniform(1) else PlgCh.uniform(0) end)
  end
  pfn reg() : Strata.Blocks.Registry do
    match Strata.Blocks.register(Strata.Blocks.empty(), Strata.Blocks.def()) do
      Ok((r1, _)) -> match Strata.Blocks.register(r1, Strata.Blocks.def()) do Ok((r2, _)) -> r2 | Err(_) -> r1 end
      Err(_) -> Strata.Blocks.empty()
    end
  end
  pfn world() : Strata.World.World do
    let w = PlgW.new(reg(), flat(), 7, 1.0)
    let k = PlgC.key(0, 0, 0)
    PlgW.insert(w, k, Strata.Terrain.run(PlgW.terrain(w), k, PlgW.seed(w)))
  end
  pfn vp() : NativeFloatArr do
    Strata.Math.Mat4.mul(Strata.Math.Mat4.perspective(1.0, 1.6, 0.1, 100.0), Strata.Math.Mat4.look_at(Strata.Math.Vec3.new(0.0, 10.0, 10.0), Strata.Math.Vec3.new(0.0, 0.0, 0.0), Strata.Math.Vec3.new(0.0, 1.0, 0.0)))
  end
  pfn inp() : Strata.Input.Input do Strata.Input.start(Strata.Input.new(Nil)) end

  describe "Plugin.frame" do
    test "frame fills the ray from the pointer and view-projection" do
      let f = Plg.frame(world(), inp(), Some((100.0, 200.0)), 0.0, 0.016, 800.0, 500.0, vp())
      Test.assert_true(f.pf_ray == Strata.Math.Ray.from_screen(vp(), 100.0, 200.0, 800.0, 500.0), "same ray")
      Test.assert_true(Option.is_some(f.pf_ray), "a ray")
      let g = Plg.frame(world(), inp(), None, 0.0, 0.016, 800.0, 500.0, vp())
      Test.assert_true(Option.is_none(g.pf_ray), "no pointer, no ray")
    end
  end

  describe "Plugin.apply" do
    test "apply runs edits in order and the second sees the first" do
      match Plg.apply(world(), [Plg.edit(PlgW.op_box(1, 1, 1, 3, 3, 3, 1)), Plg.edit(PlgW.op_cell(2, 2, 2, 2))]) do
        (w, outs, rest) ->
          Test.assert_true(PlgW.get_block(w, 2, 2, 2) == 2 && PlgW.get_block(w, 1, 1, 1) == 1, "box then cell")
          Test.assert_true(List.length(outs) == 2 && List.is_empty(rest), "two outcomes, nothing left")
      end
    end
    test "apply hands back sounds untouched" do
      match Plg.apply(world(), [Plg.sound(3, 1.0, 2.0, 3.0, 0.5), Plg.edit(PlgW.op_cell(0, 5, 0, 1)), Plg.sound(4, 0.0, 0.0, 0.0, 1.0)]) do
        (_, outs, rest) ->
          Test.assert_true(List.length(outs) == 1, "one edit")
          Test.assert_true(List.map(rest, fn r -> Plg.request_index(r)) == [2, 2], "two sounds")
          Test.assert_true(Plg.sound_of(List.head(rest)) == Some((3, 1.0, 2.0, 3.0, 0.5)), "first sound first")
      end
    end
  end
end
