-- Thermal relaxation: material slides off slopes steeper than the talus
-- angle, the total stays the same, and gentler slopes are left alone.
mod Strata.Test.Thermal do

  import Test
  alias Strata.Thermal as Th

  pfn sum_go(h : NativeF32Arr, k : Int, n : Int, acc : Float) : Float do
    if k >= n do acc else sum_go(h, k + 1, n, acc +. NativeArray.get_f32(h, k)) end
  end

  -- the largest height difference between 4-neighbours of an n x n grid
  pfn steepest_go(h : NativeF32Arr, n : Int, k : Int, best : Float) : Float do
    if k >= n * n do best
    else
      let v = NativeArray.get_f32(h, k)
      let dx = if k % n == n - 1 do 0.0 else Math.abs(v -. NativeArray.get_f32(h, k + 1)) end
      let dz = if k / n == n - 1 do 0.0 else Math.abs(v -. NativeArray.get_f32(h, k + n)) end
      let m = if dx > dz do dx else dz end
      steepest_go(h, n, k + 1, if m > best do m else best end)
    end
  end

  -- a plane rising s metres a column along x, plus z / 10
  pfn plane_go(h : NativeF32Arr, n : Int, s : Float, k : Int) : NativeF32Arr do
    if k >= n * n do h else plane_go(NativeArray.set_f32(h, k, s *. int_to_float(k % n) +. 0.1 *. int_to_float(k / n)), n, s, k + 1) end
  end

  pfn same_go(a : NativeF32Arr, b : NativeF32Arr, k : Int, n : Int) : Bool do
    if k >= n do true else if NativeArray.get_f32(a, k) != NativeArray.get_f32(b, k) do false else same_go(a, b, k + 1, n) end end
  end

  describe "Thermal" do
    test "a 10 m step over one 0.25 m column settles to 45 degrees in 20 passes, conserving height" do
      let n = 16
      let h = NativeArray.set_f32(NativeArray.make_f32(n * n, 0.0), 8 + n * 8, 10.0)
      let r = Th.relax(h, n, 0.25, NativeArray.make_f32(n * n, 45.0), 20)
      Test.assert_eq_int(NativeArray.length_f32(r), n * n, "a height a column")
      -- tan 45 degrees over 0.25 m is 0.25 m between neighbours
      Test.assert_true(steepest_go(r, n, 0, 0.0) <= 0.25 +. 0.001, "no neighbour stands more than 0.25 m over another")
      Test.assert_true(Math.abs(sum_go(r, 0, n * n, 0.0) -. 10.0) < 0.001, "the total height is unchanged")
      Test.assert_true(NativeArray.get_f32(r, 8 + n * 8) < 2.0, "the step came down")
    end
    test "a slope under the talus is unchanged" do
      let n = 34
      let h = plane_go(NativeArray.make_f32(n * n, 0.0), n, 0.5, 0)
      -- 0.5 m a 1 m column is 26.6 degrees, under a talus of 30
      let r = Th.relax(h, n, 1.0, NativeArray.make_f32(n * n, 30.0), 4)
      Test.assert_true(same_go(h, r, 0, n * n), "every column as it was")
    end
  end
end
