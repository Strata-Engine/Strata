-- Model: building a model block's drawing geometry.
mod Strata.Test.Model do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  import Test
  alias Strata.Model as Mo

  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.0001 end

  -- is corner c (0..3) of quad q on the plane [axis] = v of the box?
  pfn on_plane(f : NativeF32Arr, q : Int, axis : Int, v : Float, c : Int) : Bool do
    if c >= 4 do true
    else if near(NativeArray.get_f32(f, 21 * q + 5 * c + axis), v) do on_plane(f, q, axis, v, c + 1)
    else false end end
  end
  -- does quad q lie on one of the box's six faces?
  pfn on_a_face(f : NativeF32Arr, q : Int) : Bool do
    on_plane(f, q, 0, 0.25, 0) || on_plane(f, q, 0, 0.75, 0) || on_plane(f, q, 1, 0.0, 0) || on_plane(f, q, 1, 0.5, 0) || on_plane(f, q, 2, 0.1, 0) || on_plane(f, q, 2, 0.9, 0)
  end
  pfn all_on_faces(f : NativeF32Arr, q : Int, n : Int) : Bool do
    if q >= n do true else if on_a_face(f, q) do all_on_faces(f, q + 1, n) else false end end
  end
  pfn all_tex(f : NativeF32Arr, q : Int, n : Int, tex : Float) : Bool do
    if q >= n do true else if near(NativeArray.get_f32(f, 21 * q + 20), tex) do all_tex(f, q + 1, n, tex) else false end end
  end
  -- every corner of every quad within the box
  pfn inside(f : NativeF32Arr, i : Int, n : Int) : Bool do
    if i >= n * 4 do true
    else
      let o = 21 * (i / 4) + 5 * (i % 4)
      let x = NativeArray.get_f32(f, o)
      let y = NativeArray.get_f32(f, o + 1)
      let z = NativeArray.get_f32(f, o + 2)
      if x >= 0.2499 && x <= 0.7501 && y >= -0.0001 && y <= 0.5001 && z >= 0.0999 && z <= 0.9001 do inside(f, i + 1, n) else false end
    end
  end

  describe "Model" do
    test "an empty geometry has no quads" do
      Test.assert_eq_int(Mo.count(Mo.empty()), 0, "count")
      Test.assert_eq_int(NativeArray.length_f32(Mo.floats(Mo.empty())), 0, "floats")
    end
    test "a box is six quads of 21 floats, each on a face of the box, carrying the texture" do
      let g = Mo.box(Mo.empty(), 0.25, 0.0, 0.1, 0.75, 0.5, 0.9, 7)
      Test.assert_eq_int(Mo.count(g), 6, "six quads")
      let f = Mo.floats(g)
      Test.assert_eq_int(NativeArray.length_f32(f), 126, "21 floats each")
      Test.assert_true(all_on_faces(f, 0, 6), "each quad's four corners lie on one face")
      Test.assert_true(inside(f, 0, 6), "no corner leaves the box")
      Test.assert_true(all_tex(f, 0, 6, 7.0), "the 21st float of each is the texture id")
    end
    test "boxes add up" do
      let g = Mo.box(Mo.box(Mo.empty(), 0.0, 0.0, 0.0, 1.0, 1.0, 1.0, 1), 0.2, 1.0, 0.2, 0.8, 1.2, 0.8, 2)
      Test.assert_eq_int(Mo.count(g), 12, "twelve quads")
      Test.assert_true(near(NativeArray.get_f32(Mo.floats(g), 20), 1.0), "the first box's texture first")
      Test.assert_true(near(NativeArray.get_f32(Mo.floats(g), 21 * 6 + 20), 2.0), "then the second's")
    end
    test "quad takes exactly twenty floats; anything else changes nothing" do
      let g = Mo.quad(Mo.empty(), NativeArray.make_f32(20, 0.5), 3)
      Test.assert_eq_int(Mo.count(g), 1, "one quad")
      Test.assert_true(near(NativeArray.get_f32(Mo.floats(g), 20), 3.0), "its texture")
      Test.assert_eq_int(Mo.count(Mo.quad(g, NativeArray.make_f32(19, 0.5), 3)), 1, "nineteen floats is not a quad")
      Test.assert_eq_int(Mo.count(Mo.quad(g, NativeArray.make_f32(21, 0.5), 3)), 1, "nor twenty-one")
    end
  end

  describe "Blocks.model_count" do
    test "rises by one per model" do
      let r0 = Strata.Blocks.empty()
      Test.assert_eq_int(Strata.Blocks.model_count(r0), 0, "none yet")
      match Strata.Blocks.add_model(r0, Mo.floats(Mo.box(Mo.empty(), 0.0, 0.0, 0.0, 1.0, 1.0, 1.0, 1)), Nil) do
        (r1, m) ->
          Test.assert_eq_int(m, 0, "the first model")
          Test.assert_eq_int(Strata.Blocks.model_count(r1), 1, "one")
          Test.assert_eq_int(NativeArray.length_f32(Strata.Blocks.model_quads(r1, 0)), 126, "its geometry is kept")
      end
    end
  end
end
