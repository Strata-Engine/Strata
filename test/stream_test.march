-- Stream: loading around focus points, worker-built meshes, unloading,
-- determinism, and edits that outlive a chunk's absence.
mod Strata.Test.Stream do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  needs IO.Spawn
  import Test
  alias Strata.Stream as Sm
  alias Strata.World as Wd
  alias Strata.Edit as Ed
  alias Strata.Coord as Cd
  alias Strata.Chunk as C
  alias Strata.Blocks as B

  -- stone below y = 0 with a seeded pillar in every chunk column, air above
  pfn terrain() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) ->
      if Cd.ky(k) < 0 do C.uniform(1)
      else if Cd.ky(k) == 0 do C.fill_box(C.uniform(0), 3, 0, 3, 3, (Cd.kx(k) * 7 + Cd.kz(k) * 13 + seed) % 9 + 9, 3, 1)
      else C.uniform(0) end end)
  end
  pfn reg() : Strata.Blocks.Registry do
    match B.register(B.empty(), B.def()) do
      Ok((r, _)) -> r
      Err(_) -> B.empty()
    end
  end
  pfn begin(budget : Int, workers : Int) : Strata.Stream.Stream do
    Sm.start(Wd.new(reg(), terrain(), 7, 1.0), Sm.config(2, 1, budget, workers))
  end
  pfn at(s : Strata.Stream.Stream, x : Float, y : Float, z : Float) : Strata.Stream.Stream do
    Sm.run_until_settled(Sm.set_focus(s, Cons((x, y, z), Nil)), 20000)
  end

  pfn has_key(l : List(Strata.Coord.Key), k : Strata.Coord.Key) : Bool do
    match l do
      Nil -> false
      Cons(h, t) -> if Cd.key_eq(h, k) do true else has_key(t, k) end
    end
  end
  pfn all_loaded(w : Strata.World.World, l : List(Strata.Coord.Key)) : Bool do
    match l do
      Nil -> true
      Cons(k, t) -> if Wd.is_loaded(w, k) do all_loaded(w, t) else false end
    end
  end
  pfn no_repeats(l : List(Strata.Coord.Key)) : Bool do
    match l do
      Nil -> true
      Cons(k, t) -> if has_key(t, k) do false else no_repeats(t) end
    end
  end
  pfn mesh_keys(l : List((Strata.Coord.Key, Strata.Mesh.Meshed))) : List(Strata.Coord.Key) do
    match l do
      Nil -> Nil
      Cons((k, _), t) -> Cons(k, mesh_keys(t))
    end
  end
  pfn mesh_of(l : List((Strata.Coord.Key, Strata.Mesh.Meshed)), k : Strata.Coord.Key) : Int do
    match l do
      Nil -> -1
      Cons((k2, m), t) -> if Cd.key_eq(k2, k) do Strata.Mesh.quad_count_at(m, 0) else mesh_of(t, k) end
    end
  end

  -- the walk both determinism runs take
  pfn walk(budget : Int, workers : Int) : Int do
    let s1 = at(begin(budget, workers), 0.5, 0.5, 0.5)
    let s2 = at(s1, 64.5, 0.5, 0.5)
    let s3 = at(s2, 64.5, 0.5, 64.5)
    let s4 = at(s3, 0.5, 40.5, 64.5)
    let h = Sm.world_hash(s4)
    Sm.stop(s4)
    h
  end

  -- ── Levels ───────────────────────────────────────────────────────────────
  -- the same land at levels 0..2: stone under y = 0, the pillar at every level
  pfn layered() : Strata.Terrain.Gen do
    Strata.Terrain.gen_levels(fn (k, seed) ->
      if Cd.ky(k) < 0 do C.uniform(1)
      else if Cd.ky(k) == 0 do C.fill_box(C.uniform(0), 3, 0, 3, 3, (Cd.kx(k) * 7 + Cd.kz(k) * 13 + seed + Cd.level(k)) % 9 + 9, 3, 1)
      else C.uniform(0) end end, 2)
  end
  pfn begin_levels() : Strata.Stream.Stream do
    Sm.start(Wd.new(reg(), layered(), 7, 1.0), Sm.config_levels(2, 1, 8, 4, 2, 1, 2))
  end
  pfn at_level(s : Strata.Stream.Stream, l : Int) : Int do
    Strata.Store.fold(Wd.chunks(Sm.world(s)), 0, fn (n, k, _c) -> if Cd.level(k) == l do n + 1 else n end)
  end
  pfn mesh_levels(l : List((Strata.Coord.Key, Strata.Mesh.Meshed))) : Bool do
    match l do
      Nil -> true
      Cons((k, m), t) -> if Strata.Mesh.level(m) != Cd.level(k) do false else mesh_levels(t) end
    end
  end
  pfn mesh_at(l : List((Strata.Coord.Key, Strata.Mesh.Meshed)), lv : Int) : Int do
    List.fold_left(l, 0, fn (n, p) -> match p do (k, _) -> if Cd.level(k) == lv do n + 1 else n end end)
  end

  -- level-1 meshes with x below [x]
  pfn level1_short_of(l : List((Strata.Coord.Key, Strata.Mesh.Meshed)), x : Int) : Int do
    match l do
      Nil -> 0
      Cons((k, _), t) -> (if Cd.level(k) == 1 do (if Cd.kx(k) < x do 1 else 0 end) else 0 end) + level1_short_of(t, x)
    end
  end

  describe "Stream" do
    test "loads the box around the focus and meshes every chunk with all its neighbours" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      Test.assert_true(Sm.settled(s), "settled")
      Test.assert_eq_int(Sm.loaded_count(s), 75, "5 x 3 x 5 chunks")
      Test.assert_eq_int(Wd.get_block(Sm.world(s), 5, -5, 5), 1, "terrain is there")
      match Sm.take_meshes(s) do
        (s2, ms) ->
          Test.assert_eq_int(List.length(ms), 9, "the 3 x 1 x 3 chunks one inside the edge")
          Test.assert_true(has_key(mesh_keys(ms), Cd.key(0, 0, 0)), "the focus chunk among them")
          Test.assert_true(has_key(mesh_keys(ms), Cd.key(-1, 0, 1)), "and a corner of the inner box")
          Test.assert_false(has_key(mesh_keys(ms), Cd.key(2, 0, 0)), "but not a chunk on the edge")
          Test.assert_true(mesh_of(ms, Cd.key(0, 0, 0)) > 0, "the focus chunk's mesh has quads")
          match Sm.take_meshes(s2) do
            (s3, again) ->
              Test.assert_eq_int(List.length(again), 0, "a second take is empty")
              Sm.stop(s3)
          end
      end
    end

    test "moving the focus loads ahead and unloads behind, one chunk late" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      match Sm.take_unloads(s) do
        (s1, none) ->
          Test.assert_eq_int(List.length(none), 0, "nothing unloaded yet")
          let s2 = at(s1, 64.5, 0.5, 0.5)
          Test.assert_true(Wd.is_loaded(Sm.world(s2), Cd.key(4, 0, 0)), "the new edge is loaded")
          Test.assert_true(Wd.is_loaded(Sm.world(s2), Cd.key(-1, 0, 0)), "one chunk behind the box is kept")
          Test.assert_false(Wd.is_loaded(Sm.world(s2), Cd.key(-2, 0, 0)), "two behind is not")
          Test.assert_eq_int(Sm.loaded_count(s2), 90, "the box plus the kept slab")
          match Sm.take_unloads(s2) do
            (s3, gone) ->
              Test.assert_eq_int(List.length(gone), 15, "the far slab: 1 x 3 x 5")
              Test.assert_true(has_key(gone, Cd.key(-2, 0, 0)), "named in the unloads")
              Sm.stop(s3)
          end
      end
    end

    test "the same seed and path give the same world whatever the workers and budget" do
      Test.assert_eq_int(walk(1, 1), walk(64, 4), "world hash")
    end

    test "an edit survives its chunk leaving and returning" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      let s2 = Sm.apply(s, Ed.set_block(Sm.world(s), 5, -5, 5, 0))
      let far = at(s2, 2000.5, 0.5, 0.5)
      Test.assert_false(Wd.is_loaded(Sm.world(far), Cd.key(0, -1, 0)), "the chunk is gone")
      Test.assert_eq_int(Wd.cache_size(Sm.world(far)), 1, "but cached")
      let back = at(far, 0.5, 0.5, 0.5)
      Test.assert_eq_int(Wd.get_block(Sm.world(back), 5, -5, 5), 0, "the edit is still there")
      Test.assert_eq_int(Wd.get_block(Sm.world(back), 6, -5, 5), 1, "and only the edit")
      Sm.stop(back)
    end

    test "applying an edit remeshes exactly its dirty chunks, with the edit in the mesh" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      match Sm.take_meshes(s) do
        (s1, _) ->
          let o = Ed.set_block(Sm.world(s1), 20, 20, 20, 1)
          Test.assert_eq_int(List.length(Ed.dirty(o)), 1, "an interior edit")
          let s2 = Sm.run_until_settled(Sm.apply(s1, o), 20000)
          match Sm.take_meshes(s2) do
            (s3, ms) ->
              Test.assert_eq_int(List.length(ms), 1, "one mesh came back")
              Test.assert_true(has_key(mesh_keys(ms), Cd.key(0, 0, 0)), "the edited chunk's")
              Test.assert_true(mesh_of(ms, Cd.key(0, 0, 0)) >= 6 + 5, "the pillar and the new block")
              Sm.stop(s3)
          end
      end
    end

    test "a teleport mid-load ends in the same world as going straight there, and a queued edit waits" do
      let s0 = Sm.tick(Sm.set_focus(begin(8, 2), Cons((0.5, 0.5, 0.5), Nil)))
      let s1 = Sm.apply(s0, Ed.set_block(Sm.world(s0), 5, -5, 5, 0))
      let far = at(s1, 3200.5, 0.5, 0.5)
      Test.assert_eq_int(Sm.loaded_count(far), 75, "one box at the far point, nothing left behind")
      let direct = at(begin(8, 2), 3200.5, 0.5, 0.5)
      Test.assert_eq_int(Sm.world_hash(far), Sm.world_hash(direct), "same world as going straight there")
      Sm.stop(direct)
      let back = at(far, 0.5, 0.5, 0.5)
      Test.assert_eq_int(Wd.get_block(Sm.world(back), 5, -5, 5), 0, "the edit made before leaving is applied")
      Sm.stop(back)
    end

    test "a block queued into an unloaded chunk at a border remeshes the loaded neighbour when the chunk arrives" do
      -- a lone block at voxel (63, 20, 20), the +x edge of chunk (1, 0, 0): six faces
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      let s1 = Sm.run_until_settled(Sm.apply(s, Ed.set_block(Sm.world(s), 63, 20, 20, 1)), 20000)
      -- step away so chunk (2, 0, 0) unloads while (1, 0, 0) stays, with its mesh
      let away = at(s1, -63.5, 0.5, 0.5)
      Test.assert_false(Wd.is_loaded(Sm.world(away), Cd.key(2, 0, 0)), "the far chunk is unloaded")
      Test.assert_true(Wd.is_loaded(Sm.world(away), Cd.key(1, 0, 0)), "its neighbour is kept")
      match Sm.take_meshes(away) do
        (a1, _) ->
          -- a block against it, across the border, in the unloaded chunk
          let a2 = Sm.apply(a1, Ed.set_block(Sm.world(a1), 64, 20, 20, 1))
          let back = at(a2, 0.5, 0.5, 0.5)
          Test.assert_eq_int(Wd.get_block(Sm.world(back), 64, 20, 20), 1, "the queued block arrived")
          match Sm.take_meshes(back) do
            (b1, ms) ->
              Test.assert_true(has_key(mesh_keys(ms), Cd.key(1, 0, 0)), "the neighbour was remeshed")
              Sm.stop(b1)
          end
      end
    end

    test "take_changed lists loads, edits and unloads once each, apart from take_meshes and take_unloads" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      match Sm.take_changed(s) do
        (s1, changed, gone) ->
          Test.assert_eq_int(List.length(changed), 75, "every loaded chunk")
          Test.assert_true(all_loaded(Sm.world(s1), changed), "each of them loaded")
          Test.assert_true(no_repeats(changed), "each once")
          Test.assert_eq_int(List.length(gone), 0, "no unloads")
          match Sm.take_changed(s1) do
            (s2, again, gone2) ->
              Test.assert_eq_int(List.length(again) + List.length(gone2), 0, "a second take is empty")
              let s3 = Sm.apply(s2, Ed.set_block(Sm.world(s2), 20, 20, 20, 1))
              match Sm.take_changed(s3) do
                (s4, edited, gone3) ->
                  Test.assert_eq_int(List.length(edited), 1, "a one-block edit lists one chunk")
                  Test.assert_true(has_key(edited, Cd.key(0, 0, 0)), "the edited chunk")
                  Test.assert_eq_int(List.length(gone3), 0, "and no unloads")
                  match Sm.take_meshes(s4) do
                    (s5, ms) ->
                      Test.assert_eq_int(List.length(ms), 9, "take_meshes still gives the 9 meshes")
                      let far = at(s5, 2000.5, 0.5, 0.5)
                      match Sm.take_changed(far) do
                        (f1, arrived, left) ->
                          Test.assert_eq_int(List.length(left), 75, "after moving far away the old chunks are unloaded")
                          Test.assert_true(has_key(left, Cd.key(0, 0, 0)) && has_key(left, Cd.key(-2, -1, 2)), "named among them")
                          Test.assert_eq_int(List.length(arrived), 75, "and the new box is loaded")
                          Test.assert_true(all_loaded(Sm.world(f1), arrived) && no_repeats(arrived), "each loaded, once")
                          match Sm.take_unloads(f1) do
                            (f2, unloads) ->
                              Test.assert_eq_int(List.length(unloads), 75, "take_unloads still gives the 75")
                              Sm.stop(f2)
                          end
                      end
                  end
              end
          end
      end
    end

    test "take_changed records nothing until first taken, then lists the loaded chunks" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      let s1 = at(at(at(at(s, 2000.5, 0.5, 0.5), 0.5, 0.5, 0.5), 4000.5, 0.5, 4000.5), 0.5, 0.5, 0.5)
      Test.assert_eq_int(Sm.changed_pending(s1), 0, "moving away and back without a take records nothing")
      match Sm.take_changed(s1) do
        (s2, changed, gone) ->
          Test.assert_eq_int(List.length(changed), Sm.loaded_count(s2), "the first take lists every loaded chunk")
          Test.assert_eq_int(List.length(changed), 75, "the 75 around the focus")
          Test.assert_true(all_loaded(Sm.world(s2), changed) && no_repeats(changed), "each loaded, once")
          Test.assert_eq_int(List.length(gone), 0, "and no unloads")
          Sm.stop(s2)
      end
    end

    test "a chunk unloaded and loaded again between two takes is listed only as changed" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      match Sm.take_changed(s) do
        (s1, _, _) ->
          -- 160 m east: chunk (-2, 0, 0) is more than one chunk behind the box and unloads; back, it loads again
          let away = at(s1, 160.5, 0.5, 0.5)
          Test.assert_false(Wd.is_loaded(Sm.world(away), Cd.key(-2, 0, 0)), "the chunk unloaded")
          let back = at(away, 0.5, 0.5, 0.5)
          match Sm.take_changed(back) do
            (b1, changed, gone) ->
              Test.assert_true(has_key(changed, Cd.key(-2, 0, 0)), "it is listed as changed")
              Test.assert_false(has_key(gone, Cd.key(-2, 0, 0)), "and not as unloaded")
              Test.assert_true(all_loaded(Sm.world(b1), changed) && no_repeats(changed), "every changed chunk loaded, once")
              Test.assert_eq_int(List.length(changed), 75, "the 60 chunks x -2..1 loaded again and the 15 of x = 3 loaded on the way, still loaded")
              Sm.stop(b1)
          end
      end
    end

    test "no focus unloads everything" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      let s2 = Sm.run_until_settled(Sm.set_focus(s, Nil), 20000)
      Test.assert_eq_int(Sm.loaded_count(s2), 0, "nothing loaded")
      Test.assert_true(Sm.settled(s2), "and settled")
      Sm.stop(s2)
    end

    test "regenerate remakes every unedited chunk from the new generator and keeps the edited ones" do
      let s = at(begin(8, 2), 0.5, 0.5, 0.5)
      let s1 = Sm.apply(s, Ed.set_block(Sm.world(s), 5, -5, 5, 0))
      -- the new land: stone everywhere, also above y = 0
      let s2 = Sm.regenerate(s1, Strata.Terrain.gen(fn (k, seed) -> C.uniform(1)))
      match Sm.take_unloads(s2) do
        (s3, gone) ->
          Test.assert_true(has_key(gone, Cd.key(1, 0, 1)), "an unedited chunk is dropped: the renderer frees it")
          Test.assert_false(has_key(gone, Cd.key(0, -1, 0)), "the edited chunk is not")
          let s4 = Sm.run_until_settled(s3, 20000)
          Test.assert_eq_int(Wd.get_block(Sm.world(s4), 40, 20, 40), 1, "an unedited chunk is the new land's")
          Test.assert_eq_int(Wd.get_block(Sm.world(s4), 5, -5, 5), 0, "the edit is kept")
          Test.assert_eq_int(Sm.loaded_count(s4), Sm.loaded_count(s), "the same box is loaded")
          Sm.stop(s4)
      end
    end

    test "two focus points load the union of their boxes" do
      let s = Sm.run_until_settled(Sm.set_focus(begin(8, 2), Cons((0.5, 0.5, 0.5), Cons((640.5, 0.5, 0.5), Nil))), 20000)
      Test.assert_eq_int(Sm.loaded_count(s), 150, "two boxes that do not touch")
      Sm.stop(s)
    end
    test "with levels, a settled stream holds each level's box, meshes carry their level, and the world is the same by two paths" do
      let s = at(begin_levels(), 0.5, 0.5, 0.5)
      Test.assert_eq_int(at_level(s, 0), 144, "level 0: an inner 3 x 1 x 3 snapped out to whole level-1 chunks, 4 x 2 x 4, and a ring: 6 x 4 x 6")
      Test.assert_eq_int(at_level(s, 1), 144, "level 1 likewise, of its own chunks")
      Test.assert_eq_int(at_level(s, 2), 75, "level 2, the top, is not snapped: 5 x 3 x 5")
      Test.assert_eq_int(Sm.loaded_count(s), 363, "nothing else")
      match Sm.take_meshes(s) do
        (s1, ms) ->
          Test.assert_eq_int(mesh_at(ms, 0), 32, "level 0 meshes its inner 4 x 2 x 4")
          Test.assert_eq_int(mesh_at(ms, 1), 28, "level 1 its inner 4 x 2 x 4 less the 2 x 1 x 2 over level 0's")
          Test.assert_eq_int(mesh_at(ms, 2), 5, "and level 2 its inner 3 x 1 x 3 less the 2 x 1 x 2 over level 1's")
          Test.assert_true(mesh_levels(ms), "each mesh carries its key's level")
          let a = at(at(s1, 3200.5, 0.5, 0.5), 300.5, 40.5, -200.5)
          let b = at(at(begin_levels(), -1600.5, 0.5, 1600.5), 300.5, 40.5, -200.5)
          Test.assert_eq_int(Sm.loaded_count(a), Sm.loaded_count(b), "the same chunks")
          Test.assert_eq_int(Sm.world_hash(a), Sm.world_hash(b), "the same world")
          Sm.stop(a)
          Sm.stop(b)
      end
    end

    test "an edit makes its ancestors stale; they regenerate through the pipeline, off the next frame, with the edit coarsened in" do
      let s = at(begin_levels(), 0.5, 0.5, 0.5)
      -- a 2 x 2 x 2 carve aligned to a level-1 voxel, deep in stone
      let o = Ed.fill_box(Sm.world(s), 4, -6, 4, 5, -5, 5, 0)
      let st = Wd.stale(Ed.world(o))
      Test.assert_true(has_key(st, Cd.key_at(0, -1, 0, 1)), "the level-1 ancestor is stale")
      Test.assert_true(has_key(st, Cd.key_at(0, -1, 0, 2)), "and the level-2 one")
      let s1 = Sm.tick(Sm.apply(s, o))
      Test.assert_eq_int(List.length(Wd.stale(Sm.world(s1))), 0, "the stale keys are taken")
      match Sm.pending(s1) do
        (_, gens, _, _) -> Test.assert_eq_int(gens, 2, "a tick later both are still being generated: the tick did not wait for them")
      end
      let old = Strata.Store.get(Wd.chunks(Sm.world(s1)), Cd.key_at(0, -1, 0, 1))
      Test.assert_eq_int(C.get(old, 2, 29, 2), 1, "and the old level-1 chunk is still loaded, without the carve")
      let s2 = Sm.tick(Sm.tick(s1))
      let c1 = Strata.Store.get(Wd.chunks(Sm.world(s2)), Cd.key_at(0, -1, 0, 1))
      Test.assert_eq_int(C.get(c1, 2, 29, 2), 0, "two ticks on, the carve is one air voxel at level 1")
      Test.assert_eq_int(C.get(c1, 3, 29, 2), 1, "its neighbour is stone")
      Test.assert_eq_int(C.get(c1, 2, 28, 2), 1, "and below it")
      let c2 = Strata.Store.get(Wd.chunks(Sm.world(s2)), Cd.key_at(0, -1, 0, 2))
      Test.assert_eq_int(C.get(c2, 1, 30, 1), 1, "at level 2 the stone around it wins")
      Test.assert_true(C.form(c1) != 0, "the level-1 chunk was replaced")
      let s3 = Sm.run_until_settled(s2, 20000)
      Test.assert_true(Sm.settled(s3), "and the stream settles")
      Test.assert_eq_int(C.uniform_id(Wd.coarsen(Sm.world(s3), Cd.key_at(1, -1, 0, 1))), 1, "an ancestor of no edit is the generated chunk")
      Sm.stop(s3)
    end

    test "a stale key edited again before its first result lands: the older result is not applied, and once settled the chunk shows both edits" do
      let s = at(begin_levels(), 0.5, 0.5, 0.5)
      let k1 = Cd.key_at(0, -1, 0, 1)
      let s1 = Sm.tick(Sm.apply(s, Ed.fill_box(Sm.world(s), 4, -6, 4, 5, -5, 5, 0)))
      -- the first carve's tasks are running; a second carve in the same level-1 chunk
      let s2 = Sm.apply(s1, Ed.fill_box(Sm.world(s1), 8, -6, 4, 9, -5, 5, 0))
      let s3 = Sm.tick(Sm.tick(s2))
      -- the first tasks' results (captured before the second carve) land now, with an older stamp
      Test.assert_eq_int(C.get(Strata.Store.get(Wd.chunks(Sm.world(s3)), k1), 2, 29, 2), 1, "the result with the older stamp is not applied")
      let s4 = Sm.run_until_settled(s3, 20000)
      let c1 = Strata.Store.get(Wd.chunks(Sm.world(s4)), k1)
      Test.assert_eq_int(C.get(c1, 2, 29, 2), 0, "the first carve")
      Test.assert_eq_int(C.get(c1, 4, 29, 2), 0, "and the second")
      Test.assert_eq_int(C.get(c1, 3, 29, 2), 1, "stone between them")
      Sm.stop(s4)
    end

    test "a stale key that leaves the box before its task returns: the result is dropped, and coming back generates it with the edit" do
      let s = at(begin_levels(), 0.5, 0.5, 0.5)
      let k1 = Cd.key_at(0, -1, 0, 1)
      let s1 = Sm.tick(Sm.apply(s, Ed.fill_box(Sm.world(s), 4, -6, 4, 5, -5, 5, 0)))
      let far = at(s1, 3200.5, 0.5, 0.5)
      Test.assert_false(Wd.is_loaded(Sm.world(far), k1), "nothing is loaded for it far away")
      Test.assert_eq_int(Sm.loaded_count(far), 363, "only the far boxes")
      let back = at(far, 0.5, 0.5, 0.5)
      Test.assert_eq_int(C.get(Strata.Store.get(Wd.chunks(Sm.world(back)), k1), 2, 29, 2), 0, "back again, it shows the edit")
      Sm.stop(back)
    end

    test "a loaded stale key in the unload band is still refreshed" do
      let s = at(begin_levels(), 0.5, 0.5, 0.5)
      let k1 = Cd.key_at(0, -1, 0, 1)
      let s1 = Sm.apply(s, Ed.fill_box(Sm.world(s), 4, -6, 4, 5, -5, 5, 0))
      -- level-1 chunk 0 is now 3 chunks from the focus's: past its box (2), inside the unload band
      let away = at(s1, 192.5, 0.5, 0.5)
      Test.assert_true(Wd.is_loaded(Sm.world(away), k1), "the stale chunk is kept in the band")
      Test.assert_false(Wd.is_loaded(Sm.world(away), Cd.key(0, -1, 0)), "its edited level-0 chunk has gone to the cache")
      Test.assert_eq_int(C.get(Strata.Store.get(Wd.chunks(Sm.world(away)), k1), 2, 29, 2), 0, "and it was refreshed with the edit")
      Sm.stop(away)
    end
  
    test "each level's meshed inside is whole chunks of the level above, and holds its parents in the next level's" do
      let s = at(begin_levels(), 0.5, 0.5, 0.5)
      let w = Sm.world(s)
      let inner = List.filter(Strata.Store.keys(Wd.chunks(w)), fn k -> Strata.Mesh.has_all(Wd.chunks(w), k))
      let below_top = List.filter(inner, fn k -> Cd.level(k) < 2)
      Test.assert_true(List.all(below_top, fn k -> List.all(Cd.children(Cd.parent(k)), fn c -> Strata.Mesh.has_all(Wd.chunks(w), c))), "every meshable chunk below the top has seven meshable siblings")
      Test.assert_true(List.all(below_top, fn k -> Strata.Mesh.has_all(Wd.chunks(w), Cd.parent(k))), "and a meshable parent")
      -- level 0's inside is -1..1 in x and 0 in y about the focus, snapped out to whole level-1 chunks (-2..1, 0..1), and the box is one more
      Test.assert_true(Wd.is_loaded(w, Cd.key(-3, 0, 0)), "x -1 is snapped out to -2, and the box runs one further")
      Test.assert_false(Wd.is_loaded(w, Cd.key(3, 0, 0)), "x 1 already ends a level-1 chunk: the box ends at 2")
      Test.assert_true(Wd.is_loaded(w, Cd.key(0, 2, 0)), "y 0 is snapped out to 1, and the box runs to 2")
      Test.assert_false(Wd.is_loaded(w, Cd.key(0, -2, 0)), "and down to -1")
      Sm.stop(s)
    end
    test "a coarse chunk over loaded, meshable children is not meshed; once they leave it is" do
      let s = at(Sm.start(Wd.new(reg(), layered(), 7, 1.0), Sm.config_levels(4, 4, 8, 4, 4, 2, 1)), 0.5, 0.5, 0.5)
      Test.assert_eq_int(at_level(s, 0), 1000, "level 0: inside 7 x 7 x 7 snapped to 8 x 8 x 8, and a ring")
      Test.assert_eq_int(at_level(s, 1), 486, "level 1, the top: inside 7 x 3 x 7 grown in y to hold level 0's parents, 7 x 4 x 7, and a ring")
      match Sm.take_meshes(s) do
        (s1, ms) ->
          Test.assert_eq_int(mesh_at(ms, 0), 512, "level 0 meshes its inside, 8 x 8 x 8")
          Test.assert_eq_int(mesh_at(ms, 1), 132, "level 1 its inside, less the 4 x 4 x 4 over level 0's")
          Test.assert_false(has_key(mesh_keys(ms), Cd.key_at(0, 0, 0, 1)), "the level-1 chunk at the focus is not meshed")
          Test.assert_true(has_key(mesh_keys(ms), Cd.key_at(2, 0, 0, 1)), "one over the level-0 edge is")
          -- four chunks on in x: level-0 chunks -5 to -2 go; -1 stays in the band, but without its neighbour it cannot be meshed
          let s2 = at(s1, 128.5, 0.5, 0.5)
          match Sm.take_meshes(s2) do
            (s3, ms2) ->
              Test.assert_true(has_key(mesh_keys(ms2), Cd.key_at(-1, 0, 0, 1)), "the level-1 chunk the fine box left is meshed now")
              Test.assert_false(has_key(mesh_keys(ms2), Cd.key_at(1, 0, 0, 1)), "one still over meshable children is not")
              Test.assert_eq_int(level1_short_of(ms2, 4), 32, "the 2 x 4 x 4 of them that the fine box left, and no other level-1 chunk short of the new edge")
              Sm.stop(s3)
          end
      end
    end
  end
  -- ── Batches: the keys of a chunk column in one task ──────────────────────
  -- a generator whose column function is honest: the chunks `run` gives
  pfn honest() : Strata.Terrain.Gen do
    Strata.Terrain.with_column(layered(), Strata.Terrain.Column(fn (ks, seed) -> List.map(ks, fn k -> Strata.Terrain.run(layered(), k, seed))))
  end
  -- one that tells how it was called (not honest: a probe): every chunk of a call is uniform, id 100 + the keys in the call
  pfn probe() : Strata.Terrain.Gen do
    Strata.Terrain.with_column(terrain(), Strata.Terrain.Column(fn (ks, seed) -> List.map(ks, fn k -> C.uniform(100 + List.length(ks)))))
  end
  pfn begin_with(g : Strata.Terrain.Gen, cap : Int) : Strata.Stream.Stream do
    Sm.start(Wd.new(reg(), g, 7, 1.0), Sm.with_batch(Sm.config_levels(2, 1, 8, 4, 2, 1, 2), cap))
  end
  -- (the lowest uniform id, the highest, how many chunks) over the loaded level-0 chunks
  pfn id_span(s : Strata.Stream.Stream) : (Int, Int, Int) do
    Strata.Store.fold(Wd.chunks(Sm.world(s)), (1000000, 0, 0), fn (acc, _k, c) ->
      match acc do (lo, hi, n) ->
        let id = C.uniform_id(c)
        (if id < lo do id else lo end, if id > hi do id else hi end, n + 1)
      end)
  end
  -- the walk the batch runs take, ending in a hash
  pfn batch_walk(g : Strata.Terrain.Gen, cap : Int) : Int do
    let a = at(at(at(begin_with(g, cap), 0.5, 0.5, 0.5), 3200.5, 0.5, 0.5), 300.5, 40.5, -200.5)
    let h = Sm.world_hash(a)
    Sm.stop(a)
    h
  end
  pfn two_focus(g : Strata.Terrain.Gen, cap : Int) : Int do
    let a = Sm.run_until_settled(Sm.set_focus(begin_with(g, cap), Cons((0.5, 0.5, 0.5), Cons((400.5, 0.5, 0.5), Nil))), 20000)
    let h = Sm.world_hash(a)
    Sm.stop(a)
    h
  end

  describe "Stream batches" do
    test "the default is one key a task, and with_batch clamps below 1" do
      Test.assert_eq_int(Sm.batch(Sm.config(2, 1, 8, 4)), 1, "one key a task")
      Test.assert_eq_int(Sm.batch(Sm.with_batch(Sm.config(2, 1, 8, 4), 0)), 1, "below 1 is 1")
      Test.assert_eq_int(Sm.batch(Sm.with_batch(Sm.config(2, 1, 8, 4), 4)), 4, "as asked")
    end
    test "at cap 1 the column function is given single keys; at cap 4 whole columns go in one call" do
      let one = at(Sm.start(Wd.new(reg(), probe(), 7, 1.0), Sm.with_batch(Sm.config(2, 3, 8, 8), 1)), 0.5, 0.5, 0.5)
      let four = at(Sm.start(Wd.new(reg(), probe(), 7, 1.0), Sm.with_batch(Sm.config(2, 3, 8, 8), 4)), 0.5, 0.5, 0.5)
      match id_span(one) do
        (lo, hi, n) ->
          Test.assert_eq_int(lo, 101, "cap 1: every call held one key")
          Test.assert_eq_int(hi, 101, "none more")
          match id_span(four) do
            (lo4, hi4, n4) ->
              Test.assert_eq_int(n4, n, "the same chunks are loaded either way")
              Test.assert_true(lo4 >= 101, "cap 4: every chunk came from the column function")
              Test.assert_eq_int(hi4, 104, "and some calls held four keys of a column, never more")
          end
      end
      Sm.stop(one)
      Sm.stop(four)
    end
    test "the world is the same at caps 1, 4 and 8, with one focus and with two" do
      let h1 = batch_walk(honest(), 1)
      Test.assert_eq_int(batch_walk(honest(), 4), h1, "cap 4 as cap 1")
      Test.assert_eq_int(batch_walk(honest(), 8), h1, "cap 8 as cap 1")
      Test.assert_eq_int(batch_walk(layered(), 4), h1, "and as a generator with no column function")
      let t1 = two_focus(honest(), 1)
      Test.assert_eq_int(two_focus(honest(), 4), t1, "two focus points, cap 4")
      Test.assert_eq_int(two_focus(honest(), 8), t1, "two focus points, cap 8")
    end
    test "at cap 4 an edit's stale ancestors still regenerate with the edit coarsened in" do
      let s = at(begin_with(honest(), 4), 0.5, 0.5, 0.5)
      let s1 = Sm.run_until_settled(Sm.tick(Sm.apply(s, Ed.fill_box(Sm.world(s), 4, -6, 4, 5, -5, 5, 0))), 20000)
      let c1 = Strata.Store.get(Wd.chunks(Sm.world(s1)), Cd.key_at(0, -1, 0, 1))
      Test.assert_eq_int(C.get(c1, 2, 29, 2), 0, "the carve is one air voxel at level 1")
      Test.assert_eq_int(C.get(c1, 3, 29, 2), 1, "its neighbour is stone")
      let r = at(begin_with(honest(), 1), 0.5, 0.5, 0.5)
      let r1 = Sm.run_until_settled(Sm.tick(Sm.apply(r, Ed.fill_box(Sm.world(r), 4, -6, 4, 5, -5, 5, 0))), 20000)
      Test.assert_eq_int(Sm.world_hash(s1), Sm.world_hash(r1), "the same world as at cap 1")
      Sm.stop(s1)
      Sm.stop(r1)
    end
    test "a focus moved away while batches run: none of their chunks stays, and the world is as going straight there" do
      let s = Sm.tick(Sm.set_focus(begin_with(honest(), 4), Cons((0.5, 0.5, 0.5), Nil)))
      match Sm.pending(s) do
        (_, gens, _, _) -> Test.assert_true(gens > 0, "batches are running")
      end
      let far = at(s, 3200.5, 0.5, 0.5)
      let straight = at(begin_with(honest(), 4), 3200.5, 0.5, 0.5)
      Test.assert_false(Wd.is_loaded(Sm.world(far), Cd.key(0, 0, 0)), "nothing of the first place is loaded")
      Test.assert_eq_int(Sm.loaded_count(far), Sm.loaded_count(straight), "the same chunks")
      Test.assert_eq_int(Sm.world_hash(far), Sm.world_hash(straight), "the same world")
      Test.assert_true(Sm.settled(far), "and nothing is left waiting")
      Sm.stop(far)
      Sm.stop(straight)
    end
    test "regenerate while batches run drops them: every chunk is the new generator's" do
      let s = Sm.tick(Sm.set_focus(begin_with(honest(), 4), Cons((0.5, 0.5, 0.5), Nil)))
      let s1 = Sm.run_until_settled(Sm.regenerate(s, probe()), 20000)
      match id_span(s1) do
        (lo, _, _) -> Test.assert_true(lo >= 101, "no chunk of the old generator is left")
      end
      Sm.stop(s1)
    end
  end
end
