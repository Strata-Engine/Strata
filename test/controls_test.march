mod Strata.Test.Controls do
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Clock
  needs IO.Process
  import Test
  alias Strata.Ui as U

  pfn is(got : (String, Int), text : String, caret : Int) : Bool do
    match got do (t, c) -> t == text && c == caret end
  end

  describe "Slider controls" do
    test "pointer capture clamps to either end and rounds to steps" do
      Test.assert_eq_int(Strata.Controls.slider_step(-5.0, 10.0, 100.0, 5), 0, "before track")
      Test.assert_eq_int(Strata.Controls.slider_step(64.0, 10.0, 100.0, 5), 2, "middle step")
      Test.assert_eq_int(Strata.Controls.slider_step(140.0, 10.0, 100.0, 5), 4, "after track")
      let color = (1.0, 1.0, 1.0, 1.0)
      let ui = Strata.Controls.slider(U.begin(800.0, 600.0, 1.0, 1.0), 10.0, 20.0, 100.0, 4, 5, color, color)
      Test.assert_eq_int(U.quad_count(ui), 2, "track and thumb")
    end
  end
  describe "Base 36 text" do
    test "digits round-trip and respect the length bound" do
      Test.assert_true(Strata.Controls.base36(1295) == "ZZ", "encoded")
      Test.assert_eq_int(Strata.Controls.base36_input(int_shl(1, 35), 0, 0, 35, 2147483646), 1295, "appended")
      Test.assert_eq_int(Strata.Controls.base36_input(int_shl(1, 36), 0, 0, 1295, 2147483646), 35, "backspace")
      Test.assert_eq_int(Strata.Controls.base36_input(1, 0, 0, 2147483646, 2147483646), 2147483646, "bounded")
    end
  end
  describe "Text editing" do
    test "typed characters go in at the caret, in order" do
      Test.assert_true(is(Strata.Controls.text_edit("", 0, [104, 105], 16), "hi", 2), "into nothing")
      Test.assert_true(is(Strata.Controls.text_edit("hd", 1, [101, 108], 16), "held", 3), "in the middle")
      Test.assert_true(is(Strata.Controls.text_edit("ab", 2, Nil, 16), "ab", 2), "no events, no change")
    end

    test "the limit counts characters and stops insertion only" do
      Test.assert_true(is(Strata.Controls.text_edit("abc", 3, [100, 101], 4), "abcd", 4), "one fits")
      Test.assert_true(is(Strata.Controls.text_edit("abcd", 4, [-259, 120], 4), "abcx", 4), "room made by a backspace is used")
      Test.assert_true(is(Strata.Controls.text_edit("éé", 4, [233], 3), "ééé", 6), "two-byte characters count once each")
    end

    test "backspace and delete take a whole character and stop at the ends" do
      Test.assert_true(is(Strata.Controls.text_edit("abc", 2, [-259], 16), "ac", 1), "backspace")
      Test.assert_true(is(Strata.Controls.text_edit("abc", 0, [-259], 16), "abc", 0), "backspace at the start")
      Test.assert_true(is(Strata.Controls.text_edit("abc", 1, [-261], 16), "ac", 1), "delete")
      Test.assert_true(is(Strata.Controls.text_edit("abc", 3, [-261], 16), "abc", 3), "delete at the end")
      Test.assert_true(is(Strata.Controls.text_edit("aéb", 3, [-259], 16), "ab", 1), "backspace over two bytes")
      Test.assert_true(is(Strata.Controls.text_edit("a世b", 1, [-261], 16), "ab", 1), "delete over three bytes")
    end

    test "the caret moves by characters and to either end" do
      Test.assert_true(is(Strata.Controls.text_edit("aéb", 3, [-263], 16), "aéb", 1), "left over two bytes")
      Test.assert_true(is(Strata.Controls.text_edit("aéb", 1, [-262], 16), "aéb", 3), "right over two bytes")
      Test.assert_true(is(Strata.Controls.text_edit("abc", 0, [-263], 16), "abc", 0), "left at the start")
      Test.assert_true(is(Strata.Controls.text_edit("abc", 3, [-262], 16), "abc", 3), "right at the end")
      Test.assert_true(is(Strata.Controls.text_edit("abc", 2, [-268, 120], 16), "xabc", 1), "home, then type")
      Test.assert_true(is(Strata.Controls.text_edit("abc", 1, [-269, 120], 16), "abcx", 4), "end, then type")
    end

    test "characters beyond ASCII are encoded as UTF-8" do
      Test.assert_true(is(Strata.Controls.text_edit("", 0, [233], 16), "é", 2), "two bytes")
      Test.assert_true(is(Strata.Controls.text_edit("", 0, [19990], 16), "世", 3), "three bytes")
      Test.assert_true(is(Strata.Controls.text_edit("", 0, [128512], 16), "😀", 4), "four bytes")
    end

    test "a caret out of range or inside a character is moved to where it may be" do
      Test.assert_true(is(Strata.Controls.text_edit("ab", 9, [120], 16), "abx", 3), "past the end")
      Test.assert_true(is(Strata.Controls.text_edit("ab", -4, [120], 16), "xab", 1), "before the start")
      Test.assert_true(is(Strata.Controls.text_edit("aéb", 2, [120], 16), "axéb", 2), "inside the two-byte character")
    end

    test "control characters and other keys are passed over" do
      Test.assert_true(is(Strata.Controls.text_edit("ab", 2, [-257, -256, -258, 9, 13, 127, 0, -340], 16), "ab", 2), "enter, escape, tab and the rest")
    end
  end
end
