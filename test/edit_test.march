-- Edit.blast: a carve sphere whose radius varies by direction, dirtying
-- only the chunks it touches, the same crater for the same seed.
mod Strata.Test.Edit do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias Strata.World as Wd
  alias Strata.Edit as Ed
  alias Strata.Coord as Cd
  alias Strata.Chunk as C
  alias Strata.Blocks as B

  pfn reg() : Strata.Blocks.Registry do
    match B.register(B.empty(), B.def()) do
      Ok((r, _)) -> r
      Err(_) -> B.empty()
    end
  end
  -- solid stone everywhere
  pfn solid() : Strata.World.World do Wd.new(reg(), Strata.Terrain.gen(fn (k, seed) -> C.uniform(1)), 7, 1.0) end
  pfn load(w : Strata.World.World, cx : Int, cy : Int, cz : Int) : Strata.World.World do
    let k = Cd.key(cx, cy, cz)
    Wd.insert(w, k, Strata.Terrain.run(Wd.terrain(w), k, Wd.seed(w)))
  end
  -- the 4 x 4 x 4 box of chunks -2..1 on each axis
  pfn load_box(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 64 do w else load_box(load(w, i % 4 - 2, (i / 4) % 4 - 2, i / 16 - 2), i + 1) end
  end
  pfn has_key(l : List(Strata.Coord.Key), k : Strata.Coord.Key) : Bool do
    match l do
      Nil -> false
      Cons(h, t) -> if Cd.key_eq(h, k) do true else has_key(t, k) end
    end
  end

  -- the air voxels in the cube of half-side n about (cx, cy, cz): count, and the farthest one's squared distance
  pfn carved(w : Strata.World.World, cx : Int, cy : Int, cz : Int, n : Int, i : Int, cnt : Int, far : Int) : (Int, Int) do
    let side = 2 * n + 1
    if i >= side * side * side do (cnt, far)
    else
      let dx = i % side - n
      let dy = (i / side) % side - n
      let dz = i / (side * side) - n
      if Wd.get_block(w, cx + dx, cy + dy, cz + dz) != 0 do carved(w, cx, cy, cz, n, i + 1, cnt, far)
      else
        let d2 = dx * dx + dy * dy + dz * dz
        carved(w, cx, cy, cz, n, i + 1, cnt + 1, if d2 > far do d2 else far end)
      end
    end
  end
  -- do two worlds hold the same blocks over the cube of half-side n about (cx, cy, cz)?
  pfn same(a : Strata.World.World, b : Strata.World.World, cx : Int, cy : Int, cz : Int, n : Int, i : Int) : Bool do
    let side = 2 * n + 1
    if i >= side * side * side do true
    else
      let x = cx + i % side - n
      let y = cy + (i / side) % side - n
      let z = cz + i / (side * side) - n
      if Wd.get_block(a, x, y, z) != Wd.get_block(b, x, y, z) do false else same(a, b, cx, cy, cz, n, i + 1) end
    end
  end

  -- voxel k of the integer segment from the centre to (dx, dy, dz): k / n of each coordinate rounded half up, n the largest |coordinate|
  pfn fdv(a : Int, b : Int) : Int do if a >= 0 do a / b else 0 - ((b - 1 - a) / b) end end
  pfn seg_at(dx : Int, dy : Int, dz : Int, k : Int, n : Int) : (Int, Int, Int) do (fdv(2 * k * dx + n, 2 * n), fdv(2 * k * dy + n, 2 * n), fdv(2 * k * dz + n, 2 * n)) end
  pfn absv(v : Int) : Int do if v < 0 do 0 - v else v end end
  -- carved voxels in the cube of half-side m about (cx, cy, cz) one of whose segment voxels toward the centre is not carved
  pfn holes(w : Strata.World.World, cx : Int, cy : Int, cz : Int, m : Int, i : Int, bad : Int) : Int do
    let side = 2 * m + 1
    if i >= side * side * side do bad
    else
      let dx = i % side - m
      let dy = (i / side) % side - m
      let dz = i / (side * side) - m
      if Wd.get_block(w, cx + dx, cy + dy, cz + dz) != 0 do holes(w, cx, cy, cz, m, i + 1, bad)
      else
        let n = if absv(dx) > absv(dy) do (if absv(dx) > absv(dz) do absv(dx) else absv(dz) end) else (if absv(dy) > absv(dz) do absv(dy) else absv(dz) end) end
        let ok = List.all(List.range(0, n), fn k -> match seg_at(dx, dy, dz, k, n) do (x, y, z) -> Wd.get_block(w, cx + x, cy + y, cz + z) == 0 end)
        holes(w, cx, cy, cz, m, i + 1, if ok do bad else bad + 1 end)
      end
    end
  end
  -- the chunks the cells of a blast touch, a cell on a chunk face reaching across it: what its dirty set must be
  pfn touched(w : Strata.World.World, cx : Int, cy : Int, cz : Int, m : Int) : List(Strata.Coord.Key) do
    let side = 2 * m + 1
    List.fold_left(List.range(0, side * side * side), Nil, fn (acc, i) -> touch_one(w, cx + i % side - m, cy + (i / side) % side - m, cz + i / (side * side) - m, acc))
  end
  pfn touch_one(w : Strata.World.World, x : Int, y : Int, z : Int, acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    if Wd.get_block(w, x, y, z) != 0 do acc
    else List.fold_left(List.range(0, 27), acc, fn (a2, j) -> add_key(a2, Cd.key_of_voxel(x + j % 3 - 1, y + (j / 3) % 3 - 1, z + j / 9 - 1)))
  end
  end
  pfn add_key(l : List(Strata.Coord.Key), k : Strata.Coord.Key) : List(Strata.Coord.Key) do if has_key(l, k) do l else Cons(k, l) end end
  pfn same_keys(a : List(Strata.Coord.Key), b : List(Strata.Coord.Key)) : Bool do
    if List.length(a) != List.length(b) do false else List.all(a, fn k -> has_key(b, k)) end
  end

  describe "Edit.blast" do
    test "a blast on a chunk border dirties exactly the two chunks it touches" do
      let o = Ed.blast(load_box(solid(), 0), 0, 16, 16, 4, 11, 0)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 2, "two chunks")
      Test.assert_true(has_key(Ed.dirty(o), Cd.key(0, 0, 0)), "the +x one")
      Test.assert_true(has_key(Ed.dirty(o), Cd.key(-1, 0, 0)), "the -x one")
      Test.assert_true(List.length(Ed.changes(o)) > 100, "every carved voxel is recorded")
    end
    test "a blast inside one chunk dirties that chunk alone" do
      let o = Ed.blast(load_box(solid(), 0), 16, 16, 16, 6, 11, 0)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 1, "one chunk")
      Test.assert_true(has_key(Ed.dirty(o), Cd.key(0, 0, 0)), "its own")
    end
    test "the same seed gives the same crater, another seed another" do
      let w = load_box(solid(), 0)
      let a = Ed.world(Ed.blast(w, 3, 5, -4, 6, 11, 0))
      let b = Ed.world(Ed.blast(w, 3, 5, -4, 6, 11, 0))
      let c = Ed.world(Ed.blast(w, 3, 5, -4, 6, 12, 0))
      Test.assert_true(same(a, b, 3, 5, -4, 9, 0), "seed 11 twice: the same voxels")
      Test.assert_false(same(a, c, 3, 5, -4, 9, 0), "seeds 11 and 12 differ")
    end
    test "the radius never exceeds 1.3 times the given, and the crater is not a ball" do
      let w = load_box(solid(), 0)
      let ok = List.all(List.range(1, 9), fn s ->
        match carved(Ed.world(Ed.blast(w, 0, 0, 0, 7, s, 0)), 0, 0, 0, 12, 0, 0, 0) do
          (cnt, far) -> cnt > 0 && far * 100 <= 7 * 7 * 169
        end)
      Test.assert_true(ok, "no carved voxel beyond 9.1 from the centre, over 8 seeds")
      let ball = carved(Ed.world(Ed.fill_sphere(w, 0, 0, 0, 7, 0)), 0, 0, 0, 12, 0, 0, 0)
      let crater = carved(Ed.world(Ed.blast(w, 0, 0, 0, 7, 11, 0)), 0, 0, 0, 12, 0, 0, 0)
      Test.assert_true(match (ball, crater) do ((n1, _), (n2, _)) -> n1 != n2 end, "a different set of voxels from the sphere")
    end
    test "50 craters are star-shaped, within 1.3 radii, and dirty exactly the chunks they touch" do
      let w = load_box(solid(), 0)
      let rs = List.map(List.range(0, 50), fn s ->
        let r = 3 + s % 6
        let cx = (s * 7) % 23 - 11
        let cy = (s * 5) % 19 - 9
        let cz = (s * 3) % 17 - 8
        let o = Ed.blast(w, cx, cy, cz, r, 100 + s, 0)
        let w2 = Ed.world(o)
        let m = (13 * r + 9) / 10 + 1
        match carved(w2, cx, cy, cz, m, 0, 0, 0) do
          (cnt, far) -> (holes(w2, cx, cy, cz, m, 0, 0), if cnt > 0 do far * 100 <= r * r * 169 else false end, same_keys(Ed.dirty(o), touched(w2, cx, cy, cz, m)))
        end)
      Test.assert_eq_int(List.fold_left(rs, 0, fn (a, t) -> match t do (h, _, _) -> a + h end), 0, "every voxel on a carved voxel's segment to the centre is carved")
      Test.assert_true(List.all(rs, fn t -> match t do (_, ok, _) -> ok end), "every crater carves something, none past 1.3 radii")
      Test.assert_true(List.all(rs, fn t -> match t do (_, _, ok) -> ok end), "the dirty set is exactly the chunks the carved voxels touch")
    end
    test "a negative radius is no edit" do
      let o = Ed.blast(load_box(solid(), 0), 0, 0, 0, -1, 11, 0)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 0, "nothing dirty")
      Test.assert_eq_int(List.length(Ed.changes(o)), 0, "nothing recorded")
    end
    test "unsupported: what an edit left hanging is the block over the hole, and only that" do
      let w = load_box(solid(), 0)
      let o = Ed.set_block(w, 0, 0, 0, 0)
      let all_need = fn id -> id == 1
      let holds = fn id -> id != 0
      Test.assert_true(Ed.unsupported(Ed.world(o), Ed.changes(o), all_need, holds) == [(0, 1, 0, 0)], "the cell over the dug one, to be set to air")
      Test.assert_true(Ed.unsupported(Ed.world(o), Ed.changes(o), fn _ -> false, holds) == Nil, "nothing when no block needs a floor")
      Test.assert_true(Ed.unsupported(Ed.world(o), Ed.changes(o), all_need, fn _ -> true) == Nil, "nothing when air holds things up")
      -- a box dug out: every cell of the layer over it hangs
      let o2 = Ed.fill_box(w, 0, 0, 0, 2, 0, 1, 0)
      Test.assert_eq_int(List.length(Ed.unsupported(Ed.world(o2), Ed.changes(o2), all_need, holds)), 6, "the six cells over a 3 x 1 x 2 hole")
    end
  end

  -- ── Edit.stamp ──
  pfn air() : Strata.World.World do load_box(Wd.new(reg(), Strata.Terrain.gen(fn (k, seed) -> C.uniform(0)), 7, 1.0), 0) end
  pfn tmpl(sx : Int, sy : Int, sz : Int, ids : List(Int)) : Strata.Template.Template do
    Strata.Template.make(sx, sy, sz, List.fold_left(List.range(0, sx * sy * sz), NativeArray.make_i32(sx * sy * sz, 0), fn (a, i) -> NativeArray.set_i32(a, i, List.nth(ids, i))), 1.0)
  end

  describe "Edit.stamp" do
    test "stamping a template writes its blocks at the origin" do
      let w = Ed.world(Ed.stamp(air(), tmpl(2, 1, 1, [3, 4]), 5, 6, 7, 0, 0))
      Test.assert_true(Wd.get_block(w, 5, 6, 7) == 3 && Wd.get_block(w, 6, 6, 7) == 4 && Wd.get_block(w, 7, 6, 7) == 0, "3 then 4")
    end
    test "holes keep the world" do
      let o = Ed.stamp(load_box(solid(), 0), tmpl(2, 1, 1, [3, 0]), 5, 6, 7, 0, 0)
      Test.assert_true(Wd.get_block(Ed.world(o), 5, 6, 7) == 3 && Wd.get_block(Ed.world(o), 6, 6, 7) == 1 && List.length(Ed.changes(o)) == 1, "the hole left stone, one change")
    end
    test "a stamp across a chunk border marks both chunks dirty" do
      let d = Ed.dirty(Ed.stamp(air(), tmpl(2, 1, 1, [3, 4]), 31, 0, 0, 0, 0))
      Test.assert_true(has_key(d, Cd.key(0, 0, 0)) && has_key(d, Cd.key(1, 0, 0)), "both chunks")
    end
    test "a quarter turn matches blit's" do
      let t = tmpl(3, 1, 2, [1, 2, 3, 4, 5, 6])
      let w = Ed.world(Ed.stamp(air(), t, 4, 4, 4, 1, 0))
      let c = Strata.Template.blit(C.uniform(0), Cd.key(0, 0, 0), t, 4, 4, 4, 1, 0)
      Test.assert_true(List.all(List.range(0, 64), fn i -> Wd.get_block(w, i % 8, 4, i / 8) == C.get(c, i % 8, 4, i / 8)), "the same cells")
    end
  end
end
