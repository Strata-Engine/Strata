-- Weather: the drawn sky eases toward the wanted one, the ground stays wet
-- after rain, and a storm throws lightning the same way every time.
mod WeatherTest do
  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  needs IO.Spawn

  alias Strata.Weather as W

  pfn storm() : Strata.Weather.Sky do { overcast: 1.0, rain: 1.0, storm: 1.0, wind_x: 4.0, wind_z: -2.0 } end
  pfn rainy() : Strata.Weather.Sky do { overcast: 0.9, rain: 0.8, storm: 0.0, wind_x: 0.0, wind_z: 0.0 } end
  -- [steps] frames of [dt] seconds
  pfn run(w : Strata.Weather.Weather, dt : Float, steps : Int) : Strata.Weather.Weather do if steps <= 0 do w else run(W.step(w, dt), dt, steps - 1) end end

  describe "Strata.Weather" do
    test "cloud gathers gradually, not at once" do
      let w = W.want(W.new(1), rainy())
      let soon = W.now(run(w, 0.1, 10))
      let later = W.now(run(w, 0.1, 600))
      Test.assert_true(soon.overcast > 0.0 && soon.overcast < 0.2, "a second in, the sky has only begun to cloud")
      Test.assert_true(later.overcast > 0.85, "a minute in, it is overcast")
    end
    test "rain sets in faster than cloud" do
      let s = W.now(run(W.want(W.new(1), rainy()), 0.1, 50))
      Test.assert_true(s.rain /. 0.8 > s.overcast /. 0.9, "rain is further along than cloud")
    end
    test "the ground stays wet after rain stops, and dries" do
      let soaked = run(W.want(W.new(1), rainy()), 0.1, 600)
      Test.assert_true(W.wet(soaked) > 0.9, "soaked by a minute of rain")
      let after = run(W.want(soaked, W.clear()), 0.1, 300)
      let after_sky = W.now(after)
      Test.assert_true(after_sky.rain < 0.01, "the rain has stopped")
      Test.assert_true(W.wet(after) > 0.5, "half a minute later the ground is still wet")
      Test.assert_true(W.wet(run(after, 0.5, 600)) == 0.0, "five minutes later it is dry")
    end
    test "a settled sky needs no easing" do
      let w = W.settled(1, rainy())
      let sky = W.now(w)
      Test.assert_true(sky.overcast == 0.9 && W.wet(w) > 0.9, "overcast and wet from the first frame")
    end
    test "a storm throws lightning, the same strikes every time" do
      let a = run(W.settled(7, storm()), 0.05, 1200)
      let b = run(W.settled(7, storm()), 0.05, 1200)
      Test.assert_true(W.strikes(a) >= 3, "a minute of storm strikes several times")
      Test.assert_true(W.strikes(a) == W.strikes(b), "deterministic")
      Test.assert_true(W.strikes(run(W.settled(7, rainy()), 0.05, 1200)) == 0, "rain without storm throws none")
    end
    test "a flash fades within half a second" do
      let struck = run(W.settled(7, storm()), 0.05, 1200)
      let quiet = run(W.want(struck, rainy()), 0.05, 400)
      Test.assert_true(W.flash(quiet) < 0.01, "dark again once the storm passes")
    end
    test "a paced sky changes on the game's clock, and holds while paused" do
      let w = W.want(W.paced(W.new(1), 0.9, 0.45, 4.0), rainy())
      let day = W.now(W.step_eased(w, 0.05, 1.8))
      Test.assert_true(day.overcast > 0.75, "overcast within a short game day")
      let held = W.step_eased(w, 5.0, 0.0)
      let held_sky = W.now(held)
      Test.assert_true(held_sky.overcast == 0.0, "paused: no change")
      Test.assert_true(held.clock == 5.0, "but the rain's clock runs")
    end
    test "cloud and rain dim the sun and draw in the fog" do
      let clear = W.new(1)
      let wet = W.settled(1, storm())
      Test.assert_true(W.light(clear) == 1.0 && W.light(wet) < 0.35, "a storm lets little sun through")
      let (_, stop) = W.fog(wet, 270.0, 650.0)
      Test.assert_true(stop < 450.0, "the far fog draws in")
    end
  end
end
