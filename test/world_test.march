-- World and Edit: loading, caching edited chunks, single and bulk edits,
-- dirty sets, change records, and edits queued for chunks not yet loaded.
mod Strata.Test.World do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  import Test
  alias Strata.World as Wd
  alias Strata.Edit as Ed
  alias Strata.Coord as Cd
  alias Strata.Chunk as C
  alias Strata.Blocks as B

  -- stone (id 1) below y = 0, air above
  pfn flat() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) -> if Cd.ky(k) < 0 do C.uniform(1) else C.uniform(0) end)
  end
  pfn reg() : Strata.Blocks.Registry do
    match B.register(B.empty(), B.def()) do
      Ok((r, _)) -> r
      Err(_) -> B.empty()
    end
  end
  pfn fresh() : Strata.World.World do Wd.new(reg(), flat(), 7, 1.0) end

  pfn load(w : Strata.World.World, cx : Int, cy : Int, cz : Int) : Strata.World.World do
    let k = Cd.key(cx, cy, cz)
    Wd.insert(w, k, Strata.Terrain.run(Wd.terrain(w), k, Wd.seed(w)))
  end
  -- load the 4 x 4 x 4 box of chunks -2..1 on each axis
  pfn load_box(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 64 do w else load_box(load(w, i % 4 - 2, (i / 4) % 4 - 2, i / 16 - 2), i + 1) end
  end
  pfn has_key(l : List(Strata.Coord.Key), k : Strata.Coord.Key) : Bool do
    match l do
      Nil -> false
      Cons(h, t) -> if Cd.key_eq(h, k) do true else has_key(t, k) end
    end
  end
  pfn no_dups(l : List(Strata.Coord.Key)) : Bool do
    match l do
      Nil -> true
      Cons(h, t) -> if has_key(t, h) do false else no_dups(t) end
    end
  end

  pfn apply_each(w : Strata.World.World, cells : List((Int, Int, Int, Int))) : Strata.World.World do
    match cells do
      Nil -> w
      Cons((x, y, z, id), t) -> apply_each(Ed.world(Ed.set_block(w, x, y, z, id)), t)
    end
  end
  pfn same_blocks(a : Strata.World.World, b : Strata.World.World, cells : List((Int, Int, Int, Int))) : Bool do
    match cells do
      Nil -> true
      Cons((x, y, z, _), t) -> if Wd.get_block(a, x, y, z) == Wd.get_block(b, x, y, z) do same_blocks(a, b, t) else false end
    end
  end

  -- the changes and dirty chunks of setting each cell in turn
  pfn merge_keys(a : List(Strata.Coord.Key), b : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    match b do
      Nil -> a
      Cons(k, t) -> merge_keys(if has_key(a, k) do a else Cons(k, a) end, t)
    end
  end
  pfn each_outcome(w : Strata.World.World, cells : List((Int, Int, Int, Int)), n : Int, dirty : List(Strata.Coord.Key)) : (Int, List(Strata.Coord.Key)) do
    match cells do
      Nil -> (n, dirty)
      Cons((x, y, z, id), t) ->
        let o = Ed.set_block(w, x, y, z, id)
        each_outcome(Ed.world(o), t, n + List.length(Ed.changes(o)), merge_keys(dirty, Ed.dirty(o)))
    end
  end
  pfn all_in(a : List(Strata.Coord.Key), b : List(Strata.Coord.Key)) : Bool do
    match a do
      Nil -> true
      Cons(k, t) -> if has_key(b, k) do all_in(t, b) else false end
    end
  end

  pfn head_kind(l : List(Strata.Edit.Change)) : Int do
    match l do
      Nil -> -1
      Cons(c, _) -> Ed.kind(c)
    end
  end
  pfn head_old(l : List(Strata.Edit.Change)) : Int do
    match l do
      Nil -> -1
      Cons(c, _) -> Ed.old_id(c)
    end
  end
  pfn head_new(l : List(Strata.Edit.Change)) : Int do
    match l do
      Nil -> -1
      Cons(c, _) -> Ed.new_id(c)
    end
  end

  pfn flat4(p : ((Int, Int), (Int, Int))) : (Int, Int, Int, Int) do
    match p do
      ((x, y), (z, id)) -> (x, y, z, id)
    end
  end

  -- ── Levels ───────────────────────────────────────────────────────────────
  -- 1 stone, 2..9 a fluid (9 full), 10 tall grass (a cross)
  pfn reg3() : Strata.Blocks.Registry do
    let water = B.with_layer(B.with_opacity(B.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent)
    let grass = B.with_collide(B.with_style(B.with_opacity(B.def(), Strata.Blocks.Clear), Strata.Blocks.Cross), false)
    match B.register(B.empty(), B.def()) do
      Ok((r1, _)) ->
        match B.register_fluid(r1, water) do
          Ok((r2, _)) ->
            match B.register(r2, grass) do
              Ok((r3, _)) -> r3
              Err(_) -> r2
            end
          Err(_) -> r1
        end
      Err(_) -> B.empty()
    end
  end
  -- stone below y = 0 at levels 0..2
  pfn flat_levels() : Strata.Terrain.Gen do
    Strata.Terrain.gen_levels(fn (k, seed) -> if Cd.ky(k) < 0 do C.uniform(1) else C.uniform(0) end, 2)
  end
  pfn load_key(w : Strata.World.World, k : Strata.Coord.Key) : Strata.World.World do
    Wd.insert(w, k, Strata.Terrain.run(Wd.terrain(w), k, Wd.seed(w)))
  end
  -- 20 of the 64 level-0 chunks under level-2 key (0, -1, 0): loaded, each with a 4-cube carved at its corner
  pfn carve20(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 20 do w
    else
      let cx = i % 4
      let cy = 0 - 1 - (i / 4) % 4
      let cz = i / 16
      let w1 = load_key(w, Cd.key(cx, cy, cz))
      carve20(Ed.world(Ed.fill_box(w1, 32 * cx + 4 * (i % 8), 32 * cy + 8, 32 * cz + 4, 32 * cx + 4 * (i % 8) + 3, 32 * cy + 11, 32 * cz + 7, 0)), i + 1)
    end
  end
  pfn same_chunk(a : Strata.Chunk.Chunk, b : Strata.Chunk.Chunk, i : Int) : Bool do
    if i >= 32768 do true
    else if C.get_or(a, i % 32, i / 1024, (i / 32) % 32, -1) != C.get_or(b, i % 32, i / 1024, (i / 32) % 32, -1) do false
    else same_chunk(a, b, i + 1) end end
  end
  pfn count_air(c : Strata.Chunk.Chunk, i : Int, n : Int) : Int do
    if i >= 32768 do n else count_air(c, i + 1, if C.get_or(c, i % 32, i / 1024, (i / 32) % 32, -1) == 0 do n + 1 else n end) end
  end

  describe "World levels" do
    test "coarsening: solid cube blocks win, then a fluid as a full voxel, then air; a cross counts as air" do
      let w0 = load_key(Wd.new(reg3(), flat_levels(), 7, 1.0), Cd.key(0, 0, 0))
      -- cube (0..1)^3: one tall grass; cube x 2..3: water (a part state) and air; cube x 4..5: two water, one stone, one grass
      let cells = Cons((0, 0, 0, 10), Cons((2, 0, 0, 4), Cons((4, 0, 0, 1), Cons((5, 0, 0, 3), Cons((4, 1, 0, 3), Cons((5, 1, 1, 10), Nil))))))
      let w = Ed.world(Ed.set_many(w0, cells))
      Test.assert_true(Wd.is_edited(w, Cd.key(0, 0, 0)), "the fine chunk is edited")
      let c = Wd.coarsen(w, Cd.key_at(0, 0, 0, 1))
      Test.assert_eq_int(C.get(c, 0, 0, 0), 0, "a lone cross in air coarsens to air")
      Test.assert_eq_int(C.get(c, 1, 0, 0), 9, "water and air coarsen to water, a full voxel of its family")
      Test.assert_eq_int(C.get(c, 2, 0, 0), 1, "stone, water and grass coarsen to stone, though water is the commoner")
      Test.assert_eq_int(C.get(c, 3, 0, 0), 0, "an untouched cube of air stays air")
    end
    test "a coarse chunk is put as given; coarsen_over on the edits captured gives World.coarsen's chunk" do
      let w = carve20(Wd.new(reg3(), flat_levels(), 7, 1.0), 0)
      let k = Cd.key_at(0, -1, 0, 2)
      let fines = Wd.edits_under(w, k)
      Test.assert_eq_int(List.length(fines), 20, "20 edited fine chunks captured")
      let generated = Strata.Terrain.run(Wd.terrain(w), k, Wd.seed(w))
      let plain = Strata.Store.get(Wd.chunks(Wd.insert(w, k, generated)), k)
      Test.assert_eq_int(C.uniform_id(plain), 1, "insert does no coarsening: the generated chunk as it was given")
      -- what a worker task does
      let made = Wd.coarsen_over(Wd.registry(w), k, generated, fines)
      let put = Strata.Store.get(Wd.chunks(Wd.insert(w, k, made)), k)
      Test.assert_true(same_chunk(put, Wd.coarsen(w, k), 0), "equal to World.coarsen")
      Test.assert_eq_int(count_air(put, 0, 0), 20, "each carve one air voxel at level 2")
    end
  end

  -- ── What a store reads: the change log, region values, release ──────────
  pfn count_key(l : List(Strata.Coord.Key), k : Strata.Coord.Key) : Int do
    List.fold_left(l, 0, fn (n, h) -> if Cd.key_eq(h, k) do n + 1 else n end)
  end
  pfn chunk_for(l : List((Strata.Coord.Key, Strata.Chunk.Chunk)), k : Strata.Coord.Key) : Option(Strata.Chunk.Chunk) do
    match l do
      Nil -> None
      Cons((h, c), t) -> if Cd.key_eq(h, k) do Some(c) else chunk_for(t, k) end
    end
  end
  pfn ops_for(l : List((Strata.Coord.Key, List(Strata.World.Op))), k : Strata.Coord.Key) : Option(List(Strata.World.Op)) do
    match l do
      Nil -> None
      Cons((h, ops), t) -> if Cd.key_eq(h, k) do Some(ops) else ops_for(t, k) end
    end
  end
  -- the tag of the first op, -1 if none
  pfn first_tag(ops : List(Strata.World.Op)) : Int do
    match ops do
      Nil -> -1
      Cons(o, _) ->
        match Wd.op_fields(o) do
          (tag, _) -> tag
        end
    end
  end
  -- the hash of the chunk region_values gives for k, -1 if none
  pfn value_hash(w : Strata.World.World, k : Strata.Coord.Key) : Int do
    match Wd.region_values(w, Cons(k, Nil)) do
      (cs, _) ->
        match chunk_for(cs, k) do
          Some(c) -> C.hash(c)
          None -> -1
        end
    end
  end
  -- the coarse chunk of coarse key p as the far field builds it on a worker
  pfn far(w : Strata.World.World, p : Strata.Coord.Key) : Strata.Chunk.Chunk do
    Wd.coarsen_over(Wd.registry(w), p, Strata.Terrain.run(Wd.terrain(w), p, Wd.seed(w)), Wd.edits_under(w, p))
  end

  describe "World change log" do
    test "with the log off, edits, unloads and queued edits record nothing" do
      let w = load(fresh(), 0, -1, 0)
      let e = Ed.world(Ed.set_block(Ed.world(Ed.set_block(w, 5, -5, 5, 0)), 40, -5, 5, 0))
      let u = Wd.unload(e, Cd.key(0, -1, 0))
      match Wd.take_changes(u) do
        (_, ks) -> Test.assert_eq_int(List.length(ks), 0, "nothing recorded while the log is off")
      end
    end
    test "with the log on, an edit, a queued edit and an unload of an edited chunk each appear once; a second take is empty" do
      let w = Wd.log_changes(load(load(fresh(), 0, -1, 0), 2, -1, 0), true)
      -- a cell edit in loaded (0, -1, 0), twice; an edit queued for unloaded (1, -1, 0)
      let e = Ed.world(Ed.set_block(Ed.world(Ed.set_block(Ed.world(Ed.set_block(w, 5, -5, 5, 0)), 6, -5, 5, 0)), 40, -5, 5, 0))
      match Wd.take_changes(e) do
        (e2, ks) ->
          Test.assert_eq_int(List.length(ks), 2, "two keys")
          Test.assert_eq_int(count_key(ks, Cd.key(0, -1, 0)), 1, "the loaded chunk's edits, once")
          Test.assert_eq_int(count_key(ks, Cd.key(1, -1, 0)), 1, "the queued edit")
          match Wd.take_changes(e2) do
            (e3, ks2) ->
              Test.assert_eq_int(List.length(ks2), 0, "a second take is empty")
              -- an edited chunk unloaded; an untouched one unloaded
              let u = Wd.unload(Wd.unload(e3, Cd.key(0, -1, 0)), Cd.key(2, -1, 0))
              match Wd.take_changes(u) do
                (_, ks3) ->
                  Test.assert_eq_int(List.length(ks3), 1, "the unload of the edited chunk alone")
                  Test.assert_eq_int(count_key(ks3, Cd.key(0, -1, 0)), 1, "once")
              end
          end
      end
    end
    test "a chunk edited back to its generation is recorded, and turning the log off drops it" do
      let w = Wd.log_changes(load(fresh(), 0, -1, 0), true)
      match Wd.take_changes(Ed.world(Ed.set_block(w, 5, -5, 5, 0))) do
        (e, _) ->
          let back = Ed.world(Ed.set_block(e, 5, -5, 5, 1))
          Test.assert_false(Wd.is_edited(back, Cd.key(0, -1, 0)), "edited back")
          match Wd.take_changes(back) do
            (_, ks) -> Test.assert_eq_int(count_key(ks, Cd.key(0, -1, 0)), 1, "recorded, so a store deletes its saved copy")
          end
          match Wd.take_changes(Wd.log_changes(Wd.log_changes(back, false), true)) do
            (_, ks) -> Test.assert_eq_int(List.length(ks), 0, "off and on again: nothing kept from before")
          end
      end
    end
  end

  describe "World region values" do
    test "an edited loaded chunk compacted, a cached chunk, a queue in order, nothing for a chunk edited back" do
      let w = load(load(load(fresh(), 0, -1, 0), 1, -1, 0), 2, -1, 0)
      -- (0, -1, 0) edited and kept loaded; (1, -1, 0) edited and unloaded to the cache;
      -- (2, -1, 0) edited back; (3, -1, 0) not loaded: two edits queued
      let e1 = Ed.world(Ed.set_block(Ed.world(Ed.set_block(w, 5, -5, 5, 0)), 37, -5, 5, 0))
      let e2 = Ed.world(Ed.set_block(Ed.world(Ed.set_block(e1, 69, -5, 5, 0)), 69, -5, 5, 1))
      let e3 = Ed.world(Ed.set_block(Ed.world(Ed.fill_box(e2, 100, -9, 4, 101, -8, 5, 0)), 102, -5, 5, 0))
      let v = Wd.unload(e3, Cd.key(1, -1, 0))
      let keys = Cons(Cd.key(0, -1, 0), Cons(Cd.key(1, -1, 0), Cons(Cd.key(2, -1, 0), Cons(Cd.key(3, -1, 0), Cons(Cd.key(4, -1, 0), Nil)))))
      match Wd.region_values(v, keys) do
        (cs, qs) ->
          Test.assert_eq_int(List.length(cs), 2, "two chunks")
          match chunk_for(cs, Cd.key(0, -1, 0)) do
            Some(c) ->
              Test.assert_eq_int(C.get(c, 5, 27, 5), 0, "the loaded chunk with its edit")
              Test.assert_eq_int(C.form(c), C.form(C.compact(c)), "compacted")
            None -> Test.fail("the loaded edited chunk")
          end
          match chunk_for(cs, Cd.key(1, -1, 0)) do
            Some(c) -> Test.assert_eq_int(C.get(c, 5, 27, 5), 0, "the cached chunk with its edit")
            None -> Test.fail("the cached chunk")
          end
          Test.assert_true(Option.is_none(chunk_for(cs, Cd.key(2, -1, 0))), "nothing for a chunk edited back")
          Test.assert_eq_int(List.length(qs), 1, "one queue")
          match ops_for(qs, Cd.key(3, -1, 0)) do
            Some(ops) ->
              Test.assert_eq_int(List.length(ops), 2, "two queued edits")
              Test.assert_eq_int(first_tag(ops), 1, "in the order they were made: the box first")
            None -> Test.fail("the queue")
          end
      end
    end
  end

  describe "World release" do
    test "a written chunk is released for its coarse copy; one edited since the write is kept" do
      let k = Cd.key(0, -1, 0)
      let w = Ed.world(Ed.set_block(load(fresh(), 0, -1, 0), 5, -5, 5, 0))
      let u = Wd.unload(w, k)
      let h = value_hash(u, k)
      Test.assert_eq_int(Wd.cache_size(u), 1, "cached")
      Test.assert_eq_int(Wd.held_coarsened(u), 0, "no coarse copy yet")
      let r = Wd.release_written(u, Cons((k, h), Nil))
      Test.assert_eq_int(Wd.cache_size(r), 0, "released from the cache")
      Test.assert_eq_int(Wd.held_coarsened(r), 1, "its coarse copy kept")
      -- the chunk edited again after the write: loaded, edited, unloaded
      let again = Wd.unload(Ed.world(Ed.set_block(load(u, 0, -1, 0), 6, -5, 5, 0)), k)
      let kept = Wd.release_written(again, Cons((k, h), Nil))
      Test.assert_eq_int(Wd.cache_size(kept), 1, "a stale hash keeps the chunk")
      Test.assert_eq_int(Wd.held_coarsened(kept), 0, "and makes no coarse copy")
      -- a loaded chunk is never released
      let loaded = Wd.release_written(w, Cons((k, value_hash(w, k)), Nil))
      Test.assert_true(Wd.is_loaded(loaded, k), "still loaded")
      Test.assert_eq_int(Wd.held_coarsened(loaded), 0, "no coarse copy")
      -- loading a released key generates it and drops its coarse copy
      Test.assert_eq_int(Wd.held_coarsened(load(r, 0, -1, 0)), 0, "dropped when the chunk loads")
    end
    test "far field: the coarse chunks over a released edit equal the ones built before the release" do
      let k = Cd.key(1, -1, 2)
      let w0 = load_key(Wd.new(reg3(), flat_levels(), 7, 1.0), k)
      -- a 6-cube carved, water poured in part of it, and a column of tall grass (a cross)
      let w1 = Ed.world(Ed.fill_box(w0, 34, -20, 66, 39, -15, 71, 0))
      let w2 = Ed.world(Ed.fill_box(w1, 34, -20, 66, 36, -19, 68, 9))
      let w = Wd.unload(Ed.world(Ed.fill_box(w2, 40, -3, 70, 41, -1, 71, 10)), k)
      let p1 = Cd.parent(k)
      let p2 = Cd.parent(p1)
      let before1 = far(w, p1)
      let before2 = far(w, p2)
      Test.assert_true(C.hash(before1) != C.hash(Strata.Terrain.run(Wd.terrain(w), p1, Wd.seed(w))), "the edit shows at level 1")
      Test.assert_true(C.hash(before2) != C.hash(Strata.Terrain.run(Wd.terrain(w), p2, Wd.seed(w))), "and at level 2")
      let r = Wd.release_written(w, Cons((k, value_hash(w, k)), Nil))
      Test.assert_eq_int(Wd.cache_size(r), 0, "released")
      Test.assert_eq_int(List.length(Wd.edits_under(r, p1)), 1, "the coarse copy is captured under level 1")
      Test.assert_eq_int(C.hash(far(r, p1)), C.hash(before1), "level 1 equal after the release")
      Test.assert_eq_int(C.hash(far(r, p2)), C.hash(before2), "level 2 equal after the release")
      Test.assert_eq_int(C.hash(Wd.coarsen(r, p1)), C.hash(before1), "World.coarsen agrees")
    end
  end

  describe "World" do
    test "a block reads as air until its chunk is inserted" do
      let w = fresh()
      Test.assert_eq_int(Wd.get_block(w, 5, -5, 5), 0, "not loaded")
      Test.assert_false(Wd.is_loaded(w, Cd.key(0, -1, 0)), "not loaded")
      let w2 = load(w, 0, -1, 0)
      Test.assert_true(Wd.is_loaded(w2, Cd.key(0, -1, 0)), "loaded")
      Test.assert_eq_int(Wd.get_block(w2, 5, -5, 5), 1, "stone below zero")
      Test.assert_eq_int(Wd.get_block(w2, 5, 5, 5), 0, "the chunk above is not loaded")
    end
    test "carries what it was made with" do
      let w = fresh()
      Test.assert_eq_int(Wd.seed(w), 7, "seed")
      Test.assert_true(Wd.scale(w) == 1.0, "scale")
      Test.assert_eq_int(B.count(Wd.registry(w)), 2, "registry")
    end
    test "unloading an untouched chunk drops it; an edited one is cached and comes back" do
      let w = load(fresh(), 0, -1, 0)
      Test.assert_eq_int(Wd.cache_size(Wd.unload(w, Cd.key(0, -1, 0))), 0, "untouched: dropped")
      let e = Ed.world(Ed.set_block(w, 5, -5, 5, 0))
      Test.assert_true(Wd.is_edited(e, Cd.key(0, -1, 0)), "edited")
      let u = Wd.unload(e, Cd.key(0, -1, 0))
      Test.assert_false(Wd.is_loaded(u, Cd.key(0, -1, 0)), "unloaded")
      Test.assert_eq_int(Wd.cache_size(u), 1, "edited: cached")
      Test.assert_true(Wd.is_edited(u, Cd.key(0, -1, 0)), "still counted as edited while cached")
      let back = load(u, 0, -1, 0)
      Test.assert_eq_int(Wd.get_block(back, 5, -5, 5), 0, "the edit survives the round trip")
      Test.assert_eq_int(Wd.get_block(back, 6, -5, 5), 1, "the rest is as generated")
      Test.assert_eq_int(Wd.cache_size(back), 0, "and the cache entry is gone")
    end
    test "a chunk edited back to its generated state is no longer edited" do
      let w = load(fresh(), 0, -1, 0)
      let e = Ed.world(Ed.set_block(Ed.world(Ed.set_block(w, 5, -5, 5, 0)), 5, -5, 5, 1))
      Test.assert_false(Wd.is_edited(e, Cd.key(0, -1, 0)), "back to generated")
      Test.assert_eq_int(Wd.cache_size(Wd.unload(e, Cd.key(0, -1, 0))), 0, "so unloading drops it")
    end
    test "unloading a chunk that is not loaded changes nothing" do
      Test.assert_eq_int(Wd.cache_size(Wd.unload(fresh(), Cd.key(9, 9, 9))), 0, "nothing cached")
    end
  end

  describe "Edit.set_block" do
    test "an interior edit dirties its own chunk and records the change" do
      let o = Ed.set_block(load_box(fresh(), 0), 5, 5, 5, 1)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 1, "one dirty chunk")
      Test.assert_true(has_key(Ed.dirty(o), Cd.key(0, 0, 0)), "its own")
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 5, 5, 5), 1, "the block is set")
      Test.assert_eq_int(List.length(Ed.changes(o)), 1, "one change")
      Test.assert_eq_int(head_old(Ed.changes(o)), 0, "old id")
      Test.assert_eq_int(head_new(Ed.changes(o)), 1, "new id")
      Test.assert_eq_int(List.length(Ed.deferred(o)), 0, "nothing deferred")
    end
    test "setting the id already there is not an edit" do
      let o = Ed.set_block(load_box(fresh(), 0), 5, -5, 5, 1)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 0, "nothing dirty")
      Test.assert_eq_int(List.length(Ed.changes(o)), 0, "no change")
    end
    test "an edit on a chunk face also dirties the chunk across it" do
      let o = Ed.set_block(load_box(fresh(), 0), 0, 5, 5, 1)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 2, "two chunks")
      Test.assert_true(has_key(Ed.dirty(o), Cd.key(0, 0, 0)) && has_key(Ed.dirty(o), Cd.key(-1, 0, 0)), "its own and -x")
    end
    test "an edit on a chunk corner dirties all eight chunks around the corner" do
      let o = Ed.set_block(load_box(fresh(), 0), 0, 0, 0, 1)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 8, "eight chunks")
      Test.assert_true(has_key(Ed.dirty(o), Cd.key(-1, -1, -1)), "the diagonal one included")
      Test.assert_true(no_dups(Ed.dirty(o)), "each once")
    end
    test "an edit queued for an unloaded chunk still dirties the loaded chunk across the border" do
      -- chunk (0, 0, 0) is loaded, (1, 0, 0) is not; voxel 32 is the first of the unloaded one
      let o = Ed.set_block(load(fresh(), 0, 0, 0), 32, 5, 5, 1)
      Test.assert_true(has_key(Ed.deferred(o), Cd.key(1, 0, 0)), "deferred on the unloaded chunk")
      Test.assert_true(has_key(Ed.dirty(o), Cd.key(0, 0, 0)), "and the loaded neighbour is dirty")
    end
    test "only loaded neighbours are dirtied" do
      let o = Ed.set_block(load(fresh(), 0, 0, 0), 0, 0, 0, 1)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 1, "the neighbours are not loaded")
    end
    test "negative coordinates land in negative chunks" do
      let o = Ed.set_block(load_box(fresh(), 0), -1, -1, -1, 0)
      Test.assert_eq_int(Wd.get_block(Ed.world(o), -1, -1, -1), 0, "set")
      Test.assert_eq_int(C.get(Strata.Store.get(Wd.chunks(Ed.world(o)), Cd.key(-1, -1, -1)), 31, 31, 31), 0, "at local (31, 31, 31) of chunk (-1, -1, -1)")
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 0, -1, 0), 1, "the voxel across the origin is untouched")
    end
    test "an edit to an unloaded chunk is queued and applied when the chunk arrives" do
      let o = Ed.set_block(fresh(), 5, -5, 5, 0)
      Test.assert_eq_int(List.length(Ed.dirty(o)), 0, "nothing loaded to dirty")
      Test.assert_true(has_key(Ed.deferred(o), Cd.key(0, -1, 0)), "deferred on its chunk")
      Test.assert_eq_int(Wd.pending_size(Ed.world(o)), 1, "one chunk has queued edits")
      Test.assert_eq_int(List.length(Ed.changes(o)), 1, "the edit is still recorded")
      Test.assert_eq_int(head_old(Ed.changes(o)), -1, "with the old id unknown")
      Test.assert_eq_int(head_new(Ed.changes(o)), 0, "and the new id")
      Test.assert_true(Wd.is_edited(Ed.world(o), Cd.key(0, -1, 0)), "which counts as edited")
      let w2 = load(Ed.world(o), 0, -1, 0)
      Test.assert_eq_int(Wd.get_block(w2, 5, -5, 5), 0, "applied on arrival")
      Test.assert_eq_int(Wd.pending_size(w2), 0, "and the queue is empty")
      Test.assert_true(Wd.is_edited(w2, Cd.key(0, -1, 0)), "the chunk now differs from its generation")
    end
  end

  describe "Edit.fill_sphere" do
    test "fills voxels within the radius, across eight chunks, as one change" do
      let o = Ed.fill_sphere(load_box(fresh(), 0), 0, 0, 0, 12, 1)
      let w = Ed.world(o)
      Test.assert_eq_int(Wd.get_block(w, 0, 0, 0), 1, "the centre")
      Test.assert_eq_int(Wd.get_block(w, 12, 0, 0), 1, "distance 12 on +x")
      Test.assert_eq_int(Wd.get_block(w, 0, 12, 0), 1, "distance 12 on +y")
      Test.assert_eq_int(Wd.get_block(w, 13, 0, 0), 0, "distance 13 is outside")
      Test.assert_eq_int(Wd.get_block(w, 9, 9, 0), 0, "(9, 9, 0) is 12.7 away: outside")
      Test.assert_eq_int(Wd.get_block(w, 8, 8, 0), 1, "(8, 8, 0) is 11.3 away: inside")
      Test.assert_eq_int(List.length(Ed.dirty(o)), 8, "eight chunks")
      Test.assert_true(no_dups(Ed.dirty(o)), "each once")
      Test.assert_eq_int(List.length(Ed.changes(o)), 1, "one SphereFill record")
      Test.assert_eq_int(head_kind(Ed.changes(o)), 2, "of the sphere kind")
    end
    test "radius 0 changes one voxel; a negative radius changes nothing" do
      let o = Ed.fill_sphere(load_box(fresh(), 0), 5, 5, 5, 0, 1)
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 5, 5, 5), 1, "the centre")
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 6, 5, 5), 0, "and no more")
      let n = Ed.fill_sphere(load_box(fresh(), 0), 5, 5, 5, -1, 1)
      Test.assert_eq_int(Wd.get_block(Ed.world(n), 5, 5, 5), 0, "nothing")
      Test.assert_eq_int(List.length(Ed.dirty(n)), 0, "nothing dirty")
      Test.assert_eq_int(List.length(Ed.changes(n)), 0, "no change record")
    end
  end

  describe "Edit.fill_box" do
    test "fills inclusive corners in either order, as one change" do
      let o = Ed.fill_box(load_box(fresh(), 0), 3, 3, 3, -2, 1, 1, 1)
      let w = Ed.world(o)
      Test.assert_eq_int(Wd.get_block(w, -2, 1, 1), 1, "low corner")
      Test.assert_eq_int(Wd.get_block(w, 3, 3, 3), 1, "high corner")
      Test.assert_eq_int(Wd.get_block(w, 4, 3, 3), 0, "outside")
      Test.assert_eq_int(List.length(Ed.changes(o)), 1, "one BoxFill record")
      Test.assert_eq_int(head_kind(Ed.changes(o)), 1, "of the box kind")
    end
    test "the part in an unloaded chunk is deferred and applied on arrival" do
      -- chunks (0,0,0) loaded, (1,0,0) not; the box spans both
      let o = Ed.fill_box(load(fresh(), 0, 0, 0), 30, 5, 5, 34, 5, 5, 1)
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 31, 5, 5), 1, "the loaded part is set")
      Test.assert_true(has_key(Ed.deferred(o), Cd.key(1, 0, 0)), "the unloaded chunk is deferred")
      Test.assert_eq_int(List.length(Ed.deferred(o)), 1, "only that one")
      Test.assert_eq_int(Wd.pending_size(Ed.world(o)), 1, "one chunk queued")
      let w2 = load(Ed.world(o), 1, 0, 0)
      Test.assert_eq_int(Wd.get_block(w2, 34, 5, 5), 1, "inside the box")
      Test.assert_eq_int(Wd.get_block(w2, 35, 5, 5), 0, "outside it")
      Test.assert_eq_int(Wd.pending_size(w2), 0, "queue drained")
    end
    test "queued edits apply in the order they were made" do
      let o1 = Ed.fill_box(fresh(), 0, 0, 0, 5, 5, 5, 1)
      let o2 = Ed.set_block(Ed.world(o1), 2, 2, 2, 0)
      let w = load(Ed.world(o2), 0, 0, 0)
      Test.assert_eq_int(Wd.get_block(w, 2, 2, 2), 0, "the later single edit wins")
      Test.assert_eq_int(Wd.get_block(w, 3, 2, 2), 1, "over the earlier box")
    end
  end

  describe "Edit.set_many" do
    test "agrees with setting each cell in turn" do
      Check.all(Gen.list(Gen.map(Gen.tuple2(Gen.tuple2(Gen.int(-40, 40), Gen.int(-40, 40)), Gen.tuple2(Gen.int(-40, 40), Gen.int(0, 1))), fn p -> flat4(p))), fn cells ->
        let base = load_box(fresh(), 0)
        let o = Ed.set_many(base, cells)
        same_blocks(Ed.world(o), apply_each(base, cells), cells) && no_dups(Ed.dirty(o))
      )
    end
    test "records the same changes and dirties the same chunks as setting each cell in turn" do
      Check.all(Gen.list(Gen.map(Gen.tuple2(Gen.tuple2(Gen.int(-40, 40), Gen.int(-40, 40)), Gen.tuple2(Gen.int(-40, 40), Gen.int(0, 1))), fn p -> flat4(p))), fn cells ->
        let base = load_box(fresh(), 0)
        let o = Ed.set_many(base, cells)
        match each_outcome(base, cells, 0, Nil) do
          (n, dirty) -> List.length(Ed.changes(o)) == n && all_in(Ed.dirty(o), dirty) && all_in(dirty, Ed.dirty(o))
        end
      )
    end
    test "a cell set twice ends as the later one, across a chunk border too" do
      let o = Ed.set_many(load_box(fresh(), 0), Cons((31, 5, 5, 1), Cons((32, 5, 5, 1), Cons((31, 5, 5, 0), Cons((0, 5, 5, 1), Nil)))))
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 31, 5, 5), 0, "set, then cleared")
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 32, 5, 5), 1, "its neighbour over the border")
      Test.assert_eq_int(Wd.get_block(Ed.world(o), 0, 5, 5), 1, "and another in the first chunk")
      Test.assert_eq_int(List.length(Ed.changes(o)), 4, "four changes: the cell that was set and cleared counts twice")
    end
  end

  describe "World and a store's workers" do
    test "region_raw gives a touched loaded chunk with its generation hash, a cached chunk with -1, nothing for an untouched one" do
      let w = Wd.log_changes(load(load(load(fresh(), 0, -1, 0), 1, -1, 0), 2, -1, 0), true)
      -- (0, -1, 0) edited; (1, -1, 0) edited and unloaded; (2, -1, 0) edited back; (3, -1, 0) not loaded, one edit queued
      let e = Ed.world(Ed.set_block(Ed.world(Ed.set_block(Ed.world(Ed.set_block(Ed.world(Ed.set_block(Ed.world(Ed.set_block(w, 5, -5, 5, 0)), 37, -5, 5, 0)), 69, -5, 5, 0)), 69, -5, 5, 1)), 100, -5, 5, 0))
      let v = Wd.unload(e, Cd.key(1, -1, 0))
      let gen = C.hash(Strata.Terrain.run(Wd.terrain(v), Cd.key(0, -1, 0), Wd.seed(v)))
      match Wd.region_raw(v, Cons(Cd.key(0, -1, 0), Cons(Cd.key(1, -1, 0), Cons(Cd.key(2, -1, 0), Cons(Cd.key(3, -1, 0), Nil))))) do
        (cs, qs) ->
          Test.assert_eq_int(List.length(cs), 3, "three chunks: the worker judges the one edited back")
          match cs do
            Cons((k0, c0, h0), Cons((k1, _, h1), Cons((k2, c2, h2), Nil))) ->
              Test.assert_true(Cd.key_eq(k0, Cd.key(0, -1, 0)), "in the keys' order")
              Test.assert_eq_int(h0, gen, "the loaded chunk with the hash it generated to")
              Test.assert_true(C.hash(c0) != h0, "from which it differs")
              Test.assert_true(Cd.key_eq(k1, Cd.key(1, -1, 0)), "then the cached one")
              Test.assert_eq_int(h1, -1, "a cached chunk says -1")
              Test.assert_true(Cd.key_eq(k2, Cd.key(2, -1, 0)), "then the one edited back")
              Test.assert_eq_int(C.hash(c2), h2, "which hashes to its generation")
            _ -> Test.fail("the three chunks")
          end
          Test.assert_eq_int(List.length(qs), 1, "one queue")
      end
    end
    test "insert_saved puts a store's chunk in the generated one's place: edited, recognised when edited back, under a newer cached chunk" do
      let k = Cd.key(0, -1, 0)
      let gen = Strata.Terrain.run(Wd.terrain(fresh()), k, 7)
      let saved = C.set(gen, 5, 27, 5, 0)
      let w = Wd.insert_saved(Wd.log_changes(fresh(), true), k, saved, C.hash(gen))
      Test.assert_eq_int(Wd.get_block(w, 5, -5, 5), 0, "the saved chunk is loaded")
      Test.assert_true(Wd.is_edited(w, k), "and counts as edited")
      match Wd.take_changes(w) do
        (_, ks) -> Test.assert_eq_int(List.length(ks), 0, "loading it is not a change")
      end
      Test.assert_eq_int(Wd.cache_size(Wd.unload(w, k)), 1, "unloaded, it goes to the cache")
      let back = Ed.world(Ed.set_block(w, 5, -5, 5, 1))
      Test.assert_false(Wd.is_edited(back, k), "edited back to its generation, it is recognised")
      Test.assert_eq_int(Wd.cache_size(Wd.unload(Wd.log_changes(back, false), k)), 0, "and dropped at unload when no store listens")
      -- with the log on it waits in the cache, logged as reverted, until the store has dropped its saved copy
      let waiting = Wd.unload(back, k)
      Test.assert_eq_int(Wd.cache_size(waiting), 1, "with a store listening it waits in the cache")
      match Wd.take_changes_marked(waiting) do
        (w3, changed, reverted) ->
          Test.assert_eq_int(List.length(changed), 0, "not as a change")
          Test.assert_eq_int(List.length(reverted), 1, "but as reverted")
          Test.assert_eq_int(Wd.cache_size(Wd.forget_reverted(w3, Cons((k, C.hash(gen) + 1), Nil))), 1, "another hash leaves it")
          Test.assert_eq_int(Wd.cache_size(Wd.forget_reverted(w3, Cons((k, C.hash(gen)), Nil))), 0, "forgotten once its saved copy is dropped")
      end
      -- a chunk still in the cache is newer than the store's
      let newer = Wd.unload(Ed.world(Ed.set_block(load(Wd.log_changes(fresh(), true), 0, -1, 0), 9, -5, 9, 0)), k)
      let both = Wd.insert_saved(newer, k, saved, C.hash(gen))
      Test.assert_eq_int(Wd.get_block(both, 9, -5, 9), 0, "the cached edit is there")
      Test.assert_eq_int(Wd.get_block(both, 5, -5, 5), 1, "and the store's older chunk is not")
      -- an edit queued here is applied over the saved chunk
      let queued = Wd.insert_saved(Ed.world(Ed.set_block(Wd.log_changes(fresh(), true), 7, -5, 7, 0)), k, saved, C.hash(gen))
      Test.assert_eq_int(Wd.get_block(queued, 7, -5, 7), 0, "the queued edit")
      Test.assert_eq_int(Wd.get_block(queued, 5, -5, 5), 0, "over the saved chunk")
    end
  end
end
