-- Character: a rig and a size from a MagicaVoxel character file.
mod Strata.Test.Character do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  import Test
  alias Strata.Test.VoxFixture as ChF
  alias Strata.Rig as ChRg

  -- a solid model of size (sx, sy, sz) (file axes) in colour c
  pfn solid(sx : Int, sy : Int, sz : Int, c : Int) : List(Int) do
    ChF.model(sx, sy, sz, List.flat_map(List.range(0, sx), fn x -> List.flat_map(List.range(0, sy), fn y -> List.map(List.range(0, sz), fn z -> (x, y, z, c)))))
  end
  -- a part: (name, size in file axes, the low corner in file axes, colour)
  type ChPart = ChPart(String, Int, Int, Int, Int, Int, Int, Int)
  -- MagicaVoxel's translation for a model whose low corner is (x, y, z): low + floor(size / 2)
  pfn t_of(p : ChPart) : String do
    match p do ChPart(_, sx, sy, sz, x, y, z, _) -> int_to_string(x + sx / 2) ++ " " ++ int_to_string(y + sy / 2) ++ " " ++ int_to_string(z + sz / 2) end
  end
  pfn models(ps : List(ChPart)) : List(List(Int)) do
    List.map(ps, fn p -> match p do ChPart(_, sx, sy, sz, _, _, _, c) -> solid(sx, sy, sz, c) end)
  end
  pfn file_of(ps : List(ChPart)) : NativeU8Arr do
    let scene = ChF.scene(List.map(ps, fn p -> match p do ChPart(n, _, _, _, _, _, _, _) -> (n, t_of(p)) end))
    ChF.bytes(ChF.file(List.append(models(ps), [scene, ChF.rgba([(200, 150, 120), (40, 60, 160)]), ChF.matl(241, [("_emit", "0.5")])])))
  end

  -- today's humanoid, in file axes (x right-to-left as the rig's x, y forward, z up), feet at z 0:
  -- pelvis 6 wide, 4 deep, 3 tall at z 14; spine 8 x 4 x 9 on it; head 5 x 5 x 5 on that; arms of 2 x 2 (6, 5, 2 long) beside the spine; legs of 3 x 3 (7, 7) and feet 3 x 5 x 1
  pfn humanoid_parts(head : Int) : List(ChPart) do
    [ChPart("pelvis", 6, 4, 3, 0, 0, 14, 1), ChPart("spine", 8, 4, 9, -1, 0, 17, 1), ChPart("head", head, head, head, 6 - head, 0, 26, 1),
     ChPart("arm_l_upper", 2, 2, 6, 7, 1, 20, 1), ChPart("arm_l_fore", 2, 2, 5, 7, 1, 15, 1), ChPart("arm_l_hand", 2, 2, 2, 7, 1, 13, 241),
     ChPart("arm_r_upper", 2, 2, 6, -3, 1, 20, 1), ChPart("arm_r_fore", 2, 2, 5, -3, 1, 15, 1), ChPart("arm_r_hand", 2, 2, 2, -3, 1, 13, 1),
     ChPart("leg_l_thigh", 3, 3, 7, 3, 0, 7, 2), ChPart("leg_l_shin", 3, 3, 7, 3, 0, 0, 2), ChPart("leg_l_foot", 3, 5, 1, 3, 0, -1, 2),
     ChPart("leg_r_thigh", 3, 3, 7, 0, 0, 7, 2), ChPart("leg_r_shin", 3, 3, 7, 0, 0, 0, 2), ChPart("leg_r_foot", 3, 5, 1, 0, 0, -1, 2)]
  end
  -- today's humanoid (viewer/lib/figures.march): each part's parent, and its pivot in its parent's voxels
  pfn humanoid_parents() : List(Int) do [-1, 0, 1, 1, 3, 4, 1, 6, 7, 0, 9, 10, 0, 12, 13] end
  pfn humanoid_pivots() : List((Float, Float, Float)) do
    [(0.0, 15.0, 0.0), (3.0, 3.0, 2.0), (4.0, 9.0, 2.0), (9.0, 8.5, 2.0), (1.0, 0.0, 1.0), (1.0, 0.0, 1.0), (-1.0, 8.5, 2.0), (1.0, 0.0, 1.0), (1.0, 0.0, 1.0),
     (4.5, 0.0, 2.0), (1.5, 0.0, 1.5), (1.5, 0.0, 1.5), (1.5, 0.0, 2.0), (1.5, 0.0, 1.5), (1.5, 0.0, 1.5)]
  end
  pfn build(ps : List(ChPart)) : Result(Strata.Character.Character, String) do
    match Strata.Vox.parse(file_of(ps)) do Ok(v) -> Strata.Character.from_vox(v) | Err(e) -> Err(e) end
  end
  pfn ok(r : Result(Strata.Character.Character, String)) : Strata.Character.Character do
    match r do Ok(c) -> c | Err(e) -> panic("character: " ++ e) end
  end
  pfn rig_of(r : Result(Strata.Character.Character, String)) : Strata.Rig.Rig do
    let c = ok(r)
    c.rig
  end
  pfn err_has(r : Result(Strata.Character.Character, String), want : String) : Unit do
    match r do
      Ok(_) -> Test.assert_true(false, "expected an error naming " ++ want)
      Err(e) -> Test.assert_true(string_contains(e, want), "the error \"" ++ e ++ "\" names " ++ want)
    end
  end
  pfn near(a : Float, b : Float, tol : Float, what : String) : Unit do Test.assert_true(float_abs(a -. b) <= tol, what ++ ": " ++ float_to_string(a) ++ " vs " ++ float_to_string(b)) end
  pfn without(ps : List(ChPart), name : String) : List(ChPart) do List.filter(ps, fn p -> match p do ChPart(n, _, _, _, _, _, _, _) -> n != name end) end
  -- the pivot of part p in its parent's voxels
  pfn piv(r : Strata.Rig.Rig, p : Int) : (Float, Float, Float) do ChRg.pivot_at(r, p) end
  pfn colour_of(r : Strata.Rig.Rig, i : Int) : (Float, Float, Float) do
    match List.find(ChRg.palette(r), fn c -> match c do (k, _, _, _, _, _) -> k == i end) do
      Some((_, cr, cg, cb, _, _)) -> (cr, cg, cb)
      None -> (-1.0, -1.0, -1.0)
    end
  end

  describe "Character" do
    test "today's humanoid, drawn as a file, builds today's skeleton" do
      let c = ok(build(humanoid_parts(5)))
      let r = c.rig
      Test.assert_eq_int(ChRg.part_count(r), 15, "15 parts")
      let pa = ChRg.parents(r)
      List.map(List.range(0, 15), fn p -> Test.assert_eq_int(NativeArray.get_i32(pa, p), List.nth(humanoid_parents(), p), "parent of " ++ int_to_string(p)))
      List.map(List.range(1, 15), fn p ->
        match (piv(r, p), List.nth(humanoid_pivots(), p)) do
          ((ax, ay, az), (bx, b_y, bz)) ->
            near(ax, bx, 0.5, "pivot x of " ++ int_to_string(p))
            near(ay, b_y, 0.5, "pivot y of " ++ int_to_string(p))
            near(az, bz, 0.5, "pivot z of " ++ int_to_string(p))
        end)
      ()
    end

    test "odd and even sizes join on the spine's top" do
      List.map([5, 6], fn n ->
        let r = rig_of(build(humanoid_parts(n)))
        match (piv(r, 2), ChRg.size(r, 1)) do
          ((x, y, z), (sx, sy, sz)) ->
            near(y, int_to_float(sy), 0.001, "head of " ++ int_to_string(n) ++ " on the spine's top")
            near(x, int_to_float(sx) /. 2.0, 0.5, "head of " ++ int_to_string(n) ++ " centred in x")
            near(z, int_to_float(sz) /. 2.0, 0.5, "head of " ++ int_to_string(n) ++ " centred in z")
        end)
      ()
    end

    test "a model with no voxels is a joint" do
      let ps = List.map(humanoid_parts(5), fn p -> match p do ChPart("arm_l_hand", sx, sy, sz, x, y, z, _) -> ChPart("arm_l_hand", sx, sy, sz, x, y, z, 0) | _ -> p end)
      let r = rig_of(build(ps))
      Test.assert_eq_int(ChRg.part_count(r), 15, "still 15 parts")
    end

    test "an extra hangs from its part" do
      let r = rig_of(build(List.append(humanoid_parts(5), [ChPart("extra:head:antenna", 1, 1, 4, 3, 2, 31, 2)])))
      Test.assert_eq_int(ChRg.part_count(r), 16, "16 parts")
      Test.assert_eq_int(NativeArray.get_i32(ChRg.parents(r), 15), 2, "parent is the head")
      match ChRg.anchor_at(r, 15) do (x, y, z) -> near(x +. y +. z, 0.0, 0.001, "anchored at its low corner") end
    end

    test "a file that breaks the convention is refused, naming the part" do
      err_has(build(without(humanoid_parts(5), "leg_r_foot")), "leg_r_foot")
      err_has(build(List.append(humanoid_parts(5), [ChPart("head", 2, 2, 2, 1, 0, 26, 1)])), "head")
      err_has(build(List.append(humanoid_parts(5), [ChPart("extra:tail_base:tip", 1, 1, 1, 0, -3, 15, 1)])), "tail_base")
      let far_hand = List.map(humanoid_parts(5), fn p -> match p do ChPart("arm_l_hand", sx, sy, sz, x, y, _, c) -> ChPart("arm_l_hand", sx, sy, sz, x, y, 10, c) | _ -> p end)
      err_has(build(far_hand), "arm_l_hand")
      err_has(build(List.append(humanoid_parts(5), [ChPart("extra:spine:pole", 1, 1, 129, 0, 0, 20, 1)])), "128")
    end

    test "size: feet to the top voxel, and the eye 0.12 m under it" do
      let c = ok(build(humanoid_parts(5)))
      near(c.size.height, 32.0 /. 16.0, 0.001, "height")
      near(c.size.eye, 2.0 -. 0.12, 0.001, "eye")
    end

    test "trim takes a colour, darker trim staying darker" do
      let ps = List.append(humanoid_parts(5), [ChPart("extra:spine:sash", 2, 1, 2, 2, -1, 18, 242)])
      match Strata.Vox.parse(file_of(ps)) do
        Err(e) -> panic(e)
        Ok(v0) ->
          let pal = NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(NativeArray.set_u8(v0.palette, 964, 204), 965, 204), 966, 204), 968, 102), 969, 102), 970, 102)
          let c = ok(Strata.Character.from_vox({ v0 with palette: pal }))
          let r = Strata.Character.trimmed(c, 0.0, 0.0, 1.0)
          match (colour_of(r, 241), colour_of(r, 242), colour_of(r, 1)) do
            ((_, _, b1), (_, _, b2), (r1, _, _)) ->
              near(b1, 1.0, 0.01, "241 the full shade")
              near(b2, 0.5, 0.01, "242 half as bright")
              near(r1, 200.0 /. 255.0, 0.01, "skin unchanged")
          end
      end
    end

    test "sockets, legs and the mask are today's" do
      let r = rig_of(build(humanoid_parts(5)))
      Test.assert_eq_int(List.length(ChRg.sockets(r)), 2, "two sockets")
      Test.assert_true(List.map(ChRg.sockets(r), fn s -> match s do (p, _, _, _, _) -> p end) == [5, 8], "on the hands")
      Test.assert_true(List.map(ChRg.legs(r), fn l -> match l do (a, b, c, _) -> 10000 * a + 100 * b + c end) == [91011, 121314], "the two legs")
      Test.assert_true(List.all(ChRg.legs(r), fn l -> match l do (_, _, _, s) -> float_abs(s -. 0.0625) < 0.0001 end), "soles 1/16 m")
      Test.assert_true(ChRg.masks(r) == [[6]], "mask [6]")
    end
  end
end
