-- Falls: where still water steps down.
mod Strata.Test.Falls do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  needs IO.Spawn
  needs IO.Foreign
  import Test
  alias Strata.World as Wd
  alias Strata.Edit as Ed
  alias Strata.Coord as Cd
  alias Strata.Chunk as C
  alias Strata.Blocks as B

  -- two blocks: 1 stone, 2 water (it does not collide)
  pfn reg() : Strata.Blocks.Registry do
    match B.register(B.empty(), B.def()) do
      Ok((r1, _)) -> (match B.register(r1, B.with_collide(B.def(), false)) do
          Ok((r2, _)) -> r2
          Err(_) -> r1
        end)
      Err(_) -> B.empty()
    end
  end
  pfn load_go(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 8 do w else load_go(Wd.insert(w, Cd.key(i % 2 - 1, (i / 2) % 2 - 1, i / 4 - 1), C.uniform(0)), i + 1) end
  end
  -- air; then a stone bed four deep under x 0..9 at z 0, an upper pool on it (x 0..4, y 4) and a lower one cut into it (x 5..9, y 2, open above)
  pfn stepped() : Strata.World.World do
    let w0 = load_go(Wd.new(reg(), Strata.Terrain.gen(fn (k, seed) -> C.uniform(0)), 1, 1.0), 0)
    let w1 = Ed.world(Ed.fill_box(w0, 0, 0, 0, 9, 3, 0, 1))
    let w2 = Ed.world(Ed.fill_box(w1, 0, 4, 0, 4, 4, 0, 2))
    let w3 = Ed.world(Ed.fill_box(w2, 5, 3, 0, 9, 3, 0, 0))
    Ed.world(Ed.fill_box(w3, 5, 2, 0, 9, 2, 0, 2))
  end

  describe "Falls" do
    test "find: the one place the upper water's surface steps down to the lower" do
      let ds = Strata.Falls.find(stepped(), fn id -> id == 2, -8, 16, 0, 0)
      Test.assert_true(ds == [(5.5, 3.0, 0.5, 2)], "one drop: its foot on the lower water beside the lip, two cells down")
    end
    test "find: level water has no drops, and a drop onto stone is not one" do
      let w0 = load_go(Wd.new(reg(), Strata.Terrain.gen(fn (k, seed) -> C.uniform(0)), 1, 1.0), 0)
      let flat = Ed.world(Ed.fill_box(Ed.world(Ed.fill_box(w0, 0, 0, 0, 9, 3, 0, 1)), 0, 4, 0, 9, 4, 0, 2))
      Test.assert_eq_int(List.length(Strata.Falls.find(flat, fn id -> id == 2, -8, 16, 0, 0)), 0, "a level pool")
      Test.assert_eq_int(Strata.Falls.count(Strata.Falls.none()), 0, "none known before a search")
    end
  end
end
