-- The generic noise primitives: range and determinism.
mod Strata.Test.Noise do

  import Test
  alias Strata.Noise as N

  pfn in_unit_go(i : Int, seed : Int) : Bool do
    if i >= 400 do true
    else
      let x = int_to_float(i) *. 0.37 -. 60.0
      let z = int_to_float(i) *. 0.91 -. 150.0
      let v = N.fbm(x, z, seed)
      let r = N.ridged_fbm(x, z, seed)
      if v >= 0.0 && v < 1.0 && r >= 0.0 && r <= 1.0 do in_unit_go(i + 1, seed) else false end
    end
  end

  pfn test_kind(kind : Int, a : NativeF32Arr) : Bool do
    let s = N.settings(kind, 3, 2.0, 0.5, 1, 4.0)
    let n = N.field2(s, 9, 0.02, 12.5, -40.0, 3.0, 8, 8, a)
    n == 64 && field_matches_go(s, a, 8, 0)
  end

  pfn cell(a : NativeF32Arr, i : Int) : Float do NativeArray.get_f32(a, i) end

  pfn field_matches_go(s : Strata.Noise.Settings, a : NativeF32Arr, n : Int, i : Int) : Bool do
    if i >= n * n do true
    else
      let x = 12.5 +. int_to_float(i % n) *. 3.0
      let z = -40.0 +. int_to_float(i / n) *. 3.0
      let want = N.sample2(s, 9, 0.02, x, z)
      if Math.abs(cell(a, i) -. want) < 0.000001 do field_matches_go(s, a, n, i + 1) else false end
    end
  end

  pfn same_go(a : NativeF32Arr, b : NativeF32Arr, i : Int, n : Int) : Bool do
    if i >= n do true else if cell(a, i) == cell(b, i) do same_go(a, b, i + 1, n) else false end end
  end

  pfn range_go(s : Strata.Noise.Settings, lo : Float, hi : Float, i : Int) : Bool do
    if i >= 400 do true
    else
      let v = N.sample2(s, 5, 0.013, int_to_float(i) *. 7.3 -. 900.0, int_to_float(i) *. -3.1 +. 200.0)
      if v >= lo && v <= hi do range_go(s, lo, hi, i + 1) else false end
    end
  end

  describe "Noise fields" do
    test "field2 equals sample2 at each point, for every kind" do
      let a = NativeArray.make_f32(64, 0.0)
      let ok = test_kind(0, a) && test_kind(1, a) && test_kind(2, a) && test_kind(3, a)
      Test.assert_true(ok, "field matches samples")
    end
    test "the same call twice is identical" do
      let s = N.settings(0, 4, 2.0, 0.5, 1, 6.0)
      let a = NativeArray.make_f32(64, 0.0)
      let b = NativeArray.make_f32(64, 0.0)
      let n1 = N.field2(s, 3, 0.02, 0.0, 0.0, 2.0, 8, 8, a)
      let n2 = N.field2(s, 3, 0.02, 0.0, 0.0, 2.0, 8, 8, b)
      Test.assert_true(n1 == 64 && n2 == 64, "both fill 64 cells")
      Test.assert_true(same_go(a, b, 0, 64), "identical")
    end
    test "field3 with a short array returns 0" do
      let s = N.settings(0, 1, 2.0, 0.5, 0, 0.0)
      let a = NativeArray.make_f32(100, 0.0)
      Test.assert_true(N.field3(s, 1, 0.02, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0, 32, 32, 32, a) == 0, "refused")
      Test.assert_true(cell(a, 0) == 0.0, "untouched")
    end
    test "ridged stays in [0, 1], fBm and cellular in [-1, 1]" do
      Test.assert_true(range_go(N.settings(0, 4, 2.0, 0.5, 2, 0.0), 0.0, 1.0, 0), "ridged")
      Test.assert_true(range_go(N.settings(0, 4, 2.0, 0.5, 1, 0.0), -1.0, 1.0, 0), "fbm")
      Test.assert_true(range_go(N.settings(2, 1, 2.0, 0.5, 0, 0.0), -1.0, 1.0, 0), "cell value")
      Test.assert_true(range_go(N.settings(3, 1, 2.0, 0.5, 0, 0.0), -1.0, 1.0, 0), "cell F2-F1")
    end
  end

  describe "Noise" do
    test "fbm and ridged_fbm stay in the unit range, negative coordinates included" do
      Test.assert_true(in_unit_go(0, 7), "all samples in range")
    end
    test "the same point and seed give the same value, another seed a different one" do
      Test.assert_true(N.value2(3.25, -8.5, 11) == N.value2(3.25, -8.5, 11), "deterministic")
      Test.assert_true(N.value2(3.25, -8.5, 11) != N.value2(3.25, -8.5, 12), "seeded")
    end
  end
end
