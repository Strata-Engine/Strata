-- The block registry: registration, state families, models, total lookups.
mod Strata.Test.Blocks do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  import Test
  alias Strata.Blocks as B

  pfn reg1(r : Strata.Blocks.Registry, d : Strata.Blocks.Def) : (Strata.Blocks.Registry, Int) do
    match B.register(r, d) do
      Ok(p) -> p
      Err(_) -> (r, -1)
    end
  end

  pfn fam(r : Strata.Blocks.Registry, d : Strata.Blocks.Def, n : Int) : (Strata.Blocks.Registry, Int) do
    match B.register_family(r, d, n) do
      Ok(p) -> p
      Err(_) -> (r, -1)
    end
  end

  pfn is_air(r : Strata.Blocks.Registry, id : Int) : Bool do
    let no_collide = !B.collides(r, id)
    let empty = B.opacity_index(r, id) == 0
    let no_mesh = B.style_index(r, id) == 3
    no_collide && empty && no_mesh && !B.is_solid_opaque(r, id) && B.emission(r, id) == 0 && B.face_tex(r, id, 0) == 0
  end

  describe "Blocks.empty" do
    test "holds air as id 0" do
      let r = B.empty()
      Test.assert_eq_int(B.count(r), 1, "one block: air")
      Test.assert_true(is_air(r, 0), "id 0 has the air values")
    end
  end

  describe "Blocks.register" do
    test "the default definition is a solid opaque collidable cube" do
      let (r, id) = reg1(B.empty(), B.def())
      Test.assert_eq_int(id, 1, "first registered id")
      Test.assert_eq_int(B.count(r), 2, "air + one")
      Test.assert_true(B.collides(r, id), "collides")
      Test.assert_true(B.is_solid_opaque(r, id), "solid opaque")
      Test.assert_eq_int(B.style_index(r, id), 0, "style Cube")
      Test.assert_eq_int(B.layer_index(r, id), 0, "layer Opaque")
      Test.assert_eq_int(B.opacity_index(r, id), 1, "opacity Solid")
    end

    test "with_faces sets top, bottom and the four sides" do
      let (r, id) = reg1(B.empty(), B.with_faces(B.def(), 3, 4, 5))
      Test.assert_eq_int(B.face_tex(r, id, 0), 3, "top")
      Test.assert_eq_int(B.face_tex(r, id, 1), 4, "bottom")
      Test.assert_eq_int(B.face_tex(r, id, 2), 5, "+x")
      Test.assert_eq_int(B.face_tex(r, id, 3), 5, "-x")
      Test.assert_eq_int(B.face_tex(r, id, 4), 5, "+z")
      Test.assert_eq_int(B.face_tex(r, id, 5), 5, "-z")
      Test.assert_eq_int(B.face_tex(r, id, 9), 0, "a face that does not exist")
      Test.assert_eq_int(B.face_tex(r, id, -1), 0, "nor a negative one")
    end

    test "with_face overrides one face" do
      let (r, id) = reg1(B.empty(), B.with_face(B.with_faces(B.def(), 3, 4, 5), 2, 9))
      Test.assert_eq_int(B.face_tex(r, id, 2), 9, "+x overridden")
      Test.assert_eq_int(B.face_tex(r, id, 3), 5, "-x kept")
    end

    test "carries opacity, layer, style, collision, light and material" do
      let d0 = B.with_material(B.with_emission(B.with_collide(B.with_style(B.with_layer(B.with_opacity(B.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), Strata.Blocks.Model(4)), false), 10, 20, 30, 200), 77, 5)
      let (r, id) = reg1(B.empty(), d0)
      Test.assert_false(B.collides(r, id), "no collision")
      Test.assert_false(B.is_solid_opaque(r, id), "see-through is not solid opaque")
      Test.assert_eq_int(B.opacity_index(r, id), 2, "SeeThrough")
      Test.assert_eq_int(B.layer_index(r, id), 2, "Translucent")
      Test.assert_eq_int(B.style_index(r, id), 2, "a Model")
      Test.assert_eq_int(B.model_of(r, id), 4, "Model(4)")
      Test.assert_eq_int(B.emission(r, id), 10 + 20 * 256 + 30 * 65536 + 200 * 16777216, "r | g<<8 | b<<16 | strength<<24")
      Test.assert_eq_int(B.roughness(r, id), 77, "roughness")
      Test.assert_eq_int(B.emissive(r, id), 5, "emissive")
    end
  end

  describe "Blocks.register_family" do
    test "registers contiguous states and maps between base and state" do
      let (r0, _) = reg1(B.empty(), B.def())
      let (r, b) = fam(r0, B.def(), 8)
      Test.assert_eq_int(b, 2, "base follows the block before it")
      Test.assert_eq_int(B.count(r), 10, "air + 1 + 8")
      Test.assert_eq_int(B.state_of(r, b + 5), 5, "state of the sixth")
      Test.assert_eq_int(B.base_of(r, b + 5), b, "its base")
      Test.assert_eq_int(B.with_state(r, b, 7), b + 7, "last state")
      Test.assert_eq_int(B.with_state(r, b + 3, 0), b, "back to the base from any member")
      Test.assert_eq_int(B.with_state(r, b, 8), b, "a state past the family leaves the id alone")
      Test.assert_eq_int(B.with_state(r, b, -1), b, "as does a negative one")
      Test.assert_eq_int(B.base_of(r, 1), 1, "a plain block is its own base")
      Test.assert_eq_int(B.state_of(r, 1), 0, "in state 0")
    end
    test "a family of no states is an error" do
      let bad = match B.register_family(B.empty(), B.def(), 0) do
        Ok(_) -> false
        Err(_) -> true
      end
      Test.assert_true(bad, "Err")
    end
  end

  describe "Blocks lookups on ids nobody registered" do
    test "answer as air" do
      let (r, _) = reg1(B.empty(), B.def())
      Test.assert_true(is_air(r, -1), "negative")
      Test.assert_true(is_air(r, B.count(r)), "one past the end")
      Test.assert_true(is_air(r, 70000), "past sixteen bits")
      Test.assert_eq_int(B.base_of(r, 70000), 0, "base of garbage is air")
      Test.assert_eq_int(B.state_of(r, -5), 0, "state of garbage is 0")
      Test.assert_eq_int(B.with_state(r, 70000, 2), 70000, "with_state leaves garbage alone")
    end
  end

  describe "Blocks.gpu_table" do
    test "is eight words a block: six face textures, flags, emission" do
      let d = B.with_emission(B.with_faces(B.def(), 3, 4, 5), 10, 20, 30, 200)
      let (r, id) = reg1(B.empty(), d)
      let t = B.gpu_table(r)
      Test.assert_eq_int(NativeArray.length_i32(t), 8 * B.count(r), "eight words for each registered id")
      Test.assert_eq_int(NativeArray.get_i32(t, 8 * id + 0), 3, "top")
      Test.assert_eq_int(NativeArray.get_i32(t, 8 * id + 1), 4, "bottom")
      Test.assert_eq_int(NativeArray.get_i32(t, 8 * id + 2), 5, "+x")
      Test.assert_eq_int(NativeArray.get_i32(t, 8 * id + 3), 5, "-x")
      Test.assert_eq_int(NativeArray.get_i32(t, 8 * id + 4), 5, "+z")
      Test.assert_eq_int(NativeArray.get_i32(t, 8 * id + 5), 5, "-z")
      Test.assert_eq_int(int_and(NativeArray.get_i32(t, 8 * id + 6), 1), 1, "flags bit 0: it collides")
      Test.assert_eq_int(int_and(NativeArray.get_i32(t, 8 * id + 6) / 32, 3), 0, "flags bits 5-6: a cube")
      Test.assert_eq_int(int_and(NativeArray.get_i32(t, 8 * id + 7), 4294967295), B.emission(r, id), "the emission word")
    end
    test "air's row is all zero but for the style bits that say it has no mesh" do
      let t = B.gpu_table(B.empty())
      Test.assert_eq_int(NativeArray.get_i32(t, 0) + NativeArray.get_i32(t, 1) + NativeArray.get_i32(t, 5) + NativeArray.get_i32(t, 7), 0, "no textures, no light")
      Test.assert_eq_int(NativeArray.get_i32(t, 6), 96, "flags: style 3 and nothing else")
    end
  end

  describe "Blocks models" do
    test "a model keeps its quads and boxes" do
      let q = NativeArray.make_f32(12, 0.5)
      let (r, m) = B.add_model(B.empty(), q, Cons(Strata.Blocks.Box(0.0, 0.0, 0.0, 1.0, 0.5, 1.0), Nil))
      Test.assert_eq_int(m, 0, "first model index")
      Test.assert_eq_int(NativeArray.length_f32(B.model_quads(r, m)), 12, "quads kept")
      Test.assert_eq_int(List.length(B.model_boxes(r, m)), 1, "one box")
    end
    test "an unknown model has no quads and no boxes" do
      let r = B.empty()
      Test.assert_eq_int(NativeArray.length_f32(B.model_quads(r, 3)), 0, "empty quads")
      Test.assert_eq_int(List.length(B.model_boxes(r, 3)), 0, "no boxes")
      Test.assert_eq_int(List.length(B.model_boxes(r, -1)), 0, "negative index too")
    end
  end

  pfn fluid(r : Strata.Blocks.Registry) : (Strata.Blocks.Registry, Int) do
    match B.register_fluid(r, B.with_faces(B.with_collide(B.with_layer(B.with_opacity(B.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false), 30, 30, 30)) do
      Ok(p) -> p
      Err(_) -> (r, -1)
    end
  end

  describe "Blocks.register_fluid" do
    test "a fluid is eight states, fill 1 to 8, of one family" do
      let (r1, stone) = reg1(B.empty(), B.def())
      let (r, w) = fluid(r1)
      Test.assert_eq_int(B.count(r), w + 8, "eight ids")
      Test.assert_eq_int(B.fill(r, w), 1, "the base is one eighth")
      Test.assert_eq_int(B.fill(r, w + 4), 5, "state 4 is five eighths")
      Test.assert_eq_int(B.fill(r, w + 7), 8, "the last is full")
      Test.assert_true(B.is_fluid(r, w) && B.is_fluid(r, w + 7), "every state is a fluid")
      Test.assert_eq_int(B.fluid_base(r, w + 5), w, "its family's base")
      Test.assert_eq_int(B.light_class(r, w), B.light_class(r, w + 7), "one light class for all levels")
      Test.assert_eq_int(B.fill(r, stone), 8, "any other block is full")
      Test.assert_false(B.is_fluid(r, stone), "and no fluid")
      Test.assert_eq_int(B.fluid_base(r, stone), -1, "with no fluid family")
      Test.assert_eq_int(B.fill(r, 0), 0, "air holds nothing")
      Test.assert_eq_int(B.fill(r, 9999), 0, "nor does an id nobody registered")
      Test.assert_false(B.is_fluid(r, 9999), "which is no fluid either")
    end
  end

  describe "Blocks sound" do
    test "a block that sets nothing takes its class's sound" do
      let (r1, stone) = reg1(B.empty(), B.def())
      let (r2, glass) = reg1(r1, B.with_opacity(B.def(), Strata.Blocks.SeeThrough))
      let (r3, plant) = reg1(r2, B.with_style(B.with_opacity(B.def(), Strata.Blocks.Clear), Strata.Blocks.Cross))
      let (r4, water) = match B.register_fluid(r3, B.with_opacity(B.def(), Strata.Blocks.SeeThrough)) do
        Ok(p) -> p
        Err(_) -> (r3, -1)
      end
      Test.assert_true(B.sound_of(r4, 0) == (0, 0, 0), "air: nothing")
      Test.assert_true(B.sound_of(r4, stone) == (20, 25, 200), "solid")
      Test.assert_true(B.sound_of(r4, glass) == (60, 4, 80), "see-through")
      Test.assert_true(B.sound_of(r4, plant) == (0, 0, 0), "clear")
      Test.assert_true(B.sound_of(r4, water + 7) == (40, 10, 220), "a fluid")
      Test.assert_true(B.sound_of(r4, 9999) == (0, 0, 0), "an id nobody registered is air")
    end
    test "with_sound values round-trip and clamp" do
      let (r1, wool) = reg1(B.empty(), B.with_sound(B.def(), 230, 30, 255))
      let (r2, odd) = reg1(r1, B.with_sound(B.def(), -5, 400, 0))
      Test.assert_true(B.sound_of(r2, wool) == (230, 30, 255), "set values")
      Test.assert_true(B.sound_of(r2, odd) == (0, 255, 0), "clamped to 0..255")
    end
    test "sound leaves the light alone" do
      let d = B.with_material(B.def(), 12, 200)
      let (r1, a) = reg1(B.empty(), d)
      let (r2, b) = reg1(r1, B.with_sound(d, 230, 30, 255))
      let (r3, c) = reg1(r2, B.with_material(B.with_sound(B.def(), 230, 30, 255), 12, 200))
      Test.assert_eq_int(B.roughness(r3, b), B.roughness(r3, a), "roughness")
      Test.assert_eq_int(B.emissive(r3, b), B.emissive(r3, a), "emissive")
      Test.assert_true(B.sound_of(r3, c) == (230, 30, 255), "with_material after with_sound keeps the sound")
      Test.assert_eq_int(B.light_class(r3, b), B.light_class(r3, a), "the same light class")
      Test.assert_eq_int(B.light_class_count(r3), 2, "sound makes no light class of its own")
    end
  end

  describe "Blocks physics materials" do
    test "a plain block has the default materials" do
      let (r, id) = reg1(B.empty(), B.def())
      Test.assert_eq_int(B.density(r, id), 2000, "density kg/m3")
      Test.assert_eq_int(B.strength(r, id), 50000, "strength J/m2")
      Test.assert_eq_int(B.span_cm(r, id), 400, "span cm")
      Test.assert_eq_int(B.piece_cm(r, id), 50, "piece cm")
      Test.assert_false(B.anchors(r, id), "not an anchor")
    end

    test "with_physics values read back exactly" do
      let (r, id) = reg1(B.empty(), B.with_physics(B.def(), 2500, 2000, 600, 20, true))
      Test.assert_eq_int(B.density(r, id), 2500, "density")
      Test.assert_eq_int(B.strength(r, id), 2000, "strength")
      Test.assert_eq_int(B.span_cm(r, id), 600, "span")
      Test.assert_eq_int(B.piece_cm(r, id), 20, "piece")
      Test.assert_true(B.anchors(r, id), "anchor")
      Test.assert_eq_int(B.face_tex(r, id, 0), 0, "other fields unchanged")
      Test.assert_true(B.collides(r, id), "still collides")
    end

    test "a block that does not collide has no density" do
      let (r, id) = reg1(B.empty(), B.with_collide(B.def(), false))
      Test.assert_eq_int(B.density(r, id), 0, "no mass")
      Test.assert_eq_int(B.density(r, 0), 0, "air has none")
      Test.assert_eq_int(B.density(r, 999), 0, "nor an unregistered id")
    end

    test "max_span_cm is the largest span of any colliding block" do
      let (r1, _) = reg1(B.empty(), B.def())
      let (r2, _) = reg1(r1, B.with_physics(B.def(), 2000, 50000, 600, 50, false))
      let (r3, _) = reg1(r2, B.with_collide(B.with_physics(B.def(), 2000, 50000, 900, 50, false), false))
      Test.assert_eq_int(B.max_span_cm(r3), 600, "600 wins; the non-colliding 900 does not count")
    end
  end
end
