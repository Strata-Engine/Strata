-- Procedural trees in the library: the same seed, the same tree; the ids the caller gives.
mod Strata.Test.Trees do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias Strata.Trees as Trz

  pfn same_ids(a : Strata.Template.Template, b : Strata.Template.Template) : Bool do
    let ia = Strata.Template.t_ids(a)
    let ib = Strata.Template.t_ids(b)
    NativeArray.length_i32(ia) == NativeArray.length_i32(ib) && List.all(List.range(0, NativeArray.length_i32(ia)), fn i -> NativeArray.get_i32(ia, i) == NativeArray.get_i32(ib, i))
  end
  pfn at(t : Strata.Template.Template, x : Int, y : Int, z : Int) : Int do
    NativeArray.get_i32(Strata.Template.t_ids(t), x + Strata.Template.t_sx(t) * (y + Strata.Template.t_sy(t) * z))
  end
  pfn has(t : Strata.Template.Template, id : Int) : Bool do
    let ids = Strata.Template.t_ids(t)
    List.any(List.range(0, NativeArray.length_i32(ids)), fn i -> NativeArray.get_i32(ids, i) == id)
  end

  describe "Trees" do
    test "the same species, seed and voxel size build the same tree" do
      Test.assert_true(same_ids(Trz.build(0, 42, 0.4, 7, 8), Trz.build(0, 42, 0.4, 7, 8)), "equal ids")
    end
    test "the base is the middle of the bottom row" do
      let t = Trz.build(1, 7, 0.4, 31, 32)
      let h = Trz.half(t)
      Test.assert_true(h == (Strata.Template.t_sx(t) - 1) / 2 && at(t, h, 0, h) == 31, "wood at (half, 0, half)")
    end
    test "wood and leaves use the ids given" do
      let t = Trz.build(0, 3, 0.4, 41, 42)
      Test.assert_true(has(t, 41) && has(t, 42) && !has(t, 7) && !has(t, 8), "41 and 42, never 7 or 8")
    end
    test "pine and oak differ" do
      Test.assert_true(!same_ids(Trz.build(0, 5, 0.4, 7, 8), Trz.build(2, 5, 0.4, 7, 8)), "different trees")
    end
  end
end
