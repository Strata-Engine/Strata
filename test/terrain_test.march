-- Terrain: the generator contract, and the structure layer a generator may
-- carry beside it (a replay of its template pass).
mod Strata.Test.Terrain do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  import Test
  alias Strata.Terrain as Tn
  alias Strata.Coord as Cd
  alias Strata.Chunk as C

  pfn plain() : Strata.Terrain.Gen do Tn.gen(fn (k, seed) -> C.uniform(1)) end

  -- a stamps function: the site index + 1 (here the key's x + seed) on the bottom row, 0 above
  pfn rows(k : Strata.Coord.Key, seed : Int) : NativeI32Arr do rows_go(NativeArray.make_i32(32768, 0), Cd.kx(k) + seed, 0) end
  pfn rows_go(a : NativeI32Arr, v : Int, i : Int) : NativeI32Arr do
    if i >= 1024 do a else rows_go(NativeArray.set_i32(a, i, v), v, i + 1) end
  end

  pfn zeros(a : NativeI32Arr, i : Int) : Bool do
    if i >= 32768 do true else if NativeArray.get_i32(a, i) != 0 do false else zeros(a, i + 1) end end
  end

  describe "Terrain.stamps" do
    test "a generator without stamps gives 32768 zeros" do
      let a = Tn.stamps(plain(), Cd.key(3, -1, 2), 7)
      Test.assert_eq_int(NativeArray.length_i32(a), 32768, "one per voxel")
      Test.assert_true(zeros(a, 0), "all zero")
    end
    test "a generator with stamps gives what its function gives, and generates as before" do
      let g = Tn.with_stamps(plain(), Strata.Terrain.Stamps(fn (k, seed) -> rows(k, seed)))
      let a = Tn.stamps(g, Cd.key(3, 0, 0), 7)
      Test.assert_eq_int(NativeArray.get_i32(a, 0), 10, "the bottom row holds x + seed")
      Test.assert_eq_int(NativeArray.get_i32(a, 1023), 10, "all of it")
      Test.assert_eq_int(NativeArray.get_i32(a, 1024), 0, "the row above none")
      Test.assert_eq_int(C.get(Tn.run(g, Cd.key(3, 0, 0), 7), 5, 5, 5), 1, "run is the chunk function's")
    end
  end
end
