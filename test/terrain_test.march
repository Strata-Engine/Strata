-- Terrain: the generator contract, and the structure layer a generator may
-- carry beside it (a replay of its template pass).
mod Strata.Test.Terrain do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)
  needs IO.Process
  import Test
  alias Strata.Terrain as Tn
  alias Strata.Coord as Cd
  alias Strata.Chunk as C

  pfn plain() : Strata.Terrain.Gen do Tn.gen(fn (k, seed) -> C.uniform(1)) end

  -- a stamps function: the site index + 1 (here the key's x + seed) on the bottom row, 0 above
  pfn rows(k : Strata.Coord.Key, seed : Int) : NativeI32Arr do rows_go(NativeArray.make_i32(32768, 0), Cd.kx(k) + seed, 0) end
  pfn rows_go(a : NativeI32Arr, v : Int, i : Int) : NativeI32Arr do
    if i >= 1024 do a else rows_go(NativeArray.set_i32(a, i, v), v, i + 1) end
  end

  pfn zeros(a : NativeI32Arr, i : Int) : Bool do
    if i >= 32768 do true else if NativeArray.get_i32(a, i) != 0 do false else zeros(a, i + 1) end end
  end

  describe "Terrain.stamps" do
    test "a generator without stamps gives 32768 zeros" do
      let a = Tn.stamps(plain(), Cd.key(3, -1, 2), 7)
      Test.assert_eq_int(NativeArray.length_i32(a), 32768, "one per voxel")
      Test.assert_true(zeros(a, 0), "all zero")
    end
    test "a generator with stamps gives what its function gives, and generates as before" do
      let g = Tn.with_stamps(plain(), Strata.Terrain.Stamps(fn (k, seed) -> rows(k, seed)))
      let a = Tn.stamps(g, Cd.key(3, 0, 0), 7)
      Test.assert_eq_int(NativeArray.get_i32(a, 0), 10, "the bottom row holds x + seed")
      Test.assert_eq_int(NativeArray.get_i32(a, 1023), 10, "all of it")
      Test.assert_eq_int(NativeArray.get_i32(a, 1024), 0, "the row above none")
      Test.assert_eq_int(C.get(Tn.run(g, Cd.key(3, 0, 0), 7), 5, 5, 5), 1, "run is the chunk function's")
    end
  end

  describe "Terrain levels" do
    test "gen declares level 0; gen_levels declares its level" do
      Test.assert_eq_int(Tn.max_level(plain()), 0, "gen is level 0")
      Test.assert_eq_int(Tn.max_level(Tn.gen_levels(fn (k, seed) -> C.uniform(1), 3)), 3, "gen_levels says its own")
      Test.assert_eq_int(Tn.max_level(Tn.with_stamps(Tn.gen_levels(fn (k, seed) -> C.uniform(1), 2), Strata.Terrain.Stamps(fn (k, seed) -> rows(k, seed)))), 2, "with_stamps keeps it")
    end
    test "run of a key above the declared level is air; at or under it, the function's" do
      let g = Tn.gen_levels(fn (k, seed) -> C.uniform(1 + Cd.level(k)), 1)
      Test.assert_eq_int(C.uniform_id(Tn.run(g, Cd.key_at(0, 0, 0, 2), 7)), 0, "level 2 on a level-1 generator")
      Test.assert_eq_int(C.uniform_id(Tn.run(g, Cd.key_at(0, 0, 0, 1), 7)), 2, "level 1 is generated")
      Test.assert_eq_int(C.uniform_id(Tn.run(plain(), Cd.key_at(0, 0, 0, 1), 7)), 0, "gen gives the near field only")
    end
  end
  -- a column function that says how it was called: every chunk it makes is
  -- uniform with id 100 + the number of keys in the call
  pfn counted() : Strata.Terrain.Gen do
    Tn.with_column(Tn.gen_levels(fn (k, seed) -> C.uniform(1), 2), Strata.Terrain.Column(fn (ks, seed) -> List.map(ks, fn k -> C.uniform(100 + List.length(ks)))))
  end
  -- one that answers one chunk too few
  pfn short() : Strata.Terrain.Gen do
    Tn.with_column(plain(), Strata.Terrain.Column(fn (ks, seed) -> List.map(List.drop(ks, 1), fn k -> C.uniform(9))))
  end
  -- one whose chunks tell their keys apart: uniform with id 50 + y
  pfn by_y() : Strata.Terrain.Gen do
    Tn.with_column(Tn.gen(fn (k, seed) -> C.uniform(50 + Cd.ky(k))), Strata.Terrain.Column(fn (ks, seed) -> List.map(ks, fn k -> C.uniform(50 + Cd.ky(k)))))
  end
  pfn ids(cs : List(Strata.Chunk.Chunk)) : List(Int) do List.map(cs, fn c -> C.uniform_id(c)) end
  pfn col3(x : Int, z : Int) : List(Strata.Coord.Key) do Cons(Cd.key(x, 0, z), Cons(Cd.key(x, 1, z), Cons(Cd.key(x, 2, z), Nil))) end

  describe "Terrain.run_column" do
    test "no keys, no chunks" do
      Test.assert_eq_int(List.length(Tn.run_column(counted(), Nil, 7)), 0, "none")
    end
    test "a generator without a column function answers the single runs" do
      Test.assert_true(ids(Tn.run_column(plain(), col3(4, -2), 7)) == Cons(1, Cons(1, Cons(1, Nil))), "three of the chunk function's")
    end
    test "the keys of one column go to the column function in one call, in order" do
      Test.assert_true(ids(Tn.run_column(counted(), col3(4, -2), 7)) == Cons(103, Cons(103, Cons(103, Nil))), "one call with three keys")
      Test.assert_true(ids(Tn.run_column(by_y(), col3(4, -2), 7)) == Cons(50, Cons(51, Cons(52, Nil))), "each key its own chunk, in the order asked")
      Test.assert_true(ids(Tn.run_column(by_y(), List.reverse(col3(4, -2)), 7)) == Cons(52, Cons(51, Cons(50, Nil))), "and in the other order")
    end
    test "keys of two columns, or of two levels, are run one by one" do
      let two = Cons(Cd.key(4, 0, -2), Cons(Cd.key(5, 0, -2), Nil))
      Test.assert_true(ids(Tn.run_column(counted(), two, 7)) == Cons(1, Cons(1, Nil)), "two columns: the chunk function")
      let levels = Cons(Cd.key(4, 0, -2), Cons(Cd.key_at(4, 0, -2, 1), Nil))
      Test.assert_true(ids(Tn.run_column(counted(), levels, 7)) == Cons(1, Cons(1, Nil)), "two levels: the chunk function")
      Test.assert_false(Tn.same_column(Cd.key(4, 0, -2), Cd.key(4, 0, -3)), "another z is another column")
      Test.assert_true(Tn.same_column(Cd.key(4, 0, -2), Cd.key(4, 9, -2)), "another y is the same column")
    end
    test "a column above the generator's levels is air, and the column function is not asked" do
      let high = Cons(Cd.key_at(4, 0, -2, 3), Cons(Cd.key_at(4, 1, -2, 3), Nil))
      Test.assert_true(ids(Tn.run_column(counted(), high, 7)) == Cons(0, Cons(0, Nil)), "air, as run gives")
    end
    test "a column function that answers another number of chunks is not believed" do
      Test.assert_true(ids(Tn.run_column(short(), col3(4, -2), 7)) == Cons(1, Cons(1, Cons(1, Nil))), "the single runs instead")
    end
    test "with_stamps and with_column each keep the other" do
      let g = Tn.with_stamps(counted(), Strata.Terrain.Stamps(fn (k, seed) -> rows(k, seed)))
      Test.assert_true(ids(Tn.run_column(g, col3(1, 1), 7)) == Cons(103, Cons(103, Cons(103, Nil))), "the column function is still there")
      let g2 = Tn.with_column(Tn.with_stamps(plain(), Strata.Terrain.Stamps(fn (k, seed) -> rows(k, seed))), Strata.Terrain.Column(fn (ks, seed) -> List.map(ks, fn k -> C.uniform(7))))
      Test.assert_eq_int(NativeArray.get_i32(Tn.stamps(g2, Cd.key(3, 0, 0), 7), 0), 10, "the stamps are still there")
    end
  end
end
