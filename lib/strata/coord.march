-- Coord — world, chunk and local voxel coordinates, and the voxel scale.
--
-- A chunk is 32 x 32 x 32 voxels, fixed at compile time so the flat index
-- carries refinements Z3 can discharge. A world voxel coordinate splits into
-- a chunk coordinate and a local one by FLOOR division, so voxel -1 is local
-- 31 of chunk -1 and the split has no seam at the origin. The voxel scale
-- (metres per voxel) is a runtime value a world carries; nothing here fixes
-- it.
mod Strata.Coord do

  fn side() : Int do 32 end
  fn volume() : Int do 32768 end

  doc "The local coordinate 0..31 of world voxel coordinate [v] inside its chunk."
  fn local_of(v : Int) : {Int | 0 <= _ && _ < 32} do
    -- two's complement: the low five bits are v mod 32, floored, for any sign
    let m = int_and(v, 31)
    if m < 0 do 0 else if m > 31 do 31 else m end end
  end

  doc "The chunk coordinate holding world voxel coordinate [v]: floor(v / 32)."
  fn chunk_of(v : Int) : Int do (v - local_of(v)) / 32 end

  doc "Flat index of a local voxel: x + 32 * (z + 32 * y). The refinements let Z3 discharge the bound."
  fn index(x : {Int | 0 <= _ && _ < 32}, y : {Int | 0 <= _ && _ < 32}, z : {Int | 0 <= _ && _ < 32})
      : {Int | 0 <= _ && _ < 32768} do
    x + 32 * (z + 32 * y)
  end

  -- A chunk's name: its chunk coordinates and a level of detail. The level is
  -- always 0 for now; it is in the key so a coarser level can be added without
  -- changing every signature that carries one.
  type Key = ChunkKey(Int, Int, Int, Int)

  doc "The key of chunk ([cx], [cy], [cz]) at level 0."
  fn key(cx : Int, cy : Int, cz : Int) : Key do ChunkKey(cx, cy, cz, 0) end

  doc "The key of the chunk holding world voxel ([x], [y], [z])."
  fn key_of_voxel(x : Int, y : Int, z : Int) : Key do ChunkKey(chunk_of(x), chunk_of(y), chunk_of(z), 0) end

  fn kx(k : Key) : Int do match k do ChunkKey(x, _, _, _) -> x end end
  fn ky(k : Key) : Int do match k do ChunkKey(_, y, _, _) -> y end end
  fn kz(k : Key) : Int do match k do ChunkKey(_, _, z, _) -> z end end
  fn level(k : Key) : Int do match k do ChunkKey(_, _, _, l) -> l end end

  fn key_eq(a : Key, b : Key) : Bool do
    match a do
      ChunkKey(x0, y0, z0, l0) ->
        match b do
          ChunkKey(x1, y1, z1, l1) -> x0 == x1 && y0 == y1 && z0 == z1 && l0 == l1
        end
    end
  end

  -- One round of a 32-bit integer finaliser; keeps the result non-negative.
  pfn mix(h : Int) : Int do
    let a = int_and(h, 4294967295)
    let b = int_and(int_xor(a, a / 65536) * 2246822519, 4294967295)
    let c = int_and(int_xor(b, b / 8192) * 3266489917, 4294967295)
    int_xor(c, c / 65536)
  end

  doc "A non-negative hash of a key that tells axes, signs and levels apart."
  fn key_hash(k : Key) : Int do
    match k do
      ChunkKey(x, y, z, l) -> mix(mix(mix(mix(x + 2654435769) + y * 40503 + 97) + z * 69069 + 13) + l * 31)
    end
  end

  doc "The voxel coordinate holding position [metres] at [scale] metres per voxel: floor(metres / scale)."
  fn to_voxel(scale : Float, metres : Float) : Int do float_to_int(Math.floor(metres /. scale)) end

  doc "The position in metres of voxel coordinate [v]'s low corner."
  fn to_metres(scale : Float, v : Int) : Float do int_to_float(v) *. scale end
end
