-- GuiDraw: the parts of the interface toolkit that touch C. `paint` draws a
-- Strata.Gui result into a Strata.Ui display; `measurer` is the text
-- measure a theme needs, from Strata.Text; `sample` reads a frame's pointer,
-- wheel and typing from the window. Strata.Gui itself stays pure, so its
-- tests link no C.
mod Strata.GuiDraw do

  doc "Draw a result's boxes and words into [u], in order, on top of what [u] already holds."
  fn paint(u : Strata.Ui.Ui, r : Strata.Gui.GResult) : Strata.Ui.Ui do
    Strata.Gui.fold_draws(r, u,
      fn (acc, x, y, w, h, c) -> Strata.Ui.rect(acc, 0, x, y, w, h, c),
      fn (acc, x, y, font, size, c, s) -> Strata.Text.text(acc, 0, x, y, font, size, c, s))
  end

  doc "Text measured by Strata.Text: (width, height) of one unwrapped line, in the units [size] is in."
  fn measurer() : Int -> Float -> String -> (Float, Float) do
    fn (font, size, s) -> match Strata.Text.measure(font, size, s, 0.0) do (w, h, _) -> (w, h) end
  end

  doc "The default theme measured with Strata.Text in the built-in font."
  fn theme() : Strata.Gui.GTheme do
    let t = Strata.Gui.theme(measurer())
    { t with gt_font: Strata.Text.default_font() }
  end

  doc "A frame's input from the window as of the last poll: the pointer in interface pixels for a display at [scale] (None when [pointing] is false, as while the cursor is captured), the left button, the wheel, what was typed, and [input], already stepped this frame."
  fn sample(input : Strata.Input.Input, scale : Float, pointing : Bool) : Strata.Gui.GFrame do
    let s = if scale > 0.01 do scale else 1.0 end
    let p = if pointing do Some((Strata.Ffi.Vk.mouse_x() /. s, Strata.Ffi.Vk.mouse_y() /. s)) else None end
    Strata.Gui.frame(p, pointing && Strata.Ffi.Vk.mouse_button(0), if pointing do Strata.Ffi.Vk.scroll_y() else 0.0 end, Strata.Ffi.Vk.typed(), input)
  end
end
