-- Character — a rig and a size from a MagicaVoxel character file.
--
-- The file's convention (docs/superpowers/plans/2026-11-16-strata-characters.md):
--
-- Each part is one model, named `pelvis spine head arm_l_upper arm_l_fore
-- arm_l_hand arm_r_upper arm_r_fore arm_r_hand leg_l_thigh leg_l_shin
-- leg_l_foot leg_r_thigh leg_r_shin leg_r_foot` (all fifteen, once each),
-- then any extras, `extra:<parent>:<label>`, whose parent is one of those or
-- the label of an extra earlier in the file. The rig's parts are the fifteen in that order
-- (the humanoid of viewer/lib/figures.march), then the extras in file order.
--
-- Axes: the rig's x is the file's x, its y the file's z (up), its z the
-- file's y; the character faces the file's +y, its left arm on +x. A model's
-- low corner is its translation less floor(size / 2) (MagicaVoxel centres a
-- model on its translation).
--
-- Joints. The pelvis turns about the middle of its bottom face, and stands
-- over the figure's origin at the height that puts the lowest foot on y 0.
-- The spine and head join their parent at their bottom face, arm and leg
-- parts at their top face: at the middle of where that face overlaps the
-- parent's box seen from above, or the middle of the face where it doesn't
-- (an arm hanging beside the spine). Extras turn about their low corner. A
-- joint further outside its parent's box than a voxel plus half the part's
-- width is refused, as is an extra whose box doesn't touch its parent's, as is a part
-- over 128 voxels a side, more than 64 parts, or a name out of place.
--
-- Sockets: the middle of each hand's bottom face, 1/32 m up (socket 0 left,
-- 1 right). Both legs declared, sole one voxel. Mask 0: the right arm.
--
-- Voxel size: the file's own (`_strata_voxel` on its root transform), else 1/16 m.
--
-- Palette: the file's colours (sRGB, turned to linear light), emission and roughness. Indices 241-244 are
-- trim: `trimmed` gives them a shade, each scaled by its own brightness over
-- that of the first trim index present, so a darker trim stays darker.
mod Strata.Character do

  needs IO.Foreign

  alias Strata.Rig as ChrRg

  -- A character's size in metres: feet to its top voxel, half its larger width (x or z) at rest, and its eye, 0.12 m under its top.
  type CharSize = { height : Float, half_w : Float, eye : Float }

  -- A character: its rig, its size, and its trim entries present (index, file colour).
  type Character = { rig : Strata.Rig.Rig, size : CharSize, trim : List((Int, Float, Float, Float)) }

  -- a part as placed: its name, its parent's place in the order (-1 the root), its low corner and size (rig axes, voxels), its voxels
  type ChrPlaced = ChrPlaced(String, Int, Int, Int, Int, Int, Int, Int, NativeU8Arr)

  -- the file's voxel size: its own, else 1/16 m
  pfn voxel_of(v : Strata.Vox.Vox) : Float do if v.scale > 0.0 do v.scale else 0.0625 end end

  doc "The fifteen part names, in the rig's order."
  fn part_names() : List(String) do
    ["pelvis", "spine", "head", "arm_l_upper", "arm_l_fore", "arm_l_hand", "arm_r_upper", "arm_r_fore", "arm_r_hand",
     "leg_l_thigh", "leg_l_shin", "leg_l_foot", "leg_r_thigh", "leg_r_shin", "leg_r_foot"]
  end
  pfn parent_index(i : Int) : Int do List.nth([-1, 0, 1, 1, 3, 4, 1, 6, 7, 0, 9, 10, 0, 12, 13], i) end
  -- 0 the root, 1 joins at its bottom face, 2 at its top face, 3 an extra (its low corner)
  pfn join_kind(i : Int) : Int do if i == 0 do 0 else if i <= 2 do 1 else if i < 15 do 2 else 3 end end end end

  pfn imin(a : Int, b : Int) : Int do if a < b do a else b end end
  pfn imax(a : Int, b : Int) : Int do if a > b do a else b end end

  -- ── names ────────────────────────────────────────────────────────────────
  pfn count_named(ms : List(Strata.Vox.VoxModel), n : String) : Int do List.length(List.filter(ms, fn m -> m.name == n)) end
  pfn extra_parent(n : String) : Option(String) do
    if !String.starts_with(n, "extra:") do None
    else match String.split(n, ":") do Cons(_, Cons(p, Cons(_, _))) -> Some(p) | _ -> None end end
  end
  -- the first name out of place, if any
  pfn check_names(ms : List(Strata.Vox.VoxModel)) : Option(String) do
    match List.find(part_names(), fn n -> count_named(ms, n) != 1) do
      Some(n) -> Some(if count_named(ms, n) == 0 do "missing part " ++ n else "part " ++ n ++ " appears " ++ int_to_string(count_named(ms, n)) ++ " times" end)
      None ->
        match List.find(ms, fn m -> !List.member(part_names(), m.name) && extra_parent(m.name) == None) do
          Some(m) -> Some("part name \"" ++ m.name ++ "\" is neither one of the fifteen nor extra:<parent>:<label>")
          None -> match List.find(ms, fn m -> m.sx > 128 || m.sy > 128 || m.sz > 128) do
            Some(m) -> Some("part " ++ m.name ++ " is over 128 voxels a side")
            None -> if List.length(ms) > 64 do Some("over 64 parts") else None end
          end
        end
    end
  end

  -- the parts in the rig's order, each with its parent's index; or the first extra whose parent isn't before it
  pfn place(m : Strata.Vox.VoxModel, parent : Int) : ChrPlaced do
    ChrPlaced(m.name, parent, m.tx - m.sx / 2, m.tz - m.sz / 2, m.ty - m.sy / 2, m.sx, m.sz, m.sy, m.voxels)
  end
  pfn order_extras(es : List(Strata.Vox.VoxModel), names : List(String), acc : List(ChrPlaced)) : Result(List(ChrPlaced), String) do
    match es do
      Nil -> Ok(List.reverse(acc))
      Cons(m, rest) ->
        match extra_parent(m.name) do
          None -> Err("part " ++ m.name ++ ": no parent")
          Some(p) ->
            match List.find_index(names, fn n -> n == p || String.starts_with(n, "extra:") && String.ends_with(n, ":" ++ p)) do
              None -> Err("part " ++ m.name ++ ": its parent " ++ p ++ " is not a part before it")
              Some(i) -> order_extras(rest, List.append(names, [m.name]), Cons(place(m, i), acc))
            end
        end
    end
  end
  pfn ordered(ms : List(Strata.Vox.VoxModel)) : Result(List(ChrPlaced), String) do
    let main = List.map(List.enumerate(part_names()), fn ip -> match ip do (i, n) -> place(unwrap(List.find(ms, fn m -> m.name == n)), if i == 0 do -1 else parent_index(i) end) end)
    let extras = List.filter(ms, fn m -> extra_parent(m.name) != None)
    match order_extras(extras, part_names(), Nil) do Ok(es) -> Ok(List.append(main, es)) | Err(e) -> Err(e) end
  end

  -- ── joints ───────────────────────────────────────────────────────────────
  -- the middle of [a0, a1) and [b0, b1) where they overlap, else of [a0, a1)
  pfn overlap_mid(a0 : Int, a1 : Int, b0 : Int, b1 : Int) : Float do
    let lo = imax(a0, b0)
    let hi = imin(a1, b1)
    if hi > lo do int_to_float(lo + hi) /. 2.0 else int_to_float(a0 + a1) /. 2.0 end
  end
  -- the joint of part i (figure voxels) given its parent's box
  pfn joint(i : Int, c : ChrPlaced, p : ChrPlaced) : (Float, Float, Float) do
    match (c, p) do
      (ChrPlaced(_, _, x, y, z, sx, sy, sz, _), ChrPlaced(_, _, px, _, pz, psx, _, psz, _)) ->
        let k = join_kind(i)
        if k == 3 do (int_to_float(x), int_to_float(y), int_to_float(z))
        else (overlap_mid(x, x + sx, px, px + psx), int_to_float(if k == 1 do y else y + sy end), overlap_mid(z, z + sz, pz, pz + psz)) end
    end
  end
  -- j within p's box grown by m voxels
  pfn inside(j : (Float, Float, Float), p : ChrPlaced, m : Float) : Bool do
    match (j, p) do
      ((jx, jy, jz), ChrPlaced(_, _, x, y, z, sx, sy, sz, _)) ->
        jx >= int_to_float(x) -. m && jx <= int_to_float(x + sx) +. m && jy >= int_to_float(y) -. m && jy <= int_to_float(y + sy) +. m && jz >= int_to_float(z) -. m && jz <= int_to_float(z + sz) +. m
    end
  end
  -- how far a joint may lie outside its parent: a voxel, plus half the child's width (an arm hanging beside the chest)
  pfn margin(c : ChrPlaced) : Float do match c do ChrPlaced(_, _, _, _, _, sx, _, sz, _) -> 1.0 +. int_to_float(imax(sx, sz)) /. 2.0 end end
  -- two boxes no more than a voxel apart on every axis (an extra must touch its parent somewhere)
  pfn touching(a : ChrPlaced, b : ChrPlaced) : Bool do
    match (a, b) do
      (ChrPlaced(_, _, ax, ay, az, asx, asy, asz, _), ChrPlaced(_, _, bx, b_y, bz, bsx, bsy, bsz, _)) ->
        ax <= bx + bsx + 1 && bx <= ax + asx + 1 && ay <= b_y + bsy + 1 && b_y <= ay + asy + 1 && az <= bz + bsz + 1 && bz <= az + asz + 1
    end
  end
  pfn name_of(c : ChrPlaced) : String do match c do ChrPlaced(n, _, _, _, _, _, _, _, _) -> n end end
  pfn parent_of(c : ChrPlaced) : Int do match c do ChrPlaced(_, p, _, _, _, _, _, _, _) -> p end end
  pfn low_y(c : ChrPlaced) : Int do match c do ChrPlaced(_, _, _, y, _, _, _, _, _) -> y end end
  pfn has_voxels(c : ChrPlaced) : Bool do match c do ChrPlaced(_, _, _, _, _, _, _, _, v) -> NativeArray.length_u8(v) > 0 end end

  -- ── the rig ──────────────────────────────────────────────────────────────
  pfn voxels_go(r : Strata.Rig.Rig, p : Int, v : NativeU8Arr, i : Int, n : Int) : Strata.Rig.Rig do
    if i >= n do r
    else
      let c = NativeArray.get_u8(v, 4 * i + 3)
      let r2 = if c == 0 do r else ChrRg.voxel(r, p, NativeArray.get_u8(v, 4 * i), NativeArray.get_u8(v, 4 * i + 2), NativeArray.get_u8(v, 4 * i + 1), c) end
      voxels_go(r2, p, v, i + 1, n)
    end
  end
  pfn used_go(v : NativeU8Arr, i : Int, n : Int, acc : List(Int)) : List(Int) do
    if i >= n do acc else
      let c = NativeArray.get_u8(v, 4 * i + 3)
      used_go(v, i + 1, n, if c == 0 || List.member(acc, c) do acc else Cons(c, acc) end)
    end
  end
  pfn used(ps : List(ChrPlaced)) : List(Int) do
    List.fold_left(ps, Nil, fn (acc, c) -> match c do ChrPlaced(_, _, _, _, _, _, _, _, v) -> used_go(v, 0, NativeArray.length_u8(v) / 4, acc) end)
  end
  -- a palette channel in linear light (the file's colours are sRGB; the renderer's palette is linear)
  pfn ch(pal : NativeU8Arr, i : Int, k : Int) : Float do Math.pow(int_to_float(NativeArray.get_u8(pal, 4 * i + k)) /. 255.0, 2.2) end

  -- part i of ps added to r, its joint checked; ps all, done the parts added so far
  pfn add_parts(r : Strata.Rig.Rig, ps : List(ChrPlaced), i : Int, shift : Int) : Result(Strata.Rig.Rig, String) do
    if i >= List.length(ps) do Ok(r)
    else
      let c = List.nth(ps, i)
      match c do
        ChrPlaced(name, par, x, y, z, sx, sy, sz, v) ->
          if par < 0 do
            match ChrRg.part(r, -1, 0.0, int_to_float(y + shift), 0.0, sx, sy, sz) do
              (r1, p) -> add_parts(voxels_go(ChrRg.anchor(r1, p, int_to_float(sx) /. 2.0, 0.0, int_to_float(sz) /. 2.0), p, v, 0, NativeArray.length_u8(v) / 4), ps, i + 1, shift)
            end
          else
            let pc = List.nth(ps, par)
            let j = joint(i, c, pc)
            if !(if join_kind(i) == 3 do touching(c, pc) else inside(j, pc, margin(c)) end) do Err("part " ++ name ++ " doesn't touch its parent " ++ name_of(pc))
            else
              match (j, pc) do
                ((jx, jy, jz), ChrPlaced(_, _, px, py, pz, _, _, _, _)) ->
                  match ChrRg.part(r, par, jx -. int_to_float(px), jy -. int_to_float(py), jz -. int_to_float(pz), sx, sy, sz) do
                    (r1, p) -> add_parts(voxels_go(ChrRg.anchor(r1, p, jx -. int_to_float(x), jy -. int_to_float(y), jz -. int_to_float(z)), p, v, 0, NativeArray.length_u8(v) / 4), ps, i + 1, shift)
                  end
              end
            end
          end
      end
    end
  end

  pfn colours(r : Strata.Rig.Rig, v : Strata.Vox.Vox, idx : List(Int)) : Strata.Rig.Rig do
    List.fold_left(idx, r, fn (acc, i) -> ChrRg.colour(acc, i, ch(v.palette, i, 0), ch(v.palette, i, 1), ch(v.palette, i, 2), NativeArray.get_f32(v.rough, i), NativeArray.get_f32(v.emit, i)))
  end
  pfn sockets(r : Strata.Rig.Rig, ps : List(ChrPlaced), vm : Float) : Strata.Rig.Rig do
    let at = fn p -> match List.nth(ps, p) do ChrPlaced(_, _, _, _, _, sx, _, sz, _) -> (int_to_float(sx) /. 2.0, int_to_float(sz) /. 2.0) end
    match (at(5), at(8)) do
      ((lx, lz), (rx, rz)) ->
        let r1 = Tuple.first(ChrRg.socket(r, 5, lx, 0.03125 /. vm, lz, Strata.Math.Quat.identity()))
        let r2 = Tuple.first(ChrRg.socket(r1, 8, rx, 0.03125 /. vm, rz, Strata.Math.Quat.identity()))
        Tuple.first(ChrRg.mask(ChrRg.leg(ChrRg.leg(r2, 9, 10, 11, vm), 12, 13, 14, vm), [6]))
    end
  end

  pfn size_of(ps : List(ChrPlaced), shift : Int, vm : Float) : CharSize do
    let full = List.filter(ps, has_voxels)
    let top = List.fold_left(full, -100000, fn (a, c) -> match c do ChrPlaced(_, _, _, y, _, _, sy, _, _) -> imax(a, y + sy) end)
    let x0 = List.fold_left(full, 100000, fn (a, c) -> match c do ChrPlaced(_, _, x, _, _, _, _, _, _) -> imin(a, x) end)
    let x1 = List.fold_left(full, -100000, fn (a, c) -> match c do ChrPlaced(_, _, x, _, _, sx, _, _, _) -> imax(a, x + sx) end)
    let z0 = List.fold_left(full, 100000, fn (a, c) -> match c do ChrPlaced(_, _, _, _, z, _, _, _, _) -> imin(a, z) end)
    let z1 = List.fold_left(full, -100000, fn (a, c) -> match c do ChrPlaced(_, _, _, _, z, _, _, sz, _) -> imax(a, z + sz) end)
    let h = int_to_float(top + shift) *. vm
    { height: h, half_w: int_to_float(imax(x1 - x0, z1 - z0)) *. vm /. 2.0, eye: h -. 0.12 }
  end

  doc "The character a MagicaVoxel file describes, or why it doesn't follow the convention (naming the part)."
  fn from_vox(v : Strata.Vox.Vox) : Result(Character, String) do
    match check_names(v.models) do
      Some(e) -> Err("character: " ++ e)
      None ->
        match ordered(v.models) do
          Err(e) -> Err("character: " ++ e)
          Ok(ps) ->
            let shift = 0 - imin(low_y(List.nth(ps, 11)), low_y(List.nth(ps, 14)))
            let idx = List.sort_by(used(ps), fn (a, b) -> a < b)
            let vm = voxel_of(v)
            match add_parts(colours(ChrRg.new(vm), v, idx), ps, 0, shift) do
              Err(e) -> Err("character: " ++ e)
              Ok(r0) ->
                let r = sockets(r0, ps, vm)
                if ChrRg.refused(r) > 0 do Err("character: the rig refused a call: " ++ ChrRg.why(r))
                else
                  let trim = List.map(List.filter(idx, fn i -> i >= 241 && i <= 244), fn i -> (i, ch(v.palette, i, 0), ch(v.palette, i, 1), ch(v.palette, i, 2)))
                  Ok({ rig: r, size: size_of(ps, shift, vm), trim: trim })
                end
            end
        end
    end
  end

  doc "The character in the file at [path], or why not."
  fn load(path : String) : Result(Character, String) do
    match Strata.Vox.read(path) do Ok(v) -> from_vox(v) | Err(e) -> Err(e) end
  end

  pfn bright(r : Float, g : Float, b : Float) : Float do
    let m = if r > g do r else g end
    if m > b do m else b end
  end

  pfn trim_one(acc : Strata.Rig.Rig, pal : List((Int, Float, Float, Float, Float, Float)), base : Float, t : (Int, Float, Float, Float), r : Float, g : Float, b : Float) : Strata.Rig.Rig do
    match t do
      (i, tr, tg, tb) ->
        let k = if base > 0.0 do bright(tr, tg, tb) /. base else 1.0 end
        match List.find(pal, fn e -> match e do (j, _, _, _, _, _) -> j == i end) do
          Some((_, _, _, _, ro, em)) -> ChrRg.colour(acc, i, r *. k, g *. k, b *. k, ro, em)
          None -> acc
        end
    end
  end

  doc "The character's rig with its trim (palette 241-244) in the shade (r, g, b), each entry scaled by its brightness over the first's."
  fn trimmed(c : Character, r : Float, g : Float, b : Float) : Strata.Rig.Rig do
    match c.trim do
      Nil -> c.rig
      Cons((_, fr, fg, fb), _) ->
        let base = bright(fr, fg, fb)
        let pal = ChrRg.palette(c.rig)
        List.fold_left(c.trim, c.rig, fn (acc, t) -> trim_one(acc, pal, base, t, r, g, b))
    end
  end
end
