-- Seabed — a sea floor a game can reshape: dredge it deeper, raise reefs
-- and shoals, and hand the result to the waves (Strata.Waves) or to anything
-- that needs the water's depth (a ship's keel, a mesh of the floor).
--
-- A floor is a w x h grid of cells (x fastest), each the water's depth in
-- voxels (0 is land). Its base comes from the coastline: a shelf that starts
-- [shore] voxels deep beside land and deepens with the distance from it (a
-- 3-4 chamfer distance over the cells) to a deepest depth. A game's edits go
-- on top: dig makes a rectangle at least so deep, raise makes it no deeper,
-- each easing back to the floor around it over a margin of cells, so the
-- result is channels and mounds, not pits and pillars. A game keeps its own
-- short list of edits and replays them over the regenerated base, so what it
-- saves is small and the base is the same every time.
mod Strata.Seabed do

  -- The water's depth in voxels a cell (x fastest; 0 is land, -2..-1 dry sand above the surface that is still not land), over w x h cells.
  type Seafloor = { depth : NativeIntArr, w : Int, h : Int }

  -- An edit to a floor, in cells: Dig(x0, z0, x1, z1, depth, margin) makes the rectangle x0..x1, z0..z1 at least [depth] voxels deep; Raise(..., depth, margin) makes it no deeper than [depth] (a reef's top). Either eases back to the floor around it over [margin] cells and never turns land to water or water to land.
  type Edit = Dig(Int, Int, Int, Int, Int, Int) | Raise(Int, Int, Int, Int, Int, Int)

  pfn far() : Int do 1000000 end
  pfn least(a : Int, b : Int) : Int do if a < b do a else b end end
  pfn most(a : Int, b : Int) : Int do if a > b do a else b end end
  pfn clampi(v : Int, lo : Int, hi : Int) : Int do if v < lo do lo else if v > hi do hi else v end end end

  -- ── The shelf ────────────────────────────────────────────────────────────
  pfn seed(land : NativeIntArr, a : NativeIntArr, i : Int, n : Int) : NativeIntArr do
    if i >= n do a else seed(land, NativeArray.set_int(a, i, if NativeArray.get_int(land, i) != 0 do 0 else far() end), i + 1, n) end
  end
  pfn at(a : NativeIntArr, w : Int, h : Int, x : Int, z : Int) : Int do
    if x < 0 || z < 0 || x >= w || z >= h do far() else NativeArray.get_int(a, z * w + x) end
  end
  pfn forward(a : NativeIntArr, w : Int, h : Int, i : Int) : NativeIntArr do
    if i >= w * h do a else
      let x = i % w
      let z = i / w
      let d = least(least(NativeArray.get_int(a, i), at(a, w, h, x - 1, z) + 3), least(at(a, w, h, x, z - 1) + 3,
        least(at(a, w, h, x - 1, z - 1) + 4, at(a, w, h, x + 1, z - 1) + 4)))
      forward(NativeArray.set_int(a, i, d), w, h, i + 1)
    end
  end
  pfn backward(a : NativeIntArr, w : Int, h : Int, i : Int) : NativeIntArr do
    if i < 0 do a else
      let x = i % w
      let z = i / w
      let d = least(least(NativeArray.get_int(a, i), at(a, w, h, x + 1, z) + 3), least(at(a, w, h, x, z + 1) + 3,
        least(at(a, w, h, x + 1, z + 1) + 4, at(a, w, h, x - 1, z + 1) + 4)))
      backward(NativeArray.set_int(a, i, d), w, h, i - 1)
    end
  end
  doc "The 3-4 chamfer distance of every cell from the nearest land cell of [land] (non-zero is land; x fastest, w x h): 3 a cell across, 4 a cell diagonally. Cells with no land anywhere stay at a million."
  fn coast_distance(land : NativeIntArr, w : Int, h : Int) : NativeIntArr do
    let n = w * h
    backward(forward(seed(land, NativeArray.make_int(n, 0), 0, n), w, h, 0), w, h, n - 1)
  end
  pfn depths(dist : NativeIntArr, cell_vox : Int, shore : Int, num : Int, den : Int, deepest : Int, a : NativeIntArr, i : Int, n : Int) : NativeIntArr do
    if i >= n do a else
      let d = NativeArray.get_int(dist, i)
      let v = if d == 0 do 0 else if d >= far() do deepest else clampi(shore + d * cell_vox / 3 * num / den, shore, deepest) end end
      depths(dist, cell_vox, shore, num, den, deepest, NativeArray.set_int(a, i, v), i + 1, n)
    end
  end
  doc "A floor from a coastline: [land] (non-zero is land, x fastest, w x h cells of [cell_vox] voxels). Beside land the water is [shore] voxels deep, deepening [num]/[den] voxels a voxel of distance from land, to [deepest]."
  fn shelf(land : NativeIntArr, w : Int, h : Int, cell_vox : Int, shore : Int, num : Int, den : Int, deepest : Int) : Seafloor do
    let n = w * h
    { depth: depths(coast_distance(land, w, h), cell_vox, shore, num, den, deepest, NativeArray.make_int(n, 0), 0, n), w: w, h: h }
  end

  -- ── Edits ────────────────────────────────────────────────────────────────
  -- how many cells outside the rectangle (x0..x1, z0..z1) a cell is, the larger axis
  pfn outside(x : Int, z : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int) : Int do
    most(most(x0 - x, x - x1), most(most(z0 - z, z - z1), 0))
  end
  pfn edit_go(f : Seafloor, deepen : Bool, x0 : Int, z0 : Int, x1 : Int, z1 : Int, target : Int, margin : Int, a : NativeIntArr, x : Int, z : Int) : NativeIntArr do
    if z > z1 + margin do a
    else if x > x1 + margin do edit_go(f, deepen, x0, z0, x1, z1, target, margin, a, x0 - margin, z + 1)
    else if x < 0 || z < 0 || x >= f.w || z >= f.h do edit_go(f, deepen, x0, z0, x1, z1, target, margin, a, x + 1, z)
    else
      let i = z * f.w + x
      let now = NativeArray.get_int(a, i)
      let a = if now == 0 do a else
        -- the target, easing back to the cell's own depth over the margin
        let k = outside(x, z, x0, z0, x1, z1)
        let eased = target + (now - target) * k / (margin + 1)
        -- dry sand (below 0) is already shallower than any reef: raising leaves it be
        NativeArray.set_int(a, i, if deepen do most(now, eased) else if now < 0 do now else most(1, least(now, eased)) end end)
      end
      edit_go(f, deepen, x0, z0, x1, z1, target, margin, a, x + 1, z)
    end end end
  end
  doc "The floor with cells x0..x1, z0..z1 at least [depth] voxels deep, easing back over [margin] cells. Land stays land."
  fn dig(f : Seafloor, x0 : Int, z0 : Int, x1 : Int, z1 : Int, depth : Int, margin : Int) : Seafloor do
    { f with depth: edit_go(f, true, x0, z0, x1, z1, depth, most(margin, 0), f.depth, x0 - most(margin, 0), z0 - most(margin, 0)) }
  end
  doc "The floor with cells x0..x1, z0..z1 no deeper than [depth] voxels (and never above 1: water stays water), easing back over [margin] cells: a reef or a shoal."
  fn raise(f : Seafloor, x0 : Int, z0 : Int, x1 : Int, z1 : Int, depth : Int, margin : Int) : Seafloor do
    { f with depth: edit_go(f, false, x0, z0, x1, z1, most(depth, 1), most(margin, 0), f.depth, x0 - most(margin, 0), z0 - most(margin, 0)) }
  end
  doc "The floor with [edits] applied in order."
  fn apply(f : Seafloor, edits : List(Edit)) : Seafloor do
    match edits do
      Nil -> f
      Cons(Dig(x0, z0, x1, z1, d, m), rest) -> apply(dig(f, x0, z0, x1, z1, d, m), rest)
      Cons(Raise(x0, z0, x1, z1, d, m), rest) -> apply(raise(f, x0, z0, x1, z1, d, m), rest)
    end
  end

  -- ── Natural features ─────────────────────────────────────────────────────
  -- A floor with what each cell is made of: 0 open floor (sand or mud, which a
  -- storm may move), 1 reef (fixed), 2 sand bar (movable; for drawing and for
  -- what lives there). Reefs and bars only ever make the water shallower, and
  -- never touch land.
  type Features = { floor : Seafloor, kind : NativeIntArr }

  doc "Features over floor [f]: every cell open floor (kind 0)."
  fn features(f : Seafloor) : Features do { floor: f, kind: NativeArray.make_int(f.w * f.h, 0) } end

  doc "What cell (x, z) of [ft] is made of: 0 open floor, 1 reef, 2 sand bar; 0 off the floor."
  fn kind_at(ft : Features, x : Int, z : Int) : Int do
    if x < 0 || z < 0 || x >= ft.floor.w || z >= ft.floor.h do 0 else NativeArray.get_int(ft.kind, z * ft.floor.w + x) end
  end

  pfn band_go(depth : NativeIntArr, kind : NativeIntArr, dist : NativeIntArr, w : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int, near : Int, far : Int, top : Int, x : Int, z : Int) : (NativeIntArr, NativeIntArr) do
    if z > z1 do (depth, kind)
    else if x > x1 do band_go(depth, kind, dist, w, x0, z0, x1, z1, near, far, top, x0, z + 1)
    else
      let i = z * w + x
      let now = NativeArray.get_int(depth, i)
      let d = NativeArray.get_int(dist, i)
      if now >= 1 && d >= near * 3 && d <= far * 3 do
        band_go(NativeArray.set_int(depth, i, least(now, top)), NativeArray.set_int(kind, i, 1), dist, w, x0, z0, x1, z1, near, far, top, x + 1, z)
      else band_go(depth, kind, dist, w, x0, z0, x1, z1, near, far, top, x + 1, z) end
    end end
  end
  doc "A fringing reef: the water cells of rectangle x0..x1, z0..z1 that lie [near] to [far] cells from [land] (non-zero is land) become reef, no deeper than [top] voxels."
  fn reef_band(ft : Features, land : NativeIntArr, x0 : Int, z0 : Int, x1 : Int, z1 : Int, near : Int, far : Int, top : Int) : Features do
    let f = ft.floor
    let (depth, kind) = band_go(f.depth, ft.kind, coast_distance(land, f.w, f.h), f.w, most(x0, 0), most(z0, 0), least(x1, f.w - 1), least(z1, f.h - 1), near, far, most(top, 1), most(x0, 0), most(z0, 0))
    { floor: { f with depth: depth }, kind: kind }
  end

  pfn mound_go(depth : NativeIntArr, kind : NativeIntArr, w : Int, h : Int, cx : Int, cz : Int, r : Int, top : Int, x : Int, z : Int) : (NativeIntArr, NativeIntArr) do
    if z > cz + r do (depth, kind)
    else if x > cx + r do mound_go(depth, kind, w, h, cx, cz, r, top, cx - r, z + 1)
    else if x < 0 || z < 0 || x >= w || z >= h do mound_go(depth, kind, w, h, cx, cz, r, top, x + 1, z)
    else
      let i = z * w + x
      let now = NativeArray.get_int(depth, i)
      let d2 = (x - cx) * (x - cx) + (z - cz) * (z - cz)
      if now < 1 || d2 > r * r do mound_go(depth, kind, w, h, cx, cz, r, top, x + 1, z) else
        -- the top, easing back to the floor toward the rim
        let eased = top + (now - top) * d2 / (r * r + 1)
        if eased < now do mound_go(NativeArray.set_int(depth, i, most(eased, 1)), NativeArray.set_int(kind, i, 1), w, h, cx, cz, r, top, x + 1, z)
        else mound_go(depth, kind, w, h, cx, cz, r, top, x + 1, z) end
      end
    end end end
  end
  doc "A patch reef: a mound of reef [radius] cells round (cx, cz), its top [top] voxels down at the centre, easing back to the floor at its rim. Land and dry sand stay as they are."
  fn patch_reef(ft : Features, cx : Int, cz : Int, radius : Int, top : Int) : Features do
    let f = ft.floor
    let r = most(radius, 1)
    let (depth, kind) = mound_go(f.depth, ft.kind, f.w, f.h, cx, cz, r, most(top, 1), cx - r, cz - r)
    { floor: { f with depth: depth }, kind: kind }
  end

  -- how far (cells) (x, z) is from segment a-b, and how far along it (0..1) its nearest point lies
  pfn along(x : Int, z : Int, ax : Int, az : Int, bx : Int, bz : Int) : (Float, Float) do
    let dx = int_to_float(bx - ax)
    let dz = int_to_float(bz - az)
    let px = int_to_float(x - ax)
    let pz = int_to_float(z - az)
    let len2 = dx *. dx +. dz *. dz
    let t0 = if len2 <= 0.0 do 0.0 else (px *. dx +. pz *. dz) /. len2 end
    let t = if t0 < 0.0 do 0.0 else if t0 > 1.0 do 1.0 else t0 end end
    let ex = px -. t *. dx
    let ez = pz -. t *. dz
    (Math.sqrt(ex *. ex +. ez *. ez), t)
  end
  pfn bar_go(depth : NativeIntArr, kind : NativeIntArr, w : Int, h : Int, ax : Int, az : Int, bx : Int, bz : Int, width : Int, crest : Int, x0 : Int, x1 : Int, z1 : Int, x : Int, z : Int) : (NativeIntArr, NativeIntArr) do
    if z > z1 do (depth, kind)
    else if x > x1 do bar_go(depth, kind, w, h, ax, az, bx, bz, width, crest, x0, x1, z1, x0, z + 1)
    else if x < 0 || z < 0 || x >= w || z >= h do bar_go(depth, kind, w, h, ax, az, bx, bz, width, crest, x0, x1, z1, x + 1, z)
    else
      let i = z * w + x
      let now = NativeArray.get_int(depth, i)
      let (dist, t) = along(x, z, ax, az, bx, bz)
      let wf = int_to_float(width)
      -- sand does not pile on a reef
      if now < 1 || dist > wf || NativeArray.get_int(kind, i) == 1 do bar_go(depth, kind, w, h, ax, az, bx, bz, width, crest, x0, x1, z1, x + 1, z) else
        -- across: the crest easing to the floor over the width; along: the last quarter at each end tapers away
        let across = dist /. (wf +. 1.0)
        let end_t = if t < 0.5 do t else 1.0 -. t end
        let taper = if end_t >= 0.25 do 0.0 else 1.0 -. end_t /. 0.25 end
        let ease = if across > taper do across else taper end
        let eased = crest + float_to_int(int_to_float(now - crest) *. ease)
        if eased < now do
          bar_go(NativeArray.set_int(depth, i, eased), if now - eased > 2 do NativeArray.set_int(kind, i, 2) else kind end, w, h, ax, az, bx, bz, width, crest, x0, x1, z1, x + 1, z)
        else bar_go(depth, kind, w, h, ax, az, bx, bz, width, crest, x0, x1, z1, x + 1, z) end
      end
    end end end
  end
  doc "A sand bar: a ridge along the segment (ax, az)-(bx, bz) whose spine is [crest] voxels deep (-2..2: below 0 it pokes out as dry sand), easing back to the floor over [width] cells either side and tapering away over the last quarter of its length at each end. Cells it raised more than 2 voxels are sand bar (kind 2). Only ever shallower; land and reef stay as they are."
  fn bar(ft : Features, ax : Int, az : Int, bx : Int, bz : Int, width : Int, crest : Int) : Features do
    let f = ft.floor
    let wd = most(width, 1)
    let (depth, kind) = bar_go(f.depth, ft.kind, f.w, f.h, ax, az, bx, bz, wd, clampi(crest, -2, 2),
      least(ax, bx) - wd, most(ax, bx) + wd, most(az, bz) + wd, least(ax, bx) - wd, least(az, bz) - wd)
    { floor: { f with depth: depth }, kind: kind }
  end

  -- ── Generating features from a seed ──────────────────────────────────────
  pfn flood_label(land : NativeIntArr, labels : NativeIntArr, w : Int, h : Int, label : Int, stack : List(Int)) : NativeIntArr do
    match stack do
      Nil -> labels
      Cons(i, rest) ->
        if i < 0 || i >= w * h || NativeArray.get_int(land, i) == 0 || NativeArray.get_int(labels, i) != 0 do flood_label(land, labels, w, h, label, rest) else
          let x = i % w
          let more = Cons(if x > 0 do i - 1 else -1 end, Cons(if x < w - 1 do i + 1 else -1 end, Cons(i - w, Cons(i + w, rest))))
          flood_label(land, NativeArray.set_int(labels, i, label), w, h, label, more)
        end
    end
  end
  pfn label_go(land : NativeIntArr, labels : NativeIntArr, w : Int, h : Int, i : Int, next : Int) : NativeIntArr do
    if i >= w * h do labels
    else if NativeArray.get_int(land, i) != 0 && NativeArray.get_int(labels, i) == 0 do
      label_go(land, flood_label(land, labels, w, h, next, Cons(i, Nil)), w, h, i + 1, next + 1)
    else label_go(land, labels, w, h, i + 1, next) end end
  end
  doc "The islands of [land] (non-zero is land, x fastest, w x h): each cell's island, 1.. for 4-connected land, 0 for water."
  fn islands(land : NativeIntArr, w : Int, h : Int) : NativeIntArr do label_go(land, NativeArray.make_int(w * h, 0), w, h, 0, 1) end

  -- How a seed's features are placed: [reef_share] percent of islands get a fringing reef; up to [patch_max] patch reefs; [bar_min]..[bar_max] sand bars; the islands under any cell in [forced] always get a fringing reef.
  type FeatureRecipe = { reef_share : Int, patch_max : Int, bar_min : Int, bar_max : Int, forced : List((Int, Int)) }
  doc "About 40% of islands with a fringing reef, up to 3 patch reefs and 2 to 5 sand bars."
  fn default_recipe() : FeatureRecipe do { reef_share: 40, patch_max: 3, bar_min: 2, bar_max: 5, forced: Nil } end

  -- an island's extent: cells, and its bounding box
  type IslandBox = { label : Int, cells : Int, x0 : Int, z0 : Int, x1 : Int, z1 : Int }
  pfn boxes_go(labels : NativeIntArr, w : Int, i : Int, n : Int, cells : NativeIntArr, x0 : NativeIntArr, z0 : NativeIntArr, x1 : NativeIntArr, z1 : NativeIntArr) : (NativeIntArr, NativeIntArr, NativeIntArr, NativeIntArr, NativeIntArr) do
    if i >= n do (cells, x0, z0, x1, z1) else
      let l = NativeArray.get_int(labels, i)
      if l == 0 do boxes_go(labels, w, i + 1, n, cells, x0, z0, x1, z1) else
        let x = i % w
        let z = i / w
        boxes_go(labels, w, i + 1, n, NativeArray.set_int(cells, l, NativeArray.get_int(cells, l) + 1),
          NativeArray.set_int(x0, l, least(NativeArray.get_int(x0, l), x)), NativeArray.set_int(z0, l, least(NativeArray.get_int(z0, l), z)),
          NativeArray.set_int(x1, l, most(NativeArray.get_int(x1, l), x)), NativeArray.set_int(z1, l, most(NativeArray.get_int(z1, l), z)))
      end
    end
  end
  pfn max_label(labels : NativeIntArr, i : Int, best : Int) : Int do
    if i >= NativeArray.length_int(labels) do best else max_label(labels, i + 1, most(best, NativeArray.get_int(labels, i))) end
  end
  -- islands of at least 30 cells (a speck of rock is not an island), in label order
  pfn island_boxes(labels : NativeIntArr, w : Int, h : Int) : List(IslandBox) do
    let m = max_label(labels, 0, 0)
    let (cells, x0, z0, x1, z1) = boxes_go(labels, w, 0, w * h, NativeArray.make_int(m + 1, 0), NativeArray.make_int(m + 1, far()),
      NativeArray.make_int(m + 1, far()), NativeArray.make_int(m + 1, -1), NativeArray.make_int(m + 1, -1))
    List.filter(List.map(List.range(1, m + 1), fn l -> { label: l, cells: NativeArray.get_int(cells, l), x0: NativeArray.get_int(x0, l),
      z0: NativeArray.get_int(z0, l), x1: NativeArray.get_int(x1, l), z1: NativeArray.get_int(z1, l) }), fn b -> b.cells >= 30)
  end

  pfn roll(seed : Int, salt : Int) : Float do Strata.Seed.unit(Strata.Seed.mix(seed, salt)) end
  pfn pick(seed : Int, salt : Int, n : Int) : Int do clampi(float_to_int(roll(seed, salt) *. int_to_float(n)), 0, most(n - 1, 0)) end

  pfn forced_label(labels : NativeIntArr, w : Int, h : Int, forced : List((Int, Int)), label : Int) : Bool do
    match forced do
      Nil -> false
      Cons((x, z), rest) ->
        if x >= 0 && z >= 0 && x < w && z < h && NativeArray.get_int(labels, z * w + x) == label do true else forced_label(labels, w, h, rest, label) end
    end
  end

  -- one side (0 north, 1 east, 2 south, 3 west) of an island's coast, out to [reach] cells: the rectangle a fringing reef stretch is laid in
  pfn side_rect(b : IslandBox, side : Int, reach : Int) : (Int, Int, Int, Int) do
    let mx = (b.x0 + b.x1) / 2
    let mz = (b.z0 + b.z1) / 2
    match side do
      0 -> (b.x0 - reach, b.z0 - reach, b.x1 + reach, mz)
      1 -> (mx, b.z0 - reach, b.x1 + reach, b.z1 + reach)
      2 -> (b.x0 - reach, mz, b.x1 + reach, b.z1 + reach)
      _ -> (b.x0 - reach, b.z0 - reach, mx, b.z1 + reach)
    end
  end
  pfn fringe(ft : Features, dist : NativeIntArr, seed : Int, b : IslandBox, sides : Int, start : Int, k : Int) : Features do
    if k >= sides do ft else
      let side = (start + k) % 4
      let far_cells = 12 + pick(seed, 4100 + b.label * 8 + side, 9)
      let top = 4 + pick(seed, 4000 + b.label * 8 + side, 9)
      let (x0, z0, x1, z1) = side_rect(b, side, far_cells)
      let f = ft.floor
      let (depth, kind) = band_go(f.depth, ft.kind, dist, f.w, most(x0, 0), most(z0, 0), least(x1, f.w - 1), least(z1, f.h - 1), 6, far_cells, top, most(x0, 0), most(z0, 0))
      fringe({ floor: { f with depth: depth }, kind: kind }, dist, seed, b, sides, start, k + 1)
    end
  end
  pfn fringes(ft : Features, dist : NativeIntArr, labels : NativeIntArr, seed : Int, r : FeatureRecipe, isles : List(IslandBox)) : Features do
    match isles do
      Nil -> ft
      Cons(b, rest) ->
        let chosen = forced_label(labels, ft.floor.w, ft.floor.h, r.forced, b.label) || roll(seed, 1000 + b.label) *. 100.0 < int_to_float(r.reef_share)
        let ft = if chosen do fringe(ft, dist, seed, b, 1 + pick(seed, 2000 + b.label, 3), pick(seed, 3000 + b.label, 4), 0) else ft end
        fringes(ft, dist, labels, seed, r, rest)
    end
  end

  pfn patches(ft : Features, dist : NativeIntArr, bare : Option(IslandBox), seed : Int, n : Int, j : Int, k : Int) : Features do
    if j >= n do ft
    else if k >= 30 do patches(ft, dist, bare, seed, n, j + 1, 0)
    else
      let f = ft.floor
      let i = pick(seed, 6000 + j * 40 + k, f.w * f.h)
      let d = NativeArray.get_int(f.depth, i)
      if d >= 12 && d <= 60 && NativeArray.get_int(ft.kind, i) == 0 && NativeArray.get_int(dist, i) >= 24 && !near_bare(bare, i % f.w, i / f.w, 27) do
        patches(patch_reef(ft, i % f.w, i / f.w, 3 + pick(seed, 6500 + j, 4), 4 + pick(seed, 6600 + j, 9)), dist, bare, seed, n, j + 1, 0)
      else patches(ft, dist, bare, seed, n, j, k + 1) end
    end end
  end

  -- ── Where sand bars go ──
  -- A candidate: its centre, the direction its spine runs (unit), and its kind (1 bay mouth, 2 gentle shore, 3 channel).
  type BarSite = { x : Int, z : Int, dx : Float, dz : Float, kind : Int }
  pfn land_at(land : NativeIntArr, w : Int, h : Int, x : Int, z : Int) : Bool do
    if x < 0 || z < 0 || x >= w || z >= h do false else NativeArray.get_int(land, z * w + x) != 0 end
  end
  -- land within 12 cells of (x, z), sampled every other cell: (land samples, all samples, sum of their offsets x, z)
  pfn bay_go(land : NativeIntArr, w : Int, h : Int, x : Int, z : Int, u : Int, v : Int, hits : Int, all : Int, sx : Int, sz : Int) : (Int, Int, Int, Int) do
    if v > 12 do (hits, all, sx, sz)
    else if u > 12 do bay_go(land, w, h, x, z, -12, v + 2, hits, all, sx, sz)
    else if u * u + v * v > 144 do bay_go(land, w, h, x, z, u + 2, v, hits, all, sx, sz)
    else if land_at(land, w, h, x + u, z + v) do bay_go(land, w, h, x, z, u + 2, v, hits + 1, all + 1, sx + u, sz + v)
    else bay_go(land, w, h, x, z, u + 2, v, hits, all + 1, sx, sz) end end end end
  end
  -- the first island met walking from (x, z) along (ux, uz) for up to 12 cells, 0 for none
  pfn probe(labels : NativeIntArr, w : Int, h : Int, x : Int, z : Int, ux : Int, uz : Int, k : Int) : Int do
    if k > 12 do 0 else
      let px = x + ux * k
      let pz = z + uz * k
      if px < 0 || pz < 0 || px >= w || pz >= h do 0
      else if NativeArray.get_int(labels, pz * w + px) != 0 do NativeArray.get_int(labels, pz * w + px)
      else probe(labels, w, h, x, z, ux, uz, k + 1) end end
    end
  end
  pfn unit_dir(dx : Float, dz : Float) : (Float, Float) do
    let l = Math.sqrt(dx *. dx +. dz *. dz)
    if l <= 0.0 do (1.0, 0.0) else (dx /. l, dz /. l) end
  end
  pfn channel_dir(labels : NativeIntArr, w : Int, h : Int, x : Int, z : Int) : Option((Float, Float)) do
    let a = probe(labels, w, h, x, z, 1, 0, 1)
    let b = probe(labels, w, h, x, z, -1, 0, 1)
    let c = probe(labels, w, h, x, z, 0, 1, 1)
    let d = probe(labels, w, h, x, z, 0, -1, 1)
    if a > 0 && b > 0 && a != b do Some((1.0, 0.0))
    else if c > 0 && d > 0 && c != d do Some((0.0, 1.0)) else None end end
  end
  pfn site_at(f : Seafloor, land : NativeIntArr, labels : NativeIntArr, dist : NativeIntArr, x : Int, z : Int) : Option(BarSite) do
    let i = z * f.w + x
    let d = NativeArray.get_int(f.depth, i)
    let cd = NativeArray.get_int(dist, i)
    if d < 8 || d > 20 || cd >= far() do None else
      let (hits, all, sx, sz) = bay_go(land, f.w, f.h, x, z, -12, -12, 0, 0, 0, 0)
      if all > 0 && hits * 100 >= all * 45 do
        -- across the bay's mouth: square to the way the land lies
        let (ux, uz) = unit_dir(int_to_float(sx), int_to_float(sz))
        Some({ x: x, z: z, dx: 0.0 -. uz, dz: ux, kind: 1 })
      else
        match channel_dir(labels, f.w, f.h, x, z) do
          Some((ux, uz)) -> Some({ x: x, z: z, dx: ux, dz: uz, kind: 3 })
          None ->
            if cd >= 24 && cd <= 48 do
              -- along the shore: square to the way the distance from land grows
              let gx = int_to_float(NativeArray.get_int(dist, i + (if x < f.w - 1 do 1 else 0 end)) - NativeArray.get_int(dist, i - (if x > 0 do 1 else 0 end)))
              let gz = int_to_float(NativeArray.get_int(dist, i + (if z < f.h - 1 do f.w else 0 end)) - NativeArray.get_int(dist, i - (if z > 0 do f.w else 0 end)))
              let (ux, uz) = unit_dir(0.0 -. gz, gx)
              Some({ x: x, z: z, dx: ux, dz: uz, kind: 2 })
            else None end
        end
      end
    end
  end
  pfn sites_go(f : Seafloor, land : NativeIntArr, labels : NativeIntArr, dist : NativeIntArr, x : Int, z : Int, out : List(BarSite)) : List(BarSite) do
    if z >= f.h do out
    else if x >= f.w do sites_go(f, land, labels, dist, 2, z + 5, out)
    else match site_at(f, land, labels, dist, x, z) do
      Some(s) -> sites_go(f, land, labels, dist, x + 5, z, Cons(s, out))
      None -> sites_go(f, land, labels, dist, x + 5, z, out)
    end end end
  end
  pfn clear_of(placed : List(BarSite), x : Int, z : Int) : Bool do
    List.all(placed, fn p -> (p.x - x) * (p.x - x) + (p.z - z) * (p.z - z) >= 900)
  end
  -- choose up to [want] sites of [kind] from [sites] in seeded order, 30 cells apart from each other and from [placed]
  pfn pick_sites(sites : List(BarSite), kind : Int, seed : Int, want : Int, placed : List(BarSite), tries : Int) : List(BarSite) do
    let pool = List.filter(sites, fn s -> s.kind == kind)
    let n = List.length(pool)
    if n == 0 || tries >= 40 || List.length(placed) >= want do placed else
      let s = List.nth(pool, pick(seed, 7000 + kind * 100 + tries, n))
      pick_sites(sites, kind, seed, want, if clear_of(placed, s.x, s.z) do Cons(s, placed) else placed end, tries + 1)
    end
  end
  pfn lay_bars(ft : Features, seed : Int, placed : List(BarSite), j : Int) : Features do
    match placed do
      Nil -> ft
      Cons(s, rest) ->
        let half = int_to_float(if s.kind == 3 do 5 + pick(seed, 7600 + j, 4) else 6 + pick(seed, 7600 + j, 7) end)
        let ax = s.x + float_to_int(s.dx *. half)
        let az = s.z + float_to_int(s.dz *. half)
        let bx = s.x - float_to_int(s.dx *. half)
        let bz = s.z - float_to_int(s.dz *. half)
        lay_bars(bar(ft, ax, az, bx, bz, 2 + pick(seed, 7700 + j, 2), -2 + pick(seed, 7800 + j, 5)), seed, rest, j + 1)
    end
  end

  -- whether any reef or bar lies within 20 cells of island [b]'s box
  pfn featured_go(ft : Features, x0 : Int, z0 : Int, x1 : Int, z1 : Int, x : Int, z : Int) : Bool do
    if z > z1 do false
    else if x > x1 do featured_go(ft, x0, z0, x1, z1, x0, z + 1)
    else if kind_at(ft, x, z) != 0 do true
    else featured_go(ft, x0, z0, x1, z1, x + 1, z) end end end
  end
  pfn featured(ft : Features, b : IslandBox) : Bool do
    let x0 = most(b.x0 - 20, 0)
    let z0 = most(b.z0 - 20, 0)
    featured_go(ft, x0, z0, least(b.x1 + 20, ft.floor.w - 1), least(b.z1 + 20, ft.floor.h - 1), x0, z0)
  end
  pfn clear_go(ft : Features, base : Seafloor, x0 : Int, x1 : Int, z1 : Int, x : Int, z : Int) : Features do
    if z > z1 do ft
    else if x > x1 do clear_go(ft, base, x0, x1, z1, x0, z + 1)
    else
      let i = z * base.w + x
      let f = ft.floor
      clear_go({ floor: { f with depth: NativeArray.set_int(f.depth, i, NativeArray.get_int(base.depth, i)) }, kind: NativeArray.set_int(ft.kind, i, 0) }, base, x0, x1, z1, x + 1, z)
    end end
  end
  -- the island left bare: when there are two or more islands, the smallest that is not forced and got no fringing reef;
  -- if every island got one, the smallest that is not forced, its reef taken back
  pfn bare_island(ft : Features, base : Seafloor, labels : NativeIntArr, r : FeatureRecipe, isles : List(IslandBox)) : (Features, Option(IslandBox)) do
    let free = List.filter(isles, fn b -> !forced_label(labels, base.w, base.h, r.forced, b.label))
    if List.length(isles) < 2 || List.is_empty(free) do (ft, None) else
      let smallest = fn (bs : List(IslandBox)) -> List.fold_left(bs, List.head(bs), fn (a, b) -> if b.cells < a.cells do b else a end)
      let unreefed = List.filter(free, fn b -> !featured(ft, b))
      if !List.is_empty(unreefed) do (ft, Some(smallest(unreefed))) else
        let small = smallest(free)
        let x0 = most(small.x0 - 20, 0)
        (clear_go(ft, base, x0, least(small.x1 + 20, base.w - 1), least(small.z1 + 20, base.h - 1), x0, most(small.z0 - 20, 0)), Some(small))
      end
    end
  end
  -- whether (x, z) lies within [margin] cells of island [bare]'s box
  pfn near_bare(bare : Option(IslandBox), x : Int, z : Int, margin : Int) : Bool do
    match bare do
      None -> false
      Some(b) -> x >= b.x0 - margin && x <= b.x1 + margin && z >= b.z0 - margin && z <= b.z1 + margin
    end
  end

  doc "Natural features for floor [f] round [land] (non-zero is land), from [seed] as recipe [r] says: fringing reefs along stretches of some islands' coasts (6 cells out to 12..20, tops 4..12 voxels down), patch reefs on the open shelf in 12..60 voxels of water, and sand bars (crests -2..2) across bay mouths, along shores and in channels between islands, 30 cells apart. At least one island is left bare when there are two or more. With no land there are none. The same inputs always give the same features."
  fn generate(f : Seafloor, land : NativeIntArr, seed : Int, r : FeatureRecipe) : Features do
    let labels = islands(land, f.w, f.h)
    let isles = island_boxes(labels, f.w, f.h)
    if List.is_empty(isles) do features(f) else
      let dist = coast_distance(land, f.w, f.h)
      let (ft, bare) = bare_island(fringes(features(f), dist, labels, seed, r, isles), f, labels, r, isles)
      let ft = patches(ft, dist, bare, seed, pick(seed, 5000, r.patch_max + 1), 0, 0)
      let want = r.bar_min + pick(seed, 7500, r.bar_max - r.bar_min + 1)
      -- a bar reaches up to 15 cells from its centre: none starts within 36 of the bare island's box
      let sites = List.filter(sites_go(ft.floor, land, labels, dist, 2, 2, Nil), fn st -> !near_bare(bare, st.x, st.z, 36))
      lay_bars(ft, seed, pick_sites(sites, 3, seed, want, pick_sites(sites, 2, seed, want, pick_sites(sites, 1, seed, want, Nil, 0), 0), 0), 0)
    end
  end

  -- ── Reading it ───────────────────────────────────────────────────────────
  doc "The water's depth in voxels at cell (x, z): -2..-1 dry sand, 0 off the floor or on land."
  fn depth_at(f : Seafloor, x : Int, z : Int) : Int do
    if x < 0 || z < 0 || x >= f.w || z >= f.h do 0 else NativeArray.get_int(f.depth, z * f.w + x) end
  end
  pfn metres_go(f : Seafloor, voxel_m : Float, a : NativeF32Arr, i : Int) : NativeF32Arr do
    if i >= f.w * f.h do a else metres_go(f, voxel_m, NativeArray.set_f32(a, i, int_to_float(NativeArray.get_int(f.depth, i)) *. voxel_m), i + 1) end
  end
  doc "Every cell's depth in metres ([voxel_m] metres a voxel), x fastest: the depth grid Strata.Waves.solve takes."
  fn depths_m(f : Seafloor, voxel_m : Float) : NativeF32Arr do metres_go(f, voxel_m, NativeArray.make_f32(f.w * f.h, 0.0), 0) end
end
