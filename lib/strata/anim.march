-- Anim — what a game animates, as a value: rigs and clips uploaded once,
-- figures spawned from them, played, blended and placed, and every figure
-- posed by `update`. The pose arithmetic runs in C (native/strata_anim.h,
-- through Strata.Ffi.Anim); this module keeps what March needs beside it:
-- each finished rig, with its sockets and legs, by id.
--
-- Sockets and hit tests answer from the pose before springs, as of the last
-- update; a figure placed, played or changed since (or hanging from one) is
-- posed first, so an answer is never stale.
--
-- Cost control: `view` gives the camera. A figure out of view (not `always`)
-- still advances and fires its marks every update but is posed one update in
-- four; past the far distance it is posed every other update with its springs
-- frozen. A skipped figure is posed on demand before a socket or hit answers,
-- so the camera never changes a mark, a socket or a hit. The renderer draws
-- between each figure's last two poses, straight from C.
--
-- One world per process: `open` makes it (closing any open one), `close`
-- frees it. Time is the dt passed to `update`, never the clock: the same
-- calls with the same dt give the same `hash`.
--
-- A call C refuses (no such figure, a layer outside 0..7, a clip of another
-- rig, ...) changes nothing and is counted in `stats`.
--
-- A consumer lists native/strata_anim.c in its own [ffi] sources (GAPS S11).
-- `spawn` is a March keyword, so a figure is made with `spawn_at` (GAPS S22).
mod Strata.Anim do

  needs IO.Foreign
  needs Anim

  alias Strata.Math.Quat as Qt

  type Anim = { rigs : List((Int, Strata.Rig.Rig)), capacity : Int }

  -- (Strata.Query has a `Hit`: a type named in a record or a match must be unique across the library, GAPS S18/S19)
  -- A ray's answer: the figure and part struck, the voxel (x, y, z) in the part's grid (as `Strata.Rig.voxel`
  -- takes it), its palette index, the distance in metres and the struck face's normal in world space.
  type FigureHit = { fig : Int, part : Int, x : Int, y : Int, z : Int, colour : Int, dist : Float, normal : (Float, Float, Float) }

  doc "Open the figure world for up to [capacity] figures (1..4096), closing any open one."
  fn open(capacity : Int) : Anim do
    let ok = Strata.Ffi.Anim.open(capacity)
    { rigs: Nil, capacity: if ok do capacity else 0 end }
  end

  doc "Free the figure world. Rigs, clips and figures are gone; open again to start over."
  fn close(a : Anim) : Anim do
    Strata.Ffi.Anim.close()
    { a with rigs: Nil, capacity: 0 }
  end

  doc "How many figures the world was opened for; 0 when it could not be opened or is closed."
  fn capacity(a : Anim) : Int do a.capacity end

  doc "Upload rig [r]: its hierarchy, rest pose, masks, sockets, and every part's voxels (for hit tests); its meshes are `Strata.Rig.meshes`. Answers its id, or -1 if refused (the rig, or one of its masks, sockets or grids: a rig holds at most 32 sockets). The rig's sockets and legs stay here, read with `rig`."
  fn finish_rig(a : Anim, r : Strata.Rig.Rig) : (Anim, Int) do
    let id = Strata.Ffi.Anim.rig(Strata.Rig.part_count(r), Strata.Rig.parents(r), Strata.Rig.floats(r))
    if id < 0 do (a, id)
    else
      let made = Strata.Ffi.Anim.masks(id, Strata.Rig.mask_count(r), Strata.Rig.mask_counts(r), Strata.Rig.mask_roots(r))
      let shaped = shapes_go(id, r, 0, Strata.Rig.part_count(r), 0)
      let socketed = sockets_go(id, r, Strata.Rig.sockets(r), 0)
      let whole = made == Strata.Rig.mask_count(r) && shaped == Strata.Rig.part_count(r) && socketed == List.length(Strata.Rig.sockets(r))
      if whole do ({ a with rigs: Cons((id, r), a.rigs) }, id) else (a, -1) end
    end
  end

  -- every part's grid, for hit tests; how many were taken
  pfn shapes_go(id : Int, r : Strata.Rig.Rig, p : Int, n : Int, ok : Int) : Int do
    if p >= n do ok
    else
      match Strata.Rig.size(r, p) do
        (sx, sy, sz) ->
          let got = Strata.Ffi.Anim.shape(id, p, sx, sy, sz, Strata.Rig.voxel_size(r), Strata.Rig.grid(r, p))
          shapes_go(id, r, p + 1, n, if got >= 0 do ok + 1 else ok end)
      end
    end
  end
  -- every socket, in socket order: grid coordinates less the part's anchor, in metres; how many were taken
  pfn sockets_go(id : Int, r : Strata.Rig.Rig, ss : List((Int, Float, Float, Float, (Float, Float, Float, Float))), ok : Int) : Int do
    match ss do
      Nil -> ok
      Cons((p, x, y, z, (qx, qy, qz, qw)), rest) ->
        match Strata.Rig.anchor_at(r, p) do
          (ax, ay, az) ->
            let v = Strata.Rig.voxel_size(r)
            let got = Strata.Ffi.Anim.socket_def(id, p, (x -. ax) *. v, (y -. ay) *. v, (z -. az) *. v, qx, qy, qz, qw)
            sockets_go(id, r, rest, if got >= 0 do ok + 1 else ok end)
        end
    end
  end

  pfn rig_go(rs : List((Int, Strata.Rig.Rig)), id : Int) : Option(Strata.Rig.Rig) do
    match rs do
      Nil -> None
      Cons((i, r), rest) -> if i == id do Some(r) else rig_go(rest, id) end
    end
  end
  doc "The rig finished as [id], with its sockets and legs."
  fn rig(a : Anim, id : Int) : Option(Strata.Rig.Rig) do rig_go(a.rigs, id) end

  -- the id of a finished rig equal to r, newest first; -1 if none
  pfn id_of(rs : List((Int, Strata.Rig.Rig)), r : Strata.Rig.Rig) : Int do
    match rs do
      Nil -> -1
      Cons((i, x), rest) -> if Strata.Rig.same(x, r) do i else id_of(rest, r) end
    end
  end

  doc "The id rig [r] was finished as in this world (the newest, if finished twice), or -1."
  fn rig_id(a : Anim, r : Strata.Rig.Rig) : Int do id_of(a.rigs, r) end

  doc "Upload clip [c]. Its rig must have been finished in this world first. Answers its id, or -1 if refused."
  fn finish_clip(a : Anim, c : Strata.Clip.Clip) : (Anim, Int) do
    let rid = id_of(a.rigs, Strata.Clip.rig(c))
    let id = Strata.Ffi.Anim.clip(rid, Strata.Clip.duration(c), Strata.Clip.loops(c), Strata.Clip.stride_of(c), Strata.Clip.key_count(c), Strata.Clip.key_ints(c), Strata.Clip.key_floats(c), Strata.Clip.mark_count(c), Strata.Clip.mark_times(c), Strata.Clip.mark_tags(c))
    (a, id)
  end

  doc "A new figure of rig [rig] at (x, y, z) metres turned by [q], in its rest pose. Answers its id, or -1 if refused (no such rig, or the world full)."
  fn spawn_at(a : Anim, rig : Int, x : Float, y : Float, z : Float, q : Strata.Math.Quat.Quat) : (Anim, Int) do
    (a, Strata.Ffi.Anim.spawn_at(rig, x, y, z, Qt.x(q), Qt.y(q), Qt.z(q), Qt.w(q)))
  end

  doc "Remove figure [f]."
  fn remove(a : Anim, f : Int) : Anim do
    Strata.Ffi.Anim.remove(f)
    a
  end

  doc "Put figure [f] at (x, y, z) metres turned by [q]. It is posed there at the next update."
  fn place(a : Anim, f : Int, x : Float, y : Float, z : Float, q : Strata.Math.Quat.Quat) : Anim do
    Strata.Ffi.Anim.place(f, x, y, z, Qt.x(q), Qt.y(q), Qt.z(q), Qt.w(q))
    a
  end

  doc "Play clip [clip] on [layer] (0..7) of figure [f]: crossfading from what plays there over [fade] seconds, at [rate] (1 is as made), the layer's weight ramping to [weight]; [mask] is a mask number of the figure's rig (-1 for every part); additive layers add their turn on top of the layers below."
  fn play(a : Anim, f : Int, layer : Int, clip : Int, fade : Float, rate : Float, weight : Float, mask : Int, additive : Bool) : Anim do
    Strata.Ffi.Anim.play(f, layer, clip, fade, rate, weight, mask, additive)
    a
  end

  doc "Play a blend of up to four [clips] placed at increasing [positions] on [layer]: the two neighbours of [value] blend, kept in step by phase. Rate 1; set it with `set_rate`."
  fn blend(a : Anim, f : Int, layer : Int, clips : List(Int), positions : List(Float), value : Float, fade : Float, weight : Float, mask : Int) : Anim do
    let n = if List.length(clips) == List.length(positions) do List.length(clips) else 0 end
    Strata.Ffi.Anim.blend(f, layer, n, NativeArray.from_list_i32(clips), NativeArray.from_list_f32(positions), value, fade, weight, mask)
    a
  end

  doc "The rate of what plays newest on [layer] (1 is as made, negative plays backward). [fade] is not used."
  fn set_rate(a : Anim, f : Int, layer : Int, v : Float, fade : Float) : Anim do
    Strata.Ffi.Anim.set(f, layer, 0, v, fade)
    a
  end
  doc "The weight of [layer], 0..1, ramping there over [fade] seconds."
  fn set_weight(a : Anim, f : Int, layer : Int, v : Float, fade : Float) : Anim do
    Strata.Ffi.Anim.set(f, layer, 1, v, fade)
    a
  end
  doc "Jump what plays newest on [layer] to [v]: seconds into a clip, or a blend's phase 0..1. [fade] is not used."
  fn set_time(a : Anim, f : Int, layer : Int, v : Float, fade : Float) : Anim do
    Strata.Ffi.Anim.set(f, layer, 2, v, fade)
    a
  end
  doc "Move the blend on [layer] to [v], over [fade] seconds."
  fn set_value(a : Anim, f : Int, layer : Int, v : Float, fade : Float) : Anim do
    Strata.Ffi.Anim.set(f, layer, 3, v, fade)
    a
  end
  doc "Pause or resume what plays newest on [layer]."
  fn pause(a : Anim, f : Int, layer : Int, paused : Bool) : Anim do
    Strata.Ffi.Anim.set(f, layer, 4, if paused do 1.0 else 0.0 end, 0.0)
    a
  end

  -- ── The procedural stage ─────────────────────────────────────────────────
  -- After the layers, in this order: the drop, overrides, aim, reach, then
  -- springs. Each has a weight. Settings stay until changed or cleared.

  doc "Pull part [part]'s rotation (in its parent's frame) toward [q] and its move toward (x, y, z) metres by [weight] 0..1, over what the layers made. Weight 0 clears it."
  fn override(a : Anim, f : Int, part : Int, q : Strata.Math.Quat.Quat, x : Float, y : Float, z : Float, weight : Float) : Anim do
    Strata.Ffi.Anim.override(f, part, Qt.x(q), Qt.y(q), Qt.z(q), Qt.w(q), x, y, z, weight)
    a
  end

  doc "Aim slot [slot] (0..3): the last part of [chain] (up to four parts, each below the one before) turns its axis (ax, ay, az), in its own frame, toward the world point (tx, ty, tz). The turn is shared equally along the chain, each part turning at most [limit] degrees. Weight 0 clears it."
  fn aim(a : Anim, f : Int, slot : Int, chain : List(Int), ax : Float, ay : Float, az : Float, tx : Float, ty : Float, tz : Float, limit : Float, weight : Float) : Anim do
    Strata.Ffi.Anim.aim(f, slot, List.length(chain), NativeArray.from_list_i32(chain), ax, ay, az, tx, ty, tz, limit, weight)
    a
  end

  doc "Reach slot [slot] (0..7): two-bone IK. The chain [upper], [lower], [end_part] puts its end at the world point (tx, ty, tz), bending toward the pole (px, py, pz); out of reach it straightens toward the point. Weight 0 clears it."
  fn reach(a : Anim, f : Int, slot : Int, upper : Int, lower : Int, end_part : Int, tx : Float, ty : Float, tz : Float, px : Float, py : Float, pz : Float, weight : Float) : Anim do
    Strata.Ffi.Anim.reach(f, slot, upper, lower, end_part, tx, ty, tz, px, py, pz, weight, 0.0)
    a
  end

  doc "Make part [part] springy: its world rotation follows its animated one with lag and overshoot, [stiffness] and [damping] per second. Stiffness 0 clears it."
  fn spring(a : Anim, f : Int, part : Int, stiffness : Float, damping : Float) : Anim do
    Strata.Ffi.Anim.spring(f, part, stiffness, damping)
    a
  end

  doc "Lower figure [f]'s root by [metres] after the layers (what `ground` sets)."
  fn drop(a : Anim, f : Int, metres : Float) : Anim do
    Strata.Ffi.Anim.drop(f, metres)
    a
  end

  pfn origin_at(f : Int, part : Int, stage : Int) : Option((Float, Float, Float)) do
    let out = NativeArray.make_f32(3, 0.0)
    if Strata.Ffi.Anim.origin(f, part, stage, out) == 1 do Some((NativeArray.get_f32(out, 0), NativeArray.get_f32(out, 1), NativeArray.get_f32(out, 2))) else None end
  end
  doc "Part [part]'s origin in world space as last posed, before springs (with the drop, aim and reach); none if there is no such figure or part."
  fn origin(_a : Anim, f : Int, part : Int) : Option((Float, Float, Float)) do origin_at(f, part, 1) end
  doc "Part [part]'s origin as the layers and overrides alone put it: no drop, aim, reach or springs. What `ground` casts its rays from."
  fn animated_origin(_a : Anim, f : Int, part : Int) : Option((Float, Float, Float)) do origin_at(f, part, 0) end

  -- ── Foot placement ───────────────────────────────────────────────────────

  pfn ground_stop(reg : Strata.Blocks.Registry) : Int -> Bool do
    fn id -> id != 0 && Strata.Blocks.collides(reg, id) && Strata.Blocks.style_index(reg, id) != 1
  end

  -- one leg: a ray from 0.5 m above the foot to the leg's length below it; (target, the drop it asks for)
  pfn leg_target(r : Strata.Rig.Rig, leg : (Int, Int, Int, Float), foot : (Float, Float, Float), w : Strata.World.World) : (Option((Float, Float, Float)), Float) do
    match leg do
      (upper, _, end_part, sole) ->
        match foot do
          (fx, fy, fz) ->
            let reach = Strata.Rig.reach_length(r, upper, end_part)
            let h = Strata.Query.raycast(w, fx, fy +. 0.5, fz, 0.0, -1.0, 0.0, 0.5 +. reach, ground_stop(Strata.World.registry(w)))
            if Strata.Query.is_hit(h) do
              let ty = fy +. 0.5 -. Strata.Query.hit_dist(h) +. sole
              let d = fy -. ty
              (Some((fx, ty, fz)), if d > reach do reach else d end)
            else (None, 0.0) end
        end
    end
  end

  pfn targets_go(r : Strata.Rig.Rig, legs : List((Int, Int, Int, Float)), feet : List((Float, Float, Float)), w : Strata.World.World, acc : List(Option((Float, Float, Float))), drop : Float) : (List(Option((Float, Float, Float))), Float) do
    match legs do
      Nil -> (List.reverse(acc), drop)
      Cons(l, ls) ->
        match feet do
          Nil -> targets_go(r, ls, Nil, w, Cons(None, acc), drop)
          Cons(ft, fs) ->
            match leg_target(r, l, ft, w) do
              (t, d) -> targets_go(r, ls, fs, w, Cons(t, acc), if d > drop do d else drop end)
            end
        end
    end
  end

  doc "The pure part of `ground`. For each of [r]'s legs, in leg order, [feet] gives its foot's animated origin (metres); a ray goes straight down from 0.5 m above it to the leg's length below. Answers, per leg, the reach target where the sole meets the ground (the ground's top plus the sole), or none when the ray finds no ground (none within reach, or the chunk not loaded); and the drop: the largest (foot height - target) over the legs that found ground, each at most its leg's length, and never below 0. Ground is any block that collides, but not a cross."
  fn ground_targets(r : Strata.Rig.Rig, feet : List((Float, Float, Float)), w : Strata.World.World) : (List(Option((Float, Float, Float))), Float) do
    targets_go(r, Strata.Rig.legs(r), feet, w, Nil, 0.0)
  end

  pfn foot_of(f : Int, leg : (Int, Int, Int, Float)) : (Float, Float, Float) do
    match leg do (_, _, foot, _) -> unwrap_or(origin_at(f, foot, 0), (0.0, 0.0, 0.0)) end
  end

  -- each leg's reach slot (its place in leg order): at its target at once, or fading to the clip.
  -- A grounded leg is never faded in: with every grounded leg at full weight, a root that lags
  -- its drop leaves a foot short of the ground (above it), never below.
  pfn ground_go(f : Int, legs : List((Int, Int, Int, Float)), ts : List(Option((Float, Float, Float))), slot : Int, fwd : (Float, Float, Float), weight : Float) : Unit do
    match legs do
      Nil -> ()
      Cons((upper, lower, end_part, _), ls) ->
        match ts do
          Nil -> ()
          Cons(t, rest) ->
            match t do
              Some((tx, ty, tz)) ->
                match (unwrap_or(origin_at(f, lower, 0), (tx, ty, tz)), fwd) do
                  ((kx, ky, kz), (dx, dy, dz)) -> Strata.Ffi.Anim.reach(f, slot, upper, lower, end_part, tx, ty, tz, kx +. dx, ky +. dy, kz +. dz, weight, 0.0)
                end
              None -> Strata.Ffi.Anim.reach_fade(f, slot, 0.0, 0.15)
            end
            ground_go(f, ls, rest, slot + 1, fwd, weight)
        end
    end
  end

  -- the figure's facing: its placement turning +z
  pfn forward(f : Int) : (Float, Float, Float) do
    let q = NativeArray.make_f32(4, 0.0)
    if Strata.Ffi.Anim.facing(f, q) == 1 do
      let x = NativeArray.get_f32(q, 0)
      let y = NativeArray.get_f32(q, 1)
      let z = NativeArray.get_f32(q, 2)
      let w = NativeArray.get_f32(q, 3)
      (2.0 *. (x *. z +. w *. y), 2.0 *. (y *. z -. w *. x), 1.0 -. 2.0 *. (x *. x +. y *. y))
    else (0.0, 0.0, 1.0) end
  end

  doc "How fast `ground` moves a figure's drop, metres a second: a 0.25 m step in 0.125 s."
  fn drop_speed() : Float do 2.0 end

  doc "Foot placement for figure [f] over world [w], at [weight] 0..1: call it each frame before `update`. For each of the rig's legs (reach slots 0, 1, ... in leg order) it casts a ray down from 0.5 m above the foot's animated origin to the leg's length below; on ground the leg reaches for where the sole meets it, its knee bending toward a point 1 m ahead of the knee in the figure's facing (+z turned by its placement), and the root is lowered by the largest drop so that the longer leg reaches, moving toward it at `drop_speed` (so a step does not pop the root). A leg that finds ground reaches at once; a leg with no ground fades back to the clip over 0.15 s."
  fn ground(a : Anim, f : Int, w : Strata.World.World, weight : Float) : Anim do
    match rig(a, Strata.Ffi.Anim.fig_rig(f)) do
      None -> a
      Some(r) ->
        let legs = Strata.Rig.legs(r)
        let k = if weight < 0.0 do 0.0 else if weight > 1.0 do 1.0 else weight end end
        match ground_targets(r, List.map(legs, fn l -> foot_of(f, l)), w) do
          (ts, d) ->
            ground_go(f, legs, ts, 0, forward(f), k)
            Strata.Ffi.Anim.drop_to(f, d *. k, drop_speed())
            a
        end
    end
  end

  -- ── Attachments, sockets and hit tests ──────────────────────────────────

  doc "Hang figure [child] from figure [parent]'s socket [socket] (a socket number of the parent's rig), placed at (x, y, z) metres turned by [q] in the socket's frame. It is posed after its parent in every update, and moves with it. Chains go four deep; a cycle, a deeper chain, or no such figure or socket is refused (counted in `stats`). A figure already hanging moves to the new socket. A figure whose parent is removed is detached where it stands."
  fn attach(a : Anim, child : Int, parent : Int, socket : Int, x : Float, y : Float, z : Float, q : Strata.Math.Quat.Quat) : Anim do
    if Strata.Ffi.Anim.attach(child, parent, socket, x, y, z, Qt.x(q), Qt.y(q), Qt.z(q), Qt.w(q)) do a else a end
  end

  doc "Figure [child] no longer hangs; it is left at its parent's socket as the parent stands now."
  fn detach(a : Anim, child : Int) : Anim do
    Strata.Ffi.Anim.detach(child)
    a
  end

  doc "Socket [s] of figure [f] (a socket number of its rig) in world space: its position in metres and its rotation, from the pose before springs as of the last update (a figure changed since is posed first). None if there is no such figure or socket."
  fn socket(_a : Anim, f : Int, s : Int) : Option((Float, Float, Float, Strata.Math.Quat.Quat)) do
    let out = NativeArray.make_f32(7, 0.0)
    if Strata.Ffi.Anim.socket(f, s, out) == 1 do
      Some((NativeArray.get_f32(out, 0), NativeArray.get_f32(out, 1), NativeArray.get_f32(out, 2), Strata.Math.Quat.Quat(NativeArray.get_f32(out, 3), NativeArray.get_f32(out, 4), NativeArray.get_f32(out, 5), NativeArray.get_f32(out, 6))))
    else None end
  end

  pfn hit_of(ints : NativeI32Arr, fl : NativeF32Arr) : FigureHit do
    { fig: NativeArray.get_i32(ints, 0), part: NativeArray.get_i32(ints, 1), x: NativeArray.get_i32(ints, 2), y: NativeArray.get_i32(ints, 3), z: NativeArray.get_i32(ints, 4), colour: NativeArray.get_i32(ints, 5), dist: NativeArray.get_f32(fl, 0), normal: (NativeArray.get_f32(fl, 1), NativeArray.get_f32(fl, 2), NativeArray.get_f32(fl, 3)) }
  end
  doc "The nearest voxel of any figure along the ray from (ox, oy, oz) in direction (dx, dy, dz) (any length), within [max] metres: each part is tested as a box in its own space, then voxel by voxel through its grid. [ignore] skips that figure and every figure hanging from it (-1 for none). From the pose before springs. Combine with `Strata.Query.raycast` to learn whether the world came first."
  fn hit_ray(_a : Anim, ox : Float, oy : Float, oz : Float, dx : Float, dy : Float, dz : Float, max : Float, ignore : Int) : Option(FigureHit) do
    let ints = NativeArray.make_i32(6, 0)
    let fl = NativeArray.make_f32(4, 0.0)
    if Strata.Ffi.Anim.hit_ray(ox, oy, oz, dx, dy, dz, max, ignore, ints, fl) == 1 do Some(hit_of(ints, fl)) else None end
  end

  pfn pairs_go(out : NativeI32Arr, i : Int, acc : List((Int, Int))) : List((Int, Int)) do
    if i < 0 do acc else pairs_go(out, i - 1, Cons((NativeArray.get_i32(out, 2 * i), NativeArray.get_i32(out, 2 * i + 1)), acc)) end
  end
  doc "Every (figure, part) whose part box overlaps the box centred at (cx, cy, cz) with half sizes (hx, hy, hz) turned by [q]: part boxes, not voxels (a sword sweep needs no more). [ignore] skips that figure and what hangs from it (-1 for none). In figure order, then part order."
  fn hit_box(_a : Anim, cx : Float, cy : Float, cz : Float, hx : Float, hy : Float, hz : Float, q : Strata.Math.Quat.Quat, ignore : Int) : List((Int, Int)) do
    let out = NativeArray.make_i32(512, 0)
    let n = Strata.Ffi.Anim.hit_box(cx, cy, cz, hx, hy, hz, Qt.x(q), Qt.y(q), Qt.z(q), Qt.w(q), ignore, out)
    if n <= 256 do pairs_go(out, n - 1, Nil)
    else
      let all = NativeArray.make_i32(2 * n, 0)
      let m = Strata.Ffi.Anim.hit_box(cx, cy, cz, hx, hy, hz, Qt.x(q), Qt.y(q), Qt.z(q), Qt.w(q), ignore, all)
      pairs_go(all, (if m < n do m else n end) - 1, Nil)
    end
  end

  doc "The camera, used from the next update: [planes] holds 24 floats, six planes (a, b, c, d) with ax + by + cz + d >= 0 inside (fewer than 24 floats: no planes, every figure in view); the eye at (ex, ey, ez); [far] metres past which a figure is far (0 for none). A figure whose bounds lie more than 2 m outside a plane, and not `always`, is posed one update in four; a far one every other update with its springs frozen. Marks, sockets and hits are the same whatever the camera sees."
  fn view(a : Anim, planes : NativeF32Arr, ex : Float, ey : Float, ez : Float, far : Float) : Anim do
    Strata.Ffi.Anim.view(planes, ex, ey, ez, far)
    a
  end

  doc "Pose figure [f] every update when [yes], whatever the camera sees (its springs run even when far)."
  fn always(a : Anim, f : Int, yes : Bool) : Anim do
    Strata.Ffi.Anim.always(f, yes)
    a
  end

  doc "Mark figure [f] to be drawn traced (seen by the light pass) when [yes]. At most 64 figures are traced at once; past that a figure waits, drawn plain and counted in `stat` 9, until a traced one is let go."
  fn traced(a : Anim, f : Int, yes : Bool) : Anim do
    Strata.Ffi.Anim.traced(f, yes)
    a
  end

  doc "Advance every figure by [dt] seconds and pose those the camera needs (every figure when no `view` is set). A negative dt changes nothing and is counted."
  fn update(a : Anim, dt : Float) : Anim do
    Strata.Ffi.Anim.update(dt)
    a
  end

  pfn marks_go(i : Int, acc : List((Int, Int, Int, Float))) : List((Int, Int, Int, Float)) do
    if i < 0 do acc
    else marks_go(i - 1, Cons((Strata.Ffi.Anim.mark_int(i, 0), Strata.Ffi.Anim.mark_int(i, 1), Strata.Ffi.Anim.mark_int(i, 2), Strata.Ffi.Anim.mark_weight(i)), acc)) end
  end
  doc "The marks the last update crossed, in time order: (figure, layer, tag, weight). A mark on a layer at weight 0 is reported with weight 0."
  fn marks(_a : Anim) : List((Int, Int, Int, Float)) do marks_go(Strata.Ffi.Anim.mark_count() - 1, Nil) end

  doc "Figure [f]'s last pose: 12 floats a part, a column-major 3x4 matrix in world space (rotation columns, then the part's origin). A figure the last update skipped (out of view or far) answers the pose it was last given. Empty if there is no such figure."
  fn matrices(_a : Anim, f : Int) : NativeF32Arr do
    let out = NativeArray.make_f32(Strata.Size.of(12 * Strata.Ffi.Anim.parts(f)), 0.0)
    let copied = Strata.Ffi.Anim.matrices(f, out)
    if copied > 0 do out else NativeArray.make_f32(0, 0.0) end
  end

  doc "A hash of every live figure's pose: equal runs give equal hashes."
  fn hash(_a : Anim) : Int do Strata.Ffi.Anim.hash() end

  doc "(figures, posed by the last update, stale since it, refused calls)."
  fn stats(_a : Anim) : (Int, Int, Int, Int) do
    (float_to_int(Strata.Ffi.Anim.stat(0)), float_to_int(Strata.Ffi.Anim.stat(1)), float_to_int(Strata.Ffi.Anim.stat(2)), float_to_int(Strata.Ffi.Anim.stat(3)))
  end
  doc "A figure of the kernel's: 0 figures, 1 posed, 2 stale, 3 refused calls, 4 negative dt, 5 the last refusal's reason (AN_R_* in strata_anim.h), 6 marks dropped, 7 procedural records in use, 8 passes queries made over the figures to pose stale ones, 9 figures traced past the cap of 64, 10 parts left out of the last draw list, 11 figures the last update did not pose (out of view or far)."
  fn stat(_a : Anim, which : Int) : Float do Strata.Ffi.Anim.stat(which) end
end
