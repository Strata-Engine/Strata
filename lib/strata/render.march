-- Render — keeps the renderer in step with a stream.
--
-- A game's frame is: tick the stream, `sync` the renderer with it, set the
-- camera, draw. `sync` takes the stream's finished meshes and unloaded
-- chunks, lets Strata.Slots decide which slot each belongs in, and performs
-- the uploads and frees. A chunk is uploaded whole or not at all: one the
-- renderer has no room for is kept and tried again on the next sync, and
-- until it lands the chunk's previous mesh stays on screen, all of it.
mod Strata.Render do

  alias Strata.Slots as Sr2

  -- the slot table, and an empty mesh to stand in where one is required
  type Render = Render(Strata.Slots.Slots, Strata.Mesh.Meshed)

  pfn no_mesh() : Strata.Mesh.Meshed do
    Strata.Mesh.build(Strata.Blocks.empty(), Strata.Mesh.around_from(fn (dx, dy, dz) -> Strata.Chunk.uniform(0)))
  end

  doc "A renderer-side table of [capacity] chunk slots. The shim holds 16384."
  fn new(capacity : Int) : Render do Render(Sr2.new(capacity), no_mesh()) end

  doc "Chunk slots in use."
  fn used(r : Render) : Int do match r do Render(sl, _) -> Sr2.used(sl) end end
  doc "Meshes waiting for a slot or for room in the quad buffer."
  fn waiting(r : Render) : Int do match r do Render(sl, _) -> Sr2.waiting(sl) end end
  doc "The slot a chunk's mesh is in, or -1."
  fn slot_of(r : Render, k : Strata.Coord.Key) : Int do match r do Render(sl, _) -> Sr2.slot_of(sl, k) end end

  doc "How many blocks could not have a light class of their own and share the nearest of their kind: 0 unless the registry holds more than 255 blocks that differ in what they are to light. Such a block is lit and reflected with another block's texture, smoothness or glow."
  fn light_overflow(r : Strata.Blocks.Registry) : Int do Strata.Blocks.light_overflow(r) end

  doc "Give the renderer the registry's per-block data (textures, flags, emission). Call once the registry is built, and again if it changes."
  fn upload_blocks(r : Strata.Blocks.Registry) : Bool do
    Strata.Ffi.Vk.blocks_set(Strata.Blocks.gpu_table(r), Strata.Blocks.count(r)) && Strata.Ffi.Vk.light_table_set(Strata.Blocks.light_table(r), Strata.Blocks.light_class_count(r))
  end

  doc "The direction to the sun and its colour (linear; a noon sun is about 1.05, 1.0, 0.9). The sky, the fog and every shadow follow it."
  fn set_sun(dx : Float, dy : Float, dz : Float, r : Float, g : Float, b : Float) : Unit do Strata.Ffi.Vk.set_sun(dx, dy, dz, r, g, b) end

  doc "How the light pass shades: 4 everything (sun shadows, reflections, sky light), 3 without sky light, 2 shadows only, 1 sky and sun without rays, 0 the flat shading from before ray tracing. A renderer starts in mode 4."
  fn set_lighting(mode : Int) : Unit do Strata.Ffi.Vk.set_lighting(mode) end

  doc "The time in seconds that water's ripples run on. Call each frame; a paused game passes the same time and the water holds still."
  fn set_time(seconds : Float) : Unit do Strata.Ffi.Vk.set_time(seconds) end

  doc "Light quality. [sky_rays] is how many sky rays a pixel traces each time it samples, 0..8, default 2; 0 gives a flat sky term. [reflections] turns mirror rays off water and other smooth blocks on or off."
  fn set_quality(sky_rays : Int, reflections : Bool) : Unit do Strata.Ffi.Vk.set_quality(sky_rays, reflections) end

  doc "Size the lighting to a stream of these radii, in chunks. Call once, before the first `sync`: it empties the lighting's copy of the world, and chunks already uploaded stay unlit until they are meshed again. Without it the lighting covers three chunks. It assumes ONE focus point: with several focus points further apart than the stream's box, chunks that collide in the volume go without shadows."
  fn set_light_box(radius_h : Int, radius_v : Int) : Bool do Strata.Ffi.Vk.set_light_box(radius_h, radius_v) end

  pfn models_go(r : Strata.Blocks.Registry, m : Int, ok : Bool) : Bool do
    if m >= Strata.Blocks.model_count(r) do ok
    else
      let f = Strata.Blocks.model_quads(r, m)
      models_go(r, m + 1, Strata.Ffi.Vk.model_set(m, f, NativeArray.length_f32(f) / 21) && ok)
    end
  end

  doc "Give the renderer every model's drawing geometry. Call before the first chunks are uploaded."
  fn upload_models(r : Strata.Blocks.Registry) : Bool do models_go(r, 0, true) end

  -- Upload a chunk whole. Every part is given, empty ones too, so a part
  -- that lost its last quad is cleared; the renderer takes all of it or none.
  pfn upload(slot : Int, k : Strata.Coord.Key, m : Strata.Mesh.Meshed) : Bool do
    let b = Strata.Ffi.Vk.chunk_begin(slot, 32 * Strata.Coord.kx(k), 32 * Strata.Coord.ky(k), 32 * Strata.Coord.kz(k))
    let p0 = Strata.Ffi.Vk.chunk_part(0, Strata.Mesh.quads_at(m, 0), Strata.Mesh.quad_count_at(m, 0))
    let p1 = Strata.Ffi.Vk.chunk_part(1, Strata.Mesh.quads_at(m, 1), Strata.Mesh.quad_count_at(m, 1))
    let p2 = Strata.Ffi.Vk.chunk_part(2, Strata.Mesh.quads_at(m, 2), Strata.Mesh.quad_count_at(m, 2))
    let p3 = Strata.Ffi.Vk.chunk_part(3, Strata.Mesh.instances(m), Strata.Mesh.instance_count(m))
    let lb = Strata.Mesh.light_bytes(m)
    let pl = Strata.Ffi.Vk.chunk_light(lb, NativeArray.length_u8(lb))
    -- commit is called whatever came before, so a failed part cannot leave a half-built chunk staged
    let done = Strata.Ffi.Vk.chunk_commit()
    b && p0 && p1 && p2 && p3 && pl && done
  end

  pfn perform(sl : Strata.Slots.Slots, acts : List(Strata.Slots.Action), none : Strata.Mesh.Meshed) : Strata.Slots.Slots do
    match acts do
      Nil -> sl
      Cons(a, t) ->
        if !Sr2.is_upload(a) do
          Strata.Ffi.Vk.chunk_free(Sr2.slot(a))
          perform(sl, t, none)
        else perform(if upload(Sr2.slot(a), Sr2.key(a), Sr2.mesh_or(a, none)) do sl else Sr2.refused(sl, a) end, t, none) end
    end
  end

  doc "Bring the renderer up to date with the stream: upload its finished meshes, free its unloaded chunks, retry anything refused earlier."
  fn sync(r : Render, s : Strata.Stream.Stream) : (Render, Strata.Stream.Stream) do
    match Strata.Stream.take_meshes(s) do
      (s2, meshes) ->
        match Strata.Stream.take_unloads(s2) do
          (s3, gone) ->
            match r do
              Render(sl, none) ->
                match Sr2.plan(sl, meshes, gone) do
                  (sl2, acts) -> (Render(perform(sl2, acts, none), none), s3)
                end
            end
        end
    end
  end
end
