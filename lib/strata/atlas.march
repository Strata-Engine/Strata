-- Atlas — the one global, per-seed structure: a coarse grid in metres that
-- chunk generation reads and never writes.
--
-- The grid is n x n samples, `step` metres apart, centred on the origin:
-- sample (i, j) sits at x = (i - n / 2) * step, z = (j - n / 2) * step. Every
-- layer is a flat array indexed i + n * j. This module builds the island
-- (its mask, a warped fBm laid over a falloff from the centre) and the
-- regions (cellular noise quantised to region_count), and erodes the height
-- between the two (Strata.Erosion, uplift scaled by the mask, talus angle
-- from a rock-strength noise).
--
-- Erosion leaves almost no hollow, so up to lake_count bowls are carved on
-- rivers (Strata.Seed.cell(seed, 105, i, 0, j) ranks the candidates).
-- Then the water (Strata.Flood over the carved heights): a sample whose
-- spill height is more than lake_margin above it is lake, its water at
-- spill - lake_margin over an unchanged bed; any other sample is raised to
-- its spill (by at most lake_margin), so land never holds a pit and the
-- height never rises down a river. Drainage is step * step a sample summed
-- down the flood's receivers; land that is not lake with drainage over
-- river_min_area is river, 2 (area / river_min_area)^0.375 m wide. Sites are
-- dry, flat samples ranked by Strata.Seed.cell and taken while spaced.
--
-- Seeds: Strata.Seed.mix(seed, 101) the island's fBm, 102 the regions, 103
-- the rock strength; Strata.Seed.cell(seed, 104, i, 0, j) ranks the sites.
--
-- An atlas goes to bytes and back (to_bytes, from_bytes) and is kept on
-- disk by load_or_build, in a file cache_name names after the seed and Def.
mod Strata.Atlas do

  needs IO.Spawn      -- erosion splits rows across worker tasks
  needs IO.FileSystem -- load_or_build keeps a cache on disk

  alias Strata.Noise as Nz
  alias Strata.Seed as Sd3

  -- n, step (m), island radius (m), region size (m), region count, sea level (m), erosion,
  -- river_min_area (m^2), lake_margin (m), site_count, site_spacing (m), site_flat (m),
  -- lake_count, lake_radius (m), lake_depth (m)
  type Def = Def(Int, Float, Float, Float, Int, Float, Strata.Erosion.Params, Float, Float, Int, Float, Float, Int, Float, Float)

  -- A place for a structure: x (m), z (m), floor height (m), radius (m), region, index in take order
  type Site = Site(Float, Float, Float, Float, Int, Int)

  -- def, height, region, water, receiver, drainage, river width, sites, river polylines, carved lakes
  type Atlas = Atlas(Def, NativeF32Arr, NativeIntArr, NativeF32Arr, NativeIntArr, NativeF32Arr, NativeF32Arr, List(Site), List(List((Float, Float, Float))), List((Float, Float, Float)), Int)

  doc "A grid of n x n samples, step metres apart, centred on the origin: an island of the given radius, regions about region_size metres across (region_count ids), sea at sea metres, eroded with Strata.Erosion.default_params(); rivers from 2000 m^2 of drainage, 6 lakes carved 30 m in radius and 5 m deep, lakes 0.3 m below their spill, 8 sites 150 m apart on ground no rougher than 2 m over 3 x 3 samples."
  fn def(n : Int, step : Float, island_radius : Float, region_size : Float, region_count : Int, sea : Float) : Def do
    -- erosion routes lakes for grids up to 1448 samples a side (Strata.Erosion.route)
    Def(if n > 1448 do 1448 else n end, step, island_radius, region_size, region_count, sea, Strata.Erosion.default_params(), 2000.0, 0.3, 8, 150.0, 2.0, 6, 30.0, 5.0)
  end

  doc "The same Def eroded with p instead; p with 0 iterations leaves the island's height as the mask made it."
  fn with_erosion(d : Def, p : Strata.Erosion.Params) : Def do
    match d do Def(n, st, r, rz, rc, sea, _, ra, lm, sc, sp, sf, lc, lr, ld) -> Def(n, st, r, rz, rc, sea, p, ra, lm, sc, sp, sf, lc, lr, ld) end
  end

  doc "The same Def with rivers from river_min_area square metres of drainage, and lakes lake_margin metres below their spill height (a shallower hollow is filled)."
  fn with_rivers(d : Def, river_min_area : Float, lake_margin : Float) : Def do
    match d do Def(n, st, r, rz, rc, sea, p, _, _, sc, sp, sf, lc, lr, ld) -> Def(n, st, r, rz, rc, sea, p, river_min_area, lake_margin, sc, sp, sf, lc, lr, ld) end
  end

  doc "The same Def with up to site_count sites, each at least site_spacing metres from the others, on samples whose 3 x 3 neighbourhood spans at most site_flat metres of height."
  fn with_sites(d : Def, site_count : Int, site_spacing : Float, site_flat : Float) : Def do
    match d do Def(n, st, r, rz, rc, sea, p, ra, lm, _, _, _, lc, lr, ld) -> Def(n, st, r, rz, rc, sea, p, ra, lm, site_count, site_spacing, site_flat, lc, lr, ld) end
  end

  doc "The same Def with up to lake_count lakes carved before the flood: bowls lake_radius metres across and lake_depth metres deep at the centre, on river samples, at least 4 lake_radius from each other and from the grid's edge. 0 carves none."
  fn with_lakes(d : Def, lake_count : Int, lake_radius : Float, lake_depth : Float) : Def do
    match d do Def(n, st, r, rz, rc, sea, p, ra, lm, sc, sp, sf, _, _, _) -> Def(n, st, r, rz, rc, sea, p, ra, lm, sc, sp, sf, lake_count, lake_radius, lake_depth) end
  end

  fn d_n(d : Def) : Int do match d do Def(v, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> v end end
  fn d_step(d : Def) : Float do match d do Def(_, v, _, _, _, _, _, _, _, _, _, _, _, _, _) -> v end end
  fn d_radius(d : Def) : Float do match d do Def(_, _, v, _, _, _, _, _, _, _, _, _, _, _, _) -> v end end
  fn d_region_size(d : Def) : Float do match d do Def(_, _, _, v, _, _, _, _, _, _, _, _, _, _, _) -> v end end
  fn d_region_count(d : Def) : Int do match d do Def(_, _, _, _, v, _, _, _, _, _, _, _, _, _, _) -> v end end
  fn d_sea(d : Def) : Float do match d do Def(_, _, _, _, _, v, _, _, _, _, _, _, _, _, _) -> v end end
  fn d_erosion(d : Def) : Strata.Erosion.Params do match d do Def(_, _, _, _, _, _, v, _, _, _, _, _, _, _, _) -> v end end
  fn d_river_min_area(d : Def) : Float do match d do Def(_, _, _, _, _, _, _, v, _, _, _, _, _, _, _) -> v end end
  fn d_lake_margin(d : Def) : Float do match d do Def(_, _, _, _, _, _, _, _, v, _, _, _, _, _, _) -> v end end
  fn d_site_count(d : Def) : Int do match d do Def(_, _, _, _, _, _, _, _, _, v, _, _, _, _, _) -> v end end
  fn d_site_spacing(d : Def) : Float do match d do Def(_, _, _, _, _, _, _, _, _, _, v, _, _, _, _) -> v end end
  fn d_site_flat(d : Def) : Float do match d do Def(_, _, _, _, _, _, _, _, _, _, _, v, _, _, _) -> v end end
  fn d_lake_count(d : Def) : Int do match d do Def(_, _, _, _, _, _, _, _, _, _, _, _, v, _, _) -> v end end
  fn d_lake_radius(d : Def) : Float do match d do Def(_, _, _, _, _, _, _, _, _, _, _, _, _, v, _) -> v end end
  fn d_lake_depth(d : Def) : Float do match d do Def(_, _, _, _, _, _, _, _, _, _, _, _, _, _, v) -> v end end

  fn s_x(s : Site) : Float do match s do Site(v, _, _, _, _, _) -> v end end
  fn s_z(s : Site) : Float do match s do Site(_, v, _, _, _, _) -> v end end
  fn s_floor(s : Site) : Float do match s do Site(_, _, v, _, _, _) -> v end end
  fn s_radius(s : Site) : Float do match s do Site(_, _, _, v, _, _) -> v end end
  fn s_region(s : Site) : Int do match s do Site(_, _, _, _, v, _) -> v end end
  fn s_index(s : Site) : Int do match s do Site(_, _, _, _, _, v) -> v end end

  doc "The seed the atlas was built for."
  fn seed_of(a : Atlas) : Int do match a do Atlas(_, _, _, _, _, _, _, _, _, _, v) -> v end end
  fn def_of(a : Atlas) : Def do match a do Atlas(d, _, _, _, _, _, _, _, _, _, _) -> d end end
  pfn heights(a : Atlas) : NativeF32Arr do match a do Atlas(_, v, _, _, _, _, _, _, _, _, _) -> v end end
  pfn regions(a : Atlas) : NativeIntArr do match a do Atlas(_, _, v, _, _, _, _, _, _, _, _) -> v end end
  pfn waters(a : Atlas) : NativeF32Arr do match a do Atlas(_, _, _, v, _, _, _, _, _, _, _) -> v end end
  pfn receivers(a : Atlas) : NativeIntArr do match a do Atlas(_, _, _, _, v, _, _, _, _, _, _) -> v end end
  pfn drainages(a : Atlas) : NativeF32Arr do match a do Atlas(_, _, _, _, _, v, _, _, _, _, _) -> v end end
  pfn widths(a : Atlas) : NativeF32Arr do match a do Atlas(_, _, _, _, _, _, v, _, _, _, _) -> v end end

  doc "The structure sites, in the order they were taken."
  fn sites(a : Atlas) : List(Site) do match a do Atlas(_, _, _, _, _, _, _, v, _, _, _) -> v end end

  doc "The rivers as polylines of (x m, z m, width m), one from each river head down its receivers to the first sample that is not river: the sea, a lake (whose outlet starts its own), or the grid's edge. Downstream of a confluence polylines share their points."
  fn rivers(a : Atlas) : List(List((Float, Float, Float))) do match a do Atlas(_, _, _, _, _, _, _, _, v, _, _) -> v end end

  doc "The carved lakes, in the order they were taken: (x m, z m, water level m) at each centre; the level is -1 if the bowl held no water."
  fn lakes(a : Atlas) : List((Float, Float, Float)) do match a do Atlas(_, _, _, _, _, _, _, _, _, v, _) -> v end end

  fn n(a : Atlas) : Int do d_n(def_of(a)) end
  fn step(a : Atlas) : Float do d_step(def_of(a)) end
  pfn sea(a : Atlas) : Float do d_sea(def_of(a)) end

  pfn salt_mask() : Int do 101 end
  pfn salt_region() : Int do 102 end
  pfn salt_strength() : Int do 103 end
  pfn salt_site() : Int do 104 end
  pfn salt_lake() : Int do 105 end

  -- ── Building ─────────────────────────────────────────────────────────────
  pfn clamp(v : Float, lo : Float, hi : Float) : Float do if v < lo do lo else if v > hi do hi else v end end end

  -- Height from the warped fBm v in [-1, 1] at sample i: the mask
  -- m = lerp(e, 1 - d, 0.7), e = v mapped to [0, 1] and d the distance from the
  -- centre over the island radius. m is 0.25 at the shore (so the sea starts at
  -- the radius, whatever the noise: 0.3 e + 0.7 (1 - d) < 0.25 from d = 1.07 out),
  -- and the land rises 60 m a unit above it; the sea floor falls to sea - 20.
  -- ms gets the mask, clamped to [0, 1].
  pfn shape_go(hs : NativeF32Arr, ms : NativeF32Arr, d : Def, i : Int) : (NativeF32Arr, NativeF32Arr) do
    let n = d_n(d)
    if i >= n * n do (hs, ms)
    else
      let x = int_to_float(i % n - n / 2) *. d_step(d)
      let z = int_to_float(i / n - n / 2) *. d_step(d)
      let dist = Math.sqrt(x *. x +. z *. z) /. d_radius(d)
      let e = 0.5 +. 0.5 *. NativeArray.get_f32(hs, i)
      let m = e *. 0.3 +. (1.0 -. dist) *. 0.7
      shape_go(NativeArray.set_f32(hs, i, d_sea(d) +. clamp(60.0 *. (m -. 0.25), 0.0 -. 20.0, 60.0)), NativeArray.set_f32(ms, i, clamp(m, 0.0, 1.0)), d, i + 1)
    end
  end

  -- cell value in [-1, 1] to 0..count-1; the sea is -1
  pfn quantise_go(rs : NativeIntArr, cells : NativeF32Arr, hs : NativeF32Arr, d : Def, i : Int) : NativeIntArr do
    if i >= d_n(d) * d_n(d) do rs
    else
      let c = d_region_count(d)
      let q = float_to_int(Math.floor((NativeArray.get_f32(cells, i) +. 1.0) *. 0.5 *. int_to_float(c)))
      let r = if NativeArray.get_f32(hs, i) <= d_sea(d) do 0 - 1 else if q < 0 do 0 else if q > c - 1 do c - 1 else q end end end
      quantise_go(NativeArray.set_int(rs, i, r), cells, hs, d, i + 1)
    end
  end

  -- v in [-1, 1] to [0, 1]
  pfn unit_go(arr : NativeF32Arr, i : Int, cnt : Int) : NativeF32Arr do
    if i >= cnt do arr else unit_go(NativeArray.set_f32(arr, i, clamp(0.5 +. 0.5 *. NativeArray.get_f32(arr, i), 0.0, 1.0)), i + 1, cnt) end
  end

  pfn shift_go(arr : NativeF32Arr, by_m : Float, i : Int, cnt : Int) : NativeF32Arr do
    if i >= cnt do arr else shift_go(NativeArray.set_f32(arr, i, NativeArray.get_f32(arr, i) +. by_m), by_m, i + 1, cnt) end
  end

  pfn workers() : Int do
    let c = System.cpu_count()
    if c < 1 do 1 else if c > 8 do 8 else c end end
  end

  -- erosion works in metres above the sea; rock strength is 3-octave fBm at 4 / radius
  pfn erode(d : Def, seed : Int, hs : NativeF32Arr, ms : NativeF32Arr) : NativeF32Arr do
    let p = d_erosion(d)
    if Strata.Erosion.p_iterations(p) <= 0 do hs
    else
      let n = d_n(d)
      let cnt = n * n
      let x0 = int_to_float(0 - n / 2) *. d_step(d)
      let ss = NativeArray.make_f32(Strata.Size.of(cnt), 0.0)
      let k = Nz.field2(Nz.settings(0, 3, 2.0, 0.5, 1, 0.0), Sd3.mix(seed, salt_strength()), 4.0 /. d_radius(d), x0, x0, d_step(d), n, n, ss)
      let rel = shift_go(hs, 0.0 -. d_sea(d), 0, cnt)
      let out = Strata.Erosion.run(p, n, d_step(d), rel, ms, unit_go(ss, 0, cnt), workers())
      shift_go(out, d_sea(d), 0, cnt)
    end
  end


  -- ── Water ────────────────────────────────────────────────────────────────
  -- lakes and filled hollows: (heights, water levels) from the eroded
  -- heights h and the flood's spill
  pfn lake_go(h : NativeF32Arr, sp : NativeF32Arr, margin : Float, i : Int, cnt : Int, hs : NativeF32Arr, ws : NativeF32Arr) : (NativeF32Arr, NativeF32Arr) do
    if i >= cnt do (hs, ws)
    else
      let v = NativeArray.get_f32(h, i)
      let s = NativeArray.get_f32(sp, i)
      if s -. v > margin do lake_go(h, sp, margin, i + 1, cnt, NativeArray.set_f32(hs, i, v), NativeArray.set_f32(ws, i, s -. margin))
      else lake_go(h, sp, margin, i + 1, cnt, NativeArray.set_f32(hs, i, s), ws) end
    end
  end

  -- step * step a sample, summed down the receivers, last in order first
  pfn area_go(rcv : NativeIntArr, ord : NativeIntArr, t : Int, ar : NativeF32Arr) : NativeF32Arr do
    if t < 0 do ar
    else
      let i = NativeArray.get_int(ord, t)
      let r = NativeArray.get_int(rcv, i)
      area_go(rcv, ord, t - 1, if r >= 0 do NativeArray.set_f32(ar, r, NativeArray.get_f32(ar, r) +. NativeArray.get_f32(ar, i)) else ar end)
    end
  end

  -- river widths: 2 (area / min_area)^0.375 m on land that is not lake, past min_area
  pfn width_go(d : Def, hs : NativeF32Arr, ws : NativeF32Arr, ar : NativeF32Arr, i : Int, cnt : Int, out : NativeF32Arr) : NativeF32Arr do
    if i >= cnt do out
    else
      let area = NativeArray.get_f32(ar, i)
      let river = if NativeArray.get_f32(hs, i) <= d_sea(d) do false else if NativeArray.get_f32(ws, i) >= 0.0 do false else area > d_river_min_area(d) end end
      width_go(d, hs, ws, ar, i + 1, cnt, if river do NativeArray.set_f32(out, i, 2.0 *. Math.pow(area /. d_river_min_area(d), 0.375)) else out end)
    end
  end

  -- 1 for every sample a river flows into
  pfn fed_go(rcv : NativeIntArr, wd : NativeF32Arr, i : Int, cnt : Int, fed : NativeIntArr) : NativeIntArr do
    if i >= cnt do fed
    else
      let r = NativeArray.get_int(rcv, i)
      let into = if r < 0 do false else NativeArray.get_f32(wd, i) > 0.0 end
      fed_go(rcv, wd, i + 1, cnt, if into do NativeArray.set_int(fed, r, 1) else fed end)
    end
  end

  pfn x_of(d : Def, i : Int) : Float do int_to_float(i % d_n(d) - d_n(d) / 2) *. d_step(d) end
  pfn z_of(d : Def, i : Int) : Float do int_to_float(i / d_n(d) - d_n(d) / 2) *. d_step(d) end

  -- from river sample i down its receivers while they are river; the first
  -- that is not (sea or lake) closes the line at the last width
  pfn trace_go(d : Def, rcv : NativeIntArr, wd : NativeF32Arr, i : Int, left : Int, acc : List((Float, Float, Float))) : List((Float, Float, Float)) do
    let w = NativeArray.get_f32(wd, i)
    let here = Cons((x_of(d, i), z_of(d, i), w), acc)
    let r = NativeArray.get_int(rcv, i)
    if r < 0 do List.reverse(here)
    else if left <= 0 do List.reverse(here)
    else if NativeArray.get_f32(wd, r) > 0.0 do trace_go(d, rcv, wd, r, left - 1, here)
    else List.reverse(Cons((x_of(d, r), z_of(d, r), w), here)) end end end
  end

  -- a polyline from every river sample no river flows into, in index order
  pfn heads_go(d : Def, rcv : NativeIntArr, wd : NativeF32Arr, fed : NativeIntArr, i : Int, acc : List(List((Float, Float, Float)))) : List(List((Float, Float, Float))) do
    if i < 0 do acc
    else if NativeArray.get_f32(wd, i) <= 0.0 do heads_go(d, rcv, wd, fed, i - 1, acc)
    else if NativeArray.get_int(fed, i) == 1 do heads_go(d, rcv, wd, fed, i - 1, acc)
    else heads_go(d, rcv, wd, fed, i - 1, Cons(trace_go(d, rcv, wd, i, d_n(d) * d_n(d), Nil), acc)) end end end
  end

  -- ── Sites ────────────────────────────────────────────────────────────────
  -- the height range over the 3 x 3 samples around interior sample i
  pfn range_go(hs : NativeF32Arr, n : Int, i : Int, t : Int, lo : Float, hi : Float) : Float do
    if t >= 9 do hi -. lo
    else
      let v = NativeArray.get_f32(hs, i + (t % 3 - 1) + n * (t / 3 - 1))
      range_go(hs, n, i, t + 1, if v < lo do v else lo end, if v > hi do v else hi end)
    end
  end

  pfn candidate(d : Def, hs : NativeF32Arr, ws : NativeF32Arr, wd : NativeF32Arr, i : Int) : Bool do
    let n = d_n(d)
    let x = i % n
    let z = i / n
    if x < 1 || z < 1 || x > n - 2 || z > n - 2 do false
    else if NativeArray.get_f32(hs, i) <= d_sea(d) do false
    else if NativeArray.get_f32(ws, i) >= 0.0 do false
    else if NativeArray.get_f32(wd, i) > 0.0 do false
    else range_go(hs, n, i, 0, 1000000.0, 0.0 -. 1000000.0) <= d_site_flat(d) end end end end
  end

  -- every candidate as (rank, index), last index first
  pfn candidates_go(d : Def, seed : Int, hs : NativeF32Arr, ws : NativeF32Arr, wd : NativeF32Arr, i : Int, cnt : Int, acc : List((Int, Int))) : List((Int, Int)) do
    if i >= cnt do acc
    else if candidate(d, hs, ws, wd, i) do candidates_go(d, seed, hs, ws, wd, i + 1, cnt, Cons((Sd3.cell(seed, salt_site(), i % d_n(d), 0, i / d_n(d)), i), acc))
    else candidates_go(d, seed, hs, ws, wd, i + 1, cnt, acc) end end
  end

  pfn ranked_before(a : (Int, Int), b : (Int, Int)) : Bool do
    match a do
      (ra, ia) ->
        match b do
          (rb, ib) -> if ra != rb do ra < rb else ia < ib end
        end
    end
  end

  pfn dist(ax : Float, az : Float, bx : Float, bz : Float) : Float do
    let dx = ax -. bx
    let dz = az -. bz
    Math.sqrt(dx *. dx +. dz *. dz)
  end

  pfn clear(ss : List(Site), x : Float, z : Float, spacing : Float) : Bool do
    match ss do
      Nil -> true
      Cons(s, rest) -> if dist(s_x(s), s_z(s), x, z) < spacing do false else clear(rest, x, z, spacing) end
    end
  end

  -- candidates in rank order, each taken when spaced from those taken, until site_count
  pfn take_go(d : Def, hs : NativeF32Arr, rs : NativeIntArr, cs : List((Int, Int)), got : Int, acc : List(Site)) : List(Site) do
    if got >= d_site_count(d) do List.reverse(acc)
    else
      match cs do
        Nil -> List.reverse(acc)
        Cons((_, i), rest) ->
          let x = x_of(d, i)
          let z = z_of(d, i)
          if clear(acc, x, z, d_site_spacing(d)) do take_go(d, hs, rs, rest, got + 1, Cons(Site(x, z, NativeArray.get_f32(hs, i), 12.0, NativeArray.get_int(rs, i), got), acc))
          else take_go(d, hs, rs, rest, got, acc) end
      end
    end
  end

  -- ── Carved lakes ─────────────────────────────────────────────────────────
  -- Erosion leaves almost no hollow (the demo island's deepest is 0.18 m), so
  -- lakes are carved as bowls on rivers before the flood, which then fills
  -- each to its lowest rim.

  -- river samples (on the uncarved surface's own flood) with drainage below
  -- 50 river_min_area, a 3 x 3 range of at most 2 lake_depth, and room for a
  -- bowl that holds water (`holds`), as (rank, index)
  pfn lake_candidates_go(d : Def, seed : Int, hs : NativeF32Arr, ar : NativeF32Arr, i : Int, cnt : Int, acc : List((Int, Int))) : List((Int, Int)) do
    if i >= cnt do acc
    else
      let n = d_n(d)
      let x = i % n
      let z = i / n
      let area = NativeArray.get_f32(ar, i)
      let ok = if x < 1 || z < 1 || x > n - 2 || z > n - 2 do false
        else if NativeArray.get_f32(hs, i) <= d_sea(d) do false
        else if area <= d_river_min_area(d) do false
        else if area >= 50.0 *. d_river_min_area(d) do false
        else if range_go(hs, n, i, 0, 1000000.0, 0.0 -. 1000000.0) > 2.0 *. d_lake_depth(d) do false
        else holds(d, hs, i) end end end end end
      lake_candidates_go(d, seed, hs, ar, i + 1, cnt, if ok do Cons((Sd3.cell(seed, salt_lake(), x, 0, z), i), acc) else acc end)
    end
  end

  -- the lowest sample on the ring lake_radius to lake_radius + 1.5 step from
  -- centre c: wider than a diagonal step (step * sqrt 2), so no path between
  -- 8-neighbours leaves the bowl without stepping on it
  pfn ring_go(d : Def, hs : NativeF32Arr, c : Int, span : Int, t : Int, lo : Float) : Float do
    let side = 2 * span + 1
    if t >= side * side do lo
    else
      let n = d_n(d)
      let x = c % n + t % side - span
      let z = c / n + t / side - span
      if x < 0 || z < 0 || x >= n || z >= n do ring_go(d, hs, c, span, t + 1, lo)
      else
        let k = x + n * z
        let r = dist(x_of(d, c), z_of(d, c), x_of(d, k), z_of(d, k))
        let v = NativeArray.get_f32(hs, k)
        let rim = if r < d_lake_radius(d) do false else r < d_lake_radius(d) +. 1.5 *. d_step(d) end
        ring_go(d, hs, c, span, t + 1, if rim && v < lo do v else lo end)
      end
    end
  end

  -- a bowl carved at i holds water: its bottom (h - lake_depth) is at least
  -- 0.5 m above the sea and at least lake_depth / 2 under the lowest sample of
  -- the closed ring around it. The flood cannot leave the bowl below that
  -- sample, so the spill at the centre is at least bottom + lake_depth / 2
  -- and the water there at least lake_depth / 2 - lake_margin deep.
  pfn holds(d : Def, hs : NativeF32Arr, i : Int) : Bool do
    let bottom = NativeArray.get_f32(hs, i) -. d_lake_depth(d)
    if bottom < d_sea(d) +. 0.5 do false
    else
      let span = float_to_int(Math.ceil((d_lake_radius(d) +. 1.5 *. d_step(d)) /. d_step(d)))
      ring_go(d, hs, i, span, 0, 1000000.0) -. bottom >= 0.5 *. d_lake_depth(d)
    end
  end

  -- the distance in metres from sample i to the nearest edge of the grid
  pfn edge_room(d : Def, i : Int) : Float do
    let n = d_n(d)
    let x = i % n
    let z = i / n
    let a = if x < n - 1 - x do x else n - 1 - x end
    let b = if z < n - 1 - z do z else n - 1 - z end
    int_to_float(if a < b do a else b end) *. d_step(d)
  end

  pfn lake_clear(d : Def, cs : List(Int), i : Int) : Bool do
    match cs do
      Nil -> true
      Cons(c, rest) -> if dist(x_of(d, c), z_of(d, c), x_of(d, i), z_of(d, i)) < 4.0 *. d_lake_radius(d) do false else lake_clear(d, rest, i) end
    end
  end

  -- candidates in rank order, each taken when 4 lake_radius from the taken and the edge, until lake_count
  pfn lake_take_go(d : Def, cs : List((Int, Int)), got : Int, acc : List(Int)) : List(Int) do
    if got >= d_lake_count(d) do List.reverse(acc)
    else
      match cs do
        Nil -> List.reverse(acc)
        Cons((_, i), rest) ->
          let ok = if edge_room(d, i) < 4.0 *. d_lake_radius(d) do false else lake_clear(d, acc, i) end   -- not `&&`: GAPS S16
          if ok do lake_take_go(d, rest, got + 1, Cons(i, acc)) else lake_take_go(d, rest, got, acc) end
      end
    end
  end

  -- the centres of the lakes to carve, as sample indices in take order
  pfn lake_centres(d : Def, seed : Int, hs : NativeF32Arr) : List(Int) do
    if d_lake_count(d) <= 0 do Nil
    else
      let n = d_n(d)
      let cnt = n * n
      match Strata.Flood.fill(n, hs, d_sea(d)) do
        (_, rcv) ->
          let ar = area_go(rcv, Strata.Erosion.order(n, rcv), cnt - 1, NativeArray.make_f32(Strata.Size.of(cnt), d_step(d) *. d_step(d)))
          lake_take_go(d, List.sort_by(lake_candidates_go(d, seed, hs, ar, 0, cnt, Nil), fn (p, q) -> ranked_before(p, q)), 0, Nil)
      end
    end
  end

  -- lower the samples around centre c by lake_depth (1 - (r / lake_radius)^2), never below sea + 0.5
  pfn bowl_go(d : Def, hs : NativeF32Arr, c : Int, span : Int, t : Int) : NativeF32Arr do
    let side = 2 * span + 1
    if t >= side * side do hs
    else
      let n = d_n(d)
      let x = c % n + t % side - span
      let z = c / n + t / side - span
      let k = x + n * z
      let rr = dist(x_of(d, c), z_of(d, c), x_of(d, k), z_of(d, k)) /. d_lake_radius(d)
      if rr >= 1.0 do bowl_go(d, hs, c, span, t + 1)
      else
        let h = NativeArray.get_f32(hs, k)
        let low = h -. d_lake_depth(d) *. (1.0 -. rr *. rr)
        let floor = d_sea(d) +. 0.5
        let v = if low >= floor do low else if h < floor do h else floor end end
        bowl_go(d, NativeArray.set_f32(hs, k, v), c, span, t + 1)
      end
    end
  end

  pfn carve_go(d : Def, hs : NativeF32Arr, cs : List(Int)) : NativeF32Arr do
    match cs do
      Nil -> hs
      Cons(c, rest) -> carve_go(d, bowl_go(d, hs, c, float_to_int(Math.ceil(d_lake_radius(d) /. d_step(d))), 0), rest)
    end
  end

  pfn lake_list(d : Def, ws : NativeF32Arr, cs : List(Int)) : List((Float, Float, Float)) do
    List.map(cs, fn c -> (x_of(d, c), z_of(d, c), NativeArray.get_f32(ws, c)))
  end

  doc "Build the atlas for a seed: the island mask, erosion, the carved lakes, the flood (lakes, filled hollows, receivers), drainage and rivers, the regions, then the sites."
  fn build(d : Def, seed : Int) : Atlas do
    let n = d_n(d)
    let cnt = n * n
    let x0 = int_to_float(0 - n / 2) *. d_step(d)
    let r = d_radius(d)
    let hs = NativeArray.make_f32(Strata.Size.of(cnt), 0.0)
    let k = Nz.field2(Nz.settings(0, 4, 2.0, 0.5, 1, 0.3 *. r), Sd3.mix(seed, salt_mask()), 2.0 /. r, x0, x0, d_step(d), n, n, hs)
    let hs0 = match shape_go(hs, NativeArray.make_f32(Strata.Size.of(cnt), 0.0), d, 0) do (h1, ms) -> erode(d, seed, h1, ms) end
    let centres = lake_centres(d, seed, hs0)
    let hs1 = carve_go(d, hs0, centres)
    match Strata.Flood.fill(n, hs1, d_sea(d)) do
      (sp, rcv) ->
        match lake_go(hs1, sp, d_lake_margin(d), 0, cnt, NativeArray.make_f32(Strata.Size.of(cnt), 0.0), NativeArray.make_f32(Strata.Size.of(cnt), 0.0 -. 1.0)) do
          (hs2, ws) ->
            let ar = area_go(rcv, Strata.Erosion.order(n, rcv), cnt - 1, NativeArray.make_f32(Strata.Size.of(cnt), d_step(d) *. d_step(d)))
            let wd = width_go(d, hs2, ws, ar, 0, cnt, NativeArray.make_f32(Strata.Size.of(cnt), 0.0))
            let lines = heads_go(d, rcv, wd, fed_go(rcv, wd, 0, cnt, NativeArray.make_int(Strata.Size.of(cnt), 0)), cnt - 1, Nil)
            let cells = NativeArray.make_f32(Strata.Size.of(cnt), 0.0)
            let rz = d_region_size(d)
            let k2 = Nz.field2(Nz.settings(2, 1, 2.0, 0.5, 0, 0.25 *. rz), Sd3.mix(seed, salt_region()), 1.0 /. rz, x0, x0, d_step(d), n, n, cells)
            let rs = quantise_go(NativeArray.make_int(Strata.Size.of(cnt), 0), cells, hs2, d, 0)
            let ranked = List.sort_by(candidates_go(d, seed, hs2, ws, wd, 0, cnt, Nil), fn (p, q) -> ranked_before(p, q))
            Atlas(d, hs2, rs, ws, rcv, ar, wd, take_go(d, hs2, rs, ranked, 0, Nil), lines, lake_list(d, ws, centres), seed)
        end
    end
  end

  -- ── Sampling ─────────────────────────────────────────────────────────────
  doc "The height of sample (i, j), in metres."
  fn height_ij(a : Atlas, i : Int, j : Int) : Float do NativeArray.get_f32(heights(a), i + n(a) * j) end

  doc "The region of sample (i, j): 0..region_count-1 on land, -1 in the sea."
  fn region_ij(a : Atlas, i : Int, j : Int) : Int do NativeArray.get_int(regions(a), i + n(a) * j) end

  doc "The river width of sample (i, j) in metres, 0 off the rivers."
  fn river_width_ij(a : Atlas, i : Int, j : Int) : Float do NativeArray.get_f32(widths(a), i + n(a) * j) end

  doc "The lake level of sample (i, j) in metres, -1 where there is no lake."
  fn lake_ij(a : Atlas, i : Int, j : Int) : Float do NativeArray.get_f32(waters(a), i + n(a) * j) end

  doc "The sample that sample (i, j) drains into, as an index i + n * j over the filled surface; -1 for an outlet (the sea, or the grid's edge)."
  fn receiver_ij(a : Atlas, i : Int, j : Int) : Int do NativeArray.get_int(receivers(a), i + n(a) * j) end

  -- grid coordinate of a position: sample i is at gx = i
  pfn grid(a : Atlas, m : Float) : Float do m /. step(a) +. int_to_float(n(a) / 2) end

  -- layer [arr] at a position, bilinear between samples; [beyond] off the grid
  pfn bilinear(a : Atlas, arr : NativeF32Arr, xm : Float, zm : Float, beyond : Float) : Float do
    let gx = grid(a, xm)
    let gz = grid(a, zm)
    let top = int_to_float(n(a) - 1)
    if gx < 0.0 || gz < 0.0 || gx > top || gz > top do beyond
    else
      let fx = Math.floor(gx)
      let fz = Math.floor(gz)
      let i = float_to_int(fx)
      let j = float_to_int(fz)
      let i1 = if i + 1 > n(a) - 1 do i else i + 1 end
      let j1 = if j + 1 > n(a) - 1 do j else j + 1 end
      let tx = gx -. fx
      let tz = gz -. fz
      let a0 = NativeArray.get_f32(arr, i + n(a) * j) *. (1.0 -. tx) +. NativeArray.get_f32(arr, i1 + n(a) * j) *. tx
      let a1 = NativeArray.get_f32(arr, i + n(a) * j1) *. (1.0 -. tx) +. NativeArray.get_f32(arr, i1 + n(a) * j1) *. tx
      a0 *. (1.0 -. tz) +. a1 *. tz
    end
  end

  doc "The height at a position in metres, bilinear between samples; the sea level minus 20 m beyond the grid."
  fn height_at(a : Atlas, xm : Float, zm : Float) : Float do bilinear(a, heights(a), xm, zm, sea(a) -. 20.0) end

  pfn window_go(nn : Int, arr : NativeF32Arr, none : Float, i0 : Int, j0 : Int, side : Int, k : Int, out : NativeF32Arr) : NativeF32Arr do
    if k >= side * side do out
    else
      let i = i0 + k % side
      let j = j0 + k / side
      let v = if i < 0 || j < 0 || i >= nn || j >= nn do none else NativeArray.get_f32(arr, i + nn * j) end
      window_go(nn, arr, none, i0, j0, side, k + 1, NativeArray.set_f32(out, k, v))
    end
  end

  doc "A copy of one layer over the side x side samples from (i0, j0), row by row (index (i - i0) + side * (j - j0)): layer 0 the height, 2 the lake level, 4 the river width; a sample beyond the grid reads sea - 20, -1 and 0. For a generator that samples one area many times: the copy is its own, so worker tasks do not share it (GAPS S15)."
  fn window(a : Atlas, layer : Int, i0 : Int, j0 : Int, side : Int) : NativeF32Arr do
    let out = NativeArray.make_f32(Strata.Size.of(side * side), 0.0)
    if layer == 0 do window_go(n(a), heights(a), sea(a) -. 20.0, i0, j0, side, 0, out)
    else if layer == 2 do window_go(n(a), waters(a), 0.0 -. 1.0, i0, j0, side, 0, out)
    else window_go(n(a), widths(a), 0.0, i0, j0, side, 0, out) end end
  end

  -- the index of the sample nearest a position, or -1 beyond the grid
  pfn nearest(a : Atlas, xm : Float, zm : Float) : Int do
    let i = float_to_int(Math.floor(grid(a, xm) +. 0.5))
    let j = float_to_int(Math.floor(grid(a, zm) +. 0.5))
    if i < 0 || j < 0 || i >= n(a) || j >= n(a) do 0 - 1 else i + n(a) * j end
  end

  doc "The region at a position, taken from the nearest sample; -1 beyond the grid or in the sea."
  fn region_at(a : Atlas, xm : Float, zm : Float) : Int do
    let k = nearest(a, xm, zm)
    if k < 0 do 0 - 1 else NativeArray.get_int(regions(a), k) end
  end

  doc "The lake level at a position (nearest sample), or -1 where there is no lake."
  fn lake_at(a : Atlas, xm : Float, zm : Float) : Float do
    let k = nearest(a, xm, zm)
    if k < 0 do 0.0 -. 1.0 else NativeArray.get_f32(waters(a), k) end
  end

  doc "The river width in metres at a position, bilinear between samples (a sample off the rivers is 0), so it fades to 0 one step from a river; 0 beyond the grid."
  fn river_width_at(a : Atlas, xm : Float, zm : Float) : Float do bilinear(a, widths(a), xm, zm, 0.0) end

  doc "The drainage area in square metres at a position (nearest sample), 0 where unknown."
  fn drainage_at(a : Atlas, xm : Float, zm : Float) : Float do
    let k = nearest(a, xm, zm)
    if k < 0 do 0.0 else NativeArray.get_f32(drainages(a), k) end
  end

  pfn nearest_go(ss : List(Site), xm : Float, zm : Float, best : Option(Site), bd : Float) : Option(Site) do
    match ss do
      Nil -> best
      Cons(s, rest) ->
        let e = dist(s_x(s), s_z(s), xm, zm)
        if e < bd do nearest_go(rest, xm, zm, Some(s), e) else nearest_go(rest, xm, zm, best, bd) end
    end
  end

  doc "The site nearest (xm, zm) no more than `reach` metres away, or None; of two at the same distance, the one taken first."
  fn site_near(a : Atlas, xm : Float, zm : Float, reach : Float) : Option(Site) do
    nearest_go(sites(a), xm, zm, None, reach +. 0.000001)
  end

  -- ── Hash ─────────────────────────────────────────────────────────────────
  pfn prime() : Int do 1000000007 end
  pfn fold(h : Int, v : Int) : Int do ((h * 1000003 + v) % prime() + prime()) % prime() end
  pfn q(v : Float) : Int do float_to_int(Math.floor(v *. 256.0)) end

  pfn hash_f(arr : NativeF32Arr, i : Int, cnt : Int, h : Int) : Int do
    if i >= cnt do h else hash_f(arr, i + 1, cnt, fold(h, q(NativeArray.get_f32(arr, i)))) end
  end
  pfn hash_i(arr : NativeIntArr, i : Int, cnt : Int, h : Int) : Int do
    if i >= cnt do h else hash_i(arr, i + 1, cnt, fold(h, NativeArray.get_int(arr, i))) end
  end

  doc "A hash of the Def and of every array, in a fixed order."
  fn hash(a : Atlas) : Int do
    let d = def_of(a)
    let cnt = n(a) * n(a)
    let h0 = fold(fold(fold(fold(fold(fold(7, d_n(d)), q(d_step(d))), q(d_radius(d))), q(d_region_size(d))), d_region_count(d)), q(d_sea(d)))
    let p = d_erosion(d)
    let hp = fold(fold(fold(fold(fold(fold(fold(fold(h0, Strata.Erosion.p_iterations(p)), q(Strata.Erosion.p_dt(p))), q(Strata.Erosion.p_k(p) *. 1000000000.0)), q(Strata.Erosion.p_m(p))), q(Strata.Erosion.p_n_exp(p))), q(Strata.Erosion.p_uplift(p) *. 1000000.0)), q(Strata.Erosion.p_talus_lo(p))), q(Strata.Erosion.p_talus_hi(p)))
    let h1 = hash_f(heights(a), 0, cnt, hp)
    let h2 = hash_i(regions(a), 0, cnt, h1)
    let h3 = hash_f(waters(a), 0, cnt, h2)
    let h4 = hash_i(receivers(a), 0, cnt, h3)
    let h5 = hash_f(drainages(a), 0, cnt, h4)
    let h6 = hash_f(widths(a), 0, cnt, h5)
    let h7 = fold(fold(fold(fold(fold(h6, q(d_river_min_area(d))), q(d_lake_margin(d))), d_site_count(d)), q(d_site_spacing(d))), q(d_site_flat(d)))
    let h8 = fold(fold(fold(h7, d_lake_count(d)), q(d_lake_radius(d))), q(d_lake_depth(d)))
    hash_lakes(lakes(a), hash_sites(sites(a), h8))
  end

  pfn hash_lakes(ls : List((Float, Float, Float)), h : Int) : Int do
    match ls do
      Nil -> h
      Cons((x, z, w), rest) -> hash_lakes(rest, fold(fold(fold(h, q(x)), q(z)), q(w)))
    end
  end

  pfn hash_sites(ss : List(Site), h : Int) : Int do
    match ss do
      Nil -> h
      Cons(s, rest) -> hash_sites(rest, fold(fold(fold(fold(fold(fold(h, q(s_x(s))), q(s_z(s))), q(s_floor(s))), q(s_radius(s))), s_region(s)), s_index(s)))
    end
  end

  -- ── Bytes ────────────────────────────────────────────────────────────────
  -- An atlas as bytes, for a cache on disk, little-endian: a version byte;
  -- the Def in its field order (floats as binary64, counts as 32 bits); the
  -- seed (its low 32 bits, then its high 32); the six layers as held (binary32 floats, 32-bit ints); then the sites, the
  -- river polylines and the carved lakes, each list led by its length.
  -- March has no bit casts, so a float is taken apart into sign, exponent
  -- and mantissa by hand; every value comes back exactly.
  --
  -- version() names the layout AND what build makes: raise it whenever
  -- build's output for a Def could change, so a cache made by older code is
  -- never read. It is in the bytes, so in cache_name too. 2: the seed is
  -- written after the Def. test/atlas_test.march stores the hash of one
  -- atlas: when that test fails, build's arithmetic changed, and this must
  -- be raised.
  pfn version() : Int do 2 end

  ptype Wr = Wr(NativeU8Arr, Int)

  pfn w8(w : Wr, v : Int) : Wr do match w do Wr(b, p) -> Wr(NativeArray.set_u8(b, p, int_and(v, 255)), p + 1) end end
  pfn w32(w : Wr, v : Int) : Wr do w8(w8(w8(w8(w, v), int_shr(v, 8)), int_shr(v, 16)), int_shr(v, 24)) end

  pfn r32(b : NativeU8Arr, p : Int) : Int do
    NativeArray.get_u8(b, p) + int_shl(NativeArray.get_u8(b, p + 1), 8) + int_shl(NativeArray.get_u8(b, p + 2), 16) + int_shl(NativeArray.get_u8(b, p + 3), 24)
  end
  -- the same 32 bits as a signed number
  pfn r32s(b : NativeU8Arr, p : Int) : Int do
    let u = r32(b, p)
    if u >= 2147483648 do u - 4294967296 else u end
  end

  pfn pow2(e : Int) : Float do Math.pow(2.0, int_to_float(e)) end

  -- e with 2^e <= a < 2^(e + 1), for a > 0
  pfn exponent(a : Float) : Int do
    let e = float_to_int(Math.floor(Math.log(a) /. Math.log(2.0)))
    if a /. pow2(e) >= 2.0 do e + 1 else if a /. pow2(e) < 1.0 do e - 1 else e end end
  end

  -- the binary32 bits of v, which is exact in binary32 (it was read from a f32 array)
  pfn f32_bits(v : Float) : Int do
    if v == 0.0 do 0
    else
      let sign = if v < 0.0 do 2147483648 else 0 end
      let a = Math.abs(v)
      let e = exponent(a)
      if e < 0 - 126 do sign + float_to_int(Math.round(a /. pow2(0 - 149)))
      else sign + int_shl(e + 127, 23) + float_to_int(Math.round((a /. pow2(e) -. 1.0) *. 8388608.0)) end
    end
  end

  pfn f32_of(u : Int) : Float do
    let ex = int_and(int_shr(u, 23), 255)
    let m = int_and(u, 8388607)
    let a = if ex == 0 do int_to_float(m) *. pow2(0 - 149) else (1.0 +. int_to_float(m) /. 8388608.0) *. pow2(ex - 127) end
    if u >= 2147483648 do 0.0 -. a else a end
  end

  -- a binary64 as two 32-bit words: the mantissa's low 32 bits, then sign,
  -- 11 exponent bits and the mantissa's top 20 (a subnormal is written as 0)
  pfn wf(w : Wr, v : Float) : Wr do
    let a = Math.abs(v)
    if a < pow2(0 - 1022) do w32(w32(w, 0), 0)
    else
      let sign = if v < 0.0 do 2147483648 else 0 end
      let e = exponent(a)
      let m = float_to_int((a /. pow2(e) -. 1.0) *. 4503599627370496.0)
      w32(w32(w, int_and(m, 4294967295)), sign + int_shl(e + 1023, 20) + int_shr(m, 32))
    end
  end

  pfn rf(b : NativeU8Arr, p : Int) : Float do
    let hi = r32(b, p + 4)
    let ex = int_and(int_shr(hi, 20), 2047)
    if ex == 0 do 0.0
    else
      let m = int_shl(int_and(hi, 1048575), 32) + r32(b, p)
      let a = (1.0 +. int_to_float(m) /. 4503599627370496.0) *. pow2(ex - 1023)
      if hi >= 2147483648 do 0.0 -. a else a end
    end
  end

  -- the version byte and the Def: 157 bytes
  pfn def_size() : Int do 157 end

  pfn put_def(w0 : Wr, d : Def) : Wr do
    let p = d_erosion(d)
    let w1 = w32(wf(w32(wf(wf(wf(w32(w8(w0, version()), d_n(d)), d_step(d)), d_radius(d)), d_region_size(d)), d_region_count(d)), d_sea(d)), Strata.Erosion.p_iterations(p))
    let w2 = wf(wf(wf(wf(wf(wf(wf(w1, Strata.Erosion.p_dt(p)), Strata.Erosion.p_k(p)), Strata.Erosion.p_m(p)), Strata.Erosion.p_n_exp(p)), Strata.Erosion.p_uplift(p)), Strata.Erosion.p_talus_lo(p)), Strata.Erosion.p_talus_hi(p))
    let w3 = wf(wf(w32(wf(wf(w2, d_river_min_area(d)), d_lake_margin(d)), d_site_count(d)), d_site_spacing(d)), d_site_flat(d))
    wf(wf(w32(w3, d_lake_count(d)), d_lake_radius(d)), d_lake_depth(d))
  end

  pfn get_def(b : NativeU8Arr) : Def do
    let e = Strata.Erosion.params(r32s(b, 41), rf(b, 45), rf(b, 53), rf(b, 61), rf(b, 69), rf(b, 77), rf(b, 85), rf(b, 93))
    Def(r32s(b, 1), rf(b, 5), rf(b, 13), rf(b, 21), r32s(b, 29), rf(b, 33), e, rf(b, 101), rf(b, 109), r32s(b, 117), rf(b, 121), rf(b, 129), r32s(b, 137), rf(b, 141), rf(b, 149))
  end

  pfn put_fs(w : Wr, arr : NativeF32Arr, i : Int, cnt : Int) : Wr do
    if i >= cnt do w else put_fs(w32(w, f32_bits(NativeArray.get_f32(arr, i))), arr, i + 1, cnt) end
  end
  pfn put_is(w : Wr, arr : NativeIntArr, i : Int, cnt : Int) : Wr do
    if i >= cnt do w else put_is(w32(w, NativeArray.get_int(arr, i)), arr, i + 1, cnt) end
  end
  pfn get_fs(b : NativeU8Arr, p : Int, arr : NativeF32Arr, i : Int, cnt : Int) : NativeF32Arr do
    if i >= cnt do arr else get_fs(b, p, NativeArray.set_f32(arr, i, f32_of(r32(b, p + 4 * i))), i + 1, cnt) end
  end
  pfn get_is(b : NativeU8Arr, p : Int, arr : NativeIntArr, i : Int, cnt : Int) : NativeIntArr do
    if i >= cnt do arr else get_is(b, p, NativeArray.set_int(arr, i, r32s(b, p + 4 * i)), i + 1, cnt) end
  end

  pfn put_sites(w : Wr, ss : List(Site)) : Wr do
    match ss do
      Nil -> w
      Cons(s, rest) -> put_sites(w32(w32(wf(wf(wf(wf(w, s_x(s)), s_z(s)), s_floor(s)), s_radius(s)), s_region(s)), s_index(s)), rest)
    end
  end
  pfn put_points(w : Wr, ps : List((Float, Float, Float))) : Wr do
    match ps do
      Nil -> w
      Cons((x, z, v), rest) -> put_points(wf(wf(wf(w, x), z), v), rest)
    end
  end
  pfn put_rivers(w : Wr, rs : List(List((Float, Float, Float)))) : Wr do
    match rs do
      Nil -> w
      Cons(r, rest) -> put_rivers(put_points(w32(w, List.length(r)), r), rest)
    end
  end
  pfn points_size(rs : List(List((Float, Float, Float))), acc : Int) : Int do
    match rs do
      Nil -> acc
      Cons(r, rest) -> points_size(rest, acc + 4 + 24 * List.length(r))
    end
  end

  doc "The atlas as bytes, for from_bytes: a version byte, the Def, the seed, the layers, the sites, the rivers and the lakes."
  fn to_bytes(a : Atlas) : NativeU8Arr do
    let cnt = n(a) * n(a)
    let size = def_size() + 8 + 24 * cnt + 4 + 40 * List.length(sites(a)) + points_size(rivers(a), 4) + 4 + 24 * List.length(lakes(a))
    let w1 = w32(w32(put_def(Wr(NativeArray.make_u8(Strata.Size.of(size), 0), 0), def_of(a)), seed_of(a)), int_shr(seed_of(a), 32))
    let w2 = put_fs(put_is(put_fs(put_fs(put_is(put_fs(w1, heights(a), 0, cnt), regions(a), 0, cnt), waters(a), 0, cnt), drainages(a), 0, cnt), receivers(a), 0, cnt), widths(a), 0, cnt)
    let w3 = put_points(w32(put_rivers(w32(put_sites(w32(w2, List.length(sites(a))), sites(a)), List.length(rivers(a))), rivers(a)), List.length(lakes(a))), lakes(a))
    match w3 do Wr(b, _) -> b end
  end

  -- a list's length at p, if there is room for it and for [each] bytes an item after it
  pfn count_at(b : NativeU8Arr, p : Int, each : Int) : Option(Int) do
    let len = NativeArray.length_u8(b)
    if p + 4 > len do None
    else
      let c = r32s(b, p)
      if c < 0 do None else if p + 4 + c * each > len do None else Some(c) end end
    end
  end

  pfn get_sites(b : NativeU8Arr, p : Int, i : Int, c : Int, acc : List(Site)) : List(Site) do
    if i >= c do List.reverse(acc)
    else
      let q = p + 40 * i
      get_sites(b, p, i + 1, c, Cons(Site(rf(b, q), rf(b, q + 8), rf(b, q + 16), rf(b, q + 24), r32s(b, q + 32), r32s(b, q + 36)), acc))
    end
  end
  pfn get_points(b : NativeU8Arr, p : Int, i : Int, c : Int, acc : List((Float, Float, Float))) : List((Float, Float, Float)) do
    if i >= c do List.reverse(acc)
    else get_points(b, p, i + 1, c, Cons((rf(b, p + 24 * i), rf(b, p + 24 * i + 8), rf(b, p + 24 * i + 16)), acc)) end
  end
  -- [left] polylines from p: the polylines and the position after them, or None if the bytes end first
  pfn get_rivers(b : NativeU8Arr, p : Int, left : Int, acc : List(List((Float, Float, Float)))) : Option((List(List((Float, Float, Float))), Int)) do
    if left <= 0 do Some((List.reverse(acc), p))
    else
      match count_at(b, p, 24) do
        None -> None
        Some(c) -> get_rivers(b, p + 4 + 24 * c, left - 1, Cons(get_points(b, p + 4, 0, c, Nil), acc))
      end
    end
  end

  doc "The atlas to_bytes wrote, or None if the bytes are cut short, run long, or come from another version."
  fn from_bytes(b : NativeU8Arr) : Option(Atlas) do
    let len = NativeArray.length_u8(b)
    if len < def_size() + 8 do None
    else if NativeArray.get_u8(b, 0) != version() do None
    else
      let d = get_def(b)
      let seed = r32(b, def_size()) + int_shl(r32s(b, def_size() + 4), 32)
      let nn = d_n(d)
      let cnt = nn * nn
      let p0 = def_size() + 8
      if nn < 1 || nn > 8192 || p0 + 24 * cnt > len do None
      else
        let hs = get_fs(b, p0, NativeArray.make_f32(Strata.Size.of(cnt), 0.0), 0, cnt)
        let rs = get_is(b, p0 + 4 * cnt, NativeArray.make_int(Strata.Size.of(cnt), 0), 0, cnt)
        let ws = get_fs(b, p0 + 8 * cnt, NativeArray.make_f32(Strata.Size.of(cnt), 0.0), 0, cnt)
        let ar = get_fs(b, p0 + 12 * cnt, NativeArray.make_f32(Strata.Size.of(cnt), 0.0), 0, cnt)
        let rcv = get_is(b, p0 + 16 * cnt, NativeArray.make_int(Strata.Size.of(cnt), 0), 0, cnt)
        let wd = get_fs(b, p0 + 20 * cnt, NativeArray.make_f32(Strata.Size.of(cnt), 0.0), 0, cnt)
        let p1 = p0 + 24 * cnt
        match count_at(b, p1, 40) do
          None -> None
          Some(sc) ->
            let p2 = p1 + 4 + 40 * sc
            match count_at(b, p2, 4) do
              None -> None
              Some(rc) ->
                match get_rivers(b, p2 + 4, rc, Nil) do
                  None -> None
                  Some((lines, p3)) ->
                    match count_at(b, p3, 24) do
                      None -> None
                      Some(lc) ->
                        if p3 + 4 + 24 * lc != len do None
                        else Some(Atlas(d, hs, rs, ws, rcv, ar, wd, get_sites(b, p1 + 4, 0, sc, Nil), lines, get_points(b, p3 + 4, 0, lc, Nil), seed)) end
                    end
                end
            end
        end
      end
    end end
  end

  pfn fold_bytes(b : NativeU8Arr, i : Int, cnt : Int, h : Int) : Int do
    if i >= cnt do h else fold_bytes(b, i + 1, cnt, fold(h, NativeArray.get_u8(b, i))) end
  end

  -- the Def's exact bytes, version byte first
  pfn def_bytes(d : Def) : NativeU8Arr do match put_def(Wr(NativeArray.make_u8(Strata.Size.of(def_size()), 0), 0), d) do Wr(v, _) -> v end end

  pfn same_bytes(a : NativeU8Arr, b : NativeU8Arr, i : Int, cnt : Int) : Bool do
    if i >= cnt do true else if NativeArray.get_u8(a, i) != NativeArray.get_u8(b, i) do false else same_bytes(a, b, i + 1, cnt) end end
  end

  doc "Whether atlas a was built for Def d (byte for byte) and seed."
  fn built_for(a : Atlas, d : Def, seed : Int) : Bool do
    if seed_of(a) != seed do false else same_bytes(def_bytes(def_of(a)), def_bytes(d), 0, def_size()) end
  end

  doc "The file a cache keeps this seed's atlas in: atlas-<seed>-<a hash of the Def's exact bytes and the format version>.bin."
  fn cache_name(d : Def, seed : Int) : String do
    "atlas-" ++ int_to_string(seed) ++ "-" ++ int_to_string(fold_bytes(def_bytes(d), 0, def_size(), 7)) ++ ".bin"
  end

  doc "The atlas for (d, seed) from dir/cache_name(d, seed) if that file holds the atlas of that Def and seed, else built and written there (dir is made if missing; a failed write only loses the cache). A file holding another Def or seed (a name collision, or a file copied over) is rebuilt and rewritten."
  fn load_or_build(dir : String, d : Def, seed : Int) : Atlas do
    let path = dir ++ "/" ++ cache_name(d, seed)
    let read = match Authority.must(File.read(path)) do
      Ok(text) -> from_bytes(Bytes.to_u8_arr(Bytes.from_string(text)))
      Err(_) -> None
    end
    let cached = match read do
      Some(a) -> if built_for(a, d, seed) do Some(a) else None end
      None -> None
    end
    match cached do
      Some(a) -> a
      None ->
        let a = build(d, seed)
        let _made = Authority.must(Dir.mkdir_p(dir))
        let _wrote = Authority.must(File.write(path, Bytes.to_string(Bytes.from_u8_arr(to_bytes(a)))))
        a
    end
  end

  -- ── Images ───────────────────────────────────────────────────────────────
  pfn byte(v : Float) : String do char_from_int(float_to_int(clamp(v, 0.0, 1.0) *. 255.0)) end

  pfn grey3(v : Float, acc : List(String)) : List(String) do Cons(byte(v), Cons(byte(v), Cons(byte(v), acc))) end

  pfn max_f(arr : NativeF32Arr, i : Int, cnt : Int, best : Float) : Float do
    if i >= cnt do best
    else
      let v = NativeArray.get_f32(arr, i)
      max_f(arr, i + 1, cnt, if v > best do v else best end)
    end
  end

  -- a hue (distinct per id, by the golden ratio) as three bytes
  pfn hue3(id : Int, acc : List(String)) : List(String) do
    let t = int_to_float(id) *. 0.618034
    let h = t -. Math.floor(t)
    let r = clamp(Math.abs(h *. 6.0 -. 3.0) -. 1.0, 0.0, 1.0)
    let g = clamp(2.0 -. Math.abs(h *. 6.0 -. 2.0), 0.0, 1.0)
    let b = clamp(2.0 -. Math.abs(h *. 6.0 -. 4.0), 0.0, 1.0)
    Cons(byte(0.25 +. 0.75 *. b), Cons(byte(0.25 +. 0.75 *. g), Cons(byte(0.25 +. 0.75 *. r), acc)))
  end

  pfn black3(acc : List(String)) : List(String) do Cons(char_from_int(0), Cons(char_from_int(0), Cons(char_from_int(0), acc))) end

  -- the grey of v between lo and hi; black for a none value (v <= none)
  pfn scaled3(v : Float, none : Float, lo : Float, hi : Float, acc : List(String)) : List(String) do
    if v <= none do black3(acc) else grey3((v -. lo) /. (if hi -. lo < 0.000001 do 1.0 else hi -. lo end), acc) end
  end

  pfn region3(r : Int, acc : List(String)) : List(String) do if r < 0 do black3(acc) else hue3(r, acc) end end

  -- drainage on a log scale from one sample's area (base) to hi
  pfn log3(v : Float, base : Float, hi : Float, acc : List(String)) : List(String) do
    if v <= 0.0 do black3(acc)
    else
      let top = Math.log(hi /. base)
      grey3(if top < 0.000001 do 1.0 else Math.log(v /. base) /. top end, acc)
    end
  end

  pfn pixels_go(a : Atlas, layer : Int, hi : Float, i : Int, cnt : Int, acc : List(String)) : List(String) do
    if i >= cnt do List.reverse(acc)
    else
      let next = if layer == 0 do scaled3(NativeArray.get_f32(heights(a), i), 0.0 -. 1000000.0, sea(a) -. 20.0, hi, acc)
        else if layer == 1 do region3(NativeArray.get_int(regions(a), i), acc)
        else if layer == 2 do scaled3(NativeArray.get_f32(waters(a), i), 0.0 -. 1.0, sea(a) -. 20.0, hi, acc)
        else if layer == 3 do log3(NativeArray.get_f32(drainages(a), i), step(a) *. step(a), hi, acc)
        else scaled3(NativeArray.get_f32(widths(a), i), 0.0, 0.0, hi, acc) end end end end
      pixels_go(a, layer, hi, i + 1, cnt, next)
    end
  end

  doc "A layer as a P6 image, n x n bytes of RGB: 0 height (sea - 20 m to the highest sample), 1 region (a hue per id), 2 lake level (sea - 20 m to the highest), 3 drainage (log scale from one sample's area to the most), 4 river width (0 to the widest); grey, black for none."
  fn layer_ppm(a : Atlas, layer : Int) : String do
    let cnt = n(a) * n(a)
    let arr = if layer == 0 do heights(a) else if layer == 2 do waters(a) else if layer == 3 do drainages(a) else widths(a) end end end
    let hi = max_f(arr, 0, cnt, 0.0 -. 1000000.0)
    "P6\n" ++ int_to_string(n(a)) ++ " " ++ int_to_string(n(a)) ++ "\n255\n" ++ string_from_chars(pixels_go(a, layer, hi, 0, cnt, Nil))
  end
end
