-- Seed — derived seeds and per-cell streams from one world seed.
--
-- March integers are 63 bits and arithmetic traps on overflow, so the hash
-- works in 32-bit lanes (each multiply stays under 2^60) and joins two lanes
-- into a result of up to 62 bits. It is a PCG-style hash: multiply, then
-- xorshift, repeated. Pure and deterministic.
mod Strata.Seed do

  pfn low32(v : Int) : Int do int_and(v, 4294967295) end
  pfn high32(v : Int) : Int do int_and(int_shr(v, 32), 4294967295) end

  -- one 32-bit round: xorshift, multiply, xorshift, multiply, xorshift
  pfn h32(x0 : Int) : Int do
    let x1 = int_xor(x0, int_shr(x0, 16))
    let x2 = low32(x1 * 73244475)
    let x3 = int_xor(x2, int_shr(x2, 16))
    let x4 = low32(x3 * 73244475)
    int_xor(x4, int_shr(x4, 16))
  end

  doc "A derived seed from [seed] and [salt]: the same pair always gives the same value, any other pair a different one."
  fn mix(seed : Int, salt : Int) : Int do
    let a = h32(int_xor(low32(seed), h32(low32(salt + 2654435769))))
    let b = h32(int_xor(int_xor(high32(seed), h32(high32(salt) + 1013904223)), a + 1640531527))
    int_and(b, 1073741823) * 4294967296 + a
  end

  doc "The first value of the stream belonging to the cell (x, y, z), for [seed] and [salt]."
  fn cell(seed : Int, salt : Int, x : Int, y : Int, z : Int) : Int do
    let s = mix(seed, salt)
    let a0 = h32(int_xor(low32(s), h32(low32(x + 2246822519))))
    let a1 = h32(int_xor(a0, h32(low32(y + 3266489917))))
    let a2 = h32(int_xor(a1, h32(low32(z + 668265263))))
    let b = h32(int_xor(int_xor(high32(s), a2), 374761393))
    int_and(b, 1073741823) * 4294967296 + a2
  end

  doc "A float in [0, 1) from a hash value."
  fn unit(h : Int) : Float do int_to_float(int_and(int_shr(h, 8), 16777215)) /. 16777216.0 end

  doc "The next value of a stream: another well-spread hash of [h]."
  fn next(h : Int) : Int do mix(h, 1442695041) end
end
