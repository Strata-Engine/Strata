-- Noise — 2D value noise with fBm and ridged variants. Deterministic and
-- seedable. Copied from cube_forge's generic noise layer; terrain shaping
-- belongs to games, not here.
mod Strata.Noise do

  alias Strata.Ffi.Noise as Nf

  -- A noise recipe: kind (0 OpenSimplex2, 1 OpenSimplex2S, 2 cellular cell
  -- value, 3 cellular F2 - F1), octaves, lacunarity, gain, fractal (0 none,
  -- 1 fBm, 2 ridged) and the domain-warp amplitude in metres (0 for none).
  type Settings = Settings(Int, Int, Float, Float, Int, Float)

  doc "A noise recipe; see the module notes for the kind and fractal numbers."
  fn settings(kind : Int, octaves : Int, lacunarity : Float, gain : Float, fractal : Int, warp : Float) : Settings do
    Settings(kind, octaves, lacunarity, gain, fractal, warp)
  end

  fn kind(s : Settings) : Int do match s do Settings(k, _, _, _, _, _) -> k end end
  fn octaves(s : Settings) : Int do match s do Settings(_, o, _, _, _, _) -> o end end
  fn lacunarity(s : Settings) : Float do match s do Settings(_, _, l, _, _, _) -> l end end
  fn gain(s : Settings) : Float do match s do Settings(_, _, _, g, _, _) -> g end end
  fn fractal(s : Settings) : Int do match s do Settings(_, _, _, _, f, _) -> f end end
  fn warp(s : Settings) : Float do match s do Settings(_, _, _, _, _, w) -> w end end

  doc """
  Fill out[i + w * j] with noise at (x0 + i * step, z0 + j * step), metres;
  freq is cycles per metre. Returns w * d, or 0 (writing nothing) when out is
  too small. Range [-1, 1], or [0, 1] for ridged.
  """
  fn field2(s : Settings, seed : Int, freq : Float, x0 : Float, z0 : Float, step : Float, w : Int, d : Int, out : NativeF32Arr) : Int do
    Nf.field2(kind(s), octaves(s), lacunarity(s), gain(s), fractal(s), warp(s), seed, freq, x0, z0, step, w, d, out)
  end

  doc "Fill out[i + w * (j + h * k)] with 3D noise; returns w * h * d, or 0 when out is too small."
  fn field3(s : Settings, seed : Int, freq : Float, x0 : Float, y0 : Float, z0 : Float, sx : Float, sy : Float, sz : Float, w : Int, h : Int, d : Int, out : NativeF32Arr) : Int do
    Nf.field3(kind(s), octaves(s), lacunarity(s), gain(s), fractal(s), warp(s), seed, freq, x0, y0, z0, sx, sy, sz, w, h, d, out)
  end

  doc "One 2D sample, for tests and sparse use."
  fn sample2(s : Settings, seed : Int, freq : Float, x : Float, z : Float) : Float do
    Nf.sample2(kind(s), octaves(s), lacunarity(s), gain(s), fractal(s), warp(s), seed, freq, x, z)
  end

  doc "One 3D sample, for tests and sparse use."
  fn sample3(s : Settings, seed : Int, freq : Float, x : Float, y : Float, z : Float) : Float do
    Nf.sample3(kind(s), octaves(s), lacunarity(s), gain(s), fractal(s), warp(s), seed, freq, x, y, z)
  end

  pfn base_seed(seed : Int) : Int do int_and(seed, 4294967295) end


  -- Integer hash of a lattice point to [0, 1). Deterministic, seedable. Only the
  -- low 32 bits of the seed are used.
  fn hash2(ix : Int, iz : Int, seed : Int) : Float do
    let h0 = int_xor(ix * 374761393 + iz * 668265263 + base_seed(seed) * 1274126177, 0)
    let h1 = int_and(h0, 2147483647)
    let h2 = int_xor(h1, h1 / 8192)
    let h3 = int_and(h2 * 1103515245 + 12345, 2147483647)
    let h4 = int_xor(h3, h3 / 65536)
    int_to_float(int_and(h4, 65535)) /. 65536.0
  end

  fn smooth(t : Float) : Float do t *. t *. (3.0 -. 2.0 *. t) end

  fn lerp(a : Float, b : Float, t : Float) : Float do a +. (b -. a) *. t end

  doc "Value noise at (x, z), in [0, 1)."
  fn value2(x : Float, z : Float, seed : Int) : Float do
    let fx = Math.floor(x)
    let fz = Math.floor(z)
    let ix = float_to_int(fx)
    let iz = float_to_int(fz)
    let tx = smooth(x -. fx)
    let tz = smooth(z -. fz)
    let a = hash2(ix, iz, seed)
    let b = hash2(ix + 1, iz, seed)
    let c = hash2(ix, iz + 1, seed)
    let d = hash2(ix + 1, iz + 1, seed)
    lerp(lerp(a, b, tx), lerp(c, d, tx), tz)
  end

  doc "3-octave fBm in [0, 1)."
  fn fbm(x : Float, z : Float, seed : Int) : Float do
    let n0 = value2(x, z, seed)
    let n1 = value2(x *. 2.0 +. 17.3, z *. 2.0 +. 9.1, seed + 1)
    let n2 = value2(x *. 4.0 +. 31.7, z *. 4.0 +. 3.3, seed + 2)
    (n0 *. 0.6 +. n1 *. 0.3 +. n2 *. 0.1)
  end

  doc "Ridged noise in [0, 1]: 1 - |2n - 1|, so peaks form creases rather than blobs."
  fn ridged(x : Float, z : Float, seed : Int) : Float do
    1.0 -. Math.abs(2.0 *. value2(x, z, seed) -. 1.0)
  end

  doc """
  3-octave ridged noise in [0, 1]. Each octave is gated by the ones below it, so
  valley floors (a low first octave) stay smooth and only the ridges carry the
  fine creases -- rock that has been rained on, rather than noise everywhere.
  """
  fn ridged_fbm(x : Float, z : Float, seed : Int) : Float do
    let r0 = ridged(x, z, seed)
    let r1 = ridged(x *. 2.0 +. 11.7, z *. 2.0 +. 5.3, seed + 3)
    let r2 = ridged(x *. 4.0 +. 23.1, z *. 4.0 +. 41.9, seed + 4)
    r0 *. (0.45 +. 0.33 *. r1 +. 0.22 *. r1 *. r2)
  end

  fn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end
end
