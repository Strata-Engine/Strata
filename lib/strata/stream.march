-- Stream — which chunks are loaded, and the workers that generate and mesh
-- them off the caller's thread.
--
-- The wanted set is the union, over the focus points, of a box of chunks
-- around each: `radius_h` out in x and z, `radius_v` in y. A chunk is
-- unloaded once it is more than one chunk beyond every box, so a focus
-- pacing across a chunk boundary does not thrash.
--
-- Generation and meshing run as tasks on the scheduler's other threads. A
-- task carries everything it needs (the generator, or the registry and a
-- snapshot of the 27 chunks), so it shares no state with the caller.
--
-- `tick` collects the tasks started TWO ticks ago, applies up to
-- `apply_budget` generated chunks, and starts the next batch: up to
-- `workers` generation keys (nearest to a focus first; with `with_batch`,
-- the keys of one chunk column among them go into one task, so a generator
-- with a column function does the column's shared work once) and up to `workers`
-- mesh tasks, for loaded chunks that need a mesh and have all 26 neighbours
-- loaded. Work therefore has two whole frames to finish before it is asked
-- for; `tick` waits only for a task still running two frames after it was
-- started. (One frame was not enough: a hard chunk takes 14 ms or more to
-- mesh, and the wait showed as dropped frames.) With `with_poll` it does not
-- wait at all: work not finished two ticks on (Task.poll) is kept for a later
-- tick and counts against that tick's workers.
--
-- A mesh is requested with a stamp; a result whose stamp is no longer the
-- chunk's current one (the chunk was edited or unloaded meanwhile) is
-- dropped and asked for again.
--
-- Levels (Part F of the renderer design): with `config_levels`, each level
-- 1..levels (no higher than the generator declares) keeps a box of its own
-- chunks, `far_h` out in x and z and `far_v` in y, around the level-L chunk
-- holding each focus, loaded and unloaded as level 0's is (its neighbours
-- are its own level's). A level's box is its inside, the chunks it can
-- mesh, and one chunk round it. Each level's inside also holds the parents
-- of the inside below it, and every level's but the top's is snapped out to
-- whole chunks of the level above (the unload band is grown before it is
-- snapped), so the renderer's which-chunk-draws rule (Strata.Slots) can hide
-- each coarse chunk over a finer inside and has clean edges. Each level
-- loads its whole box, also under the finer levels, but a coarse chunk
-- whose eight children are all loaded and can all be meshed is not meshed:
-- the children draw that region. When one of them, or a neighbour one
-- needs, unloads, the chunks above are looked at again and meshed.
-- A level-0 edit makes its ancestors stale
-- (Strata.World): `apply` and `tick` put the loaded (or wanted) ones at the
-- head of the generation queue with a fresh stamp, and they go through the
-- same two-tick pipeline as any chunk, so an edit never waits on a
-- generation. The task captures the edited level-0 chunks under its key
-- when it starts (`World.edits_under`) and coarsens them over what it
-- generates (`World.coarsen_over`), so putting the chunk in costs the
-- caller nothing more than any other. The old chunk and its mesh stay until
-- the new one is applied; a result whose stamp is no longer its key's newest
-- (edited again meanwhile) is dropped and the key asked for again.
mod Strata.Stream do

  needs IO.Spawn

  alias Strata.World as Wo
  alias Strata.Store as So
  alias Strata.Coord as Ko
  alias Strata.Regions as Rs

  -- radius_h, radius_v (chunks), apply_budget (generated chunks per tick),
  -- workers, far_h, far_v (each coarse level's radii in its own chunks), levels
  type Config = Config(Int, Int, Int, Int, Int, Int, Int, Int, Bool)

  pfn nonneg(v : Int) : Int do if v < 0 do 0 else v end end

  doc "A streaming configuration: horizontal and vertical radius in chunks, generated chunks applied per tick, worker count. Level 0 only: `config_levels(.., 0, 0, 0)`."
  fn config(radius_h : Int, radius_v : Int, apply_budget : Int, workers : Int) : Config do
    config_levels(radius_h, radius_v, apply_budget, workers, 0, 0, 0)
  end

  doc "As `config`, with levels 1..[levels] each keeping a box [far_h] chunks out in x and z and [far_v] in y, in chunks of its own level, around the focus (Part F's reference: radius 10 x 3 at level 0, 10 x 1 for levels 1..4)."
  fn config_levels(radius_h : Int, radius_v : Int, apply_budget : Int, workers : Int, far_h : Int, far_v : Int, levels : Int) : Config do
    Config(nonneg(radius_h), nonneg(radius_v), if apply_budget < 1 do 1 else apply_budget end, if workers < 1 do 1 else workers end, nonneg(far_h), nonneg(far_v), nonneg(levels), 1, false)
  end
  pfn rh(c : Config) : Int do match c do Config(a, _, _, _, _, _, _, _, _) -> a end end
  pfn rv(c : Config) : Int do match c do Config(_, b, _, _, _, _, _, _, _) -> b end end
  pfn budget(c : Config) : Int do match c do Config(_, _, n, _, _, _, _, _, _) -> n end end
  pfn nworkers(c : Config) : Int do match c do Config(_, _, _, n, _, _, _, _, _) -> n end end
  pfn fh(c : Config) : Int do match c do Config(_, _, _, _, a, _, _, _, _) -> a end end
  pfn fv(c : Config) : Int do match c do Config(_, _, _, _, _, b, _, _, _) -> b end end
  pfn nlevels(c : Config) : Int do match c do Config(_, _, _, _, _, _, n, _, _) -> n end end

  doc "The configuration [c] with at most [cap] keys of one chunk column and level made by one generation task (Strata.Terrain.run_column), so a generator with a column function does a column's shared work once. 1, the default, is one key a task; below 1 is 1. A tick still starts no more keys than `workers`."
  fn with_batch(c : Config, cap : Int) : Config do
    match c do Config(a, b, n, wk, f, g, l, _, p) -> Config(a, b, n, wk, f, g, l, if cap < 1 do 1 else cap end, p) end
  end
  doc "The configuration [c] whose tick takes only the work that has finished (Task.poll) and keeps the rest for a later tick, so it never waits on a worker. Off by default: a scripted run that must be the same every time has the work of two ticks ago applied whatever it costs to wait."
  fn with_poll(c : Config, yes : Bool) : Config do
    match c do Config(a, b, n, wk, f, g, l, bt, _) -> Config(a, b, n, wk, f, g, l, bt, yes) end
  end
  pfn polls(c : Config) : Bool do match c do Config(_, _, _, _, _, _, _, _, p) -> p end end
  doc "How many keys of one column a generation task may make."
  fn batch(c : Config) : Int do match c do Config(_, _, _, _, _, _, _, n, _) -> n end end

  -- the highest level streamed: the config's, no higher than the generator's
  pfn top(c : Config, w : Strata.World.World) : Int do
    let g = Strata.Terrain.max_level(Wo.terrain(w))
    if nlevels(c) < g do nlevels(c) else g end
  end

  -- ── Work in flight ───────────────────────────────────────────────────────
  -- a generated chunk and its content hash, which the worker computes
  -- (MadeSaved: a level-0 chunk a store holds, saved edits applied, and the
  -- hash of what the generator made for its key)
  type Made = Made(Strata.Chunk.Chunk, Int) | MadeSaved(Strata.Chunk.Chunk, Int)
  -- what a generation task answers: its chunks in order, and the region files it read
  type Batch = Batch(List(Made), List(Strata.Regions.Loaded))
  -- a key, the stale stamp it was asked with (0: a wanted chunk), its result
  type GenRes = GenRes(Strata.Coord.Key, Int, Made)
  -- the keys of one batch, each with its stamp, the task making them in that
  -- order, and the regions whose files the task reads
  type GenTask = GenTask(List((Strata.Coord.Key, Int)), Task(Batch), List(Strata.Coord.Key))
  -- stale coarse keys to generate again, each with the stamp of its newest
  -- request, and the last stamp issued
  type Redo = Redo(Strata.Store.Store(Int), Int)
  type MeshTask = MeshTask(Strata.Coord.Key, Int, Task(Strata.Mesh.Meshed))

  -- ── The stream ───────────────────────────────────────────────────────────
  -- Meshing state per loaded chunk.
  --   need   the stamp of the mesh the chunk needs now (0: none)
  --   asked  the stamp last requested (0: none)
  --   ready  finished meshes not yet taken
  --   todo   keys to look at on the next tick
  --   clock  the last stamp issued
  type Meshing = Meshing(Strata.Store.Store(Int), Strata.Store.Store(Int), Strata.Store.Store(Strata.Mesh.Meshed), List(Strata.Coord.Key), Int)

  -- What has happened to the loaded chunks, kept for two readers that take it
  -- apart: unloads not yet taken by `take_unloads` (the renderer's), and the
  -- chunks loaded or edited and the chunks unloaded not yet taken by
  -- `take_changed` (the entity kernel's). The two sets keep each key once: a
  -- chunk loaded after it was unloaded leaves the unloaded set, and the
  -- other way about. They are kept only once `take_changed` has been called
  -- (sl_on), so a stream nobody takes from (the viewer's) holds nothing in
  -- them. (Fields carry `sl_` so no other record shares them, GAPS S18, S19.)
  --
  -- The record also carries what a store (Strata.Save) gives and takes:
  -- the saved regions generation consults (sl_source; None, as a stream
  -- starts, and nothing is read), and the region files generation tasks
  -- have read, kept until the store takes them (`take_regions`).
  type ChunkLog = { sl_unloads : List(Strata.Coord.Key), sl_on : Bool, sl_changed : Strata.Store.Store(Bool), sl_dropped : Strata.Store.Store(Bool),
                    sl_source : Option(Strata.Regions.RegionSource), sl_regions : List(Strata.Regions.Loaded) }

  pfn no_log() : ChunkLog do { sl_unloads: Nil, sl_on: false, sl_changed: So.empty(false), sl_dropped: So.empty(false), sl_source: None, sl_regions: Nil } end
  pfn log_unload(lg : ChunkLog, k : Strata.Coord.Key) : ChunkLog do
    if lg.sl_on do { lg with sl_unloads: Cons(k, lg.sl_unloads), sl_changed: So.remove(lg.sl_changed, k), sl_dropped: So.put(lg.sl_dropped, k, true) }
    else { lg with sl_unloads: Cons(k, lg.sl_unloads) } end
  end
  pfn log_loaded(lg : ChunkLog, k : Strata.Coord.Key) : ChunkLog do
    if lg.sl_on do { lg with sl_changed: So.put(lg.sl_changed, k, true), sl_dropped: So.remove(lg.sl_dropped, k) } else lg end
  end
  -- the loaded keys of [ks] as changed (an edit's dirty chunks)
  pfn log_edited(lg : ChunkLog, w : Strata.World.World, ks : List(Strata.Coord.Key)) : ChunkLog do
    match ks do
      Nil -> lg
      Cons(k, t) -> log_edited(if Wo.is_loaded(w, k) do log_loaded(lg, k) else lg end, w, t)
    end
  end

  -- world, config, focus chunks, wanted-and-missing queue (nearest first),
  -- generated chunks waiting for budget, the generation and mesh tasks to
  -- collect on the next tick, meshing, the chunk log, the generation and
  -- mesh tasks started on the last tick (collected the tick after next),
  -- and the stale coarse keys being generated again
  type Stream = Stream(Strata.World.World, Config, List(Strata.Coord.Key), List(Strata.Coord.Key), List(GenRes), List(GenTask), List(MeshTask), Meshing, ChunkLog, List(GenTask), List(MeshTask), Redo)

  pfn no_mesh(w : Strata.World.World) : Strata.Mesh.Meshed do
    Strata.Mesh.build(Strata.World.registry(w), Strata.Mesh.around_from(fn (dx, dy, dz) -> Strata.Chunk.uniform(0)))
  end

  doc "Start streaming [w]. Nothing loads until a focus is set and `tick` is called."
  fn start(w : Strata.World.World, c : Config) : Stream do
    Stream(w, c, Nil, Nil, Nil, Nil, Nil, Meshing(So.empty(0), So.empty(0), So.empty(no_mesh(w)), Nil, 0), no_log(), Nil, Nil, Redo(So.empty(0), 0))
  end

  -- ── Collecting tasks ─────────────────────────────────────────────────────
  type Got = Got(List(GenRes), List(Strata.Coord.Key), List(Strata.Regions.Loaded))     -- finished, failed, region files read

  -- a finished batch as one result a key, in order; a batch that answers another number of chunks has failed
  pfn results(ks : List((Strata.Coord.Key, Int)), ms : List(Made), ok : List(GenRes)) : Option(List(GenRes)) do
    match ks do
      Nil -> match ms do
          Nil -> Some(ok)
          _ -> None
        end
      Cons((k, st), kt) ->
        match ms do
          Nil -> None
          Cons(m, mt) -> results(kt, mt, Cons(GenRes(k, st, m), ok))
        end
    end
  end
  pfn keys_onto(ks : List((Strata.Coord.Key, Int)), acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    match ks do
      Nil -> acc
      Cons((k, _), t) -> keys_onto(t, Cons(k, acc))
    end
  end

  pfn await_gens(ts : List(GenTask), g : Got) : Got do
    match ts do
      Nil -> g
      Cons(GenTask(ks, t, _), rest) -> await_gens(rest, gen_done(ks, task_await(t), g))
    end
  end
  -- a generation task's result folded in: its chunks, or its keys to try again
  pfn gen_done(ks : List((Strata.Coord.Key, Int)), r : Result(Batch, String), g : Got) : Got do
    match g do
      Got(ok, bad, reads) ->
        match r do
          Ok(Batch(ms, rr)) ->
            match results(ks, ms, ok) do
              Some(ok2) -> Got(ok2, bad, List.append(rr, reads))
              None -> Got(ok, keys_onto(ks, bad), List.append(rr, reads))
            end
          Err(_) -> Got(ok, keys_onto(ks, bad), reads)
        end
    end
  end
  -- the finished tasks folded in, the rest answered (in order) to be kept for a later tick
  pfn poll_gens(ts : List(GenTask), g : Got, still : List(GenTask)) : (Got, List(GenTask)) do
    match ts do
      Nil -> (g, List.reverse(still))
      Cons(GenTask(ks, t, rr), rest) ->
        match task_poll(t) do
          None -> poll_gens(rest, g, Cons(GenTask(ks, t, rr), still))
          Some(r) -> poll_gens(rest, gen_done(ks, r, g), still)
        end
    end
  end

  -- Fold finished meshes in: one whose stamp is still the chunk's current
  -- need is kept for the caller; a stale one is dropped (its chunk is on
  -- the todo list already, or gone). A failed one is asked for again.
  pfn await_meshes(ts : List(MeshTask), m : Meshing) : Meshing do
    match ts do
      Nil -> m
      Cons(MeshTask(k, stamp, t), rest) -> await_meshes(rest, mesh_done(k, stamp, task_await(t), m))
    end
  end
  -- a mesh task's result folded in
  pfn mesh_done(k : Strata.Coord.Key, stamp : Int, r : Result(Strata.Mesh.Meshed, String), m : Meshing) : Meshing do
    match m do
      Meshing(need, asked, ready, todo, clock) ->
        match r do
          Ok(mesh) -> if So.get(need, k) == stamp do Meshing(need, asked, So.put(ready, k, mesh), todo, clock) else m end
          Err(_) -> Meshing(need, So.remove(asked, k), ready, Cons(k, todo), clock)
        end
    end
  end
  -- the finished mesh tasks folded in, the rest answered (in order) to be kept for a later tick
  pfn poll_meshes(ts : List(MeshTask), m : Meshing, still : List(MeshTask)) : (Meshing, List(MeshTask)) do
    match ts do
      Nil -> (m, List.reverse(still))
      Cons(MeshTask(k, stamp, t), rest) ->
        match task_poll(t) do
          None -> poll_meshes(rest, m, Cons(MeshTask(k, stamp, t), still))
          Some(r) -> poll_meshes(rest, mesh_done(k, stamp, r, m), still)
        end
    end
  end

  doc "Wait for the work in flight and fold it in, so nothing is left running. Call before dropping a stream."
  fn stop(s : Stream) : Unit do
    match s do
      Stream(_, _, _, _, _, gts, mts, m, _, gts2, mts2, _) ->
        match await_gens(gts2, await_gens(gts, Got(Nil, Nil, Nil))) do
          Got(_, _, _) ->
            match await_meshes(mts2, await_meshes(mts, m)) do
              Meshing(_, _, _, _, _) -> ()
            end
        end
    end
  end

  doc "The highest level streamed: the configuration's, no higher than the generator declares (0: the near field only)."
  fn top_level(s : Stream) : Int do match s do Stream(w, c, _, _, _, _, _, _, _, _, _, _) -> top(c, w) end end

  fn world(s : Stream) : Strata.World.World do match s do Stream(w, _, _, _, _, _, _, _, _, _, _, _) -> w end end
  fn loaded_count(s : Stream) : Int do Wo.loaded_count(world(s)) end

  doc "The stream with world [w] in place of its own: for a caller that took something out of the world (`Strata.World.take_changes`, `release_written`) and puts it back. The loaded chunks must be the ones the stream's world held; to put an edited world, use `apply`."
  fn put_world(s : Stream, w : Strata.World.World) : Stream do
    match s do Stream(_, c, fs, q, got, gts, mts, m, gone, gts2, mts2, rd) -> Stream(w, c, fs, q, got, gts, mts, m, gone, gts2, mts2, rd) end
  end

  doc "Is a generation of [k] under way: its task running, or its chunk made and waiting to be applied?"
  fn generating(s : Stream, k : Strata.Coord.Key) : Bool do
    match s do
      Stream(_, _, _, _, got, gts, _, _, _, gts2, _, _) ->
        if waiting_has(got, k) do true else if running(gts, k) do true else running(gts2, k) end end
    end
  end

  -- ── The wanted set ───────────────────────────────────────────────────────
  pfn absv(v : Int) : Int do if v < 0 do 0 - v else v end end

  pfn pow2(l : Int) : Int do if l <= 0 do 1 else 2 * pow2(l - 1) end end
  -- floor(v / d) for d > 0, any sign
  pfn fdiv(v : Int, d : Int) : Int do if v >= 0 do v / d else 0 - ((d - 1 - v) / d) end end

  -- the level-l chunks holding the (level-0) focus chunks
  pfn focus_at(fs : List(Strata.Coord.Key), l : Int) : List(Strata.Coord.Key) do
    let n = pow2(l)
    List.map(fs, fn f -> Ko.key_at(fdiv(Ko.kx(f), n), fdiv(Ko.ky(f), n), fdiv(Ko.kz(f), n), l))
  end

  -- One axis of a focus's INSIDE at level [l]: the chunks of the box that
  -- have all their neighbours, and so are meshed. It is [rl] - 1 level-l
  -- chunks about the level-l chunk holding the focus ([r0] - 1 at level 0;
  -- a radius under 1 counts as 1), with the parents of the level below's
  -- inside, all grown by [grow], and, below the top level [top], snapped out
  -- to whole chunks of the level above. The box is the inside and one chunk
  -- round it. [f] is the focus's level-0 chunk coordinate. So the meshed
  -- chunks of each level below the top make up whole chunks of the level
  -- above, and each one's parent is meshed too: the renderer's draw rule
  -- can hide every coarse chunk over them.
  pfn inner(f : Int, r0 : Int, rl : Int, l : Int, top : Int, grow : Int) : (Int, Int) do
    let raw = if l <= 0 do (f - in_r(r0) - grow, f + in_r(r0) + grow)
      else
        match inner(f, r0, rl, l - 1, top, grow) do
          (lo, hi) ->
            let fl = fdiv(f, pow2(l))
            let a = fdiv(lo, 2)
            let b = fdiv(hi, 2)
            (if a < fl - in_r(rl) - grow do a else fl - in_r(rl) - grow end, if b > fl + in_r(rl) + grow do b else fl + in_r(rl) + grow end)
        end
      end
    match raw do
      (lo, hi) -> if l < top do (2 * fdiv(lo, 2), 2 * fdiv(hi, 2) + 1) else (lo, hi) end
    end
  end
  pfn in_r(r : Int) : Int do if r < 1 do 0 else r - 1 end end
  -- ... and the box: the inside and one chunk round it
  pfn snapped(f : Int, r0 : Int, rl : Int, l : Int, top : Int, grow : Int) : (Int, Int) do
    match inner(f, r0, rl, l, top, grow) do
      (lo, hi) -> (lo - 1, hi + 1)
    end
  end
  pfn inside(v : Int, r : (Int, Int)) : Bool do
    match r do (lo, hi) -> if v < lo do false else v <= hi end end
  end
  -- A focus's box at level [l] as (x0, x1, y0, y1, z0, z1), level-l chunk coordinates, inclusive.
  pfn box_of(c : Config, top : Int, f : Strata.Coord.Key, l : Int, grow : Int) : (Int, Int, Int, Int, Int, Int) do
    match snapped(Ko.kx(f), rh(c), fh(c), l, top, grow) do
      (x0, x1) -> match snapped(Ko.ky(f), rv(c), fv(c), l, top, grow) do
        (y0, y1) -> match snapped(Ko.kz(f), rh(c), fh(c), l, top, grow) do
          (z0, z1) -> (x0, x1, y0, y1, z0, z1)
        end
      end
    end
  end

  -- Is k in its level's box about some focus, grown by [grow] chunks? Levels
  -- above [hi] are wanted nowhere.
  pfn in_box(c : Config, hi : Int, fs : List(Strata.Coord.Key), k : Strata.Coord.Key, grow : Int) : Bool do
    let l = Ko.level(k)
    if l < 0 do false else if l > hi do false else in_boxes(c, hi, fs, k, l, grow) end end
  end
  pfn in_boxes(c : Config, hi : Int, fs : List(Strata.Coord.Key), k : Strata.Coord.Key, l : Int, grow : Int) : Bool do
    match fs do
      Nil -> false
      Cons(f, t) ->
        if !inside(Ko.kx(k), snapped(Ko.kx(f), rh(c), fh(c), l, hi, grow)) do in_boxes(c, hi, t, k, l, grow)
        else if !inside(Ko.kz(k), snapped(Ko.kz(f), rh(c), fh(c), l, hi, grow)) do in_boxes(c, hi, t, k, l, grow)
        else if !inside(Ko.ky(k), snapped(Ko.ky(f), rv(c), fv(c), l, hi, grow)) do in_boxes(c, hi, t, k, l, grow)
        else true end end end
    end
  end

  pfn has_key(l : List(Strata.Coord.Key), k : Strata.Coord.Key) : Bool do
    match l do
      Nil -> false
      Cons(h, t) -> if Ko.key_eq(h, k) do true else has_key(t, k) end
    end
  end

  pfn cheb(dx : Int, dy : Int, dz : Int) : Int do
    let a = absv(dx)
    let b = absv(dy)
    let c = absv(dz)
    if a >= b && a >= c do a else if b >= c do b else c end end
  end

  -- Sort one focus's box into buckets by Chebyshev distance from the chunk
  -- [fl] holding the focus: bucket d gains the box's keys at distance d that
  -- are not loaded and not already seen. One pass over the box; i walks it.
  pfn bucket(w : Strata.World.World, seen : Strata.Store.Store(Bool), bs : Strata.Tree.Tree(List(Strata.Coord.Key)), fl : Strata.Coord.Key, bx : (Int, Int, Int, Int, Int, Int), multi : Bool, i : Int) : (Strata.Store.Store(Bool), Strata.Tree.Tree(List(Strata.Coord.Key))) do
    match bx do
      (x0, x1, y0, y1, z0, z1) ->
        let nx = x1 - x0 + 1
        let nz = z1 - z0 + 1
        let ny = y1 - y0 + 1
        if i >= nx * nz * ny do (seen, bs)
        else
          let x = x0 + i % nx
          let z = z0 + (i / nx) % nz
          let y = y0 + i / (nx * nz)
          let k = Ko.key_at(x, y, z, Ko.level(fl))
          -- with one focus no key can come up twice, so the seen set is left alone
          if Wo.is_loaded(w, k) || (multi && So.has(seen, k)) do bucket(w, seen, bs, fl, bx, multi, i + 1)
          else
            let d = cheb(x - Ko.kx(fl), y - Ko.ky(fl), z - Ko.kz(fl))
            bucket(w, if multi do So.put(seen, k, true) else seen end, Strata.Tree.set(bs, d, Cons(k, Strata.Tree.get(bs, d))), fl, bx, multi, i + 1)
          end
        end
    end
  end

  -- how far a box reaches from [fl], the chunk holding its focus, in chunks (Chebyshev)
  pfn reach(fl : Strata.Coord.Key, bx : (Int, Int, Int, Int, Int, Int)) : Int do
    match bx do
      (x0, x1, y0, y1, z0, z1) ->
        List.fold_left(Cons(Ko.kx(fl) - x0, Cons(x1 - Ko.kx(fl), Cons(Ko.ky(fl) - y0, Cons(y1 - Ko.ky(fl), Cons(Ko.kz(fl) - z0, Cons(z1 - Ko.kz(fl), Nil)))))), 0, fn (m, v) -> if v > m do v else m end)
    end
  end

  pfn buckets_for(w : Strata.World.World, c : Config, top : Int, l : Int, seen : Strata.Store.Store(Bool), bs : Strata.Tree.Tree(List(Strata.Coord.Key)), fs : List(Strata.Coord.Key), multi : Bool) : Strata.Tree.Tree(List(Strata.Coord.Key)) do
    match fs do
      Nil -> bs
      Cons(f, t) ->
        match bucket(w, seen, bs, head_or(focus_at(Cons(f, Nil), l), f), box_of(c, top, f, l, 0), multi, 0) do
          (seen2, bs2) -> buckets_for(w, c, top, l, seen2, bs2, t, multi)
        end
    end
  end
  pfn head_or(l : List(Strata.Coord.Key), d : Strata.Coord.Key) : Strata.Coord.Key do
    match l do
      Nil -> d
      Cons(h, _) -> h
    end
  end

  pfn push_all(ks : List(Strata.Coord.Key), acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    match ks do
      Nil -> acc
      Cons(k, t) -> push_all(t, Cons(k, acc))
    end
  end

  -- The buckets end to end, farthest first onto the front, so the result
  -- runs nearest first.
  pfn drain(bs : Strata.Tree.Tree(List(Strata.Coord.Key)), d : Int, acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    if d < 0 do acc else drain(bs, d - 1, push_all(Strata.Tree.get(bs, d), acc)) end
  end

  pfn nils(n : Int, acc : List(List(Strata.Coord.Key))) : List(List(Strata.Coord.Key)) do
    if n <= 0 do acc else nils(n - 1, Cons(Nil, acc)) end
  end

  -- One level's wanted chunks that are not loaded, nearest to a focus first.
  pfn missing_at(w : Strata.World.World, c : Config, top : Int, fs : List(Strata.Coord.Key), l : Int) : List(Strata.Coord.Key) do
    let far = List.fold_left(fs, 0, fn (m, f) ->
      let r = reach(head_or(focus_at(Cons(f, Nil), l), f), box_of(c, top, f, l, 0))
      if r > m do r else m end)
    let multi = match fs do
      Cons(_, Cons(_, _)) -> true
      _ -> false
    end
    drain(buckets_for(w, c, top, l, So.empty(false), Strata.Tree.from_list(nils(far + 1, Nil), Nil), fs, multi), far, Nil)
  end

  -- Wanted chunks that are not loaded: level 0 nearest to a focus first,
  -- then each coarser level likewise.
  pfn missing(w : Strata.World.World, c : Config, fs : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    let hi = top(c, w)
    let coarse = List.fold_left(List.reverse(List.range(1, hi + 1)), Nil, fn (acc, l) -> List.append(missing_at(w, c, hi, fs, l), acc))
    List.append(missing_at(w, c, hi, fs, 0), coarse)
  end

  -- ── Unloading ────────────────────────────────────────────────────────────
  type Dropped = Dropped(Strata.World.World, Meshing, ChunkLog)

  pfn forget(m : Meshing, k : Strata.Coord.Key) : Meshing do
    match m do
      Meshing(need, asked, ready, todo, clock) -> Meshing(So.remove(need, k), So.remove(asked, k), So.remove(ready, k), todo, clock)
    end
  end

  -- every level's band box about each focus, level 0 first: worked out once a walk
  pfn bands(c : Config, top : Int, fs : List(Strata.Coord.Key)) : List(List((Int, Int, Int, Int, Int, Int))) do
    List.map(List.range(0, top + 1), fn l -> List.map(fs, fn f -> box_of(c, top, f, l, 1)))
  end
  pfn in_any(bxs : List((Int, Int, Int, Int, Int, Int)), k : Strata.Coord.Key) : Bool do
    match bxs do
      Nil -> false
      Cons((x0, x1, y0, y1, z0, z1), t) ->
        if Ko.kx(k) < x0 do in_any(t, k) else if Ko.kx(k) > x1 do in_any(t, k)
        else if Ko.kz(k) < z0 do in_any(t, k) else if Ko.kz(k) > z1 do in_any(t, k)
        else if Ko.ky(k) < y0 do in_any(t, k) else if Ko.ky(k) > y1 do in_any(t, k)
        else true end end end end end end
    end
  end
  pfn nth_bands(bl : List(List((Int, Int, Int, Int, Int, Int))), l : Int) : List((Int, Int, Int, Int, Int, Int)) do
    match bl do
      Nil -> Nil
      Cons(h, t) -> if l <= 0 do h else nth_bands(t, l - 1) end
    end
  end

  -- Unload every key in [ks] outside its level's band ([bl], from `bands`).
  pfn drop_far(d : Dropped, ks : List(Strata.Coord.Key), top : Int, bl : List(List((Int, Int, Int, Int, Int, Int)))) : Dropped do
    match ks do
      Nil -> d
      Cons(k, t) ->
        let l = Ko.level(k)
        let keep = if l < 0 do false else if l > top do false else in_any(nth_bands(bl, l), k) end end
        if keep do drop_far(d, t, top, bl)
        else
          match d do
            Dropped(w, m, gone) ->
              let w2 = Wo.unload(w, k)
              drop_far(Dropped(w2, wake(forget(m, k), w2, k, top), log_unload(gone, k)), t, top, bl)
          end
        end
    end
  end

  pfn focus_keys(w : Strata.World.World, points : List((Float, Float, Float)), acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    match points do
      Nil -> List.reverse(acc)
      Cons((x, y, z), t) ->
        let sc = Wo.scale(w)
        let k = Ko.key_of_voxel(Ko.to_voxel(sc, x), Ko.to_voxel(sc, y), Ko.to_voxel(sc, z))
        focus_keys(w, t, if has_key(acc, k) do acc else Cons(k, acc) end)
    end
  end

  doc "Set the focus points, in metres. Chunks now out of range are unloaded at once; loading happens over the following ticks."
  fn set_focus(s : Stream, points : List((Float, Float, Float))) : Stream do
    match s do
      Stream(w, c, _, _, got, gts, mts, m, gone, gts2, mts2, rd) ->
        let fs = focus_keys(w, points, Nil)
        match drop_far(Dropped(w, m, gone), So.keys(Wo.chunks(w)), top(c, w), bands(c, top(c, w), fs)) do
          Dropped(w2, m2, gone2) ->
            -- stale keys still loaded (kept within the unload band) or wanted keep their place at the head of the queue
            let rd2 = match rd do Redo(st, n) -> Redo(So.fold(st, So.empty(0), fn (acc, k, v) -> if stale_wanted(c, top(c, w2), fs, w2, k) do So.put(acc, k, v) else acc end), n) end
            let ks = match rd2 do Redo(st, _) -> So.keys(st) end
            Stream(w2, c, fs, prepend(ks, missing(w2, c, fs)), got, gts, mts, m2, gone2, gts2, mts2, rd2)
        end
    end
  end

  doc "Regenerate from generator [g]: the work in flight is waited for and dropped, every loaded chunk that was not edited is unloaded (its key is reported by `take_unloads`, so the renderer frees it) and loads again from [g] over the following ticks; edited chunks stay, and are remeshed against their new neighbours as these arrive."
  fn regenerate(s : Stream, g : Strata.Terrain.Gen) : Stream do
    stop(s)
    match s do
      Stream(w, c, fs, _, _, _, _, m, gone, _, _, Redo(_, n)) ->
        match Wo.regenerate(w, g) do
          (w2, dropped) ->
            let m2 = List.fold_left(dropped, m, fn (acc, k) -> forget(acc, k))
            let m3 = stale(m2, w2, So.keys(Wo.chunks(w2)))
            Stream(w2, c, fs, missing(w2, c, fs), Nil, Nil, Nil, m3, List.fold_left(dropped, gone, fn (lg, k) -> log_unload(lg, k)), Nil, Nil, Redo(So.empty(0), n))
        end
    end
  end

  -- ── Meshing bookkeeping ──────────────────────────────────────────────────
  pfn add_todo(todo : List(Strata.Coord.Key), w : Strata.World.World, k : Strata.Coord.Key, i : Int) : List(Strata.Coord.Key) do
    -- k and its 26 neighbours, where loaded
    if i >= 27 do todo
    else
      let n = Ko.offset(k, i % 3 - 1, i / 9 - 1, (i / 3) % 3 - 1)
      add_todo(if Wo.is_loaded(w, n) do Cons(n, todo) else todo end, w, k, i + 1)
    end
  end

  -- [k] unloaded: a coarse chunk over it, or over a chunk that needed it as a
  -- neighbour, may no longer have all its children meshable, and so must be
  -- meshed itself. Those are the parents of k's 27, at most 8 keys: put the
  -- loaded ones on the todo list (send_meshes decides).
  pfn wake(m : Meshing, w : Strata.World.World, k : Strata.Coord.Key, top : Int) : Meshing do
    if Ko.level(k) >= top do m
    else
      match m do
        Meshing(need, asked, ready, todo, clock) ->
          let ps = List.map(List.range(0, 8), fn i -> Ko.key_at(fdiv(Ko.kx(k) + 2 * (i % 2) - 1, 2), fdiv(Ko.ky(k) + 2 * ((i / 2) % 2) - 1, 2), fdiv(Ko.kz(k) + 2 * (i / 4) - 1, 2), Ko.level(k) + 1))
          Meshing(need, asked, ready, List.fold_left(ps, todo, fn (acc, p) -> if Wo.is_loaded(w, p) do Cons(p, acc) else acc end), clock)
      end
    end
  end

  -- Are all eight children of coarse chunk [k] loaded and meshable (all their
  -- neighbours loaded)? Then they draw its region and it needs no mesh.
  pfn under(w : Strata.World.World, k : Strata.Coord.Key) : Bool do
    if Ko.level(k) <= 0 do false else all_meshable(w, Ko.children(k)) end
  end
  pfn all_meshable(w : Strata.World.World, ks : List(Strata.Coord.Key)) : Bool do
    match ks do
      Nil -> true
      Cons(k, t) -> if Strata.Mesh.has_all(Wo.chunks(w), k) do all_meshable(w, t) else false end
    end
  end

  -- A chunk arrived: it needs a mesh, and it may complete a neighbour's 27.
  pfn arrived(m : Meshing, w : Strata.World.World, k : Strata.Coord.Key) : Meshing do
    match m do
      Meshing(need, asked, ready, todo, clock) -> Meshing(So.put(need, k, clock + 1), asked, ready, add_todo(todo, w, k, 0), clock + 1)
    end
  end

  pfn stale(m : Meshing, w : Strata.World.World, ks : List(Strata.Coord.Key)) : Meshing do
    match ks do
      Nil -> m
      Cons(k, t) ->
        match m do
          Meshing(need, asked, ready, todo, clock) ->
            if Wo.is_loaded(w, k) do stale(Meshing(So.put(need, k, clock + 1), asked, ready, Cons(k, todo), clock + 1), w, t)
            else stale(m, w, t) end
        end
    end
  end

  -- ── Stale coarse chunks ──────────────────────────────────────────────────
  -- A stale key is worth generating again while it is loaded (a loaded
  -- chunk is kept within the unload band, one chunk past its box) or wanted.
  pfn stale_wanted(c : Config, hi : Int, fs : List(Strata.Coord.Key), w : Strata.World.World, k : Strata.Coord.Key) : Bool do
    if Wo.is_loaded(w, k) do in_box(c, hi, fs, k, 1) else in_box(c, hi, fs, k, 0) end
  end

  -- Take the world's stale keys (clearing them): each loaded or wanted one
  -- gets a fresh stamp and goes to the head of the queue [q].
  pfn start_stale(w : Strata.World.World, c : Config, fs : List(Strata.Coord.Key), rd : Redo, q : List(Strata.Coord.Key)) : (Strata.World.World, Redo, List(Strata.Coord.Key)) do
    let w2 = Wo.clear_stale(w)
    let hi = top(c, w2)
    List.fold_left(Wo.stale(w), (w2, rd, q), fn (acc, k) ->
      match acc do
        (wa, Redo(st, n), qa) ->
          if stale_wanted(c, hi, fs, wa, k) do (wa, Redo(So.put(st, k, n + 1), n + 1), Cons(k, qa)) else acc end
      end)
  end

  doc "Adopt the world an edit produced and schedule its dirty chunks for remeshing. The coarse chunks the edit made stale go to the head of the generation queue; they are put back, with the edit coarsened in, when their generation is applied (the tick after next at the soonest)."
  fn apply(s : Stream, o : Strata.Edit.Outcome) : Stream do
    match s do
      Stream(_, c, fs, q, got, gts, mts, m, gone, gts2, mts2, rd) ->
        match start_stale(Strata.Edit.world(o), c, fs, rd, q) do
          (w2, rd2, q2) -> Stream(w2, c, fs, q2, got, gts, mts, stale(m, w2, Strata.Edit.dirty(o)), log_edited(gone, w2, Strata.Edit.dirty(o)), gts2, mts2, rd2)
        end
    end
  end

  -- ── The tick ─────────────────────────────────────────────────────────────
  pfn count(l : List(a), n : Int) : Int do
    match l do
      Nil -> n
      Cons(_, t) -> count(t, n + 1)
    end
  end

  -- the world, meshing, results over budget, the stale stamps, keys to ask for again
  type Applied = Applied(Strata.World.World, Meshing, List(GenRes), Strata.Store.Store(Int), List(Strata.Coord.Key), ChunkLog)

  -- Insert up to n generated chunks. One for a key no longer wanted is
  -- dropped; one for a loaded key is dropped unless it answers that key's
  -- newest stale stamp, when it replaces the loaded chunk (and it and its
  -- loaded neighbours need meshes if it changed); one answering an older
  -- stamp is dropped and its key asked for again. What is over budget waits
  -- for the next tick.
  pfn apply_gens(a : Applied, rs : List(GenRes), n : Int, c : Config, fs : List(Strata.Coord.Key)) : Applied do
    match rs do
      Nil -> a
      Cons(GenRes(k, st, ch), t) ->
        match a do
          Applied(w, m, rest, rd, again, lg) ->
            let cur = So.get(rd, k)
            -- a stale key is kept while loaded in the unload band; anything else must be wanted
            let keep = if cur == 0 do in_box(c, top(c, w), fs, k, 0) else stale_wanted(c, top(c, w), fs, w, k) end
            if !keep do apply_gens(Applied(w, m, rest, So.remove(rd, k), again, lg), t, n, c, fs)
            else if cur != 0 && st != cur do apply_gens(Applied(w, m, rest, rd, Cons(k, again), lg), t, n, c, fs)
            else if cur == 0 && Wo.is_loaded(w, k) do apply_gens(a, t, n, c, fs)
            else if n <= 0 do apply_gens(Applied(w, m, Cons(GenRes(k, st, ch), rest), rd, again, lg), t, n, c, fs)
            else
              let h = made_hash(ch)
              if Wo.is_loaded(w, k) do
                let changed = Wo.gen_hash(w, k) != h
                let w2 = put_made(w, k, ch)
                apply_gens(Applied(w2, if changed do stale(m, w2, add_todo(Nil, w2, k, 0)) else m end, rest, So.remove(rd, k), again, if changed do log_loaded(lg, k) else lg end), t, n - 1, c, fs)
              else
                let w2 = put_made(w, k, ch)
                apply_gens(Applied(w2, arrived(m, w2, k), rest, So.remove(rd, k), again, log_loaded(lg, k)), t, n - 1, c, fs)
              end
            end end end end
        end
    end
  end

  pfn made_hash(ch : Made) : Int do
    match ch do
      Made(_, h) -> h
      MadeSaved(_, h) -> h
    end
  end
  -- a made chunk into the world: a generated one as generated, a saved one in the generated one's place
  pfn put_made(w : Strata.World.World, k : Strata.Coord.Key, ch : Made) : Strata.World.World do
    match ch do
      Made(cc, h) -> Wo.insert_hashed(w, k, cc, h)
      MadeSaved(cc, h) -> Wo.insert_saved(w, k, cc, h)
    end
  end

  pfn waiting_has(rs : List(GenRes), k : Strata.Coord.Key) : Bool do
    match rs do
      Nil -> false
      Cons(GenRes(k2, _, _), t) -> if Ko.key_eq(k2, k) do true else waiting_has(t, k) end
    end
  end

  type Handed = Handed(List(Strata.Coord.Key), List(GenTask))

  -- On the worker: generate the batch's keys (one chunk column and level:
  -- Strata.Terrain.run_column), then coarsen each coarse key's captured fine
  -- chunks over its chunk. With a store's regions ([src]), a level-0 key
  -- whose region has a file gets what the region holds for it: the saved
  -- chunk in the generated one's place, and the saved queue of edits
  -- applied, oldest first. A region not decoded yet is read here, once a
  -- task ([reads] remembers it), and answered with the chunks.
  pfn finish_made(r : Strata.Blocks.Registry, items : List((Strata.Coord.Key, Int, List(Strata.World.Fine))), cs : List(Strata.Chunk.Chunk), acc : List(Made), src : Option(Strata.Regions.RegionSource), reads : List(Strata.Regions.Loaded)) : Batch do
    match items do
      Nil -> Batch(List.reverse(acc), reads)
      Cons((k, _, fines), it) ->
        match cs do
          Nil -> Batch(List.reverse(acc), reads)
          Cons(c0, ct) ->
            if Ko.level(k) > 0 do
              let c = Wo.coarsen_over(r, k, c0, fines)
              finish_made(r, it, ct, Cons(Made(c, Strata.Chunk.hash(c)), acc), src, reads)
            else
              let (m, reads2) = saved_or(k, c0, src, reads)
              finish_made(r, it, ct, Cons(m, acc), src, reads2)
            end
        end
    end
  end
  -- the level-0 chunk of k: generated chunk c0, or what the store's region holds for k
  pfn saved_or(k : Strata.Coord.Key, c0 : Strata.Chunk.Chunk, src : Option(Strata.Regions.RegionSource), reads : List(Strata.Regions.Loaded)) : (Made, List(Strata.Regions.Loaded)) do
    match src do
      None -> (Made(c0, Strata.Chunk.hash(c0)), reads)
      Some(sr) ->
        let rk = Rs.of_chunk(k)
        if !Rs.present(sr, rk) do (Made(c0, Strata.Chunk.hash(c0)), reads)
        else
          match Rs.lookup(sr, rk) do
            Some(g) -> (from_region(k, c0, g), reads)
            None ->
              match Rs.loaded_in(reads, rk) do
                Some(rd) -> (from_read(k, c0, rd), reads)
                None ->
                  let rd = Rs.read(Rs.dir(sr), rk)
                  (from_read(k, c0, rd), Cons(Rs.loaded(rk, Rs.epoch(sr), rd), reads))
              end
          end
        end
    end
  end
  pfn from_read(k : Strata.Coord.Key, c0 : Strata.Chunk.Chunk, rd : Strata.Regions.RegionRead) : Made do
    match rd do
      RrGot(g) -> from_region(k, c0, g)
      _ -> Made(c0, Strata.Chunk.hash(c0))
    end
  end
  pfn from_region(k : Strata.Coord.Key, c0 : Strata.Chunk.Chunk, g : Strata.Savefile.Region) : Made do
    let ops = Rs.ops_in(g, k)
    match Rs.chunk_in(g, k) do
      Some(c) -> MadeSaved(List.fold_left(ops, c, fn (acc, op) -> Wo.apply_op(acc, k, op)), Strata.Chunk.hash(c0))
      None ->
        match ops do
          Nil -> Made(c0, Strata.Chunk.hash(c0))
          _ -> MadeSaved(List.fold_left(ops, c0, fn (acc, op) -> Wo.apply_op(acc, k, op)), Strata.Chunk.hash(c0))
        end
    end
  end
  pfn make(g : Strata.Terrain.Gen, r : Strata.Blocks.Registry, items : List((Strata.Coord.Key, Int, List(Strata.World.Fine))), seed : Int, src : Option(Strata.Regions.RegionSource)) : Batch do
    finish_made(r, items, Strata.Terrain.run_column(g, List.map(items, fn i -> match i do (k, _, _) -> k end), seed), Nil, src, Nil)
  end

  pfn gen_task(g : Strata.Terrain.Gen, r : Strata.Blocks.Registry, items : List((Strata.Coord.Key, Int, List(Strata.World.Fine))), seed : Int, src : Option(Strata.Regions.RegionSource)) : Task(Batch) do
    task_spawn(fn _ -> make(g, r, items, seed, src))
  end

  -- ── A store's regions ────────────────────────────────────────────────────
  -- The region whose file a task for level-0 key k would have to read: it
  -- has a file and is not decoded yet. None for any other key.
  pfn to_read(src : Option(Strata.Regions.RegionSource), k : Strata.Coord.Key) : Option(Strata.Coord.Key) do
    match src do
      None -> None
      Some(sr) ->
        if Ko.level(k) != 0 do None
        else
          let rk = Rs.of_chunk(k)
          if !Rs.present(sr, rk) do None else if Rs.decoded(sr, rk) do None else Some(rk) end end
        end
    end
  end
  pfn reading(ts : List(GenTask), rk : Strata.Coord.Key) : Bool do
    match ts do
      Nil -> false
      Cons(GenTask(_, _, rr), t) -> if has_key(rr, rk) do true else reading(t, rk) end
    end
  end
  -- the regions a batch's task will read, each once
  pfn reads_of(items : List((Strata.Coord.Key, Int, List(Strata.World.Fine))), src : Option(Strata.Regions.RegionSource), acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    match items do
      Nil -> acc
      Cons((k, _, _), t) ->
        match to_read(src, k) do
          None -> reads_of(t, src, acc)
          Some(rk) -> reads_of(t, src, if has_key(acc, rk) do acc else Cons(rk, acc) end)
        end
    end
  end

  -- Whether key k may be started now: its stamp (0 for a key not loaded, the
  -- stale stamp for a loaded stale one), or -1: loaded and not stale, not
  -- wanted, already waiting to be applied, or already started.
  -- Nor (-2: it keeps its place in the queue) may a key whose region's file another task is reading (one started
  -- in this dispatch, [out], or still in flight, [fly]): one task reads a
  -- region's file, and its other keys wait for a later dispatch, when the
  -- region is decoded.
  pfn startable(k : Strata.Coord.Key, out : List(GenTask), w : Strata.World.World, c : Config, fs : List(Strata.Coord.Key), waiting : List(GenRes), rd : Strata.Store.Store(Int), ld : Loading) : Int do
    let st = So.get(rd, k)
    let skip = if st == 0 do Wo.is_loaded(w, k) else false end
    if skip do 0 - 1
    else
      let want = if st == 0 do in_box(c, top(c, w), fs, k, 0) else stale_wanted(c, top(c, w), fs, w, k) end
      if !want do 0 - 1 else if waiting_has(waiting, k) do 0 - 1 else if running(out, k) do 0 - 1 else if region_busy(k, out, ld) do 0 - 2 else st end end end end
    end
  end
  -- the store's regions as a dispatch sees them, and the tasks in flight
  type Loading = Loading(Option(Strata.Regions.RegionSource), List(GenTask))
  pfn region_busy(k : Strata.Coord.Key, out : List(GenTask), ld : Loading) : Bool do
    match ld do
      Loading(src, fly) ->
        match to_read(src, k) do
          None -> false
          Some(rk) -> if reading(out, rk) do true else reading(fly, rk) end
        end
    end
  end

  pfn item_of(k : Strata.Coord.Key, st : Int, w : Strata.World.World) : (Strata.Coord.Key, Int, List(Strata.World.Fine)) do
    (k, st, if Ko.level(k) > 0 do Wo.edits_under(w, k) else Nil end)
  end

  -- how far down the queue a batch looks for the other keys of its column
  pfn mate_reach() : Int do 512 end

  -- The other keys of first's chunk column among the next [look] keys of the
  -- queue that may be started, at most [left] of them: (the batch's items in
  -- queue order after [items], the queue without them). A key that may not
  -- be started stays in the queue, as send_gens leaves it there.
  pfn mates(first : Strata.Coord.Key, q : List(Strata.Coord.Key), left : Int, look : Int, out : List(GenTask), w : Strata.World.World, c : Config, fs : List(Strata.Coord.Key), waiting : List(GenRes), rd : Strata.Store.Store(Int), ld : Loading, items : List((Strata.Coord.Key, Int, List(Strata.World.Fine))), kept : List(Strata.Coord.Key)) : (List((Strata.Coord.Key, Int, List(Strata.World.Fine))), List(Strata.Coord.Key)) do
    -- kept is newest first and prepend puts its first key deepest, so the queue keeps its order
    if left <= 0 do (List.reverse(items), prepend(kept, q))
    else if look <= 0 do (List.reverse(items), prepend(kept, q))
    else
      match q do
        Nil -> (List.reverse(items), List.reverse(kept))
        Cons(k, t) ->
          if !Strata.Terrain.same_column(first, k) do mates(first, t, left, look - 1, out, w, c, fs, waiting, rd, ld, items, Cons(k, kept))
          -- the queue can hold a key twice (asked for again after a failure): once in a batch is enough
          else if has_item(items, k) do mates(first, t, left, look - 1, out, w, c, fs, waiting, rd, ld, items, kept)
          else
            let st = startable(k, out, w, c, fs, waiting, rd, ld)
            if st < 0 do mates(first, t, left, look - 1, out, w, c, fs, waiting, rd, ld, items, Cons(k, kept))
            else mates(first, t, left - 1, look - 1, out, w, c, fs, waiting, rd, ld, Cons(item_of(k, st, w), items), kept) end
          end end
      end
    end end
  end
  pfn has_item(items : List((Strata.Coord.Key, Int, List(Strata.World.Fine))), k : Strata.Coord.Key) : Bool do
    match items do
      Nil -> false
      Cons((k2, _, _), t) -> if Ko.key_eq(k2, k) do true else has_item(t, k) end
    end
  end

  pfn stamped(items : List((Strata.Coord.Key, Int, List(Strata.World.Fine)))) : List((Strata.Coord.Key, Int)) do
    List.map(items, fn i -> match i do (k, st, _) -> (k, st) end)
  end

  -- Start generation tasks from the head of the queue for up to [room] keys:
  -- a key not loaded, or loaded and stale (stamp in rd), not already waiting
  -- or started, and wanted. With a batch cap over 1 the other startable keys
  -- of its chunk column go into the same task, up to the cap and the room.
  -- A coarse key carries the fine chunks to coarsen.
  pfn send_gens(q : List(Strata.Coord.Key), out : List(GenTask), w : Strata.World.World, c : Config, fs : List(Strata.Coord.Key), waiting : List(GenRes), room : Int, rd : Strata.Store.Store(Int), ld : Loading, held : List(Strata.Coord.Key)) : Handed do
    match q do
      Nil -> Handed(List.reverse(held), out)
      Cons(k, t) ->
        let st = startable(k, out, w, c, fs, waiting, rd, ld)
        if st == 0 - 2 do send_gens(t, out, w, c, fs, waiting, room, rd, ld, Cons(k, held))
        else if st < 0 do send_gens(t, out, w, c, fs, waiting, room, rd, ld, held)
        else if room <= 0 do Handed(prepend(held, q), out)
        else
          let more = if batch(c) < room do batch(c) - 1 else room - 1 end
          match mates(k, t, more, mate_reach(), out, w, c, fs, waiting, rd, ld, Cons(item_of(k, st, w), Nil), Nil) do
            (items, t2) ->
              -- everything this thread needs of the items is taken before the task starts: the task
              -- gets the list as its last use here, so the two threads never hold it together
              let ks = stamped(items)
              let n = List.length(items)
              let src = match ld do Loading(sr, _) -> sr end
              let rr = reads_of(items, src, Nil)
              let task = gen_task(Wo.terrain(w), Wo.registry(w), items, Wo.seed(w), src)
              send_gens(t2, Cons(GenTask(ks, task, rr), out), w, c, fs, waiting, room - n, rd, ld, held)
          end
        end end end
    end
  end

  type Asked = Asked(Meshing, List(MeshTask), List(Strata.Coord.Key))

  pfn mesh_task(r : Strata.Blocks.Registry, a : Strata.Mesh.Around, l : Int) : Task(Strata.Mesh.Meshed) do
    task_spawn(fn _ -> Strata.Mesh.with_level(Strata.Mesh.build(r, a), l))
  end

  -- Start a mesh task for each todo chunk that needs one and has its 27,
  -- up to [room]; what does not fit stays on the todo list in [left].
  pfn send_meshes(todo : List(Strata.Coord.Key), seen : Strata.Store.Store(Bool), m : Meshing, out : List(MeshTask), left : List(Strata.Coord.Key), w : Strata.World.World, room : Int) : Asked do
    match todo do
      Nil -> Asked(m, out, left)
      Cons(k, t) ->
        -- an arriving chunk puts itself and its 26 neighbours on the list, so
        -- most keys are there many times over: look at each once
        if So.has(seen, k) do send_meshes(t, seen, m, out, left, w, room)
        else
          let seen2 = So.put(seen, k, true)
          match m do
            Meshing(need, asked, ready, td, clock) ->
              let want = So.get(need, k)
              if want == 0 || want == So.get(asked, k) || !Strata.Mesh.has_all(Wo.chunks(w), k) do send_meshes(t, seen2, m, out, left, w, room)
              -- a coarse chunk over meshable children is not meshed; wake looks at it again when one goes
              else if under(w, k) do send_meshes(t, seen2, m, out, left, w, room)
              else if room <= 0 do send_meshes(t, seen2, m, out, Cons(k, left), w, room)
              else
                let task = mesh_task(Wo.registry(w), Strata.Mesh.around_of(Wo.chunks(w), k), Ko.level(k))
                send_meshes(t, seen2, Meshing(need, So.put(asked, k, want), ready, td, clock), Cons(MeshTask(k, want, task), out), left, w, room - 1)
              end end end
          end
        end
    end
  end

  pfn append(a : List(GenRes), b : List(GenRes)) : List(GenRes) do
    match a do
      Nil -> b
      Cons(h, t) -> Cons(h, append(t, b))
    end
  end

  pfn prepend(ks : List(Strata.Coord.Key), q : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    match ks do
      Nil -> q
      Cons(k, t) -> prepend(t, Cons(k, q))
    end
  end

  pfn take_todo(m : Meshing) : (Meshing, List(Strata.Coord.Key)) do
    match m do
      Meshing(need, asked, ready, todo, clock) -> (Meshing(need, asked, ready, Nil, clock), todo)
    end
  end

  pfn with_todo(m : Meshing, left : List(Strata.Coord.Key)) : Meshing do
    match m do
      Meshing(need, asked, ready, todo, clock) -> Meshing(need, asked, ready, prepend(left, todo), clock)
    end
  end

  -- Drop from the queue any key a running task is already generating, so it
  -- is not started twice. The running keys are gathered into a store once,
  -- so each queued key costs one lookup, not a walk of every task's batch.
  pfn running_keys(ts : List(GenTask), acc : Strata.Store.Store(Bool)) : Strata.Store.Store(Bool) do
    match ts do
      Nil -> acc
      Cons(GenTask(ks, _, _), t) -> running_keys(t, List.fold_left(ks, acc, fn (a, kv) -> match kv do (k, _) -> So.put(a, k, true) end))
    end
  end
  pfn running(ts : List(GenTask), k : Strata.Coord.Key) : Bool do
    match ts do
      Nil -> false
      Cons(GenTask(ks, _, _), t) -> if in_batch(ks, k) do true else running(t, k) end
    end
  end
  pfn in_batch(ks : List((Strata.Coord.Key, Int)), k : Strata.Coord.Key) : Bool do
    match ks do
      Nil -> false
      Cons((k2, _), t) -> if Ko.key_eq(k2, k) do true else in_batch(t, k) end
    end
  end
  pfn skip_running(q : List(Strata.Coord.Key), ts : List(GenTask)) : List(Strata.Coord.Key) do
    match ts do
      Nil -> q
      _ ->
        let run = running_keys(ts, So.empty(false))
        List.filter(q, fn k -> !So.has(run, k))
    end
  end

  -- the region files tasks read, kept for the store to take, and decoded
  -- regions put where the next dispatch finds them
  pfn with_reads(lg : ChunkLog, reads : List(Strata.Regions.Loaded)) : ChunkLog do
    match reads do
      Nil -> lg
      _ ->
        match lg.sl_source do
          None -> lg
          Some(sr) -> { lg with sl_source: Some(List.fold_left(reads, sr, fn (acc, rd) -> Rs.with_loaded(acc, rd))), sl_regions: List.append(reads, lg.sl_regions) }
        end
    end
  end

  doc "The stream with a store's saved regions for its generation to consult (`Strata.Save.region_source`): a level-0 chunk the store holds takes the generated one's place, and saved queued edits are applied, on the workers. A region not yet decoded is read by the one task that first needs it; other keys of that region wait for a later dispatch. Give it right after `Strata.Save.open`, before the first `tick`; `Strata.Save.tick` renews it each frame. A stream never given one reads no file and behaves as it always did."
  fn with_store(s : Stream, regions : Strata.Regions.RegionSource) : Stream do
    match s do
      Stream(w, c, fs, q, got, gts, mts, m, gone, gts2, mts2, rd) -> Stream(w, c, fs, q, got, gts, mts, m, { gone with sl_source: Some(regions) }, gts2, mts2, rd)
    end
  end

  doc "The region files generation tasks have read since the last take (decoded, damaged or missing), for `Strata.Save.adopt_regions`."
  fn take_regions(s : Stream) : (Stream, List(Strata.Regions.Loaded)) do
    match s do
      Stream(w, c, fs, q, got, gts, mts, m, gone, gts2, mts2, rd) -> (Stream(w, c, fs, q, got, gts, mts, m, { gone with sl_regions: Nil }, gts2, mts2, rd), gone.sl_regions)
    end
  end

  doc "One step: collect the work started two ticks ago, apply generated chunks within the budget (stale coarse chunks among them), start the next batch of generation and meshing."
  fn tick(s : Stream) : Stream do
    match s do
      Stream(w, c, fs, q, got, gts, mts, m, gone, gts_new, mts_new, Redo(rst, rn)) ->
        -- polling, the work not yet done is kept (still_g, still_m) and counts against this tick's workers; waiting, there is none
        let (gotten, still_g) = if polls(c) do poll_gens(gts, Got(Nil, Nil, Nil), Nil) else (await_gens(gts, Got(Nil, Nil, Nil)), Nil) end
        match gotten do
          Got(gens, failed, reads) ->
            let (m1, still_m) = if polls(c) do poll_meshes(mts, m, Nil) else (await_meshes(mts, m), Nil) end
            match apply_gens(Applied(w, m1, Nil, rst, Nil, with_reads(gone, reads)), append(got, gens), budget(c), c, fs) do
              Applied(w1, m2, waiting, rst2, again, gone2) ->
                match start_stale(w1, c, fs, Redo(rst2, rn), prepend(again, prepend(failed, q))) do
                  (w2, rd2, q1) ->
                    let rs2 = match rd2 do Redo(st, _) -> st end
                    match send_gens(skip_running(q1, List.append(still_g, gts_new)), Nil, w2, c, fs, waiting, nonneg(nworkers(c) - List.length(still_g)), rs2, Loading(gone2.sl_source, List.append(still_g, gts_new)), Nil) do
                      Handed(q2, gts2) ->
                        match take_todo(m2) do
                          (m3, todo) ->
                            match send_meshes(todo, So.empty(false), m3, Nil, Nil, w2, nonneg(nworkers(c) - List.length(still_m))) do
                              -- what was started last tick is collected next tick; what starts now, the tick after
                              Asked(m4, mts2, left) -> Stream(w2, c, fs, q2, waiting, List.append(still_g, gts_new), List.append(still_m, mts_new), with_todo(m4, left), gone2, gts2, mts2, rd2)
                            end
                        end
                    end
                end
            end
        end
    end
  end

  doc "Is there nothing left to do: no chunk wanted and missing, no task running, nothing waiting to be applied or looked at?"
  fn settled(s : Stream) : Bool do
    match s do
      Stream(_, _, _, q, got, gts, mts, Meshing(_, _, _, todo, _), _, gts2, mts2, _) ->
        count(q, 0) == 0 && count(got, 0) == 0 && count(gts, 0) == 0 && count(mts, 0) == 0 && count(todo, 0) == 0 && count(gts2, 0) == 0 && count(mts2, 0) == 0
    end
  end

  doc "What is outstanding, as (wanted chunks not yet requested, chunks being generated, meshes being built, generated chunks waiting for budget)."
  fn pending(s : Stream) : (Int, Int, Int, Int) do
    match s do
      Stream(_, _, _, q, got, gts, mts, _, _, gts2, mts2, _) -> (count(q, 0), count(gts, 0) + count(gts2, 0), count(mts, 0) + count(mts2, 0), count(got, 0))
    end
  end

  doc "Tick until settled or [max_ticks] ticks have passed. For tests and tools; a game calls `tick` once a frame."
  fn run_until_settled(s : Stream, max_ticks : Int) : Stream do
    if max_ticks <= 0 do s
    else
      let s2 = tick(s)
      if settled(s2) do s2 else run_until_settled(s2, max_ticks - 1) end
    end
  end

  doc "Meshes finished since the last take, at most one (the newest) per chunk, of every level (`Strata.Mesh.level` is its key's). The renderer uploads them."
  fn take_meshes(s : Stream) : (Stream, List((Strata.Coord.Key, Strata.Mesh.Meshed))) do
    match s do
      Stream(w, c, fs, q, got, gts, mts, Meshing(need, asked, ready, todo, clock), gone, gts2, mts2, rd) ->
        let out = So.fold(ready, Nil, fn (acc, k, mesh) -> Cons((k, mesh), acc))
        (Stream(w, c, fs, q, got, gts, mts, Meshing(need, asked, So.empty(no_mesh(w)), todo, clock), gone, gts2, mts2, rd), out)
    end
  end

  doc "Chunks unloaded since the last take. The renderer frees their meshes."
  fn take_unloads(s : Stream) : (Stream, List(Strata.Coord.Key)) do
    match s do
      Stream(w, c, fs, q, got, gts, mts, m, gone, gts2, mts2, rd) -> (Stream(w, c, fs, q, got, gts, mts, m, { gone with sl_unloads: Nil }, gts2, mts2, rd), gone.sl_unloads)
    end
  end

  doc "Chunks loaded or edited, and chunks unloaded, since the last take: each chunk once, in one list or the other. Apart from `take_meshes` and `take_unloads`, which the renderer empties; Strata.Entities reads this to keep its copy of the blocks. Nothing is recorded until the first take, which lists every chunk loaded then (and nothing unloaded); from then on each take lists what happened since the one before. A stream nobody takes from records nothing; once taken from, the log stays on for the stream's life, so a game that stops calling this (it closed its entities) keeps growing the unloaded set: go on calling it, or drop the stream."
  fn take_changed(s : Stream) : (Stream, List(Strata.Coord.Key), List(Strata.Coord.Key)) do
    match s do
      Stream(w, c, fs, q, got, gts, mts, m, gone, gts2, mts2, rd) ->
        let lg = { gone with sl_on: true, sl_changed: So.empty(false), sl_dropped: So.empty(false) }
        let changed = if gone.sl_on do So.keys(gone.sl_changed) else So.keys(Wo.chunks(w)) end
        (Stream(w, c, fs, q, got, gts, mts, m, lg, gts2, mts2, rd), changed, So.keys(gone.sl_dropped))
    end
  end

  doc "How many chunk keys `take_changed` holds for its next take, loaded or edited and unloaded together; 0 before the first take. For tests."
  fn changed_pending(s : Stream) : Int do
    match s do
      Stream(_, _, _, _, _, _, _, _, gone, _, _, _) -> So.size(gone.sl_changed) + So.size(gone.sl_dropped)
    end
  end

  pfn mix(h : Int) : Int do
    let a = int_and(h, 4294967295)
    let b = int_and(int_wrapping_mul(int_xor(a, a / 65536), 2246822519), 4294967295)
    int_xor(b, b / 8192)
  end

  doc "A hash of every loaded chunk and where it is; the same whatever order the chunks arrived in."
  fn world_hash(s : Stream) : Int do
    So.fold(Wo.chunks(world(s)), 0, fn (acc, k, c) -> (acc + mix(Ko.key_hash(k) + Strata.Chunk.hash(c) % 1000003) * 31 + 7) % 2305843009213693951)
  end
end
