mod Strata.Occupancy do

  -- Occupancy — one bit per voxel of a chunk, set where the block is solid and
  -- opaque. 32768 bits in 4096 bytes; bit Coord.index(x, y, z) is bit (i % 8)
  -- of byte (i / 8). The mesher's corner shading and the ray-traced lighting
  -- both read this, and the renderer uploads it as it is.
  pfn bit_value(k : Int) : Int do
    if k == 0 do
      1
    else
      if k == 1 do
        2
      else
        if k == 2 do
          4
        else
          if k == 3 do
            8
          else
            if k == 4 do
              16
            else
              if k == 5 do 32 else if k == 6 do 64 else 128 end end
            end
          end
        end
      end
    end
  end

  pfn fill_go(o : NativeU8Arr, r : Strata.Blocks.Registry, c : Strata.Chunk.Chunk, i : Int) : NativeU8Arr do
    if i < 0 || i >= 32768 do
      o
    else
      if Strata.Blocks.is_solid_opaque(r, Strata.Chunk.get_idx(c, i)) do
        fill_go(NativeArray.set_u8(o, i / 8, NativeArray.get_u8(o, i / 8) + bit_value(i % 8)), r, c, i + 1)
      else
        fill_go(o, r, c, i + 1)
      end
    end
  end

  doc """The chunk's occupancy mask: 4096 bytes."""
  fn of_chunk(r : Strata.Blocks.Registry, c : Strata.Chunk.Chunk) : NativeU8Arr do
    let u = Strata.Chunk.uniform_id(c)
    if u >= 0 do
      NativeArray.make_u8(4096, if Strata.Blocks.is_solid_opaque(r, u) do 255 else 0 end)
    else
      fill_go(NativeArray.make_u8(4096, 0), r, c, 0)
    end
  end

  doc """Is local voxel (x, y, z) solid and opaque? False outside the chunk or for a mask of the wrong size."""
  fn bit(o : NativeU8Arr, x : Int, y : Int, z : Int) : Bool do
    if x < 0 || x > 31 || y < 0 || y > 31 || z < 0 || z > 31 || NativeArray.length_u8(o) < 4096 do
      false
    else
      do
        let i = x + 32 * (z + 32 * y)
        int_and(NativeArray.get_u8(o, i / 8), bit_value(i % 8)) != 0
      end
    end
  end

  pfn count_go(o : NativeU8Arr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do
      acc
    else
      count_go(o, i + 1, n, acc + int_popcount(NativeArray.get_u8(o, i)))
    end
  end

  doc """How many voxels are set."""
  fn count(o : NativeU8Arr) : Int do
    count_go(o, 0, NativeArray.length_u8(o), 0)
  end

end
