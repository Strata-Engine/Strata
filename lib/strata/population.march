-- Population — what a world holds, declared by the game and placed by the
-- engine. A game builds a `Pop` at start-up from four kinds of declaration,
-- each kind its own namespace of names:
--
--   fields  a number per ground column: one the game supplies in a slot
--           (built-ins 0..9, its own 10..31), a noise, another field through a curve, or the
--           cover of a layer (how much of it stands near the column);
--   zones   yes or no for a column: region ids, a band of a field, a ring
--           around sites, and all, any and not of other zones;
--   shapes  the things placed: block ids, or templates, a variant each;
--   layers  what is placed, by which placer (cover, scatter, site), under
--           which rule.
--
-- A rule is data: a base density per square metre times a curve of each of
-- some fields, passing only inside some zones and outside others.
--
-- `freeze` checks the declarations and compiles them into a `Frozen`: every
-- name resolved to a small index into lists held in declaration order, so
-- nothing is looked up by name per column. Layers run in declaration order,
-- except that a layer is moved after every layer whose cover its rule reads
-- (through curve fields and zones too); a layer is placed at the first
-- point where all it reads has run. The first mistake found is returned as
-- an `Err` naming the offender. Nothing here places anything.
mod Strata.Population do

  -- points (x, factor), sorted by x; piecewise linear, flat beyond the ends
  opaque type PopCurve = PopCurve(List((Float, Float)))
  -- metres: centre x and z, the floor height, the radius; the site's index
  opaque type PopSite = PopSite(Float, Float, Float, Float, Int)
  -- base density per square metre; (field, curve) factors; zones to be inside; zones to be outside
  opaque type PopRule = PopRule(Float, List((String, PopCurve)), List(String), List(String))

  -- declarations as given, by name
  opaque type PopFieldDecl = PdGround(String, Int) | PdNoise(String, Int, Int, Float, Int) | PdCurve(String, String, PopCurve) | PdCover(String, String, Float)
  opaque type PopZoneDecl = PdRegions(String, List(Int)) | PdBand(String, String, Float, Float) | PdRing(String, List(PopSite), Float, Float) | PdAll(String, List(String)) | PdAny(String, List(String)) | PdNot(String, String)
  opaque type PopShapesDecl = PdBlocks(String, List(Int)) | PdTemplates(String, List(Strata.Template.Template))
  -- shape set, zone, a weight per variant
  opaque type PopWeightsDecl = PdWeights(String, String, List(Float))
  opaque type PopLayerDecl = PdLayerCover(String, String, PopRule, Int) | PdLayerScatter(String, String, PopRule, Float, Float, Int) | PdLayerSite(String, String, List(PopSite), Float, Int)

  -- each list newest first; freeze reverses them
  -- pp_seen: (layer, level) from seen_to; pp_ranks: (shape set, rank) from ranks; pp_on: (layer, block ids) from cover_on; pp_between: (layer, lo, hi) from cover_between
  ptype PopData = { pp_fields : List(PopFieldDecl), pp_zones : List(PopZoneDecl), pp_shapes : List(PopShapesDecl), pp_weights : List(PopWeightsDecl), pp_layers : List(PopLayerDecl), pp_seen : List((String, Int)), pp_ranks : List((String, NativeIntArr)), pp_on : List((String, List(Int))), pp_between : List((String, Float, Float)) }
  opaque type Pop = Pop(PopData)
  pfn popd(p : Pop) : PopData do match p do Pop(d) -> d end end

  -- compiled: a field index is into fz_fields, a zone index into fz_zones,
  -- a shape set index into fz_shapes, a layer index into fz_layers (run order)
  -- PfGround slot; PfNoise kind, octaves, period (m), salt; PfCurve source field; PfCover layer, radius (m)
  opaque type PopField = PfGround(Int) | PfNoise(Int, Int, Float, Int) | PfCurve(Int, PopCurve) | PfCover(Int, Float)
  opaque type PopZone = PfRegions(List(Int)) | PfBand(Int, Float, Float) | PfRing(List(PopSite), Float, Float) | PfAll(List(Int)) | PfAny(List(Int)) | PfNot(Int)
  -- the variants, and (zone, a weight per variant) in declaration order
  opaque type PopShapes = PfBlocks(List(Int), List((Int, List(Float)))) | PfTemplates(List(Strata.Template.Template), List((Int, List(Float))))
  opaque type PopFrozenRule = PfRule(Float, List((Int, PopCurve)), List(Int), List(Int))
  -- shape set first; cover: rule, salt; scatter: rule, cell (m), jitter, salt; site: sites, margin (m), salt
  opaque type PopLayer = PfLayerCover(Int, PopFrozenRule, Int) | PfLayerScatter(Int, PopFrozenRule, Float, Float, Int) | PfLayerSite(Int, List(PopSite), Float, Int)

  -- fz_seen: each layer's declared seen_to level (run order), -1 for the default; fz_ranks: each shape set's rank array, empty for the default; fz_on: each layer's cover_on block ids (run order), empty for any block; fz_between: each layer's cover_between heights, (-inf, inf) for any
  ptype FrozenData = { fz_field_names : List(String), fz_fields : List(PopField), fz_zone_names : List(String), fz_zones : List(PopZone), fz_shape_names : List(String), fz_shapes : List(PopShapes), fz_layer_names : List(String), fz_layers : List(PopLayer), fz_ground : List(Int), fz_seen : List(Int), fz_ranks : List(NativeIntArr), fz_on : List(List(Int)), fz_between : List((Float, Float)) }
  opaque type Frozen = Frozen(FrozenData)
  pfn fd(f : Frozen) : FrozenData do match f do Frozen(d) -> d end end
  pfn fz_field_names_of(f : Frozen) : List(String) do
    let d = fd(f)
    d.fz_field_names
  end
  pfn fz_fields_of(f : Frozen) : List(PopField) do
    let d = fd(f)
    d.fz_fields
  end
  pfn fz_zone_names_of(f : Frozen) : List(String) do
    let d = fd(f)
    d.fz_zone_names
  end
  pfn fz_zones_of(f : Frozen) : List(PopZone) do
    let d = fd(f)
    d.fz_zones
  end
  pfn fz_shape_names_of(f : Frozen) : List(String) do
    let d = fd(f)
    d.fz_shape_names
  end
  pfn fz_shapes_of(f : Frozen) : List(PopShapes) do
    let d = fd(f)
    d.fz_shapes
  end
  pfn fz_layer_names_of(f : Frozen) : List(String) do
    let d = fd(f)
    d.fz_layer_names
  end
  pfn fz_layers_of(f : Frozen) : List(PopLayer) do
    let d = fd(f)
    d.fz_layers
  end
  pfn fz_ground_of(f : Frozen) : List(Int) do
    let d = fd(f)
    d.fz_ground
  end
  pfn fz_seen_of(f : Frozen) : List(Int) do
    let d = fd(f)
    d.fz_seen
  end
  pfn fz_ranks_of(f : Frozen) : List(NativeIntArr) do
    let d = fd(f)
    d.fz_ranks
  end
  pfn fz_on_of(f : Frozen) : List(List(Int)) do
    let d = fd(f)
    d.fz_on
  end
  pfn fz_between_of(f : Frozen) : List((Float, Float)) do
    let d = fd(f)
    d.fz_between
  end

  -- Building

  doc "A population with nothing declared."
  fn new() : Pop do Pop({ pp_fields: Nil, pp_zones: Nil, pp_shapes: Nil, pp_weights: Nil, pp_layers: Nil, pp_seen: Nil, pp_ranks: Nil, pp_on: Nil, pp_between: Nil }) end

  pfn add_field(p : Pop, d : PopFieldDecl) : Pop do
    let q = popd(p)
    Pop({ q with pp_fields: Cons(d, q.pp_fields) })
  end
  pfn add_zone(p : Pop, d : PopZoneDecl) : Pop do
    let q = popd(p)
    Pop({ q with pp_zones: Cons(d, q.pp_zones) })
  end
  pfn add_shapes(p : Pop, d : PopShapesDecl) : Pop do
    let q = popd(p)
    Pop({ q with pp_shapes: Cons(d, q.pp_shapes) })
  end
  pfn add_layer(p : Pop, d : PopLayerDecl) : Pop do
    let q = popd(p)
    Pop({ q with pp_layers: Cons(d, q.pp_layers) })
  end

  doc "A field the game supplies in its Ground, in slot 0..31. Slots 0..9 are the built-ins: 0 altitude (m), 1 slope (rise over run), 2 water depth (m), 3 river distance (m), 4 lake distance (m), 5 coast distance (m), 6 wetness (unit), 7 region (id), 8 depth below the top surface (m), 9 open sky (0 or 1). Slots 10..31 are the game's own: the library gives them no meaning, and the game names them as it declares them. freeze refuses another slot."
  fn field_ground(p : Pop, name : String, slot : Int) : Pop do add_field(p, PdGround(name, slot)) end

  doc "A noise field: noise kind, octaves, period in metres and a seed salt."
  fn field_noise(p : Pop, name : String, kind : Int, octaves : Int, period : Float, salt : Int) : Pop do add_field(p, PdNoise(name, kind, octaves, period, salt)) end

  doc "The field named `of` through curve c."
  fn field_curve(p : Pop, name : String, of : String, c : PopCurve) : Pop do add_field(p, PdCurve(name, of, c)) end

  doc "How many of the layer's instances stand within radius metres of a column, over the layer's densest packing, clamped to 0..1. A layer whose rule reads it runs after that layer."
  fn field_cover(p : Pop, name : String, layer : String, radius : Float) : Pop do add_field(p, PdCover(name, layer, radius)) end

  doc "A curve through points (x, factor), taken in order of x by a stable sort: piecewise linear between them, flat beyond the first and the last. Points at one x keep the order given and make a step: below it the curve approaches the first, at and above it reads the last. freeze refuses a curve with no points."
  fn curve(points : List((Float, Float))) : PopCurve do PopCurve(List.sort_by(points, x_before)) end

  pfn x_before(a : (Float, Float), b : (Float, Float)) : Bool do
    match a do (ax, _) -> match b do (bx, _) -> ax <= bx end end
  end

  pfn curve_walk(pts : List((Float, Float)), x : Float) : Float do
    match pts do
      Nil -> 0.0
      Cons((x0, y0), rest) ->
        if x < x0 do y0
        else
          match rest do
            Nil -> y0
            Cons((x1, y1), _) -> if x < x1 do y0 +. (y1 -. y0) *. (x -. x0) /. (x1 -. x0) else curve_walk(rest, x) end
          end
        end
    end
  end

  doc "The curve's value at x; 0 for a curve with no points."
  fn curve_at(c : PopCurve, x : Float) : Float do match c do PopCurve(pts) -> curve_walk(pts, x) end end

  pfn curve_empty(c : PopCurve) : Bool do match c do PopCurve(pts) -> List.is_empty(pts) end end

  doc "A zone: the columns whose region id (built-in slot 7) is one of ids."
  fn zone_regions(p : Pop, name : String, ids : List(Int)) : Pop do add_zone(p, PdRegions(name, ids)) end

  doc "A zone: the columns where lo <= field < hi."
  fn zone_band(p : Pop, name : String, field : String, lo : Float, hi : Float) : Pop do add_zone(p, PdBand(name, field, lo, hi)) end

  doc "A zone: the columns within inner..outer metres of some site's centre."
  fn zone_ring(p : Pop, name : String, sites : List(PopSite), inner : Float, outer : Float) : Pop do add_zone(p, PdRing(name, sites, inner, outer)) end

  doc "A zone: the columns inside every zone of `of`."
  fn zone_all(p : Pop, name : String, of : List(String)) : Pop do add_zone(p, PdAll(name, of)) end

  doc "A zone: the columns inside some zone of `of`."
  fn zone_any(p : Pop, name : String, of : List(String)) : Pop do add_zone(p, PdAny(name, of)) end

  doc "A zone: the columns outside the zone `of`."
  fn zone_not(p : Pop, name : String, of : String) : Pop do add_zone(p, PdNot(name, of)) end

  doc "A rule: density per square metre is base times curve(field) for each (field, curve) of curves; it passes only inside every zone of inside and outside every zone of outside."
  fn rule(base : Float, curves : List((String, PopCurve)), inside : List(String), outside : List(String)) : PopRule do PopRule(base, curves, inside, outside) end

  doc "A site: centre (xm, zm) and floor height in metres, radius in metres, and the game's index for it."
  fn site(xm : Float, zm : Float, floor : Float, radius : Float, index : Int) : PopSite do PopSite(xm, zm, floor, radius, index) end

  doc "A shape set of one-voxel things: a variant per block id."
  fn shapes_blocks(p : Pop, name : String, ids : List(Int)) : Pop do add_shapes(p, PdBlocks(name, ids)) end

  doc "A shape set of templates: a variant per template."
  fn shapes_templates(p : Pop, name : String, ts : List(Strata.Template.Template)) : Pop do add_shapes(p, PdTemplates(name, ts)) end

  doc "Inside zone, the shape set's variants are weighted by w, one weight per variant; where no weights apply its variants are equally likely."
  fn weights(p : Pop, shapes : String, zone : String, w : List(Float)) : Pop do
    let q = popd(p)
    Pop({ q with pp_weights: Cons(PdWeights(shapes, zone, w), q.pp_weights) })
  end

  doc "A cover layer: per surface, the rule's density picks whether it holds one of the shape set's blocks; hashed with salt."
  fn layer_cover(p : Pop, name : String, shapes : String, r : PopRule, salt : Int) : Pop do add_layer(p, PdLayerCover(name, shapes, r, salt)) end

  doc "A scatter layer: hashed cells `cell` metres on a side, at most one instance a cell, offset by up to jitter / 2 of a cell (jitter 0..0.6); hashed with salt."
  fn layer_scatter(p : Pop, name : String, shapes : String, r : PopRule, cell : Float, jitter : Float, salt : Int) : Pop do add_layer(p, PdLayerScatter(name, shapes, r, cell, jitter, salt)) end

  doc "A site layer: one instance at each site, the ground drawn up to it for margin metres around; hashed with salt."
  fn layer_site(p : Pop, name : String, shapes : String, sites : List(PopSite), margin : Float, salt : Int) : Pop do add_layer(p, PdLayerSite(name, shapes, sites, margin, salt)) end

  doc "The coarsest level the layer named layer is placed at, 0..16 (a level-L chunk's voxels are 2^L of level 0's). Without it a scatter or site layer of templates is placed down to the coarsest level at which its widest variant is still at least two coarse voxels across (seen_level), and a block layer (a cover layer, or any layer whose shape set holds blocks) at level 0 only; a block layer may not be given a level above 0. At most one per layer."
  fn seen_to(p : Pop, layer : String, level : Int) : Pop do
    let q = popd(p)
    Pop({ q with pp_seen: Cons((layer, level), q.pp_seen) })
  end

  doc "How a shape set of templates is coarsened at coarser levels: rank[id] is id's rank, and each coarse voxel takes the id of highest rank among the fine voxels its cube holds (Strata.Template.coarsen; an id past the array's end ranks 0, a tie goes to the higher id, any id beats a hole). Without it every id is ranked by itself. Ranks must be 0 or more; at most one per shape set; not for a set of blocks."
  fn ranks(p : Pop, shapes : String, rank : NativeIntArr) : Pop do
    let q = popd(p)
    Pop({ q with pp_ranks: Cons((shapes, rank), q.pp_ranks) })
  end

  doc "The block ids the cover layer named layer places on: a floor holds one of its blocks only where the floor's own voxel holds one of ids (a floor below the chunk, whose voxel the chunk does not hold, holds none). Without it a cover layer places on any floor. ids not empty, each 0..65535; at most one per layer; a cover layer only."
  fn cover_on(p : Pop, layer : String, ids : List(Int)) : Pop do
    let q = popd(p)
    Pop({ q with pp_on: Cons((layer, ids), q.pp_on) })
  end

  doc "The heights the cover layer named layer places on: a floor whose height in metres (its voxel's bottom, its world voxel y times the voxel size) is above lo and at most hi. Without it a cover layer places at any height. lo and hi numbers (either may be infinite), lo below hi; at most one per layer; a cover layer only."
  fn cover_between(p : Pop, layer : String, lo : Float, hi : Float) : Pop do
    let q = popd(p)
    Pop({ q with pp_between: Cons((layer, lo, hi), q.pp_between) })
  end

  -- Names and lookups

  pfn field_name(d : PopFieldDecl) : String do
    match d do
      PdGround(n, _) -> n
      PdNoise(n, _, _, _, _) -> n
      PdCurve(n, _, _) -> n
      PdCover(n, _, _) -> n
    end
  end
  pfn zone_name(d : PopZoneDecl) : String do
    match d do
      PdRegions(n, _) -> n
      PdBand(n, _, _, _) -> n
      PdRing(n, _, _, _) -> n
      PdAll(n, _) -> n
      PdAny(n, _) -> n
      PdNot(n, _) -> n
    end
  end
  pfn shapes_name(d : PopShapesDecl) : String do
    match d do
      PdBlocks(n, _) -> n
      PdTemplates(n, _) -> n
    end
  end
  pfn variant_count(d : PopShapesDecl) : Int do
    match d do
      PdBlocks(_, ids) -> List.length(ids)
      PdTemplates(_, ts) -> List.length(ts)
    end
  end
  pfn layer_name(d : PopLayerDecl) : String do
    match d do
      PdLayerCover(n, _, _, _) -> n
      PdLayerScatter(n, _, _, _, _, _) -> n
      PdLayerSite(n, _, _, _, _) -> n
    end
  end
  pfn layer_shapes(d : PopLayerDecl) : String do
    match d do
      PdLayerCover(_, s, _, _) -> s
      PdLayerScatter(_, s, _, _, _, _) -> s
      PdLayerSite(_, s, _, _, _) -> s
    end
  end
  pfn layer_rule(d : PopLayerDecl) : Option(PopRule) do
    match d do
      PdLayerCover(_, _, r, _) -> Some(r)
      PdLayerScatter(_, _, r, _, _, _) -> Some(r)
      PdLayerSite(_, _, _, _, _) -> None
    end
  end
  pfn rule_fields(r : PopRule) : List(String) do match r do PopRule(_, cs, _, _) -> List.map(cs, curve_field) end end
  pfn rule_zones(r : PopRule) : List(String) do match r do PopRule(_, _, ins, outs) -> List.append(ins, outs) end end
  pfn curve_field(fc : (String, PopCurve)) : String do match fc do (n, _) -> n end end

  pfn has_name(xs : List(String), n : String) : Bool do List.any(xs, fn x -> x == n) end

  pfn index_go(xs : List(String), n : String, i : Int) : Int do
    match xs do
      Nil -> -1
      Cons(x, rest) -> if x == n do i else index_go(rest, n, i + 1) end
    end
  end
  -- the position of n in xs, or -1
  pfn index_of(xs : List(String), n : String) : Int do index_go(xs, n, 0) end

  pfn find_field(fs : List(PopFieldDecl), n : String) : Option(PopFieldDecl) do List.find(fs, fn d -> field_name(d) == n) end
  pfn find_zone(zs : List(PopZoneDecl), n : String) : Option(PopZoneDecl) do List.find(zs, fn d -> zone_name(d) == n) end
  pfn find_layer(ls : List(PopLayerDecl), n : String) : Option(PopLayerDecl) do List.find(ls, fn d -> layer_name(d) == n) end

  -- the zones a zone is made of
  pfn zone_children(d : PopZoneDecl) : List(String) do
    match d do
      PdAll(_, of) -> of
      PdAny(_, of) -> of
      PdNot(_, of) -> Cons(of, Nil)
      _ -> Nil
    end
  end

  -- Checks: each the first mistake it finds, or None

  pfn first_some(xs : List(a), f : a -> Option(String)) : Option(String) do
    match xs do
      Nil -> None
      Cons(x, rest) ->
        match f(x) do
          Some(e) -> Some(e)
          None -> first_some(rest, f)
        end
    end
  end
  pfn first_of(checks : List(Option(String))) : Option(String) do first_some(checks, fn c -> c) end

  pfn q(n : String) : String do "'" ++ n ++ "'" end
  -- every mistake ends with its subject, `about(kind, names)`: the kind of
  -- declaration at fault (field, zone, shapes, weights, layer, or the
  -- seen_to or ranks call) and its name (a shape set and a zone for weights;
  -- the layer for seen_to, the shape set for ranks), read back by freeze_subject
  pfn about(kind : String, names : List(String)) : String do subject_mark() ++ kind ++ "\t" ++ string_join(names, "\t") end
  pfn subject_mark() : String do "\n  about: " end
  pfn about1(kind : String, n : String) : String do about(kind, Cons(n, Nil)) end
  pfn fail(subj : String, msg : String) : Option(String) do Some("population: " ++ msg ++ subj) end
  pfn fail_if(bad : Bool, subj : String, msg : String) : Option(String) do if bad do fail(subj, msg) else None end end
  -- not a number, or a number not above 0 (NaN compares false with everything)
  pfn not_positive(v : Float) : Bool do if v > 0.0 do false else true end end
  -- the first of names not in known, as a mistake of `who`
  pfn undeclared(who : String, subj : String, kind : String, names : List(String), known : List(String)) : Option(String) do
    first_some(names, fn n -> fail_if(!has_name(known, n), subj, who ++ " names undeclared " ++ kind ++ " " ++ q(n)))
  end

  pfn dup_go(kind : String, sk : String, names : List(String), seen : List(String)) : Option(String) do
    match names do
      Nil -> None
      Cons(n, rest) -> if has_name(seen, n) do fail(about1(sk, n), "two " ++ kind ++ "s named " ++ q(n)) else dup_go(kind, sk, rest, Cons(n, seen)) end
    end
  end
  -- sk: the subject's kind
  pfn duplicate(kind : String, sk : String, names : List(String)) : Option(String) do dup_go(kind, sk, names, Nil) end

  pfn check_field(fnames : List(String), lnames : List(String), d : PopFieldDecl) : Option(String) do
    let s = about1("field", field_name(d))
    match d do
      PdGround(n, slot) -> fail_if(if slot < 0 do true else slot > 31 end, s, "field " ++ q(n) ++ " reads ground slot " ++ int_to_string(slot) ++ ", outside 0..31")
      PdNoise(n, k, o, per, _) ->
        first_of([
          fail_if(not_positive(per), s, "field " ++ q(n) ++ " has a noise period of " ++ float_to_string(per) ++ " m; it must be above 0"),
          fail_if(if k < 0 do true else k > 3 end, s, "field " ++ q(n) ++ " has noise kind " ++ int_to_string(k) ++ "; it must be 0..3"),
          fail_if(if o < 1 do true else o > 16 end, s, "field " ++ q(n) ++ " has " ++ int_to_string(o) ++ " octaves; it must be 1..16")])
      PdCurve(n, of, c) -> first_of([undeclared("field " ++ q(n), s, "field", Cons(of, Nil), fnames), fail_if(curve_empty(c), s, "field " ++ q(n) ++ " has a curve with no points")])
      PdCover(n, l, r) -> first_of([undeclared("field " ++ q(n), s, "layer", Cons(l, Nil), lnames), fail_if(!radius_ok(r), s, "field " ++ q(n) ++ " has a cover radius of " ++ float_to_string(r) ++ "; it must be a number of metres above 0 and finite")])
    end
  end

  -- a cover field of a scatter layer divides its count by pi r^2 / cell^2 (Strata.Populate): that must be above 0 and finite, which a tiny or huge radius against the cell can break (underflow to 0, overflow to infinity)
  pfn check_cover_norm(ls : List(PopLayerDecl), d : PopFieldDecl) : Option(String) do
    match d do
      PdCover(n, l, r) ->
        match find_layer(ls, l) do
          Some(PdLayerScatter(_, _, _, cell, _, _)) ->
            let norm = Math.pi() *. r *. r /. (cell *. cell)
            fail_if(!radius_ok(norm), about1("field", n), "field " ++ q(n) ++ " counts layer " ++ q(l) ++ "'s instances within " ++ float_to_string(r) ++ " m over pi * radius^2 / cell^2 = " ++ float_to_string(norm) ++ "; that must be a number above 0 and finite, so the radius is too small or too large for a cell of " ++ float_to_string(cell) ++ " m")
          _ -> None
        end
      _ -> None
    end
  end
  -- a cover radius: above 0 and finite, written so NaN fails (Strata.Populate divides by it and turns radius / scale into a column count)
  pfn radius_ok(r : Float) : Bool do if r > 0.0 do r < float_infinity() else false end end
  -- a site layer hashes its sites' indices (Strata.Seed.cell adds to them), so they are kept far from either end of Int
  pfn index_far(i : Int) : Bool do if i > 1099511627776 do true else i < 0 - 1099511627776 end end

  -- 0 or more and finite: written so NaN fails (every comparison with it is false)
  pfn metres_ok(v : Float) : Bool do if v >= 0.0 do v < float_infinity() else false end end

  pfn check_sites(who : String, subj : String, sites : List(PopSite)) : Option(String) do
    first_some(sites, fn s -> fail_if(!metres_ok(site_radius(s)), subj, who ++ " has a site radius of " ++ float_to_string(site_radius(s)) ++ "; it must be a number of metres, 0 or more and finite"))
  end

  pfn check_zone(fnames : List(String), znames : List(String), d : PopZoneDecl) : Option(String) do
    let who = "zone " ++ q(zone_name(d))
    let s = about1("zone", zone_name(d))
    match d do
      PdRegions(_, _) -> None
      PdBand(_, f, _, _) -> undeclared(who, s, "field", Cons(f, Nil), fnames)
      PdRing(_, sites, inner, outer) -> first_of([fail_if(if inner < 0.0 do true else outer < 0.0 end, s, who ++ " has a negative radius"), check_sites(who, s, sites)])
      _ -> undeclared(who, s, "zone", zone_children(d), znames)
    end
  end

  -- a block id for which bad holds: 0 is air, and a chunk holds ids up to 65535
  pfn block_ids_where(d : PopShapesDecl, bad : Int -> Bool) : Bool do
    match d do
      PdBlocks(_, ids) -> List.any(ids, bad)
      PdTemplates(_, _) -> false
    end
  end
  pfn check_shapes(d : PopShapesDecl) : Option(String) do
    let s = about1("shapes", shapes_name(d))
    first_of([fail_if(variant_count(d) == 0, s, "shape set " ++ q(shapes_name(d)) ++ " has no variants"),
              fail_if(block_ids_where(d, fn id -> id <= 0), s, "shape set " ++ q(shapes_name(d)) ++ " holds a block id of 0 or below"),
              fail_if(block_ids_where(d, fn id -> id > 65535), s, "shape set " ++ q(shapes_name(d)) ++ " holds a block id above 65535")])
  end
  -- whether the shape set named n is declared and holds templates
  pfn templates_named(ss : List(PopShapesDecl), n : String) : Bool do
    List.any(ss, fn d -> match d do
      PdTemplates(m, _) -> m == n
      PdBlocks(_, _) -> false
    end)
  end

  pfn check_weights(shapes : List(PopShapesDecl), znames : List(String), w : PopWeightsDecl) : Option(String) do
    match w do
      PdWeights(s, z, ws) ->
        let who = "weights of " ++ q(s) ++ " in " ++ q(z)
        let subj = about("weights", [s, z])
        match List.find(shapes, fn d -> shapes_name(d) == s) do
          None -> fail(subj, who ++ " name undeclared shape set " ++ q(s))
          Some(d) ->
            first_of([
              undeclared(who, subj, "zone", Cons(z, Nil), znames),
              fail_if(List.length(ws) != variant_count(d), subj, who ++ " give " ++ int_to_string(List.length(ws)) ++ " weights for " ++ int_to_string(variant_count(d)) ++ " variants"),
              fail_if(List.any(ws, fn v -> if v >= 0.0 do false else true end), subj, who ++ " hold a weight that is negative or not a number"),
              fail_if(not_positive(List.fold_left(ws, 0.0, fn (a, v) -> a +. v)), subj, who ++ " sum to 0")])
        end
    end
  end

  pfn weights_key(w : PopWeightsDecl) : String do match w do PdWeights(s, z, _) -> q(s) ++ " in " ++ q(z) end end
  pfn weights_subject(w : PopWeightsDecl) : String do match w do PdWeights(s, z, _) -> about("weights", [s, z]) end end
  -- a shape set weighted twice in one zone
  pfn duplicate_weights(ws : List(PopWeightsDecl)) : Option(String) do
    first_some(dup_keys(List.map(ws, weights_key), Nil), fn k -> first_some(ws, fn w -> if weights_key(w) == k do fail(weights_subject(w), "two weights of " ++ k) else None end))
  end
  pfn dup_keys(ks : List(String), seen : List(String)) : List(String) do
    match ks do
      Nil -> Nil
      Cons(k, rest) -> if has_name(seen, k) do Cons(k, Nil) else dup_keys(rest, Cons(k, seen)) end
    end
  end

  pfn check_rule(who : String, subj : String, fnames : List(String), znames : List(String), r : PopRule) : Option(String) do
    match r do
      PopRule(base, cs, _, _) ->
        first_of([fail_if(if base >= 0.0 do false else true end, subj, who ++ " has a rule base of " ++ float_to_string(base) ++ "; it must be 0 or more"), undeclared(who, subj, "field", rule_fields(r), fnames), undeclared(who, subj, "zone", rule_zones(r), znames), first_some(cs, fn fc -> empty_curve_of(who, subj, fc))])
    end
  end
  pfn empty_curve_of(who : String, subj : String, fc : (String, PopCurve)) : Option(String) do
    match fc do (f, c) -> fail_if(curve_empty(c), subj, who ++ " has a curve with no points for field " ++ q(f)) end
  end

  -- a scatter cell: finite and at least 1/64 m (NaN fails), so a layer's candidate walk over a chunk stays bounded
  pfn cell_ok(c : Float) : Bool do if c >= 0.015625 do c < float_infinity() else false end end

  pfn check_layer(fnames : List(String), znames : List(String), ss : List(PopShapesDecl), snames : List(String), d : PopLayerDecl) : Option(String) do
    let who = "layer " ++ q(layer_name(d))
    let s = about1("layer", layer_name(d))
    let shapes = undeclared(who, s, "shape set", Cons(layer_shapes(d), Nil), snames)
    match d do
      PdLayerCover(_, sname, r, _) -> first_of([shapes, fail_if(templates_named(ss, sname), s, who ++ " is a cover layer on shape set " ++ q(sname) ++ ", which holds templates; cover places blocks"), check_rule(who, s, fnames, znames, r)])
      PdLayerScatter(_, _, r, cell, jitter, _) ->
        first_of([shapes, check_rule(who, s, fnames, znames, r), fail_if(!cell_ok(cell), s, who ++ " has a cell of " ++ float_to_string(cell) ++ " m; it must be a finite number of metres, at least 1/64"), fail_if(if jitter < 0.0 do true else jitter > 0.6 end, s, who ++ " has a jitter of " ++ float_to_string(jitter) ++ ", outside 0..0.6")])
      PdLayerSite(_, _, sites, margin, _) -> first_of([shapes, fail_if(!metres_ok(margin), s, who ++ " has a margin of " ++ float_to_string(margin) ++ "; it must be a number of metres, 0 or more and finite"), check_sites(who, s, sites), first_some(sites, fn st -> fail_if(index_far(site_index(st)), s, who ++ " has a site index of " ++ int_to_string(site_index(st)) ++ "; it must be within -2^40..2^40"))])
    end
  end

  -- Levels: seen_to and ranks

  -- the layer's shape set holds blocks (or the layer is a cover layer): it is placed at level 0 only
  pfn block_layer(ss : List(PopShapesDecl), d : PopLayerDecl) : Bool do
    match d do
      PdLayerCover(_, _, _, _) -> true
      _ -> !templates_named(ss, layer_shapes(d))
    end
  end
  pfn seen_name(e : (String, Int)) : String do match e do (n, _) -> n end end
  pfn check_seen(ls : List(PopLayerDecl), ss : List(PopShapesDecl), e : (String, Int)) : Option(String) do
    match e do
      (n, lvl) ->
        let who = "seen_to of layer " ++ q(n)
        match find_layer(ls, n) do
          None -> fail(about1("seen_to", n), "seen_to names undeclared layer " ++ q(n))
          Some(d) ->
            first_of([fail_if(if lvl < 0 do true else lvl > 16 end, about1("seen_to", n), who ++ " is level " ++ int_to_string(lvl) ++ "; it must be within 0..16"),
                      fail_if(if lvl > 0 do block_layer(ss, d) else false end, about1("seen_to", n), who ++ " is level " ++ int_to_string(lvl) ++ ", but it places blocks of shape set " ++ q(layer_shapes(d)) ++ ", which are placed at level 0 only")])
        end
    end
  end
  pfn on_name(e : (String, List(Int))) : String do match e do (n, _) -> n end end
  pfn check_on(ls : List(PopLayerDecl), e : (String, List(Int))) : Option(String) do
    match e do
      (n, ids) ->
        let who = "cover_on of layer " ++ q(n)
        match find_layer(ls, n) do
          None -> fail(about1("cover_on", n), "cover_on names undeclared layer " ++ q(n))
          Some(d) ->
            let cover = match d do
                PdLayerCover(_, _, _, _) -> true
                _ -> false
              end
            first_of([fail_if(!cover, about1("cover_on", n), who ++ ", which is not a cover layer; only cover layers place on a floor's block"),
                      fail_if(List.is_empty(ids), about1("cover_on", n), who ++ " names no block id"),
                      fail_if(List.any(ids, fn i -> if i < 0 do true else i > 65535 end), about1("cover_on", n), who ++ " holds a block id outside 0..65535")])
        end
    end
  end
  pfn between_name(e : (String, Float, Float)) : String do match e do (n, _, _) -> n end end
  pfn check_between(ls : List(PopLayerDecl), e : (String, Float, Float)) : Option(String) do
    match e do
      (n, lo, hi) ->
        let who = "cover_between of layer " ++ q(n)
        match find_layer(ls, n) do
          None -> fail(about1("cover_between", n), "cover_between names undeclared layer " ++ q(n))
          Some(d) ->
            let cover = match d do
                PdLayerCover(_, _, _, _) -> true
                _ -> false
              end
            first_of([fail_if(!cover, about1("cover_between", n), who ++ ", which is not a cover layer; only cover layers place on a floor's height"),
                      fail_if(if lo < hi do false else true end, about1("cover_between", n), who ++ " is " ++ float_to_string(lo) ++ " .. " ++ float_to_string(hi) ++ "; lo must be below hi, both numbers")])
        end
    end
  end
  pfn between_of(bs : List((String, Float, Float)), n : String) : (Float, Float) do
    match List.find(bs, fn e -> between_name(e) == n) do
      Some((_, lo, hi)) -> (lo, hi)
      None -> (float_neg_infinity(), float_infinity())
    end
  end
  pfn on_of(ons : List((String, List(Int))), n : String) : List(Int) do
    match List.find(ons, fn e -> on_name(e) == n) do
      Some((_, v)) -> v
      None -> Nil
    end
  end
  pfn rank_name(e : (String, NativeIntArr)) : String do match e do (n, _) -> n end end
  pfn negative_rank(a : NativeIntArr, i : Int, n : Int) : Bool do if i >= n do false else if NativeArray.get_int(a, i) < 0 do true else negative_rank(a, i + 1, n) end end end
  pfn check_ranks(ss : List(PopShapesDecl), e : (String, NativeIntArr)) : Option(String) do
    match e do
      (n, rank) ->
        match List.find(ss, fn d -> shapes_name(d) == n) do
          None -> fail(about1("ranks", n), "ranks names undeclared shape set " ++ q(n))
          Some(d) ->
            first_of([fail_if(!templates_named(ss, n), about1("ranks", n), "ranks of shape set " ++ q(n) ++ ", which holds blocks; only templates are coarsened"),
                      fail_if(negative_rank(rank, 0, NativeArray.length_int(rank)), about1("ranks", n), "ranks of shape set " ++ q(n) ++ " hold a rank below 0")])
        end
    end
  end

  -- Cycles among curve fields and among zones

  -- xs from the first n on
  pfn from_name(xs : List(String), n : String) : List(String) do
    match xs do
      Nil -> Nil
      Cons(x, rest) -> if x == n do xs else from_name(rest, n) end
    end
  end
  -- path (newest first) has reached n again: the loop from n back to n
  pfn loop_text(path : List(String), n : String) : String do
    string_join(List.append(from_name(List.reverse(path), n), Cons(n, Nil)), " -> ")
  end

  pfn field_loop(fs : List(PopFieldDecl), n : String, path : List(String)) : Option(String) do
    if has_name(path, n) do fail(about1("field", n), "fields read each other in a cycle: " ++ loop_text(path, n))
    else
      match find_field(fs, n) do
        Some(PdCurve(_, of, _)) -> field_loop(fs, of, Cons(n, path))
        _ -> None
      end
    end
  end

  pfn zone_loop(zs : List(PopZoneDecl), n : String, path : List(String)) : Option(String) do
    if has_name(path, n) do fail(about1("zone", n), "zones are made of each other in a cycle: " ++ loop_text(path, n))
    else
      match find_zone(zs, n) do
        Some(d) -> first_some(zone_children(d), fn c -> zone_loop(zs, c, Cons(n, path)))
        None -> None
      end
    end
  end

  -- What a rule reaches (declarations checked and free of cycles)

  -- the fields a zone reads, through the zones it is made of
  pfn zone_fields(zs : List(PopZoneDecl), n : String) : List(String) do
    match find_zone(zs, n) do
      Some(PdBand(_, f, _, _)) -> Cons(f, Nil)
      Some(d) -> List.flat_map(zone_children(d), fn c -> zone_fields(zs, c))
      None -> Nil
    end
  end
  -- the layers whose cover a field reads, through curve fields
  pfn field_layers(fs : List(PopFieldDecl), n : String) : List(String) do
    match find_field(fs, n) do
      Some(PdCurve(_, of, _)) -> field_layers(fs, of)
      Some(PdCover(_, l, _)) -> Cons(l, Nil)
      _ -> Nil
    end
  end
  -- the built-in slots a field reads, through curve fields
  pfn field_slots(fs : List(PopFieldDecl), n : String) : List(Int) do
    match find_field(fs, n) do
      Some(PdCurve(_, of, _)) -> field_slots(fs, of)
      Some(PdGround(_, s)) -> Cons(s, Nil)
      _ -> Nil
    end
  end
  -- every field a rule reads directly or through its zones
  pfn rule_reads(zs : List(PopZoneDecl), r : PopRule) : List(String) do
    List.append(rule_fields(r), List.flat_map(rule_zones(r), fn z -> zone_fields(zs, z)))
  end
  -- the zones the weights of shape set s are keyed to
  pfn weights_zones(ws : List(PopWeightsDecl), s : String) : List(String) do
    List.filter_map(ws, fn w -> weights_zone_of(s, w))
  end
  pfn weights_zone_of(s : String, w : PopWeightsDecl) : Option(String) do
    match w do PdWeights(s2, z, _) -> if s2 == s do Some(z) else None end end
  end
  -- the layers whose cover the layer reads: through its rule, and through the zones its shape set's weights are keyed to
  pfn layer_reads(fs : List(PopFieldDecl), zs : List(PopZoneDecl), ws : List(PopWeightsDecl), d : PopLayerDecl) : List(String) do
    let from_rule = match layer_rule(d) do
      Some(r) -> rule_reads(zs, r)
      None -> Nil
    end
    let from_weights = List.flat_map(weights_zones(ws, layer_shapes(d)), fn z -> zone_fields(zs, z))
    List.flat_map(List.append(from_rule, from_weights), fn f -> field_layers(fs, f))
  end

  -- Layer order

  pfn reads_of(deps : List((String, List(String))), n : String) : List(String) do
    match List.find(deps, fn e -> entry_name(e) == n) do
      Some((_, ds)) -> ds
      None -> Nil
    end
  end
  pfn entry_name(e : (String, List(String))) : String do match e do (n, _) -> n end end
  pfn ready(done_rev : List(String), e : (String, List(String))) : Bool do
    match e do (_, ds) -> List.all(ds, fn d -> has_name(done_rev, d)) end
  end

  -- every pending layer waits on another pending one: follow the waits from n until one repeats
  pfn chase(pending : List((String, List(String))), n : String, path : List(String)) : String do
    if has_name(path, n) do loop_text(path, n)
    else
      let names = List.map(pending, entry_name)
      match List.find(reads_of(pending, n), fn d -> has_name(names, d)) do
        Some(d) -> chase(pending, d, Cons(n, path))
        None -> string_join(names, ", ")
      end
    end
  end

  -- where chase's loop starts: the first layer that repeats, or n's when the waits leave the pending ones
  pfn chase_head(pending : List((String, List(String))), n : String, path : List(String)) : String do
    if has_name(path, n) do n
    else
      let names = List.map(pending, entry_name)
      match List.find(reads_of(pending, n), fn d -> has_name(names, d)) do
        Some(d) -> chase_head(pending, d, Cons(n, path))
        None -> n
      end
    end
  end

  -- the layers in run order: repeatedly the earliest declared whose reads have all run
  pfn run_order(pending : List((String, List(String))), done_rev : List(String)) : Result(List(String), String) do
    match pending do
      Nil -> Ok(List.reverse(done_rev))
      Cons(first, _) ->
        match List.find(pending, fn e -> ready(done_rev, e)) do
          Some(e) ->
            let n = entry_name(e)
            run_order(List.filter(pending, fn x -> entry_name(x) != n), Cons(n, done_rev))
          None -> Err("population: layers read each other's cover in a cycle: " ++ chase(pending, entry_name(first), Nil) ++ about1("layer", chase_head(pending, entry_name(first), Nil)))
        end
    end
  end

  -- Compiling (declarations checked)

  pfn compile_field(fnames : List(String), lorder : List(String), d : PopFieldDecl) : PopField do
    match d do
      PdGround(_, s) -> PfGround(s)
      PdNoise(_, k, o, per, salt) -> PfNoise(k, o, per, salt)
      PdCurve(_, of, c) -> PfCurve(index_of(fnames, of), c)
      PdCover(_, l, r) -> PfCover(index_of(lorder, l), r)
    end
  end

  pfn compile_zone(fnames : List(String), znames : List(String), d : PopZoneDecl) : PopZone do
    match d do
      PdRegions(_, ids) -> PfRegions(ids)
      PdBand(_, f, lo, hi) -> PfBand(index_of(fnames, f), lo, hi)
      PdRing(_, sites, inner, outer) -> PfRing(sites, inner, outer)
      PdAll(_, of) -> PfAll(List.map(of, fn z -> index_of(znames, z)))
      PdAny(_, of) -> PfAny(List.map(of, fn z -> index_of(znames, z)))
      PdNot(_, of) -> PfNot(index_of(znames, of))
    end
  end

  pfn weights_of(znames : List(String), ws : List(PopWeightsDecl), s : String) : List((Int, List(Float))) do
    List.filter_map(ws, fn w -> weight_entry(znames, s, w))
  end
  pfn weight_entry(znames : List(String), s : String, w : PopWeightsDecl) : Option((Int, List(Float))) do
    match w do PdWeights(s2, z, v) -> if s2 == s do Some((index_of(znames, z), v)) else None end end
  end

  pfn compile_shapes(znames : List(String), ws : List(PopWeightsDecl), d : PopShapesDecl) : PopShapes do
    match d do
      PdBlocks(n, ids) -> PfBlocks(ids, weights_of(znames, ws, n))
      PdTemplates(n, ts) -> PfTemplates(ts, weights_of(znames, ws, n))
    end
  end

  pfn compile_curve(fnames : List(String), fc : (String, PopCurve)) : (Int, PopCurve) do
    match fc do (f, c) -> (index_of(fnames, f), c) end
  end
  pfn compile_rule(fnames : List(String), znames : List(String), r : PopRule) : PopFrozenRule do
    match r do
      PopRule(base, cs, ins, outs) ->
        PfRule(base, List.map(cs, fn fc -> compile_curve(fnames, fc)), List.map(ins, fn z -> index_of(znames, z)), List.map(outs, fn z -> index_of(znames, z)))
    end
  end

  pfn compile_layer(fnames : List(String), znames : List(String), snames : List(String), d : PopLayerDecl) : PopLayer do
    let s = index_of(snames, layer_shapes(d))
    match d do
      PdLayerCover(_, _, r, salt) -> PfLayerCover(s, compile_rule(fnames, znames, r), salt)
      PdLayerScatter(_, _, r, cell, jitter, salt) -> PfLayerScatter(s, compile_rule(fnames, znames, r), cell, jitter, salt)
      PdLayerSite(_, _, sites, margin, salt) -> PfLayerSite(s, sites, margin, salt)
    end
  end

  pfn band_field(d : PopZoneDecl) : List(String) do
    match d do
      PdBand(_, f, _, _) -> Cons(f, Nil)
      _ -> Nil
    end
  end

  pfn dedup_sorted(xs : List(Int), acc : List(Int)) : List(Int) do
    match xs do
      Nil -> List.reverse(acc)
      Cons(x, rest) ->
        match acc do
          Cons(a, _) -> if a == x do dedup_sorted(rest, acc) else dedup_sorted(rest, Cons(x, acc)) end
          Nil -> dedup_sorted(rest, Cons(x, acc))
        end
    end
  end

  -- a regions zone reads the region slot
  pfn regions_slot(d : PopZoneDecl) : List(Int) do
    match d do
      PdRegions(_, _) -> Cons(7, Nil)
      _ -> Nil
    end
  end

  -- the built-in slots some layer's rule or some zone reads, ascending
  pfn ground_used(fs : List(PopFieldDecl), zs : List(PopZoneDecl), ls : List(PopLayerDecl)) : List(Int) do
    let from_rules = List.flat_map(ls, fn d -> rule_fields_of(d))
    let roots = List.append(from_rules, List.flat_map(zs, band_field))
    let slots = List.append(List.flat_map(roots, fn f -> field_slots(fs, f)), List.flat_map(zs, regions_slot))
    dedup_sorted(List.sort_by(slots, fn (a, b) -> a <= b), Nil)
  end
  pfn rule_fields_of(d : PopLayerDecl) : List(String) do
    match layer_rule(d) do
      Some(r) -> rule_fields(r)
      None -> Nil
    end
  end

  pfn compile(fs : List(PopFieldDecl), zs : List(PopZoneDecl), ss : List(PopShapesDecl), ws : List(PopWeightsDecl), ls : List(PopLayerDecl), lorder : List(String)) : FrozenData do
    let fnames = List.map(fs, field_name)
    let znames = List.map(zs, zone_name)
    let snames = List.map(ss, shapes_name)
    let layers = List.filter_map(lorder, fn n -> find_layer(ls, n))
    { fz_field_names: fnames, fz_fields: List.map(fs, fn d -> compile_field(fnames, lorder, d)), fz_zone_names: znames, fz_zones: List.map(zs, fn d -> compile_zone(fnames, znames, d)), fz_shape_names: snames, fz_shapes: List.map(ss, fn d -> compile_shapes(znames, ws, d)), fz_layer_names: lorder, fz_layers: List.map(layers, fn d -> compile_layer(fnames, znames, snames, d)), fz_ground: ground_used(fs, zs, ls), fz_seen: Nil, fz_ranks: Nil, fz_on: Nil, fz_between: Nil }
  end

  pfn seen_of(seens : List((String, Int)), n : String) : Int do
    match List.find(seens, fn e -> seen_name(e) == n) do
      Some((_, v)) -> v
      None -> -1
    end
  end
  pfn rank_of_set(rks : List((String, NativeIntArr)), n : String) : NativeIntArr do
    match List.find(rks, fn e -> rank_name(e) == n) do
      Some((_, v)) -> v
      None -> NativeArray.make_int(0, 0)
    end
  end

  doc "Checks the declarations and compiles them, or the first mistake found, naming the offender: a duplicate name within a kind; a field, zone, rule, weights or layer naming something undeclared; a ground slot outside 0..31; a noise period not above 0, a noise kind outside 0..3 or octaves outside 1..16; a shape set with no variants; a block id of 0 or below or above 65535; a cover layer on a shape set of templates; weights whose count is not the variant count, with a negative weight, or summing to 0; a second weights for one shape set and zone; a rule base below 0 or not a number; a curve with no points; a negative radius or margin; a cover radius not above 0, NaN or infinite; a cover field of a scatter layer whose pi * radius^2 / cell^2 is not above 0 or not finite; a site radius or site layer margin that is NaN or infinite; a site layer's site index outside -2^40..2^40; a cell that is not finite or is below 1/64 m; a jitter outside 0..0.6; a seen_to naming an undeclared layer, a level outside 0..16, a level above 0 for a block layer, or a second seen_to for a layer; ranks naming an undeclared shape set or a set of blocks, a rank below 0, or a second ranks for a set; cover_on naming an undeclared layer or one that is not a cover layer, no ids or an id outside 0..65535, or a second cover_on for a layer; cover_between naming an undeclared layer or one that is not a cover layer, lo not below hi (or NaN), or a second cover_between for a layer; curve fields or zones that refer to each other in a cycle; layers that read each other's cover in a cycle, through their rules or their shape sets' weights zones. Every message ends with a line naming the declaration at fault, which freeze_subject reads."
  fn freeze(p : Pop) : Result(Frozen, String) do
    let q = popd(p)
    let fs = List.reverse(q.pp_fields)
    let zs = List.reverse(q.pp_zones)
    let ss = List.reverse(q.pp_shapes)
    let ws = List.reverse(q.pp_weights)
    let ls = List.reverse(q.pp_layers)
    let fnames = List.map(fs, field_name)
    let znames = List.map(zs, zone_name)
    let snames = List.map(ss, shapes_name)
    let lnames = List.map(ls, layer_name)
    let seens = List.reverse(q.pp_seen)
    let rks = List.reverse(q.pp_ranks)
    let ons = List.reverse(q.pp_on)
    let bets = List.reverse(q.pp_between)
    let mistake = first_of([
      duplicate("field", "field", fnames), duplicate("zone", "zone", znames), duplicate("shape set", "shapes", snames), duplicate("layer", "layer", lnames),
      first_some(fs, fn d -> check_field(fnames, lnames, d)),
      first_some(zs, fn d -> check_zone(fnames, znames, d)),
      first_some(ss, check_shapes),
      duplicate_weights(ws),
      first_some(ws, fn w -> check_weights(ss, znames, w)),
      first_some(ls, fn d -> check_layer(fnames, znames, ss, snames, d)),
      first_some(fs, fn d -> check_cover_norm(ls, d)),
      duplicate("seen_to of a layer", "seen_to", List.map(seens, seen_name)),
      first_some(seens, fn e -> check_seen(ls, ss, e)),
      duplicate("ranks of a shape set", "ranks", List.map(rks, rank_name)),
      first_some(rks, fn e -> check_ranks(ss, e)),
      duplicate("cover_on of a layer", "cover_on", List.map(ons, on_name)),
      first_some(ons, fn e -> check_on(ls, e)),
      duplicate("cover_between of a layer", "cover_between", List.map(bets, between_name)),
      first_some(bets, fn e -> check_between(ls, e)),
      first_some(fnames, fn n -> field_loop(fs, n, Nil)),
      first_some(znames, fn n -> zone_loop(zs, n, Nil))])
    match mistake do
      Some(e) -> Err(e)
      None ->
        match run_order(List.map(ls, fn d -> (layer_name(d), layer_reads(fs, zs, ws, d))), Nil) do
          Err(e) -> Err(e)
          Ok(lorder) ->
            let f = compile(fs, zs, ss, ws, ls, lorder)
            Ok(Frozen({ f with fz_seen: List.map(lorder, fn n -> seen_of(seens, n)), fz_ranks: List.map(ss, fn d -> rank_of_set(rks, shapes_name(d))), fz_on: List.map(lorder, fn n -> on_of(ons, n)), fz_between: List.map(lorder, fn n -> between_of(bets, n)) }))
        end
    end
  end

  doc "What a message from freeze or fit_all is about: the kind of declaration at fault (\"field\", \"zone\", \"shapes\", \"weights\", \"layer\", or \"seen_to\", \"ranks\", \"cover_on\" or \"cover_between\" for a mistake in such a call) and its name (for weights, the shape set's and the zone's; for seen_to, cover_on and cover_between the layer's, for ranks the shape set's), read from the line \"  about: KIND<tab>NAME...\" every such message ends with; None for any other text. Where two declarations share the name (a duplicate) it is the later one at fault. A name holding a tab or a newline does not read back."
  fn freeze_subject(err : String) : Option((String, List(String))) do
    match String.split_first(err, subject_mark()) do
      None -> None
      Some((_, rest)) ->
        match String.split(rest, "\t") do
          Cons(k, names) -> if List.is_empty(names) do None else Some((k, names)) end
          Nil -> None
        end
    end
  end

  doc "The layers' names in the order they run."
  fn layer_names(f : Frozen) : List(String) do fz_layer_names_of(f) end

  doc "The built-in slots (0..9) that some rule or zone reads, through curve fields (a regions zone reads slot 7), ascending: the game checks its Ground supplies them."
  fn missing_ground(f : Frozen) : List(Int) do fz_ground_of(f) end

  -- Reading a Frozen, for the module that evaluates it (Strata.Populate).
  -- March has no package-private visibility (a function is public, `fn`, or
  -- private to its module, `pfn`), so these are public; a game needs the
  -- names, indices and counts, the layer readers and shape_set_templates,
  -- and the rest are Strata.Populate's. A Frozen itself is opaque: only
  -- freeze and fit_all make one, so none skips their checks.
  -- Indices are positions in declaration order (layers: run order). A
  -- reader asked for an index out of range, or for a number its kind does
  -- not have, answers -1, 0.0, Nil or a curve with no points.

  doc "A curve's points (x, factor), sorted by x."
  fn curve_points(c : PopCurve) : List((Float, Float)) do match c do PopCurve(pts) -> pts end end

  doc "A site's centre x in metres."
  fn site_xm(s : PopSite) : Float do match s do PopSite(v, _, _, _, _) -> v end end
  doc "A site's centre z in metres."
  fn site_zm(s : PopSite) : Float do match s do PopSite(_, v, _, _, _) -> v end end
  doc "A site's floor height in metres."
  fn site_floor(s : PopSite) : Float do match s do PopSite(_, _, v, _, _) -> v end end
  doc "A site's radius in metres."
  fn site_radius(s : PopSite) : Float do match s do PopSite(_, _, _, v, _) -> v end end
  doc "The game's index for a site."
  fn site_index(s : PopSite) : Int do match s do PopSite(_, _, _, _, v) -> v end end

  pfn nth_of(xs : List(a), i : Int) : Option(a) do if i < 0 do None else List.nth_opt(xs, i) end end
  pfn no_curve() : PopCurve do PopCurve(Nil) end

  -- fields

  pfn fz_field(f : Frozen, i : Int) : Option(PopField) do nth_of(fz_fields_of(f), i) end
  doc "How many fields there are."
  fn field_count(f : Frozen) : Int do List.length(fz_fields_of(f)) end
  doc "The fields' names, by index."
  fn field_names(f : Frozen) : List(String) do fz_field_names_of(f) end
  doc "The index of the field named n, or -1."
  fn field_index(f : Frozen, n : String) : Int do index_of(fz_field_names_of(f), n) end
  doc "Field i's kind: 0 ground, 1 noise, 2 curve, 3 cover; -1 for no such field."
  fn field_kind(f : Frozen, i : Int) : Int do
    match fz_field(f, i) do
      Some(PfGround(_)) -> 0
      Some(PfNoise(_, _, _, _)) -> 1
      Some(PfCurve(_, _)) -> 2
      Some(PfCover(_, _)) -> 3
      None -> -1
    end
  end
  doc "A ground field's slot 0..9."
  fn field_slot(f : Frozen, i : Int) : Int do
    match fz_field(f, i) do
      Some(PfGround(s)) -> s
      _ -> -1
    end
  end
  doc "A noise field's noise kind."
  fn field_noise_kind(f : Frozen, i : Int) : Int do
    match fz_field(f, i) do
      Some(PfNoise(k, _, _, _)) -> k
      _ -> -1
    end
  end
  doc "A noise field's octaves."
  fn field_octaves(f : Frozen, i : Int) : Int do
    match fz_field(f, i) do
      Some(PfNoise(_, o, _, _)) -> o
      _ -> -1
    end
  end
  doc "A noise field's period in metres."
  fn field_period(f : Frozen, i : Int) : Float do
    match fz_field(f, i) do
      Some(PfNoise(_, _, v, _)) -> v
      _ -> 0.0
    end
  end
  doc "A noise field's seed salt."
  fn field_salt(f : Frozen, i : Int) : Int do
    match fz_field(f, i) do
      Some(PfNoise(_, _, _, s)) -> s
      _ -> -1
    end
  end
  doc "A curve field's source field index."
  fn field_source(f : Frozen, i : Int) : Int do
    match fz_field(f, i) do
      Some(PfCurve(s, _)) -> s
      _ -> -1
    end
  end
  doc "A curve field's curve."
  fn field_source_curve(f : Frozen, i : Int) : PopCurve do
    match fz_field(f, i) do
      Some(PfCurve(_, c)) -> c
      _ -> no_curve()
    end
  end
  doc "A cover field's layer index (run order)."
  fn field_layer(f : Frozen, i : Int) : Int do
    match fz_field(f, i) do
      Some(PfCover(l, _)) -> l
      _ -> -1
    end
  end
  doc "A cover field's radius in metres."
  fn field_radius(f : Frozen, i : Int) : Float do
    match fz_field(f, i) do
      Some(PfCover(_, r)) -> r
      _ -> 0.0
    end
  end

  -- zones

  pfn fz_zone(f : Frozen, i : Int) : Option(PopZone) do nth_of(fz_zones_of(f), i) end
  doc "How many zones there are."
  fn zone_count(f : Frozen) : Int do List.length(fz_zones_of(f)) end
  doc "The zones' names, by index."
  fn zone_names(f : Frozen) : List(String) do fz_zone_names_of(f) end
  doc "The index of the zone named n, or -1."
  fn zone_index(f : Frozen, n : String) : Int do index_of(fz_zone_names_of(f), n) end
  doc "Zone i's kind: 0 regions, 1 band, 2 ring, 3 all, 4 any, 5 not; -1 for no such zone."
  fn zone_kind(f : Frozen, i : Int) : Int do
    match fz_zone(f, i) do
      Some(PfRegions(_)) -> 0
      Some(PfBand(_, _, _)) -> 1
      Some(PfRing(_, _, _)) -> 2
      Some(PfAll(_)) -> 3
      Some(PfAny(_)) -> 4
      Some(PfNot(_)) -> 5
      None -> -1
    end
  end
  doc "A regions zone's region ids."
  fn zone_ids(f : Frozen, i : Int) : List(Int) do
    match fz_zone(f, i) do
      Some(PfRegions(ids)) -> ids
      _ -> Nil
    end
  end
  doc "A band zone's field index."
  fn zone_field(f : Frozen, i : Int) : Int do
    match fz_zone(f, i) do
      Some(PfBand(fi, _, _)) -> fi
      _ -> -1
    end
  end
  doc "A band zone's lower bound (inclusive)."
  fn zone_lo(f : Frozen, i : Int) : Float do
    match fz_zone(f, i) do
      Some(PfBand(_, v, _)) -> v
      _ -> 0.0
    end
  end
  doc "A band zone's upper bound (exclusive)."
  fn zone_hi(f : Frozen, i : Int) : Float do
    match fz_zone(f, i) do
      Some(PfBand(_, _, v)) -> v
      _ -> 0.0
    end
  end
  doc "A ring zone's sites."
  fn zone_sites(f : Frozen, i : Int) : List(PopSite) do
    match fz_zone(f, i) do
      Some(PfRing(ss, _, _)) -> ss
      _ -> Nil
    end
  end
  doc "A ring zone's inner radius in metres."
  fn zone_inner(f : Frozen, i : Int) : Float do
    match fz_zone(f, i) do
      Some(PfRing(_, v, _)) -> v
      _ -> 0.0
    end
  end
  doc "A ring zone's outer radius in metres."
  fn zone_outer(f : Frozen, i : Int) : Float do
    match fz_zone(f, i) do
      Some(PfRing(_, _, v)) -> v
      _ -> 0.0
    end
  end
  doc "The zone indices an all, any or not zone is made of (a not zone: the one it negates)."
  fn zone_members(f : Frozen, i : Int) : List(Int) do
    match fz_zone(f, i) do
      Some(PfAll(zs)) -> zs
      Some(PfAny(zs)) -> zs
      Some(PfNot(z)) -> Cons(z, Nil)
      _ -> Nil
    end
  end

  -- shape sets

  pfn fz_shapes_at(f : Frozen, i : Int) : Option(PopShapes) do nth_of(fz_shapes_of(f), i) end
  doc "How many shape sets there are."
  fn shape_set_count(f : Frozen) : Int do List.length(fz_shapes_of(f)) end
  doc "The shape sets' names, by index."
  fn shape_set_names(f : Frozen) : List(String) do fz_shape_names_of(f) end
  doc "The index of the shape set named n, or -1."
  fn shape_set_index(f : Frozen, n : String) : Int do index_of(fz_shape_names_of(f), n) end
  doc "Shape set i's kind: 0 blocks, 1 templates; -1 for no such set."
  fn shape_set_kind(f : Frozen, i : Int) : Int do
    match fz_shapes_at(f, i) do
      Some(PfBlocks(_, _)) -> 0
      Some(PfTemplates(_, _)) -> 1
      None -> -1
    end
  end
  doc "A block shape set's block ids, a variant each."
  fn shape_set_blocks(f : Frozen, i : Int) : List(Int) do
    match fz_shapes_at(f, i) do
      Some(PfBlocks(ids, _)) -> ids
      _ -> Nil
    end
  end
  doc "A template shape set's templates, a variant each."
  fn shape_set_templates(f : Frozen, i : Int) : List(Strata.Template.Template) do
    match fz_shapes_at(f, i) do
      Some(PfTemplates(ts, _)) -> ts
      _ -> Nil
    end
  end
  doc "How many variants shape set i has."
  fn shape_set_variants(f : Frozen, i : Int) : Int do
    match fz_shapes_at(f, i) do
      Some(PfBlocks(ids, _)) -> List.length(ids)
      Some(PfTemplates(ts, _)) -> List.length(ts)
      None -> 0
    end
  end
  doc "Shape set i's weights: (zone index, a weight per variant), in declaration order, at most one per zone."
  fn shape_set_weights(f : Frozen, i : Int) : List((Int, List(Float))) do
    match fz_shapes_at(f, i) do
      Some(PfBlocks(_, ws)) -> ws
      Some(PfTemplates(_, ws)) -> ws
      None -> Nil
    end
  end

  -- layers, in run order

  pfn fz_layer(f : Frozen, i : Int) : Option(PopLayer) do nth_of(fz_layers_of(f), i) end
  pfn fz_rule(f : Frozen, i : Int) : Option(PopFrozenRule) do
    match fz_layer(f, i) do
      Some(PfLayerCover(_, r, _)) -> Some(r)
      Some(PfLayerScatter(_, r, _, _, _)) -> Some(r)
      _ -> None
    end
  end
  doc "How many layers there are."
  fn layer_count(f : Frozen) : Int do List.length(fz_layers_of(f)) end
  doc "The index (run order) of the layer named n, or -1."
  fn layer_index(f : Frozen, n : String) : Int do index_of(fz_layer_names_of(f), n) end
  doc "Layer i's kind: 0 cover, 1 scatter, 2 site; -1 for no such layer."
  fn layer_kind(f : Frozen, i : Int) : Int do
    match fz_layer(f, i) do
      Some(PfLayerCover(_, _, _)) -> 0
      Some(PfLayerScatter(_, _, _, _, _)) -> 1
      Some(PfLayerSite(_, _, _, _)) -> 2
      None -> -1
    end
  end
  doc "Layer i's shape set index."
  fn layer_shape_set(f : Frozen, i : Int) : Int do
    match fz_layer(f, i) do
      Some(PfLayerCover(s, _, _)) -> s
      Some(PfLayerScatter(s, _, _, _, _)) -> s
      Some(PfLayerSite(s, _, _, _)) -> s
      None -> -1
    end
  end
  doc "Layer i's hash salt."
  fn layer_salt(f : Frozen, i : Int) : Int do
    match fz_layer(f, i) do
      Some(PfLayerCover(_, _, v)) -> v
      Some(PfLayerScatter(_, _, _, _, v)) -> v
      Some(PfLayerSite(_, _, _, v)) -> v
      None -> -1
    end
  end
  doc "Layer i's rule base density per square metre (cover and scatter)."
  fn layer_base(f : Frozen, i : Int) : Float do
    match fz_rule(f, i) do
      Some(PfRule(b, _, _, _)) -> b
      None -> 0.0
    end
  end
  doc "Layer i's rule factors: (field index, curve) (cover and scatter)."
  fn layer_curves(f : Frozen, i : Int) : List((Int, PopCurve)) do
    match fz_rule(f, i) do
      Some(PfRule(_, cs, _, _)) -> cs
      None -> Nil
    end
  end
  doc "The zone indices layer i's rule must be inside (cover and scatter)."
  fn layer_inside(f : Frozen, i : Int) : List(Int) do
    match fz_rule(f, i) do
      Some(PfRule(_, _, ins, _)) -> ins
      None -> Nil
    end
  end
  doc "The zone indices layer i's rule must be outside (cover and scatter)."
  fn layer_outside(f : Frozen, i : Int) : List(Int) do
    match fz_rule(f, i) do
      Some(PfRule(_, _, _, outs)) -> outs
      None -> Nil
    end
  end
  doc "A scatter layer's cell side in metres."
  fn layer_cell(f : Frozen, i : Int) : Float do
    match fz_layer(f, i) do
      Some(PfLayerScatter(_, _, v, _, _)) -> v
      _ -> 0.0
    end
  end
  doc "A scatter layer's jitter 0..0.6."
  fn layer_jitter(f : Frozen, i : Int) : Float do
    match fz_layer(f, i) do
      Some(PfLayerScatter(_, _, _, v, _)) -> v
      _ -> 0.0
    end
  end
  doc "A site layer's sites."
  fn layer_sites(f : Frozen, i : Int) : List(PopSite) do
    match fz_layer(f, i) do
      Some(PfLayerSite(_, ss, _, _)) -> ss
      _ -> Nil
    end
  end
  doc "A site layer's margin in metres."
  fn layer_margin(f : Frozen, i : Int) : Float do
    match fz_layer(f, i) do
      Some(PfLayerSite(_, _, v, _)) -> v
      _ -> 0.0
    end
  end

  -- levels

  doc "Layer i's declared seen_to level, or -1 when none was declared (the default applies: seen_level)."
  fn layer_seen_to(f : Frozen, i : Int) : Int do
    match nth_of(fz_seen_of(f), i) do
      Some(v) -> v
      None -> -1
    end
  end
  doc "Layer i's cover_on block ids (run order); Nil when none were declared (any floor) or for no such layer."
  fn layer_on(f : Frozen, i : Int) : List(Int) do
    match nth_of(fz_on_of(f), i) do
      Some(v) -> v
      None -> Nil
    end
  end
  doc "Layer i's cover_between heights (run order): (lo, hi), (-inf, inf) when none were declared or for no such layer."
  fn layer_between(f : Frozen, i : Int) : (Float, Float) do
    match nth_of(fz_between_of(f), i) do
      Some(v) -> v
      None -> (float_neg_infinity(), float_infinity())
    end
  end
  doc "Shape set i's rank array (ranks); empty when none was declared (every id ranked by itself) or for no such set."
  fn shape_set_ranks(f : Frozen, i : Int) : NativeIntArr do
    match nth_of(fz_ranks_of(f), i) do
      Some(v) -> v
      None -> NativeArray.make_int(0, 0)
    end
  end
  doc "The widest variant of shape set i in metres: the larger of a template's x and z sides times its voxel size, largest over the set; 0 for blocks."
  fn shape_set_widest(f : Frozen, i : Int) : Float do
    List.fold_left(shape_set_templates(f, i), 0.0, fn (m, t) -> fmax(m, int_to_float(Math.max_int(Strata.Template.t_sx(t), Strata.Template.t_sz(t))) *. Strata.Template.t_voxel_size(t)))
  end
  pfn default_go(wide : Float, scale : Float, l : Int) : Int do
    -- level l + 1 has voxels of scale * 2^(l + 1): seen while wide covers two of them
    if l >= 16 do l else if wide >= 2.0 *. scale *. Math.pow(2.0, int_to_float(l + 1)) do default_go(wide, scale, l + 1) else l end end
  end
  doc "The default seen_to level of a stamp layer whose widest variant is `wide` metres, in a world of `scale` metres a voxel: the coarsest level L (0..16) at which wide is at least two voxels of scale * 2^L; 0 when it is under two voxels at level 1, or the scale is not above 0 (NaN included). Public only because Strata.Populate reads it (March has no package-private visibility): a game asks seen_level_at."
  fn default_seen(wide : Float, scale : Float) : Int do if scale > 0.0 do default_go(wide, scale, 0) else 0 end end
  doc "The coarsest level layer i (run order) is placed at in a world of `scale` metres a voxel: 0 for a block layer (a cover layer, or a shape set of blocks); else its declared seen_to, or default_seen of its shape set's widest variant; -1 for no such layer."
  fn seen_level_at(f : Frozen, i : Int, scale : Float) : Int do
    let kind = layer_kind(f, i)
    let s = layer_shape_set(f, i)
    if kind < 0 do -1
    else if kind == 0 do 0
    else if shape_set_kind(f, s) != 1 do 0
    else if layer_seen_to(f, i) >= 0 do layer_seen_to(f, i)
    else default_seen(shape_set_widest(f, s), scale) end end end end
  end
  doc "seen_level_at for the layer named layer; -1 for an undeclared layer."
  fn seen_level(f : Frozen, layer : String, scale : Float) : Int do seen_level_at(f, layer_index(f, layer), scale) end

  -- Reach and fitting (scatter and site layers place templates)

  pfn fmax(a : Float, b : Float) : Float do if a > b do a else b end end
  -- metres from the centre of a template's middle voxel to the centre of its outermost, along its wider side
  pfn half_width(t : Strata.Template.Template) : Float do
    int_to_float(Math.max_int(Strata.Template.t_sx(t), Strata.Template.t_sz(t)) - 1) *. 0.5 *. Strata.Template.t_voxel_size(t)
  end
  -- the largest half-width plus half the largest voxel; 0 for no templates
  pfn reach_of(ts : List(Strata.Template.Template)) : Float do
    List.fold_left(ts, 0.0, fn (m, t) -> fmax(m, half_width(t))) +. 0.5 *. List.fold_left(ts, 0.0, fn (m, t) -> fmax(m, Strata.Template.t_voxel_size(t)))
  end

  doc "How far, in metres, a template of shape set i reaches from the column it stands on: the largest half-width of its templates (half of one less than the wider side, in voxels, times the voxel size) plus half its largest voxel; 0 for a set of blocks. A template s voxels wide of size v reaches s * v / 2, whatever voxel size it is fitted to."
  fn shape_set_reach(f : Frozen, i : Int) : Float do reach_of(shape_set_templates(f, i)) end

  doc "How far, in metres, anything a scatter or site layer places reaches from the column it stands on: the largest half-width of any template of any such layer plus half the largest voxel size among them; 0 when they place no templates. A shape set no scatter or site layer uses does not count. Strata.Populate.pad turns it into columns of Ground."
  fn reach(f : Frozen) : Float do
    reach_of(List.flat_map(List.range(0, layer_count(f)), fn l -> if layer_kind(f, l) == 0 do Nil else shape_set_templates(f, layer_shape_set(f, l)) end))
  end

  pfn fit_templates(ts : List(Strata.Template.Template), scale : Float) : Option(List(Strata.Template.Template)) do
    match ts do
      Nil -> Some(Nil)
      Cons(t, rest) ->
        match Strata.Template.fit(t, scale) do
          None -> None
          Some(t2) ->
            match fit_templates(rest, scale) do
              None -> None
              Some(rest2) -> Some(Cons(t2, rest2))
            end
        end
    end
  end
  pfn fit_sets(names : List(String), sets : List(PopShapes), scale : Float) : Result(List(PopShapes), String) do
    match sets do
      Nil -> Ok(Nil)
      Cons(s, rest) ->
        let name = match names do
          Cons(n, _) -> n
          Nil -> ""
        end
        let fitted = match s do
          PfBlocks(_, _) -> Some(s)
          PfTemplates(ts, ws) ->
            match fit_templates(ts, scale) do
              Some(ts2) -> Some(PfTemplates(ts2, ws))
              None -> None
            end
        end
        match fitted do
          None -> Err("population: shape set " ++ q(name) ++ " holds a template that cannot be fitted to a world of " ++ float_to_string(scale) ++ " m a voxel: its voxel size must be a whole number of the world's" ++ about1("shapes", name))
          Some(s2) ->
            match fit_sets(List.drop(names, 1), rest, scale) do
              Err(e) -> Err(e)
              Ok(rest2) -> Ok(Cons(s2, rest2))
            end
        end
    end
  end

  -- How many cells a side a scatter layer of `cell` metres, whose templates reach `reach` metres, walks for one chunk at `level` of a world of `scale` metres a voxel: ceil((32 * scale * 2^level + 2 * reach) / cell); the walk visits at most (that + 1)^2 cells. NaN for a NaN input.
  pfn walk_side(cell : Float, reach : Float, scale : Float, level : Int) : Float do
    Math.ceil((32.0 *. scale *. Math.pow(2.0, int_to_float(level)) +. 2.0 *. reach) /. cell)
  end
  doc "Whether a scatter layer of `cell` metres, whose templates reach `reach` metres, walks at most 2048 cells a side for one chunk at `level` of a world of `scale` metres a voxel, ceil((32 * scale * 2^level + 2 * reach) / cell), so one chunk's candidate walk stays near 2^22 cells (a NaN fails). Public only because Strata.Populate reads it (March has no package-private visibility): fit_all and place_problems give a game the same answer."
  fn walk_ok(cell : Float, reach : Float, scale : Float, level : Int) : Bool do
    let v = walk_side(cell, reach, scale, level)
    if v <= 2048.0 do true else false end
  end
  -- the first scatter layer from l whose walk at its seen level is too long, as a mistake
  pfn walks_go(f : Frozen, scale : Float, l : Int) : Option(String) do
    if l >= layer_count(f) do None
    else if layer_kind(f, l) == 1 do
      let lvl = seen_level_at(f, l, scale)
      let cell = layer_cell(f, l)
      let reach = shape_set_reach(f, layer_shape_set(f, l))
      if walk_ok(cell, reach, scale, lvl) do walks_go(f, scale, l + 1)
      else fail(about1("layer", name_at(fz_layer_names_of(f), l)), "layer " ++ q(name_at(fz_layer_names_of(f), l)) ++ " is seen to level " ++ int_to_string(lvl) ++ " in a world of " ++ float_to_string(scale) ++ " m a voxel, where one chunk walks " ++ float_to_string(walk_side(cell, reach, scale, lvl)) ++ " cells of " ++ float_to_string(cell) ++ " m a side; at most 2048: a larger cell or a lower seen_to") end
    else walks_go(f, scale, l + 1) end end
  end
  pfn name_at(xs : List(String), i : Int) : String do
    match nth_of(xs, i) do
      Some(n) -> n
      None -> ""
    end
  end

  doc "f with every template of every shape set put through Strata.Template.fit at a world of `scale` metres a voxel, so each is as many metres across as it was authored; or Err naming the first shape set holding a template that cannot be fitted (a voxel size that is not a whole number of the world's, or a world coarser than the template). Block sets pass through. Also Err naming the first scatter layer whose candidate walk for one chunk at its seen level (seen_level_at at this scale) is more than 2048 cells a side (walk_side). Strata.Populate.place refuses a population whose scatter or site templates are not at its Ground's voxel size: fit it first."
  fn fit_all(f : Frozen, scale : Float) : Result(Frozen, String) do
    match fit_sets(fz_shape_names_of(f), fz_shapes_of(f), scale) do
      Ok(sets) ->
        let d = fd(f)
        let f2 = Frozen({ d with fz_shapes: sets })
        match walks_go(f2, scale, 0) do
          Some(e) -> Err(e)
          None -> Ok(f2)
        end
      Err(e) -> Err(e)
    end
  end
end
