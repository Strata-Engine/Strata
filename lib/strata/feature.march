-- Feature — things a generator scatters over the ground (anything a
-- template stands for), placed by hashed cells so any area asks for them
-- alone and gets the same answer.
--
-- The plane is cut into square cells `cell` metres on a side, keyed by
-- (floor(x / cell), floor(z / cell)), so a cell at negative coordinates is
-- its own and not the mirror of a positive one. Each cell's stream,
-- Strata.Seed.cell(seed, salt, cx, 0, cz), decides in order: whether it
-- holds a placement (unit < chance * density(x, z), density read at the
-- jittered place), its offset from the cell's centre (each axis
-- (unit - 0.5) * jitter * cell, so a jitter of 0.6 or less keeps it inside
-- the cell), a quarter turn 0..3, and two values for the game: index (to
-- pick a template) and stream (to draw the template's probabilities).
--
-- candidates walks every cell overlapping the asked box grown by the kind's
-- radius, so a placement whose template reaches `radius` metres into the
-- box is found from any box it touches. No game notion lives here.
mod Strata.Feature do

  -- metres: cell side, how far a placement's template reaches, jitter (<= 0.6) as a share of the cell; the hash salt; the chance a cell holds one
  type FeatureKind = FeatureKind(Float, Float, Float, Int, Float)
  -- metres: where it stands (x, z); a Seed value to pick a template; a quarter turn 0..3; a stream for its probabilities
  type Placed = Placed(Float, Float, Int, Int, Int)

  doc "A kind of feature: cells `cell` metres on a side, templates reaching `radius` metres from where they stand, offset by up to jitter / 2 of a cell either side of its centre (jitter <= 0.6), hashed with salt, and a cell holding one with probability chance (times the density)."
  fn kind(cell : Float, radius : Float, jitter : Float, salt : Int, chance : Float) : FeatureKind do FeatureKind(cell, radius, jitter, salt, chance) end

  fn k_cell(k : FeatureKind) : Float do match k do FeatureKind(v, _, _, _, _) -> v end end
  fn k_radius(k : FeatureKind) : Float do match k do FeatureKind(_, v, _, _, _) -> v end end
  fn k_jitter(k : FeatureKind) : Float do match k do FeatureKind(_, _, v, _, _) -> v end end
  fn k_salt(k : FeatureKind) : Int do match k do FeatureKind(_, _, _, v, _) -> v end end
  fn k_chance(k : FeatureKind) : Float do match k do FeatureKind(_, _, _, _, v) -> v end end

  fn p_xm(p : Placed) : Float do match p do Placed(v, _, _, _, _) -> v end end
  fn p_zm(p : Placed) : Float do match p do Placed(_, v, _, _, _) -> v end end
  fn p_index(p : Placed) : Int do match p do Placed(_, _, v, _, _) -> v end end
  fn p_rot(p : Placed) : Int do match p do Placed(_, _, _, v, _) -> v end end
  fn p_stream(p : Placed) : Int do match p do Placed(_, _, _, _, v) -> v end end

  pfn cell_key(v : Float, cell : Float) : Int do float_to_int(Math.floor(v /. cell)) end

  doc "The placement of cell (cx, cz) for seed, or None when the cell holds none; density (x, z) -> [0, 1] multiplies the kind's chance."
  fn at_cell(k : FeatureKind, seed : Int, cx : Int, cz : Int, density : Float -> Float -> Float) : Option(Placed) do
    let cell = k_cell(k)
    let h0 = Strata.Seed.cell(seed, k_salt(k), cx, 0, cz)
    let h1 = Strata.Seed.next(h0)
    let h2 = Strata.Seed.next(h1)
    let h3 = Strata.Seed.next(h2)
    let h4 = Strata.Seed.next(h3)
    let h5 = Strata.Seed.next(h4)
    let xm = (int_to_float(cx) +. 0.5 +. (Strata.Seed.unit(h1) -. 0.5) *. k_jitter(k)) *. cell
    let zm = (int_to_float(cz) +. 0.5 +. (Strata.Seed.unit(h2) -. 0.5) *. k_jitter(k)) *. cell
    if Strata.Seed.unit(h0) < k_chance(k) *. density(xm, zm) do
      Some(Placed(xm, zm, h4, int_and(int_shr(h3, 20), 3), h5))
    else None end
  end

  pfn walk(k : FeatureKind, seed : Int, cx0 : Int, cx1 : Int, cx : Int, cz : Int, cz1 : Int, density : Float -> Float -> Float, acc : List(Placed)) : List(Placed) do
    if cz > cz1 do List.reverse(acc)
    else if cx > cx1 do walk(k, seed, cx0, cx1, cx0, cz + 1, cz1, density, acc)
    else
      match at_cell(k, seed, cx, cz, density) do
        Some(p) -> walk(k, seed, cx0, cx1, cx + 1, cz, cz1, density, Cons(p, acc))
        None -> walk(k, seed, cx0, cx1, cx + 1, cz, cz1, density, acc)
      end
    end end
  end

  doc "The placements of every cell overlapping the box x0..x1, z0..z1 (metres, inclusive) grown by the kind's radius, cells in rows of increasing z, x increasing within a row. density (x, z) -> [0, 1] multiplies the chance; index and stream are Seed values for the game."
  fn candidates(k : FeatureKind, seed : Int, x0 : Float, z0 : Float, x1 : Float, z1 : Float, density : Float -> Float -> Float) : List(Placed) do
    let r = k_radius(k)
    let cell = k_cell(k)
    let cx0 = cell_key(x0 -. r, cell)
    walk(k, seed, cx0, cell_key(x1 +. r, cell), cx0, cell_key(z0 -. r, cell), cell_key(z1 +. r, cell), density, Nil)
  end
end
