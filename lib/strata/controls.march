-- Immediate-mode controls. The caller owns focus and pointer capture.
mod Strata.Controls do
  alias Strata.Ui as U
  alias Strata.Text as T

  doc "Return the nearest step under a pointer. Positions outside the track clamp to the ends."
  fn slider_step(pointer : Float, left : Float, width : Float, steps : Int) : Int do
    if width <= 0.0 || steps <= 1 do 0 else
      let fraction = (pointer -. left) /. width
      let position = if fraction < 0.0 do 0.0 else if fraction > 1.0 do 1.0 else fraction end end
      float_to_int(position *. int_to_float(steps - 1) +. 0.5)
    end
  end

  doc "Draw a slider track and thumb at [step], with [steps] positions."
  fn slider(u : Strata.Ui.Ui, x : Float, y : Float, width : Float, step : Int, steps : Int,
    track : (Float, Float, Float, Float), thumb : (Float, Float, Float, Float)) : Strata.Ui.Ui do
    let position = if steps <= 1 do 0.0 else int_to_float(step) /. int_to_float(steps - 1) end
    let position = if position < 0.0 do 0.0 else if position > 1.0 do 1.0 else position end end
    let u = U.rect(u, 0, x, y +. 7.0, width, 4.0, track)
    U.rect(u, 0, x -. 6.0 +. position *. width, y +. 1.0, 12.0, 16.0, thumb)
  end

  doc "Draw a single-line field, with an end caret while focused."
  fn text_field(u : Strata.Ui.Ui, x : Float, y : Float, width : Float, height : Float,
    text : String, focused : Bool, background : (Float, Float, Float, Float),
    foreground : (Float, Float, Float, Float), size : Float) : Strata.Ui.Ui do
    let u = U.rect(u, 0, x, y, width, height, background)
    T.text(u, 0, x +. 10.0, y +. (height -. size) *. 0.5, T.default_font(), size, foreground,
      text ++ (if focused do "|" else "" end))
  end

  doc "Encode a nonnegative integer in uppercase base 36."
  fn base36(value : Int) : String do
    if value <= 0 do "0" else base36_digits(value, "") end
  end
  pfn base36_digits(n : Int, out : String) : String do
    if n <= 0 do out else
      let digit = n % 36
      let ch = char_from_int(if digit < 10 do 48 + digit else 65 + digit - 10 end)
      base36_digits(n / 36, string_from_chars([ch]) ++ out)
    end
  end

  doc "Apply rising key bits 0..35 as base-36 digits and bit 36 as backspace, bounded by [maximum]."
  fn base36_input(now : Int, old : Int, i : Int, value : Int, maximum : Int) : Int do
    if i >= 37 do value else
      let hit = int_and(now, int_shl(1, i)) != 0 && int_and(old, int_shl(1, i)) == 0
      let next = if !hit do value else if i == 36 do value / 36
        else if value <= (maximum - i) / 36 do value * 36 + i else value end end end
      base36_input(now, old, i + 1, next, maximum)
    end
  end
end
