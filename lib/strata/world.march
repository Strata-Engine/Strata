-- World — the loaded chunks and what must outlive them.
--
-- A world holds the registry, the terrain generator, the seed and the voxel
-- scale it was made with, the chunks currently loaded, and three things
-- that persist while a chunk is away:
--
--   * the cache: chunks that were unloaded while they differed from their
--     generation. A chunk nobody edited is dropped, because it generates
--     again identically; an edited one waits here and is restored when the
--     world returns to it. (Nothing is written to disk yet, so the cache
--     only grows.)
--   * pending edits: edits made to a chunk that was not loaded. They are
--     queued on its key, in order, and applied when it arrives.
--   * for each loaded chunk, the hash it generated to, so a chunk edited
--     back to its generated state is recognised and dropped again.
--
-- Chunks of every level (Strata.Coord) share the one store. Only level 0 is
-- edited. A coarser chunk shows the edited level-0 chunks under it (loaded
-- and edited, or cached) coarsened and laid over what it generated to
-- (`coarsen`). The laying over is a pure function (`coarsen_over`) of the
-- generated chunk and the fine chunks `edits_under` captures, so Strata.Stream
-- runs it on a worker and `insert` puts a coarse chunk as it is given. An
-- edit to a level-0 chunk marks its ancestors, up to the generator's level,
-- stale (`stale`), and Strata.Stream builds them again. A coarse chunk is
-- never cached: it is made again from its generator and the edits.
--
-- Loading policy lives in Strata.Stream; editing in Strata.Edit.
mod Strata.World do

  alias Strata.Chunk as Ck
  alias Strata.Store as Sr
  alias Strata.Coord as Kd

  -- An edit in world voxel coordinates, as queued for a chunk that is away.
  type Op = OpCell(Int, Int, Int, Int)                    -- x, y, z, id
          | OpBox(Int, Int, Int, Int, Int, Int, Int)      -- low corner, high corner, id
          | OpSphere(Int, Int, Int, Int, Int)             -- centre, radius, id

  fn op_cell(x : Int, y : Int, z : Int, id : Int) : Op do OpCell(x, y, z, id) end
  fn op_box(x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, id : Int) : Op do OpBox(x0, y0, z0, x1, y1, z1, id) end
  fn op_sphere(cx : Int, cy : Int, cz : Int, radius : Int, id : Int) : Op do OpSphere(cx, cy, cz, radius, id) end

  doc "An op's tag (0 cell, 1 box, 2 sphere) and its Ints in constructor order, as op_cell, op_box and op_sphere take them."
  fn op_fields(o : Op) : (Int, List(Int)) do
    match o do
      OpCell(x, y, z, id) -> (0, [x, y, z, id])
      OpBox(x0, y0, z0, x1, y1, z1, id) -> (1, [x0, y0, z0, x1, y1, z1, id])
      OpSphere(cx, cy, cz, r, id) -> (2, [cx, cy, cz, r, id])
    end
  end

  -- registry, generator, seed, scale, loaded chunks, generation hashes,
  -- chunks touched since they loaded, cache, pending edits (newest first),
  -- coarse keys made stale by edits
  type World = World(Strata.Blocks.Registry, Strata.Terrain.Gen, Int, Float, Strata.Store.Store(Strata.Chunk.Chunk), Strata.Store.Store(Int), Strata.Store.Store(Bool), Strata.Store.Store(Strata.Chunk.Chunk), Strata.Store.Store(List(Op)), Strata.Store.Store(Bool))

  doc "An empty world: no chunk loaded. [scale] is metres per voxel."
  fn new(r : Strata.Blocks.Registry, g : Strata.Terrain.Gen, seed : Int, scale : Float) : World do
    World(r, g, seed, scale, Sr.empty(Ck.uniform(0)), Sr.empty(-1), Sr.empty(false), Sr.empty(Ck.uniform(0)), Sr.empty(Nil), Sr.empty(false))
  end

  fn registry(w : World) : Strata.Blocks.Registry do match w do World(r, _, _, _, _, _, _, _, _, _) -> r end end
  fn terrain(w : World) : Strata.Terrain.Gen do match w do World(_, g, _, _, _, _, _, _, _, _) -> g end end
  fn seed(w : World) : Int do match w do World(_, _, s, _, _, _, _, _, _, _) -> s end end
  doc "Metres per voxel."
  fn scale(w : World) : Float do match w do World(_, _, _, sc, _, _, _, _, _, _) -> sc end end
  doc "The loaded chunks. An absent key reads as an air chunk."
  fn chunks(w : World) : Strata.Store.Store(Strata.Chunk.Chunk) do match w do World(_, _, _, _, cs, _, _, _, _, _) -> cs end end
  fn is_loaded(w : World, k : Strata.Coord.Key) : Bool do Sr.has(chunks(w), k) end
  fn loaded_count(w : World) : Int do Sr.size(chunks(w)) end
  doc "How many edited chunks wait in the cache."
  fn cache_size(w : World) : Int do match w do World(_, _, _, _, _, _, _, ca, _, _) -> Sr.size(ca) end end
  doc "How many chunks have edits queued for their arrival."
  fn pending_size(w : World) : Int do match w do World(_, _, _, _, _, _, _, _, pe, _) -> Sr.size(pe) end end

  doc "The block at world voxel (x, y, z); air when its chunk is not loaded."
  fn get_block(w : World, x : Int, y : Int, z : Int) : Int do
    Ck.get_or(Sr.get(chunks(w), Kd.key_of_voxel(x, y, z)), Kd.local_of(x), Kd.local_of(y), Kd.local_of(z), 0)
  end

  -- ── Applying an edit to one chunk ────────────────────────────────────────
  pfn lo(a : Int, b : Int) : Int do if a < b do a else b end end
  pfn hi(a : Int, b : Int) : Int do if a > b do a else b end end

  pfn sphere_x(c : Strata.Chunk.Chunk, x : Int, x1 : Int, y : Int, z : Int, ox : Int, oy : Int, oz : Int, cx : Int, cy : Int, cz : Int, rr : Int, id : Int) : Strata.Chunk.Chunk do
    if x > x1 do c
    else
      let dx = ox + x - cx
      let dy = oy + y - cy
      let dz = oz + z - cz
      let i = x + 32 * (z + 32 * y)
      if dx * dx + dy * dy + dz * dz <= rr && i >= 0 && i < 32768 do sphere_x(Ck.set_idx(c, i, id), x + 1, x1, y, z, ox, oy, oz, cx, cy, cz, rr, id)
      else sphere_x(c, x + 1, x1, y, z, ox, oy, oz, cx, cy, cz, rr, id) end
    end
  end
  pfn sphere_z(c : Strata.Chunk.Chunk, x0 : Int, x1 : Int, y : Int, z : Int, z1 : Int, ox : Int, oy : Int, oz : Int, cx : Int, cy : Int, cz : Int, rr : Int, id : Int) : Strata.Chunk.Chunk do
    if z > z1 do c else sphere_z(sphere_x(c, x0, x1, y, z, ox, oy, oz, cx, cy, cz, rr, id), x0, x1, y, z + 1, z1, ox, oy, oz, cx, cy, cz, rr, id) end
  end
  pfn sphere_y(c : Strata.Chunk.Chunk, x0 : Int, x1 : Int, y : Int, y1 : Int, z0 : Int, z1 : Int, ox : Int, oy : Int, oz : Int, cx : Int, cy : Int, cz : Int, rr : Int, id : Int) : Strata.Chunk.Chunk do
    if y > y1 do c else sphere_y(sphere_z(c, x0, x1, y, z0, z1, ox, oy, oz, cx, cy, cz, rr, id), x0, x1, y + 1, y1, z0, z1, ox, oy, oz, cx, cy, cz, rr, id) end
  end

  doc "The chunk at [k] after [op], which is in world voxel coordinates and is clipped to the chunk."
  fn apply_op(c : Strata.Chunk.Chunk, k : Strata.Coord.Key, op : Op) : Strata.Chunk.Chunk do
    let ox = 32 * Kd.kx(k)
    let oy = 32 * Kd.ky(k)
    let oz = 32 * Kd.kz(k)
    match op do
      OpCell(x, y, z, id) -> Ck.fill_box(c, x - ox, y - oy, z - oz, x - ox, y - oy, z - oz, id)
      OpBox(x0, y0, z0, x1, y1, z1, id) -> Ck.fill_box(c, x0 - ox, y0 - oy, z0 - oz, x1 - ox, y1 - oy, z1 - oz, id)
      OpSphere(cx, cy, cz, r, id) ->
        if r < 0 do c
        else
          let x0 = hi(cx - r - ox, 0)
          let x1 = lo(cx + r - ox, 31)
          let y0 = hi(cy - r - oy, 0)
          let y1 = lo(cy + r - oy, 31)
          let z0 = hi(cz - r - oz, 0)
          let z1 = lo(cz + r - oz, 31)
          if x0 > x1 || y0 > y1 || z0 > z1 do c
          else sphere_y(c, x0, x1, y0, y1, z0, z1, ox, oy, oz, cx, cy, cz, r * r, id) end
        end
    end
  end

  -- queued newest first: apply the tail before the head
  pfn apply_queued(c : Strata.Chunk.Chunk, k : Strata.Coord.Key, ops : List(Op)) : Strata.Chunk.Chunk do
    match ops do
      Nil -> c
      Cons(op, older) -> apply_op(apply_queued(c, k, older), k, op)
    end
  end

  -- ── Levels: coarsening edits into ancestors ──────────────────────────────
  pfn pow2(l : Int) : Int do if l <= 0 do 1 else 2 * pow2(l - 1) end end
  -- floor(v / d) for d > 0, any sign
  pfn fdiv(v : Int, d : Int) : Int do if v >= 0 do v / d else 0 - ((d - 1 - v) / d) end end

  -- the ancestors of k up to level top, the coarsest first
  pfn ancestors(k : Strata.Coord.Key, top : Int, acc : List(Strata.Coord.Key)) : List(Strata.Coord.Key) do
    if Kd.level(k) >= top do acc
    else
      let p = Kd.parent(k)
      ancestors(p, top, Cons(p, acc))
    end
  end

  -- mark the ancestors of an edited level-0 chunk k stale, up to the generator's level
  pfn mark(st : Strata.Store.Store(Bool), g : Strata.Terrain.Gen, k : Strata.Coord.Key) : Strata.Store.Store(Bool) do
    if Kd.level(k) != 0 do st
    else List.fold_left(ancestors(k, Strata.Terrain.max_level(g), Nil), st, fn (acc, p) -> Sr.put(acc, p, true)) end
  end

  doc "The coarse keys whose chunks edits have made stale since `clear_stale`: every ancestor, up to the generator's level, of a level-0 chunk an edit changed (loaded or not). Strata.Stream builds the loaded ones again."
  fn stale(w : World) : List(Strata.Coord.Key) do match w do World(_, _, _, _, _, _, _, _, _, st) -> Sr.keys(st) end end

  doc "The world with no key stale."
  fn clear_stale(w : World) : World do
    match w do World(r, g, sd, sc, cs, gh, tc, ca, pe, _) -> World(r, g, sd, sc, cs, gh, tc, ca, pe, Sr.empty(false)) end
  end

  -- is level-0 key f under the level-l key k (n = 2^l level-0 chunks a side)?
  pfn under(k : Strata.Coord.Key, n : Int, f : Strata.Coord.Key) : Bool do
    if Kd.level(f) != 0 do false
    else if fdiv(Kd.kx(f), n) != Kd.kx(k) do false
    else if fdiv(Kd.ky(f), n) != Kd.ky(k) do false
    else fdiv(Kd.kz(f), n) == Kd.kz(k) end end end
  end

  -- A level-0 chunk that may be edited, as captured for coarsening: its key,
  -- its content, and the hash it generated to (-1 for a cached chunk, which
  -- is edited by definition). Whether a loaded one still differs from its
  -- generation is decided where it is coarsened, not where it is captured.
  type Fine = Fine(Strata.Coord.Key, Strata.Chunk.Chunk, Int)

  doc "The level-0 chunks under key [k] that may be edited: every loaded chunk touched since it loaded, and every cached chunk. A walk of the touched and cached keys, no voxel read or hash: cheap enough for the caller's thread. `coarsen_over` decides which differ."
  fn edits_under(w : World, k : Strata.Coord.Key) : List(Fine) do
    let l = Kd.level(k)
    if l <= 0 || l > 5 do Nil
    else
      let n = pow2(l)
      match w do
        World(_, _, _, _, cs, gh, tc, ca, _, _) ->
          let loaded = Sr.fold(tc, Nil, fn (acc, f, _t) -> if under(k, n, f) do Cons(Fine(f, Sr.get(cs, f), Sr.get(gh, f)), acc) else acc end)
          Sr.fold(ca, loaded, fn (acc, f, c) -> if under(k, n, f) do Cons(Fine(f, c, -1), acc) else acc end)
      end
    end
  end

  -- A voxel's rank in coarsening: 2 a solid opaque cube, 1 a fluid or another
  -- cube (glass, leaves, water that is not a fluid), 0 air, a cross, a model
  -- or nothing drawn; and the id it stands as (a fluid as its family's full voxel).
  pfn rank(r : Strata.Blocks.Registry, id : Int) : Int do
    if id <= 0 do 0
    else if Strata.Blocks.is_fluid(r, id) do 1
    else if Strata.Blocks.style_index(r, id) != 0 do 0
    else if Strata.Blocks.is_solid_opaque(r, id) do 2
    else 1 end end end end
  end
  pfn stands_as(r : Strata.Blocks.Registry, id : Int) : Int do
    if Strata.Blocks.is_fluid(r, id) do Strata.Blocks.with_state(r, id, 7) else id end
  end

  -- The registry read once a coarsening into an array the task owns (GAPS
  -- S15): for each registered id, 4 * the id it stands as + its rank.
  pfn table_go(r : Strata.Blocks.Registry, t : NativeIntArr, id : Int, n : Int) : NativeIntArr do
    if id >= n do t else table_go(r, NativeArray.set_int(t, id, 4 * stands_as(r, id) + rank(r, id)), id + 1, n) end
  end
  pfn table(r : Strata.Blocks.Registry) : NativeIntArr do
    let n = Strata.Blocks.count(r)
    table_go(r, NativeArray.make_int(if n < 1 do 1 else n end, 0), 0, n)
  end
  -- an id's entry: an unregistered id is air
  pfn entry(tab : NativeIntArr, id : Int) : Int do
    if id <= 0 do 0 else if id >= NativeArray.length_int(tab) do 0 else NativeArray.get_int(tab, id) end end
  end

  -- one more of id in the tally
  pfn tally(l : List((Int, Int)), id : Int) : List((Int, Int)) do
    match l do
      Nil -> Cons((id, 1), Nil)
      Cons((i, n), t) -> if i == id do Cons((i, n + 1), t) else Cons((i, n), tally(t, id)) end
    end
  end
  -- the winner of a tally of table entries: the highest rank, then the most common, a tie to the lower id; air when nothing ranks
  pfn best(l : List((Int, Int)), bid : Int, brank : Int, bn : Int) : Int do
    match l do
      Nil -> bid
      Cons((e, n), t) ->
        let k = e % 4
        let i = e / 4
        if k == 0 do best(t, bid, brank, bn)
        else if k > brank do best(t, i, k, n)
        else if k < brank do best(t, bid, brank, bn)
        else if n > bn do best(t, i, k, n)
        else if n == bn && i < bid do best(t, i, k, n)
        else best(t, bid, brank, bn) end end end end end
    end
  end
  pfn cube_go(tab : NativeIntArr, c : Strata.Chunk.Chunk, x0 : Int, y0 : Int, z0 : Int, s : Int, t : Int, acc : List((Int, Int))) : List((Int, Int)) do
    if t >= s * s * s do acc
    else cube_go(tab, c, x0, y0, z0, s, t + 1, tally(acc, entry(tab, Ck.get_or(c, x0 + t % s, y0 + t / (s * s), z0 + (t / s) % s, 0))))
    end
  end
  -- the coarse id of the s-cube from (x0, y0, z0) of c
  pfn cube_id(tab : NativeIntArr, c : Strata.Chunk.Chunk, x0 : Int, y0 : Int, z0 : Int, s : Int) : Int do
    let u = Ck.uniform_id(c)
    let e = if u >= 0 do entry(tab, u) else 0 end
    if u < 0 do best(cube_go(tab, c, x0, y0, z0, s, 0, Nil), 0, 0, 0)
    else if e % 4 == 0 do 0
    else e / 4 end end
  end

  -- lay the coarsening of level-0 chunk f (content c) into a, the flat voxels of level-l key k
  pfn lay_go(tab : NativeIntArr, a : NativeI32Arr, c : Strata.Chunk.Chunk, s : Int, n : Int, ox : Int, oy : Int, oz : Int, t : Int) : NativeI32Arr do
    if t >= n * n * n do a
    else
      let i = t % n
      let m = (t / n) % n
      let j = t / (n * n)
      lay_go(tab, NativeArray.set_i32(a, (ox + i) + 32 * ((oz + m) + 32 * (oy + j)), cube_id(tab, c, i * s, j * s, m * s, s)), c, s, n, ox, oy, oz, t + 1)
    end
  end
  pfn lay(tab : NativeIntArr, a : NativeI32Arr, k : Strata.Coord.Key, f : Strata.Coord.Key, c : Strata.Chunk.Chunk) : NativeI32Arr do
    let s = pow2(Kd.level(k))
    let n = 32 / s
    lay_go(tab, a, c, s, n, (Kd.kx(f) - s * Kd.kx(k)) * n, (Kd.ky(f) - s * Kd.ky(k)) * n, (Kd.kz(f) - s * Kd.kz(k)) * n, 0)
  end

  pfn lay_all(tab : NativeIntArr, k : Strata.Coord.Key, a : NativeI32Arr, fs : List(Fine)) : NativeI32Arr do
    match fs do
      Nil -> a
      Cons(Fine(f, c, _), t) -> lay_all(tab, k, lay(tab, a, k, f, c), t)
    end
  end

  -- the captured fine chunks that are edited: cached, or differing from their generation
  pfn edited(fs : List(Fine)) : List(Fine) do
    List.fold_left(fs, Nil, fn (acc, p) -> match p do Fine(f, c, h) -> if h < 0 do Cons(p, acc) else if Ck.hash(c) != h do Cons(p, acc) else acc end end end)
  end

  doc "The coarse chunk of key [k] (level L, 1..5): [generated] with each edited chunk of [fines] (from `edits_under`; a loaded one is edited if it differs from its generation hash) coarsened over it. Each coarse voxel such a chunk covers takes its 2^L cube's: the most common solid opaque cube block if there is one; else the most common fluid (as its family's full voxel) or other cube block; else air (crosses and models count as air). A tie goes to the lower id. Pure, for a worker task (registry [r])."
  fn coarsen_over(r : Strata.Blocks.Registry, k : Strata.Coord.Key, generated : Strata.Chunk.Chunk, fines : List(Fine)) : Strata.Chunk.Chunk do
    let l = Kd.level(k)
    if l <= 0 || l > 5 do generated
    else
      let n = pow2(l)
      let mine = List.fold_left(fines, Nil, fn (acc, p) -> match p do Fine(f, _, _) -> if under(k, n, f) do Cons(p, acc) else acc end end)
      match edited(mine) do
        Nil -> generated
        fs -> Ck.from_flat(lay_all(table(r), k, Ck.to_flat(generated), fs))
      end
    end
  end

  doc "The chunk of key [k] as the world shows it: what the generator makes for it with the edited level-0 chunks under it coarsened over it (`coarsen_over`). Edits queued for a chunk not yet loaded are not in it. A level-0 key, or one above level 5 (a level-0 chunk smaller than a voxel), is the generated chunk alone."
  fn coarsen(w : World, k : Strata.Coord.Key) : Strata.Chunk.Chunk do coarsen_over(registry(w), k, Strata.Terrain.run(terrain(w), k, seed(w)), edits_under(w, k)) end

  doc "The hash the loaded chunk at [k] generated to, as `insert_hashed` was given it (for a coarse chunk, the hash of what was put); -1 when it is not loaded."
  fn gen_hash(w : World, k : Strata.Coord.Key) : Int do match w do World(_, _, _, _, _, gh, _, _, _, _) -> Sr.get(gh, k) end end

  -- ── Loading and unloading ────────────────────────────────────────────────
  doc "Load the chunk at [k], given what the generator produced for it. A cached edited chunk takes the generated one's place, and edits queued for the key are applied (its ancestors are then stale). A coarser chunk is put as it is given, with no coarsening here: give it `coarsen`'s or `coarsen_over`'s chunk to show the edits under it."
  fn insert(w : World, k : Strata.Coord.Key, generated : Strata.Chunk.Chunk) : World do insert_hashed(w, k, generated, Ck.hash(generated)) end

  doc "As `insert`, for a caller that has already hashed the generated chunk (`Strata.Chunk.hash`): the stream's workers do, so the hash is not paid for on the caller's thread."
  fn insert_hashed(w : World, k : Strata.Coord.Key, generated : Strata.Chunk.Chunk, hash : Int) : World do
    if Kd.level(k) > 0 do
      match w do
        World(r, g, sd, sc, cs, gh, tc, ca, pe, st) -> World(r, g, sd, sc, Sr.put(cs, k, generated), Sr.put(gh, k, hash), Sr.remove(tc, k), ca, pe, st)
      end
    else
      match w do
        World(r, g, sd, sc, cs, gh, tc, ca, pe, st) ->
          let cached = Sr.has(ca, k)
          let base = if cached do Sr.get(ca, k) else generated end
          let queued = Sr.get(pe, k)
          let had_queue = match queued do
            Nil -> false
            _ -> true
          end
          let c = apply_queued(base, k, queued)
          World(r, g, sd, sc, Sr.put(cs, k, c), Sr.put(gh, k, hash), if cached || had_queue do Sr.put(tc, k, true) else Sr.remove(tc, k) end, Sr.remove(ca, k), Sr.remove(pe, k), if had_queue do mark(st, g, k) else st end)
      end
    end
  end

  -- Does the loaded chunk at k differ from what it generated to? Only a
  -- chunk touched since it loaded is hashed (GAPS S16: not behind &&).
  pfn differs(cs : Strata.Store.Store(Strata.Chunk.Chunk), gh : Strata.Store.Store(Int), tc : Strata.Store.Store(Bool), k : Strata.Coord.Key) : Bool do
    if !Sr.get(tc, k) do false else Ck.hash(Sr.get(cs, k)) != Sr.get(gh, k) end
  end

  doc "Unload the chunk at [k]. One that differs from its generation moves to the cache; any other is dropped (a coarse chunk always is). Unloading a chunk that is not loaded changes nothing."
  fn unload(w : World, k : Strata.Coord.Key) : World do
    match w do
      World(r, g, sd, sc, cs, gh, tc, ca, pe, st) ->
        if !Sr.has(cs, k) do w
        else
          let ca2 = if differs(cs, gh, tc, k) do Sr.put(ca, k, Ck.compact(Sr.get(cs, k))) else ca end
          World(r, g, sd, sc, Sr.remove(cs, k), Sr.remove(gh, k), Sr.remove(tc, k), ca2, pe, st)
        end
    end
  end

  doc "Has the chunk at [k] been edited: loaded and different from its generation, waiting in the cache, or with edits queued?"
  fn is_edited(w : World, k : Strata.Coord.Key) : Bool do
    match w do
      World(_, _, _, _, cs, gh, tc, ca, pe, _) ->
        if Sr.has(cs, k) do differs(cs, gh, tc, k) else Sr.has(ca, k) || Sr.has(pe, k) end
    end
  end

  doc "The world with every loaded chunk that does not differ from its generation dropped (every coarse chunk among them) and generator [g] in place of its own: edited chunks stay loaded, the cache and queued edits are kept, nothing is stale. Returns the world and the dropped keys; a stream loads them again from [g]."
  fn regenerate(w : World, g : Strata.Terrain.Gen) : (World, List(Strata.Coord.Key)) do
    match w do
      World(r, _, sd, sc, cs, gh, tc, ca, pe, _) ->
        let gone = Sr.fold(cs, Nil, fn (acc, k, _c) -> if differs(cs, gh, tc, k) do acc else Cons(k, acc) end)
        let w2 = List.fold_left(gone, World(r, g, sd, sc, cs, gh, tc, ca, pe, Sr.empty(false)), fn (acc, k) -> unload(acc, k))
        (w2, gone)
    end
  end

  -- ── What Strata.Edit builds on ───────────────────────────────────────────
  doc "Replace the loaded chunk at [k] and mark it touched, and its ancestors stale. Nothing happens if [k] is not loaded."
  fn replace_chunk(w : World, k : Strata.Coord.Key, c : Strata.Chunk.Chunk) : World do
    match w do
      World(r, g, sd, sc, cs, gh, tc, ca, pe, st) ->
        if !Sr.has(cs, k) do w
        else World(r, g, sd, sc, Sr.put(cs, k, c), gh, Sr.put(tc, k, true), ca, pe, mark(st, g, k)) end
    end
  end

  doc "Queue [op] for the chunk at [k], to be applied when it is inserted."
  fn enqueue(w : World, k : Strata.Coord.Key, op : Op) : World do
    match w do
      World(r, g, sd, sc, cs, gh, tc, ca, pe, st) -> World(r, g, sd, sc, cs, gh, tc, ca, Sr.put(pe, k, Cons(op, Sr.get(pe, k))), st)
    end
  end
end
