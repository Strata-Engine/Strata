-- Entities — a game's players, creatures and bullets as rows in C columns,
-- reached by id. The rows live in the C kernel (native/strata_ent.h, through
-- Strata.Ffi.Ent); this module keeps what March needs beside them: the kinds
-- the world was opened with, its body budget, and whether it is open.
--
-- A kind is pure data, made with `kind()` and the `with_` functions in the
-- style of Strata.Blocks, and given to `open`. Entities are added, read and
-- written one at a time, or a kind's whole column at once (`column`,
-- `set_column`), in "dense order": add order until a removal, after which the
-- kind's last entity takes the removed one's place.
--
-- One world per process: `open` makes it (closing any open one), `close`
-- frees it. Every call on a world that is not open is ignored or answers the
-- defaults, as does any call naming a dead or unknown id (position 0, kind
-- -1, slots 0, `alive` false); a write the kernel refuses changes nothing and
-- is counted in `stats`. An id is an Int; -1 is "none".
--
-- A consumer lists native/strata_ent.c in its own [ffi] sources (GAPS S11).
-- `spawn` is a March keyword, so an entity is made with `add` (GAPS S22).
mod Strata.Entities do

  needs IO.Foreign
  needs Ent

  alias Strata.Ffi.Ent as Fen

  -- field names carry `en_` so no other record shares them (GAPS S18, S19)
  type Kind = { en_mover : Int, en_unseen : Int, en_divisor : Int, en_fslots : Int, en_islots : Int,
                en_hx : Float, en_hy : Float, en_hz : Float, en_step : Float, en_gravity : Float, en_lifetime : Float, en_seen : Float }

  type Entities = { en_kinds : List(Kind), en_bodies : Int, en_live : Bool }

  doc "A placed kind with no parts, live when unseen at divisor 1, no lifetime, no slots, seen at the world's seen cap."
  fn kind() : Kind do
    { en_mover: 0, en_unseen: 0, en_divisor: 1, en_fslots: 0, en_islots: 0,
      en_hx: 0.0, en_hy: 0.0, en_hz: 0.0, en_step: 0.0, en_gravity: 0.0, en_lifetime: 0.0, en_seen: 0.0 }
  end

  doc "The kind moved by [mover] (`placed`, `flying`, `walking`, `bodied`) with a box of half extents (hx, hy, hz) metres, a step height in metres, and [gravity] in m/s2 (0 for none)."
  fn with_mover(k : Kind, mover : Int, hx : Float, hy : Float, hz : Float, step_height : Float, gravity : Float) : Kind do
    { k with en_mover: mover, en_hx: hx, en_hy: hy, en_hz: hz, en_step: step_height, en_gravity: gravity }
  end
  doc "Not moved by Strata: the game sets its position."
  fn placed() : Int do 0 end
  doc "Position advances by velocity."
  fn flying() : Int do 1 end
  doc "A box swept against the blocks, with gravity and a step height."
  fn walking() : Int do 2 end
  doc "Goes where its physics body goes (the body comes with a later `with_` function)."
  fn bodied() : Int do 3 end

  doc "What the kind's entities do unseen: [rule] `lives`, `freezes` or `goes`; living ones are stepped every [divisor]th tick."
  fn with_unseen(k : Kind, rule : Int, divisor : Int) : Kind do { k with en_unseen: rule, en_divisor: divisor } end
  fn lives() : Int do 0 end
  fn freezes() : Int do 1 end
  fn goes() : Int do 2 end

  doc "Entities of the kind are removed [seconds] after they are added; 0 or less for never."
  fn with_lifetime(k : Kind, seconds : Float) : Kind do { k with en_lifetime: seconds } end
  doc "Each entity of the kind holds [floats] float slots and [ints] int slots, at most 8 of each."
  fn with_slots(k : Kind, floats : Int, ints : Int) : Kind do { k with en_fslots: floats, en_islots: ints } end
  doc "The kind is seen within [metres] of a focus; 0 or less for the world's seen cap, the most allowed."
  fn with_seen_distance(k : Kind, metres : Float) : Kind do { k with en_seen: metres } end

  -- finite, and finite still once stored as a 32-bit float
  pfn finite32(v : Float) : Bool do
    if float_is_nan(v) do false else Math.abs(v) <= 340282346638528859811704183484516925440.0 end
  end
  pfn in_range(v : Int, lo : Int, hi : Int) : Bool do v >= lo && v <= hi end

  doc "Whether `open` would accept the kind, as far as can be told without a world: the kernel's checks, and a walking box with no zero half extent. A seen distance past the world's seen cap is found only by `open`."
  fn valid(k : Kind) : Bool do
    let ints_ok = in_range(k.en_mover, 0, 2) && in_range(k.en_unseen, 0, 2) && k.en_divisor >= 1
      && in_range(k.en_fslots, 0, 8) && in_range(k.en_islots, 0, 8)
    let finite = finite32(k.en_hx) && finite32(k.en_hy) && finite32(k.en_hz) && finite32(k.en_step)
      && finite32(k.en_gravity) && finite32(k.en_lifetime) && finite32(k.en_seen)
    let signs = k.en_hx >= 0.0 && k.en_hy >= 0.0 && k.en_hz >= 0.0 && k.en_step >= 0.0
    let box = if k.en_mover == 2 do k.en_hx > 0.0 && k.en_hy > 0.0 && k.en_hz > 0.0 else true end
    ints_ok && finite && signs && box
  end

  -- the kernel's kind ints and floats, in en_kind's order
  pfn kind_ints(k : Kind) : NativeI32Arr do
    NativeArray.from_list_i32([k.en_mover, k.en_unseen, k.en_divisor, k.en_fslots, k.en_islots, if k.en_gravity != 0.0 do 1 else 0 end, 0, 0, 0])
  end
  pfn kind_floats(k : Kind) : NativeF32Arr do
    NativeArray.from_list_f32([k.en_hx, k.en_hy, k.en_hz, k.en_step, k.en_lifetime, k.en_seen, k.en_gravity])
  end
  -- register every kind in order; false at the first refused (or invalid) one
  pfn kinds_go(ks : List(Kind), i : Int) : Bool do
    match ks do
      Nil -> true
      Cons(k, rest) -> if !valid(k) do false else if Fen.kind(kind_ints(k), kind_floats(k)) != i do false else kinds_go(rest, i + 1) end end
    end
  end

  doc "Open the entity world (closing any open one) with [kinds], numbered 0, 1, ... in order: [capacity] entities (0 or less for 65,536; at most 1,048,576), a body budget of [bodies] (0 or less for 128), and the stream's horizontal radius in chunks and chunk and voxel sizes in metres. Kinds are seen at most (radius_h - 2) chunks away. Not open (`is_open` false) if any kind is refused or the world cannot be made."
  fn open(kinds : List(Kind), capacity : Int, bodies : Int, radius_h : Int, chunk_metres : Float, voxel_metres : Float) : Entities do
    let cap = if capacity <= 0 do 65536 else capacity end
    let budget = if bodies <= 0 do 128 else bodies end
    let seen = int_to_float(radius_h - 2) *. chunk_metres
    let seen_cap = if seen < chunk_metres do chunk_metres else seen end
    let made = Fen.open(cap, 262144, budget, seen_cap, chunk_metres, voxel_metres)
    let ok = if made do kinds_go(kinds, 0) else false end
    if made && !ok do Strata.Ffi.Ent.close() else () end
    { en_kinds: kinds, en_bodies: budget, en_live: ok }
  end

  doc "Free the entity world. Its entities are gone; open again to start over."
  fn close(e : Entities) : Entities do
    if e.en_live do Strata.Ffi.Ent.close() else () end
    { e with en_live: false }
  end

  doc "False if any kind was refused, the kernel could not allocate, or the world was closed."
  fn is_open(e : Entities) : Bool do e.en_live end

  doc "A new entity of [kind] at (x, y, z) metres facing [facing] radians about the vertical. Answers its id, or -1 if refused (no such kind, a number not finite, or the world full)."
  fn add(e : Entities, kind : Int, x : Float, y : Float, z : Float, facing : Float) : (Entities, Int) do
    if e.en_live do (e, Fen.add(kind, x, y, z, facing)) else (e, -1) end
  end

  doc "Remove entity [id]. Its id stops matching at once."
  fn remove(e : Entities, id : Int) : Entities do
    if e.en_live do Strata.Ffi.Ent.remove(id) else () end
    e
  end

  fn alive(e : Entities, id : Int) : Bool do if e.en_live do Fen.alive(id) else false end end
  doc "The kind of entity [id]; -1 if it is not alive."
  fn kind_of(e : Entities, id : Int) : Int do if e.en_live do Fen.kind_of(id) else -1 end end

  pfn three(e : Entities, id : Int, which : Int) : (Float, Float, Float) do
    if e.en_live do (Fen.get(id, which, 0), Fen.get(id, which, 1), Fen.get(id, which, 2)) else (0.0, 0.0, 0.0) end
  end
  pfn one(e : Entities, id : Int, which : Int) : Float do if e.en_live do Fen.get(id, which, 0) else 0.0 end end
  pfn put(e : Entities, id : Int, which : Int, x : Float, y : Float, z : Float) : Entities do
    if e.en_live do Strata.Ffi.Ent.set(id, which, x, y, z) else () end
    e
  end

  doc "Entity [id]'s position in metres."
  fn position(e : Entities, id : Int) : (Float, Float, Float) do three(e, id, 0) end
  fn set_position(e : Entities, id : Int, x : Float, y : Float, z : Float) : Entities do put(e, id, 0, x, y, z) end
  doc "Entity [id]'s velocity in metres a second."
  fn velocity(e : Entities, id : Int) : (Float, Float, Float) do three(e, id, 1) end
  fn set_velocity(e : Entities, id : Int, x : Float, y : Float, z : Float) : Entities do put(e, id, 1, x, y, z) end
  doc "Entity [id]'s facing, radians about the vertical."
  fn facing(e : Entities, id : Int) : Float do one(e, id, 2) end
  fn set_facing(e : Entities, id : Int, a : Float) : Entities do put(e, id, 2, a, 0.0, 0.0) end
  doc "Seconds since entity [id] was added. Only the kernel advances it."
  fn age(e : Entities, id : Int) : Float do one(e, id, 3) end

  doc "Float slot [n] of entity [id]; 0 past its kind's slots."
  fn float(e : Entities, id : Int, n : Int) : Float do if e.en_live do Fen.float(id, n) else 0.0 end end
  fn set_float(e : Entities, id : Int, n : Int, v : Float) : Entities do
    if e.en_live do Strata.Ffi.Ent.set_float(id, n, v) else () end
    e
  end
  doc "Int slot [n] of entity [id]; 0 past its kind's slots."
  fn int(e : Entities, id : Int, n : Int) : Int do if e.en_live do Fen.int(id, n) else 0 end end
  fn set_int(e : Entities, id : Int, n : Int, v : Int) : Entities do
    if e.en_live do Strata.Ffi.Ent.set_int(id, n, v) else () end
    e
  end

  doc "The live ids of [kind] in dense order: exactly as many as are live, empty if none."
  fn each(e : Entities, kind : Int) : NativeIntArr do
    let n = if e.en_live do Fen.count(kind) else 0 end
    let out = NativeArray.make_int(n, -1)
    if n == 0 do out
    else
      let written = Fen.each(kind, out)
      if written == n do out else NativeArray.make_int(0, -1) end
    end
  end

  doc "Column [col] (`col_position`, `col_velocity`, `col_facing`, `col_float(n)`) of every live entity of [kind], in `each`'s order: 3 floats a row for position and velocity, 1 for facing and a slot. Empty for no such kind or column."
  fn column(e : Entities, kind : Int, col : Int) : NativeF32Arr do
    let width = if e.en_live do Fen.column_width(kind, col) else 0 end
    let rows = if width == 0 do 0 else Fen.count(kind) end
    let out = NativeArray.make_f32(rows * width, 0.0)
    if rows == 0 do out
    else
      let written = Fen.column(kind, col, out)
      if written == rows do out else NativeArray.make_f32(0, 0.0) end
    end
  end
  doc "Write column [col] of [kind] from [a], in `each`'s order. [a] must hold a row for every live entity of the kind and every value be finite; otherwise nothing is written and the call is counted."
  fn set_column(e : Entities, kind : Int, col : Int, a : NativeF32Arr) : Entities do
    if e.en_live do Strata.Ffi.Ent.set_column(kind, col, a) else () end
    e
  end
  fn col_position() : Int do 0 end
  fn col_velocity() : Int do 1 end
  fn col_facing() : Int do 2 end
  doc "The column of float slot [n]."
  fn col_float(n : Int) : Int do 10 + n end

  doc "A hash of every live entity: equal call sequences give equal hashes. 0 when not open."
  fn hash(e : Entities) : Int do if e.en_live do Fen.hash() else 0 end end

  doc "(live, seen, waiting for ground, refused calls)."
  fn stats(e : Entities) : (Int, Int, Int, Int) do (float_to_int(stat(e, 0)), float_to_int(stat(e, 1)), float_to_int(stat(e, 2)), float_to_int(stat(e, 3))) end
  doc "A number of the kernel's: 0 live, 1 seen, 2 waiting for ground, 3 refused calls, 4 negative dt, 5 events dropped, 6 the last refusal's reason (EN_R_* in strata_ent.h), 7 over the body budget."
  fn stat(e : Entities, which : Int) : Float do if e.en_live do Fen.stat(which) else 0.0 end end
end
