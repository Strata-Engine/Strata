-- Entities — a game's players, creatures and bullets as rows in C columns,
-- reached by id. The rows live in the C kernel (native/strata_ent.h, through
-- Strata.Ffi.Ent); this module keeps what March needs beside them: the kinds
-- the world was opened with, its body budget, and whether it is open.
--
-- A kind is pure data, made with `kind()` and the `with_` functions in the
-- style of Strata.Blocks, and given to `open`. Entities are added, read and
-- written one at a time, or a kind's whole column at once (`column`,
-- `set_column`), in "dense order": add order until a removal, after which the
-- kind's last entity takes the removed one's place.
--
-- One world per process: `open` makes it (closing any open one), `close`
-- frees it. Every call on a world that is not open is ignored or answers the
-- defaults, as does any call naming a dead or unknown id (position 0, kind
-- -1, slots 0, `alive` false); a write the kernel refuses changes nothing and
-- is counted in `stats`. An id is an Int; -1 is "none".
--
-- The kernel keeps its own copy of the loaded blocks, one bit a voxel: a
-- block stops an entity where `Strata.Blocks.collides` is true and its style
-- is not cross, as its whole cell (a model block too: the one place the
-- kernel differs from `Strata.Query`). `blocks` hands it what
-- `Strata.Stream` loaded, edited and unloaded since the last call; call it
-- once a frame after `Strata.Stream.tick`. `step` runs the kernel's tick:
-- ages and lifetimes, then movement: seen flyers stop at the first block on
-- their way; seen walkers are boxes swept against the blocks with gravity and
-- a step height; unseen walkers follow their routes touching no blocks. Then
-- the seen and unseen switch: an entity near a focus comes into view (a walker
-- set on the true ground first), one gone a chunk past its seen distance
-- leaves it and its kind's unseen rule applies (live, freeze or remove). A
-- route (`route`) is a list of points held by the kernel and shared by any
-- number of followers (`follow`). After movement the tick puts every live entity in a
-- grid of 4 m cells, from which `near` and `raycast` answer until the next
-- tick, and reports a touch for each overlapping pair of kinds declared with
-- `touching`. `events` reads what the last tick reported.
--
-- A kind may have a figure (`with_figure`, a Strata.Anim rig) and up to two
-- voices (`with_sound`). `tick` is `step` plus their upkeep: a seen entity
-- gets its figure and voices as it comes into view (nearest a focus first),
-- they follow it each tick, and they are freed when it leaves view or is
-- removed. The kernel holds the part ids and lists what it took away.
--
-- A bodied kind (`with_driven_body`, `with_dynamic_body`) goes where a
-- Strata.Physics body goes: `tick` gives seen ones bodies within the body
-- budget set at `open`, nearest a focus first, drives a driven body by the
-- entity's velocity and reads a dynamic one back, and removes the body when
-- the entity leaves view or is removed. Without a body it stays where it is.
--
-- `snapshot` copies the whole entity world into three native arrays and
-- `restore` rebuilds it from them, every entity unseen; `restore_with` and
-- `close_with` first free the parts entities hold.
--
-- A consumer lists native/strata_ent.c in its own [ffi] sources (GAPS S11).
-- `spawn` is a March keyword, so an entity is made with `add` (GAPS S22).
mod Strata.Entities do

  needs IO.Foreign
  needs Ent
  needs Anim

  alias Strata.Ffi.Ent as Fen

  -- field names carry `en_` so no other record shares them (GAPS S18, S19)
  -- en_figure: the rig of its figure, -1 none; en_sounds: (source, group, gain) of each voice, at most two;
  -- en_body: 0 none, 1 driven (a box of the kind's half extents), 2 dynamic (en_grid's blocks)
  type Kind = { en_mover : Int, en_unseen : Int, en_divisor : Int, en_fslots : Int, en_islots : Int,
                en_hx : Float, en_hy : Float, en_hz : Float, en_step : Float, en_gravity : Float, en_lifetime : Float, en_seen : Float,
                en_figure : Int, en_sounds : List((Int, Int, Float)), en_body : Int, en_grid : Strata.Body.Grid }

  -- en_table: the block table has been sent to the kernel
  type Entities = { en_kinds : List(Kind), en_bodies : Int, en_live : Bool, en_table : Bool }

  doc "A placed kind with no parts, live when unseen at divisor 1, no lifetime, no slots, seen at the world's seen cap."
  fn kind() : Kind do
    { en_mover: 0, en_unseen: 0, en_divisor: 1, en_fslots: 0, en_islots: 0,
      en_hx: 0.0, en_hy: 0.0, en_hz: 0.0, en_step: 0.0, en_gravity: 0.0, en_lifetime: 0.0, en_seen: 0.0,
      en_figure: -1, en_sounds: Nil, en_body: 0, en_grid: Strata.Body.grid(1, 1, 1) }
  end

  doc "The kind moved by [mover] (`placed`, `flying`, `walking`, `bodied`) with a box of half extents (hx, hy, hz) metres, a step height in metres, and [gravity] in m/s2 (0 for none)."
  fn with_mover(k : Kind, mover : Int, hx : Float, hy : Float, hz : Float, step_height : Float, gravity : Float) : Kind do
    { k with en_mover: mover, en_hx: hx, en_hy: hy, en_hz: hz, en_step: step_height, en_gravity: gravity }
  end
  doc "Not moved by Strata: the game sets its position."
  fn placed() : Int do 0 end
  doc "Position advances by velocity."
  fn flying() : Int do 1 end
  doc "A box swept against the blocks, with gravity and a step height. A seen walker whose box would reach above (or below) the chunks the kernel holds does not move that tick: size the stream's vertical radius to the terrain."
  fn walking() : Int do 2 end
  doc "Goes where its physics body goes: set by `with_driven_body` or `with_dynamic_body`, and valid only with one of them."
  fn bodied() : Int do 3 end

  doc "The kind is bodied: while seen (and within the body budget) each entity has a driven `Strata.Physics` body, a box of half extents (hx, hy, hz) metres centred on it, moved each tick by `Strata.Physics.drive` at the entity's velocity (no gravity is added: the game puts what it wants in the velocity); the entity stands where the drive leaves the box's centre. The box is also the entity's own (`near`, `raycast`, touches)."
  fn with_driven_body(k : Kind, hx : Float, hy : Float, hz : Float) : Kind do
    { k with en_mover: 3, en_hx: hx, en_hy: hy, en_hz: hz, en_body: 1 }
  end
  doc "The kind is bodied: while seen (and within the body budget) each entity has a dynamic `Strata.Physics` body of the blocks in [g], added at rest with its centre of mass on the entity and turned by the entity's facing about +y; each tick the entity's position is the body's centre of mass after the latest step (its facing is left as it is). The kind's half extents (0 unless `with_mover` set them first) are the entity's own box."
  fn with_dynamic_body(k : Kind, g : Strata.Body.Grid) : Kind do
    { k with en_mover: 3, en_body: 2, en_grid: g }
  end

  doc "What the kind's entities do unseen: [rule] `lives`, `freezes` or `goes`; living ones are stepped every [divisor]th tick."
  fn with_unseen(k : Kind, rule : Int, divisor : Int) : Kind do { k with en_unseen: rule, en_divisor: divisor } end
  fn lives() : Int do 0 end
  fn freezes() : Int do 1 end
  fn goes() : Int do 2 end

  doc "Entities of the kind are removed [seconds] after they are added; 0 or less for never."
  fn with_lifetime(k : Kind, seconds : Float) : Kind do { k with en_lifetime: seconds } end
  doc "Each entity of the kind holds [floats] float slots and [ints] int slots, at most 8 of each."
  fn with_slots(k : Kind, floats : Int, ints : Int) : Kind do { k with en_fslots: floats, en_islots: ints } end
  doc "The kind is seen within [metres] of a focus; 0 or less for the world's seen cap, the most allowed."
  fn with_seen_distance(k : Kind, metres : Float) : Kind do { k with en_seen: metres } end
  doc "While seen, each entity of the kind has a figure of [rig] (a rig id of `Strata.Anim`), made by `tick` as it comes into view, kept at its position and facing, and removed as it leaves view or is removed. -1 for none."
  fn with_figure(k : Kind, rig : Int) : Kind do { k with en_figure: rig } end
  doc "While seen, each entity of the kind has a voice playing [source] in [group] at [gain] (`Strata.Sound.play`, pitch 1, priority 1), started by `tick` as it comes into view, kept at its position, and stopped (a 0.1 s fade) as it leaves view or is removed. Up to two a kind; a third makes the kind invalid. Voices are meant to be looping sources: a one-shot voice that ends stays held by its entity (not replayed) until the entity leaves view. A known limit: each voice moved is a `Strata.Sound.move`, O(placed voices), so a tick costs O(V^2) in voiced seen entities, until Strata.Sound gains a batched move."
  fn with_sound(k : Kind, source : Int, group : Int, gain : Float) : Kind do { k with en_sounds: List.append(k.en_sounds, [(source, group, gain)]) } end

  -- finite, and finite still once stored as a 32-bit float
  pfn finite32(v : Float) : Bool do
    if float_is_nan(v) do false else Math.abs(v) <= 340282346638528859811704183484516925440.0 end
  end
  pfn in_range(v : Int, lo : Int, hi : Int) : Bool do v >= lo && v <= hi end
  pfn sound_ok(snd : (Int, Int, Float)) : Bool do match snd do (_, _, gain) -> finite32(gain) end end

  doc "Whether `open` would accept the kind, as far as can be told without a world: the kernel's checks (among them a body exactly when the mover is bodied), a walking or driven box with no zero half extent, and at most two sounds. A seen distance past the world's seen cap is found only by `open`."
  fn valid(k : Kind) : Bool do
    let ints_ok = in_range(k.en_mover, 0, 3) && in_range(k.en_unseen, 0, 2) && in_range(k.en_divisor, 1, 65536)
      && in_range(k.en_fslots, 0, 8) && in_range(k.en_islots, 0, 8)
    let finite = finite32(k.en_hx) && finite32(k.en_hy) && finite32(k.en_hz) && finite32(k.en_step)
      && finite32(k.en_gravity) && finite32(k.en_lifetime) && finite32(k.en_seen)
    let signs = k.en_hx >= 0.0 && k.en_hy >= 0.0 && k.en_hz >= 0.0 && k.en_step >= 0.0
    let boxed = k.en_mover == 2 || k.en_body == 1
    let box = if boxed do k.en_hx > 0.0 && k.en_hy > 0.0 && k.en_hz > 0.0 else true end
    let parts = List.length(k.en_sounds) <= 2 && List.all(k.en_sounds, sound_ok)
    let body = in_range(k.en_body, 0, 2) && (k.en_body != 0) == (k.en_mover == 3)
    ints_ok && finite && signs && box && parts && body
  end

  -- the kernel's kind ints and floats, in en_kind's order
  pfn kind_ints(k : Kind) : NativeI32Arr do
    NativeArray.from_list_i32([k.en_mover, k.en_unseen, k.en_divisor, k.en_fslots, k.en_islots, if k.en_gravity != 0.0 do 1 else 0 end,
      if k.en_figure >= 0 do 1 else 0 end, if k.en_body != 0 do 1 else 0 end, List.length(k.en_sounds)])
  end
  pfn kind_floats(k : Kind) : NativeF32Arr do
    NativeArray.from_list_f32([k.en_hx, k.en_hy, k.en_hz, k.en_step, k.en_lifetime, k.en_seen, k.en_gravity])
  end
  -- register every kind in order; false at the first refused (or invalid) one
  pfn kinds_go(ks : List(Kind), i : Int) : Bool do
    match ks do
      Nil -> true
      Cons(k, rest) -> if !valid(k) do false else if Fen.kind(kind_ints(k), kind_floats(k)) != i do false else kinds_go(rest, i + 1) end end
    end
  end

  doc "Open the entity world (closing any open one) with [kinds], numbered 0, 1, ... in order: [capacity] entities (0 or less for 65,536; at most 1,048,576), a body budget of [bodies] (0 or less for 128: the most physics bodies `tick` gives entities at once; the game's own bodies are outside it), and the stream's horizontal radius in chunks and chunk and voxel sizes in metres. Kinds are seen at most (radius_h - 2) chunks away. Not open (`is_open` false) if any kind is refused or the world cannot be made."
  fn open(kinds : List(Kind), capacity : Int, bodies : Int, radius_h : Int, chunk_metres : Float, voxel_metres : Float) : Entities do
    let cap = if capacity <= 0 do 65536 else capacity end
    let budget = if bodies <= 0 do 128 else bodies end
    let seen = int_to_float(radius_h - 2) *. chunk_metres
    let seen_cap = if seen < chunk_metres do chunk_metres else seen end
    let made = Fen.open(cap, 262144, budget, seen_cap, chunk_metres, voxel_metres)
    let ok = if made do kinds_go(kinds, 0) else false end
    if made && !ok do Strata.Ffi.Ent.close() else () end
    { en_kinds: kinds, en_bodies: budget, en_live: ok, en_table: false }
  end

  doc "Free the entity world. Its entities are gone; open again to start over. It does not free their parts: the figures, bodies and voices entities hold, and those waiting on the release list, stay in Strata.Anim, Strata.Physics and Strata.Sound. A game that gave its entities parts closes with `close_with`."
  fn close(e : Entities) : Entities do
    if e.en_live do Strata.Ffi.Ent.close() else () end
    { e with en_live: false }
  end

  doc "False if any kind was refused, the kernel could not allocate, or the world was closed."
  fn is_open(e : Entities) : Bool do e.en_live end

  doc "A new entity of [kind] at (x, y, z) metres facing [facing] radians about the vertical. Answers its id, or -1 if refused (no such kind, a number not finite, or the world full)."
  fn add(e : Entities, kind : Int, x : Float, y : Float, z : Float, facing : Float) : (Entities, Int) do
    if e.en_live do (e, Fen.add(kind, x, y, z, facing)) else (e, -1) end
  end

  doc "Remove entity [id]. Its id stops matching at once; the next `step` reports the removal (event 6, reason 0)."
  fn remove(e : Entities, id : Int) : Entities do
    if e.en_live do Strata.Ffi.Ent.remove(id) else () end
    e
  end

  fn alive(e : Entities, id : Int) : Bool do if e.en_live do Fen.alive(id) else false end end
  doc "The kind of entity [id]; -1 if it is not alive."
  fn kind_of(e : Entities, id : Int) : Int do if e.en_live do Fen.kind_of(id) else -1 end end

  pfn three(e : Entities, id : Int, which : Int) : (Float, Float, Float) do
    if e.en_live do (Fen.get(id, which, 0), Fen.get(id, which, 1), Fen.get(id, which, 2)) else (0.0, 0.0, 0.0) end
  end
  pfn one(e : Entities, id : Int, which : Int) : Float do if e.en_live do Fen.get(id, which, 0) else 0.0 end end
  pfn put(e : Entities, id : Int, which : Int, x : Float, y : Float, z : Float) : Entities do
    if e.en_live do Strata.Ffi.Ent.set(id, which, x, y, z) else () end
    e
  end

  doc "Entity [id]'s position in metres."
  fn position(e : Entities, id : Int) : (Float, Float, Float) do three(e, id, 0) end
  doc "Set entity [id]'s position. A bodied entity holding a body is overwritten from its body each `tick`: teleport a driven body with `Strata.Physics.place_driven` (the body's id from `body`)."
  fn set_position(e : Entities, id : Int, x : Float, y : Float, z : Float) : Entities do put(e, id, 0, x, y, z) end
  doc "Entity [id]'s velocity in metres a second."
  fn velocity(e : Entities, id : Int) : (Float, Float, Float) do three(e, id, 1) end
  doc "Set entity [id]'s velocity. For a bodied entity holding a body it only steers a driven body (moved at it each `tick`); the position is overwritten from the body each `tick`, so a driven body is teleported with `Strata.Physics.place_driven`, and a dynamic body moves as physics moves it."
  fn set_velocity(e : Entities, id : Int, x : Float, y : Float, z : Float) : Entities do put(e, id, 1, x, y, z) end
  doc "Entity [id]'s facing, radians about the vertical."
  fn facing(e : Entities, id : Int) : Float do one(e, id, 2) end
  fn set_facing(e : Entities, id : Int, a : Float) : Entities do put(e, id, 2, a, 0.0, 0.0) end
  doc "Seconds since entity [id] was added. Only the kernel advances it."
  fn age(e : Entities, id : Int) : Float do one(e, id, 3) end

  doc "Float slot [n] of entity [id]; 0 past its kind's slots."
  fn float(e : Entities, id : Int, n : Int) : Float do if e.en_live do Fen.float(id, n) else 0.0 end end
  fn set_float(e : Entities, id : Int, n : Int, v : Float) : Entities do
    if e.en_live do Strata.Ffi.Ent.set_float(id, n, v) else () end
    e
  end
  doc "Int slot [n] of entity [id]; 0 past its kind's slots."
  fn int(e : Entities, id : Int, n : Int) : Int do if e.en_live do Fen.int(id, n) else 0 end end
  fn set_int(e : Entities, id : Int, n : Int, v : Int) : Entities do
    if e.en_live do Strata.Ffi.Ent.set_int(id, n, v) else () end
    e
  end

  doc "The live ids of [kind] in dense order: exactly as many as are live, empty if none."
  fn each(e : Entities, kind : Int) : NativeIntArr do
    let n = if e.en_live do Fen.count(kind) else 0 end
    let out = NativeArray.make_int(n, -1)
    if n == 0 do out
    else
      let written = Fen.each(kind, out)
      if written == n do out else NativeArray.make_int(0, -1) end
    end
  end

  doc "Column [col] (`col_position`, `col_velocity`, `col_facing`, `col_float(n)`) of every live entity of [kind], in `each`'s order: 3 floats a row for position and velocity, 1 for facing and a slot. Empty for no such kind or column."
  fn column(e : Entities, kind : Int, col : Int) : NativeF32Arr do
    let width = if e.en_live do Fen.column_width(kind, col) else 0 end
    let rows = if width == 0 do 0 else Fen.count(kind) end
    let out = NativeArray.make_f32(rows * width, 0.0)
    if rows == 0 do out
    else
      let written = Fen.column(kind, col, out)
      if written == rows do out else NativeArray.make_f32(0, 0.0) end
    end
  end
  doc "Write column [col] of [kind] from [a], in `each`'s order. [a] must hold a row for every live entity of the kind and every value be finite; otherwise nothing is written and the call is counted."
  fn set_column(e : Entities, kind : Int, col : Int, a : NativeF32Arr) : Entities do
    if e.en_live do Strata.Ffi.Ent.set_column(kind, col, a) else () end
    e
  end
  fn col_position() : Int do 0 end
  fn col_velocity() : Int do 1 end
  fn col_facing() : Int do 2 end
  doc "The column of float slot [n]."
  fn col_float(n : Int) : Int do 10 + n end

  doc "A hash of what a snapshot holds (every live entity, its route progress and its frozen and waiting state, the routes, the free rows and their generations, the tick counter) and the entities' part ids: equal call sequences give equal hashes. Not covered: seen state, blocks, touch pairs, events and stats. 0 when not open."
  fn hash(e : Entities) : Int do if e.en_live do Fen.hash() else 0 end end

  doc "(live, seen, waiting for ground, refused calls)."
  fn stats(e : Entities) : (Int, Int, Int, Int) do (float_to_int(stat(e, 0)), float_to_int(stat(e, 1)), float_to_int(stat(e, 2)), float_to_int(stat(e, 3))) end
  doc "A number of the kernel's: 0 live, 1 seen, 2 waiting for ground, 3 refused calls, 4 negative dt, 5 events (and part releases) dropped, 6 the last refusal's reason (EN_R_* in strata_ent.h), 7 seen entities wanting a body that the budget left without one at the last `tick` (not summed), 8 route points held, 9 routes held (a freed route still followed is held), 10 + k figures `tick` could not make for kind k (Strata.Anim full) since `open`."
  fn stat(e : Entities, which : Int) : Float do if e.en_live do Fen.stat(which) else 0.0 end end

  -- ── Blocks ───────────────────────────────────────────────────────────────
  -- [v], once [used] is computed: keeps a kernel call's answer in use so the
  -- call made only for its effect is not dropped (GAPS S9)
  pfn after(used : Int, v : a) : a do if used >= 0 do v else v end end

  -- a byte an id: 1 where the block stops an entity (collides, and not a cross)
  pfn table_go(a : NativeU8Arr, r : Strata.Blocks.Registry, i : Int, n : Int) : NativeU8Arr do
    if i >= n do a
    else
      let stops = if Strata.Blocks.collides(r, i) do Strata.Blocks.style_index(r, i) != 1 else false end
      table_go(if stops do NativeArray.set_u8(a, i, 1) else a end, r, i + 1, n)
    end
  end
  -- the block table, sent once, on the first call that hands over blocks
  pfn with_table(e : Entities, r : Strata.Blocks.Registry) : Entities do
    if e.en_table do e
    else
      let n = Strata.Blocks.count(r)
      let sent = Fen.block_table(table_go(NativeArray.make_u8(if n < 1 do 1 else n end, 0), r, 0, n))
      if sent >= 0 do { e with en_table: true } else e end
    end
  end
  -- hand the kernel one chunk: a uniform one by its id, any other by its flat ids; 1 if held
  pfn send_chunk(k : Strata.Coord.Key, c : Strata.Chunk.Chunk) : Int do
    let u = Strata.Chunk.uniform_id(c)
    if u >= 0 do Fen.chunk_uniform(Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), u)
    else Fen.chunk(Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k), Strata.Chunk.to_flat(c)) end
  end
  -- the changed keys: each loaded one sent, any other dropped
  pfn send_go(w : Strata.World.World, ks : List(Strata.Coord.Key), n : Int) : Int do
    match ks do
      Nil -> n
      Cons(k, t) ->
        let one = if Strata.World.is_loaded(w, k) do send_chunk(k, Strata.Store.get(Strata.World.chunks(w), k))
          else Fen.chunk_drop(Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k)) end
        send_go(w, t, n + one)
    end
  end
  pfn drop_go(ks : List(Strata.Coord.Key), n : Int) : Int do
    match ks do
      Nil -> n
      Cons(k, t) -> drop_go(t, n + Fen.chunk_drop(Strata.Coord.kx(k), Strata.Coord.ky(k), Strata.Coord.kz(k)))
    end
  end

  doc "Bring the kernel's copy of the blocks up to date with [s]: each chunk loaded or edited since the last call is sent, each chunk unloaded is dropped (`Strata.Stream.take_changed`). The first call after `open` also sends the block table, from the stream's registry, and every chunk the stream holds loaded, the changed sets taken and set aside, so a world opened again on a stream already taken from holds exactly the loaded chunks. Call once a frame after `Strata.Stream.tick`."
  fn blocks(e : Entities, s : Strata.Stream.Stream) : (Entities, Strata.Stream.Stream) do
    if !e.en_live do (e, s)
    else if !e.en_table do
      let w = Strata.Stream.world(s)
      let e1 = with_table(e, Strata.World.registry(w))
      let held = Strata.Store.fold(Strata.World.chunks(w), 0, fn (n, k, c) -> n + send_chunk(k, c))
      let (s1, changed, gone) = Strata.Stream.take_changed(s)
      after(held + List.length(changed) + List.length(gone), (e1, s1))
    else
      let (s1, changed, gone) = Strata.Stream.take_changed(s)
      let held = send_go(Strata.Stream.world(s1), changed, 0) + drop_go(gone, 0)
      after(held, (e, s1))
    end end
  end

  doc "Send every loaded chunk of [w] to the kernel (and the block table, if not yet sent). For tests and tools; a game streams with `blocks`."
  fn blocks_world(e : Entities, w : Strata.World.World) : Entities do
    if !e.en_live do e
    else
      let e1 = with_table(e, Strata.World.registry(w))
      let held = Strata.Store.fold(Strata.World.chunks(w), 0, fn (n, k, c) -> n + send_chunk(k, c))
      after(held, e1)
    end
  end

  -- ── The tick ─────────────────────────────────────────────────────────────
  -- points as 3 Floats each into [a], from index 3 i (focus points and route points)
  pfn focus_go(a : NativeFloatArr, ps : List((Float, Float, Float)), i : Int) : NativeFloatArr do
    match ps do
      Nil -> a
      Cons((x, y, z), t) -> focus_go(NativeArray.set_float(NativeArray.set_float(NativeArray.set_float(a, 3 * i, x), 3 * i + 1, y), 3 * i + 2, z), t, i + 1)
    end
  end

  doc "The kernel's tick alone, [dt] seconds, with the [focus] points in metres: ages and lifetimes (a frozen entity does not age), then movement (placed entities stay; flying ones move by their velocity, with gravity if the kind asks, and while seen stop at the first block in their way, reporting it; seen walking ones are swept against the blocks with gravity and their kind's step height, moved by their velocity or steered along their route, and held where they are for a tick whose step would enter a chunk not loaded; unseen walking ones follow their route touching no blocks, or stay). Unseen entities of a kind with tick divisor n move on every nth tick by n times dt. Then the seen and unseen switch, measured horizontally from the nearest focus: an unseen entity within its kind's seen distance becomes seen (event 3), a walker only once the chunks 16 m above and below it are loaded and it has been set on the nearest ground within 16 m up or down (until then it waits where it is, counted in stat 2); a seen one more than one chunk's side beyond that distance becomes unseen (event 4), then its kind's rule: it lives on, freezes (no movement, no ageing) until seen again, or is removed (event 6, reason 2). With no focus nothing is seen. Then the grid `near` and `raycast` read, and a touch event for each overlapping pair of declared kinds. A negative dt is counted (stat 4) and moves nothing. No figures, bodies or voices: those come with `tick`."
  fn step(e : Entities, focus : List((Float, Float, Float)), dt : Float) : Entities do
    if !e.en_live do e
    else
      let n = List.length(focus)
      let written = Fen.tick(focus_go(NativeArray.make_float(3 * n, 0.0), focus, 0), dt)
      after(written, e)
    end
  end

  -- ── Figures and voices ───────────────────────────────────────────────────
  doc "Entity [id]'s figure (a `Strata.Anim` figure), or -1: none while it is unseen, or when its kind has none or Strata.Anim was full."
  fn figure(e : Entities, id : Int) : Int do if e.en_live do Fen.part(id, 0) else -1 end end
  doc "Entity [id]'s voice [n] (0 or 1, a `Strata.Sound` voice), or -1."
  fn voice(e : Entities, id : Int, n : Int) : Int do if e.en_live do (if n == 0 || n == 1 do Fen.part(id, 2 + n) else -1 end) else -1 end end
  doc "Entity [id]'s body (a `Strata.Physics` body id), or -1: none while it is unseen, over the body budget, after its body was lost (until it leaves view), or when its kind has none."
  fn body(e : Entities, id : Int) : Int do if e.en_live do Fen.part(id, 1) else -1 end end

  pfn kind_at(ks : List(Kind), i : Int) : Option(Kind) do
    match ks do
      Nil -> None
      Cons(k, t) -> if i <= 0 do Some(k) else kind_at(t, i - 1) end
    end
  end
  pfn sound_at(ss : List((Int, Int, Float)), i : Int) : Option((Int, Int, Float)) do
    match ss do
      Nil -> None
      Cons(x, t) -> if i <= 0 do Some(x) else sound_at(t, i - 1) end
    end
  end

  -- the release list, drained: figures removed, bodies removed, voices stopped
  pfn release_go(codes : NativeI32Arr, ids : NativeIntArr, i : Int, n : Int, p : Strata.Physics.Physics, a : Strata.Anim.Anim, s : Strata.Sound.Sound) : (Strata.Physics.Physics, Strata.Anim.Anim, Strata.Sound.Sound) do
    if i >= n do (p, a, s)
    else
      let code = NativeArray.get_i32(codes, i)
      let id = NativeArray.get_int(ids, i)
      let a1 = if code == 0 do Strata.Anim.remove(a, id) else a end
      let p1 = if code == 1 do Strata.Physics.remove(p, id) else p end
      let s1 = if code == 2 || code == 3 do Strata.Sound.stop(s, id, 0.1) else s end
      release_go(codes, ids, i + 1, n, p1, a1, s1)
    end
  end
  pfn released(p : Strata.Physics.Physics, a : Strata.Anim.Anim, s : Strata.Sound.Sound) : (Strata.Physics.Physics, Strata.Anim.Anim, Strata.Sound.Sound) do
    let n = Fen.release_count()
    if n == 0 do (p, a, s)
    else
      let codes = NativeArray.make_i32(n, 0)
      let ids = NativeArray.make_int(n, -1)
      release_go(codes, ids, 0, Fen.releases(codes, ids), p, a, s)
    end
  end

  -- the seen entities wanting [part], nearest a focus first
  pfn wanting(part : Int) : NativeIntArr do
    let n = Fen.wanting(part, NativeArray.make_int(0, -1))
    let out = NativeArray.make_int(n, -1)
    if n == 0 do out else if Fen.wanting(part, out) == n do out else NativeArray.make_int(0, -1) end end
  end

  -- a figure for each entity wanting one: made where it stands, turned by its facing; a refusal counted for its kind
  pfn figures_go(e : Entities, ids : NativeIntArr, i : Int, a : Strata.Anim.Anim) : Strata.Anim.Anim do
    if i >= NativeArray.length_int(ids) do a
    else
      let id = NativeArray.get_int(ids, i)
      let k = Fen.kind_of(id)
      let rig = match kind_at(e.en_kinds, k) do
        Some(kd) -> kd.en_figure
        None -> -1
      end
      let (x, y, z) = position(e, id)
      let (a1, fig) = Strata.Anim.spawn_at(a, rig, x, y, z, Strata.Math.Quat.from_axis_angle(0.0, 1.0, 0.0, facing(e, id)))
      let used = if fig >= 0 do Fen.set_part(id, 0, fig) else Fen.figure_refused(k) end
      figures_go(e, ids, i + 1, after(used, a1))
    end
  end

  -- voice [n] for each entity wanting one: its kind's nth sound, played where it stands; a refused play leaves it to the next tick
  pfn voices_go(e : Entities, n : Int, ids : NativeIntArr, i : Int, s : Strata.Sound.Sound) : Strata.Sound.Sound do
    if i >= NativeArray.length_int(ids) do s
    else
      let id = NativeArray.get_int(ids, i)
      let snd = match kind_at(e.en_kinds, Fen.kind_of(id)) do
        Some(kd) -> sound_at(kd.en_sounds, n)
        None -> None
      end
      match snd do
        None -> voices_go(e, n, ids, i + 1, s)
        Some((src, group, gain)) ->
          let (x, y, z) = position(e, id)
          let (s1, v) = Strata.Sound.play(s, src, group, x, y, z, gain, 1.0, 1.0)
          let used = if v > 0 do Fen.set_part(id, 2 + n, v) else 0 end
          voices_go(e, n, ids, i + 1, after(used, s1))
      end
    end
  end

  -- ── Bodies ───────────────────────────────────────────────────────────────
  pfn body_kind(e : Entities, id : Int) : Kind do
    match kind_at(e.en_kinds, Fen.kind_of(id)) do
      Some(kd) -> kd
      None -> kind()
    end
  end

  -- the seen entities holding a body, by entity id
  pfn body_holders() : NativeIntArr do
    let n = Fen.holding(1, NativeArray.make_int(0, -1))
    let out = NativeArray.make_int(n, -1)
    if n == 0 do out else if Fen.holding(1, out) == n do out else NativeArray.make_int(0, -1) end end
  end

  -- each held body: one physics has lost is reported (event 7); a driven one is driven by the entity's velocity and the
  -- entity set at the swept centre; a dynamic one's centre of mass is copied to the entity
  pfn bodies_go(e : Entities, w : Strata.World.World, ids : NativeIntArr, i : Int, p : Strata.Physics.Physics, dt : Float) : (Entities, Strata.Physics.Physics) do
    if i >= NativeArray.length_int(ids) do (e, p)
    else
      let id = NativeArray.get_int(ids, i)
      let b = Fen.part(id, 1)
      let kd = body_kind(e, id)
      if !Strata.Physics.exists(p, b) do bodies_go(e, w, ids, i + 1, after(Fen.body_lost(id), p), dt)
      else if kd.en_body == 1 do
        let (vx, vy, vz) = velocity(e, id)
        let (p1, sw) = Strata.Physics.drive(p, w, b, vx, vy, vz, dt)
        let e1 = put(e, id, 0, Strata.Query.swept_x(sw), Strata.Query.swept_y(sw), Strata.Query.swept_z(sw))
        bodies_go(e1, w, ids, i + 1, p1, dt)
      else
        let (x, y, z) = Strata.Physics.position(p, b)
        bodies_go(put(e, id, 0, x, y, z), w, ids, i + 1, p, dt)
      end end
    end
  end

  -- a body for the entity: a driven box centred on it, or its kind's grid with the centre of mass on it, turned by its facing
  pfn body_for(e : Entities, w : Strata.World.World, id : Int, p : Strata.Physics.Physics) : (Strata.Physics.Physics, Int) do
    let kd = body_kind(e, id)
    let (x, y, z) = position(e, id)
    if kd.en_body == 1 do Strata.Physics.add_driven(p, x, y, z, kd.en_hx, kd.en_hy, kd.en_hz)
    else
      let q = Strata.Math.Quat.from_axis_angle(0.0, 1.0, 0.0, facing(e, id))
      let (cx, cy, cz) = Strata.Body.centre(Strata.Body.mass_of(Strata.World.registry(w), kd.en_grid, Strata.World.scale(w)))
      let c = Strata.Math.Quat.rotate(q, Strata.Math.Vec3.new(cx, cy, cz))
      Strata.Physics.add(p, kd.en_grid, x -. Strata.Math.Vec3.x(c), y -. Strata.Math.Vec3.y(c), z -. Strata.Math.Vec3.z(c), q, Strata.Physics.dynamic())
    end
  end
  -- bodies for the first [n] of [ids] (nearest a focus first)
  pfn grants_go(e : Entities, w : Strata.World.World, ids : NativeIntArr, i : Int, n : Int, p : Strata.Physics.Physics) : Strata.Physics.Physics do
    if i >= n do p
    else
      let id = NativeArray.get_int(ids, i)
      let (p1, b) = body_for(e, w, id, p)
      grants_go(e, w, ids, i + 1, n, after(Fen.set_part(id, 1, b), p1))
    end
  end
  -- bodies for the entities wanting one, nearest first, as far as the budget has room; the rest counted in stat 7
  pfn granted(e : Entities, w : Strata.World.World, p : Strata.Physics.Physics) : Strata.Physics.Physics do
    let want = wanting(1)
    let n = NativeArray.length_int(want)
    let room = e.en_bodies - Fen.holding(1, NativeArray.make_int(0, -1))
    let give = if room < 0 do 0 else if room < n do room else n end end
    after(Fen.body_over(n - give), grants_go(e, w, want, 0, give, p))
  end

  -- the seen entities holding [part]: (how many, their part ids, their poses 7 floats each)
  pfn holders(part : Int) : (Int, NativeI32Arr, NativeF32Arr) do
    let n = Fen.seen_parts(part, NativeArray.make_i32(0, 0), NativeArray.make_f32(0, 0.0))
    let ids = NativeArray.make_i32(n, -1)
    let poses = NativeArray.make_f32(7 * n, 0.0)
    if n == 0 do (0, ids, poses) else (Fen.seen_parts(part, ids, poses), ids, poses) end
  end
  pfn moves_go(ids : NativeI32Arr, poses : NativeF32Arr, i : Int, n : Int, s : Strata.Sound.Sound) : Strata.Sound.Sound do
    if i >= n do s
    else moves_go(ids, poses, i + 1, n, Strata.Sound.move(s, NativeArray.get_i32(ids, i), NativeArray.get_f32(poses, 7 * i), NativeArray.get_f32(poses, 7 * i + 1), NativeArray.get_f32(poses, 7 * i + 2))) end
  end
  pfn moved(part : Int, s : Strata.Sound.Sound) : Strata.Sound.Sound do
    let (n, ids, poses) = holders(part)
    moves_go(ids, poses, 0, n, s)
  end

  doc "A frame's entities, after `blocks`: `step` with [focus] and [dt], then their parts. Every part the step took away (an entity removed by the game since the last tick or in the step, or gone out of view) is freed: its figure removed, its body taken out of [p] (`Strata.Physics.remove`), its voices stopped with a 0.1 s fade. Then each body still held: one [p] no longer has (`Strata.Physics.exists` false: removed, or written into the world as blocks) is cleared and reported as event 7, and the entity, kept, gets no other until it has left view; a driven body is moved by `Strata.Physics.drive` against [w] at the entity's velocity for [dt] and the entity set at the swept box's centre; a dynamic body's centre of mass after the latest finished step (`Strata.Physics.position`) becomes the entity's position. Then every seen bodied entity without a body gets one, nearest a focus first, while the bodies held by entities number fewer than the budget given to `open`: a driven box (`Strata.Physics.add_driven`) centred on it, or its kind's grid (`Strata.Physics.add`) with the centre of mass on it, turned by its facing about +y; how many are left without one this tick is stat 7. A bodied entity without a body does not move (as a placed one). The game still steps physics itself (`Strata.Physics.begin` and `finish`). Every seen entity whose kind has a figure (`with_figure`) and has none yet gets one, nearest a focus first, made at its position turned by its facing about +y; when Strata.Anim is full the entity goes without (stat 10 + its kind counts each refusal) and is tried again next tick. Likewise each voice (`with_sound`), at pitch 1 and priority 1; a refused play is tried again next tick. Then every seen figure is placed at its entity's position and facing (one `Strata.Anim.place_many`) and every voice moved there. The game plays clips on a new figure itself (`figure` after event 3). Bodied entities move after `step` (in the bodies pass above), so the grid (`near`, `raycast`), touches and the seen switch see them where the previous tick left them."
  fn tick(e : Entities, w : Strata.World.World, p : Strata.Physics.Physics, a : Strata.Anim.Anim, s : Strata.Sound.Sound,
          focus : List((Float, Float, Float)), dt : Float) : (Entities, Strata.Physics.Physics, Strata.Anim.Anim, Strata.Sound.Sound) do
    if !e.en_live do (e, p, a, s)
    else
      let e1 = step(e, focus, dt)
      let (p0, a1, s1) = released(p, a, s)
      -- a dt the kernel refused (negative, not finite) drives nothing
      let (e2, pd) = bodies_go(e1, w, body_holders(), 0, p0, if dt > 0.0 && dt <= 1000000.0 do dt else 0.0 end)
      let p1 = granted(e2, w, pd)
      let a2 = figures_go(e2, wanting(0), 0, a1)
      let s2 = voices_go(e2, 1, wanting(3), 0, voices_go(e2, 0, wanting(2), 0, s1))
      let (n, figs, poses) = holders(0)
      let a3 = if n == 0 do a2 else Strata.Anim.place_many(a2, n, figs, poses) end
      (e2, p1, a3, moved(3, moved(2, s2)))
    end
  end

  -- every part held, and every part waiting on the release list, freed: the list drained (so the parts fit on it),
  -- every held part put on it, and drained again
  pfn release_every(p : Strata.Physics.Physics, a : Strata.Anim.Anim, s : Strata.Sound.Sound) : (Strata.Physics.Physics, Strata.Anim.Anim, Strata.Sound.Sound) do
    let (p1, a1, s1) = released(p, a, s)
    after(Fen.release_all(), released(p1, a1, s1))
  end

  doc "`close`, after freeing every part the entities hold and every part waiting on the release list, as `tick` frees them (`Strata.Anim.remove`, `Strata.Physics.remove`, `Strata.Sound.stop` with a 0.1 s fade)."
  fn close_with(e : Entities, p : Strata.Physics.Physics, a : Strata.Anim.Anim, s : Strata.Sound.Sound) : (Entities, Strata.Physics.Physics, Strata.Anim.Anim, Strata.Sound.Sound) do
    if !e.en_live do (e, p, a, s)
    else
      let (p1, a1, s1) = release_every(p, a, s)
      (close(e), p1, a1, s1)
    end
  end

  -- ── Snapshot and restore ─────────────────────────────────────────────────
  -- The whole entity world as three native arrays: ints, floats and doubles, laid out as native/strata_ent_snap.h
  -- describes (the rows in dense order, generations, free rows, routes, the tick counter and the removals not yet
  -- reported). No seen state, parts, events or blocks.
  type Snapshot = Snapshot(NativeI32Arr, NativeF32Arr, NativeFloatArr)

  doc "The snapshot's three arrays: (ints, floats, doubles). Byte for byte what a save or a wire format would carry."
  fn snapshot_arrays(s : Snapshot) : (NativeI32Arr, NativeF32Arr, NativeFloatArr) do match s do Snapshot(i, f, d) -> (i, f, d) end end
  doc "A snapshot from three arrays as `snapshot_arrays` gave them."
  fn snapshot_of(ints : NativeI32Arr, floats : NativeF32Arr, doubles : NativeFloatArr) : Snapshot do Snapshot(ints, floats, doubles) end

  doc "A copy of the whole entity world: every entity's kind, id, position, velocity, facing, age, slots and route progress, in dense order, with the routes, the free rows and generations (so ids handed out before still resolve after a restore), the tick counter and the removals the next `step` will report. Seen state is not kept: a seen entity is copied as leaving view would leave it. Empty arrays when not open."
  fn snapshot(e : Entities) : Snapshot do
    let ni = if e.en_live do Fen.snapshot_size(0) else 0 end
    let ints = NativeArray.make_i32(ni, 0)
    let floats = NativeArray.make_f32(if e.en_live do Fen.snapshot_size(1) else 0 end, 0.0)
    let doubles = NativeArray.make_float(if e.en_live do Fen.snapshot_size(2) else 0 end, 0.0)
    if ni == 0 do Snapshot(ints, floats, doubles)
    else if Fen.snapshot(ints, floats, doubles) == 1 do Snapshot(ints, floats, doubles)
    else Snapshot(NativeArray.make_i32(0, 0), NativeArray.make_f32(0, 0.0), NativeArray.make_float(0, 0.0)) end end
  end

  doc "Rebuild the entity world from [s]: every entity, route and free row as the snapshot holds them, every entity unseen with no parts; the next `tick` gives the near ones their parts back. The kinds are not in the snapshot: the world must have been opened with the same kinds (count and slot counts are checked) and capacity. False, and nothing changed, if the snapshot does not fit (another capacity or kinds, another version, cut short) or while any entity holds a figure, body or voice (use `restore_with`). The block table, the chunks the kernel holds and the touch pairs (`touching`) are kept from the live world, not taken from the snapshot: restoring into a freshly opened world needs its `touching` pairs declared again (and its blocks sent by `blocks`)."
  fn restore(e : Entities, s : Snapshot) : (Entities, Bool) do
    if !e.en_live do (e, false)
    else
      match s do Snapshot(i, f, d) -> (e, Fen.restore(i, f, d) == 1) end
    end
  end

  doc "`restore`, freeing first every part the entities hold and every part waiting on the release list (as `tick` frees them when entities leave view). False, and nothing changed (no part freed), if the snapshot does not fit."
  fn restore_with(e : Entities, s : Snapshot, p : Strata.Physics.Physics, a : Strata.Anim.Anim, snd : Strata.Sound.Sound)
      : (Entities, Bool, Strata.Physics.Physics, Strata.Anim.Anim, Strata.Sound.Sound) do
    if !e.en_live do (e, false, p, a, snd)
    else
      match s do
        Snapshot(i, f, d) ->
          if Fen.snapshot_fits(i, f, d) != 1 do (e, false, p, a, snd)
          else
            let (p1, a1, s1) = release_every(p, a, snd)
            (e, Fen.restore(i, f, d) == 1, p1, a1, s1)
          end
      end
    end
  end

  -- ── Finding and touching ─────────────────────────────────────────────────
  doc "Ask for a touch event (code 1) each tick for each pair of an entity of [kind_a] and one of [kind_b] whose boxes overlap. A moving entity is tested along its whole step (the box it swept), so a fast bullet does not pass through a thin target; when both move, both are swept, so two whose paths pass close at different moments of the step can report a near miss. Declaring a pair again, or in the other order, changes nothing. A pair naming no such kind is refused and counted."
  fn touching(e : Entities, kind_a : Int, kind_b : Int) : Entities do
    if e.en_live do after(Fen.touching(kind_a, kind_b), e) else e end
  end

  doc "The kind mask holding [kinds]: bit k for kind k. Numbers outside 0..61 are left out."
  fn mask(kinds : List(Int)) : Int do
    List.fold_left(kinds, 0, fn (m, k) -> if k >= 0 && k < 62 do int_or(m, int_shl(1, k)) else m end)
  end

  doc "The ids, sorted, of the entities within [radius] metres of (x, y, z) whose kind is in the mask [kinds] (see `mask`), as the last `step` left them: one added since is not found until the next step, one removed since is not found at all. A bodied entity is found where the tick before left it: `tick` moves bodied entities after its `step`. Empty when not open."
  fn near(e : Entities, x : Float, y : Float, z : Float, radius : Float, kinds : Int) : NativeIntArr do
    let n = if e.en_live do Fen.near(x, y, z, radius, kinds, NativeArray.make_int(0, -1)) else 0 end
    let out = NativeArray.make_int(n, -1)
    if n == 0 do out
    else
      let written = Fen.near(x, y, z, radius, kinds, out)
      if written == n do out else NativeArray.make_int(0, -1) end
    end
  end

  doc "The first entity whose box the ray from (ox, oy, oz) along (dx, dy, dz) meets within [max] metres, of a kind in the mask [kinds], as the last `step` left them: (its id, the distance in metres), or (-1, -1.0) for none."
  fn raycast(e : Entities, ox : Float, oy : Float, oz : Float, dx : Float, dy : Float, dz : Float, max : Float, kinds : Int) : (Int, Float) do
    if !e.en_live do (-1, -1.0)
    else
      let t = NativeArray.make_float(1, -1.0)
      let id = Fen.ray_entities(ox, oy, oz, dx, dy, dz, max, kinds, t)
      if id >= 0 do (id, NativeArray.get_float(t, 0)) else (-1, -1.0) end
    end
  end

  -- ── Routes and walking ────────────────────────────────────────────────────
  doc "A route through [points] (metres; 1 to 256 of them), held by the kernel and shared by any number of followers. Answers its id, or -1 if refused: too many or too few points, a point not finite, or no room left in the kernel's pool of 262,144 points (a freed route's points are reused only by a route that fits in them)."
  fn route(e : Entities, points : List((Float, Float, Float))) : (Entities, Int) do
    if !e.en_live do (e, -1)
    else
      let n = List.length(points)
      (e, Fen.route(focus_go(NativeArray.make_float(3 * n, 0.0), points, 0)))
    end
  end

  doc "Free [route]: at once if nothing follows it, else once its last follower stops; from now on no new entity may follow it. Freeing a route not held, or freed already, is refused and counted."
  fn free_route(e : Entities, route : Int) : Entities do
    if e.en_live do after(Fen.route_free(route), e) else e end
  end

  doc "Walking entity [id] follows [route] from its first point at [speed] m/s, measured horizontally, starting again at the first point at the end if [loops]. Seen, it is steered toward each waypoint in turn (reached within 0.25 m) and reports event 8 if it makes no headway for a second; unseen, it moves along the straight lines between the points touching no blocks. At the end of a route that does not loop it reports event 5 and stops. Route -1 stops following. A route not held or freed, a speed negative or not finite, or an entity not walking is refused and counted."
  fn follow(e : Entities, id : Int, route : Int, speed : Float, loops : Bool) : Entities do
    if e.en_live do after(Fen.follow(id, route, speed, if loops do 1 else 0 end), e) else e end
  end

  doc "Whether walking entity [id] stood on something after its last seen step, or was set on the ground as it came into view. False for an unseen walker, or a dead id."
  fn grounded(e : Entities, id : Int) : Bool do if e.en_live do Fen.grounded(id) == 1 else false end end

  doc "Whether entity [id] was seen at the end of the last `step`: it came within its kind's seen distance of a focus (a walker once set on the ground) and has not since gone more than one chunk's side beyond it. False for a dead id, and for every entity before its first step."
  fn seen(e : Entities, id : Int) : Bool do if e.en_live do Fen.seen(id) == 1 else false end end

  -- ── Events ───────────────────────────────────────────────────────────────
  -- code, a, b, i0, i1, i2, i3, x, y, z, and the block (read from the world for a block hit, else -1)
  type Event = EnEvent(Int, Int, Int, Int, Int, Int, Int, Float, Float, Float, Int)

  pfn events_go(ints : NativeIntArr, fl : NativeFloatArr, w : Strata.World.World, i : Int, acc : List(Event)) : List(Event) do
    if i < 0 do acc
    else
      let code = NativeArray.get_int(ints, 7 * i)
      let i0 = NativeArray.get_int(ints, 7 * i + 3)
      let i1 = NativeArray.get_int(ints, 7 * i + 4)
      let i2 = NativeArray.get_int(ints, 7 * i + 5)
      let block = if code == 2 do Strata.World.get_block(w, i0, i1, i2) else -1 end
      let v = EnEvent(code, NativeArray.get_int(ints, 7 * i + 1), NativeArray.get_int(ints, 7 * i + 2), i0, i1, i2, NativeArray.get_int(ints, 7 * i + 6),
        NativeArray.get_float(fl, 3 * i), NativeArray.get_float(fl, 3 * i + 1), NativeArray.get_float(fl, 3 * i + 2), block)
      events_go(ints, fl, w, i - 1, Cons(v, acc))
    end
  end

  doc "What the last `step` reported, in order: removals the game made since the step before (reason 0), then the step's own events; after a `tick`, event 7 (body lost), written by its bodies pass after the step, comes last. A block hit's block is read from [w]. Codes: 1 touch, 2 block hit, 3 entered view, 4 left view, 5 route finished, 6 removed, 7 body lost, 8 blocked."
  fn events(e : Entities, w : Strata.World.World) : List(Event) do
    let n = if e.en_live do Fen.event_count() else 0 end
    if n == 0 do Nil
    else
      let ints = NativeArray.make_int(7 * n, 0)
      let fl = NativeArray.make_float(3 * n, 0.0)
      let got = Fen.events(ints, fl)
      events_go(ints, fl, w, got - 1, Nil)
    end
  end

  doc "The event's code: 1 touch, 2 block hit, 3 entered view, 4 left view, 5 route finished, 6 removed, 7 body lost, 8 blocked."
  fn ev_code(v : Event) : Int do match v do EnEvent(c, _, _, _, _, _, _, _, _, _, _) -> c end end
  doc "The entity the event is about."
  fn ev_a(v : Event) : Int do match v do EnEvent(_, a, _, _, _, _, _, _, _, _, _) -> a end end
  doc "The other entity of a touch; 0 for other events."
  fn ev_b(v : Event) : Int do match v do EnEvent(_, _, b, _, _, _, _, _, _, _, _) -> b end end
  doc "Where, in metres: a block hit's point on the block, a removed entity's last position."
  fn ev_point(v : Event) : (Float, Float, Float) do match v do EnEvent(_, _, _, _, _, _, _, x, y, z, _) -> (x, y, z) end end
  doc "A block hit's voxel; (0, 0, 0) for other events."
  fn ev_voxel(v : Event) : (Int, Int, Int) do
    match v do EnEvent(c, _, _, x, y, z, _, _, _, _, _) -> if c == 2 do (x, y, z) else (0, 0, 0) end end
  end
  doc "A block hit's face (0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z); -1 for other events."
  fn ev_face(v : Event) : Int do match v do EnEvent(c, _, _, _, _, _, f, _, _, _, _) -> if c == 2 do f else -1 end end end
  doc "A block hit's block id, read from the world `events` was given; -1 for other events."
  fn ev_block(v : Event) : Int do match v do EnEvent(_, _, _, _, _, _, _, _, _, _, b) -> b end end
  doc "A removal's reason: 0 the game, 1 its lifetime, 2 the unseen rule; -1 for other events."
  fn ev_reason(v : Event) : Int do match v do EnEvent(c, _, _, r, _, _, _, _, _, _, _) -> if c == 6 do r else -1 end end end
end
