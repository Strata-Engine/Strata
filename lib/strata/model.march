-- Model — the drawing geometry of a model block.
--
-- A model is a list of quads. Each quad is 21 floats: four corners of
-- (x, y, z, u, v), then a texture id. Positions are in cell units, so a
-- block's own cell runs 0..1 on each axis; texture coordinates are in tiles,
-- with v running down the image. Corners go in strip order: 0 and 1 along
-- one edge, 2 and 3 along the opposite one, so the quad is the triangles
-- (0, 1, 2) and (2, 1, 3).
--
-- `floats` gives the form `Strata.Blocks.add_model` keeps and the renderer
-- reads. Collision boxes are separate (Strata.Blocks.Box): what a model
-- looks like and what it stops need not agree.
mod Strata.Model do

  -- the floats, and how many quads they hold
  type Geometry = Geometry(NativeF32Arr, Int)

  doc "No quads."
  fn empty() : Geometry do Geometry(NativeArray.make_f32(0, 0.0), 0) end

  doc "How many quads."
  fn count(g : Geometry) : Int do match g do Geometry(_, n) -> n end end

  doc "The geometry as 21 floats a quad."
  fn floats(g : Geometry) : NativeF32Arr do match g do Geometry(f, _) -> f end end

  pfn copy(dst : NativeF32Arr, at : Int, src : NativeF32Arr, i : Int, n : Int) : NativeF32Arr do
    if i >= n do dst else copy(NativeArray.set_f32(dst, at + i, NativeArray.get_f32(src, i)), at, src, i + 1, n) end
  end

  doc "Add a quad: [corners] is exactly twenty floats, four corners of (x, y, z, u, v) in strip order. An array of any other length leaves the geometry unchanged."
  fn quad(g : Geometry, corners : NativeF32Arr, tex : Int) : Geometry do
    if NativeArray.length_f32(corners) != 20 do g
    else
      match g do
        Geometry(f, n) ->
          let grown = copy(copy(NativeArray.make_f32(21 * (n + 1), 0.0), 0, f, 0, 21 * n), 21 * n, corners, 0, 20)
          Geometry(NativeArray.set_f32(grown, 21 * n + 20, int_to_float(tex)), n + 1)
      end
    end
  end

  pfn corner(a : NativeF32Arr, c : Int, x : Float, y : Float, z : Float, u : Float, v : Float) : NativeF32Arr do
    let o = 5 * c
    NativeArray.set_f32(NativeArray.set_f32(NativeArray.set_f32(NativeArray.set_f32(NativeArray.set_f32(a, o, x), o + 1, y), o + 2, z), o + 3, u), o + 4, v)
  end

  -- One face of a box: the four corners given in strip order, each with its
  -- texture coordinate.
  pfn face(g : Geometry, tex : Int, x0 : Float, y0 : Float, z0 : Float, u0 : Float, v0 : Float, x1 : Float, y1 : Float, z1 : Float, u1 : Float, v1 : Float, x2 : Float, y2 : Float, z2 : Float, u2 : Float, v2 : Float, x3 : Float, y3 : Float, z3 : Float, u3 : Float, v3 : Float) : Geometry do
    let a = corner(corner(corner(corner(NativeArray.make_f32(20, 0.0), 0, x0, y0, z0, u0, v0), 1, x1, y1, z1, u1, v1), 2, x2, y2, z2, u2, v2), 3, x3, y3, z3, u3, v3)
    quad(g, a, tex)
  end

  doc "Add the six faces of the box from (x0, y0, z0) to (x1, y1, z1), all with texture [tex]. Texture coordinates follow the box's size in cells, so a half-height box shows half a tile on its sides."
  fn box(g : Geometry, x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float, tex : Int) : Geometry do
    let w = x1 -. x0
    let h = y1 -. y0
    let d = z1 -. z0
    let top = face(g, tex, x0, y1, z0, 0.0, 0.0, x1, y1, z0, w, 0.0, x0, y1, z1, 0.0, d, x1, y1, z1, w, d)
    let bottom = face(top, tex, x0, y0, z0, 0.0, 0.0, x1, y0, z0, w, 0.0, x0, y0, z1, 0.0, d, x1, y0, z1, w, d)
    let xpos = face(bottom, tex, x1, y0, z0, 0.0, h, x1, y0, z1, d, h, x1, y1, z0, 0.0, 0.0, x1, y1, z1, d, 0.0)
    let xneg = face(xpos, tex, x0, y0, z0, 0.0, h, x0, y0, z1, d, h, x0, y1, z0, 0.0, 0.0, x0, y1, z1, d, 0.0)
    let zpos = face(xneg, tex, x0, y0, z1, 0.0, h, x1, y0, z1, w, h, x0, y1, z1, 0.0, 0.0, x1, y1, z1, w, 0.0)
    face(zpos, tex, x0, y0, z0, 0.0, h, x1, y0, z0, w, h, x0, y1, z0, 0.0, 0.0, x1, y1, z0, w, 0.0)
  end
end
