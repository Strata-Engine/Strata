-- Mesh — the greedy mesher. One chunk in, packed quads out (Strata.Quad),
-- one buffer per render layer, plus one instance per cross or model block
-- and the chunk's occupancy mask.
--
-- The rules:
--   * A face of block A toward neighbour B is drawn when A is a Cube and B
--     is not solid-opaque, unless A and B are the same id (a body of glass
--     has no inner faces). The face goes to A's layer.
--   * A fluid stands as high as its fill level, or full height when the
--     same fluid is above it. A top face's corners dip up to three eighths
--     to meet lower neighbours, so a surface that is not level is drawn as
--     a slope, not as steps; a side face between two voxels of one fluid is
--     drawn only across a bigger difference than that. Inside a column
--     there is no top or bottom face. Each fluid quad carries its drop
--     below the voxel's top.
--   * Each face corner is shaded 0..3 from the three cells around it in the
--     layer the face looks into; only solid-opaque blocks shade, including
--     those in neighbouring chunks.
--   * Two faces merge only when block id, direction and all four corner
--     shades agree.
--   * Cross and Model blocks are one instance each. NoMesh blocks and ids
--     nobody registered draw nothing.
--
-- Meshing reads the chunk's 26 neighbours, so the mesher takes an `Around`:
-- the 27 chunks centred on the one being meshed.
mod Strata.Mesh do

  alias Strata.Chunk as C
  alias Strata.Blocks as B
  alias Strata.Quad as Q

  -- 27 chunks, index (dx + 1) + 3 * ((dz + 1) + 3 * (dy + 1))
  type Around = Around(Strata.Tree.Tree(Strata.Chunk.Chunk))

  pfn around_list(f, i : Int, acc : List(Strata.Chunk.Chunk)) : List(Strata.Chunk.Chunk) do
    if i < 0 do acc else around_list(f, i - 1, Cons(f(i % 3 - 1, i / 9 - 1, (i / 3) % 3 - 1), acc)) end
  end

  doc "The neighbourhood whose chunk at offset (dx, dy, dz), each -1..1, is f(dx, dy, dz); (0, 0, 0) is the chunk to mesh."
  fn around_from(f) : Around do Around(Strata.Tree.from_list(around_list(f, 26, Nil), C.uniform(0))) end

  doc "The chunk at offset (dx, dy, dz), each -1..1; air outside that."
  fn around_chunk(a : Around, dx : Int, dy : Int, dz : Int) : Strata.Chunk.Chunk do
    if dx < -1 || dx > 1 || dy < -1 || dy > 1 || dz < -1 || dz > 1 do C.uniform(0)
    else
      match a do
        Around(t) -> Strata.Tree.get(t, (dx + 1) + 3 * ((dz + 1) + 3 * (dy + 1)))
      end
    end
  end

  doc "The 27 chunks about [k] in store [s], at [k]'s level; a chunk the store lacks reads as the store's fill."
  fn around_of(s : Strata.Store.Store(Strata.Chunk.Chunk), k : Strata.Coord.Key) : Around do
    around_from(fn (dx, dy, dz) -> Strata.Store.get(s, Strata.Coord.offset(k, dx, dy, dz)))
  end

  pfn has_go(s : Strata.Store.Store(Strata.Chunk.Chunk), k : Strata.Coord.Key, i : Int) : Bool do
    if i >= 27 do true
    else if Strata.Store.has(s, Strata.Coord.offset(k, i % 3 - 1, i / 9 - 1, (i / 3) % 3 - 1)) do has_go(s, k, i + 1)
    else false end end
  end

  doc "Are [k] and all 26 of its neighbours at its level in the store? A chunk is meshed only when they are, so no face is drawn against a chunk that has not arrived."
  fn has_all(s : Strata.Store.Store(Strata.Chunk.Chunk), k : Strata.Coord.Key) : Bool do has_go(s, k, 0) end

  pfn off(v : Int) : Int do if v < 0 do -1 else if v > 31 do 1 else 0 end end end

  doc "The block id at (x, y, z) local to the centre chunk; each coordinate may run into the neighbours (-32..63). Air beyond them."
  fn around_get(a : Around, x : Int, y : Int, z : Int) : Int do
    let dx = off(x)
    let dy = off(y)
    let dz = off(z)
    C.get_or(around_chunk(a, dx, dy, dz), x - 32 * dx, y - 32 * dy, z - 32 * dz, 0)
  end

  doc "Shade 0..3 of a face corner from its two edge neighbours and the diagonal: two solid edges close the corner whatever the diagonal is."
  fn corner_ao(s1 : Bool, s2 : Bool, cn : Bool) : Int do
    if s1 && s2 do 0
    else 3 - ((if s1 do 1 else 0 end) + (if s2 do 1 else 0 end) + (if cn do 1 else 0 end)) end
  end

  -- ── Growable word buffers ────────────────────────────────────────────────
  type QBuf = QBuf(NativeI32Arr, Int)

  pfn qb_new() : QBuf do QBuf(NativeArray.make_i32(0, 0), 0) end
  pfn qb_copy(dst : NativeI32Arr, src : NativeI32Arr, i : Int, n : Int) : NativeI32Arr do
    if i >= n do dst else qb_copy(NativeArray.set_i32(dst, i, NativeArray.get_i32(src, i)), src, i + 1, n) end
  end
  pfn qb_push2(q : QBuf, a : Int, b : Int) : QBuf do
    match q do
      QBuf(arr, n) ->
        let cap = NativeArray.length_i32(arr)
        if n + 2 <= cap do QBuf(NativeArray.set_i32(NativeArray.set_i32(arr, n, a), n + 1, b), n + 2)
        else
          let cap2 = if cap < 64 do 128 else cap * 2 end
          let grown = qb_copy(NativeArray.make_i32(Strata.Size.of(cap2), 0), arr, 0, n)
          QBuf(NativeArray.set_i32(NativeArray.set_i32(grown, n, a), n + 1, b), n + 2)
        end
    end
  end
  pfn qb_arr(q : QBuf) : NativeI32Arr do match q do QBuf(a, _) -> a end end
  pfn qb_len(q : QBuf) : Int do match q do QBuf(_, n) -> n end end

  -- opaque, cutout, translucent quads; instances; the centre's occupancy;
  -- its light classes (32768 bytes by flat index, or 1 when it is one class
  -- throughout); the level of detail of its key
  type Meshed = Meshed(QBuf, QBuf, QBuf, QBuf, NativeU8Arr, NativeU8Arr, Int)

  pfn layer_buf(m : Meshed, l : Int) : QBuf do
    match m do
      Meshed(q0, q1, q2, _, _, _, _) -> if l == 1 do q1 else if l == 2 do q2 else q0 end end
    end
  end

  doc "The quads of layer [l] (0 opaque, 1 cutout, 2 translucent): two words a quad. The array may be longer than the quads in it; read `quad_count_at`."
  fn quads_at(m : Meshed, l : Int) : NativeI32Arr do qb_arr(layer_buf(m, l)) end
  doc "How many quads layer [l] holds."
  fn quad_count_at(m : Meshed, l : Int) : Int do qb_len(layer_buf(m, l)) / 2 end
  fn quads(m : Meshed, l : Strata.Blocks.Layer) : NativeI32Arr do quads_at(m, B.layer_number(l)) end
  fn quad_count(m : Meshed, l : Strata.Blocks.Layer) : Int do quad_count_at(m, B.layer_number(l)) end
  doc "The cross and model instances: two words each. Read `instance_count`."
  fn instances(m : Meshed) : NativeI32Arr do match m do Meshed(_, _, _, qi, _, _, _) -> qb_arr(qi) end end
  fn instance_count(m : Meshed) : Int do match m do Meshed(_, _, _, qi, _, _, _) -> qb_len(qi) / 2 end end
  doc "The centre chunk's occupancy mask (Strata.Occupancy)."
  fn occupancy(m : Meshed) : NativeU8Arr do match m do Meshed(_, _, _, _, o, _, _) -> o end end
  doc "The centre chunk's light classes for the renderer's light volume: 32768 bytes by flat index, or a single byte when every voxel has the same class."
  fn light_bytes(m : Meshed) : NativeU8Arr do match m do Meshed(_, _, _, _, _, lb, _) -> lb end end
  doc "The level of detail of the chunk the mesh was built for (`build` makes level 0; the stream sets its key's level)."
  fn level(m : Meshed) : Int do
    match m do Meshed(_, _, _, _, _, _, l) -> l end
  end
  doc "The mesh [m] marked as built for a chunk of level [l]."
  fn with_level(m : Meshed, l : Int) : Meshed do
    match m do Meshed(q0, q1, q2, qi, o, lb, _) -> Meshed(q0, q1, q2, qi, o, lb, l) end
  end
  doc "Bytes of mesh: eight per quad and per instance."
  fn bytes(m : Meshed) : Int do
    (quad_count_at(m, 0) + quad_count_at(m, 1) + quad_count_at(m, 2) + instance_count(m)) * 8
  end

  pfn no_mesh(occ : NativeU8Arr, lb : NativeU8Arr) : Meshed do Meshed(qb_new(), qb_new(), qb_new(), qb_new(), occ, lb, 0) end

  pfn light_go(lb : NativeU8Arr, r : Strata.Blocks.Registry, c : Strata.Chunk.Chunk, i : Int) : NativeU8Arr do
    if i < 0 || i >= 32768 do lb else light_go(NativeArray.set_u8(lb, i, B.light_class(r, C.get_idx(c, i))), r, c, i + 1) end
  end

  -- The chunk's light classes: one byte when it is uniform, else one a voxel.
  pfn light_of(r : Strata.Blocks.Registry, c : Strata.Chunk.Chunk) : NativeU8Arr do
    let u = C.uniform_id(c)
    if u >= 0 do NativeArray.make_u8(1, B.light_class(r, u)) else light_go(NativeArray.make_u8(32768, 0), r, c, 0) end
  end

  -- ── The padded grids ─────────────────────────────────────────────────────
  -- The centre chunk and a one-voxel shell of its neighbours: 34 x 34 x 34,
  -- index (x + 1) + 34 * ((z + 1) + 34 * (y + 1)). `ids` holds block ids;
  -- `kind` holds, per cell, bit 0 solid-opaque, bits 1-2 the style index,
  -- bits 3-4 the layer index.
  pfn pvol() : Int do 39304 end
  pfn porigin() : Int do 1191 end

  @[no_alloc]
  pfn inside(p : Int) : Bool do p >= 1 && p <= 32 end

  -- The centre chunk's ids into the grid's interior.
  pfn centre_go(ids : NativeIntArr, c : Strata.Chunk.Chunk, i : Int) : NativeIntArr do
    if i < 0 || i >= 32768 do ids
    else centre_go(NativeArray.set_int(ids, porigin() + i % 32 + 34 * ((i / 32) % 32) + 1156 * (i / 1024), C.get_idx(c, i)), c, i + 1) end
  end

  -- The one-voxel shell, from the neighbours.
  pfn shell_go(ids : NativeIntArr, a : Around, i : Int) : NativeIntArr do
    if i >= pvol() do ids
    else
      let px = i % 34
      let pz = (i / 34) % 34
      let py = i / 1156
      if inside(px) && inside(py) && inside(pz) do shell_go(ids, a, i + 1)
      else shell_go(NativeArray.set_int(ids, i, around_get(a, px - 1, py - 1, pz - 1)), a, i + 1) end
    end
  end

  pfn pad(a : Around, centre : Strata.Chunk.Chunk) : NativeIntArr do
    let u = C.uniform_id(centre)
    if u >= 0 do shell_go(NativeArray.make_int(Strata.Size.of(pvol()), u), a, 0)
    else shell_go(centre_go(NativeArray.make_int(Strata.Size.of(pvol()), 0), centre, 0), a, 0) end
  end

  -- Per-layer tallies that let whole slices be skipped. Six runs of 34,
  -- indexed by padded layer: cube blocks in the layer (interior cells only)
  -- by y, x, z at 0, 34, 68; solid-opaque cells among the layer's 32 x 32
  -- cells that face the interior, by y, x, z at 102, 136, 170.
  pfn bump(t : NativeIntArr, i : Int) : NativeIntArr do NativeArray.set_int(t, i, NativeArray.get_int(t, i) + 1) end

  -- kind per cell, the layer tallies, and per cell what fluid it holds:
  -- 0 for none, else 16 * (family base + 1) + how high it is filled, 1..8.
  -- The faces read these arrays only: the registry is shared by every
  -- worker, and touching it once a face made meshing seven times slower.
  type Kinds = Kinds(NativeU8Arr, NativeIntArr, NativeIntArr)

  pfn kind_go(kind : NativeU8Arr, tally : NativeIntArr, fam : NativeIntArr, ids : NativeIntArr, r : Strata.Blocks.Registry, i : Int) : Kinds do
    if i >= pvol() do Kinds(kind, tally, fam)
    else
      let k = B.mesh_kind(r, NativeArray.get_int(ids, i))
      let px = i % 34
      let pz = (i / 34) % 34
      let py = i / 1156
      let ix = inside(px)
      let iy = inside(py)
      let iz = inside(pz)
      let t1 = if int_and(k / 2, 3) == 0 && ix && iy && iz do bump(bump(bump(tally, py), 34 + px), 68 + pz) else tally end
      let solid = int_and(k, 1) == 1
      let t2 = if solid && ix && iz do bump(t1, 102 + py) else t1 end
      let t3 = if solid && iy && iz do bump(t2, 136 + px) else t2 end
      let t4 = if solid && ix && iy do bump(t3, 170 + pz) else t3 end
      let id = NativeArray.get_int(ids, i)
      kind_go(NativeArray.set_u8(kind, i, k), t4, if k >= 32 do NativeArray.set_int(fam, i, 16 * (B.fluid_base(r, id) + 1) + B.fill(r, id)) else fam end, ids, r, i + 1)
    end
  end

  -- Can slice n of face f hold a face at all? Not if the layer has no cube
  -- block, nor if every cell it looks into is solid.
  pfn slice_live(tally : NativeIntArr, f : Int, n : Int) : Bool do
    let axis = if f < 2 do 0 else if f < 4 do 34 else 68 end end
    let front = if f == 0 || f == 2 || f == 4 do n + 2 else n end
    NativeArray.get_int(tally, axis + n + 1) > 0 && NativeArray.get_int(tally, 102 + axis + front) < 1024
  end

  -- Padded-index strides of a face's normal and in-plane axes.
  pfn sn(f : Int) : Int do if f < 2 do 1156 else if f < 4 do 1 else 34 end end end
  pfn su(f : Int) : Int do if f == 2 || f == 3 do 34 else 1 end end
  pfn sv(f : Int) : Int do if f < 2 do 34 else 1156 end end
  pfn toward(f : Int) : Int do if f == 0 || f == 2 || f == 4 do sn(f) else 0 - sn(f) end end

  @[no_alloc]
  pfn solid_at(kind : NativeU8Arr, i : Int) : Bool do int_and(NativeArray.get_u8(kind, i), 1) == 1 end

  pfn corner_at(kind : NativeU8Arr, front : Int, du : Int, dv : Int) : Int do
    corner_ao(solid_at(kind, front + du), solid_at(kind, front + dv), solid_at(kind, front + du + dv))
  end

  -- How high the fluid in [cell] stands, in eighths: its fill, or 8 when the
  -- same fluid is above it. [mine] is the cell's own entry in fam.
  @[no_alloc]
  pfn stands(fam : NativeIntArr, cell : Int, mine : Int) : Int do
    if NativeArray.get_int(fam, cell + 1156) / 16 == mine / 16 do 8 else int_and(mine, 15) end
  end

  -- How high the fluid surface at a neighbour stands, for the corner it
  -- shares with a cell of the family in [mine] standing at [h]: its own
  -- level if it is the same fluid, else [h] (banks and air do not pull a
  -- corner down).
  @[no_alloc]
  pfn beside(fam : NativeIntArr, cell : Int, mine : Int, h : Int) : Int do
    let other = NativeArray.get_int(fam, cell)
    if other / 16 == mine / 16 do stands(fam, cell, other) else h end
  end

  -- How far a top face's corner dips, 0..3 eighths: down to the lowest of
  -- the three other cells that share the corner, so that neighbouring
  -- surfaces meet instead of stepping.
  pfn dip(fam : NativeIntArr, cell : Int, mine : Int, h : Int, du : Int, dv : Int) : Int do
    let a = beside(fam, cell + du, mine, h)
    let b = beside(fam, cell + dv, mine, h)
    let c = beside(fam, cell + du + dv, mine, h)
    let low = if a < b do (if a < c do a else c end) else (if b < c do b else c end) end
    if h - low > 3 do 3 else if h - low < 0 do 0 else h - low end end
  end

  -- The face of a fluid cell. None toward its own fluid above or below. Its
  -- top face's corners dip to meet lower neighbours of the same fluid (the
  -- shading byte carries the dips; a face with any dip is kept from merging
  -- by a bit that alternates from cell to cell). Toward a neighbour of its
  -- own fluid a side is drawn only when it stands more than three eighths
  -- higher, more than the corners can take up; a cell under its own fluid,
  -- which has no top face, shows its whole side to any lower neighbour. Every key carries the fluid
  -- bit (134217728) and the drop.
  pfn fluid_key(ids : NativeIntArr, kind : NativeU8Arr, fam : NativeIntArr, f : Int, cell : Int) : Int do
    let front = cell + toward(f)
    let id = NativeArray.get_int(ids, cell)
    let mine = NativeArray.get_int(fam, cell)
    let same = NativeArray.get_int(fam, front) / 16 == mine / 16
    if solid_at(kind, front) do 0
    else if same && f < 2 do 0
    else
      let h = stands(fam, cell, mine)
      if f == 0 do
        let code = Q.ao4(dip(fam, cell, mine, h, -1, -34), dip(fam, cell, mine, h, 1, -34), dip(fam, cell, mine, h, -1, 34), dip(fam, cell, mine, h, 1, 34))
        1 + id + 65536 * code + 16777216 * (8 - h) + 134217728 + (if code != 0 && (cell % 34 + cell / 34) % 2 == 1 do 268435456 else 0 end)
      else
        -- a cell with its own fluid above it has no top face to dip, so it shows its whole side to any lower neighbour
        let covered = NativeArray.get_int(fam, cell + 1156) / 16 == mine / 16
        let other = if same do stands(fam, front, NativeArray.get_int(fam, front)) else 0 end
        if same && covered && other >= 8 do 0
        else if same && !covered && other + 3 >= h do 0
        else 1 + id + 65536 * (if same && !covered do 3 else 0 end) + 16777216 * (8 - h) + 134217728 end end
      end
    end end
  end

  -- The merge key of the face of [cell] looking along face f, or 0 for no
  -- face: 1 + id + 65536 * shading + 16777216 * drop, + 134217728 for a fluid.
  pfn face_key(ids : NativeIntArr, kind : NativeU8Arr, fam : NativeIntArr, f : Int, cell : Int) : Int do
    let k = NativeArray.get_u8(kind, cell)
    if int_and(k / 2, 3) != 0 do 0
    else if k >= 32 do fluid_key(ids, kind, fam, f, cell)
    else
      let front = cell + toward(f)
      let id = NativeArray.get_int(ids, cell)
      if solid_at(kind, front) || NativeArray.get_int(ids, front) == id do 0
      else
        let u = su(f)
        let v = sv(f)
        1 + id + 65536 * Q.ao4(corner_at(kind, front, 0 - u, 0 - v), corner_at(kind, front, u, 0 - v), corner_at(kind, front, 0 - u, v), corner_at(kind, front, u, v))
      end
    end end
  end

  -- One slice's face keys, 32 x 32 at a + 32 * b, and how many are non-zero.
  type MaskRes = MaskRes(NativeIntArr, Int)
  pfn mask_go(mask : NativeIntArr, ids : NativeIntArr, kind : NativeU8Arr, fam : NativeIntArr, f : Int, base : Int, i : Int, found : Int) : MaskRes do
    if i >= 1024 do MaskRes(mask, found)
    else
      let key = face_key(ids, kind, fam, f, base + (i % 32) * su(f) + (i / 32) * sv(f))
      mask_go(NativeArray.set_int(mask, i, key), ids, kind, fam, f, base, i + 1, if key == 0 do found else found + 1 end)
    end
  end

  -- ── Greedy merge of one slice ────────────────────────────────────────────
  @[no_alloc]
  pfn run_w(mask : NativeIntArr, key : Int, a : Int, b : Int) : Int do
    if a >= 32 do a else if NativeArray.get_int(mask, a + 32 * b) != key do a else run_w(mask, key, a + 1, b) end end
  end
  @[no_alloc]
  pfn row_is(mask : NativeIntArr, key : Int, a : Int, a1 : Int, b : Int) : Bool do
    if a >= a1 do true else if NativeArray.get_int(mask, a + 32 * b) != key do false else row_is(mask, key, a + 1, a1, b) end end
  end
  @[no_alloc]
  pfn run_h(mask : NativeIntArr, key : Int, a : Int, a1 : Int, b : Int) : Int do
    if b >= 32 do b else if row_is(mask, key, a, a1, b) do run_h(mask, key, a, a1, b + 1) else b end end
  end
  pfn clear_row(mask : NativeIntArr, a : Int, a1 : Int, b : Int) : NativeIntArr do
    if a >= a1 do mask else clear_row(NativeArray.set_int(mask, a + 32 * b, 0), a + 1, a1, b) end
  end
  pfn clear_box(mask : NativeIntArr, a : Int, a1 : Int, b : Int, b1 : Int) : NativeIntArr do
    if b >= b1 do mask else clear_box(clear_row(mask, a, a1, b), a, a1, b + 1, b1) end
  end

  type Bufs = Bufs(QBuf, QBuf, QBuf)

  pfn emit(bufs : Bufs, r : Strata.Blocks.Registry, f : Int, n : Int, a : Int, b : Int, w : Int, h : Int, key : Int) : Bufs do
    let id = int_and(key - 1, 65535)
    let ao = int_and((key - 1) / 65536, 255)
    let x = if f == 2 || f == 3 do n else a end
    let y = if f < 2 do n else b end
    let z = if f < 2 do b else if f < 4 do a else n end end
    let w0d = Q.with_drop(Q.pack0(x, y, z, w, h, f), int_and((key - 1) / 16777216, 7))
    let w0 = if int_and((key - 1) / 134217728, 1) == 1 do Q.with_fluid(w0d) else w0d end
    -- the flags byte carries the block's light class: what the surface is to the lighting
    let w1 = Q.pack1(B.face_tex(r, id, f), ao, B.light_class(r, id))
    let l = B.layer_index(r, id)
    match bufs do
      Bufs(q0, q1, q2) ->
        if l == 1 do Bufs(q0, qb_push2(q1, w0, w1), q2)
        else if l == 2 do Bufs(q0, q1, qb_push2(q2, w0, w1))
        else Bufs(qb_push2(q0, w0, w1), q1, q2) end end
    end
  end

  type Greedy = Greedy(Bufs, NativeIntArr)
  pfn greedy(bufs : Bufs, mask : NativeIntArr, r : Strata.Blocks.Registry, f : Int, n : Int, a : Int, b : Int) : Greedy do
    if b >= 32 do Greedy(bufs, mask)
    else if a >= 32 do greedy(bufs, mask, r, f, n, 0, b + 1)
    else
      let key = NativeArray.get_int(mask, a + 32 * b)
      if key == 0 do greedy(bufs, mask, r, f, n, a + 1, b)
      else
        let a1 = run_w(mask, key, a + 1, b)
        let b1 = run_h(mask, key, a, a1, b + 1)
        let bufs2 = emit(bufs, r, f, n, a, b, a1 - a, b1 - b, key)
        greedy(bufs2, clear_box(mask, a, a1, b, b1), r, f, n, a1, b)
      end
    end end
  end

  pfn slices(bufs : Bufs, mask : NativeIntArr, ids : NativeIntArr, kind : NativeU8Arr, fam : NativeIntArr, tally : NativeIntArr, r : Strata.Blocks.Registry, f : Int, n : Int) : Greedy do
    if n >= 32 do Greedy(bufs, mask)
    else if !slice_live(tally, f, n) do slices(bufs, mask, ids, kind, fam, tally, r, f, n + 1)
    else
      match mask_go(mask, ids, kind, fam, f, porigin() + n * sn(f), 0, 0) do
        MaskRes(m2, found) ->
          if found == 0 do slices(bufs, m2, ids, kind, fam, tally, r, f, n + 1)
          else
            match greedy(bufs, m2, r, f, n, 0, 0) do
              Greedy(b2, m3) -> slices(b2, m3, ids, kind, fam, tally, r, f, n + 1)
            end
          end
      end
    end end
  end

  pfn faces(bufs : Bufs, mask : NativeIntArr, ids : NativeIntArr, kind : NativeU8Arr, fam : NativeIntArr, tally : NativeIntArr, r : Strata.Blocks.Registry, f : Int) : Bufs do
    if f >= 6 do bufs
    else
      match slices(bufs, mask, ids, kind, fam, tally, r, f, 0) do
        Greedy(b2, m2) -> faces(b2, m2, ids, kind, fam, tally, r, f + 1)
      end
    end
  end

  pfn instances_go(qi : QBuf, ids : NativeIntArr, kind : NativeU8Arr, r : Strata.Blocks.Registry, i : Int) : QBuf do
    if i >= 32768 do qi
    else
      let x = i % 32
      let z = (i / 32) % 32
      let y = i / 1024
      let p = porigin() + x + 34 * z + 1156 * y
      let st = int_and(NativeArray.get_u8(kind, p) / 2, 3)
      if st == 1 || st == 2 do
        let id = NativeArray.get_int(ids, p)
        let model = if st == 2 do B.model_of(r, id) else -1 end
        instances_go(qb_push2(qi, Q.pack_instance0(x, y, z, model), Q.pack_instance1(id)), ids, kind, r, i + 1)
      else instances_go(qi, ids, kind, r, i + 1) end
    end
  end

  -- Is the chunk at this offset uniform and solid-opaque?
  pfn wall(r : Strata.Blocks.Registry, a : Around, dx : Int, dy : Int, dz : Int) : Bool do
    let u = C.uniform_id(around_chunk(a, dx, dy, dz))
    u >= 0 && B.is_solid_opaque(r, u)
  end

  doc "Mesh the centre chunk of [a]."
  fn build(r : Strata.Blocks.Registry, a : Around) : Meshed do
    let centre = around_chunk(a, 0, 0, 0)
    let occ = Strata.Occupancy.of_chunk(r, centre)
    let u = C.uniform_id(centre)
    -- the two commonest chunks touch no array: nothing to draw at all, and
    -- solid rock walled in by solid rock
    let lb = light_of(r, centre)
    if u >= 0 && B.style_index(r, u) == 3 do no_mesh(occ, lb)
    else if u >= 0 && B.is_solid_opaque(r, u) && wall(r, a, 1, 0, 0) && wall(r, a, -1, 0, 0) && wall(r, a, 0, 1, 0) && wall(r, a, 0, -1, 0) && wall(r, a, 0, 0, 1) && wall(r, a, 0, 0, -1) do no_mesh(occ, lb)
    else
      let ids = pad(a, centre)
      match kind_go(NativeArray.make_u8(Strata.Size.of(pvol()), 0), NativeArray.make_int(204, 0), NativeArray.make_int(Strata.Size.of(pvol() + 1156), 0), ids, r, 0) do
        Kinds(kind, tally, fam) ->
          match faces(Bufs(qb_new(), qb_new(), qb_new()), NativeArray.make_int(1024, 0), ids, kind, fam, tally, r, 0) do
            Bufs(q0, q1, q2) -> Meshed(q0, q1, q2, instances_go(qb_new(), ids, kind, r, 0), occ, lb, 0)
          end
      end
    end end
  end
end
