-- Populate — a frozen population evaluated over the ground a game hands
-- over. `Strata.Population` holds the declarations and `freeze`; this module
-- runs them. It depends on `Strata.Population`, never the reverse.
--
-- A `Ground` is an n x n area of columns at one level: its corner in world
-- voxels, the level's voxel size in metres, each column's ground top and
-- water line, and the built-in fields (slots 0..9) the game can supply.
--
-- `plan` reads a `Frozen` once into flat arrays: the order fields and zones
-- are evaluated in, what each needs, and every layer's rule compiled into a
-- short program. `fields_with` runs a plan over a Ground, once, into a
-- `Table` the calling task owns: every field, every zone and every layer's
-- density over all the columns. From then on `density`, `in_zone` and
-- `field_at` are array reads.
--
-- Placers follow the field and rule section: `place_with` runs a plan's
-- layers over one chunk, in run order (cover layers now; scatter and site
-- layers in later tasks).
mod Strata.Populate do

  alias Strata.Population as Pn

  -- An n x n area of columns whose corner is world voxel (x0, z0) at one
  -- level: the world's scale, the level's voxel size, each column's ground
  -- top and water line (voxels), and the built-in fields supplied, by slot
  -- (newest first). Surfaces: without with_surfaces (pg_surf false) each
  -- column has one floor at its top; with it, column c's surfaces are
  -- pg_sys / pg_skind[pg_sat[c] .. pg_sat[c] + pg_scnt[c]] (pg_sat the prefix
  -- sum of the counts, a negative count read as 0), pg_stotal of them;
  -- pg_sneg counts the negative counts and pg_sbadk the kinds not 0 or 1.
  -- pg_flo and pg_fhi are the lowest and highest floor of any column (a
  -- floor above pg_fhi + 1 or below pg_flo cannot be reached), so a chunk no
  -- floor reaches is turned away without a pass over the columns.
  type Ground = { pg_x0 : Int, pg_z0 : Int, pg_n : Int, pg_scale : Float, pg_voxel : Float, pg_tops : NativeIntArr, pg_waters : NativeIntArr, pg_slots : List((Int, NativeF32Arr)), pg_surf : Bool, pg_scnt : NativeIntArr, pg_sat : NativeIntArr, pg_sys : NativeIntArr, pg_skind : NativeIntArr, pg_stotal : Int, pg_sneg : Int, pg_sbadk : Int, pg_flo : Int, pg_fhi : Int }

  -- A Frozen read once into flat arrays (each list padded by one entry so no
  -- array is empty).
  --   fields, in evaluation order pl_forder; per field index i:
  --     pl_fkind  0 ground, 1 noise, 2 curve, 3 cover
  --     pl_fa     the slot; the noise kind; the source field; the cover layer
  --     pl_foct, pl_fsalt, pl_fper   a noise field's octaves, salt, period (m)
  --                                  (a cover field's radius is in pl_fper)
  --     pl_fat, pl_fcnt  a curve field's first point in pl_fpts (x, factor
  --                      pairs) and its point count
  --   zones, in evaluation order pl_zorder; per zone index z:
  --     pl_zkind  0 regions, 1 band, 2 ring, 3 all, 4 any, 5 not
  --     pl_za     a band's field; a not zone's member
  --     pl_zlo, pl_zhi   a band's bounds; a ring's inner and outer radii squared
  --     pl_zat, pl_zcnt  regions: ids in pl_zints; all, any: members in
  --                      pl_zints; ring: sites as (x, z) pairs from pl_zsites
  --   rules: pl_prog[l] is where layer l's program starts in pl_prog; there:
  --     nc, then nc triples (field, first point in pl_num, point count), then
  --     ni and ni zones to be inside, then no and no zones to be outside.
  --     pl_num[l] is layer l's base density; after the nl bases and one
  --     padding entry, the curves' points as (x, factor) pairs.
  --   layers, in run order; per layer l:
  --     pl_lkind, pl_lsalt   its kind (0 cover, 1 scatter, 2 site) and salt
  --     pl_lvat, pl_lvn      its block ids in pl_lids, and how many (0 for a
  --                          template shape set)
  --     pl_lwat, pl_lwn      its weights entries, in declaration order
  --   weights entry e: zone pl_wzone[e]; the cumulative weights over their
  --   sum, one per variant, at pl_wcum[pl_wbase[e]..] (exactly 1.0 from the
  --   last variant with a weight above 0); pl_ncover counts cover layers
  --   with blocks.
  type PopPlan = { pl_names : List(String), pl_nf : Int, pl_nz : Int, pl_nl : Int, pl_forder : NativeIntArr, pl_fkind : NativeIntArr, pl_fa : NativeIntArr, pl_foct : NativeIntArr, pl_fsalt : NativeIntArr, pl_fper : NativeFloatArr, pl_fat : NativeIntArr, pl_fcnt : NativeIntArr, pl_fpts : NativeFloatArr, pl_zorder : NativeIntArr, pl_zkind : NativeIntArr, pl_za : NativeIntArr, pl_zlo : NativeFloatArr, pl_zhi : NativeFloatArr, pl_zat : NativeIntArr, pl_zcnt : NativeIntArr, pl_zints : NativeIntArr, pl_zsites : NativeFloatArr, pl_prog : NativeI32Arr, pl_num : NativeFloatArr, pl_lkind : NativeIntArr, pl_lsalt : NativeIntArr, pl_lvat : NativeIntArr, pl_lvn : NativeIntArr, pl_lids : NativeIntArr, pl_lwat : NativeIntArr, pl_lwn : NativeIntArr, pl_wzone : NativeIntArr, pl_wbase : NativeIntArr, pl_wcum : NativeFloatArr, pl_ncover : Int }

  -- Every field, zone and layer density of a plan over one Ground.
  --   pt_vals   field f at column c is pt_vals[f * nn + c]          (nf * nn)
  --   pt_zones  zone z at column c is pt_zones[z * nn + c], 0 or 1  (nz * nn)
  --   pt_dens   layer l's density at column c is pt_dens[l * nn + c] (nl * nn)
  --   pt_dmax   layer l's largest density over every column     (nl, padded)
  -- (opaque to callers: read it with field_at, in_zone, density)
  type Table = { pt_nn : Int, pt_names : List(String), pt_nl : Int, pt_nz : Int, pt_vals : NativeF32Arr, pt_zones : NativeU8Arr, pt_dens : NativeF32Arr, pt_dmax : NativeF32Arr }

  -- ── Ground ────────────────────────────────────────────────────────────────

  doc "An n x n area of columns whose corner is world voxel (x0, z0) at this level's voxel size (scale * 2^level metres); tops: the ground top voxel per column; waters: the water line voxel per column, or a value below tops for none. Columns are numbered i + n * j, i along x. It cannot fail: `problems` lists what is wrong with it."
  fn ground(x0 : Int, z0 : Int, n : Int, scale : Float, level : Int, tops : NativeIntArr, waters : NativeIntArr) : Ground do
    let none = NativeArray.make_int(1, 0)
    let lo = min_go(tops, 0, NativeArray.length_int(tops), 4611686018427387903)
    let hi = max_go(tops, 0, NativeArray.length_int(tops), -4611686018427387903)
    { pg_x0: x0, pg_z0: z0, pg_n: n, pg_scale: scale, pg_voxel: scale *. Math.pow(2.0, int_to_float(level)), pg_tops: tops, pg_waters: waters, pg_slots: Nil,
      pg_surf: false, pg_scnt: none, pg_sat: none, pg_sys: none, pg_skind: none, pg_stotal: 0, pg_sneg: 0, pg_sbadk: 0, pg_flo: lo, pg_fhi: hi }
  end

  pfn min_go(a : NativeIntArr, i : Int, n : Int, m : Int) : Int do
    if i >= n do m else min_go(a, i + 1, n, Math.min_int(m, NativeArray.get_int(a, i))) end
  end
  pfn max_go(a : NativeIntArr, i : Int, n : Int, m : Int) : Int do
    if i >= n do m else max_go(a, i + 1, n, Math.max_int(m, NativeArray.get_int(a, i))) end
  end

  -- a count read as 0 when negative or above 1000000 (so the prefix sum stays far below 2^62)
  pfn count_ok(v : Int) : Bool do if v < 0 do false else v <= 1000000 end end
  pfn count_of(counts : NativeIntArr, i : Int) : Int do
    let v = NativeArray.get_int(counts, i)
    if count_ok(v) do v else 0 end
  end
  -- at[i] = counts[0] + .. + counts[i - 1] (negatives as 0), for i in 0..n
  pfn prefix_go(at : NativeIntArr, counts : NativeIntArr, i : Int, n : Int, sum : Int) : NativeIntArr do
    let at2 = NativeArray.set_int(at, i, sum)
    if i >= n do at2 else prefix_go(at2, counts, i + 1, n, sum + count_of(counts, i)) end
  end
  pfn neg_go(counts : NativeIntArr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc else neg_go(counts, i + 1, n, if count_ok(NativeArray.get_int(counts, i)) do acc else acc + 1 end) end
  end
  pfn badk_go(kinds : NativeIntArr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc
    else
      let k = NativeArray.get_int(kinds, i)
      badk_go(kinds, i + 1, n, if k == 0 do acc else if k == 1 do acc else acc + 1 end end)
    end
  end
  -- the lowest (want_lo) or highest floor among the first n surfaces
  pfn floor_go(ys : NativeIntArr, kinds : NativeIntArr, i : Int, n : Int, want_lo : Bool, m : Int) : Int do
    if i >= n do m
    else if NativeArray.get_int(kinds, i) == 0 do
      let y = NativeArray.get_int(ys, i)
      floor_go(ys, kinds, i + 1, n, want_lo, if want_lo do Math.min_int(m, y) else Math.max_int(m, y) end)
    else floor_go(ys, kinds, i + 1, n, want_lo, m) end end
  end

  doc "The Ground with every surface of every column: counts[col] surfaces for column col (i + n * j), stored from the top down in ys (world voxel heights) and kinds (0 floor, 1 ceiling) at offsets the prefix sum of counts gives. Without it each column has one floor at tops[col]. Placers visit the floors; tops still give the column's ground top. It cannot fail: `problems` lists counts not n * n long, a count negative or above 1000000 (read as 0), ys or kinds not as long as the counts' sum, and a kind other than 0 or 1."
  fn with_surfaces(g : Ground, counts : NativeIntArr, ys : NativeIntArr, kinds : NativeIntArr) : Ground do
    let nc = NativeArray.length_int(counts)
    let at = prefix_go(NativeArray.make_int(nc + 1, 0), counts, 0, nc, 0)
    let total = NativeArray.get_int(at, nc)
    let seen = Math.min_int(total, Math.min_int(NativeArray.length_int(ys), NativeArray.length_int(kinds)))
    { g with pg_surf: true, pg_scnt: counts, pg_sat: at, pg_sys: ys, pg_skind: kinds, pg_stotal: total,
      pg_sneg: neg_go(counts, 0, nc, 0), pg_sbadk: badk_go(kinds, 0, NativeArray.length_int(kinds), 0),
      pg_flo: floor_go(ys, kinds, 0, seen, true, 4611686018427387903), pg_fhi: floor_go(ys, kinds, 0, seen, false, -4611686018427387903) }
  end

  doc "The Ground with built-in field `slot` (0..9) supplied over the same n x n area, values[i + n * j]; a slot supplied again replaces the earlier values. It cannot fail: `problems` lists a slot outside 0..9 or values not n * n long."
  fn with_field(g : Ground, slot : Int, values : NativeF32Arr) : Ground do
    { g with pg_slots: Cons((slot, values), g.pg_slots) }
  end

  pfn slot_values(slots : List((Int, NativeF32Arr)), s : Int) : Option(NativeF32Arr) do
    match slots do
      Nil -> None
      Cons((k, a), rest) -> if k == s do Some(a) else slot_values(rest, s) end
    end
  end

  pfn length_problem(what : String, len : Int, nn : Int) : List(String) do
    if len == nn do Nil else ["ground: " ++ what ++ " holds " ++ int_to_string(len) ++ " values for n * n = " ++ int_to_string(nn) ++ " columns"] end
  end
  pfn slot_problems(s : (Int, NativeF32Arr), nn : Int) : List(String) do
    match s do
      (k, a) ->
        let range = if k < 0 do true else k > 9 end
        List.append(if range do ["ground: slot " ++ int_to_string(k) ++ " is outside 0..9"] else Nil end, length_problem("slot " ++ int_to_string(k), NativeArray.length_f32(a), nn))
    end
  end

  pfn surface_problems(g : Ground, nn : Int) : List(String) do
    if g.pg_surf do
      let total = g.pg_stotal
      let nc = NativeArray.length_int(g.pg_scnt)
      let counts = if nc == nn do Nil else ["ground: surface counts hold " ++ int_to_string(nc) ++ " values for n * n = " ++ int_to_string(nn) ++ " columns"] end
      let ys = if NativeArray.length_int(g.pg_sys) == total do Nil else ["ground: surface ys hold " ++ int_to_string(NativeArray.length_int(g.pg_sys)) ++ " values for " ++ int_to_string(total) ++ " surfaces"] end
      let kinds = if NativeArray.length_int(g.pg_skind) == total do Nil else ["ground: surface kinds hold " ++ int_to_string(NativeArray.length_int(g.pg_skind)) ++ " values for " ++ int_to_string(total) ++ " surfaces"] end
      let neg = if g.pg_sneg == 0 do Nil else ["ground: " ++ int_to_string(g.pg_sneg) ++ (if g.pg_sneg == 1 do " surface count is" else " surface counts are" end) ++ " negative or above 1000000"] end
      let badk = if g.pg_sbadk == 0 do Nil else ["ground: " ++ int_to_string(g.pg_sbadk) ++ (if g.pg_sbadk == 1 do " surface kind is" else " surface kinds are" end) ++ " not 0 or 1"] end
      List.append(counts, List.append(ys, List.append(kinds, List.append(neg, badk))))
    else Nil end
  end

  doc "Everything wrong with g, one message each, or Nil: n not above 0, a scale not above 0 (or NaN), tops or waters or a supplied slot not n * n long, a slot outside 0..9; with surfaces, counts not n * n long, a count negative or above 1000000, ys or kinds not as long as the counts' sum, a kind other than 0 or 1. `fields` over a Ground with problems is a Table of zeros, and `place` returns the chunk unchanged."
  fn problems(g : Ground) : List(String) do
    let n = g.pg_n
    let nn = n * n
    let bad_n = if n > 0 do Nil else ["ground: n is " ++ int_to_string(n) ++ "; it must be above 0"] end
    let bad_scale = if g.pg_scale > 0.0 do Nil else ["ground: scale is " ++ float_to_string(g.pg_scale) ++ "; it must be above 0"] end
    let arrays = List.append(length_problem("tops", NativeArray.length_int(g.pg_tops), nn), length_problem("waters", NativeArray.length_int(g.pg_waters), nn))
    let slots = List.flat_map(List.reverse(g.pg_slots), fn s -> slot_problems(s, nn))
    List.append(bad_n, List.append(bad_scale, List.append(arrays, List.append(slots, surface_problems(g, nn)))))
  end

  -- ── Plan: a Frozen read once ──────────────────────────────────────────────

  pfn mem_int(xs : List(Int), x : Int) : Bool do List.any(xs, fn y -> y == x) end

  -- the fields in an order where a curve field follows its source (freeze refused cycles)
  pfn field_visit(f : Strata.Population.Frozen, i : Int, done_rev : List(Int)) : List(Int) do
    if mem_int(done_rev, i) do done_rev
    else
      let after = if Pn.field_kind(f, i) == 2 do field_visit(f, Pn.field_source(f, i), done_rev) else done_rev end
      Cons(i, after)
    end
  end
  pfn field_order(f : Strata.Population.Frozen, i : Int, nf : Int, done_rev : List(Int)) : List(Int) do
    if i >= nf do List.reverse(done_rev) else field_order(f, i + 1, nf, field_visit(f, i, done_rev)) end
  end

  -- the zones in an order where a zone follows the zones it is made of
  pfn zone_visit(f : Strata.Population.Frozen, z : Int, done_rev : List(Int)) : List(Int) do
    if mem_int(done_rev, z) do done_rev
    else Cons(z, List.fold_left(Pn.zone_members(f, z), done_rev, fn (acc, m) -> zone_visit(f, m, acc)))
    end
  end
  pfn zone_order(f : Strata.Population.Frozen, z : Int, nz : Int, done_rev : List(Int)) : List(Int) do
    if z >= nz do List.reverse(done_rev) else zone_order(f, z + 1, nz, zone_visit(f, z, done_rev)) end
  end

  -- points (x, factor) interleaved
  pfn flat_points(pts : List((Float, Float))) : List(Float) do
    List.flat_map(pts, fn p -> match p do (x, y) -> [x, y] end)
  end

  -- where each of the lists starts when they are laid end to end from `at`
  pfn starts(lens : List(Int), at : Int) : List(Int) do
    match lens do
      Nil -> Nil
      Cons(l, rest) -> Cons(at, starts(rest, at + l))
    end
  end

  -- one padding entry, so no array is empty
  pfn ints(xs : List(Int)) : NativeIntArr do NativeArray.from_list_int(List.append(xs, [0])) end
  pfn floats(xs : List(Float)) : NativeFloatArr do NativeArray.from_list_float(List.append(xs, [0.0])) end

  pfn field_a(f : Strata.Population.Frozen, i : Int) : Int do
    let k = Pn.field_kind(f, i)
    if k == 0 do Pn.field_slot(f, i)
    else if k == 1 do Pn.field_noise_kind(f, i)
    else if k == 2 do Pn.field_source(f, i)
    else Pn.field_layer(f, i) end end end
  end
  pfn field_f(f : Strata.Population.Frozen, i : Int) : Float do
    if Pn.field_kind(f, i) == 3 do Pn.field_radius(f, i) else Pn.field_period(f, i) end
  end
  pfn field_pts(f : Strata.Population.Frozen, i : Int) : List((Float, Float)) do
    if Pn.field_kind(f, i) == 2 do Pn.curve_points(Pn.field_source_curve(f, i)) else Nil end
  end

  pfn zone_a(f : Strata.Population.Frozen, z : Int) : Int do
    let k = Pn.zone_kind(f, z)
    if k == 1 do Pn.zone_field(f, z)
    else if k == 5 do
      match Pn.zone_members(f, z) do
        Cons(m, _) -> m
        Nil -> 0
      end
    else 0 end end
  end
  pfn zone_lo_of(f : Strata.Population.Frozen, z : Int) : Float do
    if Pn.zone_kind(f, z) == 2 do Pn.zone_inner(f, z) *. Pn.zone_inner(f, z) else Pn.zone_lo(f, z) end
  end
  pfn zone_hi_of(f : Strata.Population.Frozen, z : Int) : Float do
    if Pn.zone_kind(f, z) == 2 do Pn.zone_outer(f, z) *. Pn.zone_outer(f, z) else Pn.zone_hi(f, z) end
  end
  -- a zone's ids (regions) or members (all, any)
  pfn zone_int_list(f : Strata.Population.Frozen, z : Int) : List(Int) do
    let k = Pn.zone_kind(f, z)
    if k == 0 do Pn.zone_ids(f, z)
    else if k == 3 do Pn.zone_members(f, z)
    else if k == 4 do Pn.zone_members(f, z)
    else Nil end end end
  end
  pfn site_pair(s : Strata.Population.PopSite) : List(Float) do [Pn.site_xm(s), Pn.site_zm(s)] end
  pfn zone_site_list(f : Strata.Population.Frozen, z : Int) : List(Float) do
    if Pn.zone_kind(f, z) == 2 do List.flat_map(Pn.zone_sites(f, z), site_pair) else Nil end
  end
  pfn pick_start(kinds : List(Int), int_at : List(Int), site_at : List(Int)) : List(Int) do
    match kinds do
      Nil -> Nil
      Cons(k, ks) ->
        match int_at do
          Cons(a, as2) ->
            match site_at do
              Cons(b, bs) -> Cons(if k == 2 do b else a end, pick_start(ks, as2, bs))
              Nil -> Nil
            end
          Nil -> Nil
        end
    end
  end

  -- (field, first point, count) triples for curves whose points start at num_at, and the points
  pfn curves_code(cs : List((Int, Strata.Population.PopCurve)), num_at : Int) : (List(Int), List(Float)) do
    match cs do
      Nil -> (Nil, Nil)
      Cons((fi, c), rest) ->
        let pts = Pn.curve_points(c)
        let flat = flat_points(pts)
        match curves_code(rest, num_at + List.length(flat)) do
          (code, nums) -> (Cons(fi, Cons(num_at, Cons(List.length(pts), code))), List.append(flat, nums))
        end
    end
  end

  -- layer l's program and points, its points starting at num_at in pl_num
  pfn layer_code(f : Strata.Population.Frozen, l : Int, num_at : Int) : (List(Int), List(Float)) do
    let cs = Pn.layer_curves(f, l)
    let ins = Pn.layer_inside(f, l)
    let outs = Pn.layer_outside(f, l)
    match curves_code(cs, num_at) do
      (code, nums) -> (Cons(List.length(cs), List.append(code, Cons(List.length(ins), List.append(ins, Cons(List.length(outs), outs))))), nums)
    end
  end

  -- offsets, programs, points for layers l.. (code_at: where l's program starts in pl_prog)
  pfn compile_rules(f : Strata.Population.Frozen, l : Int, nl : Int, code_at : Int, num_at : Int) : (List(Int), List(Int), List(Float)) do
    if l >= nl do (Nil, Nil, Nil)
    else
      match layer_code(f, l, num_at) do
        (code, nums) ->
          match compile_rules(f, l + 1, nl, code_at + List.length(code), num_at + List.length(nums)) do
            (offs, code2, nums2) -> (Cons(code_at, offs), List.append(code, code2), List.append(nums, nums2))
          end
      end
    end
  end

  -- weights over their sum, cumulative: exactly 1.0 from the last weight above 0 on
  pfn cum_go(ws : List(Float), run : Float, sum : Float) : List(Float) do
    match ws do
      Nil -> Nil
      Cons(w, rest) ->
        let r = run +. w
        Cons(if r == sum do 1.0 else r /. sum end, cum_go(rest, r, sum))
    end
  end
  pfn cumulative(ws : List(Float)) : List(Float) do cum_go(ws, 0.0, List.fold_left(ws, 0.0, fn (a, w) -> a +. w)) end
  pfn entry_zone(e : (Int, List(Float))) : Int do match e do (z, _) -> z end end
  pfn entry_weights(e : (Int, List(Float))) : List(Float) do match e do (_, w) -> w end end
  -- layer l's block ids: its shape set's ids when the set holds blocks, whatever the layer's kind; none when it holds templates
  pfn layer_blocks(f : Strata.Population.Frozen, l : Int) : List(Int) do
    let s = Pn.layer_shape_set(f, l)
    if Pn.shape_set_kind(f, s) == 0 do Pn.shape_set_blocks(f, s) else Nil end
  end
  pfn layer_weights(f : Strata.Population.Frozen, l : Int) : List((Int, List(Float))) do
    let s = Pn.layer_shape_set(f, l)
    if Pn.shape_set_kind(f, s) == 0 do Pn.shape_set_weights(f, s) else Nil end
  end

  doc "f read once into flat arrays: the order its fields and zones are evaluated in, what each needs, and every layer's rule compiled. Build one per Frozen and keep it; a plan is immutable. A caller sharing one plan between worker tasks should unpack what a loop needs from it before the loop, not read it per column (GAPS S15); fields_with does so."
  fn plan(f : Strata.Population.Frozen) : PopPlan do
    let nf = Pn.field_count(f)
    let nz = Pn.zone_count(f)
    let nl = Pn.layer_count(f)
    let fis = List.range(0, nf)
    let zis = List.range(0, nz)
    let fpts = List.map(fis, fn i -> flat_points(field_pts(f, i)))
    let zints = List.map(zis, fn z -> zone_int_list(f, z))
    let zsites = List.map(zis, fn z -> zone_site_list(f, z))
    let zkinds = List.map(zis, fn z -> Pn.zone_kind(f, z))
    let zat = pick_start(zkinds, starts(List.map(zints, List.length), 0), starts(List.map(zsites, List.length), 0))
    let zcnt = List.map(zis, fn z -> if Pn.zone_kind(f, z) == 2 do List.length(Pn.zone_sites(f, z)) else List.length(zone_int_list(f, z)) end)
    let lis = List.range(0, nl)
    let lkinds = List.map(lis, fn l -> Pn.layer_kind(f, l))
    let lblocks = List.map(lis, fn l -> layer_blocks(f, l))
    let lws = List.map(lis, fn l -> layer_weights(f, l))
    let entries = List.flat_map(lws, fn ws -> ws)
    let lvn = List.map(lblocks, List.length)
    let ncover = List.length(List.filter(List.zip(lkinds, lvn), fn kv -> match kv do (k, v) -> if k == 0 do v > 0 else false end end))
    -- one padding entry after the offsets and after the bases
    match compile_rules(f, 0, nl, nl + 1, nl + 1) do
      (offs, code, nums) ->
        { pl_names: Pn.field_names(f), pl_nf: nf, pl_nz: nz, pl_nl: nl,
          pl_forder: ints(field_order(f, 0, nf, Nil)),
          pl_fkind: ints(List.map(fis, fn i -> Pn.field_kind(f, i))),
          pl_fa: ints(List.map(fis, fn i -> field_a(f, i))),
          pl_foct: ints(List.map(fis, fn i -> Pn.field_octaves(f, i))),
          pl_fsalt: ints(List.map(fis, fn i -> Pn.field_salt(f, i))),
          pl_fper: floats(List.map(fis, fn i -> field_f(f, i))),
          pl_fat: ints(starts(List.map(fpts, List.length), 0)),
          pl_fcnt: ints(List.map(fis, fn i -> List.length(field_pts(f, i)))),
          pl_fpts: floats(List.flat_map(fpts, fn xs -> xs)),
          pl_zorder: ints(zone_order(f, 0, nz, Nil)),
          pl_zkind: ints(zkinds),
          pl_za: ints(List.map(zis, fn z -> zone_a(f, z))),
          pl_zlo: floats(List.map(zis, fn z -> zone_lo_of(f, z))),
          pl_zhi: floats(List.map(zis, fn z -> zone_hi_of(f, z))),
          pl_zat: ints(zat),
          pl_zcnt: ints(zcnt),
          pl_zints: ints(List.flat_map(zints, fn xs -> xs)),
          pl_zsites: floats(List.flat_map(zsites, fn xs -> xs)),
          pl_prog: NativeArray.from_list_i32(List.append(offs, Cons(0, code))),
          pl_num: NativeArray.from_list_float(List.append(List.map(List.range(0, nl), fn l -> Pn.layer_base(f, l)), Cons(0.0, nums))),
          pl_lkind: ints(lkinds),
          pl_lsalt: ints(List.map(lis, fn l -> Pn.layer_salt(f, l))),
          pl_lvat: ints(starts(lvn, 0)),
          pl_lvn: ints(lvn),
          pl_lids: ints(List.flat_map(lblocks, fn xs -> xs)),
          pl_lwat: ints(starts(List.map(lws, List.length), 0)),
          pl_lwn: ints(List.map(lws, List.length)),
          pl_wzone: ints(List.map(entries, entry_zone)),
          pl_wbase: ints(starts(List.map(entries, fn e -> List.length(entry_weights(e))), 0)),
          pl_wcum: floats(List.flat_map(entries, fn e -> cumulative(entry_weights(e)))),
          pl_ncover: ncover }
    end
  end

  -- ── Fields ────────────────────────────────────────────────────────────────

  -- dst[off + k] = src[k] for k < cnt
  pfn copy_into(dst : NativeF32Arr, off : Int, src : NativeF32Arr, k : Int, cnt : Int) : NativeF32Arr do
    if k >= cnt do dst else copy_into(NativeArray.set_f32(dst, off + k, NativeArray.get_f32(src, k)), off, src, k + 1, cnt) end
  end

  -- a curve of cnt points at num[off..]: piecewise linear, flat beyond the ends (as Pn.curve_at).
  -- Plain code with Float-valued branches: March boxes a Float-valued `if`
  -- (march-language/march#1263, a fix in progress); the cost is recorded, not dodged.
  pfn curve_go(num : NativeFloatArr, off : Int, k : Int, cnt : Int, x : Float) : Float do
    let yk = NativeArray.get_float(num, off + 2 * k + 1)
    if k + 1 >= cnt do yk
    else
      let x1 = NativeArray.get_float(num, off + 2 * k + 2)
      if x < x1 do
        let xk = NativeArray.get_float(num, off + 2 * k)
        let y1 = NativeArray.get_float(num, off + 2 * k + 3)
        yk +. (y1 -. yk) *. (x -. xk) /. (x1 -. xk)
      else curve_go(num, off, k + 1, cnt, x) end
    end
  end
  pfn curve_eval(num : NativeFloatArr, off : Int, cnt : Int, x : Float) : Float do
    if cnt <= 0 do 0.0
    else if x < NativeArray.get_float(num, off) do NativeArray.get_float(num, off + 1)
    else curve_go(num, off, 0, cnt, x) end end
  end

  -- vals[dst + k] = curve(vals[src + k])
  pfn curve_into(vals : NativeF32Arr, dst : Int, src : Int, num : NativeFloatArr, at : Int, cnt : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do vals
    else curve_into(NativeArray.set_f32(vals, dst + k, curve_eval(num, at, cnt, NativeArray.get_f32(vals, src + k))), dst, src, num, at, cnt, k + 1, nn) end
  end

  -- a / b rounded down (b > 0)
  pfn floor_div(a : Int, b : Int) : Int do if a >= 0 do a / b else 0 - ((b - 1 - a) / b) end end

  -- the Ground's columns that fall in a tile, from the tile's samples: vals[off + (X - x0) + n * (Z - z0)] = 0.5 + 0.5 * out[(X - tx0) + 32 * (Z - tz0)]
  pfn tile_copy(vals : NativeF32Arr, off : Int, out : NativeF32Arr, x0 : Int, z0 : Int, n : Int, tx0 : Int, tz0 : Int, xa : Int, xb : Int, zb : Int, x : Int, z : Int) : NativeF32Arr do
    if z >= zb do vals
    else if x >= xb do tile_copy(vals, off, out, x0, z0, n, tx0, tz0, xa, xb, zb, xa, z + 1)
    else
      let v = 0.5 +. 0.5 *. NativeArray.get_f32(out, (x - tx0) + 32 * (z - tz0))
      tile_copy(NativeArray.set_f32(vals, off + (x - x0) + n * (z - z0), v), off, out, x0, z0, n, tx0, tz0, xa, xb, zb, x + 1, z)
    end end
  end

  -- One world-aligned tile of 32 x 32 columns, tile (tx, tz): its origin and
  -- step come from the tile's index and the voxel size only, never from the
  -- Ground, so every Ground reads the same bits at a shared column.
  pfn tile_into(vals : NativeF32Arr, off : Int, s : Strata.Noise.Settings, nseed : Int, freq : Float, voxel : Float, x0 : Int, z0 : Int, n : Int, tx : Int, tz : Int) : NativeF32Arr do
    let out = NativeArray.make_f32(1024, 0.0)
    let tx0 = 32 * tx
    let tz0 = 32 * tz
    let wrote = Strata.Noise.field2(s, nseed, freq, (int_to_float(tx0) +. 0.5) *. voxel, (int_to_float(tz0) +. 0.5) *. voxel, voxel, 32, 32, out)
    if wrote == 1024 do
      let xa = Math.max_int(x0, tx0)
      let za = Math.max_int(z0, tz0)
      tile_copy(vals, off, out, x0, z0, n, tx0, tz0, xa, Math.min_int(x0 + n, tx0 + 32), Math.min_int(z0 + n, tz0 + 32), xa, za)
    else vals end
  end
  pfn tiles_go(vals : NativeF32Arr, off : Int, s : Strata.Noise.Settings, nseed : Int, freq : Float, voxel : Float, x0 : Int, z0 : Int, n : Int, ta : Int, tb : Int, tzb : Int, tx : Int, tz : Int) : NativeF32Arr do
    if tz > tzb do vals
    else if tx > tb do tiles_go(vals, off, s, nseed, freq, voxel, x0, z0, n, ta, tb, tzb, ta, tz + 1)
    else tiles_go(tile_into(vals, off, s, nseed, freq, voxel, x0, z0, n, tx, tz), off, s, nseed, freq, voxel, x0, z0, n, ta, tb, tzb, tx + 1, tz) end end
  end

  pfn eval_field(p : PopPlan, seed : Int, g : Ground, nn : Int, vals : NativeF32Arr, i : Int) : NativeF32Arr do
    let kind = NativeArray.get_int(p.pl_fkind, i)
    let a = NativeArray.get_int(p.pl_fa, i)
    if kind == 0 do
      match slot_values(g.pg_slots, a) do
        Some(arr) -> copy_into(vals, i * nn, arr, 0, nn)
        None -> vals
      end
    else if kind == 1 do
      -- lacunarity 2, gain 0.5, fBm, no warp, at 1 / period; on world-aligned tiles, sampled at column centres; read as 0..1
      let s = Strata.Noise.settings(a, NativeArray.get_int(p.pl_foct, i), 2.0, 0.5, 1, 0.0)
      let nseed = Strata.Seed.mix(seed, NativeArray.get_int(p.pl_fsalt, i))
      let freq = 1.0 /. NativeArray.get_float(p.pl_fper, i)
      let x0 = g.pg_x0
      let z0 = g.pg_z0
      let n = g.pg_n
      let tz = floor_div(z0, 32)
      tiles_go(vals, i * nn, s, nseed, freq, g.pg_voxel, x0, z0, n, floor_div(x0, 32), floor_div(x0 + n - 1, 32), floor_div(z0 + n - 1, 32), floor_div(x0, 32), tz)
    else if kind == 2 do curve_into(vals, i * nn, a * nn, p.pl_fpts, NativeArray.get_int(p.pl_fat, i), NativeArray.get_int(p.pl_fcnt, i), 0, nn)
    else
      -- COVER FIELDS (Task 6): a cover field reads 0 until the cover pass fills it here.
      vals
    end end end
  end

  pfn eval_fields(p : PopPlan, seed : Int, g : Ground, nn : Int, vals : NativeF32Arr, k : Int) : NativeF32Arr do
    if k >= p.pl_nf do vals else eval_fields(p, seed, g, nn, eval_field(p, seed, g, nn, vals, NativeArray.get_int(p.pl_forder, k)), k + 1) end
  end

  -- ── Zones ─────────────────────────────────────────────────────────────────

  pfn b2u(b : Bool) : Int do if b do 1 else 0 end end

  pfn has_id(ids : NativeIntArr, k : Int, end_at : Int, r : Int) : Bool do
    if k >= end_at do false else if NativeArray.get_int(ids, k) == r do true else has_id(ids, k + 1, end_at, r) end end
  end
  -- a region value rounded to the nearest integer is one of ids[at .. at + cnt]; NaN, and values too large to round, match nothing
  pfn region_in(ids : NativeIntArr, at : Int, cnt : Int, v : Float) : Bool do
    if v > 0.0 -. 1000000000000000.0 do
      if v < 1000000000000000.0 do has_id(ids, at, at + cnt, float_to_int(Math.floor(v +. 0.5))) else false end
    else false end
  end
  pfn regions_go(zs : NativeU8Arr, off : Int, reg : NativeF32Arr, ids : NativeIntArr, at : Int, cnt : Int, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else regions_go(NativeArray.set_u8(zs, off + k, b2u(region_in(ids, at, cnt, NativeArray.get_f32(reg, k)))), off, reg, ids, at, cnt, k + 1, nn) end
  end
  -- region slot 7 not supplied reads 0 at every column
  pfn regions_zero(zs : NativeU8Arr, off : Int, hit : Int, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs else regions_zero(NativeArray.set_u8(zs, off + k, hit), off, hit, k + 1, nn) end
  end

  -- lo <= field < hi (a NaN is outside)
  pfn band_go(zs : NativeU8Arr, off : Int, vals : NativeF32Arr, src : Int, lo : Float, hi : Float, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else
      let v = NativeArray.get_f32(vals, src + k)
      let inside = if v >= lo do v < hi else false end
      band_go(NativeArray.set_u8(zs, off + k, b2u(inside)), off, vals, src, lo, hi, k + 1, nn)
    end
  end

  -- inner <= distance < outer from some site (sites as xm, zm pairs from at)
  pfn near_site(xz : NativeFloatArr, s : Int, end_at : Int, xm : Float, zm : Float, in2 : Float, out2 : Float) : Bool do
    if s >= end_at do false
    else
      let dx = xm -. NativeArray.get_float(xz, 2 * s)
      let dz = zm -. NativeArray.get_float(xz, 2 * s + 1)
      let d2 = dx *. dx +. dz *. dz
      if d2 >= in2 do (if d2 < out2 do true else near_site(xz, s + 1, end_at, xm, zm, in2, out2) end)
      else near_site(xz, s + 1, end_at, xm, zm, in2, out2) end
    end
  end
  -- column k's centre is ((x0 + k mod n + 0.5) * voxel, (z0 + k / n + 0.5) * voxel)
  pfn ring_go(zs : NativeU8Arr, off : Int, n : Int, x0 : Int, z0 : Int, voxel : Float, xz : NativeFloatArr, s0 : Int, s1 : Int, in2 : Float, out2 : Float, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else
      let xm = (int_to_float(x0 + k % n) +. 0.5) *. voxel
      let zm = (int_to_float(z0 + k / n) +. 0.5) *. voxel
      ring_go(NativeArray.set_u8(zs, off + k, b2u(near_site(xz, s0, s1, xm, zm, in2, out2))), off, n, x0, z0, voxel, xz, s0, s1, in2, out2, k + 1, nn)
    end
  end

  -- every member of ms[m .. end_at] reads want at column k
  pfn every_is(zs : NativeU8Arr, ms : NativeIntArr, m : Int, end_at : Int, nn : Int, k : Int, want : Int) : Bool do
    if m >= end_at do true
    else if NativeArray.get_u8(zs, NativeArray.get_int(ms, m) * nn + k) == want do every_is(zs, ms, m + 1, end_at, nn, k, want)
    else false end end
  end
  -- all: every member holds; any: not every member fails
  pfn combine_go(zs : NativeU8Arr, off : Int, ms : NativeIntArr, at : Int, end_at : Int, any : Bool, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else
      let v = if any do b2u(!every_is(zs, ms, at, end_at, nn, k, 0)) else b2u(every_is(zs, ms, at, end_at, nn, k, 1)) end
      combine_go(NativeArray.set_u8(zs, off + k, v), off, ms, at, end_at, any, k + 1, nn)
    end
  end
  pfn not_go(zs : NativeU8Arr, off : Int, src : Int, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs else not_go(NativeArray.set_u8(zs, off + k, 1 - NativeArray.get_u8(zs, src + k)), off, src, k + 1, nn) end
  end

  pfn eval_zone(p : PopPlan, g : Ground, nn : Int, vals : NativeF32Arr, zs : NativeU8Arr, z : Int) : NativeU8Arr do
    let kind = NativeArray.get_int(p.pl_zkind, z)
    let off = z * nn
    let at = NativeArray.get_int(p.pl_zat, z)
    let cnt = NativeArray.get_int(p.pl_zcnt, z)
    if kind == 0 do
      match slot_values(g.pg_slots, 7) do
        Some(reg) -> regions_go(zs, off, reg, p.pl_zints, at, cnt, 0, nn)
        None -> regions_zero(zs, off, b2u(has_id(p.pl_zints, at, at + cnt, 0)), 0, nn)
      end
    else if kind == 1 do band_go(zs, off, vals, NativeArray.get_int(p.pl_za, z) * nn, NativeArray.get_float(p.pl_zlo, z), NativeArray.get_float(p.pl_zhi, z), 0, nn)
    else if kind == 2 do ring_go(zs, off, g.pg_n, g.pg_x0, g.pg_z0, g.pg_voxel, p.pl_zsites, at / 2, at / 2 + cnt, NativeArray.get_float(p.pl_zlo, z), NativeArray.get_float(p.pl_zhi, z), 0, nn)
    else if kind == 5 do not_go(zs, off, NativeArray.get_int(p.pl_za, z) * nn, 0, nn)
    else combine_go(zs, off, p.pl_zints, at, at + cnt, kind == 4, 0, nn)
    end end end end
  end

  pfn eval_zones(p : PopPlan, g : Ground, nn : Int, vals : NativeF32Arr, zs : NativeU8Arr, k : Int) : NativeU8Arr do
    if k >= p.pl_nz do zs else eval_zones(p, g, nn, vals, eval_zone(p, g, nn, vals, zs, NativeArray.get_int(p.pl_zorder, k)), k + 1) end
  end

  -- ── Layer densities ───────────────────────────────────────────────────────

  pfn fill_go(d : NativeF32Arr, off : Int, v : Float, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d else fill_go(NativeArray.set_f32(d, off + k, v), off, v, k + 1, nn) end
  end
  -- d[off + k] *= curve(vals[src + k])
  pfn times_curve(d : NativeF32Arr, off : Int, vals : NativeF32Arr, src : Int, num : NativeFloatArr, at : Int, cnt : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d
    else times_curve(NativeArray.set_f32(d, off + k, NativeArray.get_f32(d, off + k) *. curve_eval(num, at, cnt, NativeArray.get_f32(vals, src + k))), off, vals, src, num, at, cnt, k + 1, nn) end
  end
  pfn curves_go(d : NativeF32Arr, off : Int, vals : NativeF32Arr, prog : NativeI32Arr, num : NativeFloatArr, at : Int, cnt : Int, nn : Int) : NativeF32Arr do
    if cnt <= 0 do d
    else
      let src = NativeArray.get_i32(prog, at) * nn
      curves_go(times_curve(d, off, vals, src, num, NativeArray.get_i32(prog, at + 1), NativeArray.get_i32(prog, at + 2), 0, nn), off, vals, prog, num, at + 3, cnt - 1, nn)
    end
  end
  -- d[off + k] = 0 where zone src reads bad
  pfn zero_where(d : NativeF32Arr, off : Int, zs : NativeU8Arr, src : Int, bad : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d
    else if NativeArray.get_u8(zs, src + k) == bad do zero_where(NativeArray.set_f32(d, off + k, 0.0), off, zs, src, bad, k + 1, nn)
    else zero_where(d, off, zs, src, bad, k + 1, nn) end end
  end
  pfn zones_go(d : NativeF32Arr, off : Int, zs : NativeU8Arr, prog : NativeI32Arr, at : Int, cnt : Int, bad : Int, nn : Int) : NativeF32Arr do
    if cnt <= 0 do d else zones_go(zero_where(d, off, zs, NativeArray.get_i32(prog, at) * nn, bad, 0, nn), off, zs, prog, at + 1, cnt - 1, bad, nn) end
  end
  -- 0 or above: a negative product or a NaN reads 0
  pfn clamp_go(d : NativeF32Arr, off : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d
    else if NativeArray.get_f32(d, off + k) > 0.0 do clamp_go(d, off, k + 1, nn)
    else clamp_go(NativeArray.set_f32(d, off + k, 0.0), off, k + 1, nn) end end
  end

  -- layer l over every column: the base, times each curve of its field, 0 where a zone fails, clamped at 0
  pfn layer_into(d : NativeF32Arr, prog : NativeI32Arr, num : NativeFloatArr, vals : NativeF32Arr, zs : NativeU8Arr, nn : Int, l : Int) : NativeF32Arr do
    let off = l * nn
    let at = NativeArray.get_i32(prog, l)
    let nc = NativeArray.get_i32(prog, at)
    let ins_at = at + 1 + 3 * nc
    let ni = NativeArray.get_i32(prog, ins_at)
    let outs_at = ins_at + 1 + ni
    let no = NativeArray.get_i32(prog, outs_at)
    let d1 = curves_go(fill_go(d, off, NativeArray.get_float(num, l), 0, nn), off, vals, prog, num, at + 1, nc, nn)
    clamp_go(zones_go(zones_go(d1, off, zs, prog, outs_at + 1, no, 1, nn), off, zs, prog, ins_at + 1, ni, 0, nn), off, 0, nn)
  end
  pfn layers_go(d : NativeF32Arr, prog : NativeI32Arr, num : NativeFloatArr, vals : NativeF32Arr, zs : NativeU8Arr, nn : Int, l : Int, nl : Int) : NativeF32Arr do
    if l >= nl do d else layers_go(layer_into(d, prog, num, vals, zs, nn, l), prog, num, vals, zs, nn, l + 1, nl) end
  end

  -- the largest of d[off .. off + nn] (densities are never below 0)
  pfn dmax_col(d : NativeF32Arr, off : Int, k : Int, nn : Int, m : Float) : Float do
    if k >= nn do m
    else
      let v = NativeArray.get_f32(d, off + k)
      dmax_col(d, off, k + 1, nn, if v > m do v else m end)
    end
  end
  pfn dmax_go(out : NativeF32Arr, d : NativeF32Arr, nn : Int, l : Int, nl : Int) : NativeF32Arr do
    if l >= nl do out else dmax_go(NativeArray.set_f32(out, l, dmax_col(d, l * nn, 0, nn, 0.0)), d, nn, l + 1, nl) end
  end

  doc "Every field, zone and layer density of a plan over g's columns, once, into a Table the calling task owns. Ground fields are copied from g (0 where the slot was not supplied). A noise field is Strata.Noise.field2 on world-aligned tiles of 32 x 32 columns, sampled at column centres, seeded by Strata.Seed.mix(seed, salt), at 1 / period cycles per metre, fBm with lacunarity 2 and gain 0.5, read as 0.5 + 0.5 * noise; two Grounds read the same bits at a shared column. A curve field maps its source; a cover field reads 0 (Task 6 fills it). A layer's density is its base times each curve of its field, 0 where a zone fails, clamped at 0. A Ground with problems gives a Table of zeros."
  fn fields_with(p : PopPlan, seed : Int, g : Ground) : Table do
    let ok = List.is_empty(problems(g))
    let nn = if ok do g.pg_n * g.pg_n else 0 end
    let vals0 = NativeArray.make_f32(Math.max_int(1, p.pl_nf * nn), 0.0)
    let zs0 = NativeArray.make_u8(Math.max_int(1, p.pl_nz * nn), 0)
    let d0 = NativeArray.make_f32(Math.max_int(1, p.pl_nl * nn), 0.0)
    if ok do
      let vals = eval_fields(p, seed, g, nn, vals0, 0)
      let zs = eval_zones(p, g, nn, vals, zs0, 0)
      let d = layers_go(d0, p.pl_prog, p.pl_num, vals, zs, nn, 0, p.pl_nl)
      { pt_nn: nn, pt_names: p.pl_names, pt_nl: p.pl_nl, pt_nz: p.pl_nz, pt_vals: vals, pt_zones: zs, pt_dens: d, pt_dmax: dmax_go(NativeArray.make_f32(p.pl_nl + 1, 0.0), d, nn, 0, p.pl_nl) }
    else { pt_nn: 0, pt_names: p.pl_names, pt_nl: p.pl_nl, pt_nz: p.pl_nz, pt_vals: vals0, pt_zones: zs0, pt_dens: d0, pt_dmax: NativeArray.make_f32(p.pl_nl + 1, 0.0) } end
  end

  doc "fields_with(plan(f), seed, g): for tests and tools; a caller evaluating many Grounds keeps one plan."
  fn fields(f : Strata.Population.Frozen, seed : Int, g : Ground) : Table do fields_with(plan(f), seed, g) end

  -- ── Reading a Table ───────────────────────────────────────────────────────

  pfn in_range(i : Int, n : Int) : Bool do if i < 0 do false else i < n end end
  pfn cell_ok(t : Table, i : Int, n : Int, col : Int) : Bool do if in_range(i, n) do in_range(col, t.pt_nn) else false end end

  doc "Whether column col is inside zone zone_index (an index of Strata.Population.zone_index); false for an index or column out of range. An array read."
  fn in_zone(t : Table, zone_index : Int, col : Int) : Bool do
    if cell_ok(t, zone_index, t.pt_nz, col) do NativeArray.get_u8(t.pt_zones, zone_index * t.pt_nn + col) == 1 else false end
  end

  doc "Layer layer_index's (run order) density per square metre at column col, as fields_with worked it out; 0 for an index or column out of range. An array read."
  fn density(t : Table, layer_index : Int, col : Int) : Float do
    if cell_ok(t, layer_index, t.pt_nl, col) do NativeArray.get_f32(t.pt_dens, layer_index * t.pt_nn + col) else 0.0 end
  end

  pfn name_index(xs : List(String), n : String, i : Int) : Int do
    match xs do
      Nil -> -1
      Cons(x, rest) -> if x == n do i else name_index(rest, n, i + 1) end
    end
  end

  doc "The field named name at column col; 0 for an undeclared field or a column out of range. For tests and tools: it looks the name up."
  fn field_at(t : Table, name : String, col : Int) : Float do
    let i = name_index(t.pt_names, name, 0)
    if cell_ok(t, i, List.length(t.pt_names), col) do NativeArray.get_f32(t.pt_vals, i * t.pt_nn + col) else 0.0 end
  end

  doc "Whether column col is inside the zone named name; false for an undeclared zone. For tests and tools: per column, use in_zone."
  fn zone_at(f : Strata.Population.Frozen, t : Table, name : String, col : Int) : Bool do in_zone(t, Pn.zone_index(f, name), col) end

  doc "The layer named layer's density at column col; 0 for an undeclared layer. For tests and tools: per column, use density."
  fn density_at(f : Strata.Population.Frozen, t : Table, layer : String, col : Int) : Float do density(t, Pn.layer_index(f, layer), col) end

  -- ── Placers ───────────────────────────────────────────────────────────────
  --
  -- place_with runs the layers in run order over one chunk, each placer
  -- writing through Strata.Chunk.set_idx. A cover layer visits every
  -- floor of every column of the chunk: where the voxel above lies in the
  -- chunk and is air (id 0), it rolls the hash of the floor's world voxel
  -- against the column's density times the column's area, and on success
  -- writes a variant's block there. A block written is no longer air, so a
  -- later layer never overwrites it. Scatter and site layers (later tasks)
  -- pass the chunk through.

  -- One cover layer over one chunk, everything its loop reads unpacked from
  -- the plan, the Table and the Ground once per layer (GAPS S15). The chunk's
  -- column (cx, cz) is the Ground's column (cr_ci + cx) + cr_n * (cr_cj + cz)
  -- and world column (cr_wx0 + cx, cr_wz0 + cz); a floor at world height y
  -- writes local height y - cr_ylo when that is in 0..31.
  type CoverRun = { cr_seed : Int, cr_salt : Int, cr_area : Float, cr_dens : NativeF32Arr, cr_dmax : NativeF32Arr, cr_doff : Int, cr_zs : NativeU8Arr, cr_nn : Int, cr_ids : NativeIntArr, cr_vat : Int, cr_vn : Int, cr_wzone : NativeIntArr, cr_wbase : NativeIntArr, cr_wcum : NativeFloatArr, cr_wat : Int, cr_wend : Int, cr_n : Int, cr_ci : Int, cr_cj : Int, cr_wx0 : Int, cr_wz0 : Int, cr_ylo : Int, cr_surf : Bool, cr_tops : NativeIntArr, cr_sat : NativeIntArr, cr_sys : NativeIntArr, cr_skind : NativeIntArr }

  -- the first weights entry in e..e_end whose zone holds column col, or -1
  pfn weighted_entry(wzone : NativeIntArr, zs : NativeU8Arr, nn : Int, col : Int, e : Int, e_end : Int) : Int do
    if e >= e_end do -1
    else if NativeArray.get_u8(zs, NativeArray.get_int(wzone, e) * nn + col) == 1 do e
    else weighted_entry(wzone, zs, nn, col, e + 1, e_end) end end
  end
  -- the first variant k whose cumulative weight is above u (the last when none is)
  pfn cum_pick(cum : NativeFloatArr, base : Int, k : Int, nv : Int, u : Float) : Int do
    if k + 1 >= nv do k
    else if u < NativeArray.get_float(cum, base + k) do k
    else cum_pick(cum, base, k + 1, nv, u) end end
  end

  -- the block a floor at world voxel (wx, y, wz) of column col gets, or 0:
  -- the roll against ph, then the variant from the next value of the same hash
  pfn cover_roll(r : CoverRun, col : Int, ph : Float, wx : Int, y : Int, wz : Int) : Int do
    let h = Strata.Seed.cell(r.cr_seed, r.cr_salt, wx, y, wz)
    if Strata.Seed.unit(h) < ph do
      let u = Strata.Seed.unit(Strata.Seed.next(h))
      let nv = r.cr_vn
      let e = weighted_entry(r.cr_wzone, r.cr_zs, r.cr_nn, col, r.cr_wat, r.cr_wend)
      let k = if e >= 0 do cum_pick(r.cr_wcum, NativeArray.get_int(r.cr_wbase, e), 0, nv, u) else Math.min_int(nv - 1, float_to_int(u *. int_to_float(nv))) end
      -- freeze refuses ids outside 1..65535, so every id claims its voxel
      NativeArray.get_int(r.cr_ids, r.cr_vat + k)
    else 0 end
  end

  -- One pass over (column, surface) pairs: surface s of s_end of chunk column
  -- i (Ground column col, chance ph); past the last surface, the next column.
  -- Returns the chunk and how many voxels were written.
  pfn cover_go(r : CoverRun, c : Strata.Chunk.Chunk, wrote : Int, i : Int, col : Int, ph : Float, s : Int, s_end : Int) : (Strata.Chunk.Chunk, Int) do
    if s >= s_end do
      let i2 = i + 1
      if i2 >= 1024 do (c, wrote)
      else
        let col2 = (r.cr_ci + i2 % 32) + r.cr_n * (r.cr_cj + i2 / 32)
        let ph2 = NativeArray.get_f32(r.cr_dens, r.cr_doff + col2) *. r.cr_area
        if ph2 > 0.0 do
          if r.cr_surf do cover_go(r, c, wrote, i2, col2, ph2, NativeArray.get_int(r.cr_sat, col2), NativeArray.get_int(r.cr_sat, col2 + 1))
          else cover_go(r, c, wrote, i2, col2, ph2, 0, 1) end
        else cover_go(r, c, wrote, i2, col2, ph2, 0, 0) end
      end
    else
      let is_floor = if r.cr_surf do NativeArray.get_int(r.cr_skind, s) == 0 else true end
      let y = if r.cr_surf do NativeArray.get_int(r.cr_sys, s) else NativeArray.get_int(r.cr_tops, col) end
      -- y - cr_ylo is the voxel above in local height; compared before subtracting, so no y overflows
      let inside = if is_floor do (if y >= r.cr_ylo do y <= r.cr_ylo + 31 else false end) else false end
      if inside do
        let cx = i % 32
        let cz = i / 32
        let idx = Strata.Chunk.index(cx + 32 * (cz + 32 * (y - r.cr_ylo)))
        if Strata.Chunk.get_idx(c, idx) == 0 do
          let id = cover_roll(r, col, ph, r.cr_wx0 + cx, y, r.cr_wz0 + cz)
          if id > 0 do cover_go(r, Strata.Chunk.set_idx(c, idx, id), wrote + 1, i, col, ph, s + 1, s_end)
          else cover_go(r, c, wrote, i, col, ph, s + 1, s_end) end
        else cover_go(r, c, wrote, i, col, ph, s + 1, s_end) end
      else cover_go(r, c, wrote, i, col, ph, s + 1, s_end) end
    end
  end

  -- layer l of the plan as a cover layer over the chunk r was set up for
  pfn cover_layer(p : PopPlan, base : CoverRun, c : Strata.Chunk.Chunk, l : Int) : (Strata.Chunk.Chunk, Int) do
    let nv = NativeArray.get_int(p.pl_lvn, l)
    -- a layer whose density is 0 at every column of the Ground cannot place: no pass
    if nv <= 0 do (c, 0)
    else if NativeArray.get_f32(base.cr_dmax, l) <= 0.0 do (c, 0)
    else
      let wat = NativeArray.get_int(p.pl_lwat, l)
      let r = { base with cr_salt: NativeArray.get_int(p.pl_lsalt, l), cr_doff: l * base.cr_nn, cr_vat: NativeArray.get_int(p.pl_lvat, l), cr_vn: nv, cr_wat: wat, cr_wend: wat + NativeArray.get_int(p.pl_lwn, l) }
      cover_go(r, c, 0, -1, 0, 0.0, 0, 0)
    end end
  end

  -- the layers from l in run order, each dispatched on its kind
  pfn layers_place(p : PopPlan, base : CoverRun, c : Strata.Chunk.Chunk, wrote : Int, l : Int) : (Strata.Chunk.Chunk, Int) do
    if l >= p.pl_nl do (c, wrote)
    else
      let kind = NativeArray.get_int(p.pl_lkind, l)
      if kind == 0 do
        match cover_layer(p, base, c, l) do
          (c2, w) -> layers_place(p, base, c2, wrote + w, l + 1)
        end
      -- scatter (Task 4) and site layers: the chunk passes through
      else layers_place(p, base, c, wrote, l + 1) end
    end
  end

  pfn span_ok(a : Int, n : Int) : Bool do if a >= 0 do a + 32 <= n else false end end

  doc "The chunk at key k with plan p's layers placed, in run order, over Ground g, whose fields t holds (t = fields_with(p, seed, g)). This task: cover layers only, placing nothing above level 0; scatter and site layers pass the chunk through. A cover layer visits each floor of each of the chunk's columns (g's surfaces, or one floor at tops[col]); where the voxel above the floor is air and inside the chunk it rolls Strata.Seed.unit(Strata.Seed.cell(seed, salt, wx, y, wz)) at the floor's world voxel against the layer's density times the column's area (voxel size squared), and on success writes a variant's block id there: the variant comes from Strata.Seed.next of the same hash, against the weights of the first weighted zone (declaration order) the column is in, else uniformly. A written block is not air, so a later layer never overwrites it. g may be larger than the chunk; its corner and the key's 32 * kx, 32 * kz place the chunk's columns in it. The chunk comes back unchanged (the same value) when nothing is written: at a level above 0, with no cover layer, when g does not cover the chunk's 32 x 32 columns, has problems or is at another level than k (its voxel is not scale * 2^level of k), when t is not n * n columns or holds another layer or zone count than p, or when no floor of g reaches the chunk. A layer whose density is 0 at every column of g costs no pass. The chunk handed in is never changed."
  fn place_with(p : PopPlan, seed : Int, k : Strata.Coord.Key, c : Strata.Chunk.Chunk, g : Ground, t : Table) : Strata.Chunk.Chunk do
    let n = g.pg_n
    let wx0 = 32 * Strata.Coord.kx(k)
    let wz0 = 32 * Strata.Coord.kz(k)
    let ylo = 32 * Strata.Coord.ky(k) - 1
    let ci = wx0 - g.pg_x0
    let cj = wz0 - g.pg_z0
    let level0 = Strata.Coord.level(k) == 0
    let some = if level0 do p.pl_ncover > 0 else false end
    let covers = if span_ok(ci, n) do span_ok(cj, n) else false end
    let reached = if g.pg_fhi >= ylo do g.pg_flo <= ylo + 31 else false end
    -- the Table must be this Ground's (n * n columns) and this plan's (its layer and zone counts)
    let table_ok = if t.pt_nn == n * n do (if t.pt_nl == p.pl_nl do t.pt_nz == p.pl_nz else false end) else false end
    -- the Ground's voxel must be the key's: scale * 2^level
    let level_ok = g.pg_voxel == g.pg_scale *. Math.pow(2.0, int_to_float(Strata.Coord.level(k)))
    let fits = if covers do (if reached do (if table_ok do level_ok else false end) else false end) else false end
    if some do
      if fits do
        if List.is_empty(problems(g)) do
          let base = { cr_seed: seed, cr_salt: 0, cr_area: g.pg_voxel *. g.pg_voxel, cr_dens: t.pt_dens, cr_dmax: t.pt_dmax, cr_doff: 0, cr_zs: t.pt_zones, cr_nn: t.pt_nn,
                       cr_ids: p.pl_lids, cr_vat: 0, cr_vn: 0, cr_wzone: p.pl_wzone, cr_wbase: p.pl_wbase, cr_wcum: p.pl_wcum, cr_wat: 0, cr_wend: 0,
                       cr_n: n, cr_ci: ci, cr_cj: cj, cr_wx0: wx0, cr_wz0: wz0, cr_ylo: ylo, cr_surf: g.pg_surf, cr_tops: g.pg_tops, cr_sat: g.pg_sat, cr_sys: g.pg_sys, cr_skind: g.pg_skind }
          -- set_idx writes into arrays the chunk handed in still holds, so they are copied on the first write (GAPS S30) and c is never changed
          match layers_place(p, base, c, 0, 0) do
            (out, wrote) -> if wrote > 0 do out else c end
          end
        else c end
      else c end
    else c end
  end

  doc "place_with(plan(f), seed, k, c, g, fields(f, seed, g)): for tests and tools. A game keeps one plan per Frozen, evaluates a Ground's fields once with fields_with and hands the Table to place_with."
  fn place(f : Strata.Population.Frozen, seed : Int, k : Strata.Coord.Key, c : Strata.Chunk.Chunk, g : Ground) : Strata.Chunk.Chunk do
    let p = plan(f)
    place_with(p, seed, k, c, g, fields_with(p, seed, g))
  end
end
