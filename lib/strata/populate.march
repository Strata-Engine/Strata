-- Populate — a frozen population evaluated over the ground a game hands
-- over. `Strata.Population` holds the declarations and `freeze`; this module
-- runs them. It depends on `Strata.Population`, never the reverse.
--
-- A `Ground` is an n x n area of columns at one level: its corner in world
-- voxels, the level's voxel size in metres, each column's ground top and
-- water line, and the built-in fields (slots 0..9) the game can supply.
--
-- `plan` reads a `Frozen` once into flat arrays: the order fields and zones
-- are evaluated in, what each needs, and every layer's rule compiled into a
-- short program. `fields_with` runs a plan over a Ground, once, into a
-- `Table` the calling task owns: every field, every zone and every layer's
-- density over all the columns. From then on `density`, `in_zone` and
-- `field_at` are array reads.
--
-- Placers follow the field and rule section: `place_with` runs a plan's
-- layers over one chunk, in run order: cover layers roll a block onto each
-- floor, scatter layers stamp templates (or single blocks) at hashed places,
-- each stamp cut to the chunk so its neighbours hold the rest, site layers
-- stamp a template at each of their sites. Before that, `adapt` draws the
-- game's column heights to the sites, and `adapted` marks the columns it
-- holds or changes.
mod Strata.Populate do

  alias Strata.Population as Pn

  -- An n x n area of columns whose corner is world voxel (x0, z0) at one
  -- level: the world's scale, the level's voxel size, each column's ground
  -- top and water line (voxels), and the built-in fields supplied, by slot
  -- (newest first). Surfaces: without with_surfaces (pg_surf false) each
  -- column has one floor at its top; with it, column c's surfaces are
  -- pg_sys / pg_skind[pg_sat[c] .. pg_sat[c] + pg_scnt[c]] (pg_sat the prefix
  -- sum of the counts, a negative count read as 0), pg_stotal of them;
  -- pg_sneg counts the negative counts and pg_sbadk the kinds not 0 or 1.
  -- pg_flo and pg_fhi are the lowest and highest floor of any column (a
  -- floor above pg_fhi + 1 or below pg_flo cannot be reached), so a chunk no
  -- floor reaches is turned away without a pass over the columns. pg_tlo and
  -- pg_thi are the lowest and highest of tops (scatter instances stand on
  -- tops, whatever the surfaces).
  type Ground = { pg_x0 : Int, pg_z0 : Int, pg_n : Int, pg_scale : Float, pg_voxel : Float, pg_tops : NativeIntArr, pg_waters : NativeIntArr, pg_slots : List((Int, NativeF32Arr)), pg_surf : Bool, pg_scnt : NativeIntArr, pg_sat : NativeIntArr, pg_sys : NativeIntArr, pg_skind : NativeIntArr, pg_stotal : Int, pg_sneg : Int, pg_sbadk : Int, pg_flo : Int, pg_fhi : Int, pg_tlo : Int, pg_thi : Int }

  -- A Frozen read once into flat arrays (each list padded by one entry so no
  -- array is empty).
  --   evaluation: pl_steps holds pl_nsteps steps, each 3 * index + what (0
  --   a field, 1 a zone, 2 a layer's density), every step after the steps
  --   it reads: a curve field after its source, a cover field after its
  --   layer's density, a band after its field, a zone after its members, a
  --   density after the fields and zones of its rule. Densities are visited
  --   in run order, so a layer reading another's cover follows it.
  --   fields; per field index i:
  --     pl_fkind  0 ground, 1 noise, 2 curve, 3 cover
  --     pl_fa     the slot; the noise kind; the source field; the cover layer
  --     pl_foct, pl_fsalt, pl_fper   a noise field's octaves, salt, period (m)
  --                                  (a cover field's radius is in pl_fper)
  --     pl_fat, pl_fcnt  a curve field's first point in pl_fpts (x, factor
  --                      pairs) and its point count
  --   zones; per zone index z:
  --     pl_zkind  0 regions, 1 band, 2 ring, 3 all, 4 any, 5 not
  --     pl_za     a band's field; a not zone's member
  --     pl_zlo, pl_zhi   a band's bounds; a ring's inner and outer radii squared
  --     pl_zat, pl_zcnt  regions: ids in pl_zints; all, any: members in
  --                      pl_zints; ring: sites as (x, z) pairs from pl_zsites
  --   rules: pl_prog[l] is where layer l's program starts in pl_prog; there:
  --     nc, then nc triples (field, first point in pl_num, point count), then
  --     ni and ni zones to be inside, then no and no zones to be outside.
  --     pl_num[l] is layer l's base density; after the nl bases and one
  --     padding entry, the curves' points as (x, factor) pairs.
  --   layers, in run order; per layer l:
  --     pl_lkind, pl_lsalt   its kind (0 cover, 1 scatter, 2 site) and salt
  --     pl_lvat, pl_lvn      its block ids in pl_lids, and how many (0 for a
  --                          template shape set)
  --     pl_lwat, pl_lwn      its weights entries, in declaration order
  --   weights entry e: zone pl_wzone[e]; the cumulative weights over their
  --   sum, one per variant, at pl_wcum[pl_wbase[e]..] (exactly 1.0 from the
  --   last variant with a weight above 0); pl_ncover counts cover layers
  --   with blocks.
  --   scatter, per layer l: pl_lnv its variants (blocks or templates),
  --   pl_lcell its cell (m), pl_ljit its jitter, pl_lreach how far its
  --   templates reach (m); pl_ltemps its templates (Nil for blocks, and for
  --   cover layers; a site layer's too).
  --   pl_nscatter counts scatter layers; pl_reach is Strata.Population.reach;
  --   pl_hmax the tallest thing a scatter or site layer places, in voxels (1
  --   for a block); pl_tvlo and pl_tvhi the smallest and largest voxel size
  --   of any scatter or site layer's template (both 0 with none).
  --   sites, every site layer's sites in run order, then declaration order:
  --   site s at pl_sx[s], pl_sz[s] (m), floor pl_sfl[s] (m, held as a 32-bit
  --   float, so adapt and place read the same value), radius pl_srad[s],
  --   its layer's margin pl_smar[s] (m), index pl_sidx[s]; layer l's sites
  --   are pl_lsat[l] .. pl_lsat[l] + pl_lsn[l] - 1; pl_ns of them in all,
  --   pl_nsite site layers; pl_sflo and pl_sfhi the lowest and highest floor
  --   (m) that is not NaN (a huge pair when there is none); pl_lext[l] the
  --   largest side or height in voxels of layer l's templates (1 for blocks).
  --   cover reads: layer l's rule (curves, inside and outside zones) and,
  --   for cover and scatter layers, its weights zones reach the cover fields
  --   pl_crf[pl_crat[l] ..], pl_crn[l] of them (repeats possible).
  type PopPlan = { pl_names : List(String), pl_nf : Int, pl_nz : Int, pl_nl : Int, pl_nsteps : Int, pl_steps : NativeIntArr, pl_fkind : NativeIntArr, pl_fa : NativeIntArr, pl_foct : NativeIntArr, pl_fsalt : NativeIntArr, pl_fper : NativeFloatArr, pl_fat : NativeIntArr, pl_fcnt : NativeIntArr, pl_fpts : NativeFloatArr, pl_zkind : NativeIntArr, pl_za : NativeIntArr, pl_zlo : NativeFloatArr, pl_zhi : NativeFloatArr, pl_zat : NativeIntArr, pl_zcnt : NativeIntArr, pl_zints : NativeIntArr, pl_zsites : NativeFloatArr, pl_prog : NativeI32Arr, pl_num : NativeFloatArr, pl_lkind : NativeIntArr, pl_lsalt : NativeIntArr, pl_lvat : NativeIntArr, pl_lvn : NativeIntArr, pl_lids : NativeIntArr, pl_lwat : NativeIntArr, pl_lwn : NativeIntArr, pl_wzone : NativeIntArr, pl_wbase : NativeIntArr, pl_wcum : NativeFloatArr, pl_ncover : Int, pl_lnv : NativeIntArr, pl_lcell : NativeFloatArr, pl_ljit : NativeFloatArr, pl_lreach : NativeFloatArr, pl_ltemps : List(List(Strata.Template.Template)), pl_nscatter : Int, pl_reach : Float, pl_hmax : Int, pl_tvlo : Float, pl_tvhi : Float, pl_nsite : Int, pl_ns : Int, pl_lsat : NativeIntArr, pl_lsn : NativeIntArr, pl_lext : NativeIntArr, pl_sx : NativeFloatArr, pl_sz : NativeFloatArr, pl_sfl : NativeF32Arr, pl_srad : NativeFloatArr, pl_smar : NativeFloatArr, pl_sidx : NativeIntArr, pl_sflo : Float, pl_sfhi : Float, pl_crat : NativeIntArr, pl_crn : NativeIntArr, pl_crf : NativeIntArr, pl_lseen : NativeIntArr, pl_lwide : NativeFloatArr, pl_lrank : List(NativeIntArr) }

  -- Every field, zone and layer density of a plan over one Ground.
  --   pt_vals   field f at column c is pt_vals[f * nn + c]          (nf * nn)
  --   pt_zones  zone z at column c is pt_zones[z * nn + c], 0 or 1  (nz * nn)
  --   pt_dens   layer l's density at column c is pt_dens[l * nn + c] (nl * nn)
  --   pt_dmax   layer l's largest density over every column     (nl, padded)
  -- (opaque to callers: read it with field_at, in_zone, density)
  type Table = { pt_nn : Int, pt_names : List(String), pt_nl : Int, pt_nz : Int, pt_vals : NativeF32Arr, pt_zones : NativeU8Arr, pt_dens : NativeF32Arr, pt_dmax : NativeF32Arr }

  -- ── Ground ────────────────────────────────────────────────────────────────

  doc "An n x n area of columns whose corner is world voxel (x0, z0) at this level's voxel size (scale * 2^level metres); tops: the ground top voxel per column; waters: the water line voxel per column, or a value below tops for none. Columns are numbered i + n * j, i along x. It cannot fail: `problems` lists what is wrong with it."
  fn ground(x0 : Int, z0 : Int, n : Int, scale : Float, level : Int, tops : NativeIntArr, waters : NativeIntArr) : Ground do
    let none = NativeArray.make_int(1, 0)
    let lo = min_go(tops, 0, NativeArray.length_int(tops), 4611686018427387903)
    let hi = max_go(tops, 0, NativeArray.length_int(tops), -4611686018427387903)
    { pg_x0: x0, pg_z0: z0, pg_n: n, pg_scale: scale, pg_voxel: scale *. Math.pow(2.0, int_to_float(level)), pg_tops: tops, pg_waters: waters, pg_slots: Nil,
      pg_surf: false, pg_scnt: none, pg_sat: none, pg_sys: none, pg_skind: none, pg_stotal: 0, pg_sneg: 0, pg_sbadk: 0, pg_flo: lo, pg_fhi: hi, pg_tlo: lo, pg_thi: hi }
  end

  pfn min_go(a : NativeIntArr, i : Int, n : Int, m : Int) : Int do
    if i >= n do m else min_go(a, i + 1, n, Math.min_int(m, NativeArray.get_int(a, i))) end
  end
  pfn max_go(a : NativeIntArr, i : Int, n : Int, m : Int) : Int do
    if i >= n do m else max_go(a, i + 1, n, Math.max_int(m, NativeArray.get_int(a, i))) end
  end

  -- a count read as 0 when negative or above 1000000 (so the prefix sum stays far below 2^62)
  pfn count_ok(v : Int) : Bool do if v < 0 do false else v <= 1000000 end end
  pfn count_of(counts : NativeIntArr, i : Int) : Int do
    let v = NativeArray.get_int(counts, i)
    if count_ok(v) do v else 0 end
  end
  -- at[i] = counts[0] + .. + counts[i - 1] (negatives as 0), for i in 0..n
  pfn prefix_go(at : NativeIntArr, counts : NativeIntArr, i : Int, n : Int, sum : Int) : NativeIntArr do
    let at2 = NativeArray.set_int(at, i, sum)
    if i >= n do at2 else prefix_go(at2, counts, i + 1, n, sum + count_of(counts, i)) end
  end
  pfn neg_go(counts : NativeIntArr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc else neg_go(counts, i + 1, n, if count_ok(NativeArray.get_int(counts, i)) do acc else acc + 1 end) end
  end
  pfn badk_go(kinds : NativeIntArr, i : Int, n : Int, acc : Int) : Int do
    if i >= n do acc
    else
      let k = NativeArray.get_int(kinds, i)
      badk_go(kinds, i + 1, n, if k == 0 do acc else if k == 1 do acc else acc + 1 end end)
    end
  end
  -- the lowest (want_lo) or highest floor among the first n surfaces
  pfn floor_go(ys : NativeIntArr, kinds : NativeIntArr, i : Int, n : Int, want_lo : Bool, m : Int) : Int do
    if i >= n do m
    else if NativeArray.get_int(kinds, i) == 0 do
      let y = NativeArray.get_int(ys, i)
      floor_go(ys, kinds, i + 1, n, want_lo, if want_lo do Math.min_int(m, y) else Math.max_int(m, y) end)
    else floor_go(ys, kinds, i + 1, n, want_lo, m) end end
  end

  doc "The Ground with every surface of every column: counts[col] surfaces for column col (i + n * j), stored from the top down in ys (world voxel heights) and kinds (0 floor, 1 ceiling) at offsets the prefix sum of counts gives. Without it each column has one floor at tops[col]. Placers visit the floors; tops still give the column's ground top. It cannot fail: `problems` lists counts not n * n long, a count negative or above 1000000 (read as 0), ys or kinds not as long as the counts' sum, and a kind other than 0 or 1."
  fn with_surfaces(g : Ground, counts : NativeIntArr, ys : NativeIntArr, kinds : NativeIntArr) : Ground do
    let nc = NativeArray.length_int(counts)
    let at = prefix_go(NativeArray.make_int(nc + 1, 0), counts, 0, nc, 0)
    let total = NativeArray.get_int(at, nc)
    let seen = Math.min_int(total, Math.min_int(NativeArray.length_int(ys), NativeArray.length_int(kinds)))
    { g with pg_surf: true, pg_scnt: counts, pg_sat: at, pg_sys: ys, pg_skind: kinds, pg_stotal: total,
      pg_sneg: neg_go(counts, 0, nc, 0), pg_sbadk: badk_go(kinds, 0, NativeArray.length_int(kinds), 0),
      pg_flo: floor_go(ys, kinds, 0, seen, true, 4611686018427387903), pg_fhi: floor_go(ys, kinds, 0, seen, false, -4611686018427387903) }
  end

  doc "The Ground with built-in field `slot` (0..9) supplied over the same n x n area, values[i + n * j]; a slot supplied again replaces the earlier values. It cannot fail: `problems` lists a slot outside 0..9 or values not n * n long."
  fn with_field(g : Ground, slot : Int, values : NativeF32Arr) : Ground do
    { g with pg_slots: Cons((slot, values), g.pg_slots) }
  end

  pfn slot_values(slots : List((Int, NativeF32Arr)), s : Int) : Option(NativeF32Arr) do
    match slots do
      Nil -> None
      Cons((k, a), rest) -> if k == s do Some(a) else slot_values(rest, s) end
    end
  end

  pfn length_problem(what : String, len : Int, nn : Int) : List(String) do
    if len == nn do Nil else ["ground: " ++ what ++ " holds " ++ int_to_string(len) ++ " values for n * n = " ++ int_to_string(nn) ++ " columns"] end
  end
  pfn slot_problems(s : (Int, NativeF32Arr), nn : Int) : List(String) do
    match s do
      (k, a) ->
        let range = if k < 0 do true else k > 9 end
        List.append(if range do ["ground: slot " ++ int_to_string(k) ++ " is outside 0..9"] else Nil end, length_problem("slot " ++ int_to_string(k), NativeArray.length_f32(a), nn))
    end
  end

  pfn surface_problems(g : Ground, nn : Int) : List(String) do
    if g.pg_surf do
      let total = g.pg_stotal
      let nc = NativeArray.length_int(g.pg_scnt)
      let counts = if nc == nn do Nil else ["ground: surface counts hold " ++ int_to_string(nc) ++ " values for n * n = " ++ int_to_string(nn) ++ " columns"] end
      let ys = if NativeArray.length_int(g.pg_sys) == total do Nil else ["ground: surface ys hold " ++ int_to_string(NativeArray.length_int(g.pg_sys)) ++ " values for " ++ int_to_string(total) ++ " surfaces"] end
      let kinds = if NativeArray.length_int(g.pg_skind) == total do Nil else ["ground: surface kinds hold " ++ int_to_string(NativeArray.length_int(g.pg_skind)) ++ " values for " ++ int_to_string(total) ++ " surfaces"] end
      let neg = if g.pg_sneg == 0 do Nil else ["ground: " ++ int_to_string(g.pg_sneg) ++ (if g.pg_sneg == 1 do " surface count is" else " surface counts are" end) ++ " negative or above 1000000"] end
      let badk = if g.pg_sbadk == 0 do Nil else ["ground: " ++ int_to_string(g.pg_sbadk) ++ (if g.pg_sbadk == 1 do " surface kind is" else " surface kinds are" end) ++ " not 0 or 1"] end
      List.append(counts, List.append(ys, List.append(kinds, List.append(neg, badk))))
    else Nil end
  end

  doc "Everything wrong with g, one message each, or Nil: n not above 0, a scale not above 0 (or NaN), tops or waters or a supplied slot not n * n long, a slot outside 0..9; with surfaces, counts not n * n long, a count negative or above 1000000, ys or kinds not as long as the counts' sum, a kind other than 0 or 1. `fields` over a Ground with problems is a Table of zeros, and `place` returns the chunk unchanged."
  fn problems(g : Ground) : List(String) do
    let n = g.pg_n
    let nn = n * n
    let bad_n = if n > 0 do Nil else ["ground: n is " ++ int_to_string(n) ++ "; it must be above 0"] end
    let bad_scale = if g.pg_scale > 0.0 do Nil else ["ground: scale is " ++ float_to_string(g.pg_scale) ++ "; it must be above 0"] end
    let arrays = List.append(length_problem("tops", NativeArray.length_int(g.pg_tops), nn), length_problem("waters", NativeArray.length_int(g.pg_waters), nn))
    let slots = List.flat_map(List.reverse(g.pg_slots), fn s -> slot_problems(s, nn))
    List.append(bad_n, List.append(bad_scale, List.append(arrays, List.append(slots, surface_problems(g, nn)))))
  end

  -- ── Plan: a Frozen read once ──────────────────────────────────────────────

  pfn mem_int(xs : List(Int), x : Int) : Bool do List.any(xs, fn y -> y == x) end

  -- Evaluation steps: 3 * i + 0 field i, 3 * z + 1 zone z, 3 * l + 2 layer l's density.
  -- What a step reads: a curve field its source; a cover field its layer's
  -- density; a band its field; a not, all or any zone its members; a
  -- density the fields of its rule's curves and its inside and outside
  -- zones (a site layer's rule is empty).
  pfn step_reads(f : Strata.Population.Frozen, st : Int) : List(Int) do
    let i = st / 3
    let what = st % 3
    if what == 0 do
      let k = Pn.field_kind(f, i)
      if k == 2 do [3 * Pn.field_source(f, i)] else if k == 3 do [3 * Pn.field_layer(f, i) + 2] else Nil end end
    else if what == 1 do
      if Pn.zone_kind(f, i) == 1 do [3 * Pn.zone_field(f, i)] else List.map(Pn.zone_members(f, i), fn m -> 3 * m + 1) end
    else
      List.append(List.map(Pn.layer_curves(f, i), fn c -> match c do (fi, _) -> 3 * fi end), List.map(List.append(Pn.layer_inside(f, i), Pn.layer_outside(f, i)), fn z -> 3 * z + 1))
    end end
  end
  -- st after every step it reads, depth first (freeze refused cycles of fields, of zones and of layers' cover)
  pfn step_visit(f : Strata.Population.Frozen, st : Int, done_rev : List(Int)) : List(Int) do
    if mem_int(done_rev, st) do done_rev
    else Cons(st, List.fold_left(step_reads(f, st), done_rev, fn (acc, r) -> step_visit(f, r, acc)))
    end
  end
  -- every density in run order, then every field and zone not yet visited
  pfn step_order(f : Strata.Population.Frozen, nf : Int, nz : Int, nl : Int) : List(Int) do
    let roots = List.append(List.map(List.range(0, nl), fn l -> 3 * l + 2), List.append(List.map(List.range(0, nf), fn i -> 3 * i), List.map(List.range(0, nz), fn z -> 3 * z + 1)))
    List.reverse(List.fold_left(roots, Nil, fn (acc, st) -> step_visit(f, st, acc)))
  end

  -- the cover fields field i reaches through curve fields
  pfn field_covers(f : Strata.Population.Frozen, i : Int) : List(Int) do
    let k = Pn.field_kind(f, i)
    if k == 3 do [i] else if k == 2 do field_covers(f, Pn.field_source(f, i)) else Nil end end
  end
  -- the cover fields zone z reaches through its band's field and its members
  pfn zone_covers(f : Strata.Population.Frozen, z : Int) : List(Int) do
    if Pn.zone_kind(f, z) == 1 do field_covers(f, Pn.zone_field(f, z)) else List.flat_map(Pn.zone_members(f, z), fn m -> zone_covers(f, m)) end
  end
  -- the cover fields layer l reads: its rule's curves and zones and, for cover and scatter layers, its weights zones
  pfn layer_covers(f : Strata.Population.Frozen, l : Int) : List(Int) do
    let wz = if Pn.layer_kind(f, l) == 2 do Nil else List.map(Pn.shape_set_weights(f, Pn.layer_shape_set(f, l)), entry_zone) end
    let zs = List.append(Pn.layer_inside(f, l), List.append(Pn.layer_outside(f, l), wz))
    List.append(List.flat_map(Pn.layer_curves(f, l), fn c -> match c do (fi, _) -> field_covers(f, fi) end), List.flat_map(zs, fn z -> zone_covers(f, z)))
  end

  -- points (x, factor) interleaved
  pfn flat_points(pts : List((Float, Float))) : List(Float) do
    List.flat_map(pts, fn p -> match p do (x, y) -> [x, y] end)
  end

  -- where each of the lists starts when they are laid end to end from `at`
  pfn starts(lens : List(Int), at : Int) : List(Int) do
    match lens do
      Nil -> Nil
      Cons(l, rest) -> Cons(at, starts(rest, at + l))
    end
  end

  -- one padding entry, so no array is empty
  pfn ints(xs : List(Int)) : NativeIntArr do NativeArray.from_list_int(List.append(xs, [0])) end
  pfn floats(xs : List(Float)) : NativeFloatArr do NativeArray.from_list_float(List.append(xs, [0.0])) end

  pfn field_a(f : Strata.Population.Frozen, i : Int) : Int do
    let k = Pn.field_kind(f, i)
    if k == 0 do Pn.field_slot(f, i)
    else if k == 1 do Pn.field_noise_kind(f, i)
    else if k == 2 do Pn.field_source(f, i)
    else Pn.field_layer(f, i) end end end
  end
  pfn field_f(f : Strata.Population.Frozen, i : Int) : Float do
    if Pn.field_kind(f, i) == 3 do Pn.field_radius(f, i) else Pn.field_period(f, i) end
  end
  pfn field_pts(f : Strata.Population.Frozen, i : Int) : List((Float, Float)) do
    if Pn.field_kind(f, i) == 2 do Pn.curve_points(Pn.field_source_curve(f, i)) else Nil end
  end

  pfn zone_a(f : Strata.Population.Frozen, z : Int) : Int do
    let k = Pn.zone_kind(f, z)
    if k == 1 do Pn.zone_field(f, z)
    else if k == 5 do
      match Pn.zone_members(f, z) do
        Cons(m, _) -> m
        Nil -> 0
      end
    else 0 end end
  end
  pfn zone_lo_of(f : Strata.Population.Frozen, z : Int) : Float do
    if Pn.zone_kind(f, z) == 2 do Pn.zone_inner(f, z) *. Pn.zone_inner(f, z) else Pn.zone_lo(f, z) end
  end
  pfn zone_hi_of(f : Strata.Population.Frozen, z : Int) : Float do
    if Pn.zone_kind(f, z) == 2 do Pn.zone_outer(f, z) *. Pn.zone_outer(f, z) else Pn.zone_hi(f, z) end
  end
  -- a zone's ids (regions) or members (all, any)
  pfn zone_int_list(f : Strata.Population.Frozen, z : Int) : List(Int) do
    let k = Pn.zone_kind(f, z)
    if k == 0 do Pn.zone_ids(f, z)
    else if k == 3 do Pn.zone_members(f, z)
    else if k == 4 do Pn.zone_members(f, z)
    else Nil end end end
  end
  pfn site_pair(s : Strata.Population.PopSite) : List(Float) do [Pn.site_xm(s), Pn.site_zm(s)] end
  pfn zone_site_list(f : Strata.Population.Frozen, z : Int) : List(Float) do
    if Pn.zone_kind(f, z) == 2 do List.flat_map(Pn.zone_sites(f, z), site_pair) else Nil end
  end
  pfn pick_start(kinds : List(Int), int_at : List(Int), site_at : List(Int)) : List(Int) do
    match kinds do
      Nil -> Nil
      Cons(k, ks) ->
        match int_at do
          Cons(a, as2) ->
            match site_at do
              Cons(b, bs) -> Cons(if k == 2 do b else a end, pick_start(ks, as2, bs))
              Nil -> Nil
            end
          Nil -> Nil
        end
    end
  end

  -- (field, first point, count) triples for curves whose points start at num_at, and the points
  pfn curves_code(cs : List((Int, Strata.Population.PopCurve)), num_at : Int) : (List(Int), List(Float)) do
    match cs do
      Nil -> (Nil, Nil)
      Cons((fi, c), rest) ->
        let pts = Pn.curve_points(c)
        let flat = flat_points(pts)
        match curves_code(rest, num_at + List.length(flat)) do
          (code, nums) -> (Cons(fi, Cons(num_at, Cons(List.length(pts), code))), List.append(flat, nums))
        end
    end
  end

  -- layer l's program and points, its points starting at num_at in pl_num
  pfn layer_code(f : Strata.Population.Frozen, l : Int, num_at : Int) : (List(Int), List(Float)) do
    let cs = Pn.layer_curves(f, l)
    let ins = Pn.layer_inside(f, l)
    let outs = Pn.layer_outside(f, l)
    match curves_code(cs, num_at) do
      (code, nums) -> (Cons(List.length(cs), List.append(code, Cons(List.length(ins), List.append(ins, Cons(List.length(outs), outs))))), nums)
    end
  end

  -- offsets, programs, points for layers l.. (code_at: where l's program starts in pl_prog)
  pfn compile_rules(f : Strata.Population.Frozen, l : Int, nl : Int, code_at : Int, num_at : Int) : (List(Int), List(Int), List(Float)) do
    if l >= nl do (Nil, Nil, Nil)
    else
      match layer_code(f, l, num_at) do
        (code, nums) ->
          match compile_rules(f, l + 1, nl, code_at + List.length(code), num_at + List.length(nums)) do
            (offs, code2, nums2) -> (Cons(code_at, offs), List.append(code, code2), List.append(nums, nums2))
          end
      end
    end
  end

  -- weights over their sum, cumulative: exactly 1.0 from the last weight above 0 on
  pfn cum_go(ws : List(Float), run : Float, sum : Float) : List(Float) do
    match ws do
      Nil -> Nil
      Cons(w, rest) ->
        let r = run +. w
        Cons(if r == sum do 1.0 else r /. sum end, cum_go(rest, r, sum))
    end
  end
  pfn cumulative(ws : List(Float)) : List(Float) do cum_go(ws, 0.0, List.fold_left(ws, 0.0, fn (a, w) -> a +. w)) end
  pfn entry_zone(e : (Int, List(Float))) : Int do match e do (z, _) -> z end end
  pfn entry_weights(e : (Int, List(Float))) : List(Float) do match e do (_, w) -> w end end
  -- layer l's block ids: its shape set's ids when the set holds blocks, whatever the layer's kind; none when it holds templates
  pfn layer_blocks(f : Strata.Population.Frozen, l : Int) : List(Int) do
    let s = Pn.layer_shape_set(f, l)
    if Pn.shape_set_kind(f, s) == 0 do Pn.shape_set_blocks(f, s) else Nil end
  end
  pfn layer_weights(f : Strata.Population.Frozen, l : Int) : List((Int, List(Float))) do Pn.shape_set_weights(f, Pn.layer_shape_set(f, l)) end
  -- a scatter or site layer's templates (none for a set of blocks, or a cover layer)
  pfn stamp_templates(f : Strata.Population.Frozen, l : Int) : List(Strata.Template.Template) do
    if Pn.layer_kind(f, l) == 0 do Nil else Pn.shape_set_templates(f, Pn.layer_shape_set(f, l)) end
  end
  -- a site layer's sites, each with the layer's margin (none for another kind)
  pfn layer_site_list(f : Strata.Population.Frozen, l : Int) : List((Strata.Population.PopSite, Float)) do
    if Pn.layer_kind(f, l) == 2 do List.map(Pn.layer_sites(f, l), fn s -> (s, Pn.layer_margin(f, l))) else Nil end
  end
  pfn sp_site(e : (Strata.Population.PopSite, Float)) : Strata.Population.PopSite do match e do (s, _) -> s end end
  pfn sp_margin(e : (Strata.Population.PopSite, Float)) : Float do match e do (_, m) -> m end end
  -- the largest side or height, in voxels, of ts; 1 for none
  pfn ext_of(ts : List(Strata.Template.Template)) : Int do
    List.fold_left(ts, 1, fn (m, t) -> Math.max_int(m, Math.max_int(Strata.Template.t_sx(t), Math.max_int(Strata.Template.t_sy(t), Strata.Template.t_sz(t)))))
  end
  -- floats held as 32-bit floats, one padding entry
  pfn f32s(xs : List(Float)) : NativeF32Arr do
    f32_fill(NativeArray.make_f32(List.length(xs) + 1, 0.0), xs, 0)
  end
  pfn f32_fill(a : NativeF32Arr, xs : List(Float), i : Int) : NativeF32Arr do
    match xs do
      Nil -> a
      Cons(x, rest) -> f32_fill(NativeArray.set_f32(a, i, x), rest, i + 1)
    end
  end

  doc "f read once into flat arrays: the order its fields and zones are evaluated in, what each needs, and every layer's rule compiled. Build one per Frozen and keep it; a plan is immutable. A caller sharing one plan between worker tasks should unpack what a loop needs from it before the loop, not read it per column (GAPS S15); fields_with does so."
  fn plan(f : Strata.Population.Frozen) : PopPlan do
    let nf = Pn.field_count(f)
    let nz = Pn.zone_count(f)
    let nl = Pn.layer_count(f)
    let fis = List.range(0, nf)
    let zis = List.range(0, nz)
    let fpts = List.map(fis, fn i -> flat_points(field_pts(f, i)))
    let zints = List.map(zis, fn z -> zone_int_list(f, z))
    let zsites = List.map(zis, fn z -> zone_site_list(f, z))
    let zkinds = List.map(zis, fn z -> Pn.zone_kind(f, z))
    let zat = pick_start(zkinds, starts(List.map(zints, List.length), 0), starts(List.map(zsites, List.length), 0))
    let zcnt = List.map(zis, fn z -> if Pn.zone_kind(f, z) == 2 do List.length(Pn.zone_sites(f, z)) else List.length(zone_int_list(f, z)) end)
    let lis = List.range(0, nl)
    let lkinds = List.map(lis, fn l -> Pn.layer_kind(f, l))
    let lblocks = List.map(lis, fn l -> layer_blocks(f, l))
    let lws = List.map(lis, fn l -> layer_weights(f, l))
    let entries = List.flat_map(lws, fn ws -> ws)
    let lvn = List.map(lblocks, List.length)
    let stamps = List.flat_map(lis, fn l -> stamp_templates(f, l))
    let lsites = List.map(lis, fn l -> layer_site_list(f, l))
    let sites = List.flat_map(lsites, fn xs -> xs)
    let sfl = f32s(List.map(sites, fn e -> Pn.site_floor(sp_site(e))))
    let ns = List.length(sites)
    -- the lowest and highest floor as held (32-bit), NaN skipped
    let floors = List.filter(List.map(List.range(0, ns), fn i -> NativeArray.get_f32(sfl, i)), fn v -> v == v)
    let huge = Math.pow(10.0, 300.0)
    let sizes = List.map(stamps, Strata.Template.t_voxel_size)
    let lcovers = List.map(lis, fn l -> layer_covers(f, l))
    let steps = step_order(f, nf, nz, nl)
    let ncover = List.length(List.filter(List.zip(lkinds, lvn), fn kv -> match kv do (k, v) -> if k == 0 do v > 0 else false end end))
    -- one padding entry after the offsets and after the bases
    match compile_rules(f, 0, nl, nl + 1, nl + 1) do
      (offs, code, nums) ->
        { pl_names: Pn.field_names(f), pl_nf: nf, pl_nz: nz, pl_nl: nl,
          pl_nsteps: List.length(steps),
          pl_steps: ints(steps),
          pl_fkind: ints(List.map(fis, fn i -> Pn.field_kind(f, i))),
          pl_fa: ints(List.map(fis, fn i -> field_a(f, i))),
          pl_foct: ints(List.map(fis, fn i -> Pn.field_octaves(f, i))),
          pl_fsalt: ints(List.map(fis, fn i -> Pn.field_salt(f, i))),
          pl_fper: floats(List.map(fis, fn i -> field_f(f, i))),
          pl_fat: ints(starts(List.map(fpts, List.length), 0)),
          pl_fcnt: ints(List.map(fis, fn i -> List.length(field_pts(f, i)))),
          pl_fpts: floats(List.flat_map(fpts, fn xs -> xs)),
          pl_zkind: ints(zkinds),
          pl_za: ints(List.map(zis, fn z -> zone_a(f, z))),
          pl_zlo: floats(List.map(zis, fn z -> zone_lo_of(f, z))),
          pl_zhi: floats(List.map(zis, fn z -> zone_hi_of(f, z))),
          pl_zat: ints(zat),
          pl_zcnt: ints(zcnt),
          pl_zints: ints(List.flat_map(zints, fn xs -> xs)),
          pl_zsites: floats(List.flat_map(zsites, fn xs -> xs)),
          pl_prog: NativeArray.from_list_i32(List.append(offs, Cons(0, code))),
          pl_num: NativeArray.from_list_float(List.append(List.map(List.range(0, nl), fn l -> Pn.layer_base(f, l)), Cons(0.0, nums))),
          pl_lkind: ints(lkinds),
          pl_lsalt: ints(List.map(lis, fn l -> Pn.layer_salt(f, l))),
          pl_lvat: ints(starts(lvn, 0)),
          pl_lvn: ints(lvn),
          pl_lids: ints(List.flat_map(lblocks, fn xs -> xs)),
          pl_lwat: ints(starts(List.map(lws, List.length), 0)),
          pl_lwn: ints(List.map(lws, List.length)),
          pl_wzone: ints(List.map(entries, entry_zone)),
          pl_wbase: ints(starts(List.map(entries, fn e -> List.length(entry_weights(e))), 0)),
          pl_wcum: floats(List.flat_map(entries, fn e -> cumulative(entry_weights(e)))),
          pl_ncover: ncover,
          pl_lnv: ints(List.map(lis, fn l -> Pn.shape_set_variants(f, Pn.layer_shape_set(f, l)))),
          pl_lcell: floats(List.map(lis, fn l -> Pn.layer_cell(f, l))),
          pl_ljit: floats(List.map(lis, fn l -> Pn.layer_jitter(f, l))),
          pl_lreach: floats(List.map(lis, fn l -> Pn.shape_set_reach(f, Pn.layer_shape_set(f, l)))),
          pl_ltemps: List.map(lis, fn l -> stamp_templates(f, l)),
          pl_nscatter: List.length(List.filter(lkinds, fn k -> k == 1)),
          pl_reach: Pn.reach(f),
          pl_hmax: List.fold_left(stamps, 1, fn (m, t) -> Math.max_int(m, Strata.Template.t_sy(t))),
          pl_tvlo: List.fold_left(sizes, List.fold_left(sizes, 0.0, fn (m, v) -> if v > m do v else m end), fn (m, v) -> if v < m do v else m end),
          pl_tvhi: List.fold_left(sizes, 0.0, fn (m, v) -> if v > m do v else m end),
          pl_nsite: List.length(List.filter(lkinds, fn k -> k == 2)),
          pl_ns: ns,
          pl_lsat: ints(starts(List.map(lsites, List.length), 0)),
          pl_lsn: ints(List.map(lsites, List.length)),
          pl_lext: ints(List.map(lis, fn l -> ext_of(stamp_templates(f, l)))),
          pl_sx: floats(List.map(sites, fn e -> Pn.site_xm(sp_site(e)))),
          pl_sz: floats(List.map(sites, fn e -> Pn.site_zm(sp_site(e)))),
          pl_sfl: sfl,
          pl_srad: floats(List.map(sites, fn e -> Pn.site_radius(sp_site(e)))),
          pl_smar: floats(List.map(sites, sp_margin)),
          pl_sidx: ints(List.map(sites, fn e -> Pn.site_index(sp_site(e)))),
          pl_sflo: List.fold_left(floors, huge, fn (m, v) -> if v < m do v else m end),
          pl_sfhi: List.fold_left(floors, 0.0 -. huge, fn (m, v) -> if v > m do v else m end),
          pl_crat: ints(starts(List.map(lcovers, List.length), 0)),
          pl_crn: ints(List.map(lcovers, List.length)),
          pl_crf: ints(List.flat_map(lcovers, fn xs -> xs)),
          pl_lseen: ints(List.map(lis, fn l -> if Pn.layer_kind(f, l) == 0 do 0 else if Pn.shape_set_kind(f, Pn.layer_shape_set(f, l)) != 1 do 0 else Pn.layer_seen_to(f, l) end end)),
          pl_lwide: floats(List.map(lis, fn l -> Pn.shape_set_widest(f, Pn.layer_shape_set(f, l)))),
          pl_lrank: List.map(lis, fn l -> Pn.shape_set_ranks(f, Pn.layer_shape_set(f, l))) }
    end
  end

  -- ── Fields ────────────────────────────────────────────────────────────────

  -- dst[off + k] = src[k] for k < cnt
  pfn copy_into(dst : NativeF32Arr, off : Int, src : NativeF32Arr, k : Int, cnt : Int) : NativeF32Arr do
    if k >= cnt do dst else copy_into(NativeArray.set_f32(dst, off + k, NativeArray.get_f32(src, k)), off, src, k + 1, cnt) end
  end

  -- a curve of cnt points at num[off..]: piecewise linear, flat beyond the ends (as Pn.curve_at).
  -- Plain code with Float-valued branches: March boxes a Float-valued `if`
  -- (march-language/march#1263, a fix in progress); the cost is recorded, not dodged.
  pfn curve_go(num : NativeFloatArr, off : Int, k : Int, cnt : Int, x : Float) : Float do
    let yk = NativeArray.get_float(num, off + 2 * k + 1)
    if k + 1 >= cnt do yk
    else
      let x1 = NativeArray.get_float(num, off + 2 * k + 2)
      if x < x1 do
        let xk = NativeArray.get_float(num, off + 2 * k)
        let y1 = NativeArray.get_float(num, off + 2 * k + 3)
        yk +. (y1 -. yk) *. (x -. xk) /. (x1 -. xk)
      else curve_go(num, off, k + 1, cnt, x) end
    end
  end
  pfn curve_eval(num : NativeFloatArr, off : Int, cnt : Int, x : Float) : Float do
    if cnt <= 0 do 0.0
    else if x < NativeArray.get_float(num, off) do NativeArray.get_float(num, off + 1)
    else curve_go(num, off, 0, cnt, x) end end
  end

  -- vals[dst + k] = curve(vals[src + k])
  pfn curve_into(vals : NativeF32Arr, dst : Int, src : Int, num : NativeFloatArr, at : Int, cnt : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do vals
    else curve_into(NativeArray.set_f32(vals, dst + k, curve_eval(num, at, cnt, NativeArray.get_f32(vals, src + k))), dst, src, num, at, cnt, k + 1, nn) end
  end

  -- a / b rounded down (b > 0)
  pfn floor_div(a : Int, b : Int) : Int do if a >= 0 do a / b else 0 - ((b - 1 - a) / b) end end

  -- the Ground's columns that fall in a tile, from the tile's samples: vals[off + (X - x0) + n * (Z - z0)] = 0.5 + 0.5 * out[(X - tx0) + 32 * (Z - tz0)]
  pfn tile_copy(vals : NativeF32Arr, off : Int, out : NativeF32Arr, x0 : Int, z0 : Int, n : Int, tx0 : Int, tz0 : Int, xa : Int, xb : Int, zb : Int, x : Int, z : Int) : NativeF32Arr do
    if z >= zb do vals
    else if x >= xb do tile_copy(vals, off, out, x0, z0, n, tx0, tz0, xa, xb, zb, xa, z + 1)
    else
      let v = 0.5 +. 0.5 *. NativeArray.get_f32(out, (x - tx0) + 32 * (z - tz0))
      tile_copy(NativeArray.set_f32(vals, off + (x - x0) + n * (z - z0), v), off, out, x0, z0, n, tx0, tz0, xa, xb, zb, x + 1, z)
    end end
  end

  -- One world-aligned tile of 32 x 32 columns, tile (tx, tz): its origin and
  -- step come from the tile's index and the voxel size only, never from the
  -- Ground, so every Ground reads the same bits at a shared column.
  pfn tile_into(vals : NativeF32Arr, off : Int, s : Strata.Noise.Settings, nseed : Int, freq : Float, voxel : Float, x0 : Int, z0 : Int, n : Int, tx : Int, tz : Int) : NativeF32Arr do
    let out = NativeArray.make_f32(1024, 0.0)
    let tx0 = 32 * tx
    let tz0 = 32 * tz
    let wrote = Strata.Noise.field2(s, nseed, freq, (int_to_float(tx0) +. 0.5) *. voxel, (int_to_float(tz0) +. 0.5) *. voxel, voxel, 32, 32, out)
    if wrote == 1024 do
      let xa = Math.max_int(x0, tx0)
      let za = Math.max_int(z0, tz0)
      tile_copy(vals, off, out, x0, z0, n, tx0, tz0, xa, Math.min_int(x0 + n, tx0 + 32), Math.min_int(z0 + n, tz0 + 32), xa, za)
    else vals end
  end
  pfn tiles_go(vals : NativeF32Arr, off : Int, s : Strata.Noise.Settings, nseed : Int, freq : Float, voxel : Float, x0 : Int, z0 : Int, n : Int, ta : Int, tb : Int, tzb : Int, tx : Int, tz : Int) : NativeF32Arr do
    if tz > tzb do vals
    else if tx > tb do tiles_go(vals, off, s, nseed, freq, voxel, x0, z0, n, ta, tb, tzb, ta, tz + 1)
    else tiles_go(tile_into(vals, off, s, nseed, freq, voxel, x0, z0, n, tx, tz), off, s, nseed, freq, voxel, x0, z0, n, ta, tb, tzb, tx + 1, tz) end end
  end

  pfn eval_field(p : PopPlan, seed : Int, g : Ground, nn : Int, vals : NativeF32Arr, i : Int) : NativeF32Arr do
    let kind = NativeArray.get_int(p.pl_fkind, i)
    let a = NativeArray.get_int(p.pl_fa, i)
    if kind == 0 do
      match slot_values(g.pg_slots, a) do
        Some(arr) -> copy_into(vals, i * nn, arr, 0, nn)
        None -> vals
      end
    else if kind == 1 do
      -- lacunarity 2, gain 0.5, fBm, no warp, at 1 / period; on world-aligned tiles, sampled at column centres; read as 0..1
      let s = Strata.Noise.settings(a, NativeArray.get_int(p.pl_foct, i), 2.0, 0.5, 1, 0.0)
      let nseed = Strata.Seed.mix(seed, NativeArray.get_int(p.pl_fsalt, i))
      let freq = 1.0 /. NativeArray.get_float(p.pl_fper, i)
      let x0 = g.pg_x0
      let z0 = g.pg_z0
      let n = g.pg_n
      let tz = floor_div(z0, 32)
      tiles_go(vals, i * nn, s, nseed, freq, g.pg_voxel, x0, z0, n, floor_div(x0, 32), floor_div(x0 + n - 1, 32), floor_div(z0 + n - 1, 32), floor_div(x0, 32), tz)
    else if kind == 2 do curve_into(vals, i * nn, a * nn, p.pl_fpts, NativeArray.get_int(p.pl_fat, i), NativeArray.get_int(p.pl_fcnt, i), 0, nn)
    else vals end end end
  end

  -- ── Zones ─────────────────────────────────────────────────────────────────

  pfn b2u(b : Bool) : Int do if b do 1 else 0 end end

  pfn has_id(ids : NativeIntArr, k : Int, end_at : Int, r : Int) : Bool do
    if k >= end_at do false else if NativeArray.get_int(ids, k) == r do true else has_id(ids, k + 1, end_at, r) end end
  end
  -- a region value rounded to the nearest integer is one of ids[at .. at + cnt]; NaN, and values too large to round, match nothing
  pfn region_in(ids : NativeIntArr, at : Int, cnt : Int, v : Float) : Bool do
    if v > 0.0 -. 1000000000000000.0 do
      if v < 1000000000000000.0 do has_id(ids, at, at + cnt, float_to_int(Math.floor(v +. 0.5))) else false end
    else false end
  end
  pfn regions_go(zs : NativeU8Arr, off : Int, reg : NativeF32Arr, ids : NativeIntArr, at : Int, cnt : Int, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else regions_go(NativeArray.set_u8(zs, off + k, b2u(region_in(ids, at, cnt, NativeArray.get_f32(reg, k)))), off, reg, ids, at, cnt, k + 1, nn) end
  end
  -- region slot 7 not supplied reads 0 at every column
  pfn regions_zero(zs : NativeU8Arr, off : Int, hit : Int, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs else regions_zero(NativeArray.set_u8(zs, off + k, hit), off, hit, k + 1, nn) end
  end

  -- lo <= field < hi (a NaN is outside)
  pfn band_go(zs : NativeU8Arr, off : Int, vals : NativeF32Arr, src : Int, lo : Float, hi : Float, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else
      let v = NativeArray.get_f32(vals, src + k)
      let inside = if v >= lo do v < hi else false end
      band_go(NativeArray.set_u8(zs, off + k, b2u(inside)), off, vals, src, lo, hi, k + 1, nn)
    end
  end

  -- inner <= distance < outer from some site (sites as xm, zm pairs from at)
  pfn near_site(xz : NativeFloatArr, s : Int, end_at : Int, xm : Float, zm : Float, in2 : Float, out2 : Float) : Bool do
    if s >= end_at do false
    else
      let dx = xm -. NativeArray.get_float(xz, 2 * s)
      let dz = zm -. NativeArray.get_float(xz, 2 * s + 1)
      let d2 = dx *. dx +. dz *. dz
      if d2 >= in2 do (if d2 < out2 do true else near_site(xz, s + 1, end_at, xm, zm, in2, out2) end)
      else near_site(xz, s + 1, end_at, xm, zm, in2, out2) end
    end
  end
  -- column k's centre is ((x0 + k mod n + 0.5) * voxel, (z0 + k / n + 0.5) * voxel)
  pfn ring_go(zs : NativeU8Arr, off : Int, n : Int, x0 : Int, z0 : Int, voxel : Float, xz : NativeFloatArr, s0 : Int, s1 : Int, in2 : Float, out2 : Float, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else
      let xm = (int_to_float(x0 + k % n) +. 0.5) *. voxel
      let zm = (int_to_float(z0 + k / n) +. 0.5) *. voxel
      ring_go(NativeArray.set_u8(zs, off + k, b2u(near_site(xz, s0, s1, xm, zm, in2, out2))), off, n, x0, z0, voxel, xz, s0, s1, in2, out2, k + 1, nn)
    end
  end

  -- every member of ms[m .. end_at] reads want at column k
  pfn every_is(zs : NativeU8Arr, ms : NativeIntArr, m : Int, end_at : Int, nn : Int, k : Int, want : Int) : Bool do
    if m >= end_at do true
    else if NativeArray.get_u8(zs, NativeArray.get_int(ms, m) * nn + k) == want do every_is(zs, ms, m + 1, end_at, nn, k, want)
    else false end end
  end
  -- all: every member holds; any: not every member fails
  pfn combine_go(zs : NativeU8Arr, off : Int, ms : NativeIntArr, at : Int, end_at : Int, any : Bool, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs
    else
      let v = if any do b2u(!every_is(zs, ms, at, end_at, nn, k, 0)) else b2u(every_is(zs, ms, at, end_at, nn, k, 1)) end
      combine_go(NativeArray.set_u8(zs, off + k, v), off, ms, at, end_at, any, k + 1, nn)
    end
  end
  pfn not_go(zs : NativeU8Arr, off : Int, src : Int, k : Int, nn : Int) : NativeU8Arr do
    if k >= nn do zs else not_go(NativeArray.set_u8(zs, off + k, 1 - NativeArray.get_u8(zs, src + k)), off, src, k + 1, nn) end
  end

  pfn eval_zone(p : PopPlan, g : Ground, nn : Int, vals : NativeF32Arr, zs : NativeU8Arr, z : Int) : NativeU8Arr do
    let kind = NativeArray.get_int(p.pl_zkind, z)
    let off = z * nn
    let at = NativeArray.get_int(p.pl_zat, z)
    let cnt = NativeArray.get_int(p.pl_zcnt, z)
    if kind == 0 do
      match slot_values(g.pg_slots, 7) do
        Some(reg) -> regions_go(zs, off, reg, p.pl_zints, at, cnt, 0, nn)
        None -> regions_zero(zs, off, b2u(has_id(p.pl_zints, at, at + cnt, 0)), 0, nn)
      end
    else if kind == 1 do band_go(zs, off, vals, NativeArray.get_int(p.pl_za, z) * nn, NativeArray.get_float(p.pl_zlo, z), NativeArray.get_float(p.pl_zhi, z), 0, nn)
    else if kind == 2 do ring_go(zs, off, g.pg_n, g.pg_x0, g.pg_z0, g.pg_voxel, p.pl_zsites, at / 2, at / 2 + cnt, NativeArray.get_float(p.pl_zlo, z), NativeArray.get_float(p.pl_zhi, z), 0, nn)
    else if kind == 5 do not_go(zs, off, NativeArray.get_int(p.pl_za, z) * nn, 0, nn)
    else combine_go(zs, off, p.pl_zints, at, at + cnt, kind == 4, 0, nn)
    end end end end
  end


  -- ── Layer densities ───────────────────────────────────────────────────────

  pfn fill_go(d : NativeF32Arr, off : Int, v : Float, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d else fill_go(NativeArray.set_f32(d, off + k, v), off, v, k + 1, nn) end
  end
  -- d[off + k] *= curve(vals[src + k])
  pfn times_curve(d : NativeF32Arr, off : Int, vals : NativeF32Arr, src : Int, num : NativeFloatArr, at : Int, cnt : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d
    else times_curve(NativeArray.set_f32(d, off + k, NativeArray.get_f32(d, off + k) *. curve_eval(num, at, cnt, NativeArray.get_f32(vals, src + k))), off, vals, src, num, at, cnt, k + 1, nn) end
  end
  pfn curves_go(d : NativeF32Arr, off : Int, vals : NativeF32Arr, prog : NativeI32Arr, num : NativeFloatArr, at : Int, cnt : Int, nn : Int) : NativeF32Arr do
    if cnt <= 0 do d
    else
      let src = NativeArray.get_i32(prog, at) * nn
      curves_go(times_curve(d, off, vals, src, num, NativeArray.get_i32(prog, at + 1), NativeArray.get_i32(prog, at + 2), 0, nn), off, vals, prog, num, at + 3, cnt - 1, nn)
    end
  end
  -- d[off + k] = 0 where zone src reads bad
  pfn zero_where(d : NativeF32Arr, off : Int, zs : NativeU8Arr, src : Int, bad : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d
    else if NativeArray.get_u8(zs, src + k) == bad do zero_where(NativeArray.set_f32(d, off + k, 0.0), off, zs, src, bad, k + 1, nn)
    else zero_where(d, off, zs, src, bad, k + 1, nn) end end
  end
  pfn zones_go(d : NativeF32Arr, off : Int, zs : NativeU8Arr, prog : NativeI32Arr, at : Int, cnt : Int, bad : Int, nn : Int) : NativeF32Arr do
    if cnt <= 0 do d else zones_go(zero_where(d, off, zs, NativeArray.get_i32(prog, at) * nn, bad, 0, nn), off, zs, prog, at + 1, cnt - 1, bad, nn) end
  end
  -- 0 or above: a negative product or a NaN reads 0
  pfn clamp_go(d : NativeF32Arr, off : Int, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do d
    else if NativeArray.get_f32(d, off + k) > 0.0 do clamp_go(d, off, k + 1, nn)
    else clamp_go(NativeArray.set_f32(d, off + k, 0.0), off, k + 1, nn) end end
  end

  -- layer l over every column: the base, times each curve of its field, 0 where a zone fails, clamped at 0
  pfn layer_into(d : NativeF32Arr, prog : NativeI32Arr, num : NativeFloatArr, vals : NativeF32Arr, zs : NativeU8Arr, nn : Int, l : Int) : NativeF32Arr do
    let off = l * nn
    let at = NativeArray.get_i32(prog, l)
    let nc = NativeArray.get_i32(prog, at)
    let ins_at = at + 1 + 3 * nc
    let ni = NativeArray.get_i32(prog, ins_at)
    let outs_at = ins_at + 1 + ni
    let no = NativeArray.get_i32(prog, outs_at)
    let d1 = curves_go(fill_go(d, off, NativeArray.get_float(num, l), 0, nn), off, vals, prog, num, at + 1, nc, nn)
    clamp_go(zones_go(zones_go(d1, off, zs, prog, outs_at + 1, no, 1, nn), off, zs, prog, ins_at + 1, ni, 0, nn), off, 0, nn)
  end

  -- the largest of d[off .. off + nn] (densities are never below 0)
  pfn dmax_col(d : NativeF32Arr, off : Int, k : Int, nn : Int, m : Float) : Float do
    if k >= nn do m
    else
      let v = NativeArray.get_f32(d, off + k)
      dmax_col(d, off, k + 1, nn, if v > m do v else m end)
    end
  end
  pfn dmax_go(out : NativeF32Arr, d : NativeF32Arr, nn : Int, l : Int, nl : Int) : NativeF32Arr do
    if l >= nl do out else dmax_go(NativeArray.set_f32(out, l, dmax_col(d, l * nn, 0, nn, 0.0)), d, nn, l + 1, nl) end
  end


  -- ── Cover fields ──────────────────────────────────────────────────────────
  --
  -- A cover field of layer s at a column, radius r metres:
  --   scatter  the number of s's instances (the candidates instances lists)
  --            whose base lies within r of the column's centre, over
  --            pi r^2 / cell^2 (the most its cells can hold there), at most 1;
  --   cover    s's density times the column's area (voxel^2), at most 1;
  --   site     1 where some site of s has its centre within its own radius
  --            plus r of the column's centre, else 0.
  -- Only instances standing on the Ground are counted, so a column's count
  -- is whole where the Ground holds every column within r of it with s's
  -- density right there: pad grows by the radius for that (see plan_pad).

  -- v as a column index of an n-column Ground, clamped to 0..n - 1 before it is an Int (NaN reads 0)
  pfn col_clamp(v : Float, n : Int) : Int do
    if v >= 0.0 do (if v <= int_to_float(n - 1) do float_to_int(v) else n - 1 end) else 0 end
  end
  -- counts[i + n * j] + 1 for every column i in ia..ib, j in ja..jb whose centre is within r (r2 = r^2) of (xm, zm)
  pfn count_near(counts : NativeIntArr, xm : Float, zm : Float, r2 : Float, x0 : Int, z0 : Int, n : Int, voxel : Float, ia : Int, ib : Int, jb : Int, i : Int, j : Int) : NativeIntArr do
    if j > jb do counts
    else if i > ib do count_near(counts, xm, zm, r2, x0, z0, n, voxel, ia, ib, jb, ia, j + 1)
    else
      let dx = xm -. (int_to_float(x0 + i) +. 0.5) *. voxel
      let dz = zm -. (int_to_float(z0 + j) +. 0.5) *. voxel
      if dx *. dx +. dz *. dz <= r2 do count_near(NativeArray.set_int(counts, i + n * j, NativeArray.get_int(counts, i + n * j) + 1), xm, zm, r2, x0, z0, n, voxel, ia, ib, jb, i + 1, j)
      else count_near(counts, xm, zm, r2, x0, z0, n, voxel, ia, ib, jb, i + 1, j) end
    end end
  end
  -- every placement of xs counted at the columns within r of its base
  pfn count_all(counts : NativeIntArr, xs : List(Strata.Feature.Placed), r : Float, x0 : Int, z0 : Int, n : Int, voxel : Float) : NativeIntArr do
    match xs do
      Nil -> counts
      Cons(c, rest) ->
        let xm = Strata.Feature.p_xm(c)
        let zm = Strata.Feature.p_zm(c)
        let ia = col_clamp(Math.floor((xm -. r) /. voxel) -. int_to_float(x0), n)
        let ib = col_clamp(Math.floor((xm +. r) /. voxel) -. int_to_float(x0), n)
        let ja = col_clamp(Math.floor((zm -. r) /. voxel) -. int_to_float(z0), n)
        let jb = col_clamp(Math.floor((zm +. r) /. voxel) -. int_to_float(z0), n)
        count_all(count_near(counts, xm, zm, r *. r, x0, z0, n, voxel, ia, ib, jb, ia, ja), rest, r, x0, z0, n, voxel)
    end
  end
  -- vals[off + k] = counts[k] / norm, at most 1
  pfn ratio_into(vals : NativeF32Arr, off : Int, counts : NativeIntArr, norm : Float, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do vals
    else
      let v = int_to_float(NativeArray.get_int(counts, k)) /. norm
      ratio_into(NativeArray.set_f32(vals, off + k, if v > 1.0 do 1.0 else v end), off, counts, norm, k + 1, nn)
    end
  end
  -- vals[off + k] = d[doff + k] * area, at most 1 (densities are 0 or more)
  pfn chance_into(vals : NativeF32Arr, off : Int, d : NativeF32Arr, doff : Int, area : Float, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do vals
    else
      let v = NativeArray.get_f32(d, doff + k) *. area
      chance_into(NativeArray.set_f32(vals, off + k, if v > 1.0 do 1.0 else v end), off, d, doff, area, k + 1, nn)
    end
  end
  -- some site s.. of cnt (x, z, reach) is within its reach of (xm, zm) (NaN is never within)
  pfn site_within(xs : NativeFloatArr, zs : NativeFloatArr, rs : NativeFloatArr, s : Int, cnt : Int, xm : Float, zm : Float) : Bool do
    if s >= cnt do false
    else
      let dx = xm -. NativeArray.get_float(xs, s)
      let dz = zm -. NativeArray.get_float(zs, s)
      let rr = NativeArray.get_float(rs, s)
      if dx *. dx +. dz *. dz <= rr *. rr do true else site_within(xs, zs, rs, s + 1, cnt, xm, zm) end
    end
  end
  pfn sites_into(vals : NativeF32Arr, off : Int, xs : NativeFloatArr, zs : NativeFloatArr, rs : NativeFloatArr, cnt : Int, x0 : Int, z0 : Int, n : Int, voxel : Float, k : Int, nn : Int) : NativeF32Arr do
    if k >= nn do vals
    else
      let xm = (int_to_float(x0 + k % n) +. 0.5) *. voxel
      let zm = (int_to_float(z0 + k / n) +. 0.5) *. voxel
      if site_within(xs, zs, rs, 0, cnt, xm, zm) do sites_into(NativeArray.set_f32(vals, off + k, 1.0), off, xs, zs, rs, cnt, x0, z0, n, voxel, k + 1, nn)
      else sites_into(vals, off, xs, zs, rs, cnt, x0, z0, n, voxel, k + 1, nn) end
    end
  end

  -- cover field i over g, its layer's density already in d
  pfn eval_cover(p : PopPlan, seed : Int, g : Ground, nn : Int, vals : NativeF32Arr, d : NativeF32Arr, i : Int) : NativeF32Arr do
    let s = NativeArray.get_int(p.pl_fa, i)
    let r = NativeArray.get_float(p.pl_fper, i)
    let kind = NativeArray.get_int(p.pl_lkind, s)
    let x0 = g.pg_x0
    let z0 = g.pg_z0
    let n = g.pg_n
    let voxel = g.pg_voxel
    -- the chance a level-0 column holds the cover: its area is scale^2 at every level (cover is placed at level 0 only)
    if kind == 0 do chance_into(vals, i * nn, d, s * nn, g.pg_scale *. g.pg_scale, 0, nn)
    else if kind == 1 do
      let xs = layer_cands(p, seed, g, d, s * nn, dmax_col(d, s * nn, 0, nn, 0.0), s, int_to_float(x0) *. voxel, int_to_float(z0) *. voxel, int_to_float(x0 + n) *. voxel, int_to_float(z0 + n) *. voxel)
      let cell = NativeArray.get_float(p.pl_lcell, s)
      let counts = count_all(NativeArray.make_int(nn, 0), xs, r, x0, z0, n, voxel)
      ratio_into(vals, i * nn, counts, Math.pi() *. r *. r /. (cell *. cell), 0, nn)
    else
      -- the layer's sites whose radius plus r reaches a column centre of g, each with that reach
      let s0 = NativeArray.get_int(p.pl_lsat, s)
      let ids = List.filter(List.range(s0, s0 + NativeArray.get_int(p.pl_lsn, s)), fn k ->
        box_reach(NativeArray.get_float(p.pl_sx, k), NativeArray.get_float(p.pl_sz, k), NativeArray.get_float(p.pl_srad, k) +. r, (int_to_float(x0) +. 0.5) *. voxel, (int_to_float(x0 + n - 1) +. 0.5) *. voxel, (int_to_float(z0) +. 0.5) *. voxel, (int_to_float(z0 + n - 1) +. 0.5) *. voxel))
      if List.is_empty(ids) do vals
      else sites_into(vals, i * nn, pick_floats(p.pl_sx, ids), pick_floats(p.pl_sz, ids), floats(List.map(ids, fn k -> NativeArray.get_float(p.pl_srad, k) +. r)), List.length(ids), x0, z0, n, voxel, 0, nn) end
    end end
  end

  -- the steps from k: fields, zones and densities into the three arrays
  pfn steps_go(p : PopPlan, seed : Int, g : Ground, nn : Int, vals : NativeF32Arr, zs : NativeU8Arr, d : NativeF32Arr, k : Int) : (NativeF32Arr, NativeU8Arr, NativeF32Arr) do
    if k >= p.pl_nsteps do (vals, zs, d)
    else
      let st = NativeArray.get_int(p.pl_steps, k)
      let i = st / 3
      let what = st % 3
      if what == 0 do
        let v2 = if NativeArray.get_int(p.pl_fkind, i) == 3 do eval_cover(p, seed, g, nn, vals, d, i) else eval_field(p, seed, g, nn, vals, i) end
        steps_go(p, seed, g, nn, v2, zs, d, k + 1)
      else if what == 1 do steps_go(p, seed, g, nn, vals, eval_zone(p, g, nn, vals, zs, i), d, k + 1)
      else steps_go(p, seed, g, nn, vals, zs, layer_into(d, p.pl_prog, p.pl_num, vals, zs, nn, i), k + 1) end end
    end
  end

  doc "Every field, zone and layer density of a plan over g's columns, once, into a Table the calling task owns. Ground fields are copied from g (0 where the slot was not supplied). A noise field is Strata.Noise.field2 on world-aligned tiles of 32 x 32 columns, sampled at column centres, seeded by Strata.Seed.mix(seed, salt), at 1 / period cycles per metre, fBm with lacunarity 2 and gain 0.5, read as 0.5 + 0.5 * noise; two Grounds read the same bits at a shared column. A curve field maps its source. A cover field of a scatter layer counts that layer's instances (those instances lists over g) whose base lies within its radius of the column's centre, over pi * radius^2 / cell^2, at most 1; of a cover layer it is that layer's density times the area of a level-0 column (scale^2, at every level, since cover is placed at level 0 only), at most 1; of a site layer it is 1 where some site's centre lies within the site's radius plus the cover radius of the column's centre, else 0. Only instances standing on g count, so a column's cover is whole where g holds every column within the radius of it (pad sees to that for a chunk). A layer's density is its base times each curve of its field, 0 where a zone fails, clamped at 0. Each is evaluated after what it reads: a layer's density before a cover field of it, densities in run order. A Ground with problems gives a Table of zeros."
  fn fields_with(p : PopPlan, seed : Int, g : Ground) : Table do
    let ok = List.is_empty(problems(g))
    let nn = if ok do g.pg_n * g.pg_n else 0 end
    let vals0 = NativeArray.make_f32(Math.max_int(1, p.pl_nf * nn), 0.0)
    let zs0 = NativeArray.make_u8(Math.max_int(1, p.pl_nz * nn), 0)
    let d0 = NativeArray.make_f32(Math.max_int(1, p.pl_nl * nn), 0.0)
    if ok do
      match steps_go(p, seed, g, nn, vals0, zs0, d0, 0) do
        (vals, zs, d) -> { pt_nn: nn, pt_names: p.pl_names, pt_nl: p.pl_nl, pt_nz: p.pl_nz, pt_vals: vals, pt_zones: zs, pt_dens: d, pt_dmax: dmax_go(NativeArray.make_f32(p.pl_nl + 1, 0.0), d, nn, 0, p.pl_nl) }
      end
    else { pt_nn: 0, pt_names: p.pl_names, pt_nl: p.pl_nl, pt_nz: p.pl_nz, pt_vals: vals0, pt_zones: zs0, pt_dens: d0, pt_dmax: NativeArray.make_f32(p.pl_nl + 1, 0.0) } end
  end

  doc "fields_with(plan(f), seed, g): for tests and tools; a caller evaluating many Grounds keeps one plan."
  fn fields(f : Strata.Population.Frozen, seed : Int, g : Ground) : Table do fields_with(plan(f), seed, g) end

  -- ── Reading a Table ───────────────────────────────────────────────────────

  pfn in_range(i : Int, n : Int) : Bool do if i < 0 do false else i < n end end
  pfn cell_ok(t : Table, i : Int, n : Int, col : Int) : Bool do if in_range(i, n) do in_range(col, t.pt_nn) else false end end

  doc "Whether column col is inside zone zone_index (an index of Strata.Population.zone_index); false for an index or column out of range. An array read."
  fn in_zone(t : Table, zone_index : Int, col : Int) : Bool do
    if cell_ok(t, zone_index, t.pt_nz, col) do NativeArray.get_u8(t.pt_zones, zone_index * t.pt_nn + col) == 1 else false end
  end

  doc "Layer layer_index's (run order) density per square metre at column col, as fields_with worked it out; 0 for an index or column out of range. An array read."
  fn density(t : Table, layer_index : Int, col : Int) : Float do
    if cell_ok(t, layer_index, t.pt_nl, col) do NativeArray.get_f32(t.pt_dens, layer_index * t.pt_nn + col) else 0.0 end
  end

  pfn name_index(xs : List(String), n : String, i : Int) : Int do
    match xs do
      Nil -> -1
      Cons(x, rest) -> if x == n do i else name_index(rest, n, i + 1) end
    end
  end

  doc "The field named name at column col; 0 for an undeclared field or a column out of range. For tests and tools: it looks the name up."
  fn field_at(t : Table, name : String, col : Int) : Float do
    let i = name_index(t.pt_names, name, 0)
    if cell_ok(t, i, List.length(t.pt_names), col) do NativeArray.get_f32(t.pt_vals, i * t.pt_nn + col) else 0.0 end
  end

  doc "Whether column col is inside the zone named name; false for an undeclared zone. For tests and tools: per column, use in_zone."
  fn zone_at(f : Strata.Population.Frozen, t : Table, name : String, col : Int) : Bool do in_zone(t, Pn.zone_index(f, name), col) end

  doc "The layer named layer's density at column col; 0 for an undeclared layer. For tests and tools: per column, use density."
  fn density_at(f : Strata.Population.Frozen, t : Table, layer : String, col : Int) : Float do density(t, Pn.layer_index(f, layer), col) end

  -- ── Ground adaptation ─────────────────────────────────────────────────────
  --
  -- adapt draws a game's column heights (metres) to every site layer's
  -- sites, before the game builds its density. A column is read at its
  -- centre, ((x0 + i + 0.5) * scale, (z0 + j + 0.5) * scale). Against a site
  -- of radius R and floor F, in a layer of margin M, at distance d:
  --   d <= R          inside: the height is a floor. Where several radii
  --                   hold the column, the nearest site's floor (by centre;
  --                   on a tie, the first in run order, then declaration
  --                   order).
  --   R < d < R + M   in the margin: t = (d - R) / M runs 0..1 across it and
  --                   the site pulls with r = (1 - t) / t. Every site whose
  --                   margin holds the column contributes, and the height is
  --                   (H + sum r F) / (1 + sum r), H the height given. With
  --                   one site that is F + (H - F) t: linear, the mean
  --                   halfway, H at the outer edge; with several it is
  --                   continuous, and tends to a site's floor at its radius.
  --   beyond          untouched.
  -- Each column is a function of its own centre and the sites, summed in the
  -- plan's order, so an area gives the bits a larger area gives at the same
  -- columns. Sites that reach no column of the area are left out first; they
  -- would add nothing.

  -- the box xa..xb, za..zb is within reach metres of (xm, zm) along each axis (NaN reaches nothing)
  pfn box_reach(xm : Float, zm : Float, reach : Float, xa : Float, xb : Float, za : Float, zb : Float) : Bool do
    if xm +. reach >= xa do (if xm -. reach <= xb do (if zm +. reach >= za do zm -. reach <= zb else false end) else false end) else false end
  end
  -- the plan's sites whose radius and margin can reach a column centre of the n x n area at (x0, z0), in plan order
  pfn sites_near(p : PopPlan, x0 : Int, z0 : Int, n : Int, s : Float) : List(Int) do
    let xa = (int_to_float(x0) +. 0.5) *. s
    let xb = (int_to_float(x0 + n - 1) +. 0.5) *. s
    let za = (int_to_float(z0) +. 0.5) *. s
    let zb = (int_to_float(z0 + n - 1) +. 0.5) *. s
    let sx = p.pl_sx
    let sz = p.pl_sz
    let rad = p.pl_srad
    let mar = p.pl_smar
    List.filter(List.range(0, p.pl_ns), fn i -> box_reach(NativeArray.get_float(sx, i), NativeArray.get_float(sz, i), NativeArray.get_float(rad, i) +. NativeArray.get_float(mar, i), xa, xb, za, zb))
  end

  pfn dist(xs : NativeFloatArr, zs : NativeFloatArr, i : Int, xm : Float, zm : Float) : Float do
    let dx = xm -. NativeArray.get_float(xs, i)
    let dz = zm -. NativeArray.get_float(zs, i)
    Math.sqrt(dx *. dx +. dz *. dz)
  end
  -- the nearest of sites i.. whose radius holds (xm, zm), or best (-1 for none); bd its distance
  pfn nearest_in(xs : NativeFloatArr, zs : NativeFloatArr, rs : NativeFloatArr, i : Int, cnt : Int, xm : Float, zm : Float, best : Int, bd : Float) : Int do
    if i >= cnt do best
    else
      let d = dist(xs, zs, i, xm, zm)
      if d <= NativeArray.get_float(rs, i) do
        if best < 0 do nearest_in(xs, zs, rs, i + 1, cnt, xm, zm, i, d)
        else if d < bd do nearest_in(xs, zs, rs, i + 1, cnt, xm, zm, i, d)
        else nearest_in(xs, zs, rs, i + 1, cnt, xm, zm, best, bd) end end
      else nearest_in(xs, zs, rs, i + 1, cnt, xm, zm, best, bd) end
    end
  end
  -- over sites i.. whose margin holds (xm, zm): the sum of r (with_floor false) or of r * F (true), r = (1 - t) / t, t at least 10^-9
  pfn pull_go(xs : NativeFloatArr, zs : NativeFloatArr, rs : NativeFloatArr, ms : NativeFloatArr, fs : NativeFloatArr, with_floor : Bool, i : Int, cnt : Int, xm : Float, zm : Float, acc : Float) : Float do
    if i >= cnt do acc
    else
      let d = dist(xs, zs, i, xm, zm)
      let r = NativeArray.get_float(rs, i)
      let m = NativeArray.get_float(ms, i)
      let held = if d > r do d < r +. m else false end
      if held do
        let t0 = (d -. r) /. m
        let t = if t0 > 0.000000001 do t0 else 0.000000001 end
        let w = (1.0 -. t) /. t
        pull_go(xs, zs, rs, ms, fs, with_floor, i + 1, cnt, xm, zm, acc +. (if with_floor do w *. NativeArray.get_float(fs, i) else w end))
      else pull_go(xs, zs, rs, ms, fs, with_floor, i + 1, cnt, xm, zm, acc) end
    end
  end
  -- out (the heights handed in until the first write, then a copy, GAPS S30) adapted from column c on
  pfn adapt_go(out : NativeF32Arr, hs : NativeF32Arr, xs : NativeFloatArr, zs : NativeFloatArr, rs : NativeFloatArr, ms : NativeFloatArr, fs : NativeFloatArr, cnt : Int, x0 : Int, z0 : Int, n : Int, s : Float, c : Int, nn : Int) : NativeF32Arr do
    if c >= nn do out
    else
      let xm = (int_to_float(x0 + c % n) +. 0.5) *. s
      let zm = (int_to_float(z0 + c / n) +. 0.5) *. s
      let b = nearest_in(xs, zs, rs, 0, cnt, xm, zm, -1, 0.0)
      if b >= 0 do adapt_go(NativeArray.set_f32(out, c, NativeArray.get_float(fs, b)), hs, xs, zs, rs, ms, fs, cnt, x0, z0, n, s, c + 1, nn)
      else
        let den = pull_go(xs, zs, rs, ms, fs, false, 0, cnt, xm, zm, 0.0)
        if den > 0.0 do
          let num = pull_go(xs, zs, rs, ms, fs, true, 0, cnt, xm, zm, 0.0)
          adapt_go(NativeArray.set_f32(out, c, (NativeArray.get_f32(hs, c) +. num) /. (1.0 +. den)), hs, xs, zs, rs, ms, fs, cnt, x0, z0, n, s, c + 1, nn)
        else adapt_go(out, hs, xs, zs, rs, ms, fs, cnt, x0, z0, n, s, c + 1, nn) end
      end
    end
  end
  -- some site i.. holds (xm, zm) in its radius or its margin
  pfn held_by(xs : NativeFloatArr, zs : NativeFloatArr, rs : NativeFloatArr, ms : NativeFloatArr, i : Int, cnt : Int, xm : Float, zm : Float) : Bool do
    if i >= cnt do false
    else
      let d = dist(xs, zs, i, xm, zm)
      let r = NativeArray.get_float(rs, i)
      if d <= r do true
      else if d < r +. NativeArray.get_float(ms, i) do true
      else held_by(xs, zs, rs, ms, i + 1, cnt, xm, zm) end end
    end
  end
  pfn marks_go(out : NativeU8Arr, xs : NativeFloatArr, zs : NativeFloatArr, rs : NativeFloatArr, ms : NativeFloatArr, cnt : Int, x0 : Int, z0 : Int, n : Int, s : Float, c : Int, nn : Int) : NativeU8Arr do
    if c >= nn do out
    else
      let xm = (int_to_float(x0 + c % n) +. 0.5) *. s
      let zm = (int_to_float(z0 + c / n) +. 0.5) *. s
      if held_by(xs, zs, rs, ms, 0, cnt, xm, zm) do marks_go(NativeArray.set_u8(out, c, 1), xs, zs, rs, ms, cnt, x0, z0, n, s, c + 1, nn)
      else marks_go(out, xs, zs, rs, ms, cnt, x0, z0, n, s, c + 1, nn) end
    end
  end

  -- n above 0 and at most 2^20 (so n * n stays far below 2^62), a scale above 0 (not NaN)
  pfn area_ok(n : Int, scale : Float) : Bool do if n > 0 do (if n <= 1048576 do scale > 0.0 else false end) else false end end
  -- a corner within -2^40..2^40 on both axes, so x0 + n and z0 + n stay far from either end of Int
  pfn within40(v : Int) : Bool do if v <= 1099511627776 do v >= 0 - 1099511627776 else false end end
  pfn corner_ok(x0 : Int, z0 : Int) : Bool do if within40(x0) do within40(z0) else false end end
  pfn pick_floats(a : NativeFloatArr, ids : List(Int)) : NativeFloatArr do floats(List.map(ids, fn i -> NativeArray.get_float(a, i))) end

  doc "Column heights in metres for the n x n area of columns whose corner is column (x0, z0) at `scale` metres a column (for a coarser level, pass that level's column size), heights[i + n * j], drawn to every site layer's sites: inside a site's radius the height is its floor (the nearest site's where radii overlap); across the layer's margin beyond it the height blends back to the one given, linearly for one site, and where several margins meet every site in reach pulls: (H + sum r F) / (1 + sum r) with r = (1 - t) / t, t running 0..1 across each margin; beyond, untouched. A column is read at its centre, and an area gives exactly the values a larger area gives at the same columns. Floors are read as 32-bit floats, as place reads them. The heights handed in are never changed; they come back as they are when nothing reaches the area, when n is not in 1..2^20, scale is not above 0, x0 or z0 is outside -2^40..2^40, or heights is not n * n long. A game re-deriving tops as floor(h / scale) puts a site's floor column's top one voxel under the site's template."
  fn adapt_with(p : PopPlan, x0 : Int, z0 : Int, n : Int, scale : Float, heights : NativeF32Arr) : NativeF32Arr do
    if (if area_ok(n, scale) do corner_ok(x0, z0) else false end) do
      if NativeArray.length_f32(heights) == n * n do
        let ids = sites_near(p, x0, z0, n, scale)
        if List.is_empty(ids) do heights
        else
          let fs = floats(List.map(ids, fn i -> NativeArray.get_f32(p.pl_sfl, i)))
          adapt_go(heights, heights, pick_floats(p.pl_sx, ids), pick_floats(p.pl_sz, ids), pick_floats(p.pl_srad, ids), pick_floats(p.pl_smar, ids), fs, List.length(ids), x0, z0, n, scale, 0, n * n)
        end
      else heights end
    else heights end
  end

  doc "adapt_with(plan(f), x0, z0, n, scale, heights): for tests and tools; a game keeps one plan."
  fn adapt(f : Strata.Population.Frozen, x0 : Int, z0 : Int, n : Int, scale : Float, heights : NativeF32Arr) : NativeF32Arr do adapt_with(plan(f), x0, z0, n, scale, heights) end

  doc "1 for every column of the n x n area at (x0, z0) at `scale` metres a column that some site layer's site holds in its radius or its margin, else 0: the columns adapt holds at a floor or may change (a margin column whose height is already what the blend gives is marked though adapt leaves it). A function of position alone, the same from any area. A game keeps its own rules (caves, detail) off the marked columns. All 0 for a scale not above 0 or a corner x0 or z0 outside -2^40..2^40; empty for n not in 1..2^20."
  fn adapted_with(p : PopPlan, x0 : Int, z0 : Int, n : Int, scale : Float) : NativeU8Arr do
    if area_ok(n, scale) do
      let out = NativeArray.make_u8(n * n, 0)
      let ids = if corner_ok(x0, z0) do sites_near(p, x0, z0, n, scale) else Nil end
      if List.is_empty(ids) do out
      else marks_go(out, pick_floats(p.pl_sx, ids), pick_floats(p.pl_sz, ids), pick_floats(p.pl_srad, ids), pick_floats(p.pl_smar, ids), List.length(ids), x0, z0, n, scale, 0, n * n) end
    else NativeArray.make_u8(if n > 0 do (if n <= 1048576 do n * n else 0 end) else 0 end, 0) end
  end

  doc "adapted_with(plan(f), x0, z0, n, scale): for tests and tools."
  fn adapted(f : Strata.Population.Frozen, x0 : Int, z0 : Int, n : Int, scale : Float) : NativeU8Arr do adapted_with(plan(f), x0, z0, n, scale) end

  -- ── Placers ───────────────────────────────────────────────────────────────
  --
  -- place_with runs the layers in run order over one chunk, each placer
  -- writing through Strata.Chunk.set_idx. A cover layer visits every
  -- floor of every column of the chunk: where the voxel above lies in the
  -- chunk and is air (id 0), it rolls the hash of the floor's world voxel
  -- against the column's density times the column's area, and on success
  -- writes a variant's block there. A block written is no longer air, so a
  -- later cover layer never overwrites it. A scatter layer (below the cover
  -- placer) stamps its instances in cell order, each cut to the chunk; a
  -- stamp writes its voxels over whatever is there. A site layer (after the
  -- scatter placer) stamps one instance at each of its sites the same way.

  -- One cover layer over one chunk, everything its loop reads unpacked from
  -- the plan, the Table and the Ground once per layer (GAPS S15). The chunk's
  -- column (cx, cz) is the Ground's column (cr_ci + cx) + cr_n * (cr_cj + cz)
  -- and world column (cr_wx0 + cx, cr_wz0 + cz); a floor at world height y
  -- writes local height y - cr_ylo when that is in 0..31.
  type CoverRun = { cr_seed : Int, cr_salt : Int, cr_area : Float, cr_dens : NativeF32Arr, cr_dmax : NativeF32Arr, cr_doff : Int, cr_zs : NativeU8Arr, cr_nn : Int, cr_ids : NativeIntArr, cr_vat : Int, cr_vn : Int, cr_wzone : NativeIntArr, cr_wbase : NativeIntArr, cr_wcum : NativeFloatArr, cr_wat : Int, cr_wend : Int, cr_n : Int, cr_ci : Int, cr_cj : Int, cr_wx0 : Int, cr_wz0 : Int, cr_ylo : Int, cr_surf : Bool, cr_tops : NativeIntArr, cr_sat : NativeIntArr, cr_sys : NativeIntArr, cr_skind : NativeIntArr }

  -- the first weights entry in e..e_end whose zone holds column col, or -1
  pfn weighted_entry(wzone : NativeIntArr, zs : NativeU8Arr, nn : Int, col : Int, e : Int, e_end : Int) : Int do
    if e >= e_end do -1
    else if NativeArray.get_u8(zs, NativeArray.get_int(wzone, e) * nn + col) == 1 do e
    else weighted_entry(wzone, zs, nn, col, e + 1, e_end) end end
  end
  -- the first variant k whose cumulative weight is above u (the last when none is)
  pfn cum_pick(cum : NativeFloatArr, base : Int, k : Int, nv : Int, u : Float) : Int do
    if k + 1 >= nv do k
    else if u < NativeArray.get_float(cum, base + k) do k
    else cum_pick(cum, base, k + 1, nv, u) end end
  end

  -- the block a floor at world voxel (wx, y, wz) of column col gets, or 0:
  -- the roll against ph, then the variant from the next value of the same hash
  pfn cover_roll(r : CoverRun, col : Int, ph : Float, wx : Int, y : Int, wz : Int) : Int do
    let h = Strata.Seed.cell(r.cr_seed, r.cr_salt, wx, y, wz)
    if Strata.Seed.unit(h) < ph do
      let u = Strata.Seed.unit(Strata.Seed.next(h))
      let nv = r.cr_vn
      let e = weighted_entry(r.cr_wzone, r.cr_zs, r.cr_nn, col, r.cr_wat, r.cr_wend)
      let k = if e >= 0 do cum_pick(r.cr_wcum, NativeArray.get_int(r.cr_wbase, e), 0, nv, u) else Math.min_int(nv - 1, float_to_int(u *. int_to_float(nv))) end
      -- freeze refuses ids outside 1..65535, so every id claims its voxel
      NativeArray.get_int(r.cr_ids, r.cr_vat + k)
    else 0 end
  end

  -- One pass over (column, surface) pairs: surface s of s_end of chunk column
  -- i (Ground column col, chance ph); past the last surface, the next column.
  -- Returns the chunk and how many voxels were written.
  pfn cover_go(r : CoverRun, c : Strata.Chunk.Chunk, wrote : Int, i : Int, col : Int, ph : Float, s : Int, s_end : Int) : (Strata.Chunk.Chunk, Int) do
    if s >= s_end do
      let i2 = i + 1
      if i2 >= 1024 do (c, wrote)
      else
        let col2 = (r.cr_ci + i2 % 32) + r.cr_n * (r.cr_cj + i2 / 32)
        let ph2 = NativeArray.get_f32(r.cr_dens, r.cr_doff + col2) *. r.cr_area
        if ph2 > 0.0 do
          if r.cr_surf do cover_go(r, c, wrote, i2, col2, ph2, NativeArray.get_int(r.cr_sat, col2), NativeArray.get_int(r.cr_sat, col2 + 1))
          else cover_go(r, c, wrote, i2, col2, ph2, 0, 1) end
        else cover_go(r, c, wrote, i2, col2, ph2, 0, 0) end
      end
    else
      let is_floor = if r.cr_surf do NativeArray.get_int(r.cr_skind, s) == 0 else true end
      let y = if r.cr_surf do NativeArray.get_int(r.cr_sys, s) else NativeArray.get_int(r.cr_tops, col) end
      -- y - cr_ylo is the voxel above in local height; compared before subtracting, so no y overflows
      let inside = if is_floor do (if y >= r.cr_ylo do y <= r.cr_ylo + 31 else false end) else false end
      if inside do
        let cx = i % 32
        let cz = i / 32
        let idx = Strata.Chunk.index(cx + 32 * (cz + 32 * (y - r.cr_ylo)))
        if Strata.Chunk.get_idx(c, idx) == 0 do
          let id = cover_roll(r, col, ph, r.cr_wx0 + cx, y, r.cr_wz0 + cz)
          if id > 0 do cover_go(r, Strata.Chunk.set_idx(c, idx, id), wrote + 1, i, col, ph, s + 1, s_end)
          else cover_go(r, c, wrote, i, col, ph, s + 1, s_end) end
        else cover_go(r, c, wrote, i, col, ph, s + 1, s_end) end
      else cover_go(r, c, wrote, i, col, ph, s + 1, s_end) end
    end
  end

  -- layer l of the plan as a cover layer over the chunk r was set up for
  pfn cover_layer(p : PopPlan, base : CoverRun, c : Strata.Chunk.Chunk, l : Int) : (Strata.Chunk.Chunk, Int) do
    let nv = NativeArray.get_int(p.pl_lvn, l)
    -- a layer whose density is 0 at every column of the Ground cannot place: no pass
    if nv <= 0 do (c, 0)
    else if NativeArray.get_f32(base.cr_dmax, l) <= 0.0 do (c, 0)
    else
      let wat = NativeArray.get_int(p.pl_lwat, l)
      let r = { base with cr_salt: NativeArray.get_int(p.pl_lsalt, l), cr_doff: l * base.cr_nn, cr_vat: NativeArray.get_int(p.pl_lvat, l), cr_vn: nv, cr_wat: wat, cr_wend: wat + NativeArray.get_int(p.pl_lwn, l) }
      cover_go(r, c, 0, -1, 0, 0.0, 0, 0)
    end end
  end

  -- ── Scatter ───────────────────────────────────────────────────────────────
  --
  -- A scatter layer is a Strata.Feature kind: the plane cut into cells
  -- `cell` metres on a side, each cell's hash deciding whether it holds an
  -- instance, where in the cell, its quarter turn, its variant and the
  -- stream its template's probabilities are drawn from. A cell holds one
  -- with probability density * cell * cell (at most 1), the density read
  -- from the Table at the column the candidate stands on. Nothing of this
  -- depends on the chunk or on the Ground's window: an instance is a
  -- function of the seed, the layer and its cell.
  --
  -- An instance stands on the column holding its place, one voxel above
  -- that column's top. Its template, turned, w columns along x and d along
  -- z, starts w / 2 and d / 2 columns (rounded down) before that column, so
  -- it covers at most w / 2 columns either side: no more than
  -- Strata.Population.reach / voxel, which is what pad adds one to. A chunk
  -- therefore finds every instance that can touch it among the cells within
  -- reach of its 32 x 32 columns, on a Ground holding pad more columns a
  -- side, and each chunk an instance spans stamps its own part of it.

  -- layer (run order), where it stands (x, z in metres), its column's top, variant, quarter turn, stream
  type PopInstance = PopInstance(Int, Float, Float, Int, Int, Int, Int)

  doc "The instance's layer, an index in run order."
  fn i_layer(i : PopInstance) : Int do match i do PopInstance(v, _, _, _, _, _, _) -> v end end
  doc "Where the instance stands along x, in metres."
  fn i_xm(i : PopInstance) : Float do match i do PopInstance(_, v, _, _, _, _, _) -> v end end
  doc "Where the instance stands along z, in metres."
  fn i_zm(i : PopInstance) : Float do match i do PopInstance(_, _, v, _, _, _, _) -> v end end
  doc "The ground top (world voxel height) of the column the instance stands on; its base is one above."
  fn i_top(i : PopInstance) : Int do match i do PopInstance(_, _, _, v, _, _, _) -> v end end
  doc "Which variant of its layer's shape set the instance is."
  fn i_variant(i : PopInstance) : Int do match i do PopInstance(_, _, _, _, v, _, _) -> v end end
  doc "The instance's quarter turn about Y, 0..3."
  fn i_rot(i : PopInstance) : Int do match i do PopInstance(_, _, _, _, _, v, _) -> v end end
  doc "The stream the instance's template probabilities are drawn from."
  fn i_stream(i : PopInstance) : Int do match i do PopInstance(_, _, _, _, _, _, v) -> v end end

  -- 2^40: no Ground is that wide (n * n would pass 2^62), so a pad capped there is refused, never wrapped
  pfn pad_cap() : Int do 1099511627776 end
  -- columns for a distance in metres: ceil(m / scale), at most 2^40; 0 for a scale not above 0
  pfn cols_of(m : Float, scale : Float) : Int do
    if scale > 0.0 do
      let v = Math.ceil(m /. scale)
      -- compared before it is an Int: a huge quotient is capped, a NaN reads 0
      if v < int_to_float(pad_cap()) do (if v > 0.0 do float_to_int(v) else 0 end) else pad_cap() end
    else 0 end
  end
  -- columns for a reach in metres: ceil(reach / scale) + 1; 0 for a scale not above 0
  pfn pad_of(reach : Float, scale : Float) : Int do
    if scale > 0.0 do cols_of(reach, scale) + 1 else 0 end
  end

  -- How far past a chunk each layer's density must be whole, in columns:
  -- need[l] is 0 for a cover layer (its own columns), the scatter pad for a
  -- scatter layer (its instances' columns), -1 for a site layer (it reads
  -- no column). Walking layers from the last in run order, a layer that
  -- needs e reads each cover field of it at e: a scatter source must then be
  -- whole ceil(radius / scale) further, a cover source at e, a site source
  -- reads nothing. The sources run earlier, so they are reached after
  -- their readers and pass their own need on.
  pfn need_reads(p : PopPlan, scale : Float, need : NativeIntArr, e : Int, k : Int, k1 : Int) : NativeIntArr do
    if k >= k1 do need
    else
      let fi = NativeArray.get_int(p.pl_crf, k)
      let s = NativeArray.get_int(p.pl_fa, fi)
      let kind = NativeArray.get_int(p.pl_lkind, s)
      let want = if kind == 1 do Math.min_int(pad_cap(), e + cols_of(NativeArray.get_float(p.pl_fper, fi), scale)) else e end
      let need2 = if kind == 2 do need else NativeArray.set_int(need, s, Math.max_int(NativeArray.get_int(need, s), want)) end
      need_reads(p, scale, need2, e, k + 1, k1)
    end
  end
  pfn needs_go(p : PopPlan, scale : Float, need : NativeIntArr, l : Int) : NativeIntArr do
    if l < 0 do need
    else
      let e = NativeArray.get_int(need, l)
      let at = NativeArray.get_int(p.pl_crat, l)
      let need2 = if e >= 0 do need_reads(p, scale, need, e, at, at + NativeArray.get_int(p.pl_crn, l)) else need end
      needs_go(p, scale, need2, l - 1)
    end
  end
  pfn need_init(p : PopPlan, sp : Int, need : NativeIntArr, l : Int) : NativeIntArr do
    if l >= p.pl_nl do need
    else
      let kind = NativeArray.get_int(p.pl_lkind, l)
      need_init(p, sp, NativeArray.set_int(need, l, if kind == 0 do 0 else if kind == 1 do sp else -1 end end), l + 1)
    end
  end
  pfn max_of(a : NativeIntArr, i : Int, n : Int, m : Int) : Int do if i >= n do m else max_of(a, i + 1, n, Math.max_int(m, NativeArray.get_int(a, i))) end end

  doc "pad for a plan: the same number, without the Frozen."
  fn plan_pad(p : PopPlan, scale : Float) : Int do
    let sp = pad_of(p.pl_reach, scale)
    let need = needs_go(p, scale, need_init(p, sp, NativeArray.make_int(p.pl_nl + 1, -1), 0), p.pl_nl - 1)
    Math.max_int(sp, max_of(need, 0, p.pl_nl, 0))
  end

  doc "How many columns of Ground a chunk needs beyond its own 32 on each side, in a world of `scale` metres a voxel, so that every scatter instance that can reach the chunk is judged and every cover field a placed layer reads there is whole: at least ceil(Strata.Population.reach(f) / scale) + 1 (the scatter pad); a layer reading a scatter layer's cover field of radius r needs that layer's density ceil(r / scale) further than it needs its own, so a scatter layer reading it adds r to the scatter pad and a cover layer needs r, and chains add up; a cover field of a cover layer adds no columns of its own (its radius is not read), but that cover layer then needs its density whole as far as its reader does, so whatever cover fields it reads in turn add their radii from there; a site layer's cover field adds nothing and reads no column. At most 2^40. place_with refuses a Ground with fewer when the plan has a scatter layer."
  fn pad(f : Strata.Population.Frozen, scale : Float) : Int do plan_pad(plan(f), scale) end

  -- the column holding a metre coordinate
  pfn col_of(m : Float, voxel : Float) : Int do float_to_int(Math.floor(m /. voxel)) end

  -- the chance a cell of `area` square metres holds an instance standing at (xm, zm): the layer's density at that column times the area, at most 1; 0 off the Ground
  pfn cell_chance(dens : NativeF32Arr, doff : Int, n : Int, x0 : Int, z0 : Int, voxel : Float, area : Float, xm : Float, zm : Float) : Float do
    let i = col_of(xm, voxel) - x0
    let j = col_of(zm, voxel) - z0
    if in_range(i, n) do
      if in_range(j, n) do
        let v = NativeArray.get_f32(dens, doff + i + n * j) *. area
        if v > 1.0 do 1.0 else v end
      else 0.0 end
    else 0.0 end
  end

  -- a candidate of layer l as an instance on the Ground's column it stands on: the top there, and the variant by the first weighted zone the column is in (as the cover placer picks), else uniformly
  pfn instance_of(p : PopPlan, g : Ground, t : Table, l : Int, c : Strata.Feature.Placed) : Option(PopInstance) do
    let n = g.pg_n
    let xm = Strata.Feature.p_xm(c)
    let zm = Strata.Feature.p_zm(c)
    let i = col_of(xm, g.pg_voxel) - g.pg_x0
    let j = col_of(zm, g.pg_voxel) - g.pg_z0
    if in_range(i, n) do
      if in_range(j, n) do
        let col = i + n * j
        let nv = NativeArray.get_int(p.pl_lnv, l)
        let wat = NativeArray.get_int(p.pl_lwat, l)
        let u = Strata.Seed.unit(Strata.Feature.p_index(c))
        let e = weighted_entry(p.pl_wzone, t.pt_zones, t.pt_nn, col, wat, wat + NativeArray.get_int(p.pl_lwn, l))
        let v = if e >= 0 do cum_pick(p.pl_wcum, NativeArray.get_int(p.pl_wbase, e), 0, nv, u) else Math.min_int(nv - 1, float_to_int(u *. int_to_float(nv))) end
        Some(PopInstance(l, xm, zm, NativeArray.get_int(g.pg_tops, col), v, Strata.Feature.p_rot(c), Strata.Feature.p_stream(c)))
      else None end
    else None end
  end

  -- scatter layer l's candidates, its density at dens[doff ..] (largest dmax), among the cells within the layer's reach of the box (metres), cells in rows of z, x increasing within a row; each stands on a column of g (off g the chance is 0)
  pfn layer_cands(p : PopPlan, seed : Int, g : Ground, dens : NativeF32Arr, doff : Int, dmax : Float, l : Int, x0m : Float, z0m : Float, x1m : Float, z1m : Float) : List(Strata.Feature.Placed) do
    -- a layer whose density is 0 at every column of the Ground has none
    if dmax <= 0.0 do Nil
    else
      let cell = NativeArray.get_float(p.pl_lcell, l)
      let kind = Strata.Feature.kind(cell, NativeArray.get_float(p.pl_lreach, l), NativeArray.get_float(p.pl_ljit, l), NativeArray.get_int(p.pl_lsalt, l), 1.0)
      let n = g.pg_n
      let gx0 = g.pg_x0
      let gz0 = g.pg_z0
      let voxel = g.pg_voxel
      let area = cell *. cell
      Strata.Feature.candidates(kind, seed, x0m, z0m, x1m, z1m, fn (xm, zm) -> cell_chance(dens, doff, n, gx0, gz0, voxel, area, xm, zm))
    end
  end
  -- scatter layer l's instances standing on g's columns, among the cells within the layer's reach of the box (metres), cells in rows of z, x increasing within a row
  pfn layer_instances(p : PopPlan, seed : Int, g : Ground, t : Table, l : Int, x0m : Float, z0m : Float, x1m : Float, z1m : Float) : List(PopInstance) do
    List.filter_map(layer_cands(p, seed, g, t.pt_dens, l * t.pt_nn, NativeArray.get_f32(t.pt_dmax, l), l, x0m, z0m, x1m, z1m), fn c -> instance_of(p, g, t, l, c))
  end

  -- a0..a1 meets the 32 voxels from b0
  pfn meets(a0 : Int, a1 : Int, b0 : Int) : Bool do if a0 <= b0 + 31 do a1 >= b0 else false end end
  -- the h1 + 1 voxels standing on a top (top + 1 .. top + 1 + h1) meet the 32
  -- voxels from b0; the top is compared before anything is added to it, so a
  -- top at either end of Int traps nothing (as the cover placer compares)
  pfn stands_in(top : Int, h1 : Int, b0 : Int) : Bool do if top <= b0 + 30 do top >= b0 - 1 - h1 else false end end

  -- The instances xs of one layer stamped into chunk k in order. A template
  -- (variant v of ts) turned rot is w x h x d; it starts w / 2 and d / 2
  -- columns before the instance's column and one voxel above its top, and
  -- Strata.Template.blit writes the part of it inside the chunk. A layer of
  -- blocks (nb of them, at ids[vat ..]) writes its variant's block at that
  -- one voxel. top + 1 is worked out only for an instance stands_in found
  -- in the chunk. Returns the chunk and how many instances met it.
  pfn stamp_go(c : Strata.Chunk.Chunk, k : Strata.Coord.Key, ts : List(Strata.Template.Template), ids : NativeIntArr, vat : Int, nb : Int, voxel : Float, xs : List(PopInstance), wrote : Int) : (Strata.Chunk.Chunk, Int) do
    match xs do
      Nil -> (c, wrote)
      Cons(PopInstance(_, xm, zm, top, v, rot, stream), rest) ->
        let wx = col_of(xm, voxel)
        let wz = col_of(zm, voxel)
        let qx = 32 * Strata.Coord.kx(k)
        let qy = 32 * Strata.Coord.ky(k)
        let qz = 32 * Strata.Coord.kz(k)
        match List.nth_opt(ts, v) do
          Some(tp) ->
            match Strata.Template.bounds(tp, 0, 0, 0, rot) do
              (_, _, _, w1, h1, d1) ->
                let ox = wx - (w1 + 1) / 2
                let oz = wz - (d1 + 1) / 2
                let hit = if stands_in(top, h1, qy) do (if meets(ox, ox + w1, qx) do meets(oz, oz + d1, qz) else false end) else false end
                if hit do stamp_go(Strata.Template.blit(c, k, tp, ox, top + 1, oz, rot, stream), k, ts, ids, vat, nb, voxel, rest, wrote + 1)
                else stamp_go(c, k, ts, ids, vat, nb, voxel, rest, wrote) end
            end
          None ->
            let hit = if v < nb do (if stands_in(top, 0, qy) do (if meets(wx, wx, qx) do meets(wz, wz, qz) else false end) else false end) else false end
            if hit do stamp_go(Strata.Chunk.set_idx(c, Strata.Chunk.index((wx - qx) + 32 * ((wz - qz) + 32 * (top + 1 - qy))), NativeArray.get_int(ids, vat + v)), k, ts, ids, vat, nb, voxel, rest, wrote + 1)
            else stamp_go(c, k, ts, ids, vat, nb, voxel, rest, wrote) end
        end
    end
  end

  -- layer l of the plan as a scatter layer over chunk k: its instances among the cells within reach of the chunk's columns, stamped in order
  pfn scatter_layer(p : PopPlan, seed : Int, k : Strata.Coord.Key, g : Ground, t : Table, c : Strata.Chunk.Chunk, l : Int) : (Strata.Chunk.Chunk, Int) do
    let voxel = g.pg_voxel
    let x0 = 32 * Strata.Coord.kx(k)
    let z0 = 32 * Strata.Coord.kz(k)
    let xs = layer_instances(p, seed, g, t, l, int_to_float(x0) *. voxel, int_to_float(z0) *. voxel, int_to_float(x0 + 32) *. voxel, int_to_float(z0 + 32) *. voxel)
    let ts = match List.nth_opt(p.pl_ltemps, l) do
      Some(v) -> v
      None -> Nil
    end
    stamp_go(c, k, ts, p.pl_lids, NativeArray.get_int(p.pl_lvat, l), NativeArray.get_int(p.pl_lvn, l), voxel, xs, 0)
  end

  -- ── Sites ─────────────────────────────────────────────────────────────────
  --
  -- A site layer stamps one instance at each of its sites, in declaration
  -- order: variant index mod variants (never negative), turned
  -- h mod 4 for h = Strata.Seed.cell(seed, salt, index, 0, 0), its
  -- probabilities drawn from Strata.Seed.next(h). It stands on the column
  -- holding the site's centre, its template's base centred there as a
  -- scatter instance's is (w / 2 and d / 2 columns before it), its lowest row
  -- on the voxel above the floor: floor(F / voxel) + 1, F read as a 32-bit
  -- float. A block variant is that one voxel. Nothing reads the Ground. The
  -- site's position and floor are compared as floats with the chunk's
  -- bounds before any is turned into an Int, so a huge, infinite or NaN
  -- floor or centre traps nothing and places nothing.

  -- i mod n, 0..n - 1 (n above 0)
  pfn euclid_mod(i : Int, n : Int) : Int do
    let r = i % n
    if r < 0 do r + n else r end
  end
  -- f (voxels) lies within e of the 32 columns from q
  pfn near_span(f : Float, q : Int, e : Float) : Bool do if f >= int_to_float(q) -. e do f < int_to_float(q + 32) +. e else false end end

  -- Sites s .. s1 - 1 of one layer stamped into chunk k, in order. ts its
  -- templates (Nil for blocks: nb ids at ids[vat ..]), nv its variants, ext
  -- its largest template side in voxels. Returns the chunk and how many
  -- sites met it.
  pfn site_go(c : Strata.Chunk.Chunk, k : Strata.Coord.Key, ts : List(Strata.Template.Template), ids : NativeIntArr, vat : Int, nb : Int, nv : Int, ext : Int, seed : Int, salt : Int, voxel : Float, sx : NativeFloatArr, sz : NativeFloatArr, sfl : NativeF32Arr, sidx : NativeIntArr, s : Int, s1 : Int, wrote : Int) : (Strata.Chunk.Chunk, Int) do
    if s >= s1 do (c, wrote)
    else
      let qx = 32 * Strata.Coord.kx(k)
      let qy = 32 * Strata.Coord.ky(k)
      let qz = 32 * Strata.Coord.kz(k)
      let fx = NativeArray.get_float(sx, s) /. voxel
      let fz = NativeArray.get_float(sz, s) /. voxel
      let fy = NativeArray.get_f32(sfl, s) /. voxel
      let e = int_to_float(ext + 1)
      -- within the layer's largest template of the chunk; the upper bound in y is exact (the lowest row floor(fy) + 1 <= qy + 31)
      let close = if near_span(fx, qx, e) do (if near_span(fz, qz, e) do (if fy < int_to_float(qy + 31) do fy >= int_to_float(qy) -. e else false end) else false end) else false end
      if close do
        let index = NativeArray.get_int(sidx, s)
        let v = euclid_mod(index, nv)
        let h = Strata.Seed.cell(seed, salt, index, 0, 0)
        let rot = h % 4
        let wx = float_to_int(Math.floor(fx))
        let wz = float_to_int(Math.floor(fz))
        let oy = float_to_int(Math.floor(fy)) + 1
        match List.nth_opt(ts, v) do
          Some(tp) ->
            match Strata.Template.bounds(tp, 0, 0, 0, rot) do
              (_, _, _, w1, h1, d1) ->
                let ox = wx - (w1 + 1) / 2
                let oz = wz - (d1 + 1) / 2
                let hit = if oy + h1 >= qy do (if meets(ox, ox + w1, qx) do meets(oz, oz + d1, qz) else false end) else false end
                if hit do site_go(Strata.Template.blit(c, k, tp, ox, oy, oz, rot, Strata.Seed.next(h)), k, ts, ids, vat, nb, nv, ext, seed, salt, voxel, sx, sz, sfl, sidx, s + 1, s1, wrote + 1)
                else site_go(c, k, ts, ids, vat, nb, nv, ext, seed, salt, voxel, sx, sz, sfl, sidx, s + 1, s1, wrote) end
            end
          None ->
            let hit = if v < nb do (if meets(oy, oy, qy) do (if meets(wx, wx, qx) do meets(wz, wz, qz) else false end) else false end) else false end
            if hit do site_go(Strata.Chunk.set_idx(c, Strata.Chunk.index((wx - qx) + 32 * ((wz - qz) + 32 * (oy - qy))), NativeArray.get_int(ids, vat + v)), k, ts, ids, vat, nb, nv, ext, seed, salt, voxel, sx, sz, sfl, sidx, s + 1, s1, wrote + 1)
            else site_go(c, k, ts, ids, vat, nb, nv, ext, seed, salt, voxel, sx, sz, sfl, sidx, s + 1, s1, wrote) end
        end
      else site_go(c, k, ts, ids, vat, nb, nv, ext, seed, salt, voxel, sx, sz, sfl, sidx, s + 1, s1, wrote) end
    end
  end

  -- layer l of the plan as a site layer over chunk k
  pfn site_layer(p : PopPlan, seed : Int, k : Strata.Coord.Key, voxel : Float, c : Strata.Chunk.Chunk, l : Int) : (Strata.Chunk.Chunk, Int) do
    let nv = NativeArray.get_int(p.pl_lnv, l)
    if nv <= 0 do (c, 0)
    else
      let ts = match List.nth_opt(p.pl_ltemps, l) do
        Some(v) -> v
        None -> Nil
      end
      let s0 = NativeArray.get_int(p.pl_lsat, l)
      site_go(c, k, ts, p.pl_lids, NativeArray.get_int(p.pl_lvat, l), NativeArray.get_int(p.pl_lvn, l), nv, NativeArray.get_int(p.pl_lext, l), seed, NativeArray.get_int(p.pl_lsalt, l), voxel, p.pl_sx, p.pl_sz, p.pl_sfl, p.pl_sidx, s0, s0 + NativeArray.get_int(p.pl_lsn, l), 0)
    end
  end

  -- ── Levels ────────────────────────────────────────────────────────────────
  --
  -- At level L (voxels of scale * 2^L, k = 2^L of level 0's on each axis) a
  -- scatter or site layer seen to L or beyond places the instances level 0
  -- decides: the same cells, hashes, variants, turns and streams, its
  -- density and weights zone read from the Table at the column holding the
  -- place, its top from the Ground handed over. Its template stands at its
  -- fine world position: the fine column floor(xm / scale), w / 2 and d / 2
  -- fine columns before it, its lowest fine row k (top + 1), the bottom of
  -- the coarse voxel above the coarse top (a site: floor(F / scale) + 1, as
  -- at level 0). Strata.Template.coarsen_placed coarsens it, turned and
  -- drawn, on the world's coarse grid, each coarse voxel the highest-ranked
  -- id among what level 0 writes in its cube, and blit writes the part in
  -- the chunk over whatever is there. Cover layers, and layers of blocks,
  -- are placed at level 0 only. Every value is compared before it is
  -- multiplied by k: a top or a key coordinate beyond 2^40 voxels at a
  -- level above 0 places nothing.

  -- the coarsest level layer l is placed at in a world of `scale` metres a voxel
  pfn seen_at(p : PopPlan, l : Int, scale : Float) : Int do
    let s0 = NativeArray.get_int(p.pl_lseen, l)
    if s0 >= 0 do s0 else Pn.default_seen(NativeArray.get_float(p.pl_lwide, l), scale) end
  end
  -- how many layers of `kind` are placed at level lvl or coarser
  pfn seen_count(p : PopPlan, kind : Int, lvl : Int, scale : Float, l : Int, acc : Int) : Int do
    if l >= p.pl_nl do acc
    else if NativeArray.get_int(p.pl_lkind, l) == kind do seen_count(p, kind, lvl, scale, l + 1, if seen_at(p, l, scale) >= lvl do acc + 1 else acc end)
    else seen_count(p, kind, lvl, scale, l + 1, acc) end end
  end

  -- The instances xs of one layer stamped coarsened by k into chunk key at a
  -- level above 0, in order (stamp_go's rules, at the coarse grid). rank is
  -- the layer's shape set's; scale the world's (level 0's voxel). A block
  -- variant places nothing (block layers are never seen above level 0).
  pfn stamp_coarse_go(c : Strata.Chunk.Chunk, key : Strata.Coord.Key, ts : List(Strata.Template.Template), rank : NativeIntArr, scale : Float, k : Int, xs : List(PopInstance), wrote : Int) : (Strata.Chunk.Chunk, Int) do
    match xs do
      Nil -> (c, wrote)
      Cons(PopInstance(_, xm, zm, top, v, rot, stream), rest) ->
        let qx = 32 * Strata.Coord.kx(key)
        let qy = 32 * Strata.Coord.ky(key)
        let qz = 32 * Strata.Coord.kz(key)
        match List.nth_opt(ts, v) do
          Some(tp) ->
            match Strata.Template.bounds(tp, 0, 0, 0, rot) do
              (_, _, _, w1, h1, d1) ->
                -- rows 0..h1 from the bottom of a coarse voxel are coarse rows 0..h1 / k above the top
                let up = if within40(top) do stands_in(top, h1 / k, qy) else false end
                if up do
                  let ox = col_of(xm, scale) - (w1 + 1) / 2
                  let oz = col_of(zm, scale) - (d1 + 1) / 2
                  let hit = if meets(floor_div(ox, k), floor_div(ox + w1, k), qx) do meets(floor_div(oz, k), floor_div(oz + d1, k), qz) else false end
                  if hit do
                    match Strata.Template.coarsen_placed(tp, k, rank, ox, (top + 1) * k, oz, rot, stream) do
                      (ct, cx, cy, cz) -> stamp_coarse_go(Strata.Template.blit(c, key, ct, cx, cy, cz, 0, 0), key, ts, rank, scale, k, rest, wrote + 1)
                    end
                  else stamp_coarse_go(c, key, ts, rank, scale, k, rest, wrote) end
                else stamp_coarse_go(c, key, ts, rank, scale, k, rest, wrote) end
            end
          None -> stamp_coarse_go(c, key, ts, rank, scale, k, rest, wrote)
        end
    end
  end

  -- Sites s .. s1 - 1 of one layer stamped coarsened by k into chunk key at a
  -- level above 0, in order (site_go's rules at the coarse grid). The site's
  -- centre and floor are first compared as floats with the chunk in its own
  -- voxels (within the layer's largest side, ext + 1 fine voxels, which is
  -- looser than needed), so they are bounded before any is an Int; then
  -- exactly, by the coarse box.
  pfn site_coarse_go(c : Strata.Chunk.Chunk, key : Strata.Coord.Key, ts : List(Strata.Template.Template), rank : NativeIntArr, nv : Int, ext : Int, seed : Int, salt : Int, scale : Float, voxel : Float, k : Int, sx : NativeFloatArr, sz : NativeFloatArr, sfl : NativeF32Arr, sidx : NativeIntArr, s : Int, s1 : Int, wrote : Int) : (Strata.Chunk.Chunk, Int) do
    if s >= s1 do (c, wrote)
    else
      let qx = 32 * Strata.Coord.kx(key)
      let qy = 32 * Strata.Coord.ky(key)
      let qz = 32 * Strata.Coord.kz(key)
      let xm = NativeArray.get_float(sx, s)
      let zm = NativeArray.get_float(sz, s)
      let fm = NativeArray.get_f32(sfl, s)
      let e = int_to_float(ext + 1)
      let close = if near_span(xm /. voxel, qx, e) do (if near_span(zm /. voxel, qz, e) do (if fm /. voxel < int_to_float(qy + 32) do fm /. voxel >= int_to_float(qy) -. e else false end) else false end) else false end
      if close do
        let index = NativeArray.get_int(sidx, s)
        let v = euclid_mod(index, nv)
        let h = Strata.Seed.cell(seed, salt, index, 0, 0)
        let rot = h % 4
        match List.nth_opt(ts, v) do
          Some(tp) ->
            match Strata.Template.bounds(tp, 0, 0, 0, rot) do
              (_, _, _, w1, h1, d1) ->
                let ox = col_of(xm, scale) - (w1 + 1) / 2
                let oz = col_of(zm, scale) - (d1 + 1) / 2
                let oy = col_of(fm, scale) + 1
                let hit = if meets(floor_div(oy, k), floor_div(oy + h1, k), qy) do (if meets(floor_div(ox, k), floor_div(ox + w1, k), qx) do meets(floor_div(oz, k), floor_div(oz + d1, k), qz) else false end) else false end
                if hit do
                  match Strata.Template.coarsen_placed(tp, k, rank, ox, oy, oz, rot, Strata.Seed.next(h)) do
                    (ct, cx, cy, cz) -> site_coarse_go(Strata.Template.blit(c, key, ct, cx, cy, cz, 0, 0), key, ts, rank, nv, ext, seed, salt, scale, voxel, k, sx, sz, sfl, sidx, s + 1, s1, wrote + 1)
                  end
                else site_coarse_go(c, key, ts, rank, nv, ext, seed, salt, scale, voxel, k, sx, sz, sfl, sidx, s + 1, s1, wrote) end
            end
          None -> site_coarse_go(c, key, ts, rank, nv, ext, seed, salt, scale, voxel, k, sx, sz, sfl, sidx, s + 1, s1, wrote)
        end
      else site_coarse_go(c, key, ts, rank, nv, ext, seed, salt, scale, voxel, k, sx, sz, sfl, sidx, s + 1, s1, wrote) end
    end
  end

  pfn layer_rank(p : PopPlan, l : Int) : NativeIntArr do
    match List.nth_opt(p.pl_lrank, l) do
      Some(r) -> r
      None -> NativeArray.make_int(0, 0)
    end
  end
  pfn layer_temps(p : PopPlan, l : Int) : List(Strata.Template.Template) do
    match List.nth_opt(p.pl_ltemps, l) do
      Some(v) -> v
      None -> Nil
    end
  end

  -- layer l as a scatter layer over chunk k at a level above 0, cubes of kk
  pfn scatter_coarse(p : PopPlan, seed : Int, k : Strata.Coord.Key, g : Ground, t : Table, c : Strata.Chunk.Chunk, l : Int, kk : Int) : (Strata.Chunk.Chunk, Int) do
    let voxel = g.pg_voxel
    let x0 = 32 * Strata.Coord.kx(k)
    let z0 = 32 * Strata.Coord.kz(k)
    let xs = layer_instances(p, seed, g, t, l, int_to_float(x0) *. voxel, int_to_float(z0) *. voxel, int_to_float(x0 + 32) *. voxel, int_to_float(z0 + 32) *. voxel)
    stamp_coarse_go(c, k, layer_temps(p, l), layer_rank(p, l), g.pg_scale, kk, xs, 0)
  end
  -- layer l as a site layer over chunk k at a level above 0, cubes of kk
  pfn site_coarse(p : PopPlan, seed : Int, k : Strata.Coord.Key, g : Ground, c : Strata.Chunk.Chunk, l : Int, kk : Int) : (Strata.Chunk.Chunk, Int) do
    let nv = NativeArray.get_int(p.pl_lnv, l)
    if nv <= 0 do (c, 0)
    else
      let s0 = NativeArray.get_int(p.pl_lsat, l)
      site_coarse_go(c, k, layer_temps(p, l), layer_rank(p, l), nv, NativeArray.get_int(p.pl_lext, l), seed, NativeArray.get_int(p.pl_lsalt, l), g.pg_scale, g.pg_voxel, kk, p.pl_sx, p.pl_sz, p.pl_sfl, p.pl_sidx, s0, s0 + NativeArray.get_int(p.pl_lsn, l), 0)
    end
  end

  -- the layers from l in run order at level lvl above 0 (cubes of kk): the scatter and site layers seen to lvl or beyond
  pfn layers_coarse(p : PopPlan, seed : Int, k : Strata.Coord.Key, g : Ground, t : Table, lvl : Int, kk : Int, scatter : Bool, site : Bool, c : Strata.Chunk.Chunk, wrote : Int, l : Int) : (Strata.Chunk.Chunk, Int) do
    if l >= p.pl_nl do (c, wrote)
    else
      let kind = NativeArray.get_int(p.pl_lkind, l)
      let seen = seen_at(p, l, g.pg_scale) >= lvl
      let go = if kind == 1 do (if scatter do seen else false end) else if kind == 2 do (if site do seen else false end) else false end end
      if go do
        let r = if kind == 1 do scatter_coarse(p, seed, k, g, t, c, l, kk) else site_coarse(p, seed, k, g, c, l, kk) end
        match r do
          (c2, w) -> layers_coarse(p, seed, k, g, t, lvl, kk, scatter, site, c2, wrote + w, l + 1)
        end
      else layers_coarse(p, seed, k, g, t, lvl, kk, scatter, site, c, wrote, l + 1) end
    end
  end

  -- ── Placing a chunk ───────────────────────────────────────────────────────

  -- the layers from l in run order, each dispatched on its kind. cover:
  -- whether some floor of the Ground lies in the chunk's reach (without one
  -- no cover layer makes its pass); scatter: whether some top of the Ground
  -- can put a stamp in the chunk; site: whether some site's floor can.
  pfn layers_place(p : PopPlan, base : CoverRun, seed : Int, k : Strata.Coord.Key, g : Ground, t : Table, cover : Bool, scatter : Bool, site : Bool, c : Strata.Chunk.Chunk, wrote : Int, l : Int) : (Strata.Chunk.Chunk, Int) do
    if l >= p.pl_nl do (c, wrote)
    else
      let kind = NativeArray.get_int(p.pl_lkind, l)
      if kind == 0 do
        if cover do
          match cover_layer(p, base, c, l) do
            (c2, w) -> layers_place(p, base, seed, k, g, t, cover, scatter, site, c2, wrote + w, l + 1)
          end
        else layers_place(p, base, seed, k, g, t, cover, scatter, site, c, wrote, l + 1) end
      else if kind == 1 do
        if scatter do
          match scatter_layer(p, seed, k, g, t, c, l) do
            (c2, w) -> layers_place(p, base, seed, k, g, t, cover, scatter, site, c2, wrote + w, l + 1)
          end
        else layers_place(p, base, seed, k, g, t, cover, scatter, site, c, wrote, l + 1) end
      else if kind == 2 do
        if site do
          match site_layer(p, seed, k, g.pg_voxel, c, l) do
            (c2, w) -> layers_place(p, base, seed, k, g, t, cover, scatter, site, c2, wrote + w, l + 1)
          end
        else layers_place(p, base, seed, k, g, t, cover, scatter, site, c, wrote, l + 1) end
      else layers_place(p, base, seed, k, g, t, cover, scatter, site, c, wrote, l + 1) end end end
    end
  end

  -- What place_with asks of a Ground and a Table; place_problems words each.

  -- columns a Ground must hold beyond the chunk's own on each side: the pad when the plan scatters, in the Ground's own columns (scale * 2^level)
  pfn need_of(p : PopPlan, g : Ground) : Int do if p.pl_nscatter > 0 do plan_pad(p, g.pg_voxel) else 0 end end
  -- columns a .. a + 31 and `need` more each side lie in 0 .. n - 1
  pfn span_ok(a : Int, need : Int, n : Int) : Bool do if a - need >= 0 do a + 32 + need <= n else false end end
  pfn covers_chunk(g : Ground, k : Strata.Coord.Key, need : Int) : Bool do
    if span_ok(32 * Strata.Coord.kx(k) - g.pg_x0, need, g.pg_n) do span_ok(32 * Strata.Coord.kz(k) - g.pg_z0, need, g.pg_n) else false end
  end
  -- the Table must be this Ground's (n * n columns) and this plan's (its layer and zone counts)
  pfn table_fits(p : PopPlan, g : Ground, t : Table) : Bool do
    if t.pt_nn == g.pg_n * g.pg_n do (if t.pt_nl == p.pl_nl do t.pt_nz == p.pl_nz else false end) else false end
  end
  -- the Ground's voxel must be the key's: scale * 2^level
  pfn level_fits(g : Ground, k : Strata.Coord.Key) : Bool do g.pg_voxel == g.pg_scale *. Math.pow(2.0, int_to_float(Strata.Coord.level(k))) end
  pfn same_size(a : Float, b : Float) : Bool do Math.abs(a -. b) <= 0.000001 *. a end
  -- every scatter and site layer's template is at the world's voxel size, level 0's (Strata.Template.fit's tolerance)
  pfn stamps_fit(p : PopPlan, g : Ground) : Bool do
    if p.pl_tvhi <= 0.0 do true else if same_size(p.pl_tvlo, g.pg_scale) do same_size(p.pl_tvhi, g.pg_scale) else false end end
  end
  -- a key's chunk coordinates, in voxels of its level, within 2^40, so nothing multiplied by 2^level (at most 2^16) passes 2^62
  pfn key_near(k : Strata.Coord.Key) : Bool do
    if within40(32 * Strata.Coord.kx(k)) do (if within40(32 * Strata.Coord.ky(k)) do within40(32 * Strata.Coord.kz(k)) else false end) else false end
  end

  doc "Why place_with(p, _, k, _, g, t) would hand the chunk back unchanged though the plan has layers to place, one message each, or Nil: g's own problems; a key above level 0 whose chunk lies beyond 2^40 voxels of its level; g not covering the chunk's 32 x 32 columns and, when the plan has a scatter layer, pad more on each side in g's own columns; a Table that is not this plan's over g; g at another level than k; a scatter or site layer's template at another voxel size than the world's (g's scale) (fit the population with Strata.Population.fit_all). Site layers read no column of g and add no pad. A plan with nothing to place, and a chunk no floor or stamp reaches, are not problems."
  fn place_problems(p : PopPlan, k : Strata.Coord.Key, g : Ground, t : Table) : List(String) do
    let level = if Strata.Coord.level(k) == 0 do Nil else (if key_near(k) do Nil else ["place: the key at level " ++ int_to_string(Strata.Coord.level(k)) ++ " lies beyond 2^40 voxels of its level; nothing is placed there above level 0"] end) end
    let gp = problems(g)
    if List.is_empty(gp) do
      let need = need_of(p, g)
      let x0 = 32 * Strata.Coord.kx(k)
      let z0 = 32 * Strata.Coord.kz(k)
      let more = if need > 0 do " and " ++ int_to_string(need) ++ " more on each side for the scatter layers and the cover fields read (Strata.Populate.pad)" else "" end
      let covers = if covers_chunk(g, k, need) do Nil
        else ["place: the Ground holds columns x " ++ int_to_string(g.pg_x0) ++ ".." ++ int_to_string(g.pg_x0 + g.pg_n - 1) ++ ", z " ++ int_to_string(g.pg_z0) ++ ".." ++ int_to_string(g.pg_z0 + g.pg_n - 1) ++ "; the chunk needs x " ++ int_to_string(x0 - need) ++ ".." ++ int_to_string(x0 + 31 + need) ++ ", z " ++ int_to_string(z0 - need) ++ ".." ++ int_to_string(z0 + 31 + need) ++ ": its 32 columns" ++ more] end
      let table = if table_fits(p, g, t) do Nil
        else ["place: the Table holds " ++ int_to_string(t.pt_nn) ++ " columns, " ++ int_to_string(t.pt_nl) ++ " layers and " ++ int_to_string(t.pt_nz) ++ " zones; this plan over this Ground has " ++ int_to_string(g.pg_n * g.pg_n) ++ ", " ++ int_to_string(p.pl_nl) ++ " and " ++ int_to_string(p.pl_nz)] end
      let lvl = if level_fits(g, k) do Nil
        else ["place: the Ground's voxel is " ++ float_to_string(g.pg_voxel) ++ " m, not that of a key at level " ++ int_to_string(Strata.Coord.level(k)) ++ " of a world of " ++ float_to_string(g.pg_scale) ++ " m a voxel"] end
      let stamps = if stamps_fit(p, g) do Nil
        else ["place: the scatter and site layers' templates have voxels of " ++ float_to_string(p.pl_tvlo) ++ " to " ++ float_to_string(p.pl_tvhi) ++ " m and the world's (the Ground's scale) is " ++ float_to_string(g.pg_scale) ++ " m; fit the population with Strata.Population.fit_all"] end
      List.append(level, List.append(covers, List.append(table, List.append(lvl, stamps))))
    else List.append(gp, level) end
  end

  doc "The chunk at key k with plan p's layers placed, in run order, over Ground g, whose fields t holds (t = fields_with(p, seed, g)). Cover, scatter and site layers at level 0; at a level L above 0 (g at scale * 2^L, k = 2^L) only the scatter and site layers seen to L or beyond (Strata.Population.seen_level_at), each instance level 0 decides (the same cells, hashes, variants, turns and streams; density, weights zone and top read from g at the column holding its place) standing at its fine world position (fine column floor(xm / scale), its lowest fine row k (top + 1), a site's floor(F / scale) + 1) and coarsened onto the coarse grid by Strata.Template.coarsen_placed with its shape set's ranks, then blitted over whatever is there. A cover layer visits each floor of each of the chunk's columns (g's surfaces, or one floor at tops[col]); where the voxel above the floor is air and inside the chunk it rolls Strata.Seed.unit(Strata.Seed.cell(seed, salt, wx, y, wz)) at the floor's world voxel against the layer's density times the column's area (voxel size squared), and on success writes a variant's block id there: the variant comes from Strata.Seed.next of the same hash, against the weights of the first weighted zone (declaration order) the column is in, else uniformly. A written block is not air, so a later cover layer never overwrites it. A scatter layer is Strata.Feature cells of its cell size, jitter and salt: a cell holds an instance with probability density * cell * cell (at most 1), the density read at the column the candidate stands on; its variant comes from the candidate's index against the same weights; a template variant, turned the candidate's quarter turn (w x d columns), is blitted with the candidate's stream from w / 2 and d / 2 columns (rounded down) before that column and one voxel above its top (tops, whatever the surfaces), the part inside the chunk written over whatever is there (holes leave it); a block variant is written at that one voxel. A site layer stamps, at each of its sites in declaration order, variant index mod variants (0..variants - 1) turned h mod 4, its probabilities drawn from Strata.Seed.next(h), for h = Strata.Seed.cell(seed, salt, index, 0, 0), from w / 2 and d / 2 columns before the column holding the site's centre and with its lowest row at floor(F / voxel) + 1, F the site's floor read as a 32-bit float (a block variant at that one voxel); it reads no column of g. Instances of one layer are stamped in cell order (rows of z, x increasing), sites in declaration order, layers in run order, so where stamps overlap the later is on top, the same from every chunk. Every voxel is a function of its world position, the seed and the ground under the instances that reach it: any g that covers what is needed gives the same chunk. g may be larger than the chunk; its corner and the key's 32 * kx, 32 * kz place the chunk's columns in it. The chunk comes back unchanged (the same value) when nothing is written: with no layer placed at k's level, at a level above 0 with k's chunk beyond 2^40 voxels of its level, when no floor of g reaches the chunk and no top of g or site floor can put a stamp in it, or when something is wrong, which place_problems words: g does not cover the chunk's 32 x 32 columns (and, with a scatter layer, plan_pad more on each side, in g's own columns), has problems or is at another level than k, t is not n * n columns or holds another layer or zone count than p, or a scatter or site layer's template is not at the world's scale (g's scale). A layer whose density is 0 at every column of g costs no pass, and no cover layer makes a pass over a chunk that only stamps reach. A top or floor at either end of Int, and a site floor or centre that is huge, infinite or NaN, traps nothing. The chunk handed in is never changed."
  fn place_with(p : PopPlan, seed : Int, k : Strata.Coord.Key, c : Strata.Chunk.Chunk, g : Ground, t : Table) : Strata.Chunk.Chunk do
    let lvl = Strata.Coord.level(k)
    if lvl == 0 do place_fine(p, seed, k, c, g, t)
    else if lvl > 0 do place_coarse(p, seed, k, c, g, t, lvl)
    else c end end
  end

  -- place_with at level 0
  pfn place_fine(p : PopPlan, seed : Int, k : Strata.Coord.Key, c : Strata.Chunk.Chunk, g : Ground, t : Table) : Strata.Chunk.Chunk do
    let has_cover = p.pl_ncover > 0
    let has_scatter = p.pl_nscatter > 0
    let has_site = p.pl_nsite > 0
    let some = if has_cover do true else (if has_scatter do true else has_site end) end
    -- a scale above 0 before anything divides by it
    let sound = if some do g.pg_scale > 0.0 else false end
    if sound do
      let ylo = 32 * Strata.Coord.ky(k) - 1
      -- a floor at y covers y + 1; an instance on a top at y fills y + 1 .. y + pl_hmax at most
      let cover_reach = if has_cover do (if g.pg_fhi >= ylo do g.pg_flo <= ylo + 31 else false end) else false end
      let scatter_reach = if has_scatter do (if g.pg_thi >= ylo + 1 - p.pl_hmax do g.pg_tlo <= ylo + 31 else false end) else false end
      -- a site's lowest row is floor(F / voxel) + 1, its stamp at most pl_hmax high: compared as floats, so no floor overflows
      let site_reach = if has_site do (if p.pl_sfhi /. g.pg_voxel >= int_to_float(ylo + 1 - p.pl_hmax) do p.pl_sflo /. g.pg_voxel < int_to_float(ylo + 32) else false end) else false end
      let reached = if cover_reach do true else (if scatter_reach do true else site_reach end) end
      let fits = if reached do (if covers_chunk(g, k, need_of(p, g)) do (if table_fits(p, g, t) do (if level_fits(g, k) do stamps_fit(p, g) else false end) else false end) else false end) else false end
      if fits do
        if List.is_empty(problems(g)) do
          let wx0 = 32 * Strata.Coord.kx(k)
          let wz0 = 32 * Strata.Coord.kz(k)
          let base = { cr_seed: seed, cr_salt: 0, cr_area: g.pg_voxel *. g.pg_voxel, cr_dens: t.pt_dens, cr_dmax: t.pt_dmax, cr_doff: 0, cr_zs: t.pt_zones, cr_nn: t.pt_nn,
                       cr_ids: p.pl_lids, cr_vat: 0, cr_vn: 0, cr_wzone: p.pl_wzone, cr_wbase: p.pl_wbase, cr_wcum: p.pl_wcum, cr_wat: 0, cr_wend: 0,
                       cr_n: g.pg_n, cr_ci: wx0 - g.pg_x0, cr_cj: wz0 - g.pg_z0, cr_wx0: wx0, cr_wz0: wz0, cr_ylo: ylo, cr_surf: g.pg_surf, cr_tops: g.pg_tops, cr_sat: g.pg_sat, cr_sys: g.pg_sys, cr_skind: g.pg_skind }
          -- set_idx writes into arrays the chunk handed in still holds, so they are copied on the first write (GAPS S30) and c is never changed
          match layers_place(p, base, seed, k, g, t, cover_reach, scatter_reach, site_reach, c, 0, 0) do
            (out, wrote) -> if wrote > 0 do out else c end
          end
        else c end
      else c end
    else c end
  end

  -- place_with at level lvl above 0: the scatter and site layers seen to lvl or beyond, coarsened by 2^lvl
  pfn place_coarse(p : PopPlan, seed : Int, k : Strata.Coord.Key, c : Strata.Chunk.Chunk, g : Ground, t : Table, lvl : Int) : Strata.Chunk.Chunk do
    -- a level above 16 is no layer's (seen_to is at most 16, and so is the default)
    let has_scatter = if lvl <= 16 do (if g.pg_scale > 0.0 do seen_count(p, 1, lvl, g.pg_scale, 0, 0) > 0 else false end) else false end
    let has_site = if lvl <= 16 do (if g.pg_scale > 0.0 do seen_count(p, 2, lvl, g.pg_scale, 0, 0) > 0 else false end) else false end
    let some = if has_scatter do key_near(k) else (if has_site do key_near(k) else false end) end
    if some do
      let kk = int_shl(1, lvl)
      let kf = int_to_float(kk)
      let qy = 32 * Strata.Coord.ky(k)
      let ylo = qy - 1
      -- coarse rows above a coarse top are no more than fine rows (pl_hmax), so the scatter gate of level 0 holds
      let scatter_reach = if has_scatter do (if g.pg_thi >= ylo + 1 - p.pl_hmax do g.pg_tlo <= ylo + 31 else false end) else false end
      -- a site's lowest fine row r0 = floor(F / scale) + 1 lies in the chunk's fine rows (k qy .. k (qy + 32) - 1) or below them by less than pl_hmax: in floats, before anything is an Int
      let site_reach = if has_site do (if p.pl_sfhi /. g.pg_scale >= kf *. int_to_float(qy) -. int_to_float(p.pl_hmax) do p.pl_sflo /. g.pg_scale < kf *. int_to_float(qy + 32) -. 1.0 else false end) else false end
      let reached = if scatter_reach do true else site_reach end
      let fits = if reached do (if covers_chunk(g, k, need_of(p, g)) do (if table_fits(p, g, t) do (if level_fits(g, k) do stamps_fit(p, g) else false end) else false end) else false end) else false end
      if fits do
        if List.is_empty(problems(g)) do
          match layers_coarse(p, seed, k, g, t, lvl, kk, scatter_reach, site_reach, c, 0, 0) do
            (out, wrote) -> if wrote > 0 do out else c end
          end
        else c end
      else c end
    else c end
  end

  doc "place_with(plan(f), seed, k, c, g, fields(f, seed, g)): for tests and tools. A game keeps one plan per Frozen, evaluates a Ground's fields once with fields_with and hands the Table to place_with."
  fn place(f : Strata.Population.Frozen, seed : Int, k : Strata.Coord.Key, c : Strata.Chunk.Chunk, g : Ground) : Strata.Chunk.Chunk do
    let p = plan(f)
    place_with(p, seed, k, c, g, fields_with(p, seed, g))
  end

  doc "Every instance of the scatter layer named layer that stands on a column of g, each with the top of that column, in cell order (rows of increasing z, x increasing within a row); t = fields(f, seed, g). The instances over an area are those over its parts. Nil for an undeclared layer or one that is not a scatter layer, a Table that is not f's over g, or a g with problems. For tests and tools: it builds a plan."
  fn instances(f : Strata.Population.Frozen, seed : Int, t : Table, g : Ground, layer : String) : List(PopInstance) do
    let l = Pn.layer_index(f, layer)
    if Pn.layer_kind(f, l) == 1 do
      let p = plan(f)
      if table_fits(p, g, t) do
        if List.is_empty(problems(g)) do
          let voxel = g.pg_voxel
          layer_instances(p, seed, g, t, l, int_to_float(g.pg_x0) *. voxel, int_to_float(g.pg_z0) *. voxel, int_to_float(g.pg_x0 + g.pg_n) *. voxel, int_to_float(g.pg_z0 + g.pg_n) *. voxel)
        else Nil end
      else Nil end
    else Nil end
  end
end
