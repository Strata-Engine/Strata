-- Ray — a screen point as a ray into the world.
--
-- A view-projection matrix (GL clip space, z in [-1, 1], as
-- Strata.Math.Mat4.perspective makes) maps the world to the screen; its
-- inverse maps a pixel back to a line. Pixel (0, 0) is the window's top-left
-- corner, as GLFW reports the pointer.
mod Strata.Math.Ray do

  alias Strata.Math.Mat4 as RyM
  alias Strata.Math.Vec3 as RyV

  -- a clip-space point through the inverse, divided by w; None when w is 0
  pfn unproject(inv : NativeFloatArr, nx : Float, ny : Float, nz : Float) : Option((Float, Float, Float)) do
    let p = RyM.transform_point(inv, RyV.new(nx, ny, nz))
    let w = RyM.w4(p)
    if Math.abs(w) < 0.000000000001 do None
    else Some((RyM.x4(p) /. w, RyM.y4(p) /. w, RyM.z4(p) /. w)) end
  end

  doc "The ray through pixel ([px], [py]) of a [width] x [height] window seen through [view_proj]: its origin on the near plane and its unit direction, in metres. None when the matrix has no inverse."
  fn from_screen(view_proj : NativeFloatArr, px : Float, py : Float, width : Float, height : Float) : Option(((Float, Float, Float), (Float, Float, Float))) do
    match RyM.invert(view_proj) do
      None -> None
      Some(inv) ->
        let nx = 2.0 *. px /. width -. 1.0
        let ny = 1.0 -. 2.0 *. py /. height
        match unproject(inv, nx, ny, -1.0) do
          None -> None
          Some((ax, ay, az)) ->
            match unproject(inv, nx, ny, 1.0) do
              None -> None
              Some((bx, by0, bz)) ->
                let dx = bx -. ax
                let dy = by0 -. ay
                let dz = bz -. az
                let l = Math.sqrt(dx *. dx +. dy *. dy +. dz *. dz)
                if l < 0.000000000001 do None
                else Some(((ax, ay, az), (dx /. l, dy /. l, dz /. l))) end
            end
        end
    end
  end
end
