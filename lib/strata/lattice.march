-- Lattice — a chunk's density sampled coarsely and filled in.
--
-- A generator samples its 3D fields at one point every (4, 8, 4) voxels: 9 x
-- 5 x 9 samples cover a chunk, its far faces included (the last layer of one
-- chunk is the first of the next, so the fill has no seam). The samples sit
-- in a NativeF32Arr of 405 at i + 9 * (j + 5 * k), i along x, j along y, k
-- along z. `fill` interpolates them trilinearly to the chunk's 32768 voxels
-- at the flat index of Strata.Coord.index (x + 32 * (z + 32 * y)).
--
-- The fill runs in C (native/strata_noise.c, sl_fill): March native arrays
-- are copy-on-write, so a March loop could not write into the caller's
-- array. It is separable — a 9 x 9 plane per voxel row, a row of 9 per z,
-- four voxels a cell along x — and its fractions are the constants k / 8
-- and k / 4, so it needs no weight tables.
mod Strata.Lattice do

  doc "Voxels a lattice cell spans along x, y and z: (4, 8, 4)."
  fn dims() : (Int, Int, Int) do (4, 8, 4) end

  doc "Samples a chunk along x, y and z: (9, 5, 9), 405 in all, at index i + 9 * (j + 5 * k)."
  fn samples() : (Int, Int, Int) do (9, 5, 9) end

  doc "Fill out (32768, indexed as Strata.Coord.index) trilinearly from 405 lattice samples; returns 32768, or 0 (writing nothing) when either array is too small."
  fn fill(s : NativeF32Arr, out : NativeF32Arr) : Int do Strata.Ffi.Noise.lattice_fill(s, out) end

  pfn bounds_go(s : NativeF32Arr, k : Int, lo : Float, hi : Float) : (Float, Float) do
    if k >= 405 do (lo, hi)
    else
      let v = NativeArray.get_f32(s, k)
      bounds_go(s, k + 1, if v < lo do v else lo end, if v > hi do v else hi end)
    end
  end

  doc "The least and greatest of the 405 samples."
  fn bounds(s : NativeF32Arr) : (Float, Float) do
    let v = NativeArray.get_f32(s, 0)
    bounds_go(s, 1, v, v)
  end
end
