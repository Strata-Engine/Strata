-- Terrain — the contract a game's world generator meets.
--
-- A generator is a PURE function from a chunk key and a seed to a chunk.
-- Purity is the whole contract: workers run it ahead of need and in
-- parallel, and a chunk nobody edited is dropped and generated again
-- identically when the world returns to it.
--
-- A generator may carry a second pure function beside it, its stamps: the
-- game's replay of its template pass alone, saying which voxels of a chunk
-- a placed structure wrote (the structure's index + 1 a voxel, 0 for none).
-- It is not stored; it is asked for when wanted, and a
-- voxel an edit has since removed is told by comparing with the chunk.
--
-- A generator declares the highest level of detail it supports
-- (Strata.Coord: a level-L chunk's voxels are 2^L times the world's scale)
-- and makes a chunk for any key up to it directly, without the fine chunks
-- under it. To keep cracks between levels small a coarse voxel should be
-- solid where any fine voxel it stands for would be. A key above the
-- declared level is air; a generator made with `gen` declares level 0, the
-- near field only. Stamps are a level-0 notion: a coarser key has none.
mod Strata.Terrain do

  type Stamps = Stamps(Strata.Coord.Key -> Int -> NativeI32Arr)

  -- the chunk function, the stamps function if any, and the highest level
  type Gen = Gen(Strata.Coord.Key -> Int -> Strata.Chunk.Chunk, Option(Stamps), Int)

  doc "Wrap a generator function: (chunk key, seed) -> chunk. It has no stamps and declares level 0: `gen_levels(f, 0)`."
  fn gen(f : Strata.Coord.Key -> Int -> Strata.Chunk.Chunk) : Gen do Gen(f, None, 0) end

  doc "Wrap a generator function that makes chunks of every level 0..[max_level] (it reads the key's level). It has no stamps."
  fn gen_levels(f : Strata.Coord.Key -> Int -> Strata.Chunk.Chunk, max_level : Int) : Gen do Gen(f, None, if max_level < 0 do 0 else max_level end) end

  doc "The highest level of detail [g] generates."
  fn max_level(g : Gen) : Int do match g do Gen(_, _, l) -> l end end

  doc "The generator [g] with the stamps function [s]: (chunk key, seed) -> 32768 values in a chunk's voxel order (x + 32 z + 1024 y), the structure index + 1 a voxel, 0 for none."
  fn with_stamps(g : Gen, s : Stamps) : Gen do
    match g do Gen(f, _, l) -> Gen(f, Some(s), l) end
  end

  doc "Generate the chunk at [k] for [seed]: air for a key above the generator's level (or below 0)."
  fn run(g : Gen, k : Strata.Coord.Key, seed : Int) : Strata.Chunk.Chunk do
    match g do
      Gen(f, _, l) ->
        let kl = Strata.Coord.level(k)
        if kl > l || kl < 0 do Strata.Chunk.uniform(0) else f(k, seed) end
    end
  end

  doc "The stamps of the chunk at [k] for [seed]: a fresh array of 32768, all zeros for a generator without stamps or a key above level 0."
  fn stamps(g : Gen, k : Strata.Coord.Key, seed : Int) : NativeI32Arr do
    if Strata.Coord.level(k) != 0 do NativeArray.make_i32(32768, 0)
    else
      match g do
        Gen(_, Some(Stamps(s)), _) -> s(k, seed)
        Gen(_, None, _) -> NativeArray.make_i32(32768, 0)
      end
    end
  end
end
