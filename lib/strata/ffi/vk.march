-- Window, input and the packed-quad renderer: thin bindings onto
-- native/strata_vk.c. No Vulkan type leaks: quads cross as a NativeI32Arr
-- (Strata.Quad's two words), the camera as sixteen floats, scalars as Int
-- and Float.
--
-- Every extern is wrapped in an ordinary fn: an extern called qualified from
-- another module typechecks but fails at link time (cube_forge GAPS G5).
--
-- A consumer must list native/strata_vk.c in its own forge.toml [ffi]
-- sources and link GLFW and Vulkan; forge does not build a dependency's C.
mod Strata.Ffi.Vk do

  needs IO.Foreign
  needs Window

  extern "strata_vk" : Cap(Window) do
    fn x_open(w: Int, h: Int, capture_mouse: Int, quad_capacity: Int): Int = "sv_open"
    fn x_open_slots(w: Int, h: Int, capture_mouse: Int, quad_capacity: Int, slots: Int): Int = "sv_open_slots"
    fn x_close(): Unit = "sv_close"
    fn x_should_close(): Int = "sv_should_close"
    fn x_poll(): Unit = "sv_poll"
    fn x_key(k: Int): Int = "sv_key"
    fn x_mouse_button(b: Int): Int = "sv_mouse_button"
    fn x_mouse_x(): Float = "sv_mouse_x"
    fn x_mouse_y(): Float = "sv_mouse_y"
    fn x_scroll_y(): Float = "sv_scroll_y"
    fn x_input_key(k: Int, down: Int): Unit = "sv_input_key"
    fn x_input_button(b: Int, down: Int): Unit = "sv_input_button"
    fn x_input_mouse(x: Float, y: Float): Unit = "sv_input_mouse"
    fn x_input_scroll(dy: Float): Unit = "sv_input_scroll"
    fn x_input_release(): Unit = "sv_input_release"
    fn x_set_cursor(captured: Int): Unit = "sv_set_cursor"
    fn x_mouse_dx(): Float = "sv_mouse_dx"
    fn x_mouse_dy(): Float = "sv_mouse_dy"
    fn x_time(): Float = "sv_time"
    fn x_fb_w(): Int = "sv_fb_w"
    fn x_fb_h(): Int = "sv_fb_h"
    fn x_chunk_begin(slot: Int, ox: Float, oy: Float, oz: Float, level: Int): Int = "sv_chunk_begin"
    fn x_chunk_instance(slot: Int, prototype: Int, x: Float, y: Float, z: Float): Int = "sv_chunk_instance"
    fn x_chunk_motion(slot: Int, prototype: Int, t0: Float, t1: Float, p0: Float, p1: Float, keys: NativeI32Arr, n: Int, gait: Int): Int = "sv_chunk_motion"
    fn x_motion_clock(t: Float): Unit = "sv_motion_clock"
    fn x_chunk_show(slot: Int, shown: Int): Unit = "sv_chunk_show"
    fn x_chunk_part(part: Int, words: NativeI32Arr, n: Int): Int = "sv_chunk_part"
    fn x_chunk_commit(): Int = "sv_chunk_commit"
    fn x_chunk_orders(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int): Int = "sv_chunk_orders"
    fn x_chunk_free(slot: Int): Unit = "sv_chunk_free"
    fn x_set_camera(vp: NativeF32Arr): Unit = "sv_set_camera"
    fn x_set_sun(x: Float, y: Float, z: Float, r: Float, g: Float, b: Float): Unit = "sv_set_sun"
    fn x_set_fog(start: Float, stop: Float, a: Float, b: Float): Unit = "sv_set_fog"
    fn x_set_eye(x: Float, y: Float, z: Float, scale: Float): Unit = "sv_set_eye"
    fn x_textures_create(tile_px: Int, layers: Int): Int = "sv_textures_create"
    fn x_texture_set(layer: Int, rgba: NativeU8Arr, nbytes: Int): Int = "sv_texture_set"
    fn x_textures_commit(): Int = "sv_textures_commit"
    fn x_blocks_set(words: NativeI32Arr, nblocks: Int): Int = "sv_blocks_set"
    fn x_model_set(index: Int, floats: NativeF32Arr, nquads: Int): Int = "sv_model_set"
    fn x_body_begin(slot: Int): Int = "sv_body_begin"
    fn x_body_shape(handle: Int, bytes: NativeU8Arr, n: Int, sx: Int, sy: Int, sz: Int): Int = "sv_body_shape"
    fn x_body_place(handle: Int, px: Float, py: Float, pz: Float, qx: Float, qy: Float, qz: Float, qw: Float): Unit = "sv_body_place"
    fn x_body_drop(handle: Int): Unit = "sv_body_drop"
    fn x_body_share(handle: Int, from: Int): Int = "sv_body_share"
    fn x_body_instance(slot: Int, prototype: Int): Int = "sv_body_instance"
    fn x_body_voxel(handle: Int, metres: Float): Unit = "sv_body_voxel"
    fn x_slot_voxel(slot: Int, metres: Float): Unit = "sv_slot_voxel"
    fn x_slot_pose(slot: Int, px: Float, py: Float, pz: Float, qx: Float, qy: Float, qz: Float, qw: Float): Unit = "sv_slot_pose"
    fn x_frame(): Int = "sv_frame"
    fn x_request_shot(): Unit = "sv_request_shot"
    fn x_drawn_chunks(): Int = "sv_drawn_chunks"
    fn x_drawn_quads(): Int = "sv_drawn_quads"
    fn x_live_quads(): Int = "sv_live_quads"
    fn x_set_vsync(flag: Int): Unit = "sv_set_vsync"
    fn x_footprints_begin(): Unit = "sv_footprints_begin"
    fn x_footprint(slot: Int, x: Float, y: Float, z: Float, dx: Float, dz: Float, length: Float, width: Float): Unit = "sv_footprint"
    fn x_footprint_blocked(x0: Float, y0: Float, z0: Float, x1: Float, y1: Float, z1: Float, ignore: Int): Int = "sv_footprint_blocked"
    fn x_footprints_freeze(): Unit = "sv_footprints_freeze"
    fn x_footprint_count(set: Int): Int = "sv_footprint_count"
    fn x_footprint_bound(set: Int, index: Int, which: Int): Float = "sv_footprint_bound"
    fn x_set_lighting(mode: Int): Unit = "sv_set_lighting"
    fn x_moving_lights_begin(headlights: Int): Unit = "sv_moving_lights_begin"
    fn x_headlight(x: Float, y: Float, z: Float, dx: Float, dz: Float, cls: Int): Int = "sv_headlight"
    fn x_beacon(x: Float, y: Float, z: Float, cls: Int): Unit = "sv_beacon"
    fn x_set_lamp_tracing(on: Int, moving_shadows: Int): Unit = "sv_set_lamp_tracing"
    fn x_set_lamp_shadow(cls: Int, on: Int): Unit = "sv_set_lamp_shadow"
    fn x_set_lamp_reach(voxels: Int): Unit = "sv_set_lamp_reach"
    fn x_lamp_shadow(cls: Int): Int = "sv_lamp_shadow"
    fn x_set_time(seconds: Float): Unit = "sv_set_time"
    fn x_set_underwater(surface_y: Float, r: Float, g: Float, b: Float, density: Float): Unit = "sv_set_underwater"
    fn x_set_weather(overcast: Float, wet: Float, flash: Float, rain: Float): Unit = "sv_set_weather"
    fn x_set_rain(x: Float, y: Float, z: Float, clock: Float): Unit = "sv_set_rain"
    fn x_set_cloud_shadows(blobs: NativeF32Arr, n: Int, darkness: Float): Unit = "sv_set_cloud_shadows"
    fn x_set_sea(wind_x: Float, wind_z: Float, height: Float, whitecaps: Float): Unit = "sv_set_sea"
    fn x_set_sea_map(cells: NativeF32Arr, w: Int, h: Int, x0: Float, z0: Float, cell: Float): Int = "sv_set_sea_map"
    fn x_effect_set(index: Int, floats: NativeF32Arr): Int = "sv_effect_set"
    fn x_emit(effect: Int, shape: Int, f18: NativeF32Arr, count: Int, seed: Int): Int = "sv_emit"
    fn x_spray(x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, count: Int, spread: Float, life: Float, tex: Int): Int = "sv_spray"
    fn x_set_quality(sky_rays: Int, reflections: Int): Unit = "sv_set_quality"
    fn x_set_trace_scale(scale: Int): Unit = "sv_set_trace_scale"
    fn x_trace_scale(): Int = "sv_trace_scale"
    fn x_set_light_box(radius_h: Int, radius_v: Int): Int = "sv_set_light_box"
    fn x_light_table_set(words: NativeI32Arr, nclasses: Int): Int = "sv_light_table_set"
    fn x_chunk_light(bytes: NativeU8Arr, n: Int): Int = "sv_chunk_light"
    fn x_stat(which: Int): Float = "sv_stat"
    fn x_ui_set(floats: NativeF32Arr, nquads: Int): Int = "sv_ui_set"
    fn x_overlay_set(floats: NativeF32Arr, nitems: Int): Int = "sv_overlay_set"
    fn x_set_cut(floats: NativeF32Arr): Int = "sv_set_cut"
    fn x_ui_atlas(w: Int, h: Int, rgba: NativeU8Arr): Int = "sv_ui_atlas"
    fn x_win_w(): Int = "sv_win_w"
    fn x_win_h(): Int = "sv_win_h"
    fn x_refused(): Int = "sv_refused"
    fn x_pad_commands(n: Int): Unit = "sv_pad_commands"
    fn x_force_rebuild(): Unit = "sv_force_rebuild"
    fn x_set_offscreen(flag: Int): Unit = "sv_set_offscreen"
    fn x_rig_part_begin(rig: Int, part: Int, ox: Int, oy: Int, oz: Int): Int = "sv_rig_part_begin"
    fn x_rig_part_anchor(rig: Int, part: Int, ax: Float, ay: Float, az: Float, voxel: Float): Int = "sv_rig_part_anchor"
    fn x_rig_palette(rig: Int, colours: NativeF32Arr): Int = "sv_rig_palette"
    fn x_set_blend(blend: Float): Unit = "sv_set_blend"
    fn x_rig_shape(rig: Int, part: Int, idx: NativeU8Arr, n: Int, sx: Int, sy: Int, sz: Int): Int = "sv_rig_shape"
    fn x_rig_clear(rig: Int): Int = "sv_rig_clear"
    fn x_typed_count(): Int = "sv_typed_count"
    fn x_typed(i: Int): Int = "sv_typed"
    fn x_pad_connected(p: Int): Int = "sv_pad_connected"
    fn x_pad_button(p: Int, b: Int): Int = "sv_pad_button"
    fn x_pad_axis(p: Int, a: Int): Float = "sv_pad_axis"
  end

  doc "Open a w x h window with a Vulkan surface. With [capture_mouse] the cursor is hidden and locked for mouse-look. [quad_capacity] is how many quads the GPU buffer holds; 0 means the default of 8 388 608 (64 MB). False if any step fails; the reason goes to stderr."
  fn open(w : Int, h : Int, capture_mouse : Bool, quad_capacity : Int) : Bool do x_open(w, h, if capture_mouse do 1 else 0 end, quad_capacity) == 1 end
  doc "`open` with [slots] chunk slots (16 480 to 2 097 152) instead of the default 16 480. The slot tables, motion records and command lists are sized to [slots], about 1 KB a slot across the frames in flight, so ask for what the app uses."
  fn open_slots(w : Int, h : Int, capture_mouse : Bool, quad_capacity : Int, slots : Int) : Bool do
    x_open_slots(w, h, if capture_mouse do 1 else 0 end, quad_capacity, slots) == 1
  end
  fn close() : Unit do x_close() end
  fn should_close() : Bool do x_should_close() == 1 end
  doc "Pump window events and reset the per-frame mouse motion. Call once a frame, before reading input."
  fn poll() : Unit do x_poll() end
  doc "Is the key with this GLFW key code held?"
  fn key(k : Int) : Bool do x_key(k) == 1 end
  doc "Is mouse button [b] held? 0 left, 1 right, 2 middle."
  fn mouse_button(b : Int) : Bool do x_mouse_button(b) == 1 end
  doc "Cursor x in window points, from the left edge; 0 without a window."
  fn mouse_x() : Float do x_mouse_x() end
  doc "Cursor y in window points, from the top edge; 0 without a window."
  fn mouse_y() : Float do x_mouse_y() end
  doc "Vertical scroll delta accumulated during the latest poll."
  fn scroll_y() : Float do x_scroll_y() end
  doc "Virtual input (Strata.Devtools' key, mouse, scroll and release): hold key [k] down or let it up; it counts as held alongside the real keyboard."
  fn input_key(k : Int, down : Bool) : Unit do x_input_key(k, if down do 1 else 0 end) end
  doc "Hold mouse button [b] (0 left, 1 right, 2 middle) down or let it up, alongside the real mouse."
  fn input_button(b : Int, down : Bool) : Unit do x_input_button(b, if down do 1 else 0 end) end
  doc "Put the pointer at ([x], [y]) in window coordinates (as `mouse_x` reads them) until `input_release`; a move counts toward `mouse_dx`/`mouse_dy`."
  fn input_mouse(x : Float, y : Float) : Unit do x_input_mouse(x, y) end
  doc "Scroll by [dy] this frame, on top of the real wheel."
  fn input_scroll(dy : Float) : Unit do x_input_scroll(dy) end
  doc "Let go of every virtual key and button and give the pointer back to the real mouse."
  fn input_release() : Unit do x_input_release() end
  doc "Capture the cursor (hidden and locked, for looking) or free it (shown, for pointing at an interface)."
  fn set_cursor(captured : Bool) : Unit do x_set_cursor(if captured do 1 else 0 end) end
  fn mouse_dx() : Float do x_mouse_dx() end
  fn mouse_dy() : Float do x_mouse_dy() end
  pfn typed_from(i : Int, acc : List(Int)) : List(Int) do
    if i < 0 do acc else typed_from(i - 1, Cons(x_typed(i), acc)) end
  end
  doc "What was typed during the latest poll, in order, at most 64 events: a positive number is a Unicode code point; a negative one is minus the GLFW code of a key from 256 up (Enter 257, Backspace 259, Delete 261, Right 262, Left 263, Home 268, End 269) pressed or repeated by the system. Strata.Controls.text_edit applies the list to a string."
  fn typed() : List(Int) do typed_from(x_typed_count() - 1, Nil) end
  doc "Is gamepad [p] (0..15) connected, as of the latest poll? Only a pad GLFW has a mapping for counts."
  fn pad_connected(p : Int) : Bool do x_pad_connected(p) == 1 end
  pfn first_pad_from(p : Int) : Int do
    if p >= 16 do -1 else if x_pad_connected(p) == 1 do p else first_pad_from(p + 1) end end
  end
  doc "The lowest connected gamepad, or -1 when there is none."
  fn first_pad() : Int do first_pad_from(0) end
  doc "Is pad [p]'s button [b] held? GLFW's order, Xbox layout: 0 south, 1 east, 2 west, 3 north, 4 left bumper, 5 right bumper, 6 back, 7 start, 8 guide, 9 left stick click, 10 right stick click, 11 d-pad up, 12 right, 13 down, 14 left. False for a pad that is not connected."
  fn pad_button(p : Int, b : Int) : Bool do x_pad_button(p, b) == 1 end
  doc "Pad [p]'s axis [a], with no dead zone (Strata.Input applies one): 0 and 1 the left stick's x and y, 2 and 3 the right stick's, -1..1 with y positive downward; 4 and 5 the left and right triggers, 0 at rest to 1. 0 for a pad that is not connected."
  fn pad_axis(p : Int, a : Int) : Float do x_pad_axis(p, a) end
  doc "Seconds since the window system started."
  fn time() : Float do x_time() end
  fn fb_w() : Int do x_fb_w() end
  fn fb_h() : Int do x_fb_h() end

  doc "Begin uploading a chunk into slot [slot]. (ox, oy, oz) is the chunk's low corner in voxels of level 0; [level] its level of detail (Strata.Coord): its quads' voxels are drawn 2^level voxels of level 0 on a side, and so 2^level times the world's scale in metres, with textures repeating per level-0 voxel. A chunk above level 0 is lit by the sun and sky without rays and never enters the light volume. Follow with `chunk_part` for each part that is not empty, then `chunk_commit`."
  fn chunk_begin(slot : Int, ox : Int, oy : Int, oz : Int, level : Int) : Bool do x_chunk_begin(slot, int_to_float(ox), int_to_float(oy), int_to_float(oz), level) == 1 end
  doc "Position a slot using an opaque level-zero prototype. The prototype is immutable until the renderer closes."
  fn chunk_instance(slot : Int, prototype : Int, x : Int, y : Int, z : Int) : Bool do
    x_chunk_instance(slot, prototype, int_to_float(x), int_to_float(y), int_to_float(z)) == 1
  end
  doc "Draw slot [slot] as [prototype] (as `chunk_instance` would) moving on the GPU along [n] keys: four ints each in [keys] (x, y, z, and the key's place, 0 .. 8 eighths of the way through, rising, the first 0), from time [t0] to [t1] on the clock `motion_clock` sets, its progress going from [p0] to [p1]. With [gait] the shader steps a walker's legs (the mesh's bottom two voxel rows, x 0 and x 1) every twelfth of progress. Shows the slot. False when a key is more than 511 voxels across or 127 up from the first (the slot is left as it was), or the prototype cannot be batched (the slot then stands at the first key)."
  fn chunk_motion(slot : Int, prototype : Int, t0 : Float, t1 : Float, p0 : Float, p1 : Float, keys : NativeI32Arr, n : Int, gait : Bool) : Bool do
    x_chunk_motion(slot, prototype, t0, t1, p0, p1, keys, n, if gait do 1 else 0 end) == 1
  end
  doc "Set the time slots moving by `chunk_motion` are drawn at."
  fn motion_clock(t : Float) : Unit do x_motion_clock(t) end
  doc "Draw slot [slot]'s mesh, or keep it without drawing it ([shown] false; Strata.Slots' which-chunk-draws rule). A slot's mesh is drawn from its first upload until hidden; uploading it again keeps what was set, and freeing it clears it."
  fn chunk_show(slot : Int, shown : Bool) : Unit do x_chunk_show(slot, if shown do 1 else 0 end) end
  doc "Begin uploading one 32-cubed part of a body into [slot]: give its parts with `chunk_part` and finish with `chunk_commit`, as for a chunk. It is drawn at the pose `slot_pose` gives and is never written into the light volume."
  fn body_begin(slot : Int) : Bool do x_body_begin(slot) == 1 end
  doc "Give body [handle] (0 .. 16383, the game's choice) its shape for the rays: one light class byte a voxel, x fastest, then y, then z, [sx] x [sy] x [sz]. Replaces the shape it had."
  fn body_shape(handle : Int, classes : NativeU8Arr, sx : Int, sy : Int, sz : Int) : Bool do x_body_shape(handle, classes, NativeArray.length_u8(classes), sx, sy, sz) == 1 end
  doc "Where body [handle] is for the rays: its grid's low corner in metres and its rotation."
  fn body_place(handle : Int, px : Float, py : Float, pz : Float, qx : Float, qy : Float, qz : Float, qw : Float) : Unit do x_body_place(handle, px, py, pz, qx, qy, qz, qw) end
  doc "Body [handle]'s voxels for the rays: [metres] across, or 0 for the world's size."
  fn body_voxel(handle : Int, metres : Float) : Unit do x_body_voxel(handle, metres) end
  doc "Give body [handle] the shape body [source] has for the rays, without a copy. [source] must keep its shape while any body shares it."
  fn body_share(handle : Int, source : Int) : Bool do x_body_share(handle, source) == 1 end
  doc "Draw the body part in [slot] from the mesh of the body part in [prototype], at its own pose and voxel size (`slot_pose`, `slot_voxel`): no mesh of its own. The prototype's mesh is then fixed until close; hide it with `chunk_show`. Refused for a prototype with translucent quads."
  fn body_instance(slot : Int, prototype : Int) : Bool do x_body_instance(slot, prototype) == 1 end
  doc "Body [handle] is gone: the rays no longer see it."
  fn body_drop(handle : Int) : Unit do x_body_drop(handle) end
  doc "Where a body part in [slot] is drawn: its low corner in metres and its rotation (a unit quaternion). A slot holding a chunk of the world ignores it."
  fn slot_pose(slot : Int, px : Float, py : Float, pz : Float, qx : Float, qy : Float, qz : Float, qw : Float) : Unit do x_slot_pose(slot, px, py, pz, qx, qy, qz, qw) end
  doc "The voxels of the body part in [slot] are drawn [metres] across, or at the world's size for 0. A slot holding a chunk of the world ignores it."
  fn slot_voxel(slot : Int, metres : Float) : Unit do x_slot_voxel(slot, metres) end
  doc "Begin uploading one piece of rig [rig]'s part [part] (rig ids from Strata.Anim.finish_rig): the 32-cubed piece whose low corner is (ox, oy, oz) in the part's grid. Give its quads with `chunk_part(0, ...)` (Strata.Rig.meshes: a palette index in the texture field) and finish with `chunk_commit`. One mesh is shared by every figure of the rig, drawn at each figure's pose from the animation's draw list; it never writes the light volume. A piece given again replaces the one held; an empty one removes it."
  fn rig_part_begin(rig : Int, part : Int, ox : Int, oy : Int, oz : Int) : Bool do x_rig_part_begin(rig, part, ox, oy, oz) == 1 end
  doc "Rig [rig]'s part [part] turns about (ax, ay, az) of its own grid, in its voxels (Strata.Rig.anchor_at), and its voxels are [voxel] metres: its pieces are drawn at (grid position - anchor) x voxel in the part's frame. Give it before the part is drawn."
  fn rig_part_anchor(rig : Int, part : Int, ax : Float, ay : Float, az : Float, voxel : Float) : Bool do x_rig_part_anchor(rig, part, ax, ay, az, voxel) == 1 end
  doc "Rig [rig]'s palette: 256 x (red, green, blue, roughness, emission), linear colour and each 0..1; entry 0 is empty. Figure quads take their colour, roughness and emission from it on the GPU; the world's light classes are not spent on it."
  fn rig_palette(rig : Int, colours : NativeF32Arr) : Bool do x_rig_palette(rig, colours) == 1 end
  doc "Rig [rig]'s part [part] as the rays see it: one palette index a voxel (0 empty), x fastest, then y, then z, [sx] x [sy] x [sz] (Strata.Rig.grid), its low corner the part grid's. Shared by every figure of the rig: a traced figure (Strata.Anim.traced) adds only a placement per part each frame, and a ray that hits one of its voxels takes colour, roughness and emission from the rig's palette, not a light class. Replaces the shape the part had; false if refused (no room, or a size outside 1..128)."
  fn rig_shape(rig : Int, part : Int, idx : NativeU8Arr, sx : Int, sy : Int, sz : Int) : Bool do x_rig_shape(rig, part, idx, NativeArray.length_u8(idx), sx, sy, sz) == 1 end
  doc "Forget rig [rig] whole: every part's pieces, ray shape and anchor, so a rig uploaded again under the same id (a reopened figure world starts its rig ids at 0) keeps nothing of the last one's. False if there is no renderer."
  fn rig_clear(rig : Int) : Bool do x_rig_clear(rig) == 1 end
  doc "How far between its last two poses each figure is drawn, 0..1 (the fraction of an animation step since the last `Strata.Anim.update`); 1 until set: the last pose."
  fn set_blend(blend : Float) : Unit do x_set_blend(blend) end
  doc "Give one part of the chunk being uploaded: 0 opaque quads, 1 cutout quads, 2 translucent quads, 3 cross and model instances; [n] two-word records (Strata.Quad). The words are copied."
  fn chunk_part(part : Int, words : NativeI32Arr, n : Int) : Bool do x_chunk_part(part, words, n) == 1 end
  doc "Finish the upload. The chunk is replaced whole or not at all: false means the renderer had no room for some part, nothing changed, and the caller should try again later. Never waits for the GPU."
  fn chunk_commit() : Bool do x_chunk_commit() == 1 end
  doc "Say that the translucent part given with `chunk_part(2, ...)` ends in eight ordered lists of its own quads, of these lengths (Strata.Mesh.order_count, octants 0..7): the renderer keeps the lists and draws each where the eye's rays run its way. Without this call, or with every length 0, the part is one list drawn in any order. Between `chunk_begin` and `chunk_commit`."
  fn chunk_orders(a : Int, b : Int, c : Int, d : Int, e : Int, f : Int, g : Int, h : Int) : Bool do x_chunk_orders(a, b, c, d, e, f, g, h) == 1 end
  doc "The light classes of the chunk being uploaded: 32768 bytes by the chunk's flat index, or 1 byte when every voxel has that class. Between `chunk_begin` and `chunk_commit`."
  fn chunk_light(bytes : NativeU8Arr, n : Int) : Bool do x_chunk_light(bytes, n) == 1 end
  doc "Size the light volume for a stream of these radii, in chunks. Call before the first chunk is uploaded: it empties the volume."
  fn set_light_box(radius_h : Int, radius_v : Int) : Bool do x_set_light_box(radius_h, radius_v) == 1 end
  doc "The light classes, 8 words each (Strata.Blocks.light_table)."
  fn light_table_set(words : NativeI32Arr, nclasses : Int) : Bool do x_light_table_set(words, nclasses) == 1 end
  doc "Drop everything a chunk slot holds."
  fn chunk_free(slot : Int) : Unit do x_chunk_free(slot) end

  doc "The view-projection: sixteen floats, column-major, OpenGL clip conventions (the shader converts to Vulkan's)."
  fn set_camera(vp : NativeF32Arr) : Unit do x_set_camera(vp) end
  doc "Direction TO the sun, and its colour: linear, and as bright as wanted (the viewer's noon sun is about 1)."
  fn set_sun(x : Float, y : Float, z : Float, r : Float, g : Float, b : Float) : Unit do x_set_sun(x, y, z, r, g, b) end
  doc "Fog start and end, metres from the eye."
  fn set_fog(start : Float, stop : Float) : Unit do x_set_fog(start, stop, 0.0, 0.0) end
  doc "The eye in metres, and the world's metres per voxel."
  fn set_eye(x : Float, y : Float, z : Float, scale : Float) : Unit do x_set_eye(x, y, z, scale) end
  doc "Start a texture array of [layers] square tiles, [tile_px] pixels on a side (a power of two, 1..256). One layer per texture id. Nothing changes on screen until `textures_commit`."
  fn textures_create(tile_px : Int, layers : Int) : Bool do x_textures_create(tile_px, layers) == 1 end
  doc "Set one layer's pixels: tile_px * tile_px * 4 bytes of RGBA, sRGB colour with straight alpha, rows running downward. False if the layer or the length is wrong."
  fn texture_set(layer : Int, rgba : NativeU8Arr) : Bool do x_texture_set(layer, rgba, NativeArray.length_u8(rgba)) == 1 end
  doc "Build the array with its mip chain and start drawing with it. Slow and rare: it waits for the GPU."
  fn textures_commit() : Bool do x_textures_commit() == 1 end
  doc "Upload the block table: eight words a block id, as `Strata.Blocks.gpu_table` lays them out."
  fn blocks_set(words : NativeI32Arr, nblocks : Int) : Bool do x_blocks_set(words, nblocks) == 1 end

  doc "Give model [index] its drawing geometry: [nquads] quads of 21 floats, as `Strata.Model.floats` lays them out. Chunks uploaded afterwards draw it."
  fn model_set(index : Int, floats : NativeF32Arr, nquads : Int) : Bool do x_model_set(index, floats, nquads) == 1 end

  doc "Draw and present one frame. False when the frame was skipped (minimised, or the swapchain is being rebuilt)."
  fn frame() : Bool do x_frame() == 1 end
  doc "Write the next frame drawn to the PPM file named by STRATA_SHOT (default strata_shot.ppm)."
  fn request_shot() : Unit do x_request_shot() end
  doc "Chunks and quads the culling pass let through, as of two frames ago."
  fn drawn_chunks() : Int do x_drawn_chunks() end
  fn drawn_quads() : Int do x_drawn_quads() end
  doc "How the light pass shades. 0: the shading from before ray tracing."
  -- Mode 8 shades local lamps with distance falloff and without visibility rays.
  fn set_lighting(mode : Int) : Unit do x_set_lighting(mode) end
  doc "Replace the moving lights (light mode 8, or any mode with lamp tracing on) and set whether headlights are lit."
  fn moving_lights_begin(headlights : Bool) : Unit do x_moving_lights_begin(if headlights do 1 else 0 end) end
  doc "Add a headlight in voxel coordinates facing (dx, dz). Answers whether to draw its lit lens."
  fn headlight(x : Float, y : Float, z : Float, dx : Float, dz : Float, cls : Int) : Bool do x_headlight(x, y, z, dx, dz, cls) == 1 end
  doc "Add an omnidirectional beacon in voxel coordinates."
  fn beacon(x : Float, y : Float, z : Float, cls : Int) : Unit do x_beacon(x, y, z, cls) end
  doc "Lamp light gathered by the trace pass, with a memory of its own (short where lamps move). [moving_shadows]: headlights and beacons cast shadows."
  fn set_lamp_tracing(on : Bool, moving_shadows : Bool) : Unit do x_set_lamp_tracing(if on do 1 else 0 end, if moving_shadows do 1 else 0 end) end
  doc "Whether light class [cls]'s standing lamps cast shadows while lamp tracing is on."
  fn set_lamp_shadow(cls : Int, on : Bool) : Unit do x_set_lamp_shadow(cls, if on do 1 else 0 end) end
  doc "Whether light class [cls]'s standing lamps cast shadows now: asked for, and lamp tracing on."
  fn lamp_shadow(cls : Int) : Bool do x_lamp_shadow(cls) == 1 end
  doc "How far a lamp's light reaches, in voxels (8..128; 16 unless set)."
  fn set_lamp_reach(voxels : Int) : Unit do x_set_lamp_reach(voxels) end
  doc "Put effect [index] (1 to 63) in the particles' effect table: 44 floats laid out as native/strata_particles.h says. Effect 0 is spray's and is refused, as is an index past 63 or fewer than 44 floats."
  fn effect_set(index : Int, floats : NativeF32Arr) : Bool do x_effect_set(index, floats) == 1 end

  doc "A burst of [count] particles (at most 512) of effect [effect], born at the time `set_time` last gave. [f18] holds 18 floats: the segment x0 y0 z0 x1 y1 z1 (metres) the starts are spread along, the shape's a b c, the mean velocity vx vy vz (m/s), its spread (a ball's radius), the life (s), its spread (a share, 0..1), the size scale's spread, and two unused. [shape] 0 a point, 1 a sphere of radius a, 2 a box of half sizes a b c. Answers how many were written: 0 for an effect never set."
  fn emit(effect : Int, shape : Int, f18 : NativeF32Arr, count : Int, seed : Int) : Int do x_emit(effect, shape, f18, count, seed) end

  doc "Add [count] spray particles (at most 512 a call) at (x, y, z) metres, flying at about (vx, vy, vz) m/s give or take [spread], living [life] seconds, drawn with texture layer [tex]. Answers how many were added."
  fn spray(x : Float, y : Float, z : Float, vx : Float, vy : Float, vz : Float, count : Int, spread : Float, life : Float, tex : Int) : Int do x_spray(x, y, z, vx, vy, vz, count, spread, life, tex) end
  doc "The eye is under liquid with its surface at [surface_y] metres, of this colour (linear), swallowing light at [density] per metre. A density of 0: the eye is in air."
  fn set_underwater(surface_y : Float, r : Float, g : Float, b : Float, density : Float) : Unit do x_set_underwater(surface_y, r, g, b, density) end
  doc "The weather the frame is drawn in, each 0..1: overcast, how wet surfaces are, a lightning flash, rain. All 0 is clear and dry. Strata.Weather drives it."
  fn set_weather(overcast : Float, wet : Float, flash : Float, rain : Float) : Unit do x_set_weather(overcast, wet, flash, rain) end
  doc "The direction rain falls (any length), and the clock in seconds its streaks and puddle rings run on."
  fn set_rain(x : Float, y : Float, z : Float, clock : Float) : Unit do x_set_rain(x, y, z, clock) end
  doc "Clouds' shadows: [n] blobs (at most 48), four floats each in [blobs]: a centre and a radius in metres. Ground the sun reaches through a blob loses up to [darkness] (0..1) of the sun's light, softly toward the blob's edge. n 0 casts none."
  fn set_cloud_shadows(blobs : NativeF32Arr, n : Int, darkness : Float) : Unit do x_set_cloud_shadows(blobs, n, darkness) end
  doc "The sea state ocean quads (Strata.Quad.ocean1) are drawn in: the wind's direction along x and z (any length), the open sea's wave height in metres, and whitecaps 0..1. Swells run with the wind and grow with the height; breakers roll in hardest on shores facing the wind. A height of 0, the default, is no sea state: the ocean as before."
  fn set_sea(wind_x : Float, wind_z : Float, height : Float, whitecaps : Float) : Unit do x_set_sea(wind_x, wind_z, height, whitecaps) end
  doc "The sea map: [w] x [h] cells (x fastest, at most 16384) of how exposed open water is to the wind, 0..1, its low corner at ([x0], [z0]) metres with [cell]-metre cells. Waves in a cell scale with its exposure; ocean outside the map is fully exposed. False, and nothing changed, for an empty or oversized grid, no cell size, too few values, or before the renderer opens."
  fn set_sea_map(cells : NativeF32Arr, w : Int, h : Int, x0 : Float, z0 : Float, cell : Float) : Bool do x_set_sea_map(cells, w, h, x0, z0, cell) == 1 end
  doc "The time in seconds that moving surface detail runs on."
  fn set_time(seconds : Float) : Unit do x_set_time(seconds) end
  doc "Light quality: sky rays per pixel per sample (0..8), and mirror rays on or off."
  fn set_quality(sky_rays : Int, reflections : Bool) : Unit do x_set_quality(sky_rays, if reflections do 1 else 0 end) end
  doc "Trace the light for one pixel of each scale x scale block, 1..4."
  fn set_trace_scale(scale : Int) : Unit do x_set_trace_scale(scale) end
  doc "The trace scale in use."
  fn trace_scale() : Int do x_trace_scale() end
  doc "Vsync on or off. Off selects the immediate present mode where the surface offers it; otherwise nothing changes."
  fn set_vsync(yes : Bool) : Unit do x_set_vsync(if yes do 1 else 0 end) end
  doc "Start this frame's vehicle footprints; the previous frame's set stays queryable."
  fn footprints_begin() : Unit do x_footprints_begin() end
  doc "Add a vehicle footprint in voxels: centre, heading (dx, dz), length and width."
  fn footprint(slot : Int, x : Float, y : Float, z : Float, dx : Float, dz : Float, length : Float, width : Float) : Unit do
    x_footprint(slot, x, y, z, dx, dz, length, width)
  end
  doc "Whether the segment from (x0, y0, z0) to (x1, y1, z1) crosses a footprint other than slot `ignore`'s."
  fn footprint_blocked(x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float, ignore : Int) : Bool do
    x_footprint_blocked(x0, y0, z0, x1, y1, z1, ignore) == 1
  end
  doc "Copy both footprint frames for `Strata.Ffi.Footprints.blocked`, which a worker thread may query while this thread renders. Freeze only when no worker is still querying the previous copy."
  fn footprints_freeze() : Unit do x_footprints_freeze() end
  doc "How many footprints `footprint_blocked` tests from a set: 0 this frame's, 1 the previous frame's."
  fn footprint_count(set : Int) : Int do x_footprint_count(set) end
  doc "Bounds in voxels that hold every point footprint `index` of a set can block: `which` 0 the least x, 1 the greatest x, 2 the least z, 3 the greatest z. A footprint too large or skewed to bound answers -1e30 or 1e30, bounding everything."
  fn footprint_bound(set : Int, index : Int, which : Int) : Float do x_footprint_bound(set, index, which) end
  doc "A figure for the last frame: 0 milliseconds of CPU work inside `frame`, 1 milliseconds it spent waiting (for the previous frame, the next image, and present), 2 draw calls issued, 3 GPU milliseconds or -1.0 when the driver gives no timestamps, 4 chunks with see-through quads drawn, 5 microseconds spent ordering them. Since the start: 6 swapchain rebuilds, 7 buffer elements lost to a full allocator list (should stay 0). 8 spray particles live, 9 2D quads dropped. Figures, last frame: 10 parts drawn after culling, 11 figure draws, 12 microseconds of CPU preparing them, 13 microseconds of that in the animation's draw list, 14 GPU milliseconds of their shadow map, 15 and 16 its parts and draws, 17 traced figures, 18 their parts, 19 figures past the traced cap. Since the start: 20 the worst of 12, 21 the worst of 14. The light volume: 22 pages in use, 23 chunks that found none, 24 bytes in its pool. Particles: 25 written over a live slot since the start, 33 ring slots the last frame's collision pass was given (0: it did not run), 34 particles born of effects that meet the world since the start. 35 overlay items dropped the last frame (past the overlay's capacity). Churn between the last two frames (what the app did): 36 `chunk_instance` calls, 37 `chunk_motion` calls, 38 `chunk_commit` uploads, 39 chunk-table entries synced (slots changed, each copied to every frame in flight)."
  fn stat(which : Int) : Float do x_stat(which) end
  doc "Hand the 2D layer's quads (16 floats each) to the renderer. Returns how many it took."
  fn ui_set(floats : NativeF32Arr, nquads : Int) : Int do x_ui_set(floats, nquads) end
  doc "The overlay for the frames from now on: [nitems] items of 20 floats (Strata.Overlay.pack); how many were taken."
  fn overlay_set(floats : NativeF32Arr, nitems : Int) : Int do x_overlay_set(floats, nitems) end
  doc "The cutaway for the frames from now on: 36 floats (Strata.Overlay.cut_floats); true when taken."
  fn set_cut(floats : NativeF32Arr) : Bool do x_set_cut(floats) == 1 end
  doc "Replace the interface atlas with [w] x [h] RGBA bytes."
  fn ui_atlas(w : Int, h : Int, rgba : NativeU8Arr) : Bool do x_ui_atlas(w, h, rgba) == 1 end
  doc "The window's width in points."
  fn win_w() : Int do x_win_w() end
  doc "The window's height in points."
  fn win_h() : Int do x_win_h() end
  doc "Uploads refused so far because the quad buffer was full."
  fn refused() : Int do x_refused() end
  doc "Append [n] commands that draw nothing to every indirect call, to measure what the driver charges for them. For benchmarking only."
  fn pad_commands(n : Int) : Unit do x_pad_commands(n) end
  doc "Rebuild the swapchain before the next frame, as a window resize would."
  fn force_rebuild() : Unit do x_force_rebuild() end
  doc "With true, frames render to an offscreen image and are never presented, so the display does not pace them. For timing runs: the window shows nothing new, screenshots still work."
  fn set_offscreen(yes : Bool) : Unit do x_set_offscreen(if yes do 1 else 0 end) end
  doc "Quads held in the GPU buffer."
  fn live_quads() : Int do x_live_quads() end
end
