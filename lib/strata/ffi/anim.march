-- Figures out: thin bindings onto native/strata_anim.c, which wraps the pose
-- kernel in native/strata_anim.h. What a figure does is decided in
-- Strata.Anim; this module only carries its calls across. No C type leaks:
-- arrays cross as NativeI32Arr and NativeF32Arr, the rest as Int and Float.
-- A pose comes back by C filling a caller-owned NativeF32Arr (as
-- Strata.Ffi.Noise's fields do); marks one number a call.
--
-- Every extern is wrapped in an ordinary fn: an extern called qualified from
-- another module typechecks but fails at link time (cube_forge GAPS G5).
-- Extern names carry the `xn_` prefix: names must be unique across the
-- program (GAPS S17).
--
-- A consumer must list native/strata_anim.c in its own forge.toml [ffi]
-- sources; forge does not build a dependency's C (GAPS S11).
mod Strata.Ffi.Anim do

  needs IO.Foreign
  needs Anim

  extern "strata_anim" : Cap(Anim) do
    fn xn_open(capacity: Int): Int = "an_x_open"
    fn xn_close(): Unit = "an_x_close"
    fn xn_rig(n: Int, parent: NativeI32Arr, floats: NativeF32Arr): Int = "an_x_rig"
    fn xn_masks(rig: Int, n: Int, counts: NativeI32Arr, roots: NativeI32Arr): Int = "an_x_masks"
    fn xn_clip(rig: Int, duration: Float, loops: Int, stride: Float, nkeys: Int, key_ints: NativeI32Arr, key_floats: NativeF32Arr, nmarks: Int, mark_t: NativeF32Arr, mark_tag: NativeI32Arr): Int = "an_x_clip"
    fn xn_spawn(rig: Int, x: Float, y: Float, z: Float, qx: Float, qy: Float, qz: Float, qw: Float): Int = "an_x_spawn"
    fn xn_remove(fig: Int): Unit = "an_x_remove"
    fn xn_place(fig: Int, x: Float, y: Float, z: Float, qx: Float, qy: Float, qz: Float, qw: Float): Unit = "an_x_place"
    fn xn_play(fig: Int, layer: Int, clip: Int, fade: Float, rate: Float, weight: Float, mask: Int, additive: Int): Unit = "an_x_play"
    fn xn_blend(fig: Int, layer: Int, n: Int, clips: NativeI32Arr, positions: NativeF32Arr, value: Float, fade: Float, weight: Float, mask: Int): Unit = "an_x_blend"
    fn xn_set(fig: Int, layer: Int, what: Int, v: Float, fade: Float): Unit = "an_x_set"
    fn xn_update(dt: Float): Unit = "an_x_update"
    fn xn_parts(fig: Int): Int = "an_x_parts"
    fn xn_matrices(fig: Int, out: NativeF32Arr): Int = "an_x_matrices"
    fn xn_override(fig: Int, part: Int, qx: Float, qy: Float, qz: Float, qw: Float, x: Float, y: Float, z: Float, weight: Float): Unit = "an_x_override"
    fn xn_aim(fig: Int, slot: Int, n: Int, chain: NativeI32Arr, ax: Float, ay: Float, az: Float, tx: Float, ty: Float, tz: Float, limit: Float, weight: Float): Unit = "an_x_aim"
    fn xn_reach(fig: Int, slot: Int, upper: Int, lower: Int, end_part: Int, tx: Float, ty: Float, tz: Float, px: Float, py: Float, pz: Float, weight: Float, fade: Float): Unit = "an_x_reach"
    fn xn_reach_fade(fig: Int, slot: Int, weight: Float, fade: Float): Unit = "an_x_reach_fade"
    fn xn_spring(fig: Int, part: Int, stiffness: Float, damping: Float): Unit = "an_x_spring"
    fn xn_drop(fig: Int, metres: Float): Unit = "an_x_drop"
    fn xn_drop_to(fig: Int, metres: Float, speed: Float): Unit = "an_x_drop_to"
    fn xn_origin(fig: Int, part: Int, stage: Int, out: NativeF32Arr): Int = "an_x_origin"
    fn xn_fig_rig(fig: Int): Int = "an_x_fig_rig"
    fn xn_facing(fig: Int, out: NativeF32Arr): Int = "an_x_facing"
    fn xn_socket_def(rig: Int, part: Int, x: Float, y: Float, z: Float, qx: Float, qy: Float, qz: Float, qw: Float): Int = "an_x_socket_def"
    fn xn_shape(rig: Int, part: Int, sx: Int, sy: Int, sz: Int, voxel: Float, pal: NativeU8Arr): Int = "an_x_shape"
    fn xn_attach(child: Int, parent: Int, socket: Int, x: Float, y: Float, z: Float, qx: Float, qy: Float, qz: Float, qw: Float): Int = "an_x_attach"
    fn xn_detach(child: Int): Unit = "an_x_detach"
    fn xn_socket(fig: Int, socket: Int, out: NativeF32Arr): Int = "an_x_socket"
    fn xn_hit_ray(ox: Float, oy: Float, oz: Float, dx: Float, dy: Float, dz: Float, max: Float, ignore: Int, ints: NativeI32Arr, floats: NativeF32Arr): Int = "an_x_hit_ray"
    fn xn_hit_box(cx: Float, cy: Float, cz: Float, hx: Float, hy: Float, hz: Float, qx: Float, qy: Float, qz: Float, qw: Float, ignore: Int, out: NativeI32Arr): Int = "an_x_hit_box"
    fn xn_mark_count(): Int = "an_x_mark_count"
    fn xn_mark_int(i: Int, k: Int): Int = "an_x_mark_int"
    fn xn_mark_weight(i: Int): Float = "an_x_mark_weight"
    fn xn_hash(): Int = "an_x_hash"
    fn xn_stat(which: Int): Float = "an_x_stat"
  end

  doc "Open the world for up to [capacity] figures (1..4096), closing any open one. False if it could not be made."
  fn open(capacity : Int) : Bool do xn_open(capacity) == 1 end
  doc "Free the world. Every later call does nothing (and answers 0 or -1)."
  fn close() : Unit do xn_close() end
  doc "Upload a rig of [n] parts: [parent] one a part, [floats] 13 a part (pivot xyz in metres in the parent's space, rest rotation xyzw, box min xyz and max xyz in metres in the part's space). Its id, or -1 (refused: stat 5 says why)."
  fn rig(n : Int, parent : NativeI32Arr, floats : NativeF32Arr) : Int do xn_rig(n, parent, floats) end
  doc "Upload rig [rig]'s [n] masks at once: [counts] roots each, [roots] one after another. Answers how many were made."
  fn masks(rig : Int, n : Int, counts : NativeI32Arr, roots : NativeI32Arr) : Int do xn_masks(rig, n, counts, roots) end
  doc "Upload a clip: [nkeys] keys (ints: part, channel 0 turn or 1 move, interpolation; floats: time, x, y, z, w) and [nmarks] marks. Its id, or -1."
  fn clip(rig : Int, duration : Float, loops : Bool, stride : Float, nkeys : Int, key_ints : NativeI32Arr, key_floats : NativeF32Arr, nmarks : Int, mark_t : NativeF32Arr, mark_tag : NativeI32Arr) : Int do
    xn_clip(rig, duration, if loops do 1 else 0 end, stride, nkeys, key_ints, key_floats, nmarks, mark_t, mark_tag)
  end
  doc "A new figure of rig [rig] at (x, y, z) turned by (qx, qy, qz, qw), in its rest pose. Its id, or -1."
  fn spawn_at(rig : Int, x : Float, y : Float, z : Float, qx : Float, qy : Float, qz : Float, qw : Float) : Int do xn_spawn(rig, x, y, z, qx, qy, qz, qw) end
  fn remove(fig : Int) : Unit do xn_remove(fig) end
  fn place(fig : Int, x : Float, y : Float, z : Float, qx : Float, qy : Float, qz : Float, qw : Float) : Unit do xn_place(fig, x, y, z, qx, qy, qz, qw) end
  doc "Play [clip] on [layer]: [mask] is the rig's mask number, -1 for every part."
  fn play(fig : Int, layer : Int, clip : Int, fade : Float, rate : Float, weight : Float, mask : Int, additive : Bool) : Unit do
    xn_play(fig, layer, clip, fade, rate, weight, mask, if additive do 1 else 0 end)
  end
  fn blend(fig : Int, layer : Int, n : Int, clips : NativeI32Arr, positions : NativeF32Arr, value : Float, fade : Float, weight : Float, mask : Int) : Unit do
    xn_blend(fig, layer, n, clips, positions, value, fade, weight, mask)
  end
  doc "Change a layer: [what] 0 rate, 1 weight, 2 time, 3 blend value, 4 paused (v 1)."
  fn set(fig : Int, layer : Int, what : Int, v : Float, fade : Float) : Unit do xn_set(fig, layer, what, v, fade) end
  doc "Advance every figure by [dt] seconds and pose it."
  fn update(dt : Float) : Unit do xn_update(dt) end
  doc "How many parts figure [fig] has; 0 if there is no such figure."
  fn parts(fig : Int) : Int do xn_parts(fig) end
  doc "Copy figure [fig]'s matrices (12 floats a part, a column-major 3x4 in world space) into the caller-owned [out], which must hold 12 x parts floats. Answers the parts copied: 0 if there is no such figure or [out] is too short."
  fn matrices(fig : Int, out : NativeF32Arr) : Int do xn_matrices(fig, out) end
  doc "Pull part [part]'s local rotation toward (qx, qy, qz, qw) and its move toward (x, y, z) metres by [weight] 0..1; weight 0 clears."
  fn override(fig : Int, part : Int, qx : Float, qy : Float, qz : Float, qw : Float, x : Float, y : Float, z : Float, weight : Float) : Unit do xn_override(fig, part, qx, qy, qz, qw, x, y, z, weight) end
  doc "Aim slot [slot] (0..3): the last of the [n] parts in [chain] turns its axis (ax, ay, az) toward the world point (tx, ty, tz), shared along the chain, each part at most [limit] degrees; weight 0 clears."
  fn aim(fig : Int, slot : Int, n : Int, chain : NativeI32Arr, ax : Float, ay : Float, az : Float, tx : Float, ty : Float, tz : Float, limit : Float, weight : Float) : Unit do xn_aim(fig, slot, n, chain, ax, ay, az, tx, ty, tz, limit, weight) end
  doc "Reach slot [slot] (0..7): the chain (upper, lower, end) puts its end at (tx, ty, tz), bending toward (px, py, pz); its weight moves to [weight] over [fade] seconds (0 at once)."
  fn reach(fig : Int, slot : Int, upper : Int, lower : Int, end_part : Int, tx : Float, ty : Float, tz : Float, px : Float, py : Float, pz : Float, weight : Float, fade : Float) : Unit do xn_reach(fig, slot, upper, lower, end_part, tx, ty, tz, px, py, pz, weight, fade) end
  doc "Move reach slot [slot]'s weight to [weight] over [fade] seconds, keeping its target; nothing if the slot is empty."
  fn reach_fade(fig : Int, slot : Int, weight : Float, fade : Float) : Unit do xn_reach_fade(fig, slot, weight, fade) end
  doc "Make part [part] springy; stiffness 0 clears."
  fn spring(fig : Int, part : Int, stiffness : Float, damping : Float) : Unit do xn_spring(fig, part, stiffness, damping) end
  doc "Lower figure [fig]'s root by [metres] after the layers."
  fn drop(fig : Int, metres : Float) : Unit do xn_drop(fig, metres) end
  doc "Move figure [fig]'s drop toward [metres] at [speed] metres a second through the updates (0: at once)."
  fn drop_to(fig : Int, metres : Float, speed : Float) : Unit do xn_drop_to(fig, metres, speed) end
  doc "Part [part]'s world origin into [out] (3 floats): stage 0 the animated pose, 1 before the springs. 1, or 0 if none."
  fn origin(fig : Int, part : Int, stage : Int, out : NativeF32Arr) : Int do xn_origin(fig, part, stage, out) end
  doc "Figure [fig]'s rig id; -1 if there is no such figure."
  fn fig_rig(fig : Int) : Int do xn_fig_rig(fig) end
  doc "Figure [fig]'s placement rotation (xyzw) into [out] (4 floats). 1, or 0 if none."
  fn facing(fig : Int, out : NativeF32Arr) : Int do xn_facing(fig, out) end
  doc "A socket on rig [rig]'s part [part] at (x, y, z) metres in the part's frame (from its anchor), turned by (qx, qy, qz, qw). Its number within the rig (0, 1, ...), or -1."
  fn socket_def(rig : Int, part : Int, x : Float, y : Float, z : Float, qx : Float, qy : Float, qz : Float, qw : Float) : Int do xn_socket_def(rig, part, x, y, z, qx, qy, qz, qw) end
  doc "Rig [rig]'s part [part]'s grid for hit tests: (sx, sy, sz) voxels of [voxel] metres, palette indices at x + sx (y + sy z). It must fill the part's box. Its number, or -1."
  fn shape(rig : Int, part : Int, sx : Int, sy : Int, sz : Int, voxel : Float, pal : NativeU8Arr) : Int do xn_shape(rig, part, sx, sy, sz, voxel, pal) end
  doc "Hang figure [child] from figure [parent]'s socket [socket], placed at (x, y, z) turned by (qx, qy, qz, qw) in the socket's frame. True, or false if refused (no such figure or socket, a cycle, or deeper than four)."
  fn attach(child : Int, parent : Int, socket : Int, x : Float, y : Float, z : Float, qx : Float, qy : Float, qz : Float, qw : Float) : Bool do xn_attach(child, parent, socket, x, y, z, qx, qy, qz, qw) == 1 end
  fn detach(child : Int) : Unit do xn_detach(child) end
  doc "Socket [socket] of figure [fig] in world space into [out] (7 floats: x, y, z, qx, qy, qz, qw), from the pose before springs, a stale figure posed first. 1, or 0 if none."
  fn socket(fig : Int, socket : Int, out : NativeF32Arr) : Int do xn_socket(fig, socket, out) end
  doc "The nearest voxel along a ray: 1 and [ints] (figure, part, x, y, z, colour) and [floats] (distance, normal x, y, z), or 0 for a miss."
  fn hit_ray(ox : Float, oy : Float, oz : Float, dx : Float, dy : Float, dz : Float, max : Float, ignore : Int, ints : NativeI32Arr, floats : NativeF32Arr) : Int do xn_hit_ray(ox, oy, oz, dx, dy, dz, max, ignore, ints, floats) end
  doc "The (figure, part) pairs whose part boxes a turned box overlaps, two ints a pair into [out] as far as it holds; answers how many there are."
  fn hit_box(cx : Float, cy : Float, cz : Float, hx : Float, hy : Float, hz : Float, qx : Float, qy : Float, qz : Float, qw : Float, ignore : Int, out : NativeI32Arr) : Int do xn_hit_box(cx, cy, cz, hx, hy, hz, qx, qy, qz, qw, ignore, out) end
  doc "How many marks the last update reported."
  fn mark_count() : Int do xn_mark_count() end
  doc "Of mark [i]: [k] 0 its figure, 1 its layer, 2 its tag."
  fn mark_int(i : Int, k : Int) : Int do xn_mark_int(i, k) end
  fn mark_weight(i : Int) : Float do xn_mark_weight(i) end
  doc "A hash of every live figure's pose (62 bits)."
  fn hash() : Int do xn_hash() end
  doc "0 figures, 1 posed, 2 stale, 3 refused calls, 4 negative dt, 5 the last refusal's reason, 6 marks dropped, 7 procedural records in use."
  fn stat(which : Int) : Float do xn_stat(which) end
end
