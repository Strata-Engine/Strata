-- Text: thin bindings onto native/strata_text.c. No font or glyph type
-- crosses: a font is an Int handle, a string crosses as itself (GAPS S16),
-- everything else is numbers and native arrays.
--
-- A consumer lists native/strata_text.c in its forge.toml [ffi] sources and
-- links FreeType, beside the shim.
mod Strata.Ffi.Text do

  needs IO.Foreign
  needs Window

  extern "strata_text" : Cap(Window) do
    fn x_utf8_count(s: String): Int = "stm_utf8_count"
    fn x_byte_count(s: String): Int = "stm_byte_count"
    fn x_font_default(): Int = "stm_font_default"
    fn x_font_load(path: String, face: Int): Int = "stm_font_load"
    fn x_font_set_fallbacks(font: Int, handles: NativeI32Arr, n: Int): Int = "stm_font_set_fallbacks"
    fn x_text(quads: NativeF32Arr, at: Int, font: Int, s: String, params: NativeF32Arr): Int = "stm_text"
    fn x_measure(font: Int, s: String, params: NativeF32Arr, out: NativeF32Arr): Int = "stm_measure"
    fn x_stat(which: Int): Float = "stm_stat"
    fn x_set_raster_budget(us: Int): Unit = "stm_set_raster_budget"
  end

  doc "Code points in a string, or -1 if it is not valid UTF-8."
  fn utf8_count(s : String) : Int do x_utf8_count(s) end
  doc "Bytes in a string, as C sees it."
  fn byte_count(s : String) : Int do x_byte_count(s) end
  fn font_default() : Int do x_font_default() end
  fn font_load(path : String, face : Int) : Int do x_font_load(path, face) end
  fn font_set_fallbacks(font : Int, handles : NativeI32Arr, n : Int) : Bool do x_font_set_fallbacks(font, handles, n) == 1 end
  doc "Write a text's quads into [quads] from quad [at] on; returns how many."
  fn text(quads : NativeF32Arr, at : Int, font : Int, s : String, params : NativeF32Arr) : Int do x_text(quads, at, font, s, params) end
  fn measure(font : Int, s : String, params : NativeF32Arr, out : NativeF32Arr) : Bool do x_measure(font, s, params, out) == 1 end
  fn stat(which : Int) : Float do x_stat(which) end
  fn set_raster_budget(us : Int) : Unit do x_set_raster_budget(us) end
end
