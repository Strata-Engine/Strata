-- The frozen vehicle footprints: `Strata.Ffi.Vk.footprints_freeze` copies the live sets on the
-- main thread, and `blocked` answers `Vk.footprint_blocked`'s question against that copy. It
-- reads no renderer state and never calls into Vulkan, so a simulation step on a worker task
-- may use it while the main thread draws.
--
-- Every extern is wrapped in an ordinary fn: an extern called qualified from
-- another module typechecks but fails at link time (cube_forge GAPS G5).
mod Strata.Ffi.Footprints do

  needs IO.Foreign

  extern "strata_vk" : Cap(IO.Foreign) do
    fn x_frozen_footprint_blocked(x0: Float, y0: Float, z0: Float, x1: Float, y1: Float, z1: Float, ignore: Int): Int = "sv_frozen_footprint_blocked"
  end

  doc "Whether the segment from (x0, y0, z0) to (x1, y1, z1) crossed a frozen footprint other than slot `ignore`'s."
  fn blocked(x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float, ignore : Int) : Bool do
    x_frozen_footprint_blocked(x0, y0, z0, x1, y1, z1, ignore) == 1
  end
end
