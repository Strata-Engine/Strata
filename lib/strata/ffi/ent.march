-- Entities out: thin bindings onto native/strata_ent.c, which wraps the
-- entity kernel in native/strata_ent.h. What a game's entities do is decided
-- in Strata.Entities; this module only carries its calls across. No C type
-- leaks: arrays cross as NativeI32Arr, NativeF32Arr, NativeU8Arr,
-- NativeIntArr and NativeFloatArr, the rest as Int and Float. Ids and whole columns come back by C filling a
-- caller-owned array (as Strata.Ffi.Anim's matrices do); a read of three
-- numbers comes back one number a call.
--
-- Every extern is wrapped in an ordinary fn: an extern called qualified from
-- another module typechecks but fails at link time (cube_forge GAPS G5).
-- Extern names carry the `xe_` prefix: names must be unique across the
-- program (GAPS S17).
--
-- A consumer must list native/strata_ent.c in its own forge.toml [ffi]
-- sources; forge does not build a dependency's C (GAPS S11).
mod Strata.Ffi.Ent do

  needs IO.Foreign
  needs Ent

  extern "strata_ent" : Cap(Ent) do
    fn xe_open(capacity: Int, route_points: Int, bodies: Int, seen_cap: Float, chunk_metres: Float, voxel_metres: Float): Int = "en_x_open"
    fn xe_close(): Unit = "en_x_close"
    fn xe_kind(ints: NativeI32Arr, floats: NativeF32Arr): Int = "en_x_kind"
    fn xe_add(kind: Int, x: Float, y: Float, z: Float, facing: Float): Int = "en_x_add"
    fn xe_remove(id: Int): Unit = "en_x_remove"
    fn xe_alive(id: Int): Int = "en_x_alive"
    fn xe_kind_of(id: Int): Int = "en_x_kind_of"
    fn xe_get(id: Int, which: Int, k: Int): Float = "en_x_get"
    fn xe_set(id: Int, which: Int, x: Float, y: Float, z: Float): Unit = "en_x_set"
    fn xe_float(id: Int, n: Int): Float = "en_x_float"
    fn xe_set_float(id: Int, n: Int, v: Float): Unit = "en_x_set_float"
    fn xe_int(id: Int, n: Int): Int = "en_x_int"
    fn xe_set_int(id: Int, n: Int, v: Int): Unit = "en_x_set_int"
    fn xe_count(kind: Int): Int = "en_x_count"
    fn xe_each(kind: Int, out: NativeIntArr): Int = "en_x_each"
    fn xe_column_width(kind: Int, col: Int): Int = "en_x_column_width"
    fn xe_column(kind: Int, col: Int, out: NativeF32Arr): Int = "en_x_column"
    fn xe_set_column(kind: Int, col: Int, data: NativeF32Arr): Unit = "en_x_set_column"
    fn xe_hash(): Int = "en_x_hash"
    fn xe_stat(which: Int): Float = "en_x_stat"
    fn xe_block_table(collides: NativeU8Arr): Int = "en_x_block_table"
    fn xe_chunk(cx: Int, cy: Int, cz: Int, ids: NativeI32Arr): Int = "en_x_chunk"
    fn xe_chunk_uniform(cx: Int, cy: Int, cz: Int, id: Int): Int = "en_x_chunk_uniform"
    fn xe_chunk_drop(cx: Int, cy: Int, cz: Int): Int = "en_x_chunk_drop"
    fn xe_solid(vx: Int, vy: Int, vz: Int): Int = "en_x_solid"
    fn xe_ray(ox: Float, oy: Float, oz: Float, dx: Float, dy: Float, dz: Float, max: Float, out: NativeI32Arr): Float = "en_x_ray"
    fn xe_tick(focus: NativeFloatArr, dt: Float): Int = "en_x_tick"
    fn xe_event_count(): Int = "en_x_event_count"
    fn xe_events(ints: NativeIntArr, floats: NativeFloatArr): Int = "en_x_events"
    fn xe_touching(kind_a: Int, kind_b: Int): Int = "en_x_touching"
    fn xe_near(x: Float, y: Float, z: Float, radius: Float, mask: Int, out: NativeIntArr): Int = "en_x_near"
    fn xe_ray_entities(ox: Float, oy: Float, oz: Float, dx: Float, dy: Float, dz: Float, max: Float, mask: Int, out: NativeFloatArr): Int = "en_x_ray_entities"
    fn xe_clock(): Float = "en_x_clock"
    fn xe_sweep(px: Float, py: Float, pz: Float, hx: Float, hy: Float, hz: Float, dx: Float, dy: Float, dz: Float, out: NativeFloatArr): Int = "en_x_sweep"
    fn xe_route(points: NativeFloatArr): Int = "en_x_route"
    fn xe_route_free(route: Int): Int = "en_x_route_free"
    fn xe_follow(id: Int, route: Int, speed: Float, loops: Int): Int = "en_x_follow"
    fn xe_grounded(id: Int): Int = "en_x_grounded"
    fn xe_seen(id: Int): Int = "en_x_seen"
    fn xe_part(id: Int, part: Int): Int = "en_x_part"
    fn xe_set_part(id: Int, part: Int, v: Int): Int = "en_x_set_part"
    fn xe_figure_refused(kind: Int): Int = "en_x_figure_refused"
    fn xe_release_count(): Int = "en_x_release_count"
    fn xe_releases(codes: NativeI32Arr, ids: NativeIntArr): Int = "en_x_releases"
    fn xe_seen_parts(part: Int, ids: NativeI32Arr, poses: NativeF32Arr): Int = "en_x_seen_parts"
    fn xe_wanting(part: Int, ids: NativeIntArr): Int = "en_x_wanting"
  end

  doc "Open the world (closing any open one): [capacity] rows (1..1,048,576), [route_points], a body budget of [bodies], the seen cap and chunk and voxel sizes in metres. False if it could not be made."
  fn open(capacity : Int, route_points : Int, bodies : Int, seen_cap : Float, chunk_metres : Float, voxel_metres : Float) : Bool do
    xe_open(capacity, route_points, bodies, seen_cap, chunk_metres, voxel_metres) == 1
  end
  doc "Free the world. Every later call does nothing (and answers its default)."
  fn close() : Unit do xe_close() end
  doc "Register a kind: [ints] 9 (mover, unseen rule, divisor, float slots, int slots, gravity 0/1, figure 0/1, body 0/1, voices), [floats] 7 (half extents xyz, step height, lifetime, seen distance, gravity m/s2). Its index, or -1 (refused: stat 6 says why)."
  fn kind(ints : NativeI32Arr, floats : NativeF32Arr) : Int do xe_kind(ints, floats) end
  doc "A new entity of [kind] at (x, y, z) metres facing [facing] radians. Its id, or -1."
  fn add(kind : Int, x : Float, y : Float, z : Float, facing : Float) : Int do xe_add(kind, x, y, z, facing) end
  fn remove(id : Int) : Unit do xe_remove(id) end
  fn alive(id : Int) : Bool do xe_alive(id) == 1 end
  doc "The kind of entity [id]; -1 if it is not alive."
  fn kind_of(id : Int) : Int do xe_kind_of(id) end
  doc "Of entity [id]: [which] 0 position, 1 velocity, 2 facing, 3 age; component [k] (0 for facing and age). 0 for a dead id."
  fn get(id : Int, which : Int, k : Int) : Float do xe_get(id, which, k) end
  doc "Set [which] 0 position or 1 velocity to (x, y, z), or 2 facing to x. The age cannot be set."
  fn set(id : Int, which : Int, x : Float, y : Float, z : Float) : Unit do xe_set(id, which, x, y, z) end
  fn float(id : Int, n : Int) : Float do xe_float(id, n) end
  fn set_float(id : Int, n : Int, v : Float) : Unit do xe_set_float(id, n, v) end
  fn int(id : Int, n : Int) : Int do xe_int(id, n) end
  fn set_int(id : Int, n : Int, v : Int) : Unit do xe_set_int(id, n, v) end
  doc "How many entities of [kind] are live; 0 for no such kind."
  fn count(kind : Int) : Int do xe_count(kind) end
  doc "Copy [kind]'s live ids, in dense order, into the caller-owned [out]. Answers how many were written."
  fn each(kind : Int, out : NativeIntArr) : Int do xe_each(kind, out) end
  doc "Floats a row of column [col] of [kind]: 3 for position and velocity, 1 for facing and a float slot, 0 for none."
  fn column_width(kind : Int, col : Int) : Int do xe_column_width(kind, col) end
  doc "Copy column [col] of [kind], in each's order, into the caller-owned [out]. Answers the rows written."
  fn column(kind : Int, col : Int, out : NativeF32Arr) : Int do xe_column(kind, col, out) end
  doc "Write column [col] of [kind] from [data]: exactly the kind's live count of rows, every value finite, or nothing is written."
  fn set_column(kind : Int, col : Int, data : NativeF32Arr) : Unit do xe_set_column(kind, col, data) end
  doc "A hash of every live entity (62 bits)."
  fn hash() : Int do xe_hash() end
  doc "0 live, 1 seen, 2 waiting for ground, 3 refused calls, 4 negative dt, 5 events and releases dropped, 6 the last refusal's reason, 7 over the body budget, 8 route points held, 9 routes held, 10 + k figures not made for kind k."
  fn stat(which : Int) : Float do xe_stat(which) end

  doc "Which block ids stop an entity: a byte an id, nonzero where it stops as its whole cell; ids past the array pass. Send it before the chunks. Answers how many ids were taken (0 if refused)."
  fn block_table(collides : NativeU8Arr) : Int do xe_block_table(collides) end
  doc "Hold chunk (cx, cy, cz) from its 32,768 block ids in Strata.Coord.index order. 1 if held, 0 if refused."
  fn chunk(cx : Int, cy : Int, cz : Int, ids : NativeI32Arr) : Int do xe_chunk(cx, cy, cz, ids) end
  doc "Hold chunk (cx, cy, cz) as all block [id]. 1 if held, 0 if refused."
  fn chunk_uniform(cx : Int, cy : Int, cz : Int, id : Int) : Int do xe_chunk_uniform(cx, cy, cz, id) end
  doc "Stop holding chunk (cx, cy, cz). Answers 1."
  fn chunk_drop(cx : Int, cy : Int, cz : Int) : Int do xe_chunk_drop(cx, cy, cz) end
  doc "World voxel (vx, vy, vz) in the kernel's copy: 1 solid, 0 clear, -1 no chunk held there."
  fn solid(vx : Int, vy : Int, vz : Int) : Int do xe_solid(vx, vy, vz) end
  doc "The kernel's ray from (ox, oy, oz) along (dx, dy, dz) for at most [max] metres: the distance to the first solid voxel, its voxel and face (Strata.Query's numbering) written to [out] (4 Ints); -1.0 a miss, -2.0 the ray left the held chunks first."
  fn ray(ox : Float, oy : Float, oz : Float, dx : Float, dy : Float, dz : Float, max : Float, out : NativeI32Arr) : Float do xe_ray(ox, oy, oz, dx, dy, dz, max, out) end
  doc "One kernel tick of [dt] seconds with the focus points [focus] (3 Floats each, metres). Answers the events it wrote."
  fn tick(focus : NativeFloatArr, dt : Float) : Int do xe_tick(focus, dt) end
  doc "How many events the last tick wrote."
  fn event_count() : Int do xe_event_count() end
  doc "Copy the last tick's events into [ints] (7 each: code, a, b, i0, i1, i2, i3) and [floats] (3 each: x, y, z). Answers how many were copied."
  fn events(ints : NativeIntArr, floats : NativeFloatArr) : Int do xe_events(ints, floats) end

  doc "Ask for touch events between [kind_a] and [kind_b] from the next tick on. 1 if taken, 0 if refused (no such kind)."
  fn touching(kind_a : Int, kind_b : Int) : Int do xe_touching(kind_a, kind_b) end
  doc "The ids within [radius] metres of (x, y, z) whose kind's bit is set in [mask], from the last tick's grid, sorted by id, written to [out]: answers how many were written, or with an empty [out] how many there are."
  fn near(x : Float, y : Float, z : Float, radius : Float, mask : Int, out : NativeIntArr) : Int do xe_near(x, y, z, radius, mask, out) end
  doc "The nearest entity whose box (in the last tick's grid) the ray from (ox, oy, oz) along (dx, dy, dz) meets within [max] metres, of a kind in [mask]: its id, the distance written to [out] (1 Float); -1 for none."
  fn ray_entities(ox : Float, oy : Float, oz : Float, dx : Float, dy : Float, dz : Float, max : Float, mask : Int, out : NativeFloatArr) : Int do xe_ray_entities(ox, oy, oz, dx, dy, dz, max, mask, out) end
  doc "A monotonic clock in seconds, for timing scenes. The kernel never reads it: its time is the dt it is given."
  fn clock() : Float do xe_clock() end

  doc "The kernel's sweep: the box centred at (px, py, pz) with half extents (hx, hy, hz) moved by (dx, dy, dz), all metres, one axis at a time (y, x, z) against the kernel's blocks, as Strata.Query.sweep does. [out] (6 Floats) gets the end x, y, z and 1.0 or 0.0 for each axis blocked (x, y, z). Answers 0, or -1 if a voxel on the way is in a chunk not held (or a number is refused), and then nothing moved."
  fn sweep(px : Float, py : Float, pz : Float, hx : Float, hy : Float, hz : Float, dx : Float, dy : Float, dz : Float, out : NativeFloatArr) : Int do xe_sweep(px, py, pz, hx, hy, hz, dx, dy, dz, out) end
  doc "A route of the points in [points] (3 Floats each, metres; 1 to 256 points), copied into the kernel's pool. Its id, or -1 (refused: stat 6 says why)."
  fn route(points : NativeFloatArr) : Int do xe_route(points) end
  doc "Free [route], at once or once its last follower stops. Answers 1."
  fn route_free(route : Int) : Int do xe_route_free(route) end
  doc "Entity [id] follows [route] (-1: stops following) at [speed] m/s, looping if [loops] is 1. Answers 1."
  fn follow(id : Int, route : Int, speed : Float, loops : Int) : Int do xe_follow(id, route, speed, loops) end
  doc "1 if walker [id] stood on something after its last seen step, else 0."
  fn grounded(id : Int) : Int do xe_grounded(id) end
  doc "1 if entity [id] was seen at the end of the last tick, else 0."
  fn seen(id : Int) : Int do xe_seen(id) end

  doc "Part [part] (0 figure, 1 body, 2 voice 0, 3 voice 1) of entity [id]: the id the game gave it, or -1."
  fn part(id : Int, part : Int) : Int do xe_part(id, part) end
  doc "Give entity [id] part [part] as [v] (-1 for none); refused for a part its kind lacks. Answers 1."
  fn set_part(id : Int, part : Int, v : Int) : Int do xe_set_part(id, part, v) end
  doc "Count a figure the game could not make for an entity of [kind] (stat 10 + kind). Answers 1."
  fn figure_refused(kind : Int) : Int do xe_figure_refused(kind) end
  doc "How many (part, id) pairs wait on the release list: parts cleared from entities removed or gone out of view."
  fn release_count() : Int do xe_release_count() end
  doc "Drain the release list into [codes] (the part: 0 figure, 1 body, 2 and 3 voices) and [ids] (the id it held), as many as both hold. Answers how many were taken off."
  fn releases(codes : NativeI32Arr, ids : NativeIntArr) : Int do xe_releases(codes, ids) end
  doc "The seen entities holding [part], kind by kind in dense order: the part ids into [ids], the poses into [poses] (7 Floats each: x, y, z, then the facing as a turn about +y, x, y, z, w). Answers how many were written, or with an empty [ids] how many there are."
  fn seen_parts(part : Int, ids : NativeI32Arr, poses : NativeF32Arr) : Int do xe_seen_parts(part, ids, poses) end
  doc "The seen entities whose kind has [part] and that hold none, nearest a focus of the last tick first (horizontally), ties by id, into [ids]. Answers how many were written, or with an empty [ids] how many there are."
  fn wanting(part : Int, ids : NativeIntArr) : Int do xe_wanting(part, ids) end
end
