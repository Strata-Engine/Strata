-- Sound out: thin bindings onto native/strata_audio.c, which owns the
-- device, its thread and the per-sample loop. What is heard is decided in
-- Strata.Sound; this module only carries its records across. No device type
-- leaks: records cross as a NativeI32Arr and a NativeF32Arr, the rest as Int,
-- Float and String.
--
-- Every extern is wrapped in an ordinary fn: an extern called qualified from
-- another module typechecks but fails at link time (cube_forge GAPS G5).
--
-- A consumer must list native/strata_audio.c in its own forge.toml [ffi]
-- sources; forge does not build a dependency's C (GAPS S11).
mod Strata.Ffi.Audio do

  needs IO.Foreign
  needs Audio

  extern "strata_audio" : Cap(Audio) do
    fn xa_open(headphones: Int): Int = "sa_open"
    fn xa_open_null(): Int = "sa_open_null"
    fn xa_render_open(path: String): Int = "sa_render_open"
    fn xa_close(): Unit = "sa_close"
    fn xa_send(ints: NativeI32Arr, floats: NativeF32Arr, n: Int): Int = "sa_send"
    fn xa_advance(seconds: Float): Unit = "sa_advance"
    fn xa_stat(which: Int): Float = "sa_stat"
  end

  doc "Open the sound device, for headphones (3D for two ears) or speakers. False when there is none or it fails; the game then runs silent and every later call does nothing but count."
  fn open(headphones : Bool) : Bool do xa_open(if headphones do 1 else 0 end) == 1 end
  doc "Open miniaudio's null device: paced like a real one, silent. For soak runs."
  fn open_null() : Bool do xa_open_null() == 1 end
  doc "Render in game time to the WAV at [path], with no device: each `advance` mixes exactly that many seconds. For scripted runs and the audio goldens."
  fn render(path : String) : Bool do xa_render_open(path) == 1 end
  doc "Close the device, or finish the WAV."
  fn close() : Unit do xa_close() end
  doc "Hand the frame's records to the mixer. Never waits; answers how many it took (a full ring refuses the rest, and stat 3 counts them)."
  fn send(c : Strata.Sound.Commands) : Int do xa_send(Strata.Sound.cmd_ints(c), Strata.Sound.cmd_floats(c), Strata.Sound.cmd_count(c)) end
  doc "In game time, mix [seconds] more; otherwise nothing."
  fn advance(seconds : Float) : Unit do xa_advance(seconds) end
  doc "A figure: 0 voices playing, 1 virtual, 2 plays refused by the mixer, 3 records refused before reaching it, 4 underruns, 5 the mixing thread's share of a core, 6 peak dB and 7 RMS dB of the last block, 10 milliseconds from the last play's send to the device's buffer, 11 bytes the mixer holds."
  fn stat(which : Int) : Float do xa_stat(which) end
end
