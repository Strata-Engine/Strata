-- Noise fields: thin bindings onto native/strata_noise.c (FastNoiseLite). A
-- field call fills a caller-owned NativeF32Arr and returns how many cells it
-- wrote, 0 when the array is too small. Strata.Noise is the public face.
--
-- Every extern is wrapped in an ordinary fn: an extern called qualified from
-- another module typechecks but fails at link time (cube_forge GAPS G5).
--
-- A consumer must list native/strata_noise.c in its own forge.toml [ffi]
-- sources, with -ffp-contract=off; forge does not build a dependency's C.
mod Strata.Ffi.Noise do

  needs IO.Foreign

  extern "strata_noise" : Cap(IO.Foreign) do
    fn x_field2(kind: Int, octaves: Int, lac: Float, gain: Float, fractal: Int, warp: Float, seed: Int, freq: Float, x0: Float, z0: Float, step: Float, w: Int, d: Int, out: NativeF32Arr): Int = "sn_field2"
    fn x_field3(kind: Int, octaves: Int, lac: Float, gain: Float, fractal: Int, warp: Float, seed: Int, freq: Float, x0: Float, y0: Float, z0: Float, sx: Float, sy: Float, sz: Float, w: Int, h: Int, d: Int, out: NativeF32Arr): Int = "sn_field3"
    fn x_sample2(kind: Int, octaves: Int, lac: Float, gain: Float, fractal: Int, warp: Float, seed: Int, freq: Float, x: Float, z: Float): Float = "sn_sample2"
    fn x_lattice_fill(samples: NativeF32Arr, out: NativeF32Arr): Int = "sl_fill"
    fn x_sample3(kind: Int, octaves: Int, lac: Float, gain: Float, fractal: Int, warp: Float, seed: Int, freq: Float, x: Float, y: Float, z: Float): Float = "sn_sample3"
  end

  fn field2(kind : Int, octaves : Int, lac : Float, gain : Float, fractal : Int, warp : Float, seed : Int, freq : Float, x0 : Float, z0 : Float, step : Float, w : Int, d : Int, out : NativeF32Arr) : Int do
    x_field2(kind, octaves, lac, gain, fractal, warp, seed, freq, x0, z0, step, w, d, out)
  end

  fn field3(kind : Int, octaves : Int, lac : Float, gain : Float, fractal : Int, warp : Float, seed : Int, freq : Float, x0 : Float, y0 : Float, z0 : Float, sx : Float, sy : Float, sz : Float, w : Int, h : Int, d : Int, out : NativeF32Arr) : Int do
    x_field3(kind, octaves, lac, gain, fractal, warp, seed, freq, x0, y0, z0, sx, sy, sz, w, h, d, out)
  end

  fn sample2(kind : Int, octaves : Int, lac : Float, gain : Float, fractal : Int, warp : Float, seed : Int, freq : Float, x : Float, z : Float) : Float do
    x_sample2(kind, octaves, lac, gain, fractal, warp, seed, freq, x, z)
  end

  fn lattice_fill(samples : NativeF32Arr, out : NativeF32Arr) : Int do x_lattice_fill(samples, out) end

  fn sample3(kind : Int, octaves : Int, lac : Float, gain : Float, fractal : Int, warp : Float, seed : Int, freq : Float, x : Float, y : Float, z : Float) : Float do
    x_sample3(kind, octaves, lac, gain, fractal, warp, seed, freq, x, y, z)
  end
end
