-- MagicaVoxel .vox files: thin bindings onto native/strata_vox.cpp
-- (ogt_vox). The file's scene graph is flattened in C into one grid of
-- palette indices, Y up. Strata.Template.from_vox is the public face.
--
-- Every extern is wrapped in an ordinary fn: an extern called qualified from
-- another module typechecks but fails at link time (cube_forge GAPS G5).
--
-- A consumer must list native/strata_vox.cpp in its own forge.toml [ffi]
-- sources, with -fno-exceptions among the link flags; forge does not build a
-- dependency's C.
mod Strata.Ffi.Vox do

  needs IO.Foreign

  extern "strata_vox" : Cap(IO.Foreign) do
    fn x_vox_size(bytes: NativeU8Arr, n: Int): Int = "sv_vox_size"
    fn x_vox_fill(bytes: NativeU8Arr, n: Int, out: NativeU8Arr, cap: Int): Int = "sv_vox_fill"
  end

  doc "The flattened scene's size in the first n bytes of a .vox file, packed sx | sy << 10 | sz << 20 (Y up); 0 when the bytes are not a .vox, the scene is empty or a side passes 1023."
  fn vox_size(bytes : NativeU8Arr, n : Int) : Int do x_vox_size(bytes, n) end

  doc "Fill out with the flattened scene, one palette index per voxel at x + sx * (y + sy * z) (0 empty); returns sx * sy * sz, or 0 (writing nothing) when the file is bad or cap is short of the volume or past out's length."
  fn vox_fill(bytes : NativeU8Arr, n : Int, out : NativeU8Arr, cap : Int) : Int do x_vox_fill(bytes, n, out, cap) end
end
