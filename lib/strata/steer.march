-- Steer: which way a mover should head, over the ground.
--
-- Small pure functions of positions in the horizontal plane (x, z), in
-- metres. Each answers a direction, unit or zero, or a push no longer than
-- one; a game weighs and adds them (`blend`) and multiplies by its mover's
-- speed. Nothing here reads the world: where a mover may go is Strata.Nav's
-- business, and the point to head for is usually the next corner of a path.
mod Strata.Steer do

  pfn len(x : Float, z : Float) : Float do Math.sqrt(x *. x +. z *. z) end

  doc "The unit direction from (x, z) to (tx, tz); zero when they are within a centimetre."
  fn seek(x : Float, z : Float, tx : Float, tz : Float) : (Float, Float) do
    let d = len(tx -. x, tz -. z)
    if d < 0.01 do (0.0, 0.0) else ((tx -. x) /. d, (tz -. z) /. d) end
  end

  doc "The unit direction from (tx, tz) to (x, z): straight away from it; zero when they are within a centimetre."
  fn flee(x : Float, z : Float, tx : Float, tz : Float) : (Float, Float) do
    match seek(x, z, tx, tz) do (ux, uz) -> (0.0 -. ux, 0.0 -. uz) end
  end

  doc "`seek`, with the share of full speed to go at: 1 farther than [slow] metres from the point, falling evenly to 0 at [stop] metres from it, and 0 nearer. A mover that arrives does not overshoot and turn back."
  fn arrive(x : Float, z : Float, tx : Float, tz : Float, stop : Float, slow : Float) : (Float, Float, Float) do
    let d = len(tx -. x, tz -. z)
    match seek(x, z, tx, tz) do
      (ux, uz) ->
        if d <= stop do (ux, uz, 0.0)
        else if d >= slow || slow <= stop do (ux, uz, 1.0)
        else (ux, uz, (d -. stop) /. (slow -. stop)) end end
    end
  end

  doc "Which way to move to hold a distance from (tx, tz): 1 (toward it) when farther than [far] metres, -1 (away) when nearer than [near], 0 between."
  fn range(x : Float, z : Float, tx : Float, tz : Float, near : Float, far : Float) : Int do
    let d = len(tx -. x, tz -. z)
    if d > far do 1 else if d < near do -1 else 0 end end
  end

  pfn apart_go(x : Float, z : Float, others : List((Float, Float)), radius : Float, ax : Float, az : Float) : (Float, Float) do
    match others do
      Nil -> (ax, az)
      Cons((ox, oz), rest) ->
        let d = len(x -. ox, z -. oz)
        -- one standing on the very spot pushes no way: there is no direction to take
        if d >= radius || d < 0.0001 do apart_go(x, z, rest, radius, ax, az)
        else
          let push = (radius -. d) /. radius
          apart_go(x, z, rest, radius, ax +. (x -. ox) /. d *. push, az +. (z -. oz) /. d *. push)
        end
    end
  end

  doc "The push that keeps a mover at (x, z) apart from [others]: each one nearer than [radius] metres pushes straight away from itself, harder the nearer (nothing at the radius, 1 at no distance), and the pushes are added; the sum is cut to length 1. A mover's own place may be among the others: it pushes no way."
  fn apart(x : Float, z : Float, others : List((Float, Float)), radius : Float) : (Float, Float) do
    if radius <= 0.0 do (0.0, 0.0)
    else
      match apart_go(x, z, others, radius, 0.0, 0.0) do
        (ax, az) ->
          let l = len(ax, az)
          if l > 1.0 do (ax /. l, az /. l) else (ax, az) end
      end
    end
  end

  doc "The unit direction of a times [wa] plus b times [wb]; zero when they cancel."
  fn blend(ax : Float, az : Float, wa : Float, bx : Float, bz : Float, wb : Float) : (Float, Float) do
    let x = ax *. wa +. bx *. wb
    let z = az *. wa +. bz *. wb
    let l = len(x, z)
    if l < 0.0001 do (0.0, 0.0) else (x /. l, z /. l) end
  end

  pfn wrap(a : Float) : Float do
    let pi = 3.14159265358979
    if a > pi do wrap(a -. 2.0 *. pi) else if a < 0.0 -. pi do wrap(a +. 2.0 *. pi) else a end end
  end

  doc "The facing a mover turns to this frame: from [facing] toward [wanted] (radians about the vertical) by the shorter way, by at most [step] radians. The answer is within pi of zero."
  fn turn(facing : Float, wanted : Float, step : Float) : Float do
    let d = wrap(wanted -. facing)
    if d > step do wrap(facing +. step) else if d < 0.0 -. step do wrap(facing -. step) else wrap(wanted) end end
  end
end
