-- Blocks — the block registry a game builds once and the engine reads.
--
-- Constructor patterns do not resolve reliably outside their own module
-- (cube_forge GAPS G24/G25), so every sum type here has an `_index` reader
-- and other modules match on the number.
--
-- A registry is flat native arrays indexed by block id, so the hot paths
-- (meshing, collision, ray casting) answer with one read and never call back
-- into game code. Id 0 is air and is always registered. Every lookup is
-- total: an id that is negative, unregistered or past sixteen bits answers
-- with air's values.
--
-- A block STATE is its own id. `register_family` registers a run of
-- contiguous ids that share a definition (a fluid's levels, a log's
-- orientations) and `base_of` / `state_of` / `with_state` map between them.
mod Strata.Blocks do

  type Opacity = Clear | Solid | SeeThrough
  type Layer = Opaque | Cutout | Translucent
  type Style = Cube | Cross | Model(Int) | NoMesh
  -- A collision box inside one cell: min x, y, z then max x, y, z, in 0..1.
  type Box = Box(Float, Float, Float, Float, Float, Float)

  doc "A box's bounds as (min x, min y, min z, max x, max y, max z)."
  fn box_bounds(b : Box) : (Float, Float, Float, Float, Float, Float) do
    match b do Box(x0, y0, z0, x1, y1, z1) -> (x0, y0, z0, x1, y1, z1) end
  end

  -- flags, model index, emission, material, six face textures
  -- flags, model, emission, material, six face textures, and the physics
  -- values (Phys: density kg/m3, strength N s/m2, span cm, piece cm, anchor)
  type Phys = Phys(Int, Int, Int, Int, Bool)
  type Def = Def(Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Phys)

  -- The flags byte: bit 0 collides; bits 1-2 opacity (0 empty, 1 solid,
  -- 2 see-through); bits 3-4 layer (0 opaque, 1 cutout, 2 translucent);
  -- bits 5-6 style (0 cube, 1 cross, 2 model, 3 no mesh).
  pfn air_flags() : Int do 96 end
  pfn stride() : Int do 16 end
  doc "The most block ids a registry holds: ids are sixteen bits."
  fn max_ids() : Int do 65536 end

  pfn clamp8(v : Int) : Int do if v < 0 do 0 else if v > 255 do 255 else v end end end
  pfn clamp16(v : Int) : Int do if v < 0 do 0 else if v > 65535 do 65535 else v end end end

  doc "A collidable, solid, opaque cube with texture 0 on every face, fully rough and giving no light."
  fn def() : Def do Def(3, 0, 0, 255, 0, 0, 0, 0, 0, 0, Phys(2000, 50000, 400, 50, false)) end

  pfn d_flags(d : Def) : Int do match d do Def(f, _, _, _, _, _, _, _, _, _, _) -> f end end
  pfn set_flags(d : Def, f : Int) : Def do match d do Def(_, m, e, mt, t0, t1, t2, t3, t4, t5, ph) -> Def(f, m, e, mt, t0, t1, t2, t3, t4, t5, ph) end end
  pfn put_bits(flags : Int, shift : Int, mask : Int, v : Int) : Int do
    flags - int_and(flags, mask * shift) + v * shift
  end

  fn with_collide(d : Def, yes : Bool) : Def do set_flags(d, put_bits(d_flags(d), 1, 1, if yes do 1 else 0 end)) end

  fn with_opacity(d : Def, o : Opacity) : Def do
    let v = match o do
      Clear -> 0
      Solid -> 1
      SeeThrough -> 2
    end
    set_flags(d, put_bits(d_flags(d), 2, 3, v))
  end

  fn with_layer(d : Def, l : Layer) : Def do
    let v = match l do
      Opaque -> 0
      Cutout -> 1
      Translucent -> 2
    end
    set_flags(d, put_bits(d_flags(d), 8, 3, v))
  end

  fn with_style(d : Def, s : Style) : Def do
    match s do
      Cube -> set_flags(d, put_bits(d_flags(d), 32, 3, 0))
      Cross -> set_flags(d, put_bits(d_flags(d), 32, 3, 1))
      NoMesh -> set_flags(d, put_bits(d_flags(d), 32, 3, 3))
      Model(k) ->
        match set_flags(d, put_bits(d_flags(d), 32, 3, 2)) do
          Def(f, _, e, mt, t0, t1, t2, t3, t4, t5, ph) -> Def(f, if k < 0 do 0 else k end, e, mt, t0, t1, t2, t3, t4, t5, ph)
        end
    end
  end

  doc "Texture ids for the top face, the bottom face and the four sides."
  fn with_faces(d : Def, top : Int, bottom : Int, side : Int) : Def do
    match d do
      Def(f, m, e, mt, _, _, _, _, _, _, ph) -> Def(f, m, e, mt, clamp16(top), clamp16(bottom), clamp16(side), clamp16(side), clamp16(side), clamp16(side), ph)
    end
  end

  doc "Texture id for one face (0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z). Another face number changes nothing."
  fn with_face(d : Def, face : Int, tex : Int) : Def do
    let t = clamp16(tex)
    match d do
      Def(f, m, e, mt, t0, t1, t2, t3, t4, t5, ph) ->
        if face == 0 do Def(f, m, e, mt, t, t1, t2, t3, t4, t5, ph)
        else if face == 1 do Def(f, m, e, mt, t0, t, t2, t3, t4, t5, ph)
        else if face == 2 do Def(f, m, e, mt, t0, t1, t, t3, t4, t5, ph)
        else if face == 3 do Def(f, m, e, mt, t0, t1, t2, t, t4, t5, ph)
        else if face == 4 do Def(f, m, e, mt, t0, t1, t2, t3, t, t5, ph)
        else if face == 5 do Def(f, m, e, mt, t0, t1, t2, t3, t4, t, ph)
        else d end end end end end end
    end
  end

  doc "Emitted light: colour and strength, each 0..255."
  fn with_emission(d : Def, r : Int, g : Int, b : Int, strength : Int) : Def do
    let em = clamp8(r) + 256 * clamp8(g) + 65536 * clamp8(b) + 16777216 * clamp8(strength)
    match d do
      Def(f, m, _, mt, t0, t1, t2, t3, t4, t5, ph) -> Def(f, m, em, mt, t0, t1, t2, t3, t4, t5, ph)
    end
  end

  doc "Surface values the lighting reads: roughness and emissive, each 0..255."
  fn with_material(d : Def, roughness : Int, emissive : Int) : Def do
    match d do
      Def(f, m, e, mt, t0, t1, t2, t3, t4, t5, ph) -> Def(f, m, e, clamp8(roughness) + 256 * clamp8(emissive) + (mt - int_and(mt, 65535)), t0, t1, t2, t3, t4, t5, ph)
    end
  end

  -- The material word: bits 0-7 roughness, 8-15 emissive (the light's), then
  -- the sound's: 16-23 absorption, 24-31 loss, 32-39 damping, bit 40 set.
  pfn sound_set() : Int do 1099511627776 end

  doc "How the block treats sound, each 0..255: [absorption], how much of a reflection off it is soaked up (0 rings like stone, 255 deadens like wool); [loss], the decibels a metre of it cuts from sound passing through; [damping], how much more it cuts the highs than the lows. Optional: a block that sets nothing takes a default from its opacity (see `sound_of`)."
  fn with_sound(d : Def, absorption : Int, loss : Int, damping : Int) : Def do
    match d do
      Def(f, m, e, mt, t0, t1, t2, t3, t4, t5, ph) ->
        Def(f, m, e, int_and(mt, 65535) + 65536 * clamp8(absorption) + 16777216 * clamp8(loss) + 4294967296 * clamp8(damping) + sound_set(), t0, t1, t2, t3, t4, t5, ph)
    end
  end

  doc "Physics values: density in kg per cubic metre, the impact strength as normal impulse per square metre of contact (N s/m2), how far in centimetres the block reaches sideways from support, the size in centimetres of the pieces it breaks into, and whether it holds up anything joined to it. Negative values count as 0."
  fn with_physics(d : Def, density : Int, strength : Int, span_cm : Int, piece_cm : Int, anchor : Bool) : Def do
    let nn = fn v -> if v < 0 do 0 else v end
    match d do
      Def(f, m, e, mt, t0, t1, t2, t3, t4, t5, _) -> Def(f, m, e, mt, t0, t1, t2, t3, t4, t5, Phys(nn(density), nn(strength), nn(span_cm), nn(piece_cm), anchor))
    end
  end

  -- A model: quads for drawing (passed through untouched) and boxes for
  -- collision and ray casting.
  type ModelDef = ModelDef(NativeF32Arr, List(Box))

  -- count, capacity, flags (one byte per id), ints (stride() per id: model,
  -- emission, material, family base, family size, six face textures),
  -- models (newest first), model count
  -- What the blocks are to a ray of light: each block's class (one byte per
  -- id, same capacity as the flags), the class table (8 words a class, 256
  -- rows: kind, top texture, side texture, emission, roughness, 3 spare),
  -- classes in use, and blocks that had to share the last class.
  type Light = Light(NativeU8Arr, NativeIntArr, Int, Int)

  type Registry = Registry(Int, Int, NativeU8Arr, NativeIntArr, List(ModelDef), Int, Light)

  doc "A registry holding only air, as id 0."
  fn empty() : Registry do
    let cap = 64
    let flags = NativeArray.set_u8(NativeArray.make_u8(Strata.Size.of(cap), air_flags()), 0, air_flags())
    let ints = NativeArray.set_int(NativeArray.make_int(Strata.Size.of(cap * stride()), 0), 4, 1)
    Registry(1, cap, flags, ints, Nil, 0, Light(NativeArray.make_u8(Strata.Size.of(cap), 0), NativeArray.make_int(Strata.Size.of(8 * 256), 0), 1, 0))
  end

  doc "How many ids are registered, air included."
  fn count(r : Registry) : Int do match r do Registry(n, _, _, _, _, _, _) -> n end end

  pfn copy_u8(dst : NativeU8Arr, src : NativeU8Arr, i : Int, n : Int) : NativeU8Arr do
    if i >= n do dst else copy_u8(NativeArray.set_u8(dst, i, NativeArray.get_u8(src, i)), src, i + 1, n) end
  end
  pfn copy_int(dst : NativeIntArr, src : NativeIntArr, i : Int, n : Int) : NativeIntArr do
    if i >= n do dst else copy_int(NativeArray.set_int(dst, i, NativeArray.get_int(src, i)), src, i + 1, n) end
  end

  pfn grown(r : Registry, need : Int) : Registry do
    match r do
      Registry(n, cap, flags, ints, ms, mc, lt) ->
        if need <= cap do r
        else
          let cap2 = if cap * 2 >= need do cap * 2 else need end
          let f2 = copy_u8(NativeArray.make_u8(Strata.Size.of(cap2), air_flags()), flags, 0, n)
          let i2 = copy_int(NativeArray.make_int(Strata.Size.of(cap2 * stride()), 0), ints, 0, n * stride())
          match lt do
            Light(cls, table, lc, lo) -> Registry(n, cap2, f2, i2, ms, mc, Light(copy_u8(NativeArray.make_u8(Strata.Size.of(cap2), 0), cls, 0, n), table, lc, lo))
          end
        end
    end
  end

  -- ── Light classes ────────────────────────────────────────────────────────
  -- What kind of thing a block is to a ray, from its flags byte: 0 empty
  -- (air, crosses, anything with no mesh, a clear cube), 1 a solid cube,
  -- 2 a see-through cube on the cutout layer (its texture decides where it
  -- blocks), 3 any other see-through cube, 4 a model (thin: never blocks).
  pfn light_kind(flags : Int) : Int do
    let opac = int_and(flags / 2, 3)
    let lay = int_and(flags / 8, 3)
    let sty = int_and(flags / 32, 3)
    if sty == 2 do 4
    else if sty != 0 do 0
    else if opac == 1 do 1
    else if opac == 2 do (if lay == 1 do 2 else 3 end)
    else 0 end end end end
  end

  -- The class among 1 .. n - 1 whose row is exactly these five values, or -1.
  pfn class_find(table : NativeIntArr, n : Int, kind : Int, top : Int, side : Int, em : Int, rough : Int, c : Int) : Int do
    if c >= n do -1
    else
      let o = 8 * c
      if NativeArray.get_int(table, o) == kind && NativeArray.get_int(table, o + 1) == top && NativeArray.get_int(table, o + 2) == side && NativeArray.get_int(table, o + 3) == em && NativeArray.get_int(table, o + 4) == rough do c
      else class_find(table, n, kind, top, side, em, rough, c + 1) end
    end
  end

  -- With every class taken: the class of the same kind that is closest to
  -- these values (the same emission first, then the nearest roughness), so
  -- a block that must share never turns into a lamp, a mirror or a wall.
  -- With no class of its kind at all, the last.
  pfn class_near(table : NativeIntArr, n : Int, kind : Int, em : Int, rough : Int, c : Int, best : Int, cost : Int) : Int do
    if c >= n do best
    else
      let o = 8 * c
      let dr = NativeArray.get_int(table, o + 4) - rough
      let here = if NativeArray.get_int(table, o) != kind do 2000000
        else (if NativeArray.get_int(table, o + 3) == em do 0 else 1000 end) + (if dr < 0 do 0 - dr else dr end) end
      if here < cost do class_near(table, n, kind, em, rough, c + 1, c, here) else class_near(table, n, kind, em, rough, c + 1, best, cost) end
    end
  end

  -- Give block [id] its class: an existing one it agrees with, else a new
  -- one, else (all 255 taken) the nearest of its kind, counting the overflow.
  pfn classed(lt : Light, id : Int, flags : Int, top : Int, side : Int, em : Int, rough : Int) : Light do
    let kind = light_kind(flags)
    match lt do
      Light(cls, table, n, over) ->
        if kind == 0 do Light(NativeArray.set_u8(cls, id, 0), table, n, over)
        else
          let have = class_find(table, n, kind, top, side, em, rough, 1)
          if have > 0 do Light(NativeArray.set_u8(cls, id, have), table, n, over)
          else if n >= 256 do Light(NativeArray.set_u8(cls, id, class_near(table, n, kind, em, rough, 1, 255, 1000000)), table, n, over + 1)
          else
            let o = 8 * n
            let t = NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(table, o, kind), o + 1, top), o + 2, side), o + 3, em), o + 4, rough)
            Light(NativeArray.set_u8(cls, id, n), t, n + 1, over)
          end end
        end
    end
  end

  pfn put_def(r : Registry, d : Def, base : Int, size : Int) : Registry do
    match r do
      Registry(n, cap, flags, ints, ms, mc, lt) ->
        match d do
          Def(f, m, e, mt, t0, t1, t2, t3, t4, t5, ph) ->
            let o = n * stride()
            let i0 = NativeArray.set_int(ints, o, m)
            let i1 = NativeArray.set_int(i0, o + 1, e)
            let i2 = NativeArray.set_int(i1, o + 2, mt)
            let i3 = NativeArray.set_int(i2, o + 3, base)
            let i4 = NativeArray.set_int(i3, o + 4, size)
            let i5 = NativeArray.set_int(i4, o + 5, t0)
            let i6 = NativeArray.set_int(i5, o + 6, t1)
            let i7 = NativeArray.set_int(i6, o + 7, t2)
            let i8 = NativeArray.set_int(i7, o + 8, t3)
            let i9 = NativeArray.set_int(i8, o + 9, t4)
            let i10 = NativeArray.set_int(i9, o + 10, t5)
            let i15 = match ph do
              Phys(dens, str, span, piece, anc) ->
                NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(i10, o + 11, dens), o + 12, str), o + 13, span), o + 14, piece), o + 15, if anc do 1 else 0 end)
            end
            Registry(n + 1, cap, NativeArray.set_u8(flags, n, f), i15, ms, mc, classed(lt, n, f, t0, t2, e, int_and(mt, 255)))
        end
    end
  end

  pfn put_family(r : Registry, d : Def, base : Int, size : Int, k : Int) : Registry do
    if k >= size do r else put_family(put_def(r, d, base, size), d, base, size, k + 1) end
  end

  doc "Register [states] contiguous ids sharing [d]; the result carries the first (base) id."
  fn register_family(r : Registry, d : Def, states : Int) : Result((Registry, Int), String) do
    let base = count(r)
    if states < 1 do Err("a block family needs at least one state")
    else if base + states > max_ids() do Err("the registry is full: block ids are sixteen bits")
    else Ok((put_family(grown(r, base + states), d, base, states, 0), base)) end end
  end

  pfn mark_fluid(r : Registry, id : Int, last : Int) : Registry do
    if id > last do r
    else
      match r do
        Registry(n, cap, flags, ints, ms, mc, lt) -> mark_fluid(Registry(n, cap, NativeArray.set_u8(flags, id, int_or(NativeArray.get_u8(flags, id), 128)), ints, ms, mc, lt), id + 1, last)
      end
    end
  end

  doc "Register a fluid: eight contiguous ids sharing [d], one per fill level. The base id holds one eighth of a voxel, base + 7 a full one."
  fn register_fluid(r : Registry, d : Def) : Result((Registry, Int), String) do
    match register_family(r, d, 8) do
      Ok((r2, base)) -> Ok((mark_fluid(r2, base, base + 7), base))
      Err(e) -> Err(e)
    end
  end

  doc "Register one block; the result carries its id."
  fn register(r : Registry, d : Def) : Result((Registry, Int), String) do register_family(r, d, 1) end

  @[no_alloc]
  pfn flags_of(r : Registry, id : Int) : Int do
    match r do
      Registry(n, _, flags, _, _, _, _) -> if id < 0 || id >= n do air_flags() else NativeArray.get_u8(flags, id) end
    end
  end

  -- Field [k] of id's int row, or [default] for an id nobody registered.
  pfn int_of(r : Registry, id : Int, k : Int, default : Int) : Int do
    match r do
      Registry(n, _, _, ints, _, _, _) -> if id < 0 || id >= n do default else NativeArray.get_int(ints, id * stride() + k) end
    end
  end

  doc "Does the block stop a moving body?"
  fn collides(r : Registry, id : Int) : Bool do int_and(flags_of(r, id), 1) == 1 end

  doc "Density in kg per cubic metre; 0 for a block that does not collide (it is never part of a body's mass)."
  fn density(r : Registry, id : Int) : Int do if collides(r, id) do int_of(r, id, 11, 0) else 0 end end
  doc "The impact, in joules per square metre of contact, the block survives."
  fn strength(r : Registry, id : Int) : Int do int_of(r, id, 12, 50000) end
  doc "How far, in centimetres, the block reaches sideways from support."
  fn span_cm(r : Registry, id : Int) : Int do int_of(r, id, 13, 400) end
  doc "The typical size, in centimetres, of the pieces the block breaks into."
  fn piece_cm(r : Registry, id : Int) : Int do int_of(r, id, 14, 50) end
  doc "Does the block hold up anything joined to it?"
  fn anchors(r : Registry, id : Int) : Bool do int_of(r, id, 15, 0) == 1 end

  pfn max_span_go(r : Registry, id : Int, n : Int, best : Int) : Int do
    if id >= n do best
    else
      let s = if collides(r, id) do span_cm(r, id) else 0 end
      max_span_go(r, id + 1, n, if s > best do s else best end)
    end
  end
  doc "The largest span, in centimetres, of any registered block that collides."
  fn max_span_cm(r : Registry) : Int do max_span_go(r, 0, count(r), 0) end

  fn opacity(r : Registry, id : Int) : Opacity do
    let v = int_and(flags_of(r, id) / 2, 3)
    if v == 1 do Solid else if v == 2 do SeeThrough else Clear end end
  end

  doc "The opacity as a number: 0 clear, 1 solid, 2 see-through."
  fn opacity_index(r : Registry, id : Int) : Int do
    let v = int_and(flags_of(r, id) / 2, 3)
    if v > 2 do 0 else v end
  end

  doc "Is the block solid and opaque: does it hide the faces behind it and occlude light? The hot-path form of `opacity`."
  fn is_solid_opaque(r : Registry, id : Int) : Bool do int_and(flags_of(r, id) / 2, 3) == 1 end

  fn layer(r : Registry, id : Int) : Layer do
    let v = int_and(flags_of(r, id) / 8, 3)
    if v == 1 do Cutout else if v == 2 do Translucent else Opaque end end
  end

  doc "A layer's number: 0 opaque, 1 cutout, 2 translucent."
  fn layer_number(l : Layer) : Int do
    match l do
      Opaque -> 0
      Cutout -> 1
      Translucent -> 2
    end
  end

  doc "The layer as a number: 0 opaque, 1 cutout, 2 translucent."
  fn layer_index(r : Registry, id : Int) : Int do
    let v = int_and(flags_of(r, id) / 8, 3)
    if v > 2 do 0 else v end
  end

  fn style(r : Registry, id : Int) : Style do
    let v = int_and(flags_of(r, id) / 32, 3)
    if v == 0 do Cube else if v == 1 do Cross else if v == 2 do Model(int_of(r, id, 0, 0)) else NoMesh end end end
  end

  doc "The style as a number: 0 cube, 1 cross, 2 model, 3 no mesh."
  fn style_index(r : Registry, id : Int) : Int do int_and(flags_of(r, id) / 32, 3) end

  doc "What the mesher needs of a block in one read: bit 0 solid-opaque, bits 1-2 the style index, bits 3-4 the layer index, bit 5 a fluid."
  @[no_alloc]
  fn mesh_kind(r : Registry, id : Int) : Int do
    let f = flags_of(r, id)
    let l = int_and(f / 8, 3)
    (if int_and(f / 2, 3) == 1 do 1 else 0 end) + 2 * int_and(f / 32, 3) + 8 * (if l > 2 do 0 else l end) + (if f >= 128 do 32 else 0 end)
  end

  doc "Is the id a state of a fluid family?"
  @[no_alloc]
  fn is_fluid(r : Registry, id : Int) : Bool do int_and(flags_of(r, id), 128) == 128 end

  doc "The base id of the fluid family [id] is a state of, or -1."
  fn fluid_base(r : Registry, id : Int) : Int do if is_fluid(r, id) do int_of(r, id, 3, 0) else -1 end end

  doc "How full the block is, in eighths of a voxel: 1..8 for a fluid state, 8 for any other block, 0 for air and for ids nobody registered."
  fn fill(r : Registry, id : Int) : Int do
    if id <= 0 || id >= count(r) do 0
    else if is_fluid(r, id) do id - int_of(r, id, 3, 0) + 1
    else 8 end end
  end

  doc "The model index of a Model block, 0 otherwise."
  fn model_of(r : Registry, id : Int) : Int do int_of(r, id, 0, 0) end

  doc "Texture id of one face (0..5); 0 for a face that does not exist."
  fn face_tex(r : Registry, id : Int, face : Int) : Int do
    if face < 0 || face > 5 do 0 else int_of(r, id, 5 + face, 0) end
  end

  doc "Emitted light packed as r | g<<8 | b<<16 | strength<<24."
  fn emission(r : Registry, id : Int) : Int do int_of(r, id, 1, 0) end
  fn roughness(r : Registry, id : Int) : Int do int_and(int_of(r, id, 2, 0), 255) end
  doc "What a block is to sound: (absorption, loss in dB a metre, damping), each 0..255. Values set with `with_sound`, or by opacity: empty (0, 0, 0); solid (20, 25, 200); see-through (60, 4, 80); a fluid (40, 10, 220). An id nobody registered is air."
  fn sound_of(r : Registry, id : Int) : (Int, Int, Int) do
    let mt = int_of(r, id, 2, 0)
    if int_and(mt, sound_set()) != 0 do (int_and(mt / 65536, 255), int_and(mt / 16777216, 255), int_and(mt / 4294967296, 255))
    else if id <= 0 || id >= count(r) do (0, 0, 0)
    else if is_fluid(r, id) do (40, 10, 220)
    else if opacity_index(r, id) == 1 do (20, 25, 200)
    else if opacity_index(r, id) == 2 do (60, 4, 80)
    else (0, 0, 0) end end end end end
  end
  fn emissive(r : Registry, id : Int) : Int do int_and(int_of(r, id, 2, 0) / 256, 255) end

  pfn gpu_go(t : NativeI32Arr, r : Registry, id : Int, n : Int) : NativeI32Arr do
    if id >= n do t
    else
      let o = 8 * id
      let t0 = NativeArray.set_i32(t, o, face_tex(r, id, 0))
      let t1 = NativeArray.set_i32(t0, o + 1, face_tex(r, id, 1))
      let t2 = NativeArray.set_i32(t1, o + 2, face_tex(r, id, 2))
      let t3 = NativeArray.set_i32(t2, o + 3, face_tex(r, id, 3))
      let t4 = NativeArray.set_i32(t3, o + 4, face_tex(r, id, 4))
      let t5 = NativeArray.set_i32(t4, o + 5, face_tex(r, id, 5))
      let t6 = NativeArray.set_i32(t5, o + 6, flags_of(r, id) + 256 * light_class(r, id))
      gpu_go(NativeArray.set_i32(t6, o + 7, emission(r, id)), r, id + 1, n)
    end
  end

  doc "The block's light class, 0..255: what it is to a ray. 0 is empty: air, an id nobody registered, a cross, anything without a mesh. Blocks agreeing on kind, top and side texture, emission and roughness share a class."
  @[no_alloc]
  fn light_class(r : Registry, id : Int) : Int do
    match r do
      Registry(n, _, _, _, _, _, Light(cls, _, _, _)) -> if id < 0 || id >= n do 0 else NativeArray.get_u8(cls, id) end
    end
  end

  doc "How many light classes are in use, the empty class 0 included; at most 256."
  fn light_class_count(r : Registry) : Int do match r do Registry(_, _, _, _, _, _, Light(_, _, n, _)) -> n end end

  doc "How many blocks could not have a class of their own and share class 255. 0 unless a game has more than 255 kinds of block as far as light can tell."
  fn light_overflow(r : Registry) : Int do match r do Registry(_, _, _, _, _, _, Light(_, _, _, over)) -> over end end

  pfn light_go(t : NativeI32Arr, table : NativeIntArr, i : Int, n : Int) : NativeI32Arr do
    if i >= n do t else light_go(NativeArray.set_i32(t, i, NativeArray.get_int(table, i)), table, i + 1, n) end
  end

  doc "The light classes as the renderer reads them: eight 32-bit words a class. Word 0 is the kind (0 empty, 1 solid, 2 cutout, 3 see-through, 4 thin), 1 the top texture, 2 the side texture, 3 the emission as `emission` packs it, 4 the roughness 0..255; the rest are spare."
  fn light_table(r : Registry) : NativeI32Arr do
    match r do
      Registry(_, _, _, _, _, _, Light(_, table, n, _)) -> light_go(NativeArray.make_i32(Strata.Size.of(8 * n), 0), table, 0, 8 * n)
    end
  end

  doc "The registry as the renderer's shaders read it: eight 32-bit words a block id. Words 0-5 are the face textures (0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z); word 6 the flags (bit 0 collides, bits 1-2 opacity, bits 3-4 layer, bits 5-6 style) with the light class in bits 8-15; word 7 the emission as `emission` packs it."
  fn gpu_table(r : Registry) : NativeI32Arr do
    gpu_go(NativeArray.make_i32(Strata.Size.of(8 * count(r)), 0), r, 0, count(r))
  end

  doc "The first id of the family [id] belongs to; an unregistered id answers 0 (air)."
  fn base_of(r : Registry, id : Int) : Int do int_of(r, id, 3, 0) end

  doc "Which state of its family [id] is: 0 for the base and for a plain block."
  fn state_of(r : Registry, id : Int) : Int do
    if id < 0 || id >= count(r) do 0 else id - base_of(r, id) end
  end

  doc "The id of state [s] in [id]'s family. A state outside the family, or an unregistered id, returns [id] unchanged."
  fn with_state(r : Registry, id : Int, s : Int) : Int do
    if id < 0 || id >= count(r) do id
    else if s < 0 || s >= int_of(r, id, 4, 1) do id
    else base_of(r, id) + s end end
  end

  doc "Add a model: [quads] for drawing, [boxes] for collision and ray casting. Returns its index."
  fn add_model(r : Registry, quads : NativeF32Arr, boxes : List(Box)) : (Registry, Int) do
    match r do
      Registry(n, cap, flags, ints, ms, mc, lt) -> (Registry(n, cap, flags, ints, Cons(ModelDef(quads, boxes), ms), mc + 1, lt), mc)
    end
  end

  doc "How many models the registry holds; their indices are 0 .. count - 1."
  fn model_count(r : Registry) : Int do match r do Registry(_, _, _, _, _, mc, _) -> mc end end

  -- Models are stored newest first: index m is at position (count - 1 - m).
  pfn model_at(ms : List(ModelDef), i : Int) : Option(ModelDef) do
    match ms do
      Nil -> None
      Cons(h, t) -> if i == 0 do Some(h) else model_at(t, i - 1) end
    end
  end

  pfn find_model(r : Registry, m : Int) : Option(ModelDef) do
    match r do
      Registry(_, _, _, _, ms, mc, _) -> if m < 0 || m >= mc do None else model_at(ms, mc - 1 - m) end
    end
  end

  doc "A model's drawing quads; an empty array for an unknown model."
  fn model_quads(r : Registry, m : Int) : NativeF32Arr do
    match find_model(r, m) do
      Some(ModelDef(q, _)) -> q
      None -> NativeArray.make_f32(0, 0.0)
    end
  end

  doc "A model's collision boxes; none for an unknown model."
  fn model_boxes(r : Registry, m : Int) : List(Box) do
    match find_model(r, m) do
      Some(ModelDef(_, b)) -> b
      None -> Nil
    end
  end
end
