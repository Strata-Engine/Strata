-- Fluid — finite fluids that fall, spread toward a way down, are taken by a
-- sink, and come to rest.
--
-- A fluid is a block family of eight states, one per fill level in eighths
-- of a voxel (Strata.Blocks.register_fluid). This module keeps a set of
-- ACTIVE cells, the only ones it looks at, and each step turns them into
-- one Strata.Edit outcome: the fluid is ordinary blocks changed by an
-- ordinary edit, so meshing, lighting and collision follow with no path of
-- their own.
--
-- A step reads the world as it stands and decides every move from that
-- state, so the result does not depend on the order cells are visited in:
--
--   * Sink.   A cell above or beside a sink block loses all it holds.
--   * Sea.    A sea block is a body that is never used up. A cell above
--             one loses all it holds, as over a sink. An empty cell
--             beside or under one becomes sea if it has something to
--             stand on, so a hole dug in the sea or at the shore closes
--             with sea, up to the sea's level and no higher. Over a drop
--             the sea pours the first flowing family instead, which
--             falls: a cave under the sea floods from above. Water of
--             that family standing against the sea is topped up. A sea
--             block is never removed by a step.
--   * Fall.   Else, with room below, it offers all it holds to the lowest
--             cell it can reach straight down, at most `fall` cells away.
--   * Seek.   Else, a surface cell looks `reach` cells along each of the
--             four side directions for a way down (a cell with room under
--             it, or a sink). If the next cell that way is the way down,
--             or dry ground leading to it, it sends what it holds over
--             the edge to where it would land this step: a stream runs
--             to a drop instead of spreading, and the lip of a lake pours.
--   * Level.  Else (and that includes every cell of a lake but its lip)
--             it gives an eighth at a time, two a step at most, to the
--             lowest cell it can reach through fluid in each direction, while that one stands
--             two or more below. A cell with the same fluid on top of it
--             instead pours into its lowest side neighbour: all of it
--             into an empty cell, half the difference into one that holds
--             some. The weight above it pushes water out through an opening. So a surface settles to within an
--             eighth and a lone eighth stays put.
--
-- A cell takes offers until it holds eight eighths: from above first, then
-- from its -x, +x, -z and +z neighbours. What it cannot take stays with the
-- giver. So nothing is created or lost except into a sink.
--
-- Fluid moves into air and into blocks that do not collide (plants), which
-- it replaces. A chunk that is not loaded is a wall.
mod Strata.Fluid do

  needs IO.Spawn      -- a step can be worked out on a worker (`begin`, `finish`)

  alias Strata.World as Wq
  alias Strata.Blocks as Bq
  alias Strata.Coord as Kq
  alias Strata.Store as Sq
  alias Strata.Edit as Eq

  -- where falling water arrived: x, y, z, eighths, cells fallen without landing, landed
  type Event = Event(Int, Int, Int, Int, Int, Bool)

  fn ev_x(e : Event) : Int do match e do Event(x, _, _, _, _, _) -> x end end
  fn ev_y(e : Event) : Int do match e do Event(_, y, _, _, _, _) -> y end end
  fn ev_z(e : Event) : Int do match e do Event(_, _, z, _, _, _) -> z end end
  doc "How many eighths arrived."
  fn ev_eighths(e : Event) : Int do match e do Event(_, _, _, n, _, _) -> n end end
  doc "How many cells that water has fallen without landing."
  fn ev_fell(e : Event) : Int do match e do Event(_, _, _, _, d, _) -> d end end
  doc "Did it land: is the cell under it something other than air?"
  fn ev_landed(e : Event) : Bool do match e do Event(_, _, _, _, _, l) -> l end end

  -- registry; flowing family bases; sink bases; cap, reach, fall; the active
  -- cells (each with how far its water has fallen, at most 4095 cells, plus
  -- 4096 times the steps it has been left waiting under the cap); cells set aside in or
  -- beside chunks that are not loaded; the last step's events; how many
  -- active cells the last step left for later; the cells woken since a
  -- step was last begun on a worker
  -- The cells a step left active, 4 ints each (x, y, z, value), and how many.
  type Cells = Cells(NativeIntArr, Int)
  type Fluid = Fluid(Strata.Blocks.Registry, List(Int), List(Int), Int, Int, Int, Strata.Store.Store(Int), Strata.Store.Store(Int), List(Event), Int, List((Int, Int, Int)), Int, Cells, Strata.Store.Store(NativeU8Arr))

  doc "The kind of a family whose water moves."
  fn flowing() : Int do 0 end
  doc "The kind of a block that swallows flowing fluid that reaches it and never changes."
  fn sink() : Int do 1 end
  doc "The kind of a block that is a body of liquid never used up: it swallows fluid that falls onto it, and takes over empty cells beside and under it that have something to stand on, so a hole dug in it or beside it closes with the same block, up to its level and no higher. Over a drop it pours the first flowing family, which falls. An edit that touches it must be passed to `wake`."
  fn sea() : Int do 2 end

  doc "The same simulation with a top to its seas: a `sea` block above height [y] (in voxels) is a `sink` instead. For a world whose rivers are made of the sea's block: the sea floods what is dug beside it, and a river above it only swallows, so a lake breached into the river still drains."
  fn with_sea_top(f : Fluid, y : Int) : Fluid do
    match f do
      Fluid(r, fl, sk, cap, reach, fall, a, d, ev, wt, nw, st, ac, mk) -> Fluid(r, fl, Cons(0 - 2000000 - y, drop_top(sk)), cap, reach, fall, a, d, ev, wt, nw, st, ac, mk)
    end
  end
  doc "The top of the simulation's seas, in voxels, as `with_sea_top` set it; 1000000 when none was set."
  fn sea_top_of(f : Fluid) : Int do
    match f do
      Fluid(_, _, sk, _, _, _, _, _, _, _, _, _, _, _) -> sea_top(sk)
    end
  end

  -- the top is kept in the sink list too, as -(2 000 000 + y); none: no top
  pfn drop_top(sk : List(Int)) : List(Int) do
    match sk do
      Nil -> Nil
      Cons(h, t) -> if h <= -1000000 do drop_top(t) else Cons(h, drop_top(t)) end
    end
  end
  pfn sea_top(sk : List(Int)) : Int do
    match sk do
      Nil -> 1000000
      Cons(h, t) -> if h <= -1000000 do 0 - 2000000 - h else sea_top(t) end
    end
  end

  -- seas are kept in the sink list as -(base + 1)
  pfn sea_code(base : Int) : Int do 0 - base - 1 end
  pfn sea_codes(l : List(Int)) : List(Int) do
    match l do
      Nil -> Nil
      Cons(b, t) -> Cons(sea_code(b), sea_codes(t))
    end
  end

  pfn bases(fams : List((Int, Int)), kind : Int) : List(Int) do
    match fams do
      Nil -> Nil
      Cons((b, k), t) -> if k == kind do Cons(b, bases(t, kind)) else bases(t, kind) end
    end
  end

  doc "A fluid simulation over [r]'s blocks. [families] lists (base id, kind): a `flowing` family must be one registered with `Strata.Blocks.register_fluid`; a `sink` or a `sea` is any block. Nothing is active until something wakes it."
  fn new(r : Strata.Blocks.Registry, families : List((Int, Int))) : Fluid do
    Fluid(r, bases(families, 0), List.append(bases(families, 1), sea_codes(bases(families, 2))), 4096, 16, 4, Sq.empty(-1), Sq.empty(-1), Nil, 0, Nil, 0, Cells(NativeArray.make_int(Strata.Size.of(4), 0), 0), Sq.empty(no_marks()))
  end

  doc "The same simulation with other limits: at most [cap] active cells handled a step, a way down sought within [reach] cells, a fall of at most [fall] cells a step. The defaults are 4096, 16 and 4."
  fn with_limits(f : Fluid, cap : Int, reach : Int, fall : Int) : Fluid do
    match f do
      Fluid(r, fl, sk, _, _, _, a, d, ev, wt, nw, st, ac, mk) -> Fluid(r, fl, sk, if cap < 1 do 1 else cap end, if reach < 0 do 0 else reach end, if fall < 1 do 1 else fall end, a, d, ev, wt, nw, st, ac, mk)
    end
  end

  doc "How many cells are active."
  fn active_count(f : Fluid) : Int do match f do Fluid(_, _, _, _, _, _, a, _, _, _, _, _, ac, _) -> Sq.size(a) + (match ac do Cells(_, n) -> n end) end end
  doc "How many active cells the last step left for later because of the cap."
  fn waiting_count(f : Fluid) : Int do match f do Fluid(_, _, _, _, _, _, _, _, _, wt, _, _, _, _) -> wt end end
  doc "How many cells are set aside in or beside chunks that are not loaded."
  fn dormant_count(f : Fluid) : Int do match f do Fluid(_, _, _, _, _, _, _, d, _, _, _, _, _, _) -> Sq.size(d) end end
  doc "What fell in the last step."
  fn events(f : Fluid) : List(Event) do match f do Fluid(_, _, _, _, _, _, _, _, ev, _, _, _, _, _) -> ev end end
  doc "How many steps have been applied. A step its worker computed but `finish_world` dropped is not counted, so a game reading `events` once per new count hears each step once."
  fn steps(f : Fluid) : Int do match f do Fluid(_, _, _, _, _, _, _, _, _, _, _, st, _, _) -> st end end

  doc "Make the cell at (x, y, z) active."
  fn wake_cell(f : Fluid, x : Int, y : Int, z : Int) : Fluid do
    match f do
      Fluid(r, fl, sk, cap, reach, fall, a, d, ev, wt, nw, st, ac, mk) ->
        let k = Kq.key(x, y, z)
        -- recorded even when already active: a step running on a worker may be about to put this very cell to rest
        Fluid(r, fl, sk, cap, reach, fall, if Sq.has(a, k) do a else Sq.put(a, k, 0) end, d, ev, wt, Cons((x, y, z), nw), st, ac, mk)
    end
  end

  pfn has_int(l : List(Int), v : Int) : Bool do
    match l do
      Nil -> false
      Cons(h, t) -> if h == v do true else has_int(t, v) end
    end
  end
  pfn min2(a : Int, b : Int) : Int do if a < b do a else b end end
  pfn max2(a : Int, b : Int) : Int do if a > b do a else b end end

  -- A window on the world for reading many nearby cells cheaply: a chunk,
  -- its 26 neighbours, and which of the 27 are loaded (bit (dx + 1) + 3 *
  -- ((dz + 1) + 3 * (dy + 1))). Cells further off are read from the world.
  -- ... and the cells bodies fill (`set_marks`), which are walls
  type View = View(Int, Int, Int, Strata.Chunk.Chunk, Strata.Mesh.Around, Int, Strata.World.World, Strata.Store.Store(NativeU8Arr))

  pfn mask_go(w : Strata.World.World, cx : Int, cy : Int, cz : Int, i : Int, m : Int) : Int do
    if i >= 27 do m
    else mask_go(w, cx, cy, cz, i + 1, if Wq.is_loaded(w, Kq.key(cx + i % 3 - 1, cy + i / 9 - 1, cz + (i / 3) % 3 - 1)) do m + int_shl(1, i) else m end) end
  end

  pfn view_of(w : Strata.World.World, mk : Strata.Store.Store(NativeU8Arr), k : Strata.Coord.Key) : View do
    let a = Strata.Mesh.around_of(Wq.chunks(w), k)
    View(Kq.kx(k), Kq.ky(k), Kq.kz(k), Strata.Mesh.around_chunk(a, 0, 0, 0), a, mask_go(w, Kq.kx(k), Kq.ky(k), Kq.kz(k), 0, 0), w, mk)
  end

  -- The block id at (x, y, z), or -1 when its chunk is not loaded.
  pfn peek(v : View, x : Int, y : Int, z : Int) : Int do
    match v do
      View(cx, cy, cz, centre, around, mask, w, _) ->
        let dx = Kq.chunk_of(x) - cx
        let dy = Kq.chunk_of(y) - cy
        let dz = Kq.chunk_of(z) - cz
        if dx == 0 && dy == 0 && dz == 0 do (if int_and(mask, 8192) == 0 do -1 else Strata.Chunk.get(centre, Kq.local_of(x), Kq.local_of(y), Kq.local_of(z)) end)
        else if dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1 && dz >= -1 && dz <= 1 do
          (if int_and(mask, int_shl(1, (dx + 1) + 3 * ((dz + 1) + 3 * (dy + 1)))) == 0 do -1
           else Strata.Chunk.get(Strata.Mesh.around_chunk(around, dx, dy, dz), Kq.local_of(x), Kq.local_of(y), Kq.local_of(z)) end)
        else if !Wq.is_loaded(w, Kq.key_of_voxel(x, y, z)) do -1
        else Wq.get_block(w, x, y, z) end end end
    end
  end

  -- is the cell one a body fills?
  pfn view_marked(v : View, x : Int, y : Int, z : Int) : Bool do
    match v do
      View(_, _, _, _, _, _, _, mk) -> Sq.size(mk) > 0 && marked(mk, x, y, z)
    end
  end

  -- What the cell is to fluid of family [base]: -2 its chunk is not loaded;
  -- -1 blocked; 0 empty (air or something fluid washes away); 1..8 the same
  -- fluid at that level; 9 a sink; 10 a sea.
  pfn look(r : Strata.Blocks.Registry, sk : List(Int), v : View, base : Int, x : Int, y : Int, z : Int) : Int do
    let id = peek(v, x, y, z)
    if id < 0 do -2
    else if view_marked(v, x, y, z) do -1
    else if id == 0 do 0
    else if Bq.is_fluid(r, id) do (if Bq.fluid_base(r, id) == base do Bq.fill(r, id) else -1 end)
    else if has_int(sk, Bq.base_of(r, id)) do 9
    else if has_int(sk, sea_code(Bq.base_of(r, id))) do (if y <= sea_top(sk) do 10 else 9 end)
    else if Bq.collides(r, id) do -1
    else 0 end end end end end end end
  end

  -- One move on offer: target, the order its target hears it in (0 from
  -- above, then from -x, +x, -z, +z), eighths, the giver, the family, how far
  -- the water will have fallen on arrival (0 for a sideways move), landed.
  type Offer = Offer(Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Bool)

  -- What a step gathers: offers, cells a sink empties (x, y, z, eighths),
  -- cells that touch a chunk that is not loaded (x, y, z, fell).
  -- ... and, for each cell a sink empties, the sink cell it relied on.
  type Plan = Plan(List(Offer), List((Int, Int, Int, Int)), List((Int, Int, Int, Int)), List((Int, Int, Int)))

  pfn bid(p : Plan, o : Offer) : Plan do match p do Plan(os, ds, es, ws) -> Plan(Cons(o, os), ds, es, ws) end end
  pfn drain(p : Plan, x : Int, y : Int, z : Int, n : Int, sx : Int, sy : Int, sz : Int) : Plan do match p do Plan(os, ds, es, ws) -> Plan(os, Cons((x, y, z, n), ds), es, Cons((sx, sy, sz), ws)) end end
  pfn edge(p : Plan, x : Int, y : Int, z : Int, fell : Int) : Plan do match p do Plan(os, ds, es, ws) -> Plan(os, ds, Cons((x, y, z, fell), es), ws) end end

  -- Scan down from (x, y, z): k is the cell being looked at, last the lowest
  -- empty one so far. Answers (cells down to the target, what stopped it):
  -- 0 the target is empty, 1 it is this fluid with room, 2 a sink is there,
  -- 3 a sea is there (the fluid lands on it, in the cell above).
  pfn fall_scan(r : Strata.Blocks.Registry, sk : List(Int), v : View, base : Int, x : Int, y : Int, z : Int, k : Int, last : Int, limit : Int) : (Int, Int) do
    if k > limit do (last, 0)
    else
      let c = look(r, sk, v, base, x, y - k, z)
      if c == 0 do fall_scan(r, sk, v, base, x, y, z, k + 1, k, limit)
      else if c >= 1 && c <= 7 do (k, 1)
      else if c == 9 do (k, 2)
      else if c == 10 do (k, 3)
      else (last, 0) end end end end
    end
  end

  -- Look along (dx, dz) from (x, y, z), at most [reach] cells, through cells
  -- fluid can be in. i is the cell being looked at; gap the distance of the
  -- first empty cell with ground under it (0: none yet); low and lowi the
  -- lowest level among the cells reached through fluid alone (the first
  -- gap counts, at level 0) and its distance. Answers (distance of a way
  -- down or 0, how far along the line fluid bound for it should be put,
  -- low, lowi). A way down is a cell with room under it, or a sink.
  pfn scan(r : Strata.Blocks.Registry, sk : List(Int), v : View, base : Int, x : Int, y : Int, z : Int, dx : Int, dz : Int, i : Int, reach : Int, gap : Int, low : Int, lowi : Int) : (Int, Int, Int, Int) do
    if i > reach do (0, 0, low, lowi)
    else
      let c = look(r, sk, v, base, x + i * dx, y, z + i * dz)
      if c == 9 do (if i == 1 do (0, 0, low, lowi) else (i, if gap > 0 do gap else i - 1 end, low, lowi) end)
      else if c < 0 || c == 10 do (0, 0, low, lowi)      -- a sea beside the line is a wall that fluid stands against
      else if c == 0 do
        let under = look(r, sk, v, base, x + i * dx, y - 1, z + i * dz)
        -- a cell over a sea is a way down too: water runs to the sea's edge and out onto it, where it is swallowed
        if under == 0 || under == 9 || under == 10 || (under >= 1 && under <= 7) do (i, if gap > 0 do gap else i end, low, lowi)
        else if gap == 0 do scan(r, sk, v, base, x, y, z, dx, dz, i + 1, reach, i, 0, i)
        else scan(r, sk, v, base, x, y, z, dx, dz, i + 1, reach, gap, low, lowi) end end
      else if gap == 0 && c < low do scan(r, sk, v, base, x, y, z, dx, dz, i + 1, reach, gap, c, i)
      else scan(r, sk, v, base, x, y, z, dx, dz, i + 1, reach, gap, low, lowi) end end end end
    end
  end

  -- The nearer of two ways down; 0 is none. Ties keep the first.
  pfn nearer(da : Int, db : Int) : Bool do db > 0 && (da == 0 || db < da) end

  -- Share level l with the side neighbours: one eighth at a time to the
  -- lowest of them (the first in the order -x, +x, -z, +z among equals)
  -- while it stands two or more eighths below. a..d are the neighbours'
  -- looks (below 0: no room there); the answer is the four gifts.
  pfn open_to(l : Int, n : Int) : Bool do n >= 0 && n < 8 && l - n >= 2 end
  pfn share(l : Int, a : Int, b : Int, c : Int, d : Int, ga : Int, gb : Int, gc : Int, gd : Int) : (Int, Int, Int, Int) do
    let na = a + ga
    let nb = b + gb
    let nc = c + gc
    let nd = d + gd
    let oa = open_to(l, na) && a >= 0
    let ob = open_to(l, nb) && b >= 0
    let oc = open_to(l, nc) && c >= 0
    let od = open_to(l, nd) && d >= 0
    -- no more than two eighths leave a cell in a step: a surface lowers evenly, cell by cell, not in pits
    if ga + gb + gc + gd >= 2 do (ga, gb, gc, gd)
    else if oa && (!ob || na <= nb) && (!oc || na <= nc) && (!od || na <= nd) do share(l - 1, a, b, c, d, ga + 1, gb, gc, gd)
    else if ob && (!oc || nb <= nc) && (!od || nb <= nd) do share(l - 1, a, b, c, d, ga, gb + 1, gc, gd)
    else if oc && (!od || nc <= nd) do share(l - 1, a, b, c, d, ga, gb, gc + 1, gd)
    else if od do share(l - 1, a, b, c, d, ga, gb, gc, gd + 1)
    else (ga, gb, gc, gd) end end end end end
  end
  pfn gift(p : Plan, base : Int, x : Int, y : Int, z : Int, tx : Int, tz : Int, order : Int, n : Int) : Plan do
    if n > 0 do bid(p, Offer(tx, y, tz, order, n, x, y, z, base, 0, false)) else p end
  end

  -- Send all of a cell's fluid to the way down at (tx, y, tz): over the
  -- edge to where it would fall to this step, or into the sink under the
  -- edge. A sink ON the line is not a cell fluid can be put in: then half
  -- (rounded up) moves one cell toward it instead.
  pfn toward(r : Strata.Blocks.Registry, sk : List(Int), v : View, fall : Int, p : Plan, base : Int, l : Int, x : Int, y : Int, z : Int, tx : Int, tz : Int, order : Int) : Plan do
    if look(r, sk, v, base, tx, y, tz) == 9 do gift(p, base, x, y, z, x + (if tx > x do 1 else if tx < x do -1 else 0 end end), z + (if tz > z do 1 else if tz < z do -1 else 0 end end), order, (l + 1) / 2)
    else
      match fall_scan(r, sk, v, base, tx, y, tz, 1, 0, fall) do
        (k, what) ->
          if what == 2 do drain(p, x, y, z, l, tx, y - k, tz)
          else if k == 0 || (what == 3 && k == 1) do gift(p, base, x, y, z, tx, tz, order, l)
          else if what == 3 do bid(p, Offer(tx, y - k + 1, tz, 0, l, x, y, z, base, k - 1, true))
          else bid(p, Offer(tx, y - k, tz, 0, l, x, y, z, base, k, what == 1 || look(r, sk, v, base, tx, y - k - 1, tz) != 0)) end end end
      end
    end
  end

  -- How much a cell holding l pours into a side neighbour holding n < l.
  pfn pour(l : Int, n : Int) : Int do if n == 0 do l else min2((l - n) / 2, 2) end end

  -- What the fluid cell at (x, y, z), holding [l] eighths of family [base],
  -- wants to do.
  pfn decide(r : Strata.Blocks.Registry, sk : List(Int), v : View, reach : Int, fall : Int, p : Plan, base : Int, l : Int, x : Int, y : Int, z : Int, fell : Int) : Plan do
    let below = look(r, sk, v, base, x, y - 1, z)
    let nxm = look(r, sk, v, base, x - 1, y, z)
    let nxp = look(r, sk, v, base, x + 1, y, z)
    let nzm = look(r, sk, v, base, x, y, z - 1)
    let nzp = look(r, sk, v, base, x, y, z + 1)
    -- a cell that touches a chunk that is not loaded is remembered, so the chunk's arrival wakes it
    let p1 = if below == -2 || nxm == -2 || nxp == -2 || nzm == -2 || nzp == -2 do edge(p, x, y, z, fell) else p end
    -- Water lying on a sea is swallowed, unless it is part of the sea's own
    -- body: with sea beside it, or water on top of it. Then it rests on the
    -- sea as on ground, and joins it when the sea takes it. Water that has
    -- run out over the open surface of the sea has neither, and is gone.
    let above0 = look(r, sk, v, base, x, y + 1, z)
    let by_sea = nxm == 10 || nxp == 10 || nzm == 10 || nzp == 10
    let afloat = below == 10 && (by_sea || (above0 >= 1 && above0 <= 8))
    if below == 9 || (below == 10 && !afloat) do drain(p1, x, y, z, l, x, y - 1, z)
    -- a full cell beside the sea, standing on something, with no water on it, is about to join the sea: it keeps still so the sea can take it
    else if l == 8 && by_sea && (below == -1 || below == 10 || below == 8) && !(above0 >= 1 && above0 <= 8) do p1
    else if nxm == 9 do drain(p1, x, y, z, l, x - 1, y, z)
    else if nxp == 9 do drain(p1, x, y, z, l, x + 1, y, z)
    else if nzm == 9 do drain(p1, x, y, z, l, x, y, z - 1)
    else if nzp == 9 do drain(p1, x, y, z, l, x, y, z + 1)
    else if below == 0 do
      match fall_scan(r, sk, v, base, x, y, z, 1, 0, fall) do
        (k, what) ->
          if what == 2 do drain(p1, x, y, z, l, x, y - k, z)
          else if what == 3 do bid(p1, Offer(x, y - k + 1, z, 0, l, x, y, z, base, fell + k - 1, true))
          else if what == 1 do bid(p1, Offer(x, y - k, z, 0, l, x, y, z, base, fell + k, true))
          else bid(p1, Offer(x, y - k, z, 0, l, x, y, z, base, fell + k, look(r, sk, v, base, x, y - k - 1, z) != 0)) end end end
      end
    else if below >= 1 && below <= 7 do bid(p1, Offer(x, y - 1, z, 0, l, x, y, z, base, fell + 1, true))
    else
      -- cannot fall. Fluid with the same fluid on top of it only evens out
      -- with the cells beside it; fluid at the surface looks further.
      let above = look(r, sk, v, base, x, y + 1, z)
      if above >= 1 && above <= 8 do
        -- under the weight of the fluid above, it pours into its lowest side
        -- neighbour: all of it into an empty cell (an opening), half the
        -- difference into one that already holds some, so that a surface
        -- standing in this layer evens out instead of trading pits
        let ma = if nxm >= 0 && nxm < l do nxm else 9 end
        let mb = if nxp >= 0 && nxp < l do nxp else 9 end
        let mc = if nzm >= 0 && nzm < l do nzm else 9 end
        let md = if nzp >= 0 && nzp < l do nzp else 9 end
        if ma < 9 && ma <= mb && ma <= mc && ma <= md do gift(p1, base, x, y, z, x - 1, z, 2, pour(l, ma))
        else if mb < 9 && mb <= mc && mb <= md do gift(p1, base, x, y, z, x + 1, z, 1, pour(l, mb))
        else if mc < 9 && mc <= md do gift(p1, base, x, y, z, x, z - 1, 4, pour(l, mc))
        else if md < 9 do gift(p1, base, x, y, z, x, z + 1, 3, pour(l, md))
        else p1 end end end end
      else
        match scan(r, sk, v, base, x, y, z, -1, 0, 1, reach, 0, 99, 0) do
          (dxm, txm, lxm, ixm) ->
            match scan(r, sk, v, base, x, y, z, 1, 0, 1, reach, 0, 99, 0) do
              (dxp, txp, lxp, ixp) ->
                match scan(r, sk, v, base, x, y, z, 0, -1, 1, reach, 0, 99, 0) do
                  (dzm, tzm, lzm, izm) ->
                    match scan(r, sk, v, base, x, y, z, 0, 1, 1, reach, 0, 99, 0) do
                      (dzp, tzp, lzp, izp) ->
                        -- A way down counts only when the very next cell that way is the
                        -- drop or dry ground leading to it: a stream runs, a lip pours.
                        -- With fluid in between, this cell is part of a body of water,
                        -- which stays level and feeds its outlet by levelling.
                        let wxm = if txm == 1 do dxm else 0 end
                        let wxp = if txp == 1 do dxp else 0 end
                        let wzm = if tzm == 1 do dzm else 0 end
                        let wzp = if tzp == 1 do dzp else 0 end
                        -- nearest first, in the order -x, +x, -z, +z
                        let b1 = if nearer(wxm, wxp) do 2 else if wxm > 0 do 1 else 0 end end
                        let d1 = if b1 == 2 do wxp else wxm end
                        let b2 = if nearer(d1, wzm) do 3 else b1 end
                        let d2 = if b2 == 3 do wzm else d1 end
                        let b3 = if nearer(d2, wzp) do 4 else b2 end
                        if b3 == 1 do toward(r, sk, v, fall, p1, base, l, x, y, z, x - dxm, z, 2)
                        else if b3 == 2 do toward(r, sk, v, fall, p1, base, l, x, y, z, x + dxp, z, 1)
                        else if b3 == 3 do toward(r, sk, v, fall, p1, base, l, x, y, z, x, z - dzm, 4)
                        else if b3 == 4 do toward(r, sk, v, fall, p1, base, l, x, y, z, x, z + dzp, 3)
                        else
                          -- no way down: even out with the lowest cell reached each way
                          match share(l, if ixm > 0 do lxm else -1 end, if ixp > 0 do lxp else -1 end, if izm > 0 do lzm else -1 end, if izp > 0 do lzp else -1 end, 0, 0, 0, 0) do
                            (ga, gb, gc, gd) -> gift(gift(gift(gift(p1, base, x, y, z, x - ixm, z, 2, ga), base, x, y, z, x + ixp, z, 1, gb), base, x, y, z, x, z - izm, 4, gc), base, x, y, z, x, z + izp, 3, gd)
                          end
                        end end end end
                    end
                end
            end
        end
      end
    end end end end end end end end
  end

  -- What a sea cell does for a cell beside or under it, at (tx, ty, tz):
  --   * empty, with something to stand on (ground, sea, or a full cell of
  --     the family): it becomes sea. Order 6; the "family" carries the sea's
  --     block id. So a hole dug in or beside the sea closes with sea, up to
  --     the sea's own level and no higher: the sea never spreads upward.
  --   * empty over a drop: it is filled with the flowing family, which
  --     falls (order 5); unless this sea cell has sea under it, when the
  --     room below is the lower cell's to fill first.
  --   * holding some of the family: it is topped up. Order 5.
  --   * full of the family, with something to stand on: it becomes sea too
  --     (order 7), so water that has run into a hole in the sea ends as
  --     sea and not as a second kind of water beside it.
  -- Both orders are heard after every other giver, and the sea gives
  -- nothing up.
  pfn sea_mark(id : Int) : Int do 0 - 1000 - id end
  pfn feed(r : Strata.Blocks.Registry, sk : List(Int), v : View, p : Plan, base : Int, sea_id : Int, x : Int, y : Int, z : Int, tx : Int, ty : Int, tz : Int) : Plan do
    let c = look(r, sk, v, base, tx, ty, tz)
    if c >= 1 && c <= 7 do bid(p, Offer(tx, ty, tz, 5, 8 - c, x, y, z, base, 0, true))
    else if c == 8 do
      -- a full cell of the family, standing on something: it joins the sea (order 7)
      -- ... and with none of the family on top of it: water resting on a sea cell is swallowed, so a body of water joins the sea from its top down
      let under = look(r, sk, v, base, tx, ty - 1, tz)
      let over = look(r, sk, v, base, tx, ty + 1, tz)
      if (under == -1 || under == 10 || under == 8) && !(over >= 1 && over <= 8) do bid(p, Offer(tx, ty, tz, 7, 0, x, y, z, sea_mark(sea_id), 0, true)) else p end
    else if c == 0 do
      let under = look(r, sk, v, base, tx, ty - 1, tz)
      if under == -1 || under == 10 || under == 8 do bid(p, Offer(tx, ty, tz, 6, 8, x, y, z, sea_mark(sea_id), 0, true))
      else if under == -2 do p
      -- beside the sea, over room that the sea cell below this one is about to deal with: wait for it (an offer of nothing keeps this cell active), so a hole fills from the bottom with sea and not with loose water poured in from the top
      else if ty == y && look(r, sk, v, base, x, y - 1, z) == 10 do bid(p, Offer(tx, ty, tz, 5, 0, x, y, z, base, 0, true))
      else bid(p, Offer(tx, ty, tz, 5, 8, x, y, z, base, 0, true)) end end end
    else p end end end
  end

  -- A sea cell looks along (dx, dz) past full cells of the family, at most
  -- [reach] cells, and tops up the first one with room: water standing
  -- against the sea ends level with it, not an eighth lower with every cell
  -- from the shore.
  pfn feed_line(r : Strata.Blocks.Registry, sk : List(Int), v : View, p : Plan, base : Int, x : Int, y : Int, z : Int, dx : Int, dz : Int, i : Int, reach : Int) : Plan do
    if i > reach do p
    else
      let c = look(r, sk, v, base, x + i * dx, y, z + i * dz)
      if c == 8 do feed_line(r, sk, v, p, base, x, y, z, dx, dz, i + 1, reach)
      else if c >= 1 && c <= 7 do bid(p, Offer(x + i * dx, y, z + i * dz, 5, 8 - c, x, y, z, base, 0, true))
      else p end end
    end
  end

  pfn feed_side(r : Strata.Blocks.Registry, sk : List(Int), v : View, p : Plan, base : Int, sea_id : Int, x : Int, y : Int, z : Int, dx : Int, dz : Int, reach : Int) : Plan do
    feed_line(r, sk, v, feed(r, sk, v, p, base, sea_id, x, y, z, x + dx, y, z + dz), base, x, y, z, dx, dz, 2, reach)
  end

  -- The plan for one active cell: a flowing fluid decides its move; a sea
  -- cell fills the room beside and under it (see `feed`).
  pfn consider(r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), v : View, reach : Int, fall : Int, p : Plan, x : Int, y : Int, z : Int, fell : Int) : Plan do
    let id = peek(v, x, y, z)
    if id < 0 do edge(p, x, y, z, fell)
    else if id != 0 && y <= sea_top(sk) && has_int(sk, sea_code(Bq.base_of(r, id))) do
      match fl do
        Nil -> p
        Cons(base, _) -> feed_side(r, sk, v, feed_side(r, sk, v, feed_side(r, sk, v, feed_side(r, sk, v, feed(r, sk, v, p, base, id, x, y, z, x, y - 1, z), base, id, x, y, z, -1, 0, reach), base, id, x, y, z, 1, 0, reach), base, id, x, y, z, 0, -1, reach), base, id, x, y, z, 0, 1, reach)
      end
    else
      let base = Bq.fluid_base(r, id)
      if base < 0 || !has_int(fl, base) do p else decide(r, sk, v, reach, fall, p, base, Bq.fill(r, id), x, y, z, fell) end
    end end
  end

  -- ── A step ───────────────────────────────────────────────────────────────
  pfn is_flowing(r : Strata.Blocks.Registry, fl : List(Int), w : Strata.World.World, x : Int, y : Int, z : Int) : Bool do
    let b = Bq.fluid_base(r, Wq.get_block(w, x, y, z))
    b >= 0 && has_int(fl, b)
  end

  pfn is_sea(r : Strata.Blocks.Registry, sk : List(Int), w : Strata.World.World, x : Int, y : Int, z : Int) : Bool do
    let id = Wq.get_block(w, x, y, z)
    id != 0 && y <= sea_top(sk) && has_int(sk, sea_code(Bq.base_of(r, id)))
  end

  -- does the cell hold something a step acts for: flowing fluid, or a sea?
  pfn acts(r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w : Strata.World.World, x : Int, y : Int, z : Int) : Bool do
    is_flowing(r, fl, w, x, y, z) || is_sea(r, sk, w, x, y, z)
  end

  -- How soon a cell should have its turn, smaller first: its distance from
  -- the nearest focus, shrunk by every step it has already waited, so the
  -- near go first and nothing waits for ever.
  pfn urgency(d2 : Float, waited : Int) : Float do
    let k = int_to_float(1 + waited)
    (if d2 < 0.0 do 1.0 else 1.0 +. d2 end) /. (k *. k)
  end

  pfn dist2(fs : List((Float, Float, Float)), x : Int, y : Int, z : Int, best : Float) : Float do
    match fs do
      Nil -> best
      Cons((fx, fy, fz), t) ->
        let dx = int_to_float(x) -. fx
        let dy = int_to_float(y) -. fy
        let dz = int_to_float(z) -. fz
        let d = dx *. dx +. dy *. dy +. dz *. dz
        dist2(t, x, y, z, if best < 0.0 || d < best do d else best end)
    end
  end

  -- An active cell with its urgency: (urgency, x, y, z, fell and steps waited).
  pfn nearer_cell(a : (Float, Int, Int, Int, Int), b : (Float, Int, Int, Int, Int)) : Bool do
    match a do
      (da, xa, ya, za, _) ->
        match b do
          (db, xb, yb, zb, _) ->
            if da != db do da < db
            else if ya != yb do ya < yb
            else if xa != xb do xa < xb
            else za <= zb end end end
        end
    end
  end

  pfn split_at(l : List((Float, Int, Int, Int, Int)), n : Int, acc : List((Float, Int, Int, Int, Int))) : (List((Float, Int, Int, Int, Int)), List((Float, Int, Int, Int, Int))) do
    if n <= 0 do (acc, l)
    else
      match l do
        Nil -> (acc, Nil)
        Cons(h, t) -> split_at(t, n - 1, Cons(h, acc))
      end
    end
  end

  pfn set_aside(d : Strata.Store.Store(Int), es : List((Int, Int, Int, Int))) : Strata.Store.Store(Int) do
    match es do
      Nil -> d
      Cons((x, y, z, fell), t) -> set_aside(Sq.put(d, Kq.key(x, y, z), fell), t)
    end
  end

  -- Is everything a cell at (x, y, z) could move into loaded?
  pfn all_loaded(w : Strata.World.World, x : Int, y : Int, z : Int) : Bool do
    Wq.is_loaded(w, Kq.key_of_voxel(x, y, z)) && Wq.is_loaded(w, Kq.key_of_voxel(x, y - 1, z)) && Wq.is_loaded(w, Kq.key_of_voxel(x - 1, y, z)) && Wq.is_loaded(w, Kq.key_of_voxel(x + 1, y, z)) && Wq.is_loaded(w, Kq.key_of_voxel(x, y, z - 1)) && Wq.is_loaded(w, Kq.key_of_voxel(x, y, z + 1))
  end

  -- Dormant cells whose surroundings have loaded come back to the active set.
  type Revived = Revived(Strata.Store.Store(Int), Strata.Store.Store(Int))

  pfn revive(w : Strata.World.World, active : Strata.Store.Store(Int), dormant : Strata.Store.Store(Int)) : Revived do
    if Sq.size(dormant) == 0 do Revived(active, dormant)
    else
      Sq.fold(dormant, Revived(active, dormant), fn (rv, k, fell) ->
        match rv do
          Revived(a, d) -> if all_loaded(w, Kq.kx(k), Kq.ky(k), Kq.kz(k)) do Revived(if Sq.has(a, k) do a else Sq.put(a, k, fell) end, Sq.remove(d, k)) else rv end
        end)
    end
  end

  -- Does an active cell have anything to do: flowing fluid, or a chunk that is not loaded (it is set aside)?

  -- ── A step's bookkeeping, in flat arrays ─────────────────────────────────
  -- Planning (above) reads the world through views; everything a step then
  -- keeps per cell lives in native arrays: a growable list of ints, and a
  -- table of cells by position (open addressing, linear probing), with one
  -- array a field. Persistent maps were most of a step's cost.

  -- A growable list of ints, and how many are in use.
  type Ints = Ints(NativeIntArr, Int)

  pfn ints_new(cap : Int) : Ints do Ints(NativeArray.make_int(Strata.Size.of(if cap < 4 do 4 else cap end), 0), 0) end
  pfn ints_n(l : Ints) : Int do match l do Ints(_, n) -> n end end
  pfn ints_at(l : Ints, i : Int) : Int do match l do Ints(a, _) -> NativeArray.get_int(a, i) end end
  pfn copy_into(d : NativeIntArr, s : NativeIntArr, i : Int, n : Int) : NativeIntArr do
    if i >= n do d else copy_into(NativeArray.set_int(d, i, NativeArray.get_int(s, i)), s, i + 1, n) end
  end
  pfn ints_room(l : Ints, k : Int) : Ints do
    match l do
      Ints(a, n) -> if n + k <= NativeArray.length_int(a) do l else Ints(copy_into(NativeArray.make_int(Strata.Size.of(2 * (n + k)), 0), a, 0, n), n) end
    end
  end
  pfn push3(l0 : Ints, p : Int, q : Int, r : Int) : Ints do
    match ints_room(l0, 3) do
      Ints(a, n) -> Ints(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(a, n, p), n + 1, q), n + 2, r), n + 3)
    end
  end
  pfn push4(l0 : Ints, p : Int, q : Int, r : Int, t : Int) : Ints do
    match ints_room(l0, 4) do
      Ints(a, n) -> Ints(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(a, n, p), n + 1, q), n + 2, r), n + 3, t), n + 4)
    end
  end
  pfn push6(l0 : Ints, p : Int, q : Int, r : Int, t : Int, u : Int, v : Int) : Ints do
    match ints_room(l0, 6) do
      Ints(a, n) -> Ints(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(a, n, p), n + 1, q), n + 2, r), n + 3, t), n + 4, u), n + 5, v), n + 6)
    end
  end

  -- A cell's position in one Int: 20 bits a coordinate (each within half a
  -- million voxels of the origin), plus 1, so that 0 is never a position.
  pfn pos_key(x : Int, y : Int, z : Int) : Int do ((x + 524288) * 1048576 + (y + 524288)) * 1048576 + (z + 524288) + 1 end
  pfn pos_hash(x : Int, y : Int, z : Int) : Int do int_and(int_xor(int_xor(x * 73856093, y * 19349663), z * 83492791), 1073741823) end

  -- The cells a step touches: capacity (a power of two), how many cells,
  -- the hash slots (each a cell's number plus one, 0 empty: open
  -- addressing, linear probing), and 12 ints a cell, numbered in the order
  -- they came: position key, x, y, z, delta (eighths gained or lost), fam
  -- (the family it holds after, or a sea mark), fell, old value, new value,
  -- flags, and the first offer made to it plus one (0: none). Flags: 1 has
  -- fell, 2 has old, 4 has new, 8 granted, 16 touched, 32 listed.
  type Tab = Tab(Int, Int, NativeIntArr, NativeIntArr)

  pfn zeros(n : Int) : NativeIntArr do NativeArray.make_int(Strata.Size.of(n), 0) end
  pfn pow2_at_least(c : Int, want : Int) : Int do if c >= want do c else pow2_at_least(c * 2, want) end end
  pfn tab_new(want : Int) : Tab do
    let cap = pow2_at_least(64, 2 * want)
    Tab(cap, 0, zeros(cap), zeros(12 * cap))
  end

  pfn tab_n(t : Tab) : Int do match t do Tab(_, n, _, _) -> n end end
  pfn cell(t : Tab, i : Int, f : Int) : Int do match t do Tab(_, _, _, d) -> NativeArray.get_int(d, 12 * i + f) end end
  pfn put(t : Tab, i : Int, f : Int, v : Int) : Tab do match t do Tab(c, n, s, d) -> Tab(c, n, s, NativeArray.set_int(d, 12 * i + f, v)) end end
  pfn tab_x(t : Tab, i : Int) : Int do cell(t, i, 1) end
  pfn tab_y(t : Tab, i : Int) : Int do cell(t, i, 2) end
  pfn tab_z(t : Tab, i : Int) : Int do cell(t, i, 3) end
  pfn tab_delta(t : Tab, i : Int) : Int do cell(t, i, 4) end
  pfn tab_fam(t : Tab, i : Int) : Int do cell(t, i, 5) end
  pfn tab_fell(t : Tab, i : Int) : Int do cell(t, i, 6) end
  pfn tab_old(t : Tab, i : Int) : Int do cell(t, i, 7) end
  pfn tab_head(t : Tab, i : Int) : Int do cell(t, i, 10) end
  pfn has_flag(t : Tab, i : Int, f : Int) : Bool do int_and(cell(t, i, 9), f) != 0 end
  pfn set_delta(t : Tab, i : Int, v : Int) : Tab do put(t, i, 4, v) end
  pfn set_fam(t : Tab, i : Int, v : Int) : Tab do put(t, i, 5, v) end
  pfn set_fell(t : Tab, i : Int, v : Int) : Tab do put(t, i, 6, v) end
  pfn set_old(t : Tab, i : Int, v : Int) : Tab do put(t, i, 7, v) end
  pfn set_now(t : Tab, i : Int, v : Int) : Tab do put(t, i, 8, v) end
  pfn set_head(t : Tab, i : Int, v : Int) : Tab do put(t, i, 10, v) end
  pfn add_flag(t : Tab, i : Int, v : Int) : Tab do put(t, i, 9, int_or(cell(t, i, 9), v)) end

  -- The slot holding position [key], or the empty slot where it would go.
  pfn probe(t : Tab, key : Int, s : Int) : Int do
    match t do
      Tab(c, _, slots, d) ->
        let id1 = NativeArray.get_int(slots, s)
        if id1 == 0 do s
        else if NativeArray.get_int(d, 12 * (id1 - 1)) == key do s
        else probe(t, key, int_and(s + 1, c - 1)) end end
    end
  end
  pfn slot_for(t : Tab, x : Int, y : Int, z : Int) : Int do
    match t do Tab(c, _, _, _) -> probe(t, pos_key(x, y, z), int_and(pos_hash(x, y, z), c - 1)) end
  end
  -- The number of the cell at (x, y, z), or -1.
  pfn find(t : Tab, x : Int, y : Int, z : Int) : Int do
    match t do Tab(_, _, slots, _) -> NativeArray.get_int(slots, slot_for(t, x, y, z)) - 1 end
  end

  -- Twice the room: the cells are copied as they are, the slots made again.
  pfn reslot(t : Tab, i : Int) : Tab do
    if i >= tab_n(t) do t
    else
      let s = slot_for(t, tab_x(t, i), tab_y(t, i), tab_z(t, i))
      match t do Tab(c, n, slots, d) -> reslot(Tab(c, n, NativeArray.set_int(slots, s, i + 1), d), i + 1) end
    end
  end
  pfn grow(t : Tab) : Tab do
    match t do Tab(c, n, _, d) -> reslot(Tab(2 * c, n, zeros(2 * c), copy_into(zeros(24 * c), d, 0, 12 * n)), 0) end
  end

  -- The table with (x, y, z) in it, and the cell's number.
  pfn make(t0 : Tab, x : Int, y : Int, z : Int) : (Tab, Int) do
    let t = match t0 do Tab(c, n, _, _) -> if (n + 1) * 4 > c * 3 do grow(t0) else t0 end end
    let s = slot_for(t, x, y, z)
    match t do
      Tab(c, n, slots, d) ->
        let id1 = NativeArray.get_int(slots, s)
        if id1 != 0 do (t, id1 - 1)
        else
          let b = 12 * n
          (Tab(c, n + 1, NativeArray.set_int(slots, s, n + 1), NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(d, b, pos_key(x, y, z)), b + 1, x), b + 2, y), b + 3, z)), n)
        end
    end
  end

  -- ── Reading the blocks a step touches ───────────────────────────────────
  -- Every block a step reads lies within one voxel of its cells, or along a
  -- sea's line, never more than a chunk away; those chunks are fetched from
  -- the world once a step. A reader: the low chunk x, y, z and the size in
  -- chunks of the box, its chunks, whether each is loaded, and the world,
  -- for anything outside (and for all of it when the cells are too spread
  -- out for a box).
  type Reader = Reader(Int, Int, Int, Int, Int, Int, ChunkTree, NativeIntArr, Strata.World.World)

  -- The box's chunks as a balanced tree over their numbers: the half of a
  -- node's range below goes left.
  type ChunkTree = CLeaf(Strata.Chunk.Chunk) | CNode(Int, ChunkTree, ChunkTree)

  pfn ct_build(cs : Strata.Store.Store(Strata.Chunk.Chunk), lx : Int, ly : Int, lz : Int, nx : Int, ny : Int, lo : Int, hi : Int) : ChunkTree do
    if hi - lo <= 1 do CLeaf(Sq.get(cs, Kq.key(lx + lo % nx, ly + (lo / nx) % ny, lz + lo / (nx * ny))))
    else
      let mid = (lo + hi) / 2
      CNode(mid, ct_build(cs, lx, ly, lz, nx, ny, lo, mid), ct_build(cs, lx, ly, lz, nx, ny, mid, hi))
    end
  end
  pfn ct_get(t : ChunkTree, i : Int) : Strata.Chunk.Chunk do
    match t do
      CLeaf(c) -> c
      CNode(mid, a, b) -> if i < mid do ct_get(a, i) else ct_get(b, i) end
    end
  end

  pfn loaded_flags(cs : Strata.Store.Store(Strata.Chunk.Chunk), lx : Int, ly : Int, lz : Int, nx : Int, ny : Int, i : Int, n : Int, out : NativeIntArr) : NativeIntArr do
    if i >= n do out
    else loaded_flags(cs, lx, ly, lz, nx, ny, i + 1, n, NativeArray.set_int(out, i, if Sq.has(cs, Kq.key(lx + i % nx, ly + (i / nx) % ny, lz + i / (nx * ny))) do 1 else 0 end)) end
  end
  pfn reader(w : Strata.World.World, lx : Int, ly : Int, lz : Int, nx : Int, ny : Int, nz : Int) : Reader do
    let n = if nx * ny * nz > 4096 do 0 else nx * ny * nz end
    let cs = Wq.chunks(w)
    let chunks = ct_build(cs, lx, ly, lz, if nx < 1 do 1 else nx end, if ny < 1 do 1 else ny end, 0, if n < 1 do 1 else n end)
    Reader(lx, ly, lz, if n == 0 do 0 else nx end, ny, nz, chunks, loaded_flags(cs, lx, ly, lz, nx, ny, 0, n, zeros(n + 1)), w)
  end
  -- the reader's number for the chunk holding (x, y, z), or -1 outside its box
  pfn rd_at(rd : Reader, x : Int, y : Int, z : Int) : Int do
    match rd do
      Reader(lx, ly, lz, nx, ny, nz, _, _, _) ->
        let dx = x - 32 * lx
        let dy = y - 32 * ly
        let dz = z - 32 * lz
        if dx >= 0 && dx < 32 * nx && dy >= 0 && dy < 32 * ny && dz >= 0 && dz < 32 * nz do int_shr(dx, 5) + nx * (int_shr(dy, 5) + ny * int_shr(dz, 5)) else -1 end
    end
  end
  pfn rd_block(rd : Reader, x : Int, y : Int, z : Int) : Int do
    let i = rd_at(rd, x, y, z)
    match rd do
      Reader(_, _, _, _, _, _, cs, _, w) -> if i < 0 do Wq.get_block(w, x, y, z) else Strata.Chunk.get_or(ct_get(cs, i), int_and(x, 31), int_and(y, 31), int_and(z, 31), 0) end
    end
  end
  pfn rd_loaded(rd : Reader, x : Int, y : Int, z : Int) : Bool do
    let i = rd_at(rd, x, y, z)
    match rd do
      Reader(_, _, _, _, _, _, _, fl, w) -> if i < 0 do Wq.is_loaded(w, Kq.key_of_voxel(x, y, z)) else NativeArray.get_int(fl, i) != 0 end
    end
  end
  -- does the cell hold flowing fluid, or a sea? (acts, reading the block once)
  pfn acts_rd(r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), rd : Reader, x : Int, y : Int, z : Int) : Bool do
    let id = rd_block(rd, x, y, z)
    let b = Bq.fluid_base(r, id)
    if b >= 0 && has_int(fl, b) do true
    else id != 0 && y <= sea_top(sk) && has_int(sk, sea_code(Bq.base_of(r, id))) end
  end
  -- the box of chunks around the cells, one chunk more each way
  type Span = Span(Int, Int, Int, Int, Int, Int)
  pfn span_add(s : Span, x : Int, y : Int, z : Int) : Span do
    let cx = Kq.chunk_of(x)
    let cy = Kq.chunk_of(y)
    let cz = Kq.chunk_of(z)
    match s do Span(lx, ly, lz, hx, hy, hz) -> Span(min2(lx, cx - 1), min2(ly, cy - 1), min2(lz, cz - 1), max2(hx, cx + 1), max2(hy, cy + 1), max2(hz, cz + 1)) end
  end
  pfn span_cells(s : Span, a : NativeIntArr, i : Int, n : Int) : Span do
    if i >= n do s else span_cells(span_add(s, NativeArray.get_int(a, 4 * i), NativeArray.get_int(a, 4 * i + 1), NativeArray.get_int(a, 4 * i + 2)), a, i + 1, n) end
  end
  pfn reader_over(w : Strata.World.World, s : Span) : Reader do
    match s do Span(lx, ly, lz, hx, hy, hz) -> if lx > hx do reader(w, 0, 0, 0, 0, 0, 0) else reader(w, lx, ly, lz, hx - lx + 1, hy - ly + 1, hz - lz + 1) end end
  end

  -- ── Settling, joining: what a step decides, kept in the table ────────────
  -- Offers as 12 ints each: target x, y, z, order, eighths, giver x, y, z,
  -- family, fell, landed (0 or 1), and the next offer to the same target
  -- plus one (0: none).
  type Book = Book(Tab, Ints)

  pfn book_offers(b : Book, os : List(Offer)) : Book do
    match os do
      Nil -> b
      Cons(o, rest) ->
        match o do
          Offer(tx, ty, tz, ord, n, gx, gy, gz, base, fell, landed) ->
            match b do
              Book(t0, offers) ->
                -- the giver's slot too, now, so no slot moves while the offers are settled
                match make(t0, gx, gy, gz) do
                  (t1, _) ->
                    match make(t1, tx, ty, tz) do
                      (t2, s) ->
                        let i = ints_n(offers) / 12
                        let with12 = push6(push6(offers, tx, ty, tz, ord, n, gx), gy, gz, base, fell, if landed do 1 else 0 end, tab_head(t2, s))
                        book_offers(Book(set_head(t2, s, i + 1), with12), rest)
                    end
                end
            end
        end
    end
  end

  pfn off(o : Ints, i : Int, f : Int) : Int do ints_at(o, 12 * i + f) end

  -- Offers to one target, in the order it hears them: by order, then the giver's y, x, z.
  pfn off_before(o : Ints, a : Int, b : Int) : Bool do
    if off(o, a, 3) != off(o, b, 3) do off(o, a, 3) < off(o, b, 3)
    else if off(o, a, 6) != off(o, b, 6) do off(o, a, 6) < off(o, b, 6)
    else if off(o, a, 5) != off(o, b, 5) do off(o, a, 5) < off(o, b, 5)
    else off(o, a, 7) < off(o, b, 7) end end end
  end
  pfn off_insert(o : Ints, l : List(Int), i : Int) : List(Int) do
    match l do
      Nil -> Cons(i, Nil)
      Cons(h, t) -> if off_before(o, i, h) do Cons(i, l) else Cons(h, off_insert(o, t, i)) end
    end
  end
  pfn chain(o : Ints, next1 : Int, acc : List(Int)) : List(Int) do
    if next1 == 0 do acc else chain(o, off(o, next1 - 1, 11), off_insert(o, acc, next1 - 1)) end
  end

  -- What settling gathers besides the table: givers short of what they
  -- offered (x, y, z), claims a sea made (x, y, z, sea id), events (x, y, z,
  -- eighths, fell, landed).
  type Tally = Tally(Tab, Ints, Ints, Ints)

  pfn held_now(r : Strata.Blocks.Registry, w : Reader, base : Int, x : Int, y : Int, z : Int) : Int do
    let id = rd_block(w, x, y, z)
    if Bq.fluid_base(r, id) == base do Bq.fill(r, id) else 0 end
  end

  -- One target takes its offers in order while it has room; an offer of
  -- another family than the first it took is refused.
  pfn take_all(tl : Tally, o : Ints, l : List(Int), room : Int, fam : Int) : Tally do
    match l do
      Nil -> tl
      Cons(i, rest) ->
        let ord = off(o, i, 3)
        let n = off(o, i, 4)
        let base = off(o, i, 8)
        let got = if fam >= 0 && fam != base do 0 else min2(n, room) end
        match tl do
          Tally(t, shorts, claims, evs) ->
            let shorts2 = if got < n || ord >= 5 do push3(shorts, off(o, i, 5), off(o, i, 6), off(o, i, 7)) else shorts end
            let claims2 = if ord == 7 do push4(claims, off(o, i, 0), off(o, i, 1), off(o, i, 2), 0 - 1000 - base) else claims end
            if got <= 0 do take_all(Tally(t, shorts2, claims2, evs), o, rest, room, fam)
            else
              let ts = find(t, off(o, i, 0), off(o, i, 1), off(o, i, 2))
              let t1 = add_flag(set_fam(set_delta(t, ts, tab_delta(t, ts) + got), ts, base), ts, 16)
              let t2 = if ord < 5 do
                  let gs = find(t1, off(o, i, 5), off(o, i, 6), off(o, i, 7))
                  add_flag(set_fam(set_delta(t1, gs, tab_delta(t1, gs) - got), gs, base), gs, 16)
                else t1 end
              let fell = off(o, i, 9)
              let landed = off(o, i, 10) != 0
              let arrived = if landed do 0 else min2(fell, 4095) end
              let t3 = if ord == 0 do add_flag(set_fell(t2, ts, if has_flag(t2, ts, 1) do max2(tab_fell(t2, ts), arrived) else max2(0, arrived) end), ts, 1) else t2 end
              let evs2 = if ord == 0 do push6(evs, off(o, i, 0), off(o, i, 1), off(o, i, 2), got, fell, if landed do 1 else 0 end) else evs end
              take_all(Tally(t3, shorts2, claims2, evs2), o, rest, room - got, base)
            end
        end
    end
  end

  pfn settle_slots(tl : Tally, r : Strata.Blocks.Registry, w : Reader, o : Ints, s : Int) : Tally do
    match tl do
      Tally(t, _, _, _) ->
        if s >= tab_n(t) do tl
        else
          let h = tab_head(t, s)
          if h == 0 do settle_slots(tl, r, w, o, s + 1)
          else
            let l = chain(o, h, Nil)
            let first = match l do
                Nil -> 0
                Cons(i, _) -> i
              end
            let room = 8 - held_now(r, w, off(o, first, 8), tab_x(t, s), tab_y(t, s), tab_z(t, s))
            settle_slots(take_all(tl, o, l, room, -1), r, w, o, s + 1)
          end
        end
    end
  end

  -- What the sinks take, each an event where it lands.
  pfn drain_all(tl : Tally, r : Strata.Blocks.Registry, w : Reader, ds : List((Int, Int, Int, Int))) : Tally do
    match ds do
      Nil -> tl
      Cons((x, y, z, n), rest) ->
        match tl do
          Tally(t0, shorts, claims, evs) ->
            match make(t0, x, y, z) do
              (t, s) ->
                let fell = if has_flag(t, s, 2) do max2(0, tab_old(t, s)) % 4096 else 0 end
                let t2 = add_flag(set_fam(set_delta(t, s, tab_delta(t, s) - n), s, Bq.fluid_base(r, rd_block(w, x, y, z))), s, 16)
                drain_all(Tally(t2, shorts, claims, push6(evs, x, y, z, n, fell, 1)), r, w, rest)
            end
        end
    end
  end

  -- The claims that stand, as changes (x, y, z, id): cells nothing else moved into or out of.
  pfn grant_all(t : Tab, claims : Ints, i : Int, out : List((Int, Int, Int, Int))) : (Tab, List((Int, Int, Int, Int))) do
    if 4 * i >= ints_n(claims) do (t, out)
    else
      let x = ints_at(claims, 4 * i)
      let y = ints_at(claims, 4 * i + 1)
      let z = ints_at(claims, 4 * i + 2)
      match make(t, x, y, z) do
        (t1, s) ->
          if tab_delta(t1, s) != 0 || has_flag(t1, s, 8) do grant_all(t1, claims, i + 1, out)
          else grant_all(add_flag(t1, s, 8), claims, i + 1, Cons((x, y, z, ints_at(claims, 4 * i + 3)), out))
        end
      end
    end
  end

  -- Each changed cell's block after the step, and the cells that moved.
  pfn changed(t : Tab, r : Strata.Blocks.Registry, w : Reader, s : Int, out : List((Int, Int, Int, Int)), moved : List((Int, Int, Int))) : (List((Int, Int, Int, Int)), List((Int, Int, Int))) do
    if s >= tab_n(t) do (out, moved)
    else
      let d = tab_delta(t, s)
      if !has_flag(t, s, 16) do changed(t, r, w, s + 1, out, moved)
      -- gave as much as it took: its block is as it was, but the water in it is
      -- other water (an eighth that fell in as the one there fell out), so it
      -- and its neighbours are looked at again
      else if d == 0 do changed(t, r, w, s + 1, out, Cons((tab_x(t, s), tab_y(t, s), tab_z(t, s)), moved))
      else
        let x = tab_x(t, s)
        let y = tab_y(t, s)
        let z = tab_z(t, s)
        let base = tab_fam(t, s)
        let moved2 = Cons((x, y, z), moved)
        if base <= -1000 do changed(t, r, w, s + 1, if d > 0 do Cons((x, y, z, 0 - 1000 - base), out) else out end, moved2)
        else
          let now = held_now(r, w, base, x, y, z) + d
          changed(t, r, w, s + 1, Cons((x, y, z, if now <= 0 do 0 else base + min2(now, 8) - 1 end), out), moved2)
        end
      end end
    end
  end

  -- The next step's cells: a cell of the new world joins if it holds
  -- flowing fluid or is a sea, with how far its water fell, or its old
  -- value, or 0.
  type Joined = Joined(Tab, Ints)

  pfn join1(j : Joined, r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w2 : Reader, x : Int, y : Int, z : Int) : Joined do
    if !acts_rd(r, fl, sk, w2, x, y, z) do j
    else
      match j do
        Joined(t0, out) ->
          match make(t0, x, y, z) do
            (t, s) ->
              if has_flag(t, s, 4) do Joined(t, out)
              else
                let v = if has_flag(t, s, 1) do tab_fell(t, s) else if has_flag(t, s, 2) do max2(0, tab_old(t, s)) % 4096 else 0 end end
                Joined(add_flag(set_now(t, s, v), s, 4), push4(out, x, y, z, v))
              end
          end
      end
    end
  end
  pfn join_near(j : Joined, r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w2 : Reader, x : Int, y : Int, z : Int) : Joined do
    join1(join1(join1(join1(join1(join1(join1(j, r, fl, sk, w2, x, y, z), r, fl, sk, w2, x - 1, y, z), r, fl, sk, w2, x + 1, y, z), r, fl, sk, w2, x, y - 1, z), r, fl, sk, w2, x, y + 1, z), r, fl, sk, w2, x, y, z - 1), r, fl, sk, w2, x, y, z + 1)
  end
  -- a changed cell with room may let a sea fill it along its line: wake the sea cell the line ends at
  pfn sea_line(j : Joined, r : Strata.Blocks.Registry, sk : List(Int), w2 : Reader, base : Int, x : Int, y : Int, z : Int, dx : Int, dz : Int, i : Int, reach : Int) : Joined do
    if i > reach do j
    else
      let px = x + i * dx
      let pz = z + i * dz
      let id = rd_block(w2, px, y, pz)
      if id == 0 do j
      else if y <= sea_top(sk) && has_int(sk, sea_code(Bq.base_of(r, id))) do
        match j do
          Joined(t0, out) ->
            match make(t0, px, y, pz) do
              (t, s) -> if has_flag(t, s, 4) do Joined(t, out) else Joined(add_flag(set_now(t, s, 0), s, 4), push4(out, px, y, pz, 0)) end
            end
        end
      else if Bq.fluid_base(r, id) == base && Bq.fill(r, id) == 8 do sea_line(j, r, sk, w2, base, x, y, z, dx, dz, i + 1, reach)
      else j end end end
    end
  end
  pfn seas_near(j : Joined, r : Strata.Blocks.Registry, sk : List(Int), w2 : Reader, x : Int, y : Int, z : Int, reach : Int) : Joined do
    let id = rd_block(w2, x, y, z)
    let base = Bq.fluid_base(r, id)
    if base < 0 || Bq.fill(r, id) >= 8 do j
    else sea_line(sea_line(sea_line(sea_line(j, r, sk, w2, base, x, y, z, -1, 0, 1, reach), r, sk, w2, base, x, y, z, 1, 0, 1, reach), r, sk, w2, base, x, y, z, 0, -1, 1, reach), r, sk, w2, base, x, y, z, 0, 1, 1, reach) end
  end
  pfn join_moved(j : Joined, r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w2 : Reader, seas : Bool, reach : Int, l : List((Int, Int, Int))) : Joined do
    match l do
      Nil -> j
      Cons((x, y, z), rest) ->
        let j2 = join_near(j, r, fl, sk, w2, x, y, z)
        join_moved(if seas do seas_near(j2, r, sk, w2, x, y, z, reach) else j2 end, r, fl, sk, w2, seas, reach, rest)
    end
  end
  pfn join_granted(j : Joined, r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w2 : Reader, l : List((Int, Int, Int, Int))) : Joined do
    match l do
      Nil -> j
      Cons((x, y, z, _), rest) -> join_granted(join_near(j, r, fl, sk, w2, x, y, z), r, fl, sk, w2, rest)
    end
  end
  pfn join_shorts(j : Joined, r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w2 : Reader, sh : Ints, i : Int) : Joined do
    if 3 * i >= ints_n(sh) do j else join_shorts(join1(j, r, fl, sk, w2, ints_at(sh, 3 * i), ints_at(sh, 3 * i + 1), ints_at(sh, 3 * i + 2)), r, fl, sk, w2, sh, i + 1) end
  end
  -- cells the cap left for later keep their place, one more step waited
  pfn keep_later(j : Joined, l : List((Float, Int, Int, Int, Int)), n : Int) : (Joined, Int) do
    match l do
      Nil -> (j, n)
      Cons((_, x, y, z, v), rest) ->
        match j do
          Joined(t0, out) ->
            match make(t0, x, y, z) do
              (t, s) -> keep_later(if has_flag(t, s, 4) do Joined(t, out) else Joined(add_flag(set_now(t, s, v + 4096), s, 4), push4(out, x, y, z, v + 4096)) end, rest, n + 1)
            end
        end
    end
  end

  -- ── Taking a step's cells in ─────────────────────────────────────────────
  -- Every listed cell once, with its first value, into the table; and those
  -- with anything to do, with how soon each should have its turn.
  type Listed = Listed(Tab, List((Float, Int, Int, Int, Int)))

  pfn list_cell(lc : Listed, r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w : Reader, focus : List((Float, Float, Float)), x : Int, y : Int, z : Int, v : Int) : Listed do
    match lc do
      Listed(t0, all) ->
        match make(t0, x, y, z) do
          (t, s) ->
            if has_flag(t, s, 32) do Listed(t, all)
            else
              let t2 = add_flag(set_old(t, s, v), s, 34)
              -- a cell that holds no flowing fluid has nothing to do and takes no place under the cap
              if !rd_loaded(w, x, y, z) || acts_rd(r, fl, sk, w, x, y, z) do Listed(t2, Cons((urgency(dist2(focus, x, y, z, -1.0), v / 4096), x, y, z, v), all))
              else Listed(t2, all) end
            end
        end
    end
  end
  pfn list_array(lc : Listed, r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w : Reader, focus : List((Float, Float, Float)), a : NativeIntArr, i : Int, n : Int) : Listed do
    if i >= n do lc else list_array(list_cell(lc, r, fl, sk, w, focus, NativeArray.get_int(a, 4 * i), NativeArray.get_int(a, 4 * i + 1), NativeArray.get_int(a, 4 * i + 2), NativeArray.get_int(a, 4 * i + 3)), r, fl, sk, w, focus, a, i + 1, n) end
  end

  -- ── Planning chunk by chunk ──────────────────────────────────────────────
  -- Cells are planned through a view of their chunk and its 26 neighbours.
  -- The cells are sorted by chunk with a counting pass over the box of
  -- chunks they lie in, so each view is built once.
  type ChunkSpan = ChunkSpan(Int, Int, Int, Int, Int, Int)   -- low chunk x, y, z; size in chunks x, y, z

  pfn box_of(l : List((Float, Int, Int, Int, Int)), lx : Int, ly : Int, lz : Int, hx : Int, hy : Int, hz : Int) : ChunkSpan do
    match l do
      Nil -> if lx > hx do ChunkSpan(0, 0, 0, 1, 1, 1) else ChunkSpan(lx, ly, lz, hx - lx + 1, hy - ly + 1, hz - lz + 1) end
      Cons((_, x, y, z, _), rest) ->
        let cx = Kq.chunk_of(x)
        let cy = Kq.chunk_of(y)
        let cz = Kq.chunk_of(z)
        box_of(rest, min2(lx, cx), min2(ly, cy), min2(lz, cz), max2(hx, cx), max2(hy, cy), max2(hz, cz))
    end
  end
  pfn box_slot(b : ChunkSpan, x : Int, y : Int, z : Int) : Int do
    match b do ChunkSpan(lx, ly, lz, nx, ny, _) -> (Kq.chunk_of(x) - lx) + nx * ((Kq.chunk_of(y) - ly) + ny * (Kq.chunk_of(z) - lz)) end
  end
  pfn box_size(b : ChunkSpan) : Int do match b do ChunkSpan(_, _, _, nx, ny, nz) -> nx * ny * nz end end

  pfn count_slots(b : ChunkSpan, counts : NativeIntArr, l : List((Float, Int, Int, Int, Int))) : NativeIntArr do
    match l do
      Nil -> counts
      Cons((_, x, y, z, _), rest) ->
        let s = box_slot(b, x, y, z)
        count_slots(b, NativeArray.set_int(counts, s, NativeArray.get_int(counts, s) + 1), rest)
    end
  end
  pfn starts_of(counts : NativeIntArr, i : Int, n : Int, at : Int, out : NativeIntArr) : NativeIntArr do
    if i >= n do out else starts_of(counts, i + 1, n, at + NativeArray.get_int(counts, i), NativeArray.set_int(out, i, at)) end
  end
  -- cells placed by slot: 4 ints each (x, y, z, fell)
  pfn place_cells(b : ChunkSpan, next : NativeIntArr, sorted : NativeIntArr, l : List((Float, Int, Int, Int, Int))) : NativeIntArr do
    match l do
      Nil -> sorted
      Cons((_, x, y, z, v), rest) ->
        let s = box_slot(b, x, y, z)
        let at = NativeArray.get_int(next, s)
        let sorted2 = NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(sorted, 4 * at, x), 4 * at + 1, y), 4 * at + 2, z), 4 * at + 3, v % 4096)
        place_cells(b, NativeArray.set_int(next, s, at + 1), sorted2, rest)
    end
  end
  pfn plan_range(r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), v : View, reach : Int, fall : Int, p : Plan, sorted : NativeIntArr, i : Int, e : Int) : Plan do
    if i >= e do p
    else plan_range(r, fl, sk, v, reach, fall, consider(r, fl, sk, v, reach, fall, p, NativeArray.get_int(sorted, 4 * i), NativeArray.get_int(sorted, 4 * i + 1), NativeArray.get_int(sorted, 4 * i + 2), NativeArray.get_int(sorted, 4 * i + 3)), sorted, i + 1, e) end
  end
  pfn plan_slots(r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w : Strata.World.World, mk : Strata.Store.Store(NativeU8Arr), reach : Int, fall : Int, p : Plan, sorted : NativeIntArr, starts : NativeIntArr, counts : NativeIntArr, s : Int, n : Int) : Plan do
    if s >= n do p
    else
      let c = NativeArray.get_int(counts, s)
      if c == 0 do plan_slots(r, fl, sk, w, mk, reach, fall, p, sorted, starts, counts, s + 1, n)
      else
        let st = NativeArray.get_int(starts, s)
        let x = NativeArray.get_int(sorted, 4 * st)
        let y = NativeArray.get_int(sorted, 4 * st + 1)
        let z = NativeArray.get_int(sorted, 4 * st + 2)
        let v = view_of(w, mk, Kq.key_of_voxel(x, y, z))
        plan_slots(r, fl, sk, w, mk, reach, fall, plan_range(r, fl, sk, v, reach, fall, p, sorted, st, st + c), sorted, starts, counts, s + 1, n)
      end
    end
  end
  pfn plan_now(r : Strata.Blocks.Registry, fl : List(Int), sk : List(Int), w : Strata.World.World, mk : Strata.Store.Store(NativeU8Arr), reach : Int, fall : Int, now : List((Float, Int, Int, Int, Int)), n : Int) : Plan do
    let b = box_of(now, 1000000, 1000000, 1000000, -1000000, -1000000, -1000000)
    let ns = box_size(b)
    let counts = count_slots(b, zeros(ns), now)
    let starts = starts_of(counts, 0, ns, 0, zeros(ns))
    let sorted = place_cells(b, starts_of(counts, 0, ns, 0, zeros(ns)), zeros(4 * n + 4), now)
    plan_slots(r, fl, sk, w, mk, reach, fall, Plan(Nil, Nil, Nil, Nil), sorted, starts, counts, 0, ns)
  end

  pfn any_sea(sk : List(Int)) : Bool do
    match sk do
      Nil -> false
      Cons(h, t) -> h < 0 || any_sea(t)
    end
  end
  pfn ints_events(l : Ints, i : Int, n : Int, acc : List(Event)) : List(Event) do
    if i >= n do acc
    else ints_events(l, i + 1, n, Cons(Event(ints_at(l, 6 * i), ints_at(l, 6 * i + 1), ints_at(l, 6 * i + 2), ints_at(l, 6 * i + 3), ints_at(l, 6 * i + 4), ints_at(l, 6 * i + 5) != 0), acc)) end
  end

  -- A step, with the sink cells its drains relied on.
  pfn step_full(f : Fluid, w : Strata.World.World, focus : List((Float, Float, Float))) : (Fluid, Strata.Edit.Outcome, List((Int, Int, Int))) do
    match f do
      Fluid(r, fl, sk, cap, reach, fall, woken0, dormant0, _, _, _, st, ac, mk) ->
        match revive(w, woken0, dormant0) do
          Revived(woken, dormant) ->
            match ac do
              Cells(ca, cn) ->
                -- the cells the last step left first, so a cell also woken keeps its value
                let span = Sq.fold(woken, span_cells(Span(1000000, 1000000, 1000000, -1000000, -1000000, -1000000), ca, 0, cn), fn (s, k, _) -> span_add(s, Kq.kx(k), Kq.ky(k), Kq.kz(k)))
                let rd = reader_over(w, span)
                let l0 = list_array(Listed(tab_new(4 * (cn + Sq.size(woken)) + 64), Nil), r, fl, sk, rd, focus, ca, 0, cn)
                match Sq.fold(woken, l0, fn (lc, k, v) -> list_cell(lc, r, fl, sk, rd, focus, Kq.kx(k), Kq.ky(k), Kq.kz(k), v)) do
                  Listed(t0, all) ->
                    let count = List.length(all)
                    let ordered = if count > cap do List.sort_by(all, fn (a, b) -> nearer_cell(a, b)) else all end
                    match split_at(ordered, cap, Nil) do
                      (now, later) ->
                        match plan_now(r, fl, sk, w, mk, reach, fall, now, min2(count, cap)) do
                          Plan(os, ds, es, sinks) ->
                            match book_offers(Book(t0, ints_new(12 * 64)), os) do
                              Book(t1, offers) ->
                                match drain_all(settle_slots(Tally(t1, ints_new(64), ints_new(64), ints_new(64)), r, rd, offers, 0), r, rd, ds) do
                                  Tally(t2, shorts, claims, evs) ->
                                    match grant_all(t2, claims, 0, Nil) do
                                      (t3, granted) ->
                                        match changed(t3, r, rd, 0, granted, Nil) do
                                          (changes, moved) ->
                                            let o = Eq.set_many(w, changes)
                                            let w2 = reader_over(Eq.world(o), span)
                                            let j1 = join_moved(Joined(t3, ints_new(4 * count + 64)), r, fl, sk, w2, any_sea(sk), reach, moved)
                                            match keep_later(join_shorts(join_granted(j1, r, fl, sk, w2, granted), r, fl, sk, w2, shorts, 0), later, 0) do
                                              (Joined(_, out), waiting) ->
                                                (Fluid(r, fl, sk, cap, reach, fall, Sq.empty(-1), set_aside(dormant, es), ints_events(evs, 0, ints_n(evs) / 6, Nil), waiting, Nil, st + 1, Cells(match out do Ints(a, _) -> a end, ints_n(out) / 4), mk), o, sinks)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
  end

  doc "One step over world [w]: the active cells (the nearest [focus] first, up to the cap) decide their moves from the world as it stands, the moves are settled, and the result is one edit. The new fluid holds the cells still active, those set aside in or beside chunks that are not loaded, and what fell."
  fn step_world(f : Fluid, w : Strata.World.World, focus : List((Float, Float, Float))) : (Fluid, Strata.Edit.Outcome) do
    match step_full(f, w, focus) do
      (f2, o, _) -> (f2, o)
    end
  end

  -- ── Waking from an edit ──────────────────────────────────────────────────
  pfn wake_if(f : Fluid, w : Strata.World.World, x : Int, y : Int, z : Int) : Fluid do
    match f do
      Fluid(r, fl, sk, _, _, _, _, _, _, _, _, _, _, _) -> if acts(r, fl, sk, w, x, y, z) do wake_cell(f, x, y, z) else f end
    end
  end

  pfn wake_range(f : Fluid, w : Strata.World.World, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, x : Int, y : Int, z : Int) : Fluid do
    if y > y1 do f
    else if z > z1 do wake_range(f, w, x0, y0, z0, x1, y1, z1, x0, y + 1, z0)
    else if x > x1 do wake_range(f, w, x0, y0, z0, x1, y1, z1, x0, y, z + 1)
    else wake_range(wake_if(f, w, x, y, z), w, x0, y0, z0, x1, y1, z1, x + 1, y, z) end end end
  end
  pfn wake_box(f : Fluid, w : Strata.World.World, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int) : Fluid do
    if x1 < x0 || y1 < y0 || z1 < z0 do f else wake_range(f, w, x0, y0, z0, x1, y1, z1, x0, y0, z0) end
  end

  -- Fluid in the bounds of one change (a cell, a box, or a small sphere), grown by a cell: all of it when that
  -- is at most 4096 cells, else what lies in the bounds' six faces, two
  -- cells thick (the changed cells at the face and their neighbours outside).
  -- Fluid on the skin of a sphere: cells from two inside its surface to two outside.
  pfn wake_shell(f : Fluid, w : Strata.World.World, cx : Int, cy : Int, cz : Int, rad : Int, x : Int, y : Int, z : Int) : Fluid do
    if y > cy + rad + 2 do f
    else if z > cz + rad + 2 do wake_shell(f, w, cx, cy, cz, rad, cx - rad - 2, y + 1, cz - rad - 2)
    else if x > cx + rad + 2 do wake_shell(f, w, cx, cy, cz, rad, cx - rad - 2, y, z + 1)
    else
      let d2 = (x - cx) * (x - cx) + (y - cy) * (y - cy) + (z - cz) * (z - cz)
      let inner = if rad > 2 do (rad - 2) * (rad - 2) else 0 end
      wake_shell(if d2 >= inner && d2 <= (rad + 2) * (rad + 2) do wake_if(f, w, x, y, z) else f end, w, cx, cy, cz, rad, x + 1, y, z)
    end end end
  end

  pfn wake_change(f : Fluid, w : Strata.World.World, c : Strata.Edit.Change) : Fluid do
    if Eq.kind(c) == 2 && Eq.radius(c) >= 7 do
      -- a big sphere's surface lies well inside its bounding box, so the box's faces would miss it
      match Eq.low(c) do
        (lx, ly, lz) -> wake_shell(f, w, lx + Eq.radius(c), ly + Eq.radius(c), lz + Eq.radius(c), Eq.radius(c), lx - 2, ly - 2, lz - 2)
      end
    else wake_bounds(f, w, c) end
  end

  pfn wake_bounds(f : Fluid, w : Strata.World.World, c : Strata.Edit.Change) : Fluid do
    match Eq.low(c) do
      (lx, ly, lz) ->
        match Eq.high(c) do
          (hx, hy, hz) ->
            let x0 = lx - 1
            let y0 = ly - 1
            let z0 = lz - 1
            let x1 = hx + 1
            let y1 = hy + 1
            let z1 = hz + 1
            if (x1 - x0 + 1) * (y1 - y0 + 1) * (z1 - z0 + 1) <= 4096 do wake_box(f, w, x0, y0, z0, x1, y1, z1)
            else
              let fa = wake_box(wake_box(f, w, x0, y0, z0, x0 + 1, y1, z1), w, x1 - 1, y0, z0, x1, y1, z1)
              let fb = wake_box(wake_box(fa, w, x0 + 2, y0, z0, x1 - 2, y0 + 1, z1), w, x0 + 2, y1 - 1, z0, x1 - 2, y1, z1)
              wake_box(wake_box(fb, w, x0 + 2, y0 + 2, z0, x1 - 2, y1 - 2, z0 + 1), w, x0 + 2, y0 + 2, z1 - 1, x1 - 2, y1 - 2, z1)
            end
        end
    end
  end

  pfn wake_changes(f : Fluid, w : Strata.World.World, cs : List(Strata.Edit.Change)) : Fluid do
    match cs do
      Nil -> f
      Cons(c, t) -> wake_changes(wake_change(f, w, c), w, t)
    end
  end

  doc "Tell the fluid about an edit: fluid in and around what [o] changed becomes active. [w] is the world after the edit. Call it for every edit a game makes; the fluid's own steps need no call."
  fn wake(f : Fluid, w : Strata.World.World, o : Strata.Edit.Outcome) : Fluid do wake_changes(f, w, Eq.changes(o)) end

  -- ── Steps worked out on a worker ─────────────────────────────────────────
  -- step_world is a pure function of the fluid and the world, so it can run
  -- on a worker while frames go by. The world may change meanwhile, so its
  -- result is checked before it is used: if any cell it would change no
  -- longer holds what the step saw there, or a sink it emptied a cell into
  -- is gone, the whole step is dropped and the
  -- fluid carries on from where it was. Nothing is ever half applied.
  type Job = Job(Task((Fluid, List(Strata.Edit.Change), List((Int, Int, Int)))))

  doc "Begin a step on a worker. Answers the fluid to go on waking in the meantime and the job to hand to `finish`."
  fn begin(f : Fluid, w : Strata.World.World, focus : List((Float, Float, Float))) : (Fluid, Job) do
    match f do
      Fluid(r, fl, sk, cap, reach, fall, a, d, ev, wt, _, st, ac, mk) ->
        (Fluid(r, fl, sk, cap, reach, fall, a, d, ev, wt, Nil, st, ac, mk), Job(Authority.must(Task.async(fn () -> worked(f, w, focus)))))
    end
  end

  pfn worked(f : Fluid, w : Strata.World.World, focus : List((Float, Float, Float))) : (Fluid, List(Strata.Edit.Change), List((Int, Int, Int))) do
    match step_full(f, w, focus) do
      (f2, o, sinks) -> (f2, Eq.changes(o), sinks)
    end
  end

  -- Is every sink a drain relied on still a sink?
  pfn still_sinks(f : Fluid, w : Strata.World.World, l : List((Int, Int, Int))) : Bool do
    match l do
      Nil -> true
      Cons((x, y, z), t) ->
        match f do
          Fluid(r, _, sk, _, _, _, _, _, _, _, _, _, _, _) -> if has_int(sk, Bq.base_of(r, Wq.get_block(w, x, y, z))) || has_int(sk, sea_code(Bq.base_of(r, Wq.get_block(w, x, y, z)))) do still_sinks(f, w, t) else false end
        end
    end
  end

  -- Does every cell the step changed still hold what the step saw?
  pfn still_true(w : Strata.World.World, cs : List(Strata.Edit.Change)) : Bool do
    match cs do
      Nil -> true
      Cons(c, t) ->
        match Eq.low(c) do
          (x, y, z) -> if Wq.is_loaded(w, Kq.key_of_voxel(x, y, z)) && Wq.get_block(w, x, y, z) == Eq.old_id(c) do still_true(w, t) else false end
        end
    end
  end

  pfn as_cells(cs : List(Strata.Edit.Change), acc : List((Int, Int, Int, Int))) : List((Int, Int, Int, Int)) do
    match cs do
      Nil -> acc
      Cons(c, t) -> match Eq.low(c) do (x, y, z) -> as_cells(t, Cons((x, y, z, Eq.new_id(c)), acc)) end
    end
  end

  pfn wake_list(f : Fluid, l : List((Int, Int, Int))) : Fluid do
    match l do
      Nil -> f
      Cons((x, y, z), t) -> wake_list(wake_cell(f, x, y, z), t)
    end
  end

  doc "End a step begun with `begin`: wait for it if it is not done, check it against world [w] as it is now, and answer the new fluid and the edit to apply. [f] is the fluid `begin` answered, with whatever has been woken since. If the world changed under the step, the edit is empty and the fluid is [f]: the step did not happen."
  fn finish_world(j : Job, f : Fluid, w : Strata.World.World) : (Fluid, Strata.Edit.Outcome) do
    match j do
      Job(t) ->
        match task_await(t) do
          Ok((f2, cs, sinks)) ->
            if still_true(w, cs) && still_sinks(f, w, sinks) do
              match f do
                Fluid(_, _, _, _, _, _, _, _, _, _, nw, _, _, _) -> (wake_list(f2, nw), Eq.set_many(w, as_cells(cs, Nil)))
              end
            else (f, Eq.set_many(w, Nil)) end
          Err(_) -> (f, Eq.set_many(w, Nil))
        end
    end
  end

  doc "`finish_world` on a stream: the step's edit is applied to it."
  fn finish(j : Job, f : Fluid, s : Strata.Stream.Stream) : (Fluid, Strata.Stream.Stream) do
    match finish_world(j, f, Strata.Stream.world(s)) do
      (f2, o) -> (f2, Strata.Stream.apply(s, o))
    end
  end

  doc "One fluid step on a stream: `step_world` on its world, then the edit applied to the stream, so the changed chunks are meshed again like any edit's."
  fn step(f : Fluid, s : Strata.Stream.Stream, focus : List((Float, Float, Float))) : (Fluid, Strata.Stream.Stream) do
    match step_world(f, Strata.Stream.world(s), focus) do
      (f2, o) -> (f2, Strata.Stream.apply(s, o))
    end
  end

  -- ── Cells bodies fill ────────────────────────────────────────────────────
  -- Marks are one bit a voxel per chunk key, in Strata.Occupancy's layout:
  -- bit Coord.index(x, y, z) of the chunk's 4096 bytes. A marked cell is a
  -- wall to every step; `set_marks` empties it first.
  pfn no_marks() : NativeU8Arr do NativeArray.make_u8(0, 0) end
  pfn marked(mk : Strata.Store.Store(NativeU8Arr), x : Int, y : Int, z : Int) : Bool do
    let k = Kq.key_of_voxel(x, y, z)
    Sq.has(mk, k) && Strata.Occupancy.bit(Sq.get(mk, k), Kq.local_of(x), Kq.local_of(y), Kq.local_of(z))
  end

  doc "Marks with cell (x, y, z), in voxels, added."
  fn mark(mk : Strata.Store.Store(NativeU8Arr), x : Int, y : Int, z : Int) : Strata.Store.Store(NativeU8Arr) do
    let k = Kq.key_of_voxel(x, y, z)
    let i = Kq.local_of(x) + 32 * (Kq.local_of(z) + 32 * Kq.local_of(y))
    let a = if Sq.has(mk, k) do Sq.get(mk, k) else NativeArray.make_u8(4096, 0) end
    let b = NativeArray.get_u8(a, i / 8)
    let bit = int_shl(1, i % 8)
    if int_and(b, bit) != 0 do mk else Sq.put(mk, k, NativeArray.set_u8(a, i / 8, b + bit)) end
  end
  pfn mark_list(m : Strata.Store.Store(NativeU8Arr), cells : List((Int, Int, Int))) : Strata.Store.Store(NativeU8Arr) do
    match cells do
      Nil -> m
      Cons((x, y, z), t) -> mark_list(mark(m, x, y, z), t)
    end
  end
  pfn marks_at(o : Strata.Store.Store(NativeU8Arr), k : Strata.Coord.Key) : NativeU8Arr do
    if Sq.has(o, k) do Sq.get(o, k) else no_marks() end
  end
  doc "Marks for `set_marks` from cells (x, y, z), in voxels."
  fn mark_cells(cells : List((Int, Int, Int))) : Strata.Store.Store(NativeU8Arr) do
    mark_list(Sq.empty(no_marks()), cells)
  end
  doc "The marks `set_marks` set last."
  fn marks_of(f : Fluid) : Strata.Store.Store(NativeU8Arr) do match f do Fluid(_, _, _, _, _, _, _, _, _, _, _, _, _, mk) -> mk end end

  -- the cells set in [a] and not in [o], chunk [k]
  pfn bits_go(a : NativeU8Arr, o : NativeU8Arr, k : Strata.Coord.Key, i : Int, acc : List((Int, Int, Int))) : List((Int, Int, Int)) do
    if i >= 4096 || NativeArray.length_u8(a) < 4096 do acc
    else
      let ob = if NativeArray.length_u8(o) >= 4096 do NativeArray.get_u8(o, i) else 0 end
      let d = int_and(NativeArray.get_u8(a, i), int_xor(ob, 255))
      if d == 0 do bits_go(a, o, k, i + 1, acc)
      else bits_go(a, o, k, i + 1, byte_cells(d, k, i, 0, acc)) end
    end
  end
  pfn byte_cells(d : Int, k : Strata.Coord.Key, i : Int, j : Int, acc : List((Int, Int, Int))) : List((Int, Int, Int)) do
    if j >= 8 do acc
    else if int_and(d, int_shl(1, j)) == 0 do byte_cells(d, k, i, j + 1, acc)
    else
      let idx = i * 8 + j
      byte_cells(d, k, i, j + 1, Cons((32 * Kq.kx(k) + idx % 32, 32 * Kq.ky(k) + idx / 1024, 32 * Kq.kz(k) + (idx / 32) % 32), acc))
    end end
  end
  -- the cells marked in [a] and not in [o]
  pfn newly(a : Strata.Store.Store(NativeU8Arr), o : Strata.Store.Store(NativeU8Arr)) : List((Int, Int, Int)) do
    Sq.fold(a, Nil, fn (acc, k, v) -> bits_go(v, marks_at(o, k), k, 0, acc))
  end

  pfn seen(l : List((Int, Int, Int)), x : Int, y : Int, z : Int) : Bool do
    match l do
      Nil -> false
      Cons((a, b, c), t) -> (a == x && b == y && c == z) || seen(t, x, y, z)
    end
  end
  -- Water of family [base] may pass through the cell: air, or the same water.
  pfn passes(r : Strata.Blocks.Registry, w : Strata.World.World, base : Int, x : Int, y : Int, z : Int) : Bool do
    if !Wq.is_loaded(w, Kq.key_of_voxel(x, y, z)) do false
    else
      let id = Wq.get_block(w, x, y, z)
      id == 0 || Bq.fluid_base(r, id) == base
    end
  end
  pfn level_at(r : Strata.Blocks.Registry, w : Strata.World.World, base : Int, x : Int, y : Int, z : Int) : Int do
    let id = Wq.get_block(w, x, y, z)
    if Bq.fluid_base(r, id) == base do Bq.fill(r, id) else 0 end
  end
  pfn enqueue(r : Strata.Blocks.Registry, w : Strata.World.World, base : Int, x : Int, y : Int, z : Int, seen_ : List((Int, Int, Int)), q : List((Int, Int, Int))) : (List((Int, Int, Int)), List((Int, Int, Int))) do
    if seen(seen_, x, y, z) || !passes(r, w, base, x, y, z) do (seen_, q) else (Cons((x, y, z), seen_), Cons((x, y, z), q)) end
  end
  -- Pour [left] eighths into the nearest cells with room, searching up and
  -- sideways from the cells in the queue (front, then back reversed) through
  -- air and the same water, marked cells included; a marked cell takes none.
  pfn pour_out(r : Strata.Blocks.Registry, w : Strata.World.World, mk : Strata.Store.Store(NativeU8Arr), base : Int, front : List((Int, Int, Int)), back : List((Int, Int, Int)), seen_ : List((Int, Int, Int)), left : Int, n : Int, out : List((Int, Int, Int, Int))) : (Int, List((Int, Int, Int, Int))) do
    if left <= 0 || n >= 512 do (left, out)
    else
      match front do
        Nil ->
          match back do
            Nil -> (left, out)
            Cons(_, _) -> pour_out(r, w, mk, base, List.reverse(back), Nil, seen_, left, n, out)
          end
        Cons((x, y, z), rest) ->
          let lv = level_at(r, w, base, x, y, z)
          let give = if marked(mk, x, y, z) do 0 else min2(8 - lv, left) end
          let out2 = if give > 0 do Cons((x, y, z, base + lv + give - 1), out) else out end
          match enqueue(r, w, base, x, y + 1, z, seen_, back) do
            (s1, b1) -> match enqueue(r, w, base, x - 1, y, z, s1, b1) do
              (s2, b2) -> match enqueue(r, w, base, x + 1, y, z, s2, b2) do
                (s3, b3) -> match enqueue(r, w, base, x, y, z - 1, s3, b3) do
                  (s4, b4) -> match enqueue(r, w, base, x, y, z + 1, s4, b4) do
                    (s5, b5) -> pour_out(r, w, mk, base, rest, b5, s5, left - give, n + 1, out2)
                  end
                end
              end
            end
          end
      end
    end
  end
  -- Empty the newly marked cell (x, y, z) of flowing water into the nearest
  -- cells with room; what finds none stays in it, so nothing is lost.
  pfn displace(r : Strata.Blocks.Registry, fl : List(Int), mk : Strata.Store.Store(NativeU8Arr), acc : (Strata.World.World, List((Int, Int, Int, Int))), c : (Int, Int, Int)) : (Strata.World.World, List((Int, Int, Int, Int))) do
    match (acc, c) do
      ((w, done), (x, y, z)) ->
        let id = Wq.get_block(w, x, y, z)
        let base = Bq.fluid_base(r, id)
        if base < 0 || !has_int(fl, base) do (w, done)
        else
          let w0 = Eq.world(Eq.set_many(w, Cons((x, y, z, 0), Nil)))
          match pour_out(r, w0, mk, base, Cons((x, y, z), Nil), Nil, Cons((x, y, z), Nil), Bq.fill(r, id), 0, Nil) do
            (left, poured) ->
              let writes = List.reverse(Cons((x, y, z, if left > 0 do base + left - 1 else 0 end), List.filter(poured, fn p -> match p do (px, py, pz, _) -> !(px == x && py == y && pz == z) end)))
              (Eq.world(Eq.set_many(w, writes)), List.append(done, writes))
          end
        end
    end
  end
  pfn displace_all(r : Strata.Blocks.Registry, fl : List(Int), mk : Strata.Store.Store(NativeU8Arr), acc : (Strata.World.World, List((Int, Int, Int, Int))), cs : List((Int, Int, Int))) : (Strata.World.World, List((Int, Int, Int, Int))) do
    match cs do
      Nil -> acc
      Cons(c, t) -> displace_all(r, fl, mk, displace(r, fl, mk, acc, c), t)
    end
  end
  -- the last write to each cell, once
  pfn latest(l : List((Int, Int, Int, Int)), keep : List((Int, Int, Int)), acc : List((Int, Int, Int, Int))) : List((Int, Int, Int, Int)) do
    match l do
      Nil -> acc
      Cons((x, y, z, id), t) -> if seen(keep, x, y, z) do latest(t, keep, acc) else latest(t, Cons((x, y, z), keep), Cons((x, y, z, id), acc)) end
    end
  end
  pfn wake_near(f : Fluid, w : Strata.World.World, l : List((Int, Int, Int))) : Fluid do
    match l do
      Nil -> f
      Cons((x, y, z), t) ->
        let f1 = wake_if(wake_if(wake_if(f, w, x, y, z), w, x, y + 1, z), w, x - 1, y, z)
        wake_near(wake_if(wake_if(wake_if(f1, w, x + 1, y, z), w, x, y, z - 1), w, x, y, z + 1), w, t)
    end
  end

  doc "Set the cells bodies fill (`Strata.Physics.marks`): from now on every step treats a marked cell as a wall. A cell newly marked gives its water to the nearest cells with room above and beside it (searching through air and the same water, marked cells included), so the amount is kept exactly; water that finds no room within 512 cells stays where it was. A cell no longer marked wakes the water beside and above it. Answers the fluid and the edit that moved the water, to apply as a fluid step's is. Call it before each `begin` (or `step_world`)."
  fn set_marks(f : Fluid, w : Strata.World.World, m : Strata.Store.Store(NativeU8Arr)) : (Fluid, Strata.Edit.Outcome) do
    match f do
      Fluid(r, fl, sk, cap, reach, fall, a, d, ev, wt, nw, st, ac, old) ->
        let gained = newly(m, old)
        let lost = newly(old, m)
        let f1 = Fluid(r, fl, sk, cap, reach, fall, a, d, ev, wt, nw, st, ac, m)
        let moved = displace_all(r, fl, m, (w, Nil), gained)
        match moved do
          (_, writes) ->
            let o = Eq.set_many(w, latest(List.reverse(writes), Nil, Nil))
            let w2 = Eq.world(o)
            (wake_near(wake_changes(f1, w2, Eq.changes(o)), w2, lost), o)
        end
    end
  end

  -- ── Questions a game asks ────────────────────────────────────────────────
  -- A body that swims needs to know how deep it stands in liquid and which
  -- way the liquid is moving. Both are read straight from the world: the
  -- fluid keeps no record of flow. Coordinates are in voxels.

  -- How high the liquid in a cell stands above the cell's floor, in eighths:
  -- a flowing fluid's fill (8 with the same fluid above it), 8 for a sink,
  -- 0 for anything else.
  pfn liquid(f : Fluid, w : Strata.World.World, x : Int, y : Int, z : Int) : Int do
    match f do
      Fluid(r, fl, sk, _, _, _, _, _, _, _, _, _, _, _) ->
        let id = Wq.get_block(w, x, y, z)
        if id == 0 do 0
        else if has_int(sk, Bq.base_of(r, id)) || has_int(sk, sea_code(Bq.base_of(r, id))) do 8
        else
          let base = Bq.fluid_base(r, id)
          if base < 0 || !has_int(fl, base) do 0
          else if Bq.fluid_base(r, Wq.get_block(w, x, y + 1, z)) == base do 8
          else Bq.fill(r, id) end end
        end end
    end
  end

  pfn overlap(a0 : Float, a1 : Float, b0 : Float, b1 : Float) : Float do
    let lo = if a0 > b0 do a0 else b0 end
    let hi = if a1 < b1 do a1 else b1 end
    if hi > lo do hi -. lo else 0.0 end
  end

  pfn under_go(f : Fluid, w : Strata.World.World, x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float, cx0 : Int, cz0 : Int, cx1 : Int, cy1 : Int, cz1 : Int, x : Int, y : Int, z : Int, acc : Float) : Float do
    if y > cy1 do acc
    else if z > cz1 do under_go(f, w, x0, y0, z0, x1, y1, z1, cx0, cz0, cx1, cy1, cz1, cx0, y + 1, cz0, acc)
    else if x > cx1 do under_go(f, w, x0, y0, z0, x1, y1, z1, cx0, cz0, cx1, cy1, cz1, cx0, y, z + 1, acc)
    else
      let l = liquid(f, w, x, y, z)
      let part = if l == 0 do 0.0
        else overlap(x0, x1, int_to_float(x), int_to_float(x + 1)) *. overlap(z0, z1, int_to_float(z), int_to_float(z + 1)) *. overlap(y0, y1, int_to_float(y), int_to_float(y) +. int_to_float(l) /. 8.0) end
      under_go(f, w, x0, y0, z0, x1, y1, z1, cx0, cz0, cx1, cy1, cz1, x + 1, y, z, acc +. part)
    end end end
  end

  doc "How much of the box with corners (x0, y0, z0) and (x1, y1, z1), in voxels, is under liquid: 0 for none of it, 1 for all. Flowing fluids count by how full each cell is; a sink (a sea) counts as full."
  fn depth_in(f : Fluid, w : Strata.World.World, x0 : Float, y0 : Float, z0 : Float, x1 : Float, y1 : Float, z1 : Float) : Float do
    let vol = (x1 -. x0) *. (y1 -. y0) *. (z1 -. z0)
    if vol <= 0.0 do 0.0
    else
      let cx0 = float_to_int(Math.floor(x0))
      let cz0 = float_to_int(Math.floor(z0))
      under_go(f, w, x0, y0, z0, x1, y1, z1, cx0, cz0, float_to_int(Math.floor(x1 -. 0.00001)), float_to_int(Math.floor(y1 -. 0.00001)), float_to_int(Math.floor(z1 -. 0.00001)), cx0, float_to_int(Math.floor(y0)), cz0, 0.0) /. vol
    end
  end

  pfn surface_go(f : Fluid, w : Strata.World.World, x : Int, y : Int, z : Int, n : Int) : Float do
    let l = liquid(f, w, x, y, z)
    if l == 0 do int_to_float(y)
    else if l < 8 || n <= 0 do int_to_float(y) +. int_to_float(l) /. 8.0
    else surface_go(f, w, x, y + 1, z, n - 1) end end
  end

  doc "The height, in voxels, of the liquid surface over the cell (x, y, z): the top of the column of liquid the cell is in, looking up at most 64 cells. Far below zero (-1000000) when the cell holds no liquid."
  fn surface(f : Fluid, w : Strata.World.World, x : Int, y : Int, z : Int) : Float do
    if liquid(f, w, x, y, z) == 0 do -1000000.0 else surface_go(f, w, x, y, z, 64) end
  end

  -- The pull toward a side neighbour, for a cell of family [base] standing
  -- [l] eighths high: 2 toward a drop (an empty cell with room under it) or a sink,
  -- the difference in eighths toward lower fluid or empty ground, less than
  -- nothing toward higher fluid, nothing toward a wall.
  pfn pull(f : Fluid, w : Strata.World.World, base : Int, l : Int, x : Int, y : Int, z : Int) : Float do
    match f do
      Fluid(r, _, sk, _, _, _, _, _, _, _, _, _, _, _) ->
        let id = Wq.get_block(w, x, y, z)
        if !Wq.is_loaded(w, Kq.key_of_voxel(x, y, z)) do 0.0
        else if Bq.fluid_base(r, id) == base do int_to_float(l - liquid(f, w, x, y, z)) /. 8.0
        else if has_int(sk, Bq.base_of(r, id)) do 2.0
        else if id != 0 && y <= sea_top(sk) && has_int(sk, sea_code(Bq.base_of(r, id))) do 0.0      -- water stands against a sea
        else if id != 0 && has_int(sk, sea_code(Bq.base_of(r, id))) do 2.0      -- above the seas' top it swallows, like a sink
        else if id != 0 && Bq.collides(r, id) do 0.0
        else
          let under = Wq.get_block(w, x, y - 1, z)
          if under == 0 || has_int(sk, Bq.base_of(r, under)) || has_int(sk, sea_code(Bq.base_of(r, under))) || (Bq.fluid_base(r, under) == base && Bq.fill(r, under) < 8) do 2.0
          else int_to_float(l) /. 8.0 end
        end end end end end end
    end
  end

  doc "Which way, and how strongly, the fluid in cell (x, y, z) is moving, as a vector: toward lower fluid and, twice as hard, toward drops; each component about -2 to 2, and (0, -1, 0) for fluid that is falling. Zero for still water, for a sink, and for a cell with no flowing fluid. A game multiplies it by how hard its water should push."
  fn flow(f : Fluid, w : Strata.World.World, x : Int, y : Int, z : Int) : (Float, Float, Float) do
    match f do
      Fluid(r, fl, sk, _, _, _, _, _, _, _, _, _, _, _) ->
        let id = Wq.get_block(w, x, y, z)
        let base = Bq.fluid_base(r, id)
        if base < 0 || !has_int(fl, base) do (0.0, 0.0, 0.0)
        else
          let under = Wq.get_block(w, x, y - 1, z)
          if Wq.is_loaded(w, Kq.key_of_voxel(x, y - 1, z)) && (under == 0 || has_int(sk, Bq.base_of(r, under)) || has_int(sk, sea_code(Bq.base_of(r, under))) || (Bq.fluid_base(r, under) == base && Bq.fill(r, under) < 8) || (under != 0 && !Bq.is_fluid(r, under) && !Bq.collides(r, under))) do (0.0, -1.0, 0.0)
          else
            let l = liquid(f, w, x, y, z)
            (pull(f, w, base, l, x + 1, y, z) -. pull(f, w, base, l, x - 1, y, z), 0.0, pull(f, w, base, l, x, y, z + 1) -. pull(f, w, base, l, x, y, z - 1))
          end
        end
    end
  end

  pfn amount_go(w : Strata.World.World, r : Strata.Blocks.Registry, x0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, x : Int, y : Int, z : Int, acc : Int) : Int do
    if y > y1 do acc
    else if z > z1 do amount_go(w, r, x0, z0, x1, y1, z1, x0, y + 1, z0, acc)
    else if x > x1 do amount_go(w, r, x0, z0, x1, y1, z1, x0, y, z + 1, acc)
    else
      let id = Wq.get_block(w, x, y, z)
      amount_go(w, r, x0, z0, x1, y1, z1, x + 1, y, z, if Bq.is_fluid(r, id) do acc + Bq.fill(r, id) else acc end)
    end end end
  end

  doc "The eighths of fluid in the box with inclusive corners (x0, y0, z0) and (x1, y1, z1)."
  fn amount(w : Strata.World.World, r : Strata.Blocks.Registry, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int) : Int do
    amount_go(w, r, x0, z0, x1, y1, z1, x0, y0, z0, 0)
  end
end
