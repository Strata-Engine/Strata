-- Quad — the packed mesh formats. One quad is two 32-bit words, eight bytes:
--
--   word 0   x 0-4, y 5-9, z 10-14, (w - 1) 15-19, (h - 1) 20-24, face 25-27
--   word 1   texture 0-15, corner shading 16-23, flags 24-31
--            (the mesher puts the block's light class in the flags byte)
--
-- (x, y, z) is the quad's lowest voxel, local to its chunk. Faces are
-- 0 +y, 1 -y, 2 +x, 3 -x, 4 +z, 5 -z. A quad's width runs along the face's
-- first in-plane axis u and its height along the second, v:
--
--   faces 0, 1 (+-y)   u = x, v = z
--   faces 2, 3 (+-x)   u = z, v = y
--   faces 4, 5 (+-z)   u = x, v = y
--
-- Corner shading is four 2-bit values 0..3 (3 = open, 0 = closed); corner
-- (cu, cv), each 0 or 1 along u and v, is at bits 2 * (cu + 2 * cv).
--
-- A cross or model block is one INSTANCE, also two words:
--
--   word 0   x 0-4, y 5-9, z 10-14, (model + 1) 15-31   (a cross has model -1)
--   word 1   block id
--
-- The shaders in native/shaders/ decode exactly this layout. Every reader
-- masks its input, because a word read back from a NativeI32Arr is
-- sign-extended.
mod Strata.Quad do

  pfn u32(w : Int) : Int do int_and(w, 4294967295) end

  doc "Word 0 of a quad: lowest voxel (x, y, z) 0..31, width and height 1..32, face 0..5."
  fn pack0(x : Int, y : Int, z : Int, w : Int, h : Int, face : Int) : Int do
    int_and(x, 31) + 32 * int_and(y, 31) + 1024 * int_and(z, 31) + 32768 * int_and(w - 1, 31) + 1048576 * int_and(h - 1, 31) + 33554432 * int_and(face, 7)
  end

  doc "Word 1 of a quad: texture id 0..65535, the four corner shades as one byte (see `ao4`), flags 0..255."
  fn pack1(tex : Int, ao : Int, flags : Int) : Int do
    int_and(tex, 65535) + 65536 * int_and(ao, 255) + 16777216 * int_and(flags, 255)
  end

  doc "Four corner shades 0..3 as one byte: corner (0,0), (1,0), (0,1), (1,1) along (u, v)."
  fn ao4(c00 : Int, c10 : Int, c01 : Int, c11 : Int) : Int do
    int_and(c00, 3) + 4 * int_and(c10, 3) + 16 * int_and(c01, 3) + 64 * int_and(c11, 3)
  end

  doc "Corner [i] (0..3, cu + 2 * cv) of a shading byte."
  fn ao_corner(ao : Int, i : Int) : Int do
    if i == 0 do int_and(ao, 3)
    else if i == 1 do int_and(ao / 4, 3)
    else if i == 2 do int_and(ao / 16, 3)
    else int_and(ao / 64, 3) end end end
  end

  fn x_of(w0 : Int) : Int do int_and(u32(w0), 31) end
  fn y_of(w0 : Int) : Int do int_and(u32(w0) / 32, 31) end
  fn z_of(w0 : Int) : Int do int_and(u32(w0) / 1024, 31) end
  fn w_of(w0 : Int) : Int do int_and(u32(w0) / 32768, 31) + 1 end
  fn h_of(w0 : Int) : Int do int_and(u32(w0) / 1048576, 31) + 1 end
  fn face_of(w0 : Int) : Int do int_and(u32(w0) / 33554432, 7) end
  fn tex_of(w1 : Int) : Int do int_and(u32(w1), 65535) end
  fn ao_of(w1 : Int) : Int do int_and(u32(w1) / 65536, 255) end
  fn flags_of(w1 : Int) : Int do int_and(u32(w1) / 16777216, 255) end

  doc "Word 0 of an instance: its cell and its model index, -1 for a cross."
  fn pack_instance0(x : Int, y : Int, z : Int, model : Int) : Int do
    int_and(x, 31) + 32 * int_and(y, 31) + 1024 * int_and(z, 31) + 32768 * int_and(model + 1, 131071)
  end
  doc "Word 1 of an instance: its block id."
  fn pack_instance1(id : Int) : Int do int_and(id, 65535) end
  fn instance_model(w0 : Int) : Int do int_and(u32(w0) / 32768, 131071) - 1 end
  fn instance_id(w1 : Int) : Int do int_and(u32(w1), 65535) end
end
