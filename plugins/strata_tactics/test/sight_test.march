-- Sight: lines of sight and cover.
mod StrataTactics.Test.Sight do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataTactics.Grid as SiG
  alias StrataTactics.Sight as Si
  alias StrataTactics.Test.Worlds as SiW

  pfn grid(w : Strata.World.World) : StrataTactics.Grid.TileGrid do SiG.build(w, SiW.settings()) end

  describe "Sight.line" do
    test "open ground is clear" do
      let w = SiW.ground()
      Test.assert_true(Si.line(w, grid(w), (1, 4), 3, (6, 4), 3) == Si.clear(), "clear")
    end
    test "a wall taller than both eyes blocks" do
      -- a wall across tile column 3's far edge, x = -1, every z, 6 high
      let w = SiW.box(SiW.ground(), -1, 0, -16, -1, 5, 15, 1)
      Test.assert_true(Si.line(w, grid(w), (1, 4), 3, (6, 4), 3) == Si.blocked(), "blocked")
    end
    test "a wall covering half the tile's width is partial" do
      -- the wall at x = -1 only for z 0..1 of tile row 4 (z 0..3): the rays at z + q pass, z - q are stopped
      let w = SiW.box(SiW.ground(), -1, 0, 0, -1, 5, 1, 1)
      Test.assert_true(Si.line(w, grid(w), (1, 4), 3, (6, 4), 3) == Si.partial(), "partial")
    end
    test "blasting the wall opens the line" do
      let w0 = SiW.box(SiW.ground(), -1, 0, -16, -1, 5, 15, 1)
      let g0 = grid(w0)
      Test.assert_true(Si.line(w0, g0, (1, 4), 3, (6, 4), 3) == Si.blocked(), "blocked first")
      let w1 = Strata.Edit.world(Strata.Edit.fill_box(w0, -1, 0, -2, -1, 8, 6, 0))
      Test.assert_true(Si.line(w1, g0, (1, 4), 3, (6, 4), 3) == Si.clear(), "clear after")
    end
    test "a line to a tile outside the grid is blocked" do
      let w = SiW.ground()
      Test.assert_true(Si.line(w, grid(w), (1, 4), 3, (9, 4), 3) == Si.blocked(), "off the grid")
    end
  end

  describe "Sight cover" do
    test "a low wall is half cover, a tall one full, nothing is none" do
      -- tile (4, 4) is x 0..3, z 0..3; its +x edge's columns are x = 4
      let low = SiW.box(SiW.ground(), 4, 0, 0, 4, 3, 3, 1)
      let tall = SiW.box(SiW.ground(), 4, 0, 0, 4, 6, 3, 1)
      Test.assert_true(Si.edge(low, grid(low), (4, 4), 0, 8, Si.cover_settings()) == Si.half(), "low wall: half")
      Test.assert_true(Si.edge(tall, grid(tall), (4, 4), 0, 8, Si.cover_settings()) == Si.full(), "tall wall: full")
      let w = SiW.ground()
      Test.assert_true(Si.edge(w, grid(w), (4, 4), 0, 8, Si.cover_settings()) == Si.none(), "nothing: none")
    end
    test "cover counts only the edge facing the attacker" do
      let w = SiW.box(SiW.ground(), 4, 0, 0, 4, 6, 3, 1)
      Test.assert_true(Si.against(w, grid(w), (4, 4), (7, 4), 8, Si.cover_settings()) == Si.full(), "facing +x")
      Test.assert_true(Si.against(w, grid(w), (4, 4), (1, 4), 8, Si.cover_settings()) == Si.none(), "attacker at -x")
    end
    test "a diagonal attacker gets the better of two edges" do
      let w = SiW.box(SiW.ground(), 0, 0, 4, 3, 3, 4, 1)
      Test.assert_true(Si.against(w, grid(w), (4, 4), (6, 6), 8, Si.cover_settings()) == Si.half(), "the +z edge's half cover")
    end
  end
end
