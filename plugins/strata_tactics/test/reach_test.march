-- Reach: where a unit can get to, and the way there.
mod StrataTactics.Test.Reach do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataTactics.Grid as RtG
  alias StrataTactics.Reach as Rt
  alias StrataTactics.Test.Worlds as RtW

  pfn ones(k : Int) : Int do 1 end
  pfn open(t : (Int, Int)) : Int do Rt.pass_open() end
  pfn grid(w : Strata.World.World) : StrataTactics.Grid.TileGrid do RtG.build(w, RtW.settings()) end

  describe "Reach.find" do
    test "move 3 on flat ground reaches a diamond of 24 tiles" do
      let r = Rt.find(grid(RtW.ground()), (4, 4), Rt.mover(3, 1, 1, 2), ones, open)
      Test.assert_true(List.length(Rt.tiles(r)) == 24, "24 tiles")
    end
    test "a wall 3 steps high stops a mover with jump 2, not one with jump 3" do
      -- tile (5, 4): x 4..7, z 0..3, raised by three
      let g = grid(RtW.box(RtW.ground(), 4, 0, 0, 7, 2, 3, 1))
      Test.assert_true(Option.is_none(Rt.cost_to(Rt.find(g, (4, 4), Rt.mover(3, 2, 3, 2), ones, open), (5, 4))), "jump 2 cannot")
      Test.assert_true(Rt.cost_to(Rt.find(g, (4, 4), Rt.mover(3, 3, 3, 2), ones, open), (5, 4)) == Some(1), "jump 3 can")
    end
    test "a drop of 4 steps needs drop 4" do
      let g = grid(RtW.box(RtW.ground(), 0, 0, 0, 3, 3, 3, 1))
      Test.assert_true(List.is_empty(Rt.tiles(Rt.find(g, (4, 4), Rt.mover(3, 5, 3, 2), ones, open))), "drop 3 stays")
      Test.assert_true(!List.is_empty(Rt.tiles(Rt.find(g, (4, 4), Rt.mover(3, 5, 4, 2), ones, open))), "drop 4 leaves")
    end
    test "terrain cost 2 halves the reach across it" do
      let g = grid(RtW.box(RtW.ground(), -16, -1, -16, 15, -1, 15, 10))
      let r = Rt.find(g, (4, 4), Rt.mover(4, 1, 1, 2), fn k -> if k == 10 do 2 else 1 end, open)
      Test.assert_true(List.length(Rt.tiles(r)) == 12, "a diamond of radius 2")
    end
    test "cost 0 is impassable" do
      let g = grid(RtW.box(RtW.ground(), 4, -1, 0, 7, -1, 3, 10))
      let r = Rt.find(g, (4, 4), Rt.mover(3, 1, 1, 2), fn k -> if k == 10 do 0 else 1 end, open)
      Test.assert_true(Option.is_none(Rt.cost_to(r, (5, 4))), "never entered")
    end
    test "an ally's tile may be crossed, not stopped on; an enemy's blocks" do
      let g = grid(RtW.ground())
      let ally = Rt.find(g, (4, 4), Rt.mover(3, 1, 1, 2), ones, fn t -> if t == (5, 4) do Rt.pass_through() else Rt.pass_open() end)
      Test.assert_true(!List.any(Rt.tiles(ally), fn t -> t == (5, 4)) && Rt.cost_to(ally, (6, 4)) == Some(2), "crossed")
      let enemy = Rt.find(g, (4, 4), Rt.mover(3, 1, 1, 2), ones, fn t -> if t == (5, 4) do Rt.pass_blocked() else Rt.pass_open() end)
      Test.assert_true(Option.is_none(Rt.cost_to(enemy, (5, 4))) && Rt.cost_to(enemy, (6, 4)) != Some(2), "blocked")
    end
    test "a mover too tall for the clearance cannot enter" do
      Test.assert_true(List.is_empty(Rt.tiles(Rt.find(grid(RtW.ground()), (4, 4), Rt.mover(3, 1, 1, 20), ones, open))), "too tall")
    end
    test "path ends at the target and each step is a neighbour" do
      let r = Rt.find(grid(RtW.ground()), (4, 4), Rt.mover(4, 1, 1, 2), ones, open)
      let p = Rt.path(r, (6, 6))
      Test.assert_true(List.length(p) == 5 && List.head(p) == (4, 4) && List.last(p) == (6, 6), "start to end")
      let pairs = List.zip(p, List.tail(p))
      Test.assert_true(List.all(pairs, fn pr -> match pr do ((ax, az), (bx, bz)) -> int_abs(ax - bx) + int_abs(az - bz) == 1 end), "neighbours")
    end
    test "from an edge tile nothing outside the grid is reached" do
      let g = grid(RtW.ground())
      let r = Rt.find(g, (0, 0), Rt.mover(5, 1, 1, 2), ones, open)
      Test.assert_true(List.all(Rt.tiles(r), fn t -> RtG.inside(g, t)) && List.length(Rt.tiles(r)) == 20, "inside only")
    end
  end
end
