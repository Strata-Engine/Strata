-- Watch: arcs a unit holds, and which of them a step into a tile sets off.
mod StrataTactics.Test.Watch do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataTactics.Watch as TcW

  describe "Watch" do
    test "an arc covers tiles inside its width and range, not its own tile" do
      -- facing +x, 90 degrees wide, 4 tiles
      let a = TcW.arc(1, (5, 5), 0.0, 1.5708, 4)
      Test.assert_true(TcW.covers(a, (8, 5)) && TcW.covers(a, (7, 6)), "ahead, inside")
      Test.assert_true(!TcW.covers(a, (5, 7)) && !TcW.covers(a, (10, 5)) && !TcW.covers(a, (5, 5)), "beside, past range, its own tile")
    end
    test "an arc facing -x covers behind across the wrap" do
      let a = TcW.arc(1, (5, 5), 3.1416, 1.5708, 4)
      Test.assert_true(TcW.covers(a, (2, 5)) && TcW.covers(a, (3, 6)) && TcW.covers(a, (3, 4)) && !TcW.covers(a, (8, 5)), "behind both sides of pi")
    end
    test "a step into a covered tile triggers the arcs whose owners see it, in order" do
      let a = TcW.arc(1, (5, 5), 0.0, 1.5708, 4)
      -- facing +z
      let b = TcW.arc(2, (8, 1), 1.5708, 1.5708, 4)
      let hits = TcW.triggered([a, b], (8, 4), fn x -> x.wa_owner != 3)
      Test.assert_eq_int(List.length(hits), 2, "both")
      Test.assert_eq_int(List.length(TcW.triggered([a, b], (8, 4), fn x -> x.wa_owner == 2)), 1, "only the one that sees")
    end
  end
end
