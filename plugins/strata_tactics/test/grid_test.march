-- Grid: tiles read from the voxels.
mod StrataTactics.Test.Grid do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataTactics.Grid as Gd
  alias StrataTactics.Test.Worlds as Gw

  describe "Grid.build" do
    test "flat ground: every tile stands at y 0 with full clearance" do
      let g = Gd.build(Gw.ground(), Gw.settings())
      Test.assert_true(List.all(List.range(0, 64), fn i -> Gd.floor(g, (i % 8, i / 8)) == 0 && Gd.standable(g, (i % 8, i / 8)) && Gd.clearance(g, (i % 8, i / 8)) == 16), "all tiles at 0")
      Test.assert_true(Gd.width(g) == 8 && Gd.depth(g) == 8, "size")
    end
    test "a 3-voxel block raises one tile to y 3" do
      let g = Gd.build(Gw.box(Gw.ground(), -8, 0, -4, -5, 2, -1, 1), Gw.settings())
      Test.assert_true(Gd.floor(g, (2, 3)) == 3 && Gd.floor(g, (1, 3)) == 0, "raised tile")
    end
    test "a roof over a room: the tile stands on the roof" do
      let w0 = Gw.box(Gw.ground(), 0, 0, 0, 11, 4, 11, 1)
      let w1 = Gw.box(w0, 1, 0, 1, 10, 3, 10, 0)
      let g = Gd.build(w1, Gw.settings())
      Test.assert_true(Gd.floor(g, (5, 5)) == 5, "on the roof")
    end
    test "a bridge high enough to walk under still gives the bridge" do
      let g = Gd.build(Gw.box(Gw.ground(), -12, 6, -12, -9, 6, -9, 1), Gw.settings())
      Test.assert_true(Gd.floor(g, (1, 1)) == 7, "on the bridge")
    end
    test "a tile half rubble: median floor, standable" do
      let g = Gd.build(Gw.box(Gw.ground(), -4, 0, -16, -3, 0, -13, 1), Gw.settings())
      Test.assert_true(Gd.floor(g, (3, 0)) == 0 && Gd.standable(g, (3, 0)), "lower median, standable")
    end
    test "a tile with a pillar in one column: floor unchanged" do
      let g = Gd.build(Gw.box(Gw.ground(), -4, 0, -12, -4, 5, -12, 1), Gw.settings())
      Test.assert_true(Gd.floor(g, (3, 1)) == 0 && Gd.standable(g, (3, 1)) && Gd.clearance(g, (3, 1)) == 16, "pillar ignored")
    end
    test "a column with no room for the smallest unit has no floor" do
      let g = Gd.build(Gw.box(Gw.ground(), 8, 1, -12, 11, 20, -9, 1), Gw.settings())
      Test.assert_true(!Gd.standable(g, (6, 1)), "not standable")
    end
    test "water one deep reads fluid 1" do
      let w0 = Gw.box(Gw.ground(), -16, -1, 12, -13, -1, 15, 9)
      let g = Gd.build(w0, Gw.settings())
      Test.assert_true(Gd.fluid(g, (0, 7)) == 1 && Gd.floor(g, (0, 7)) == -1, "one deep")
    end
    test "outside the grid every reader answers nothing" do
      let g = Gd.build(Gw.ground(), Gw.settings())
      Test.assert_true(!Gd.inside(g, (-1, 0)) && !Gd.standable(g, (-1, 0)) && Gd.floor(g, (8, 3)) == 0 && Gd.clearance(g, (8, 3)) == 0, "off the grid")
      Test.assert_true(Option.is_none(Gd.tile_of(g, 100.0, 0.0)) && Gd.tile_of(g, -15.5, -15.5) == Some((0, 0)), "tile_of")
    end
    test "a tile's centre is in metres on its floor" do
      let g = Gd.build(Gw.ground(), Gw.settings())
      Test.assert_true(Gd.centre(g, (0, 0)) == (-14.0, 0.0, -14.0), "centre of tile 0, 0")
    end
  end

  pfn same(a : StrataTactics.Grid.TileGrid, b : StrataTactics.Grid.TileGrid) : Bool do
    List.all(List.range(0, 64), fn i ->
      let t = (i % 8, i / 8)
      Gd.floor(a, t) == Gd.floor(b, t) && Gd.clearance(a, t) == Gd.clearance(b, t) && Gd.fluid(a, t) == Gd.fluid(b, t) && Gd.kind(a, t) == Gd.kind(b, t) && Gd.standable(a, t) == Gd.standable(b, t))
  end

  describe "Grid.refresh" do
    test "refresh after a blast equals a full build" do
      let w0 = Gw.box(Gw.ground(), -6, 0, -6, 6, 5, 6, 1)
      let g0 = Gd.build(w0, Gw.settings())
      let o = Strata.Edit.blast(w0, 2, 4, 2, 5, 11, 0)
      let w1 = Strata.Edit.world(o)
      match Gd.refresh(g0, w1, Strata.Edit.changes(o)) do
        (g1, _) -> Test.assert_true(same(g1, Gd.build(w1, Gw.settings())), "same as a full build")
      end
    end
    test "refresh re-reads only the touched tiles" do
      let w0 = Gw.ground()
      let g0 = Gd.build(w0, Gw.settings())
      let o = Strata.Edit.set_block(w0, 2, 0, 2, 1)
      match Gd.refresh(g0, Strata.Edit.world(o), Strata.Edit.changes(o)) do
        (_, ts) -> Test.assert_true(List.length(ts) <= 9 && List.length(ts) > 0, "at most nine tiles")
      end
    end
    test "a blast across the grid edge refreshes only in-region tiles" do
      let w0 = Gw.ground()
      let g0 = Gd.build(w0, Gw.settings())
      let o = Strata.Edit.blast(w0, -16, 0, -16, 6, 3, 0)
      match Gd.refresh(g0, Strata.Edit.world(o), Strata.Edit.changes(o)) do
        (_, ts) -> Test.assert_true(List.all(ts, fn t -> Gd.inside(g0, t)) && !List.is_empty(ts), "inside only")
      end
    end
    test "a blast that removes a tile's floor down to the scan floor leaves it unstandable" do
      let s = StrataTactics.Grid.settings(-16, -16, 8, 8, 4, 1, -4, 16, 2, fn id -> id)
      let w0 = Gw.ground()
      let g0 = Gd.build(w0, s)
      let o = Strata.Edit.fill_box(w0, -16, -12, -16, -13, -1, -13, 0)
      match Gd.refresh(g0, Strata.Edit.world(o), Strata.Edit.changes(o)) do
        (g1, _) -> Test.assert_true(Gd.standable(g0, (0, 0)) && !Gd.standable(g1, (0, 0)), "floor gone")
      end
    end
  end
end
