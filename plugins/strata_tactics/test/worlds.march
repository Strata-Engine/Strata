-- Test worlds for strata_tactics: stone below y = 0, air above; block ids
-- 1 stone, 2..9 water (one eighth .. full), 10 stone again; voxels -64..63
-- across and -32..31 up, one metre each (the pattern of Strata's
-- test/nav_test.march).
mod StrataTactics.Test.Worlds do

  alias Strata.World as TwW
  alias Strata.Edit as TwE
  alias Strata.Coord as TwC
  alias Strata.Chunk as TwCh
  alias Strata.Blocks as TwB

  pfn flat() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) -> if TwC.ky(k) < 0 do TwCh.uniform(1) else TwCh.uniform(0) end)
  end
  fn reg() : Strata.Blocks.Registry do
    match TwB.register(TwB.empty(), TwB.def()) do
      Ok((r1, _)) ->
        match TwB.register_fluid(r1, TwB.with_collide(TwB.with_layer(TwB.with_opacity(TwB.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false)) do
          Ok((r2, _)) ->
            match TwB.register(r2, TwB.def()) do
              Ok((r3, _)) -> r3
              Err(_) -> r2
            end
          Err(_) -> r1
        end
      Err(_) -> TwB.empty()
    end
  end
  pfn load(w : Strata.World.World, cx : Int, cy : Int, cz : Int) : Strata.World.World do
    let k = TwC.key(cx, cy, cz)
    TwW.insert(w, k, Strata.Terrain.run(TwW.terrain(w), k, TwW.seed(w)))
  end
  pfn load_box(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 32 do w else load_box(load(w, i % 4 - 2, (i / 4) % 2 - 1, i / 8 - 2), i + 1) end
  end
  doc "Flat stone ground, its top at y = 0 (the first air cell)."
  fn ground() : Strata.World.World do load_box(TwW.new(reg(), flat(), 7, 1.0), 0) end
  doc "The world with the box of voxels (corners inclusive) set to [id]."
  fn box(w : Strata.World.World, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, id : Int) : Strata.World.World do
    TwE.world(TwE.fill_box(w, x0, y0, z0, x1, y1, z1, id))
  end
  doc "The test grid: 8 x 8 tiles of 4 x 4 columns from voxel (-16, -16), a step of 1, scanned from y 16 down to -8, units at least 2 tall, kinds the block ids."
  fn settings() : StrataTactics.Grid.GridSettings do StrataTactics.Grid.settings(-16, -16, 8, 8, 4, 1, -8, 16, 2, fn id -> id) end
end
