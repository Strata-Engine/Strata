-- Marks: overlay items for the tactical layer.
mod StrataTactics.Test.Marks do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataTactics.Marks as TacMk

  pfn grid() : StrataTactics.Grid.TileGrid do StrataTactics.Grid.build(StrataTactics.Test.Worlds.box(StrataTactics.Test.Worlds.ground(), 4, 0, 0, 7, 1, 3, 1), StrataTactics.Test.Worlds.settings()) end
  pfn red() : (Float, Float, Float, Float) do (1.0, 0.0, 0.0, 1.0) end

  describe "Marks" do
    test "tiles makes one quad per tile above its floor" do
      let items = TacMk.tiles(grid(), [(4, 4), (5, 4)], red())
      Test.assert_true(List.map(items, fn i -> Strata.Overlay.kind_index(i)) == [0, 0], "two quads")
      match Strata.Overlay.pack(Strata.Overlay.add_all(Strata.Overlay.empty(), items)) do
        (a, _) -> Test.assert_true(Math.abs(NativeArray.get_f32(a, 9) -. 0.03) < 0.0001 && Math.abs(NativeArray.get_f32(a, 29) -. 2.03) < 0.0001, "3 cm over floors 0 and 2")
      end
    end
    test "outline has no inner edges" do
      Test.assert_true(List.length(TacMk.outline(grid(), [(1, 1), (2, 1), (1, 2), (2, 2)], red())) == 8, "eight edges round a 2 x 2 block")
    end
    test "path marks its end and draws through" do
      let items = TacMk.path(grid(), [(1, 1), (2, 1), (3, 1)], red())
      Test.assert_true(List.map(items, fn i -> Strata.Overlay.kind_index(i)) == [1, 1, 0], "two lines and a marker")
      match Strata.Overlay.pack(Strata.Overlay.add_all(Strata.Overlay.empty(), items)) do
        (a, _) -> Test.assert_true(NativeArray.get_f32(a, 1) == 1.0 && NativeArray.get_f32(a, 21) == 1.0 && NativeArray.get_f32(a, 41) == 1.0, "all through")
      end
    end
  end
end
