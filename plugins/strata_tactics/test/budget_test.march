-- Budgets: the grid's speed on a 64 x 64 map (asserted at four times the
-- budget so a loaded machine does not fail it; the times are printed).
mod StrataTactics.Test.Budget do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataTactics.Grid as TacBg

  pfn flat() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) -> if Strata.Coord.ky(k) < 0 do Strata.Chunk.uniform(1) else Strata.Chunk.uniform(0) end)
  end
  pfn load(w : Strata.World.World, cx : Int, cy : Int, cz : Int) : Strata.World.World do
    let k = Strata.Coord.key(cx, cy, cz)
    Strata.World.insert(w, k, Strata.Terrain.run(Strata.World.terrain(w), k, Strata.World.seed(w)))
  end
  -- 8 x 2 x 8 chunks: voxels -128..127 across, -32..31 up
  pfn load_big(w : Strata.World.World, i : Int) : Strata.World.World do
    if i >= 128 do w else load_big(load(w, i % 8 - 4, (i / 8) % 2 - 1, i / 16 - 4), i + 1) end
  end
  pfn big() : Strata.World.World do load_big(Strata.World.new(StrataTactics.Test.Worlds.reg(), flat(), 7, 1.0), 0) end
  pfn s64() : StrataTactics.Grid.GridSettings do StrataTactics.Grid.settings(-128, -128, 64, 64, 4, 1, -8, 16, 2, fn id -> id) end

  describe "Reach budget" do
    test "reach for one unit with move 12 on a 64 x 64 map under 2 ms" do
      let g = TacBg.build(big(), s64())
      let t0 = Authority.must(System.now_ms())
      let r = StrataTactics.Reach.find(g, (32, 32), StrataTactics.Reach.mover(12, 1, 1, 2), fn k -> 1, fn t -> 0)
      let ms = Authority.must(System.now_ms()) - t0
      println("tactics: reach of " ++ int_to_string(List.length(StrataTactics.Reach.tiles(r))) ++ " tiles in " ++ int_to_string(ms) ++ " ms (budget 2)")
      Test.assert_true(ms < 8, "within four times the budget")
    end
  end

  describe "Grid budget" do
    test "a full build of 64 x 64 tiles under a second" do
      let w = big()
      let t0 = Authority.must(System.now_ms())
      let g = TacBg.build(w, s64())
      let ms = Authority.must(System.now_ms()) - t0
      println("tactics: full build of 64 x 64 tiles in " ++ int_to_string(ms) ++ " ms (budget 1000)")
      Test.assert_true(TacBg.standable(g, (63, 63)) && ms < 4000, "within four times the budget")
    end
    test "a refresh after a radius-6 blast within a frame" do
      let w = big()
      let g = TacBg.build(w, s64())
      let o = Strata.Edit.blast(w, 0, 0, 0, 6, 5, 0)
      let t0 = Authority.must(System.now_ms())
      match TacBg.refresh(g, Strata.Edit.world(o), Strata.Edit.changes(o)) do
        (_, ts) ->
          let ms = Authority.must(System.now_ms()) - t0
          println("tactics: refresh of " ++ int_to_string(List.length(ts)) ++ " tiles after a radius-6 blast in " ++ int_to_string(ms) ++ " ms (budget 16)")
          Test.assert_true(ms < 64, "within four times the budget")
      end
    end
  end
end
