-- Area: target areas and picking.
mod StrataTactics.Test.Area do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataTactics.Grid as ArtG
  alias StrataTactics.Area as Art
  alias StrataTactics.Test.Worlds as ArtW

  pfn grid(w : Strata.World.World) : StrataTactics.Grid.TileGrid do ArtG.build(w, ArtW.settings()) end

  describe "Area shapes" do
    test "radius 2 is 13 tiles on flat ground" do
      Test.assert_true(List.length(Art.radius(grid(ArtW.ground()), (4, 4), 2, None)) == 13, "13")
    end
    test "vertical tolerance drops a raised tile" do
      let g = grid(ArtW.box(ArtW.ground(), 4, 0, 0, 7, 2, 3, 1))
      Test.assert_true(List.length(Art.radius(g, (4, 4), 2, Some(2))) == 12 && List.length(Art.radius(g, (4, 4), 2, None)) == 13, "raised tile dropped")
    end
    test "areas clip at the grid edge" do
      Test.assert_true(List.length(Art.radius(grid(ArtW.ground()), (0, 0), 2, None)) == 6, "corner")
    end
    test "a line of 3 heading +x" do
      Test.assert_true(Art.line(grid(ArtW.ground()), (2, 4), 0, 3, None) == [(3, 4), (4, 4), (5, 4)], "three ahead")
    end
    test "a cone of 3 is 1 + 3 + 5 tiles" do
      Test.assert_true(List.length(Art.cone(grid(ArtW.ground()), (1, 4), 0, 3, None)) == 9, "nine")
    end
  end

  describe "Area.pick" do
    test "a ray straight down at a tile centre picks that tile" do
      let w = ArtW.ground()
      Test.assert_true(Art.pick(w, grid(w), ((-14.0, 10.0, -14.0), (0.0, -1.0, 0.0)), None, 50.0) == Some((0, 0)), "tile 0, 0")
    end
    test "a ray at a roof with a cut below it picks the floor inside" do
      let w0 = ArtW.box(ArtW.ground(), 0, 0, 0, 11, 4, 11, 1)
      let w1 = ArtW.box(w0, 1, 0, 1, 10, 3, 10, 0)
      let g = grid(w1)
      -- down at 45 degrees from (0, 12): without a cut it meets the roof at x 7 (tile 5); cut at 3.5 it starts at x 8.5 inside and meets the far wall at x 11 (tile 6)
      Test.assert_true(Art.pick(w1, g, ((0.0, 12.0, 6.5), (1.0, -1.0, 0.0)), None, 50.0) == Some((5, 5)), "the roof without a cut")
      Test.assert_true(Art.pick(w1, g, ((0.0, 12.0, 6.5), (1.0, -1.0, 0.0)), Some(3.5), 50.0) == Some((6, 5)), "inside with the cut")
    end
    test "a ray into the sky picks nothing" do
      let w = ArtW.ground()
      Test.assert_true(Option.is_none(Art.pick(w, grid(w), ((0.0, 5.0, 0.0), (0.0, 1.0, 0.0)), None, 50.0)), "sky")
      Test.assert_true(Option.is_none(Art.pick(w, grid(w), ((0.0, 5.0, 0.0), (0.0, 1.0, 0.0)), Some(3.0), 50.0)), "rising from above the cut")
    end
    test "a ray hitting ground off the grid picks nothing" do
      let w = ArtW.ground()
      Test.assert_true(Option.is_none(Art.pick(w, grid(w), ((40.0, 10.0, 40.0), (0.0, -1.0, 0.0)), None, 50.0)), "off the grid")
    end
  end
end
