-- The strata_tactics example: a small game wired to the plugin.
--
-- A flat stone field with a hollow building, a tall wall and a low wall.
-- Four units on two sides, drawn as coloured boxes in the overlay, take FFT
-- turns. The active unit's reach is shown; hovering a reachable tile shows
-- the path; clicking moves the unit there. T shows line of sight and cover to
-- the tile under the pointer; B blasts that tile (a plugin request, applied by
-- the game, the grid refreshed from the outcome); Space ends the turn. The
-- camera: W A S D pan, Q E turn, R F zoom, Page Up / Down floor levels, the
-- right mouse button drags it round. Escape quits.
--
-- STRATA_FRAMES=n runs a fixed sequence instead (reach and a path shown, a
-- wall blasted, the camera turned) and writes frame n - 3 to STRATA_SHOT, as
-- the viewer does.
--
-- The lines marked "plugin:" are the wiring the plugin needs (docs/plugins.md).
mod TacticsExample do

  needs IO
  needs IO.Process
  needs IO.Spawn
  needs IO.Foreign
  needs Audio
  needs IO.FileSystem
  needs Anim

  alias Strata.Blocks as TxB
  alias Strata.Math.Mat4 as TxM

  -- ── The world ────────────────────────────────────────────────────────────
  -- block ids: 1 stone, 2 wall, 3 rubble
  pfn registry() : Strata.Blocks.Registry do
    let stone = TxB.with_faces(TxB.def(), 1, 1, 1)
    let wall = TxB.with_faces(TxB.def(), 2, 2, 2)
    let rubble = TxB.with_faces(TxB.def(), 3, 3, 3)
    match TxB.register(TxB.empty(), stone) do
      Ok((r1, _)) -> match TxB.register(r1, wall) do
        Ok((r2, _)) -> match TxB.register(r2, rubble) do Ok((r3, _)) -> r3 | Err(_) -> r2 end
        Err(_) -> r1
      end
      Err(_) -> TxB.empty()
    end
  end

  pfn gen() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) -> if Strata.Coord.ky(k) < 0 do Strata.Chunk.uniform(1) else Strata.Chunk.uniform(0) end)
  end

  -- a 16 x 16 tile of one colour with a little hashed speckle
  pfn tile_px(a : NativeU8Arr, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let n = ((i * 2654435761) / 65536) % 24 - 12
      let c = fn v -> if v + n < 0 do 0 else if v + n > 255 do 255 else v + n end end
      let a1 = NativeArray.set_u8(NativeArray.set_u8(a, i * 4, c(r)), i * 4 + 1, c(g))
      tile_px(NativeArray.set_u8(NativeArray.set_u8(a1, i * 4 + 2, c(b)), i * 4 + 3, 255), i + 1, r, g, b)
    end
  end
  pfn textures(reg : Strata.Blocks.Registry) : Bool do
    Strata.Ffi.Vk.textures_create(16, 4)
      && Strata.Ffi.Vk.texture_set(0, tile_px(NativeArray.make_u8(1024, 0), 0, 255, 0, 255))
      && Strata.Ffi.Vk.texture_set(1, tile_px(NativeArray.make_u8(1024, 0), 0, 128, 126, 120))
      && Strata.Ffi.Vk.texture_set(2, tile_px(NativeArray.make_u8(1024, 0), 0, 150, 92, 70))
      && Strata.Ffi.Vk.texture_set(3, tile_px(NativeArray.make_u8(1024, 0), 0, 95, 90, 84))
      && Strata.Ffi.Vk.textures_commit() && Strata.Render.upload_blocks(reg)
  end

  pfn settle(s : Strata.Stream.Stream, n : Int) : Strata.Stream.Stream do
    if n >= 100000 do s else let s2 = Strata.Stream.tick(s)
      if Strata.Stream.settled(s2) do s2 else settle(s2, n + 1) end end
  end

  pfn edit(s : Strata.Stream.Stream, o : Strata.Edit.Outcome) : Strata.Stream.Stream do Strata.Stream.apply(s, o) end
  pfn fill(s : Strata.Stream.Stream, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int, id : Int) : Strata.Stream.Stream do
    edit(s, Strata.Edit.fill_box(Strata.Stream.world(s), x0, y0, z0, x1, y1, z1, id))
  end

  -- the field's features: a hollow building with a door, a tall wall, a low wall, two pillars
  pfn features(s : Strata.Stream.Stream) : Strata.Stream.Stream do
    let b0 = fill(s, 8, 0, -24, 27, 8, -9, 2)
    let b1 = fill(b0, 9, 0, -23, 26, 7, -10, 0)
    let b2 = fill(b1, 16, 0, -9, 19, 3, -9, 0)
    let w0 = fill(b2, -32, 0, 10, -8, 5, 10, 2)
    let w1 = fill(w0, -6, 0, 24, 10, 1, 24, 2)
    let p0 = fill(w1, -20, 0, -20, -19, 6, -19, 2)
    settle(fill(p0, 30, 0, 14, 31, 6, 15, 2), 0)
  end

  -- ── Units ────────────────────────────────────────────────────────────────
  -- id, team (0 or 1), tile
  type Squaddie = Squaddie(Int, Int, (Int, Int))

  pfn unit_id(u : Squaddie) : Int do match u do Squaddie(i, _, _) -> i end end
  pfn unit_team(u : Squaddie) : Int do match u do Squaddie(_, t, _) -> t end end
  pfn unit_tile(u : Squaddie) : (Int, Int) do match u do Squaddie(_, _, t) -> t end end
  pfn find_unit(us : List(Squaddie), id : Int) : Option(Squaddie) do List.find(us, fn u -> unit_id(u) == id) end
  pfn move_unit(us : List(Squaddie), id : Int, t : (Int, Int)) : List(Squaddie) do
    List.map(us, fn u -> match u do Squaddie(i, tm, old) -> if i == id do Squaddie(i, tm, t) else Squaddie(i, tm, old) end end)
  end
  pfn mover() : StrataTactics.Reach.Mover do StrataTactics.Reach.mover(5, 2, 3, 3) end
  pfn label(id : Int) : String do (if id < 3 do "Blue " else "Red " end) ++ int_to_string(id) end

  -- open for the mover's side, pass-through for an ally, blocked for an enemy
  pfn pass_for(us : List(Squaddie), team : Int) : (Int, Int) -> Int do
    fn t -> match List.find(us, fn u -> unit_tile(u) == t) do
      None -> StrataTactics.Reach.pass_open()
      Some(u) -> if unit_team(u) == team do StrataTactics.Reach.pass_through() else StrataTactics.Reach.pass_blocked() end
    end
  end

  -- a unit drawn as a box: four sides and a top, 1.6 m wide and 2.6 m tall, in its team's colour
  pfn unit_box(g : StrataTactics.Grid.TileGrid, u : Squaddie, active : Bool) : List(Strata.Overlay.Item) do
    match StrataTactics.Grid.centre(g, unit_tile(u)) do
      (x, y, z) ->
        let h = 0.8
        let top = y +. 2.6
        let base = if unit_team(u) == 0 do (0.2, 0.45, 1.0) else (1.0, 0.25, 0.2) end
        let rgba = match base do (r, gg, b) -> if active do (r, gg, b, 0.95) else (r *. 0.8, gg *. 0.8, b *. 0.8, 0.85) end end
        [Strata.Overlay.quad([(x -. h, y, z -. h), (x +. h, y, z -. h), (x -. h, top, z -. h), (x +. h, top, z -. h)], rgba, false),
         Strata.Overlay.quad([(x -. h, y, z +. h), (x +. h, y, z +. h), (x -. h, top, z +. h), (x +. h, top, z +. h)], rgba, false),
         Strata.Overlay.quad([(x -. h, y, z -. h), (x -. h, y, z +. h), (x -. h, top, z -. h), (x -. h, top, z +. h)], rgba, false),
         Strata.Overlay.quad([(x +. h, y, z -. h), (x +. h, y, z +. h), (x +. h, top, z -. h), (x +. h, top, z +. h)], rgba, false),
         Strata.Overlay.quad([(x -. h, top, z -. h), (x +. h, top, z -. h), (x -. h, top, z +. h), (x +. h, top, z +. h)], rgba, false)]
    end
  end

  -- ── The game's state ─────────────────────────────────────────────────────
  -- units; moved and acted this turn; the frame's controls; the last view-projection; the gui state
  type Game = { gm_units : List(Squaddie), gm_moved : Bool, gm_acted : Bool, gm_input : Strata.Input.Input, gm_vp : NativeFloatArr, gm_gui : Strata.Gui.GState, gm_shots : Int }

  pfn game_bindings() : List((String, Strata.Input.Source, Float)) do
    [("game.end_turn", Strata.Input.Key(32), 1.0), ("game.sight", Strata.Input.Key(84), 1.0), ("game.blast", Strata.Input.Key(66), 1.0), ("game.quit", Strata.Input.Key(256), 1.0)]
  end

  -- advance the clock to the next turn and follow that unit
  pfn next_turn(tac : StrataTactics.TacticsState, g : Game) : StrataTactics.TacticsState do
    match StrataTactics.Clock.advance(StrataTactics.clock(tac)) do
      (c, _) ->
        let t1 = StrataTactics.with_clock(tac, c)
        match StrataTactics.Clock.active(c) do
          None -> if StrataTactics.Clock.ticks(c) > 100000 do t1 else next_turn(t1, g) end
          Some(id) -> match find_unit(g.gm_units, id) do
            Some(u) -> StrataTactics.with_camera(t1, StrataTactics.Camera.follow(StrataTactics.camera(t1), StrataTactics.Grid.centre(StrataTactics.grid(t1), unit_tile(u))))
            None -> t1
          end
        end
    end
  end

  pfn active_unit(tac : StrataTactics.TacticsState, g : Game) : Option(Squaddie) do
    match StrataTactics.Clock.active(StrataTactics.clock(tac)) do Some(id) -> find_unit(g.gm_units, id) | None -> None end
  end

  pfn reach_of(tac : StrataTactics.TacticsState, g : Game, u : Squaddie) : StrataTactics.Reach.Reach do
    StrataTactics.Reach.find(StrataTactics.grid(tac), unit_tile(u), mover(), fn k -> 1, pass_for(g.gm_units, unit_team(u)))
  end

  -- the marks for this frame: units, the active unit's reach, the path to the tile under the pointer, sight and cover
  pfn marks(tac : StrataTactics.TacticsState, g : Game, w : Strata.World.World, hovered : Option((Int, Int)), sight : Bool) : StrataTactics.TacticsState do
    let gr = StrataTactics.grid(tac)
    let col = StrataTactics.Marks.colours()
    let act = active_unit(tac, g)
    let boxes = List.flat_map(g.gm_units, fn u -> unit_box(gr, u, match act do Some(a) -> unit_id(a) == unit_id(u) | None -> false end))
    let reach_marks = match act do
      None -> Nil
      Some(a) ->
        if g.gm_moved do Nil
        else
          let r = reach_of(tac, g, a)
          let ts = StrataTactics.Reach.tiles(r)
          let p = match hovered do Some(t) -> StrataTactics.Marks.path(gr, StrataTactics.Reach.path(r, t), col.mc_path) | None -> Nil end
          List.append(StrataTactics.Marks.tiles(gr, ts, col.mc_reach), List.append(StrataTactics.Marks.outline(gr, ts, col.mc_outline), p))
        end
    end
    let sight_marks = match (act, hovered, sight) do
      (Some(a), Some(t), true) ->
        let res = StrataTactics.Sight.line(w, gr, unit_tile(a), 2, t, 2)
        List.append(StrataTactics.Marks.sight(gr, unit_tile(a), t, res, col), StrataTactics.Marks.cover(w, gr, t, 3, StrataTactics.Sight.cover_settings(), col))
      _ -> Nil
    end
    StrataTactics.show(tac, List.append(boxes, List.append(reach_marks, sight_marks)))   -- plugin: the marks it draws
  end

  -- ── The frame loop ───────────────────────────────────────────────────────
  pfn blast_at(tac : StrataTactics.TacticsState, t : (Int, Int)) : Strata.Plugin.Request do
    let gr = StrataTactics.grid(tac)
    let gs = StrataTactics.Grid.settings_of(gr)
    match t do (tx, tz) ->
      Strata.Plugin.blast(gs.gs_x0 + tx * gs.gs_tile + gs.gs_tile / 2, StrataTactics.Grid.floor(gr, t) + 1, gs.gs_z0 + tz * gs.gs_tile + gs.gs_tile / 2, 4, tx * 31 + tz, 0)
    end
  end

  pfn frame_loop(s : Strata.Stream.Stream, sl : Strata.Render.Render, tac : StrataTactics.TacticsState, g : Game, frame : Int, frames : Int, t_prev : Float, vpbuf : NativeF32Arr) : Unit do
    Strata.Ffi.Vk.poll()
    let scripted = frames > 0
    let now = Strata.Ffi.Vk.time()
    let dt = if scripted do 1.0 /. 60.0 else (if now -. t_prev > 0.1 do 0.1 else now -. t_prev end) end
    let raw = if scripted do Strata.Input.idle() else Strata.Render.input(g.gm_input, 0) end
    let inp = Strata.Input.step(g.gm_input, raw)
    if Strata.Ffi.Vk.should_close() || Strata.Input.held(inp, "game.quit") || (scripted && frame >= frames) do ()
    else
      let ww = int_to_float(Strata.Ffi.Vk.win_w())
      let wh = int_to_float(Strata.Ffi.Vk.win_h())
      let pointer = if scripted do None else Some((Strata.Ffi.Vk.mouse_x(), Strata.Ffi.Vk.mouse_y())) end
      let f = Strata.Plugin.frame(Strata.Stream.world(s), inp, pointer, if scripted do 0.0 else Strata.Ffi.Vk.scroll_y() end, dt, ww, wh, g.gm_vp)   -- plugin: the frame
      match StrataTactics.update(tac, f) do                                                                                                        -- plugin: update
        (tac1, reqs0, evs) ->
          -- the scripted sequence's hover and actions; or the player's
          let hovered = if scripted do Some((15, 19)) else StrataTactics.hovered(tac1) end
          let clicked = List.filter_map(evs, fn e -> if StrataTactics.event_index(e) == 2 do StrataTactics.event_tile(e) else None end)
          let act = active_unit(tac1, g)
          -- a click on a reachable tile moves the active unit there
          let g1 = match (act, clicked) do
            (Some(a), Cons(t, _)) ->
              if !g.gm_moved && Option.is_some(StrataTactics.Reach.cost_to(reach_of(tac1, g, a), t)) && t != unit_tile(a) do { g with gm_units: move_unit(g.gm_units, unit_id(a), t), gm_moved: true } else g end
            _ -> g
          end
          -- B (or frame 20 of the script) blasts the tile under the pointer
          let blast_tile = if scripted do (if frame == 10 do Some((19, 15)) else None end) else (if Strata.Input.pressed(inp, "game.blast") do hovered else None end) end
          let reqs = match blast_tile do Some(t) -> List.append(reqs0, [blast_at(tac1, t)]) | None -> reqs0 end
          match Strata.Plugin.apply(Strata.Stream.world(s), reqs) do                                                                                  -- plugin: apply requests
            (w2, outs, _) ->
              let s2 = List.fold_left(outs, s, fn (acc, o) -> edit(acc, o))
              let tac2 = StrataTactics.world_changed(tac1, w2, outs)                                                                                  -- plugin: the world changed
              let tac3 = match blast_tile do
                Some(t) -> StrataTactics.with_camera(tac2, StrataTactics.Camera.look(StrataTactics.camera(tac2), g1.gm_shots, StrataTactics.Grid.centre(StrataTactics.grid(tac2), t), 0.6))
                None -> tac2
              end
              let g2 = if Option.is_some(blast_tile) do { g1 with gm_acted: true, gm_shots: g1.gm_shots + 1 } else g1 end
              -- Space ends the turn
              let ending = !scripted && Strata.Input.pressed(inp, "game.end_turn")
              let (tac4, g3) = if ending do
                  let t5 = StrataTactics.with_clock(tac3, StrataTactics.Clock.end_turn(StrataTactics.clock(tac3), g2.gm_moved, g2.gm_acted))
                  (next_turn(t5, g2), { g2 with gm_moved: false, gm_acted: false })
                else (tac3, g2) end
              -- the scripted camera turns 45 degrees at frame 30
              let tac5 = if scripted && frame == 30 do StrataTactics.with_camera(tac4, StrataTactics.Camera.step(StrataTactics.camera(tac4), Strata.Input.step(Strata.Input.start(Strata.Input.new(StrataTactics.Camera.bindings())), Strata.Input.raw([69], Nil, Nil, Nil)), None, 0.0, ww, wh, 0.0, fn (x, z) -> 0.0)) else tac4 end
              let tac6 = marks(tac5, g3, w2, hovered, scripted || Strata.Input.held(inp, "game.sight"))
              -- the stream and the renderer
              let s3 = Strata.Stream.tick(s2)
              match Strata.Render.sync(sl, s3) do
                (sl2, s4) ->
                  let subject = match active_unit(tac6, g3) do
                    Some(a) -> match StrataTactics.Grid.centre(StrataTactics.grid(tac6), unit_tile(a)) do (x, y, z) -> Some((x, y +. 1.5, z)) end
                    None -> None
                  end
                  if Strata.Render.overlay(StrataTactics.overlay(tac6, subject)) do () else () end                                                  -- plugin: overlay
                  let aspect = if wh > 0.0 do ww /. wh else 1.6 end
                  let vp = StrataTactics.view_proj(tac6, aspect)                                                                                    -- plugin: the camera shown
                  let vpb = TxM.write_f32(vp, vpbuf)
                  Strata.Ffi.Vk.set_camera(vpb)
                  match StrataTactics.Camera.eye(StrataTactics.camera(tac6)) do (ex, ey, ez) -> Strata.Ffi.Vk.set_eye(ex, ey, ez, 1.0) end
                  -- the turn order panel
                  let u0 = Strata.Render.ui_begin(1.0)
                  let gf = Strata.Gui.frame(pointer, Strata.Input.held(inp, "tactics.select"), 0.0, Nil, inp)
                  let (gst, gres) = Strata.Gui.run(g3.gm_gui, Strata.GuiDraw.theme(), gf, ww, wh, [Strata.Gui.place(Strata.Ui.top_right(), 12.0, 12.0, Strata.Gui.panel(Strata.Gui.fit(), Strata.Gui.fit(), [StrataTactics.gui(tac6, label, 6)]))])   -- plugin: gui
                  let u1 = Strata.GuiDraw.paint(u0, gres)
                  let u2 = Strata.Text.text(u1, Strata.Ui.bottom_left(), 12.0, 12.0, Strata.Text.default_font(), 14.0, (1.0, 1.0, 1.0, 1.0), "click: move   T: sight and cover   B: blast   Space: end turn   WASD QE RF PgUp/PgDn: camera")
                  if Strata.Render.draw_ui(u2) do () else () end
                  Strata.Render.set_time(if scripted do int_to_float(frame) /. 60.0 else now end)
                  if scripted && frame == frames - 3 do Strata.Ffi.Vk.request_shot() else () end
                  let next = if Strata.Render.draw(1.0) do frame + 1 else frame end
                  frame_loop(s4, sl2, tac6, { g3 with gm_input: inp, gm_vp: vp, gm_gui: gst }, next, frames, now, vpb)
              end
          end
      end
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let frames = Authority.must(Env.get_int("STRATA_FRAMES", 0))
    if !Strata.Ffi.Vk.open(1280, 800, false, 0) do Authority.must(println("tactics_example: could not open a Vulkan window"))
    else
      Strata.Ffi.Vk.set_offscreen(Authority.must(Env.get_int("STRATA_OFFSCREEN", 0)) == 1)
      Strata.Ffi.Vk.set_lighting(4)
      let reg = registry()
      if Strata.Render.set_light_box(5, 3) do () else Authority.must(println("tactics_example: no light volume")) end
      if textures(reg) do () else Authority.must(println("tactics_example: could not upload textures")) end
      Strata.Render.set_sun(0.45, 0.82, 0.35, 1.0, 0.92, 0.8)
      Strata.Ffi.Vk.set_fog(140.0, 260.0)
      let w0 = Strata.World.new(reg, gen(), 7, 1.0)
      let s0 = settle(Strata.Stream.set_focus(Strata.Stream.start(w0, Strata.Stream.config(5, 3, 64, 8)), [(0.0, 0.0, 0.0)]), 0)
      let s1 = features(s0)
      -- plugin: setup, and the game's bindings merged with the plugin's (the game first)
      let gs = StrataTactics.Grid.settings(-48, -48, 24, 24, 4, 1, -4, 20, 2, fn id -> id)
      let t_build = Strata.Ffi.Vk.time()
      match StrataTactics.setup(StrataTactics.config(gs), reg, Strata.Stream.world(s1)) do
        (tac0, _, tac_bindings) ->
          Authority.must(println("tactics_example: grid of 24 x 24 tiles read in " ++ int_to_string(float_to_int((Strata.Ffi.Vk.time() -. t_build) *. 1000.0)) ++ " ms (release)"))
          match Strata.Input.merge([("game", game_bindings()), ("tactics", tac_bindings)]) do
            (bindings, clashes) ->
              let _said = List.map(clashes, fn c -> Authority.must(println("tactics_example: " ++ Strata.Input.clash_loser_action(c) ++ " lost its key to " ++ Strata.Input.clash_winner_action(c))))
              let units = [Squaddie(1, 0, (3, 3)), Squaddie(2, 0, (5, 4)), Squaddie(3, 1, (19, 19)), Squaddie(4, 1, (17, 20))]
              let clock = List.fold_left(units, StrataTactics.Clock.start(StrataTactics.Clock.settings()), fn (c, u) -> StrataTactics.Clock.add(c, unit_id(u), 6 + unit_id(u), 0))
              let g0 = { gm_units: units, gm_moved: false, gm_acted: false, gm_input: Strata.Input.start(Strata.Input.new(bindings)), gm_vp: TxM.identity(), gm_gui: Strata.Gui.start(), gm_shots: 1 }
              let tac1 = next_turn(StrataTactics.with_clock(tac0, clock), g0)
              match Strata.Render.sync(Strata.Render.new(16384), s1) do
                (sl, s2) -> frame_loop(s2, sl, tac1, g0, 0, frames, Strata.Ffi.Vk.time(), NativeArray.make_f32(16, 0.0))
              end
          end
      end
      Strata.Ffi.Vk.close()
    end
  end
end
