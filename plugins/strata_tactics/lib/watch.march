-- Watch — arcs a unit holds over the ground, and which of them a step sets off.
--
-- An arc is held by its owner from a tile, facing a direction (radians:
-- 0 is +x, pi/2 is +z), so many radians wide, out to so many tiles (measured
-- between tile centres). It covers a tile inside both; never its own tile.
-- What firing means, and for how long an arc is held, is the game's.
mod StrataTactics.Watch do

  -- an arc: its owner (the game's unit id), the tile it is held from, its direction and width (radians) and its range (tiles)
  type Arc = { wa_owner : Int, wa_from : (Int, Int), wa_dir : Float, wa_width : Float, wa_range : Int }

  doc "An arc held by [owner] from tile [from], facing [dir], [width] wide, out to [range] tiles."
  fn arc(owner : Int, from : (Int, Int), dir : Float, width : Float, range : Int) : Arc do
    { wa_owner: owner, wa_from: from, wa_dir: dir, wa_width: width, wa_range: range }
  end

  -- the difference of two angles wrapped into -pi .. pi
  pfn absf(v : Float) : Float do if v < 0.0 do 0.0 -. v else v end end
  pfn wrapped(a : Float) : Float do
    let tau = 2.0 *. Math.pi()
    let m = a -. tau *. Math.floor((a +. Math.pi()) /. tau)
    m
  end

  doc "Does arc [a] cover tile [t]: within its range and inside its width, not its own tile?"
  fn covers(a : Arc, t : (Int, Int)) : Bool do
    match (a.wa_from, t) do
      ((fx, fz), (tx, tz)) ->
        let dx = int_to_float(tx - fx)
        let dz = int_to_float(tz - fz)
        let d2 = dx *. dx +. dz *. dz
        let r = int_to_float(a.wa_range)
        if d2 < 0.5 || d2 > r *. r +. 0.0001 do false
        else absf(wrapped(Math.atan2(dz, dx) -. a.wa_dir)) <= a.wa_width /. 2.0 +. 0.000001 end
    end
  end

  doc "The tiles of grid [g] arc [a] covers, in row order."
  fn tiles(g : StrataTactics.Grid.TileGrid, a : Arc) : List((Int, Int)) do
    let w = StrataTactics.Grid.width(g)
    let n = w * StrataTactics.Grid.depth(g)
    List.filter(List.map(List.range(0, n), fn i -> (i % w, i / w)), fn t -> covers(a, t))
  end

  doc "The arcs of [arcs] covering tile [t] whose owners [sees] passes, in list order: what a step into [t] sets off."
  fn triggered(arcs : List(Arc), t : (Int, Int), sees : Arc -> Bool) : List(Arc) do
    List.filter(arcs, fn a -> covers(a, t) && sees(a))
  end
end
