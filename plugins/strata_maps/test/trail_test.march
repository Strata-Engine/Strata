-- Trails: on ground no route crosses, two graded tracks from the north edge to the south.
mod StrataMaps.Test.Trail do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.TrailStage as MapTr
  alias StrataMaps.Test.Blocks as MapTrb

  pfn mover() : StrataTactics.Reach.Mover do StrataTactics.Reach.mover(6, 2, 3, 12) end
  pfn steep(seed : Int) : StrataMaps.Data.MapData do StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(MapTrb.data_for(seed, 16, 2, 0.95, 0.25))) end

  describe "TrailStage" do
    test "ground a route already crosses gets no trails" do
      let d = StrataMaps.TerrainStage.run(MapTrb.data_for(3, 16, 0, 0.1, 0.0))
      Test.assert_true(List.is_empty(MapTr.paths(d, mover())), "none")
    end
    test "steep ground gets trails, and then a route crosses it" do
      -- the first seed from 1 whose highlands no route crosses
      let d = List.fold_left(List.range(1, 12), steep(1), fn (acc, s) -> if StrataMaps.Check.early(acc, mover()) do steep(s) else acc end)
      Test.assert_true(!StrataMaps.Check.early(d, mover()), "a steep map to start from")
      let t = MapTr.run(d, mover())
      Test.assert_true(List.length(MapTr.paths(d, mover())) == 2, "two trails")
      Test.assert_true(StrataMaps.Check.early(t, mover()), "a route crosses now")
    end
  end

  -- a level, dry 3 x 2 block of tiles in the two rows from row r, or a 6-tile strip along the outer row: its tiles' middles within 2 steps of each other
  pfn has_landing(d : StrataMaps.Data.MapData, r : Int) : Bool do
    match StrataMaps.Data.playable(d) do
      (px, pz, n) ->
        let t = n / 8
        let outer = if r == 0 do 0 else t - 1 end
        List.any(List.range(0, t - 2), fn x0 -> level_tiles(d, px, pz, List.map(List.range(0, 6), fn k -> (x0 + k % 3, r + k / 3))))
          || List.any(List.range(0, t - 5), fn x0 -> level_tiles(d, px, pz, List.map(List.range(0, 6), fn k -> (x0 + k, outer))))
    end
  end
  pfn level_tiles(d : StrataMaps.Data.MapData, px : Int, pz : Int, tiles : List((Int, Int))) : Bool do
    let cols = List.map(tiles, fn t -> match t do (tx, tz) -> (px + tx * 8 + 4, pz + tz * 8 + 4) end)
    let hs = List.map(cols, fn c -> match c do (x, z) -> Strata.Heights.get(d.md_heights, x, z) end)
    List.fold_left(hs, -100000, fn (a, v) -> Math.max_int(a, v)) - List.fold_left(hs, 100000, fn (a, v) -> Math.min_int(a, v)) <= 2 * d.md_settings.ms_step
      && List.all(cols, fn c -> match c do (x, z) -> StrataMaps.Data.water_at(d, x, z) < 0 end)
  end

  describe "TrailStage landings" do
    test "steep ground gets a level landing on both edges" do
      let ds = List.map(List.range(1, 6), fn sd -> MapTr.run(steep(sd), mover()))
      Test.assert_true(List.all(ds, fn d -> has_landing(d, 0) && has_landing(d, 14)), "a landing in the north rows and the south rows of every map")
    end
  end
end
