-- The ruin pass: blasts on buildings, nothing left hanging, rubble below, the same seed the same ruin.
mod StrataMaps.Test.Ruin do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.RuinStage as MapRu
  alias StrataMaps.Test.Blocks as MapRub

  -- 20 plain blocks for the ids the test blocks use
  pfn reg() : Strata.Blocks.Registry do
    List.fold_left(List.range(0, 20), Strata.Blocks.empty(), fn (r, i) -> match Strata.Blocks.register(r, Strata.Blocks.with_faces(Strata.Blocks.def(), 1, 1, 1)) do Ok((r2, _)) -> r2 | Err(_) -> r end)
  end
  pfn style() : Strata.Building.BldStyle do { Strata.Building.style(6, 2, 3, 6, 5) with bs_storeys: (3, 3), bs_door: 2 } end
  pfn town(seed : Int, ruin : Float) : StrataMaps.Data.MapData do
    let d0 = MapRub.data_for(seed, 16, 0, 0.0, 0.0)
    let k = StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(d0.md_settings.ms_knobs, "settlement", 0.6), "density", 0.6), "ruin", ruin)
    let d1 = { d0 with md_settings: { d0.md_settings with ms_knobs: k } }
    StrataMaps.BuildStage.run(StrataMaps.SettleStage.run(StrataMaps.TerrainStage.run(d1)), [style()])
  end
  pfn ruined(seed : Int, ruin : Float) : (List(Strata.Plugin.Request), StrataMaps.Data.MapData) do
    let d = town(seed, ruin)
    MapRu.run(d, MapRu.scratch(d, reg()))
  end
  -- a fresh scratch world with the requests applied: the world and every change
  pfn applied(d : StrataMaps.Data.MapData, reqs : List(Strata.Plugin.Request)) : (Strata.World.World, List(Strata.Edit.Change)) do
    match Strata.Plugin.apply(MapRu.scratch(d, reg()), reqs) do
      (w, outs, _) -> (w, List.flat_map(outs, fn o -> Strata.Edit.changes(o)))
    end
  end
  pfn count_id(w : Strata.World.World, d : StrataMaps.Data.MapData, id : Int) : Int do
    match StrataMaps.Data.playable(d) do
      (px, pz, n) -> List.length(List.filter(List.range(0, (n / 2) * (n / 2) * 24), fn i -> Strata.World.get_block(w, px + (i % (n / 2)) * 2, 8 + i / ((n / 2) * (n / 2)), pz + ((i / (n / 2)) % (n / 2)) * 2) == id))
    end
  end

  describe "RuinStage" do
    test "ruin 0 makes no requests" do
      match ruined(3, 0.0) do (reqs, _) -> Test.assert_true(List.is_empty(reqs), "none") end
    end
    test "after the pass nothing is left unsupported" do
      match ruined(4, 0.9) do
        (reqs, d) ->
          Test.assert_true(!List.is_empty(reqs), "something was ruined")
          match applied(d, reqs) do
            (w, cs) -> Test.assert_true(List.is_empty(Strata.Support.pieces(Strata.Support.loose(reg(), w, cs, 0, 0.4))), "no loose piece")
          end
      end
    end
    test "rubble lies below where buildings broke" do
      match ruined(5, 0.9) do
        (reqs, d) -> match applied(d, reqs) do
          (w, _) -> Test.assert_true(count_id(w, d, 18) > 0, "rubble on the ground")
        end
      end
    end
    test "the same seed ruins the same way" do
      match (ruined(6, 0.7), ruined(6, 0.7)) do
        ((a, d), (b, _)) ->
          Test.assert_true(List.length(a) == List.length(b) && !List.is_empty(a), "as many requests")
          match (applied(d, a), applied(d, b)) do
            ((wa, _), (wb, _)) -> Test.assert_true(List.all(List.range(0, 48), fn i -> Strata.World.get_block(wa, i - 24, 12, 3) == Strata.World.get_block(wb, i - 24, 12, 3) && Strata.World.get_block(wa, 5, 9 + i / 4, i - 24) == Strata.World.get_block(wb, 5, 9 + i / 4, i - 24)), "the same blocks")
          end
      end
    end
  end
end
