-- WorldGen: the map as a terrain generator.
mod StrataMaps.Test.WorldGen do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.WorldGen as MapWg
  alias StrataMaps.Test.Blocks as MapWgb

  pfn made() : StrataMaps.Data.MapData do StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(MapWgb.data_for(11, 16, 1, 0.5, 0.5))) end
  pfn top_of(c : Strata.Chunk.Chunk, i : Int, k : Int, cy : Int) : Int do
    List.fold_left(List.range(0, 32), -1000, fn (t, y) -> let id = Strata.Chunk.get_or(c, i, y, k, 0)
      if id == 1 || id == 2 || id == 3 || id == 4 do cy * 32 + y + 1 else t end)
  end

  describe "WorldGen" do
    test "a chunk's columns match the height field" do
      let d = made()
      let g = MapWg.gen(d)
      let c = Strata.Terrain.run(g, Strata.Coord.key(0, 0, 0), 0)
      Test.assert_true(List.all(List.range(0, 16), fn j -> top_of(c, j, j, 0) == Strata.Heights.get(d.md_heights, j, j) || Strata.Heights.get(d.md_heights, j, j) > 32), "tops match")
    end
    test "water columns hold water up to their level" do
      let d = made()
      let g = MapWg.gen(d)
      let x = 0
      let c0 = StrataMaps.Data.corner(d.md_settings)
      let wet = List.filter(List.range(c0, c0 + 384), fn z -> StrataMaps.Data.water_at(d, x, z) >= 0)
      let z = List.head(wet)
      let lv = StrataMaps.Data.water_at(d, x, z)
      let ck = Strata.Terrain.run(g, Strata.Coord.key(0, Strata.Coord.chunk_of(lv - 1), Strata.Coord.chunk_of(z)), 0)
      Test.assert_true(Strata.Chunk.get_or(ck, 0, Strata.Coord.local_of(lv - 1), Strata.Coord.local_of(z), 0) == 7, "water just under the level")
    end
    test "a chunk beyond the ring is flat ground" do
      let g = MapWg.gen(made())
      let c = Strata.Terrain.run(g, Strata.Coord.key(40, 0, 40), 0)
      Test.assert_true(List.all(List.range(0, 32), fn j -> top_of(c, j, 3, 0) == top_of(c, 3, j, 0)), "flat")
    end
    test "a chunk under the deepest valley is stone, one over the highest ground air" do
      let g = MapWg.gen(made())
      Test.assert_true(Strata.Chunk.uniform_id(Strata.Terrain.run(g, Strata.Coord.key(0, -3, 0), 0)) == 1 && Strata.Chunk.uniform_id(Strata.Terrain.run(g, Strata.Coord.key(0, 6, 0), 0)) == 0, "stone below, air above")
    end
    test "the same data gives the same chunks" do
      let a = Strata.Chunk.hash(Strata.Terrain.run(MapWg.gen(made()), Strata.Coord.key(1, 0, -1), 0))
      let b = Strata.Chunk.hash(Strata.Terrain.run(MapWg.gen(made()), Strata.Coord.key(1, 0, -1), 0))
      Test.assert_true(a == b, "same hash")
    end
  end
end
