-- WorldGen: the map as a terrain generator.
mod StrataMaps.Test.WorldGen do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.WorldGen as MapWg
  alias StrataMaps.Test.Blocks as MapWgb

  pfn made() : StrataMaps.Data.MapData do StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(MapWgb.data_for(11, 16, 1, 0.5, 0.5))) end
  pfn top_of(c : Strata.Chunk.Chunk, i : Int, k : Int, cy : Int) : Int do
    List.fold_left(List.range(0, 32), -1000, fn (t, y) -> let id = Strata.Chunk.get_or(c, i, y, k, 0)
      if id == 1 || id == 2 || id == 3 || id == 4 do cy * 32 + y + 1 else t end)
  end

  describe "WorldGen" do
    test "a chunk's columns match the height field" do
      let d = made()
      let g = MapWg.gen(d)
      let c = Strata.Terrain.run(g, Strata.Coord.key(0, 0, 0), 0)
      Test.assert_true(List.all(List.range(0, 16), fn j -> top_of(c, j, j, 0) == Strata.Heights.get(d.md_heights, j, j) || Strata.Heights.get(d.md_heights, j, j) > 32), "tops match")
    end
    test "water columns hold water up to their level" do
      let d = made()
      let g = MapWg.gen(d)
      let x = 0
      let c0 = StrataMaps.Data.corner(d.md_settings)
      let wet = List.filter(List.range(c0, c0 + 384), fn z -> StrataMaps.Data.water_at(d, x, z) >= 0)
      let z = List.head(wet)
      let lv = StrataMaps.Data.water_at(d, x, z)
      let ck = Strata.Terrain.run(g, Strata.Coord.key(0, Strata.Coord.chunk_of(lv - 1), Strata.Coord.chunk_of(z)), 0)
      Test.assert_true(Strata.Chunk.get_or(ck, 0, Strata.Coord.local_of(lv - 1), Strata.Coord.local_of(z), 0) == 7, "water just under the level")
    end
    test "a chunk beyond the ring is flat ground" do
      let g = MapWg.gen(made())
      let c = Strata.Terrain.run(g, Strata.Coord.key(40, 0, 40), 0)
      Test.assert_true(List.all(List.range(0, 32), fn j -> top_of(c, j, 3, 0) == top_of(c, 3, j, 0)), "flat")
    end
    test "a chunk under the deepest valley is stone, one over the highest ground air" do
      let g = MapWg.gen(made())
      Test.assert_true(Strata.Chunk.uniform_id(Strata.Terrain.run(g, Strata.Coord.key(0, -3, 0), 0)) == 1 && Strata.Chunk.uniform_id(Strata.Terrain.run(g, Strata.Coord.key(0, 6, 0), 0)) == 0, "stone below, air above")
    end
    test "the same data gives the same chunks" do
      let a = Strata.Chunk.hash(Strata.Terrain.run(MapWg.gen(made()), Strata.Coord.key(1, 0, -1), 0))
      let b = Strata.Chunk.hash(Strata.Terrain.run(MapWg.gen(made()), Strata.Coord.key(1, 0, -1), 0))
      Test.assert_true(a == b, "same hash")
    end
  end

  -- ── Everything on the map ──
  pfn flat_map(seed : Int) : StrataMaps.Data.MapData do StrataMaps.TerrainStage.run(MapWgb.data_for(seed, 16, 0, 0.0, 0.0)) end
  pfn chunk(d : StrataMaps.Data.MapData, cx : Int, cy : Int, cz : Int) : Strata.Chunk.Chunk do Strata.Terrain.run(MapWg.gen(d), Strata.Coord.key(cx, cy, cz), 0) end
  pfn block(d : StrataMaps.Data.MapData, x : Int, y : Int, z : Int) : Int do
    Strata.Chunk.get_or(chunk(d, int_div_euclid(x, 32), int_div_euclid(y, 32), int_div_euclid(z, 32)), int_mod_euclid(x, 32), int_mod_euclid(y, 32), int_mod_euclid(z, 32), -1)
  end
  -- a 40 x 6 x 40 box of block 6 with a hole through its middle, standing at (-20, 8, -20): it spans four chunks
  pfn boxy() : Strata.Template.Template do
    Strata.Template.make(40, 6, 40, List.fold_left(List.range(0, 40 * 6 * 40), NativeArray.make_i32(9600, 0), fn (a, i) ->
      let x = i % 40
      let z = i / 240
      if x >= 18 && x <= 21 && z >= 18 && z <= 21 do a else NativeArray.set_i32(a, i, 6) end), 0.4)
  end
  pfn with_box(d : StrataMaps.Data.MapData) : StrataMaps.Data.MapData do
    let lot = Strata.Lots.lot(-20, -20, 19, 19, 3)
    let p = Strata.Building.plan(lot, Strata.Building.style(6, 2, 3, 6, 5), 1)
    { d with md_buildings: [{ mbd_plan: p, mbd_template: boxy(), mbd_origin: (-20, 8, -20) }] }
  end

  describe "WorldGen, everything" do
    test "a building spanning four chunks is whole when they are joined" do
      let d = with_box(flat_map(1))
      Test.assert_true(List.all(List.range(0, 40 * 40), fn i ->
        let x = i % 40
        let z = i / 40
        let hole = x >= 18 && x <= 21 && z >= 18 && z <= 21
        let id = block(d, x - 20, 10, z - 20)
        if hole do id != 6 else id == 6 end), "every column of the box, the hole kept")
    end
    test "lots are concrete, scorched ground is scorched, lava fills to its level" do
      let d0 = flat_map(2)
      let c = StrataMaps.Data.corner(d0.md_settings)
      let n = StrataMaps.Settings.side_voxels(d0.md_settings)
      let i = (0 - c) * n + (0 - c)
      let top = Strata.Heights.get(d0.md_heights, 0, 0)
      let d = { d0 with md_lots: [Strata.Lots.lot(10, 10, 14, 14, 0)], md_scorched: NativeArray.set_int(d0.md_scorched, (0 - c) * n + (20 - c), 1), md_lava: NativeArray.set_int(d0.md_lava, i, top + 2) }
      Test.assert_true(block(d, 12, Strata.Heights.get(d.md_heights, 12, 12) - 1, 12) == 6, "concrete under a lot")
      Test.assert_true(block(d, 20, Strata.Heights.get(d.md_heights, 20, 0) - 1, 0) == 19, "scorched")
      Test.assert_true(block(d, 0, top, 0) == 17 && block(d, 0, top + 1, 0) == 17 && block(d, 0, top + 2, 0) == 0, "lava up to its level")
    end
    test "roads are painted with their surface" do
      match Strata.Roads.add_node(Strata.Roads.graph(), -8.0, 2.0) do
        (g1, a) -> match Strata.Roads.add_node(g1, 8.0, 2.0) do
          (g2, b) ->
            let g = Strata.Roads.add_segment(g2, a, b, 3.2, 5)
            let d0 = flat_map(3)
            let d = { d0 with md_roads: g }
            Test.assert_true(block(d, 0, Strata.Heights.get(d.md_heights, 0, 5) - 1, 5) == 5, "asphalt on the road's column")
        end
      end
    end
  end
end
