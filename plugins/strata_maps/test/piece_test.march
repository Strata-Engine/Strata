-- Set pieces: placed by zone, never on buildings, water or each other.
mod StrataMaps.Test.Piece do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.PieceStage as MapPc
  alias StrataMaps.Test.Blocks as MapPcb

  pfn crate(sx : Int, sz : Int) : Strata.Template.Template do Strata.Template.make(sx, 2, sz, NativeArray.make_i32(sx * 2 * sz, 18), 0.4) end
  pfn pieces() : List(StrataMaps.PieceStage.MapPiece) do
    [{ mp_template: crate(3, 5), mp_zone: 3, mp_per_map: (2, 4), mp_needs_flat: false },
     { mp_template: crate(2, 4), mp_zone: 2, mp_per_map: (1, 2), mp_needs_flat: false },
     { mp_template: crate(2, 2), mp_zone: 0, mp_per_map: (1, 3), mp_needs_flat: false }]
  end
  pfn style() : Strata.Building.BldStyle do { Strata.Building.style(6, 2, 3, 6, 5) with bs_coverage: 0.6 } end
  pfn made(seed : Int) : StrataMaps.Data.MapData do
    let d0 = MapPcb.data_for(seed, 16, 1, 0.2, 0.4)
    let k = StrataMaps.Settings.with_knob(d0.md_settings.ms_knobs, "settlement", 0.5)
    let d1 = { d0 with md_settings: { d0.md_settings with ms_knobs: k } }
    MapPc.run(StrataMaps.BuildStage.run(StrataMaps.SettleStage.run(StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(d1))), [style()]), pieces())
  end
  pfn feet(p : StrataMaps.Data.MapPlaced) : List((Int, Int)) do
    match p.mpl_origin do (ox, oy, oz) -> match Strata.Template.bounds(p.mpl_template, ox, oy, oz, p.mpl_rot) do
      (x0, _, z0, x1, _, z1) -> List.map(List.range(0, (x1 - x0 + 1) * (z1 - z0 + 1)), fn i -> (x0 + i % (x1 - x0 + 1), z0 + i / (x1 - x0 + 1)))
    end end
  end
  pfn on_road(d : StrataMaps.Data.MapData, c : (Int, Int)) : Bool do match c do (x, z) -> Option.is_some(Strata.Roads.at(d.md_roads, (int_to_float(x) +. 0.5) *. 0.4, (int_to_float(z) +. 0.5) *. 0.4)) end end
  pfn in_lot(d : StrataMaps.Data.MapData, c : (Int, Int)) : Bool do
    List.any(d.md_lots, fn l -> match (Strata.Lots.lot_box(l), c) do ((x0, z0, x1, z1), (x, z)) -> x >= x0 && x <= x1 && z >= z0 && z <= z1 end)
  end
  pfn on_building(d : StrataMaps.Data.MapData, c : (Int, Int)) : Bool do
    List.any(d.md_buildings, fn b -> List.any(Strata.Building.footprint(b.mbd_plan), fn f -> match (f, c) do ((x0, z0, x1, z1), (x, z)) -> x >= x0 && x <= x1 && z >= z0 && z <= z1 end))
  end
  pfn dry(d : StrataMaps.Data.MapData, c : (Int, Int)) : Bool do match c do (x, z) -> StrataMaps.Data.water_at(d, x, z) < 0 end end
  pfn of_size(d : StrataMaps.Data.MapData, sx : Int) : List(StrataMaps.Data.MapPlaced) do
    List.filter(d.md_placed, fn p -> p.mpl_kind == 0 && Strata.Template.t_sz(p.mpl_template) * 10 + Strata.Template.t_sx(p.mpl_template) == sx)
  end

  describe "PieceStage" do
    test "pieces land only in their zone" do
      let d = made(3)
      Test.assert_true(List.all(of_size(d, 53), fn p -> List.all(feet(p), fn c -> !on_road(d, c) && !in_lot(d, c))), "open ground: no road, no lot")
      Test.assert_true(List.all(of_size(d, 42), fn p -> List.all(feet(p), fn c -> on_road(d, c))), "road pieces on the road")
      Test.assert_true(List.all(of_size(d, 22), fn p -> List.all(feet(p), fn c -> in_lot(d, c))), "yard pieces in a lot")
    end
    test "pieces never overlap buildings, water or each other" do
      let d = made(4)
      let all = List.flat_map(d.md_placed, fn p -> feet(p))
      Test.assert_true(List.all(all, fn c -> !on_building(d, c) && dry(d, c)), "clear of buildings and water")
      Test.assert_true(List.length(List.dedup(List.sort_by(all, fn (a, b) -> a < b))) == List.length(all), "no column twice")
    end
    test "counts stay within per_map" do
      let d = made(5)
      Test.assert_true(List.length(of_size(d, 53)) >= 2 && List.length(of_size(d, 53)) <= 4 && List.length(of_size(d, 42)) <= 2 && List.length(of_size(d, 22)) <= 3, "within the ranges")
    end
  end
end
