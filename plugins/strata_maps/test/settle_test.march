-- Roads and lots: a settled disc, a road pattern, bridges, lots facing streets.
mod StrataMaps.Test.Settle do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.SettleStage as MapSe
  alias StrataMaps.Test.Blocks as MapSeb

  -- terrain and water, then the knobs for the settlement
  pfn town(seed : Int, base : Int, relief : Float, water : Float, settle : Float, density : Float) : StrataMaps.Data.MapData do
    let d0 = MapSeb.data_for(seed, 16, base, relief, water)
    let k = StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(d0.md_settings.ms_knobs, "settlement", settle), "density", density)
    let d1 = { d0 with md_settings: { d0.md_settings with ms_knobs: k } }
    MapSe.run(StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(d1)))
  end
  pfn lot_cols(l : Strata.Lots.Lot) : List((Int, Int)) do
    match Strata.Lots.lot_box(l) do (x0, z0, x1, z1) -> List.map(List.range(0, (x1 - x0 + 1) * (z1 - z0 + 1)), fn i -> (x0 + i % (x1 - x0 + 1), z0 + i / (x1 - x0 + 1))) end
  end
  pfn on_road(d : StrataMaps.Data.MapData, x : Int, z : Int) : Bool do
    Option.is_some(Strata.Roads.at(d.md_roads, (int_to_float(x) +. 0.5) *. 0.4, (int_to_float(z) +. 0.5) *. 0.4))
  end
  pfn any_road(d : StrataMaps.Data.MapData, cs : List((Int, Int))) : Bool do List.any(cs, fn c -> match c do (x, z) -> on_road(d, x, z) end) end
  pfn fronted(d : StrataMaps.Data.MapData, l : Strata.Lots.Lot) : Bool do
    match Strata.Lots.lot_box(l) do
      (x0, z0, x1, z1) ->
        let s = Strata.Lots.lot_street(l)
        let cs = if s == 0 do List.map(List.range(z0, z1 + 1), fn z -> (x1 + 1, z)) else if s == 1 do List.map(List.range(z0, z1 + 1), fn z -> (x0 - 1, z))
          else if s == 2 do List.map(List.range(x0, x1 + 1), fn x -> (x, z1 + 1)) else List.map(List.range(x0, x1 + 1), fn x -> (x, z0 - 1)) end end end
        any_road(d, cs)
    end
  end

  describe "SettleStage" do
    test "settlement 0 makes no roads" do
      let d = town(3, 1, 0.3, 0.0, 0.0, 0.5)
      Test.assert_true(List.is_empty(Strata.Roads.segments(d.md_roads)) && List.is_empty(d.md_lots), "no roads, no lots")
    end
    test "every lot touches a road" do
      let d = town(3, 0, 0.1, 0.0, 0.6, 0.5)
      Test.assert_true(List.length(d.md_lots) >= 4, "a settlement's worth of lots")
      Test.assert_true(List.all(d.md_lots, fn l -> fronted(d, l)), "each faces a road")
    end
    test "no lot on water or on a tile steeper than 2 steps" do
      let d = town(4, 1, 0.4, 0.5, 0.7, 0.5)
      Test.assert_true(List.all(d.md_lots, fn l -> List.all(lot_cols(l), fn c -> match c do
        (x, z) -> StrataMaps.Data.water_at(d, x, z) < 0 && MapSe.level(d, x, z)
      end)), "dry and level enough")
    end
    test "a road across the river has a bridge" do
      let d = town(5, 1, 0.2, 0.5, 0.8, 0.5)
      Test.assert_true(!List.is_empty(d.md_bridges), "at least one bridge")
    end
    test "settlement 1 on a canyon reports too little room and places what fits" do
      let d = town(6, 3, 0.8, 0.0, 1.0, 0.5)
      Test.assert_true(List.any(d.md_reports, fn r -> String.starts_with(r, "settlement")), "a report line")
      Test.assert_true(!List.is_empty(d.md_lots), "some lots placed")
    end
  end
end
