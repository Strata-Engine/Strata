-- Check and generate: routes across the map, retries.
mod StrataMaps.Test.Check do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.Check as MapCk
  alias StrataMaps.Test.Blocks as MapCkb

  pfn made(seed : Int, base : Int, relief : Float, water : Float) : StrataMaps.Data.MapData do
    StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(MapCkb.data_for(seed, 16, base, relief, water)))
  end
  pfn blend_settings(seed : Int) : StrataMaps.Settings.MapSettings do
    let s0 = StrataMaps.Settings.settings(seed, 16)
    { s0 with ms_base: 1, ms_knobs: StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(s0.ms_knobs, "relief", 0.4), "water", 0.5) }
  end

  describe "Check" do
    test "an open plain has three routes" do
      Test.assert_true(MapCk.routes(made(1, 0, 0.0, 0.0), 4, 2) == 3, "three")
    end
    test "a river that cannot be waded allows no route" do
      Test.assert_true(MapCk.routes(made(2, 0, 0.0, 0.6), 4, 0) == 0, "none")
    end
    test "fords give at least two routes" do
      Test.assert_true(MapCk.routes(made(2, 0, 0.0, 0.6), 4, 2) >= 2, "two")
    end
    test "generate returns a passing map for an ordinary blend" do
      match StrataMaps.generate(blend_settings(5), MapCkb.ids(), 4, 2) do
        (_, d, r) -> Test.assert_true(r.cr_ok && r.cr_routes >= 2, "passes")
      end
    end
    test "a map that cannot pass returns the best attempt with reasons after 8 tries" do
      match StrataMaps.generate(blend_settings(6), MapCkb.ids(), 4, 0) do
        (_, _, r) -> Test.assert_true(!r.cr_ok && r.cr_attempts == 8 && !List.is_empty(r.cr_why), "fails with reasons")
      end
    end
  end
end
