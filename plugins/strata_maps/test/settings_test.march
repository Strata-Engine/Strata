-- Settings: knobs, blends, archetypes, sizes.
mod StrataMaps.Test.Settings do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.Settings as MapSt

  pfn ranges() : List((String, Float, Float)) do [("relief", 0.2, 0.4), ("water", 0.6, 0.9)] end

  pfn canyon(s : StrataMaps.Settings.MapSettings) : StrataMaps.Settings.MapSettings do { s with ms_base: 3, ms_knobs: MapSt.with_knob(s.ms_knobs, "relief", 0.8) } end

  describe "Settings" do
    test "blend draws each knob within its range" do
      Test.assert_true(List.all(List.range(0, 50), fn seed ->
        let k = (MapSt.blend(seed, ranges(), MapSt.settings(seed, 32))).ms_knobs
        k.mk_relief >= 0.2 && k.mk_relief <= 0.4 && k.mk_water >= 0.6 && k.mk_water <= 0.9 && k.mk_hazard == 0.0), "in range")
    end
    test "the same seed blends the same" do
      let a = (MapSt.blend(7, ranges(), MapSt.settings(7, 32))).ms_knobs
      let b = (MapSt.blend(7, ranges(), MapSt.settings(7, 32))).ms_knobs
      Test.assert_true(a.mk_relief == b.mk_relief && a.mk_water == b.mk_water, "same")
    end
    test "an archetype's fixed choices win over the blend" do
      let a = { ar_name: "Canyon", ar_fixed: canyon, ar_ranges: ranges() }
      let s = MapSt.apply(a, 3, MapSt.settings(3, 32))
      Test.assert_true(s.ms_base == 3 && s.ms_knobs.mk_relief == 0.8 && s.ms_knobs.mk_water >= 0.6, "fixed wins, ranges drawn")
    end
    test "side_voxels of 64 tiles is 768" do
      Test.assert_true(MapSt.side_voxels(MapSt.settings(1, 64)) == 768 && MapSt.playable_voxels(MapSt.settings(1, 64)) == 512, "sizes")
    end
  end
end
