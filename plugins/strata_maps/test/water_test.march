-- WaterStage: rivers with level stretches, weirs and sinks.
mod StrataMaps.Test.Water do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.WaterStage as MapWs
  alias StrataMaps.Test.Blocks as MapWb

  pfn river(seed : Int, base : Int, relief : Float, water : Float) : StrataMaps.Data.MapData do
    MapWs.run(StrataMaps.TerrainStage.run(MapWb.data_for(seed, 16, base, relief, water)))
  end
  pfn across(d : StrataMaps.Data.MapData, x : Int) : List(Int) do
    let c = StrataMaps.Data.corner(d.md_settings)
    let n = StrataMaps.Settings.side_voxels(d.md_settings)
    List.filter(List.range(c, c + n), fn z -> StrataMaps.Data.water_at(d, x, z) >= 0)
  end

  describe "WaterStage" do
    test "a river runs edge to edge" do
      let d = river(1, 1, 0.4, 0.5)
      let c = StrataMaps.Data.corner(d.md_settings)
      let n = StrataMaps.Settings.side_voxels(d.md_settings)
      Test.assert_true(!List.is_empty(across(d, c)) && !List.is_empty(across(d, c + n - 1)), "both edges")
    end
    test "its width follows the knob" do
      let narrow = List.length(across(river(2, 0, 0.2, 0.0001), 0))
      let wide = List.length(across(river(2, 0, 0.2, 1.0), 0))
      Test.assert_true(narrow >= 4 && narrow <= 10 && wide >= 50 && wide <= 70, "6 to 62 voxels")
    end
    test "every stretch is level and lower than its banks" do
      let d = river(3, 1, 0.6, 0.5)
      let c = StrataMaps.Data.corner(d.md_settings)
      let n = StrataMaps.Settings.side_voxels(d.md_settings)
      Test.assert_true(List.all(List.range(0, n / 4), fn k -> MapWs.banks_ok(d, c + k * 4)), "level within each column's banks")
    end
    test "a weir separates stretches whose levels differ" do
      let d = river(4, 2, 0.9, 0.4)
      Test.assert_true(MapWs.weirs_ok(d), "every level change has a weir")
      Test.assert_true(!List.is_empty(d.md_weirs), "highlands make at least one weir")
    end
    test "water 0 makes no water" do
      let d = river(5, 1, 0.5, 0.0)
      Test.assert_true(List.is_empty(across(d, 0)) && List.is_empty(d.md_sinks), "none")
    end
    test "the downstream end has sinks" do
      let d = river(6, 1, 0.4, 0.5)
      let c = StrataMaps.Data.corner(d.md_settings)
      let n = StrataMaps.Settings.side_voxels(d.md_settings)
      Test.assert_true(!List.is_empty(d.md_sinks) && List.all(d.md_sinks, fn s -> match s do (x, _) -> x == c + n - 1 end), "sinks on the east edge")
    end
  end
end
