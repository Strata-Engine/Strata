-- Block ids for strata_maps' tests (no registry is needed to make data).
mod StrataMaps.Test.Blocks do
  fn ids() : StrataMaps.Settings.MapBlocks do
    { mb_stone: 1, mb_dirt: 2, mb_grass: 3, mb_sand: 4, mb_asphalt: 5, mb_concrete: 6, mb_water: 7, mb_sink: 15, mb_weir: 16, mb_lava: 17, mb_rubble: 18, mb_scorched: 19, mb_deck: 20 }
  end
  fn data_for(seed : Int, tiles : Int, base : Int, relief : Float, water : Float) : StrataMaps.Data.MapData do
    let s0 = StrataMaps.Settings.settings(seed, tiles)
    let k = StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(s0.ms_knobs, "relief", relief), "water", water)
    StrataMaps.Data.empty({ s0 with ms_base: base, ms_knobs: k }, ids())
  end
end
