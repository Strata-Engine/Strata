-- Buildings: a building on every lot, on flattened ground, storeys by density.
mod StrataMaps.Test.BuildStage do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.BuildStage as MapBs
  alias StrataMaps.Test.Blocks as MapBsb

  pfn style() : Strata.Building.BldStyle do { Strata.Building.style(6, 2, 3, 6, 5) with bs_storeys: (2, 4), bs_door: 2 } end
  pfn town(seed : Int, density : Float) : StrataMaps.Data.MapData do
    let d0 = MapBsb.data_for(seed, 16, 0, 0.1, 0.0)
    let k = StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(d0.md_settings.ms_knobs, "settlement", 0.7), "density", density)
    let d1 = { d0 with md_settings: { d0.md_settings with ms_knobs: k } }
    MapBs.run(StrataMaps.SettleStage.run(StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(d1))), [style()])
  end
  pfn feet(b : StrataMaps.Data.MapBuilding) : List((Int, Int)) do
    List.flat_map(Strata.Building.footprint(b.mbd_plan), fn f -> match f do (x0, z0, x1, z1) -> List.map(List.range(0, (x1 - x0 + 1) * (z1 - z0 + 1)), fn i -> (x0 + i % (x1 - x0 + 1), z0 + i / (x1 - x0 + 1))) end)
  end
  pfn main_storeys(b : StrataMaps.Data.MapBuilding) : Int do match List.head(Strata.Building.volumes(b.mbd_plan)) do (_, _, _, _, n) -> n end end

  describe "BuildStage" do
    test "every lot has a building inside it" do
      let d = town(3, 0.5)
      Test.assert_true(!List.is_empty(d.md_lots) && List.length(d.md_buildings) == List.length(d.md_lots), "one a lot")
      Test.assert_true(List.all(d.md_buildings, fn b ->
        match Strata.Lots.lot_box(b.mbd_plan.bp_lot) do (x0, z0, x1, z1) -> List.all(feet(b), fn c -> match c do (x, z) -> x >= x0 && x <= x1 && z >= z0 && z <= z1 end) end), "inside its lot")
    end
    test "buildings stand on flattened ground" do
      let d = town(3, 0.5)
      Test.assert_true(List.all(d.md_buildings, fn b -> match b.mbd_origin do (_, y, _) -> List.all(feet(b), fn c -> match c do (x, z) -> Strata.Heights.get(d.md_heights, x, z) == y end) end), "every footprint column at the building's floor")
    end
    test "density 0 builds the style's lowest storeys, density 1 its highest" do
      Test.assert_true(List.all((town(3, 0.0)).md_buildings, fn b -> main_storeys(b) == 2), "two at density 0")
      Test.assert_true(List.all((town(3, 1.0)).md_buildings, fn b -> main_storeys(b) == 4), "four at density 1")
    end
  end
end
