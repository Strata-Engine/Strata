-- TerrainStage: the base height field.
mod StrataMaps.Test.Terrain do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.TerrainStage as MapTs
  alias StrataMaps.Test.Blocks as MapTb

  pfn made(seed : Int, base : Int, relief : Float) : StrataMaps.Data.MapData do MapTs.run(MapTb.data_for(seed, 16, base, relief, 0.0)) end

  describe "TerrainStage" do
    test "plains at relief 0 vary by no more than one step" do
      match MapTs.span(made(1, 0, 0.0)) do (mx, mn) -> Test.assert_true(mx - mn <= 2, "one step") end
    end
    test "relief 1 spans at least 80 voxels on highlands" do
      match MapTs.span(MapTs.run(MapTb.data_for(2, 32, 2, 1.0, 0.0))) do (mx, mn) -> Test.assert_true(mx - mn >= 80 && mx <= 108 && mn >= 8, "a big span, in range") end
    end
    test "canyon has a floor lower than its rims by most of the relief" do
      match MapTs.span(made(3, 3, 1.0)) do (mx, mn) -> Test.assert_true(mx - mn >= 60, "deep canyon") end
    end
    test "heights are multiples of the step" do
      let d = made(4, 1, 0.6)
      let c = StrataMaps.Data.corner(d.md_settings)
      Test.assert_true(List.all(List.range(0, 200), fn k -> int_mod_euclid(Strata.Heights.get(d.md_heights, c + k * 3 % 384, c + k * 7 % 384), 2) == 0), "even")
    end
    test "the ring eases to the edge's mean" do
      let d = made(5, 2, 0.8)
      let c = StrataMaps.Data.corner(d.md_settings)
      let n = StrataMaps.Settings.side_voxels(d.md_settings)
      let a = Strata.Heights.get(d.md_heights, c, c)
      let b = Strata.Heights.get(d.md_heights, c + n - 1, c + n - 1)
      Test.assert_true(int_abs(a - b) <= 2, "corners of the ring agree")
    end
    test "the same seed gives the same field" do
      let a = made(6, 1, 0.5)
      let b = made(6, 1, 0.5)
      let c = StrataMaps.Data.corner(a.md_settings)
      Test.assert_true(List.all(List.range(0, 100), fn k -> Strata.Heights.get(a.md_heights, c + k * 3, c + k * 2) == Strata.Heights.get(b.md_heights, c + k * 3, c + k * 2)), "same")
    end
  end
end
