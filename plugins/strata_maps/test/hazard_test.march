-- Lava: pools in the lowest open ground, a scorched ring, never on roads, lots or water.
mod StrataMaps.Test.Hazard do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataMaps.HazardStage as MapHz
  alias StrataMaps.Test.Blocks as MapHzb

  pfn made(seed : Int, base : Int, water : Float, settle : Float, hazard : Float) : StrataMaps.Data.MapData do
    let d0 = MapHzb.data_for(seed, 16, base, 0.5, water)
    let k = StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(d0.md_settings.ms_knobs, "settlement", settle), "hazard", hazard)
    let d1 = { d0 with md_settings: { d0.md_settings with ms_knobs: k } }
    MapHz.run(StrataMaps.SettleStage.run(StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(d1))))
  end
  pfn cols(d : StrataMaps.Data.MapData) : List((Int, Int)) do
    match StrataMaps.Data.playable(d) do (px, pz, n) -> List.map(List.range(0, n * n), fn i -> (px + i % n, pz + i / n)) end
  end
  pfn lava(d : StrataMaps.Data.MapData) : List((Int, Int)) do List.filter(cols(d), fn c -> match c do (x, z) -> StrataMaps.Data.lava_at(d, x, z) >= 0 end) end
  pfn in_lot(d : StrataMaps.Data.MapData, x : Int, z : Int) : Bool do
    List.any(d.md_lots, fn l -> match Strata.Lots.lot_box(l) do (x0, z0, x1, z1) -> x >= x0 && x <= x1 && z >= z0 && z <= z1 end)
  end

  describe "HazardStage" do
    test "hazard 0 makes no lava" do
      Test.assert_true(List.is_empty(lava(made(3, 3, 0.0, 0.0, 0.0))), "none")
    end
    test "lava stays off roads, lots and water" do
      let d = made(4, 1, 0.4, 0.5, 0.8)
      let ls = lava(d)
      Test.assert_true(!List.is_empty(ls), "some lava")
      Test.assert_true(List.all(ls, fn c -> match c do
        (x, z) -> StrataMaps.Data.water_at(d, x, z) < 0 && !in_lot(d, x, z) && Option.is_none(Strata.Roads.at(d.md_roads, (int_to_float(x) +. 0.5) *. 0.4, (int_to_float(z) +. 0.5) *. 0.4))
      end), "off all three")
    end
    test "a scorched ring surrounds every pool" do
      let d = made(5, 3, 0.0, 0.0, 1.0)
      let edge = fn (x, z) -> List.any([(x + 1, z), (x - 1, z), (x, z + 1), (x, z - 1)], fn c -> match c do (a, b) -> StrataMaps.Data.lava_at(d, a, b) >= 0 end)
      let shore = List.filter(cols(d), fn c -> match c do (x, z) -> StrataMaps.Data.lava_at(d, x, z) < 0 && edge(x, z) end)
      Test.assert_true(!List.is_empty(shore) && List.all(shore, fn c -> match c do (x, z) -> StrataMaps.Data.scorched_at(d, x, z) end), "every column beside lava is scorched")
      Test.assert_true(List.all(lava(d), fn c -> match c do (x, z) -> StrataMaps.Data.lava_at(d, x, z) == Strata.Heights.get(d.md_heights, x, z) + 2 || StrataMaps.Data.lava_at(d, x, z) > Strata.Heights.get(d.md_heights, x, z) end), "lava stands over its bed")
    end
    test "hazard 1 with a city reports what did not fit" do
      let d = made(6, 0, 0.0, 1.0, 1.0)
      Test.assert_true(List.any(d.md_reports, fn r -> String.starts_with(r, "lava")), "a report line")
    end
  end
end
