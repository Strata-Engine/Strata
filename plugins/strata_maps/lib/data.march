-- Data — what the pipeline knows about a map as it is made: the settings
-- and blocks, the height field, the water (per column, the level of the
-- water standing there or -1), weirs and sinks, and reports from stages
-- that could not do all they were asked; then the settlement (its roads,
-- bridges, the settled disc, lots), buildings (plan, template, where it
-- stands), placed templates (set pieces and trees), lava (per column, its
-- level or -1) and the scorched ring (per column, 1 or 0), objective
-- sites, and the trails' tiles (their low corners, world voxels).
--
-- Coordinates: the whole square's low corner is world voxel
-- (-side / 2, -side / 2), so the map is centred on the origin.
mod StrataMaps.Data do

  -- a building: its plan, its template, where the template's origin stands (world voxels)
  type MapBuilding = { mbd_plan : Strata.Building.BldPlan, mbd_template : Strata.Template.Template, mbd_origin : (Int, Int, Int) }
  -- a placed template: what, where its origin stands, its quarter turns, its kind (0 set piece, 1 tree)
  type MapPlaced = { mpl_template : Strata.Template.Template, mpl_origin : (Int, Int, Int), mpl_rot : Int, mpl_kind : Int }
  -- an objective site: its rule's name and its tiles (playable-square tile coordinates)
  type MapSite = { st_name : String, st_tiles : List((Int, Int)) }

  type MapData = { md_settings : StrataMaps.Settings.MapSettings, md_blocks : StrataMaps.Settings.MapBlocks, md_heights : Strata.Heights.HeightGrid,
                   md_water : NativeIntArr, md_weirs : List((Int, Int)), md_sinks : List((Int, Int)), md_reports : List(String),
                   md_roads : Strata.Roads.RoadGraph, md_bridges : List((Int, Float, Float, Int)), md_settled : (Int, Int, Int), md_lots : List(Strata.Lots.Lot),
                   md_buildings : List(MapBuilding), md_placed : List(MapPlaced), md_lava : NativeIntArr, md_scorched : NativeIntArr, md_sites : List(MapSite), md_trails : List((Int, Int)), md_trail_mask : NativeIntArr }

  doc "The whole square's low corner, world voxels (the map is centred on the origin)."
  fn corner(s : StrataMaps.Settings.MapSettings) : Int do 0 - StrataMaps.Settings.side_voxels(s) / 2 end

  doc "Data for [s] with [b]: flat ground at height 8, no water."
  fn empty(s : StrataMaps.Settings.MapSettings, b : StrataMaps.Settings.MapBlocks) : MapData do
    let n = StrataMaps.Settings.side_voxels(s)
    let c = corner(s)
    { md_settings: s, md_blocks: b, md_heights: Strata.Heights.grid(c, c, n, 8), md_water: NativeArray.make_int(n * n, -1), md_weirs: Nil, md_sinks: Nil, md_reports: Nil,
      md_roads: Strata.Roads.graph(), md_bridges: Nil, md_settled: (0, 0, 0), md_lots: Nil, md_buildings: Nil, md_placed: Nil,
      md_lava: NativeArray.make_int(n * n, -1), md_scorched: NativeArray.make_int(n * n, 0), md_sites: Nil, md_trails: Nil, md_trail_mask: NativeArray.make_int(Math.max_int(1, s.ms_tiles * s.ms_tiles), 0) }
  end

  doc "The water level at world column (x, z), or -1 for none (or outside the square)."
  fn water_at(d : MapData, x : Int, z : Int) : Int do
    let n = StrataMaps.Settings.side_voxels(d.md_settings)
    let c = corner(d.md_settings)
    let i = x - c
    let j = z - c
    if i < 0 || j < 0 || i >= n || j >= n do -1 else NativeArray.get_int(d.md_water, j * n + i) end
  end

  doc "The data with world column (x, z)'s water level set to [level] (-1 clears it)."
  fn with_water(d : MapData, x : Int, z : Int, level : Int) : MapData do
    let n = StrataMaps.Settings.side_voxels(d.md_settings)
    let c = corner(d.md_settings)
    let i = x - c
    let j = z - c
    if i < 0 || j < 0 || i >= n || j >= n do d else { d with md_water: NativeArray.set_int(d.md_water, j * n + i, level) } end
  end

  -- a column's index in the per-column arrays, or -1 outside the square
  pfn col(d : MapData, x : Int, z : Int) : Int do
    let n = StrataMaps.Settings.side_voxels(d.md_settings)
    let c = corner(d.md_settings)
    if x < c || z < c || x >= c + n || z >= c + n do -1 else (z - c) * n + (x - c) end
  end
  doc "The lava level at world column (x, z), or -1."
  fn lava_at(d : MapData, x : Int, z : Int) : Int do let i = col(d, x, z)
    if i < 0 do -1 else NativeArray.get_int(d.md_lava, i) end end
  doc "Is world column (x, z) in a scorched ring?"
  fn scorched_at(d : MapData, x : Int, z : Int) : Bool do let i = col(d, x, z)
    i >= 0 && NativeArray.get_int(d.md_scorched, i) == 1 end
  doc "Is world column (x, z) on a trail (TrailStage)?"
  fn on_trail(d : MapData, x : Int, z : Int) : Bool do
    let t = d.md_settings.ms_tiles
    match playable(d) do (px, pz, _) -> let tx = int_div_euclid(x - px, 8)
      let tz = int_div_euclid(z - pz, 8)
      tx >= 0 && tz >= 0 && tx < t && tz < t && NativeArray.get_int(d.md_trail_mask, tz * t + tx) == 1 end
  end
  doc "The playable square: (x0, z0, side) in world voxels."
  fn playable(d : MapData) : (Int, Int, Int) do
    let p = corner(d.md_settings) + StrataMaps.Settings.ring_voxels()
    (p, p, StrataMaps.Settings.playable_voxels(d.md_settings))
  end

  doc "The data with a report line added."
  fn report(d : MapData, line : String) : MapData do { d with md_reports: List.append(d.md_reports, [line]) } end
end
