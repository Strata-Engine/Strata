-- StrataMaps — bounded tactical maps from layered settings, as a plugin
-- (docs/plugins.md, docs/2026-11-20-map-generation-design.md): a seed and
-- knobs become a height field, water, and (later) settlements, vegetation,
-- hazards and ruin; the result is a Strata.Terrain.Gen the stream builds,
-- checked for play with strata_tactics.
mod StrataMaps do

  doc "The plugin's version."
  fn version() : String do "0.1.0" end

  pfn attempt(s : StrataMaps.Settings.MapSettings, b : StrataMaps.Settings.MapBlocks, seed : Int) : StrataMaps.Data.MapData do
    StrataMaps.WaterStage.run(StrataMaps.TerrainStage.run(StrataMaps.Data.empty({ s with ms_seed: seed }, b)))
  end

  pfn try_go(s : StrataMaps.Settings.MapSettings, b : StrataMaps.Settings.MapBlocks, jump : Int, wade : Int, k : Int, best : Option((StrataMaps.Data.MapData, StrataMaps.Check.CheckReport))) : (StrataMaps.Data.MapData, StrataMaps.Check.CheckReport) do
    let d = attempt(s, b, s.ms_seed + k)
    let r = StrataMaps.Check.run(d, jump, wade, k + 1)
    let better = match best do None -> Some((d, r)) | Some((bd, br)) -> if r.cr_routes > br.cr_routes do Some((d, r)) else best end end
    if r.cr_ok do (d, r)
    else if k + 1 >= 8 do match better do Some((bd, br)) -> (bd, { br with cr_attempts: 8 }) | None -> (d, r) end
    else try_go(s, b, jump, wade, k + 1, better) end end
  end

  doc "A map from [s] with the game's blocks [b], checked for a mover that climbs [jump] voxels a tile and wades [wade]: the terrain generator for the stream, the map data, and the check's report. Up to 8 attempts from the seed, the seed + 1, ...; the first that passes, else the one with the most routes, reported as failing with its reasons. (The slice: terrain and water.)"
  fn generate(s : StrataMaps.Settings.MapSettings, b : StrataMaps.Settings.MapBlocks, jump : Int, wade : Int) : (Strata.Terrain.Gen, StrataMaps.Data.MapData, StrataMaps.Check.CheckReport) do
    match try_go(s, b, jump, wade, 0, None) do (d, r) -> (StrataMaps.WorldGen.gen(d), d, r) end
  end
end
