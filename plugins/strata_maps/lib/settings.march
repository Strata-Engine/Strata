-- Settings — what a map is made from: a seed, choices (base, style,
-- pattern), the height step, and knobs from 0 to 1. Archetypes are named
-- settings: some choices fixed, some knobs drawn in ranges; a blend draws
-- knobs in ranges by a hash of the seed and the knob's name.
mod StrataMaps.Settings do

  type MapKnobs = { mk_relief : Float, mk_water : Float, mk_settlement : Float, mk_density : Float, mk_vegetation : Float, mk_hazard : Float, mk_ruin : Float }

  -- seed; playable tiles a side; base (0 plains, 1 rolling, 2 highlands, 3 canyon, 4 plateau); style (the game's index);
  -- road pattern (0 grid, 1 arterial, 2 broken); the height step in voxels; knobs
  type MapSettings = { ms_seed : Int, ms_tiles : Int, ms_base : Int, ms_style : Int, ms_pattern : Int, ms_step : Int, ms_knobs : MapKnobs }

  -- block ids the game supplies
  type MapBlocks = { mb_stone : Int, mb_dirt : Int, mb_grass : Int, mb_sand : Int, mb_asphalt : Int, mb_concrete : Int, mb_water : Int,
                     mb_sink : Int, mb_weir : Int, mb_lava : Int, mb_rubble : Int, mb_scorched : Int, mb_deck : Int }

  -- a name; the choices it fixes; knob ranges (name, lo, hi)
  type Archetype = { ar_name : String, ar_fixed : MapSettings -> MapSettings, ar_ranges : List((String, Float, Float)) }

  doc "Every knob at 0."
  fn knobs() : MapKnobs do { mk_relief: 0.0, mk_water: 0.0, mk_settlement: 0.0, mk_density: 0.0, mk_vegetation: 0.0, mk_hazard: 0.0, mk_ruin: 0.0 } end

  doc "Settings for a map of [tiles] tiles a side from [seed]: plains, style 0, a grid, a height step of 2 voxels, every knob 0."
  fn settings(seed : Int, tiles : Int) : MapSettings do
    { ms_seed: seed, ms_tiles: if tiles < 4 do 4 else tiles end, ms_base: 0, ms_style: 0, ms_pattern: 0, ms_step: 2, ms_knobs: knobs() }
  end

  doc "The knob called [name] (relief, water, settlement, density, vegetation, hazard, ruin); 0 for another name."
  fn knob(k : MapKnobs, name : String) : Float do
    if name == "relief" do k.mk_relief else if name == "water" do k.mk_water else if name == "settlement" do k.mk_settlement
    else if name == "density" do k.mk_density else if name == "vegetation" do k.mk_vegetation else if name == "hazard" do k.mk_hazard
    else if name == "ruin" do k.mk_ruin else 0.0 end end end end end end end
  end

  pfn clamp01(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end

  doc "The knobs with [name] set to [v] (kept in 0..1); another name changes nothing."
  fn with_knob(k : MapKnobs, name : String, v : Float) : MapKnobs do
    let x = clamp01(v)
    if name == "relief" do { k with mk_relief: x } else if name == "water" do { k with mk_water: x } else if name == "settlement" do { k with mk_settlement: x }
    else if name == "density" do { k with mk_density: x } else if name == "vegetation" do { k with mk_vegetation: x } else if name == "hazard" do { k with mk_hazard: x }
    else if name == "ruin" do { k with mk_ruin: x } else k end end end end end end end
  end

  pfn name_hash(s : String) : Int do List.fold_left(string_chars(s), 5381, fn (h, c) -> Strata.Seed.mix(h, char_to_int(c))) end

  doc "The settings with each named knob drawn in its range by a hash of [seed] and the knob's name."
  fn blend(seed : Int, ranges : List((String, Float, Float)), base : MapSettings) : MapSettings do
    let k = List.fold_left(ranges, base.ms_knobs, fn (acc, r) -> match r do
      (name, lo, hi) -> with_knob(acc, name, lo +. (hi -. lo) *. Strata.Seed.unit(Strata.Seed.mix(seed, name_hash(name))))
    end)
    { base with ms_knobs: k }
  end

  doc "The archetype applied: its knobs drawn in their ranges from [seed], then its fixed choices."
  fn apply(a : Archetype, seed : Int, base : MapSettings) : MapSettings do a.ar_fixed(blend(seed, a.ar_ranges, base)) end

  doc "The playable square's side in voxels (tiles of 8)."
  fn playable_voxels(s : MapSettings) : Int do s.ms_tiles * 8 end
  doc "The whole square's side in voxels: the playable square and a ring of 16 tiles each side."
  fn side_voxels(s : MapSettings) : Int do (s.ms_tiles + 32) * 8 end
  doc "Where the playable square starts, in voxels from the whole square's corner."
  fn ring_voxels() : Int do 128 end
end
