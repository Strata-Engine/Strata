-- Check — is a map playable? (The slice's check: routes across the river.)
--
-- Over the playable square, a tile graph from the height field: a tile's
-- height is its centre column's, its water depth the level less that height;
-- a tile can be entered when its water is at most [wade] voxels deep, from a
-- neighbour whose height is within [jump] voxels. The routes are the most
-- tile-disjoint paths (no two share a tile) from the north edge to the south
-- edge, counted up to 3 by augmenting paths over the tiles split in two
-- (max-flow with a capacity of one a tile). A map passes with two routes.
mod StrataMaps.Check do

  alias StrataMaps.Settings as CkS
  alias StrataMaps.Data as CkD
  alias Strata.Heights as CkH

  type CheckReport = { cr_ok : Bool, cr_routes : Int, cr_unreached : List(String), cr_cover : Float, cr_sight : Int, cr_attempts : Int, cr_why : List(String) }

  pfn tiles(d : StrataMaps.Data.MapData) : Int do d.md_settings.ms_tiles end
  pfn centre(d : StrataMaps.Data.MapData, t : Int) : (Int, Int) do
    let lo = CkD.corner(d.md_settings) + CkS.ring_voxels()
    let n = tiles(d)
    (lo + (t % n) * 8 + 4, lo + (t / n) * 8 + 4)
  end
  pfn height(d : StrataMaps.Data.MapData, t : Int) : Int do match centre(d, t) do (x, z) -> CkH.get(d.md_heights, x, z) end end
  pfn open_tile(d : StrataMaps.Data.MapData, t : Int, wade : Int) : Bool do
    match centre(d, t) do (x, z) -> let lv = CkD.water_at(d, x, z)
      lv < 0 || lv - CkH.get(d.md_heights, x, z) <= wade end
  end
  -- the neighbour of tile t in direction k (0 +x, 1 -x, 2 +z, 3 -z), or -1
  pfn nb(n : Int, t : Int, k : Int) : Int do
    let x = t % n
    let z = t / n
    if k == 0 do (if x + 1 < n do t + 1 else -1 end) else if k == 1 do (if x > 0 do t - 1 else -1 end)
    else if k == 2 do (if z + 1 < n do t + n else -1 end) else (if z > 0 do t - n else -1 end) end end end
  end
  pfn step_ok(d : StrataMaps.Data.MapData, a : Int, b : Int, jump : Int, wade : Int) : Bool do
    b >= 0 && open_tile(d, b, wade) && int_abs(height(d, a) - height(d, b)) <= jump
  end

  -- flows: tile in->out (n2), out(t)->in(nb) by direction (4 n2), source->in (n2), out->sink (n2)
  type CkFlow = CkFlow(NativeIntArr, NativeIntArr, NativeIntArr, NativeIntArr)

  -- a BFS over residual states: state 2t (in) / 2t+1 (out), 2 n2 the source, 2 n2 + 1 the sink;
  -- parent state and the move taken: 0 source->in, 1 in->out, 2 out->in back, 3 out->in(nb) by dir, 4 in(nb)->out back by dir, 5 out->sink
  pfn bfs(d : StrataMaps.Data.MapData, fl : CkFlow, n : Int, jump : Int, wade : Int) : Option((NativeIntArr, NativeIntArr)) do
    let n2 = n * n
    let src = 2 * n2
    let snk = 2 * n2 + 1
    let par = NativeArray.make_int(2 * n2 + 2, -1)
    let mv = NativeArray.make_int(2 * n2 + 2, -1)
    let starts = List.filter(List.range(0, n), fn t -> open_tile(d, t, wade) && src_free(fl, t))
    let par1 = List.fold_left(starts, par, fn (p, t) -> NativeArray.set_int(p, 2 * t, src))
    let mv1 = List.fold_left(starts, mv, fn (m, t) -> NativeArray.set_int(m, 2 * t, 0))
    match search(d, fl, n, jump, wade, List.map(starts, fn t -> 2 * t), Nil, par1, mv1) do
      (p2, m2) -> if NativeArray.get_int(p2, snk) >= 0 do Some((p2, m2)) else None end
    end
  end

  pfn src_free(fl : CkFlow, t : Int) : Bool do match fl do CkFlow(_, _, s, _) -> NativeArray.get_int(s, t) == 0 end end

  pfn seen(par : NativeIntArr, s : Int) : Bool do NativeArray.get_int(par, s) != -1 end

  pfn search(d : StrataMaps.Data.MapData, fl : CkFlow, n : Int, jump : Int, wade : Int, now : List(Int), next : List(Int), par : NativeIntArr, mv : NativeIntArr) : (NativeIntArr, NativeIntArr) do
    match now do
      Nil -> match next do Nil -> (par, mv) | _ -> search(d, fl, n, jump, wade, List.reverse(next), Nil, par, mv) end
      Cons(s, rest) ->
        if seen(par, 2 * n * n + 1) do (par, mv)
        else
          match expand(d, fl, n, jump, wade, s, par, mv) do
            (p2, m2, found) -> search(d, fl, n, jump, wade, rest, List.append(found, next), p2, m2)
          end
        end
    end
  end

  -- the residual moves from state s
  pfn expand(d : StrataMaps.Data.MapData, fl : CkFlow, n : Int, jump : Int, wade : Int, s : Int, par : NativeIntArr, mv : NativeIntArr) : (NativeIntArr, NativeIntArr, List(Int)) do
    match fl do
      CkFlow(io, dir, _, sk) ->
        let n2 = n * n
        let t = s / 2
        let cands = if s % 2 == 0 do
            -- in(t): to out(t) if unused; back to out(prev) along a used edge into t
            let fwd = if NativeArray.get_int(io, t) == 0 do [(2 * t + 1, 1)] else Nil end
            let back = List.filter_map(List.range(0, 4), fn k -> back_move(n, dir, t, k))
            List.append(fwd, back)
          else
            -- out(t): back to in(t) if used; to in(nb) along unused edges; to the sink from the south edge
            let back = if NativeArray.get_int(io, t) == 1 do [(2 * t, 2)] else Nil end
            let fwd = List.filter_map(List.range(0, 4), fn k -> fwd_move(d, n, dir, t, k, jump, wade))
            let sink = if t / n == n - 1 && NativeArray.get_int(sk, t) == 0 do [(2 * n2 + 1, 5)] else Nil end
            List.append(back, List.append(fwd, sink))
          end
        List.fold_left(cands, (par, mv, Nil), fn (acc, c) -> visit(acc, s, c))
    end
  end
  pfn visit(acc : (NativeIntArr, NativeIntArr, List(Int)), from : Int, c : (Int, Int)) : (NativeIntArr, NativeIntArr, List(Int)) do
    match (acc, c) do
      ((p, m, found), (to, how)) -> if seen(p, to) do acc else (NativeArray.set_int(p, to, from), NativeArray.set_int(m, to, how), Cons(to, found)) end
    end
  end
  pfn fwd_move(d : StrataMaps.Data.MapData, n : Int, dir : NativeIntArr, t : Int, k : Int, jump : Int, wade : Int) : Option((Int, Int)) do
    let w = nb(n, t, k)
    if w >= 0 && NativeArray.get_int(dir, t * 4 + k) == 0 && step_ok(d, t, w, jump, wade) do Some((2 * w, 10 + k)) else None end
  end
  -- into in(t) came an edge out(u) -> in(t) with u = nb(t, k), stored at u's direction toward t
  pfn back_move(n : Int, dir : NativeIntArr, t : Int, k : Int) : Option((Int, Int)) do
    let u = nb(n, t, k)
    let kk = if k == 0 do 1 else if k == 1 do 0 else if k == 2 do 3 else 2 end end end
    if u >= 0 && NativeArray.get_int(dir, u * 4 + kk) == 1 do Some((2 * u + 1, 20 + kk)) else None end
  end

  -- push one unit along the path found
  pfn augment(fl : CkFlow, n : Int, par : NativeIntArr, mv : NativeIntArr, s : Int) : CkFlow do
    let src = 2 * n * n
    if s == src do fl
    else
      let p = NativeArray.get_int(par, s)
      let how = NativeArray.get_int(mv, s)
      match fl do
        CkFlow(io, dir, sr, sk) ->
          let fl2 = if how == 0 do CkFlow(io, dir, NativeArray.set_int(sr, s / 2, 1), sk)
            else if how == 1 do CkFlow(NativeArray.set_int(io, s / 2, 1), dir, sr, sk)
            else if how == 2 do CkFlow(NativeArray.set_int(io, s / 2, 0), dir, sr, sk)
            else if how == 5 do CkFlow(io, dir, sr, NativeArray.set_int(sk, p / 2, 1))
            else if how >= 20 do CkFlow(io, NativeArray.set_int(dir, (s / 2) * 4 + (how - 20), 0), sr, sk)
            else CkFlow(io, NativeArray.set_int(dir, (p / 2) * 4 + (how - 10), 1), sr, sk) end end end end end
          augment(fl2, n, par, mv, p)
      end
    end
  end

  pfn flow_go(d : StrataMaps.Data.MapData, fl : CkFlow, n : Int, jump : Int, wade : Int, k : Int) : Int do
    if k >= 3 do k
    else
      match bfs(d, fl, n, jump, wade) do
        None -> k
        Some((par, mv)) -> flow_go(d, augment(fl, n, par, mv, 2 * n * n + 1), n, jump, wade, k + 1)
      end
    end
  end

  doc "The most tile-disjoint routes (up to 3) from the playable square's north edge to its south edge for a mover that climbs or drops [jump] voxels a tile and wades [wade] voxels of water."
  fn routes(d : StrataMaps.Data.MapData, jump : Int, wade : Int) : Int do
    let n = tiles(d)
    let n2 = n * n
    flow_go(d, CkFlow(NativeArray.make_int(n2, 0), NativeArray.make_int(4 * n2, 0), NativeArray.make_int(n2, 0), NativeArray.make_int(n2, 0)), n, jump, wade, 0)
  end

  doc "The ground check (terrain and water only): passing with at least two routes between the north and south edges."
  fn ground(d : StrataMaps.Data.MapData, jump : Int, wade : Int, attempts : Int) : CheckReport do
    let r = routes(d, jump, wade)
    let why = if r >= 2 do Nil else ["only " ++ int_to_string(r) ++ " separate route(s) between the north and south edges (2 needed)"] end
    { cr_ok: r >= 2, cr_routes: r, cr_unreached: Nil, cr_cover: 0.0, cr_sight: 0, cr_attempts: attempts, cr_why: why }
  end

  doc "The early check, before buildings: the north and south edges joined over the height field for the mover (its climb and drop in height steps), wading 2 voxels."
  fn early(d : StrataMaps.Data.MapData, mover : StrataTactics.Reach.Mover) : Bool do
    routes(d, Math.min_int(mover.mv_jump, mover.mv_drop) * d.md_settings.ms_step, 2) >= 1
  end

  -- ── The tactical check on the built world ──────────────────────────────
  -- A mover steps to a neighbouring tile that is standable, has room for its
  -- height, holds at most 2 voxels of fluid (it wades that much), and whose
  -- floor rises at most its climb or falls at most its drop (height steps).

  pfn ok_step(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, a : (Int, Int), b : (Int, Int)) : Bool do
    let st = (StrataTactics.Grid.settings_of(g)).gs_step
    match b do
      (bx, bz) ->
        if bx < 0 || bz < 0 || bx >= StrataTactics.Grid.width(g) || bz >= StrataTactics.Grid.depth(g) do false
        else
          let dh = StrataTactics.Grid.floor(g, b) - StrataTactics.Grid.floor(g, a)
          StrataTactics.Grid.fits(g, b, m.mv_height) && StrataTactics.Grid.fluid(g, b) <= 2 && dh <= m.mv_jump * st && 0 - dh <= m.mv_drop * st
        end
    end
  end
  pfn step_to(t : (Int, Int), k : Int) : (Int, Int) do match t do (x, z) -> if k == 0 do (x + 1, z) else if k == 1 do (x - 1, z) else if k == 2 do (x, z + 1) else (x, z - 1) end end end end end
  pfn back(k : Int) : Int do if k == 0 do 1 else if k == 1 do 0 else if k == 2 do 3 else 2 end end end end

  -- tiles reached from [from] by steps
  pfn reach(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, from : List((Int, Int))) : NativeIntArr do
    let w = StrataTactics.Grid.width(g)
    let seen = List.fold_left(from, NativeArray.make_int(Math.max_int(1, w * StrataTactics.Grid.depth(g)), 0), fn (a, t) -> match t do (x, z) -> NativeArray.set_int(a, z * w + x, 1) end)
    flood(g, m, w, from, Nil, seen)
  end
  pfn flood(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, w : Int, now : List((Int, Int)), next : List((Int, Int)), seen : NativeIntArr) : NativeIntArr do
    match now do
      Nil -> match next do Nil -> seen | _ -> flood(g, m, w, next, Nil, seen) end
      Cons(t, rest) ->
        match List.fold_left(List.range(0, 4), (seen, next), fn (acc, k) -> visit_tile(g, m, w, t, k, acc)) do
          (s2, n2) -> flood(g, m, w, rest, n2, s2)
        end
    end
  end
  pfn visit_tile(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, w : Int, t : (Int, Int), k : Int, acc : (NativeIntArr, List((Int, Int)))) : (NativeIntArr, List((Int, Int))) do
    match acc do
      (seen, next) ->
        let u = step_to(t, k)
        match u do (ux, uz) -> if ok_step(g, m, t, u) && NativeArray.get_int(seen, uz * w + ux) == 0 do (NativeArray.set_int(seen, uz * w + ux, 1), Cons(u, next)) else acc end end
    end
  end

  -- edge-disjoint paths from [a] to [b] (up to 3), by augmenting paths over the tile graph; flow per arc (tile, direction) 0 or 1
  pfn paths(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, a : List((Int, Int)), b : List((Int, Int))) : Int do
    let w = StrataTactics.Grid.width(g)
    let n = w * StrataTactics.Grid.depth(g)
    let goal = List.fold_left(b, NativeArray.make_int(Math.max_int(1, n), 0), fn (arr, t) -> match t do (x, z) -> NativeArray.set_int(arr, z * w + x, 1) end)
    paths_go(g, m, a, goal, w, n, NativeArray.make_int(Math.max_int(1, n * 4), 0), 0)
  end
  pfn paths_go(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, a : List((Int, Int)), goal : NativeIntArr, w : Int, n : Int, flow : NativeIntArr, k : Int) : Int do
    if k >= 3 do k
    else
      -- parent tile index and the direction stepped, per tile; -1 unseen, -2 a start
      let par0 = List.fold_left(a, NativeArray.make_int(Math.max_int(1, n), -1), fn (arr, t) -> match t do (x, z) -> NativeArray.set_int(arr, z * w + x, -2) end)
      match augment_search(g, m, goal, w, flow, a, Nil, par0, NativeArray.make_int(Math.max_int(1, n), 0)) do
        None -> k
        Some((end_t, par, dirs)) -> paths_go(g, m, a, goal, w, n, push_flow(flow, par, dirs, w, end_t), k + 1)
      end
    end
  end
  pfn augment_search(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, goal : NativeIntArr, w : Int, flow : NativeIntArr, now : List((Int, Int)), next : List((Int, Int)), par : NativeIntArr, dirs : NativeIntArr) : Option(((Int, Int), NativeIntArr, NativeIntArr)) do
    match now do
      Nil -> match next do Nil -> None | _ -> augment_search(g, m, goal, w, flow, next, Nil, par, dirs) end
      Cons(t, rest) ->
        match t do
          (tx, tz) ->
            if NativeArray.get_int(goal, tz * w + tx) == 1 do Some((t, par, dirs))
            else
              match List.fold_left(List.range(0, 4), (par, dirs, next), fn (acc, k) -> arc(g, m, w, flow, t, k, acc)) do
                (p2, d2, n2) -> augment_search(g, m, goal, w, flow, rest, n2, p2, d2)
              end
            end
        end
    end
  end
  -- the arc from t in direction k, if the residual graph has it: cancelling flow coming back, or a step with no flow yet
  pfn arc(g : StrataTactics.Grid.TileGrid, m : StrataTactics.Reach.Mover, w : Int, flow : NativeIntArr, t : (Int, Int), k : Int, acc : (NativeIntArr, NativeIntArr, List((Int, Int)))) : (NativeIntArr, NativeIntArr, List((Int, Int))) do
    match (acc, t, step_to(t, k)) do
      ((par, dirs, next), (tx, tz), (ux, uz)) ->
        if ux < 0 || uz < 0 || ux >= StrataTactics.Grid.width(g) || uz >= StrataTactics.Grid.depth(g) do acc
        else
          let ti = tz * w + tx
          let ui = uz * w + ux
          let cancel = NativeArray.get_int(flow, ui * 4 + back(k)) == 1
          let fresh = NativeArray.get_int(flow, ti * 4 + k) == 0 && ok_step(g, m, t, (ux, uz))
          if NativeArray.get_int(par, ui) == -1 && (cancel || fresh) do (NativeArray.set_int(par, ui, ti), NativeArray.set_int(dirs, ui, k), Cons((ux, uz), next)) else acc end
        end
    end
  end
  pfn push_flow(flow : NativeIntArr, par : NativeIntArr, dirs : NativeIntArr, w : Int, t : (Int, Int)) : NativeIntArr do
    match t do
      (tx, tz) ->
        let ui = tz * w + tx
        let pi = NativeArray.get_int(par, ui)
        if pi < 0 do flow
        else
          let k = NativeArray.get_int(dirs, ui)
          let f2 = if NativeArray.get_int(flow, ui * 4 + back(k)) == 1 do NativeArray.set_int(flow, ui * 4 + back(k), 0) else NativeArray.set_int(flow, pi * 4 + k, 1) end
          push_flow(f2, par, dirs, w, (pi % w, pi / w))
        end
    end
  end

  doc "The tactical check of a built world [w] (after the ruin pass) on its grid: routes are edge-disjoint tile paths (up to 3) between the first two sites (the north and south rows when there are fewer); every site must be reached from both of those; cover is the share of standable tiles with half or full cover on some edge for a unit the mover's height; sight counts clear lines between up to 4 tiles of each of the two. Passing: 2 routes or more, nothing unreached, cover between 0.08 and 0.6 (sight is reported, not required)."
  fn run(w : Strata.World.World, g : StrataTactics.Grid.TileGrid, d : StrataMaps.Data.MapData, mover : StrataTactics.Reach.Mover) : CheckReport do
    let gw = StrataTactics.Grid.width(g)
    let gd = StrataTactics.Grid.depth(g)
    let all = List.map(List.range(0, gw * gd), fn i -> (i % gw, i / gw))
    let (na, a, nb, b) = match d.md_sites do
      Cons(s1, Cons(s2, _)) -> (s1.st_name, s1.st_tiles, s2.st_name, s2.st_tiles)
      _ -> ("the north edge", List.filter(all, fn t -> match t do (_, z) -> z == 0 && StrataTactics.Grid.standable(g, t) end), "the south edge", List.filter(all, fn t -> match t do (_, z) -> z == gd - 1 && StrataTactics.Grid.standable(g, t) end))
    end
    let r = if List.is_empty(a) || List.is_empty(b) do 0 else paths(g, mover, a, b) end
    let from_a = reach(g, mover, a)
    let from_b = reach(g, mover, b)
    let reached = fn ts -> List.any(ts, fn t -> match t do (x, z) -> NativeArray.get_int(from_a, z * gw + x) == 1 end) && List.any(ts, fn t -> match t do (x, z) -> NativeArray.get_int(from_b, z * gw + x) == 1 end)
    let unreached = List.filter_map(d.md_sites, fn s -> if reached(s.st_tiles) do None else Some(s.st_name) end)
    let standing = List.filter(all, fn t -> StrataTactics.Grid.standable(g, t))
    let covered = List.filter(standing, fn t -> List.any(List.range(0, 4), fn k -> StrataTactics.Sight.edge(w, g, t, k, mover.mv_height, StrataTactics.Sight.cover_settings()) >= StrataTactics.Sight.half()))
    let cover = if List.is_empty(standing) do 0.0 else int_to_float(List.length(covered)) /. int_to_float(List.length(standing)) end
    let eye = mover.mv_height * 3 / 4
    let pairs = List.flat_map(List.take(a, 4), fn ta -> List.map(List.take(b, 4), fn tb -> (ta, tb)))
    let sight = List.length(List.filter(pairs, fn p -> match p do (ta, tb) -> StrataTactics.Sight.line(w, g, ta, eye, tb, eye) == StrataTactics.Sight.clear() end))
    let why0 = if r >= 2 do Nil else ["only " ++ int_to_string(r) ++ " separate route(s) between " ++ na ++ " and " ++ nb ++ " (2 needed)"] end
    let why1 = if List.is_empty(unreached) do why0 else List.append(why0, [String.join(unreached, ", ") ++ " not reached from both " ++ na ++ " and " ++ nb]) end
    let why2 = if cover >= 0.08 && cover <= 0.6 do why1 else List.append(why1, ["cover on " ++ int_to_string(float_to_int(cover *. 100.0)) ++ "% of standable tiles (8% to 60% wanted)"]) end
    let why3 = if sight >= 1 do why2 else List.append(why2, ["no clear line between " ++ na ++ " and " ++ nb]) end
    { cr_ok: r >= 2 && List.is_empty(unreached) && cover >= 0.08 && cover <= 0.6, cr_routes: r, cr_unreached: unreached, cr_cover: cover, cr_sight: sight, cr_attempts: 1, cr_why: why3 }
  end
end
