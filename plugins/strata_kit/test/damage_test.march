-- Damage: carving, breaking off.
mod StrataKit.Test.Damage do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataKit.Damage as KitD

  -- a rig of one solid part of n^3 voxels, colour 1, its anchor at (ax, ay, az)
  pfn solid(sx : Int, sy : Int, sz : Int, ax : Float, ay : Float, az : Float) : Strata.Rig.Rig do
    match Strata.Rig.part(Strata.Rig.colour(Strata.Rig.new(0.1), 1, 0.5, 0.5, 0.5, 0.8, 0.0), -1, 0.0, 0.0, 0.0, sx, sy, sz) do
      (r, p) -> Strata.Rig.anchor(Strata.Rig.with_grid(r, p, NativeArray.make_u8(sx * sy * sz, 1)), p, ax, ay, az)
    end
  end
  pfn filled(r : Strata.Rig.Rig) : Int do
    let g = Strata.Rig.grid(r, 0)
    List.length(List.filter(List.range(0, NativeArray.length_u8(g)), fn i -> NativeArray.get_u8(g, i) != 0))
  end
  pfn far() : Strata.Rig.Rig do solid(9, 9, 9, -50.0, -50.0, -50.0) end

  describe "Damage.carve" do
    test "a carve removes a ball of voxels and counts them" do
      -- radius 2 round the face voxel (4, 4, 0): z 0 has 13 cells within 2, z 1 has 9, z 2 has 1: 23
      match KitD.carve(far(), 0, 4, 4, 0, 2.0, KitD.carve_settings(9)) do
        (r, n) -> Test.assert_true(n == 23 && filled(r) == 729 - 23, "23 removed")
      end
    end
    test "new faces take the interior colour" do
      match KitD.carve(far(), 0, 4, 4, 0, 2.0, KitD.carve_settings(9)) do
        (r, _) -> Test.assert_true(Strata.Rig.get(r, 0, 4, 4, 3) == 9 && Strata.Rig.get(r, 0, 4, 4, 2) == 0 && Strata.Rig.get(r, 0, 0, 0, 8) == 1, "interior on the new faces only")
      end
    end
    test "the anchor region is never removed" do
      match KitD.carve(solid(9, 9, 9, 4.0, 4.0, 0.0), 0, 4, 4, 0, 3.0, KitD.carve_settings(9)) do
        (r, n) -> Test.assert_true(n > 0 && Strata.Rig.get(r, 0, 4, 4, 0) != 0 && Strata.Rig.get(r, 0, 3, 3, 0) != 0, "kept round the anchor")
      end
    end
    test "carving everything leaves a pure joint" do
      match KitD.carve(solid(9, 9, 9, 4.5, 4.5, 4.5), 0, 4, 4, 4, 20.0, KitD.carve_settings(9)) do
        (r, n) ->
          let left = filled(r)
          Test.assert_true(Strata.Rig.part_count(r) == 1 && left > 0 && left + n == 729 && left <= 33, "only the keep ball")
          match KitD.carve(r, 0, 4, 4, 4, 20.0, KitD.carve_settings(9)) do (r2, n2) -> Test.assert_true(n2 == 0 && filled(r2) == left, "the keep ball stays") end
      end
    end
    test "a carve of a 40 x 60 x 30 part and its meshing within a frame" do
      let r = solid(40, 60, 30, 20.0, 0.0, 15.0)
      let t0 = Authority.must(System.now_ms())
      match KitD.carve(r, 0, 20, 30, 0, 4.0, KitD.carve_settings(9)) do
        (r2, _) ->
          let ms_carve = Authority.must(System.now_ms()) - t0
          let quads = List.length(Strata.Rig.meshes(r2))
          let ms = Authority.must(System.now_ms()) - t0
          println("kit: carve in " ++ int_to_string(ms_carve) ++ " ms, carve and mesh (" ++ int_to_string(quads) ++ " pieces) in " ++ int_to_string(ms) ++ " ms (budget 16)")
          Test.assert_true(ms < 64, "within four times the budget")
      end
    end
  end
end
