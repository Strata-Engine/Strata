-- Part: parts and mirroring.
mod StrataKit.Test.Part do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataKit.Part as KitP

  pfn up() : (Float, Float, Float) do (0.0, 1.0, 0.0) end
  pfn fwd() : (Float, Float, Float) do (0.0, 0.0, 1.0) end
  pfn gun() : StrataKit.Part.KitPart do
    let g = NativeArray.set_u8(NativeArray.make_u8(4 * 4 * 8, 0), 0 + 4 * (1 + 4 * 2), 7)
    KitP.from_grid(4, 4, 8, g, KitP.marker("attach", "part", 2.0, 0.0, 0.0, fwd(), up()),
      [KitP.mount_of("scope", "L", "scope_r", KitP.marker("scope_r", "part", 2.0, 4.0, 4.0, fwd(), up()))],
      [KitP.marker("muzzle", "part", 3.5, 2.0, 6.0, (0.6, 0.0, 0.8), up())], ["hand", "shoulder"], "M", "r", [("weight", 9.0)])
  end

  describe "Part" do
    test "from_grid keeps the grid, markers and tags" do
      let p = gun()
      Test.assert_true(List.length(KitP.pieces(p)) == 1 && KitP.size(p) == "M" && KitP.slots(p) == ["hand", "shoulder"], "fields")
      Test.assert_true(KitP.tag(p, "weight") == 9.0 && KitP.marker_name(KitP.attach(p)) == "attach", "tag and attach")
      Test.assert_true(Option.is_some(KitP.mount(p, "scope_r")) && KitP.marker_at(List.head(KitP.fx(p))) == (3.5, 2.0, 6.0), "mount and fx")
    end
    test "tag of an absent key is 0" do
      Test.assert_true(KitP.tag(gun(), "power") == 0.0, "absent")
    end
    test "mirror flips voxels in x" do
      let g = KitP.piece_grid(List.head(KitP.pieces(KitP.mirror(gun()))))
      Test.assert_true(NativeArray.get_u8(g, 3 + 4 * (1 + 4 * 2)) == 7 && NativeArray.get_u8(g, 0 + 4 * (1 + 4 * 2)) == 0, "(0, 1, 2) to (3, 1, 2)")
    end
    test "mirror flips a marker's position and facing, keeps up" do
      let m = List.head(KitP.fx(KitP.mirror(gun())))
      Test.assert_true(KitP.marker_at(m) == (0.5, 2.0, 6.0) && KitP.marker_facing(m) == (-0.6, 0.0, 0.8) && KitP.marker_up(m) == (0.0, 1.0, 0.0), "mirrored")
    end
    test "mirror negates the x of a marker's up as well as its facing" do
      let p = { gun() with kp_fx: [KitP.marker("muzzle", "part", 3.5, 2.0, 6.0, (0.0, 0.0, 1.0), (0.6, 0.8, 0.0))] }
      Test.assert_true(KitP.marker_up(List.head(KitP.fx(KitP.mirror(p)))) == (-0.6, 0.8, 0.0), "up mirrored")
    end
    test "mirror renames mounts and side" do
      let p = KitP.mirror(gun())
      Test.assert_true(Option.is_some(KitP.mount(p, "scope_l")) && KitP.side(p) == "l", "renamed")
    end
    test "mirror twice is the identity" do
      let p = gun()
      let q = KitP.mirror(KitP.mirror(p))
      Test.assert_true(KitP.marker_at(List.head(KitP.fx(q))) == KitP.marker_at(List.head(KitP.fx(p))) && KitP.side(q) == "r", "markers and side")
      Test.assert_true(NativeArray.get_u8(KitP.piece_grid(List.head(KitP.pieces(q))), 0 + 4 * (1 + 4 * 2)) == 7, "grid")
      Test.assert_true(Option.is_some(KitP.mount(q, "scope_r")), "names")
    end
  end
end
