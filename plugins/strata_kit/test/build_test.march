-- Build: trees, fitting, totals, detaching.
mod StrataKit.Test.Build do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataKit.Build as KitB
  alias StrataKit.Test.Parts as KitTp

  -- the core, two arms (a right arm on both sides: mirrored on the left) with a rifle in the right hand
  pfn mech() : StrataKit.Build.KitBuild do
    KitB.node(0, [("arm_l", KitB.leaf(1)), ("arm_r", KitB.node(1, [("hand_r", KitB.leaf(2))]))])
  end

  describe "Build" do
    test "a correct build has no misfits" do
      Test.assert_true(List.is_empty(KitB.fits(KitTp.all(), mech(), KitTp.ok)), "fits")
    end
    test "a heavy gun on a light shoulder is a misfit with a reason" do
      let fs = KitB.fits(KitTp.all(), KitB.node(0, [("shoulder_r", KitB.leaf(8))]), KitTp.ok)
      Test.assert_true(List.length(fs) == 1 && (match List.head(fs) do (p, why) -> p == ["shoulder_r"] && String.contains(why, "shoulder:L") end), "reason")
    end
    test "a light gun on a heavy shoulder fits" do
      let core_h = { KitTp.core() with kp_mounts: [StrataKit.Part.mount_of("shoulder", "H", "shoulder_r", StrataKit.Part.marker("shoulder_r", "part", 1.0, 12.0, 4.0, KitTp.fwd(), KitTp.upv()))] }
      Test.assert_true(List.is_empty(KitB.fits([core_h, KitTp.light_gun()], KitB.node(0, [("shoulder_r", KitB.leaf(1))]), KitTp.ok)), "fits")
    end
    test "a leg part on the back mount is a misfit" do
      Test.assert_true(List.length(KitB.fits(KitTp.all(), KitB.node(0, [("back", KitB.leaf(4))]), KitTp.ok)) == 1, "misfit")
    end
    test "a child on a mount the parent lacks is a misfit" do
      let fs = KitB.fits(KitTp.all(), KitB.node(0, [("tail", KitB.leaf(7))]), KitTp.ok)
      Test.assert_true(match fs do Cons((_, why), Nil) -> String.contains(why, "tail") | _ -> false end, "names the mount")
    end
    test "sum adds weight over every node" do
      Test.assert_true(KitB.sum(KitTp.all(), mech(), "weight") == 52.0, "30 + 9 + 9 + 4")
    end
    test "detach takes the subtree" do
      match KitB.detach(mech(), ["arm_r"]) do
        (rest, Some(sub)) ->
          Test.assert_true(KitB.count(sub) == 2 && KitB.sum(KitTp.all(), rest, "weight") == 39.0, "arm and rifle gone")
        _ -> Test.fail("nothing detached")
      end
    end
    test "detaching the root changes nothing" do
      match KitB.detach(mech(), Nil) do (b, none) -> Test.assert_true(KitB.count(b) == 4 && Option.is_none(none), "unchanged") end
    end
    test "paths list every node depth first" do
      Test.assert_true(KitB.paths(mech()) == [Nil, ["arm_l"], ["arm_r"], ["arm_r", "hand_r"]], "paths")
    end
  end
end
