-- Placeholder parts for strata_kit's tests, built in code. Indices in all():
-- 0 core, 1 arm (right), 2 rifle, 3 shield, 4 legs, 5 treads, 6 hover, 7 pod, 8 heavy gun, 9 light gun.
mod StrataKit.Test.Parts do

  alias StrataKit.Part as TkP

  fn fwd() : (Float, Float, Float) do (0.0, 0.0, 1.0) end
  fn upv() : (Float, Float, Float) do (0.0, 1.0, 0.0) end
  fn filled(sx : Int, sy : Int, sz : Int, c : Int) : NativeU8Arr do NativeArray.make_u8(sx * sy * sz, c) end
  pfn m(name : String, piece : String, x : Float, y : Float, z : Float) : StrataKit.Part.KitMarker do TkP.marker(name, piece, x, y, z, fwd(), upv()) end
  pfn mt(slot : String, size : String, name : String, piece : String, x : Float, y : Float, z : Float) : StrataKit.Part.KitMount do TkP.mount_of(slot, size, name, m(name, piece, x, y, z)) end

  fn core() : StrataKit.Part.KitPart do
    TkP.from_grid(10, 12, 8, filled(10, 12, 8, 1), m("attach", "part", 5.0, 0.0, 4.0),
      [mt("shoulder", "L", "shoulder_l", "part", 9.0, 12.0, 4.0), mt("shoulder", "L", "shoulder_r", "part", 1.0, 12.0, 4.0),
       mt("arm", "M", "arm_l", "part", 10.0, 10.0, 4.0), mt("arm", "M", "arm_r", "part", 0.0, 10.0, 4.0),
       mt("back", "M", "back", "part", 5.0, 8.0, 0.0), mt("hip", "M", "hip", "part", 5.0, 0.0, 4.0)],
      Nil, ["core"], "M", "", [("weight", 30.0), ("power", 0.0)])
  end

  fn arm_r() : StrataKit.Part.KitPart do
    let p0 = TkP.from_grid(4, 4, 4, filled(4, 4, 4, 2), m("attach", "part", 4.0, 2.0, 2.0),
      [mt("hand", "L", "hand_r", "fore", 2.0, 0.0, 2.0), mt("forearm", "L", "forearm_r", "fore", 0.0, 4.0, 2.0)],
      Nil, ["arm"], "M", "r", [("weight", 9.0), ("power", 2.0)])
    let p1 = TkP.with_piece(p0, "upper", "part", 4, 8, 4, filled(4, 8, 4, 2), (2.0, 0.0, 2.0), (2.0, 8.0, 2.0))
    TkP.with_piece(p1, "fore", "upper", 4, 8, 4, filled(4, 8, 4, 3), (2.0, 0.0, 2.0), (2.0, 8.0, 2.0))
  end

  fn rifle() : StrataKit.Part.KitPart do
    TkP.from_grid(2, 2, 10, filled(2, 2, 10, 4), m("attach", "part", 1.0, 1.0, 2.0), Nil, [m("muzzle", "part", 1.0, 1.0, 10.0)], ["hand", "shoulder", "forearm"], "L", "", [("weight", 4.0), ("power", 1.0)])
  end
  fn shield() : StrataKit.Part.KitPart do
    TkP.from_grid(2, 10, 6, filled(2, 10, 6, 5), m("attach", "part", 1.0, 5.0, 3.0), Nil, Nil, ["hand"], "L", "", [("weight", 6.0)])
  end

  fn legs() : StrataKit.Part.KitPart do
    let p0 = TkP.from_grid(10, 2, 4, filled(10, 2, 4, 6), m("attach", "part", 5.0, 2.0, 2.0), Nil, Nil, ["hip"], "M", "", [("weight", 20.0)])
    let leg = fn (p, s, x) -> TkP.with_piece(TkP.with_piece(TkP.with_piece(p, "thigh_" ++ s, "part", 3, 6, 3, filled(3, 6, 3, 6), (x, 0.0, 2.0), (1.5, 6.0, 1.5)),
      "shin_" ++ s, "thigh_" ++ s, 3, 6, 3, filled(3, 6, 3, 6), (1.5, 0.0, 1.5), (1.5, 6.0, 1.5)), "foot_" ++ s, "shin_" ++ s, 3, 1, 5, filled(3, 1, 5, 7), (1.5, 0.0, 1.5), (1.5, 1.0, 1.5))
    leg(leg(p0, "l", 8.0), "r", 2.0)
  end

  fn treads() : StrataKit.Part.KitPart do
    let p0 = TkP.from_grid(12, 4, 12, filled(12, 4, 12, 6), m("attach", "part", 6.0, 4.0, 6.0), Nil, Nil, ["hip"], "M", "", [("weight", 30.0)])
    TkP.with_piece(TkP.with_piece(p0, "wheel0", "part", 2, 4, 4, filled(2, 4, 4, 7), (0.0, 0.0, 3.0), (1.0, 2.0, 2.0)), "wheel1", "part", 2, 4, 4, filled(2, 4, 4, 7), (12.0, 0.0, 9.0), (1.0, 2.0, 2.0))
  end
  fn hover() : StrataKit.Part.KitPart do
    TkP.from_grid(10, 3, 10, filled(10, 3, 10, 6), m("attach", "part", 5.0, 3.0, 5.0), Nil, [m("thrust", "part", 2.0, 0.0, 2.0), m("thrust", "part", 8.0, 0.0, 8.0)], ["hip"], "M", "", [("weight", 18.0)])
  end
  fn pod() : StrataKit.Part.KitPart do
    TkP.from_grid(8, 6, 4, filled(8, 6, 4, 4), m("attach", "part", 4.0, 3.0, 4.0), Nil, Nil, ["back"], "M", "", [("weight", 8.0)])
  end
  fn heavy_gun() : StrataKit.Part.KitPart do TkP.from_grid(4, 4, 12, filled(4, 4, 12, 4), m("attach", "part", 2.0, 0.0, 2.0), Nil, Nil, ["shoulder"], "H", "", [("weight", 15.0)]) end
  fn light_gun() : StrataKit.Part.KitPart do TkP.from_grid(2, 2, 6, filled(2, 2, 6, 4), m("attach", "part", 1.0, 0.0, 1.0), Nil, Nil, ["shoulder", "hand"], "L", "", [("weight", 3.0)]) end

  fn all() : List(StrataKit.Part.KitPart) do [core(), arm_r(), rifle(), shield(), legs(), treads(), hover(), pod(), heavy_gun(), light_gun()] end

  pfn rank(s : String) : Int do if s == "L" do 0 else if s == "M" do 1 else if s == "H" do 2 else 9 end end end end
  doc "Steel Rain's fitting rule, as an example: the mount's slot is among the part's slots and the part is the mount's size or smaller."
  fn ok(slot : String, size : String, slots : List(String), psize : String) : Bool do List.any(slots, fn s -> s == slot) && rank(psize) <= rank(size) end
end
