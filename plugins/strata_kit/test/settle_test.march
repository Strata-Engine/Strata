-- Settling: resting loose pieces stamped into the world as blocks.
mod StrataKit.Test.Settle do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataKit.Damage as KitSd

  pfn reg() : Strata.Blocks.Registry do
    List.fold_left(List.range(0, 3), Strata.Blocks.empty(), fn (r, _) -> match Strata.Blocks.register(r, Strata.Blocks.def()) do Ok((r2, _)) -> r2 | Err(_) -> r end)
  end
  pfn flat() : Strata.Terrain.Gen do
    Strata.Terrain.gen(fn (k, seed) -> if Strata.Coord.ky(k) < 0 do Strata.Chunk.uniform(1) else Strata.Chunk.uniform(0) end)
  end
  pfn world() : Strata.World.World do
    let w = Strata.World.new(reg(), flat(), 7, 1.0)
    List.fold_left(List.range(0, 8), w, fn (acc, i) ->
      let k = Strata.Coord.key(i % 2 - 1, (i / 2) % 2 - 1, i / 4 - 1)
      Strata.World.insert(acc, k, Strata.Terrain.run(Strata.World.terrain(acc), k, Strata.World.seed(acc))))
  end
  -- a fine grid of n x m x n of block id, with an optional second id on its low half in x
  pfn cube(sx : Int, sy : Int, sz : Int, id : Int, low_id : Int, split : Int) : Strata.Body.Grid do
    List.fold_left(List.range(0, sx * sy * sz), Strata.Body.grid(sx, sy, sz), fn (g, i) ->
      let x = i % sx
      Strata.Body.grid_set(g, x, (i / sx) % sy, i / (sx * sy), if x < split do low_id else id end))
  end
  pfn nobody(x : Int, y : Int, z : Int) : Bool do false end
  pfn still() : (Float, Float, Float, Float) do (0.0, 0.0, 0.0, 1.0) end
  pfn cells(rs : List(Strata.Plugin.Request)) : Int do List.length(rs) end

  describe "Damage.settle" do
    test "a resting 8x8x8 fine cube becomes 2x2x2 world blocks" do
      Test.assert_true(cells(KitSd.settle(world(), cube(8, 8, 8, 2, 2, 0), (2.0, 0.0, 2.0), still(), 4, nobody)) == 8, "eight cells")
    end
    test "a thin plate under half a cell fills nothing there" do
      Test.assert_true(cells(KitSd.settle(world(), cube(8, 1, 8, 2, 2, 0), (2.0, 0.0, 2.0), still(), 4, nobody)) == 0, "none")
    end
    test "cells already solid are not overwritten" do
      Test.assert_true(cells(KitSd.settle(world(), cube(8, 8, 8, 2, 2, 0), (2.0, -1.0, 2.0), still(), 4, nobody)) == 4, "the air half only")
    end
    test "cells a figure occupies are dropped" do
      Test.assert_true(cells(KitSd.settle(world(), cube(8, 8, 8, 2, 2, 0), (2.0, 0.0, 2.0), still(), 4, fn (x, y, z) -> x == 2)) == 4, "x 3 only")
    end
    test "cells outside loaded chunks are dropped" do
      Test.assert_true(cells(KitSd.settle(world(), cube(8, 8, 8, 2, 2, 0), (500.0, 0.0, 500.0), still(), 4, nobody)) == 0, "none")
    end
    test "the most common block wins a cell" do
      -- a 4 x 4 x 4 fine cube in one cell: x 0..2 of id 3 (48), x 3 of id 2 (16)
      match Strata.Plugin.apply(world(), KitSd.settle(world(), cube(4, 4, 4, 2, 3, 3), (2.0, 0.0, 2.0), still(), 4, nobody)) do
        (w2, _, _) -> Test.assert_true(Strata.World.get_block(w2, 2, 0, 2) == 3, "id 3")
      end
    end
  end
end
