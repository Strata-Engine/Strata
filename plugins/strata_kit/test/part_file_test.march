-- PartFile: parts from MagicaVoxel files (test/fixtures, made by tools/make_fixtures.py).
mod StrataKit.Test.PartFile do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias StrataKit.Part as KitPf
  alias StrataKit.PartFile as KitPfl

  pfn load(n : String) : Result(StrataKit.Part.KitPart, String) do KitPfl.load("test/fixtures/" ++ n ++ ".vox", 16) end
  pfn err_has(r : Result(StrataKit.Part.KitPart, String), s : String) : Bool do match r do Err(e) -> String.contains(e, s) | Ok(_) -> false end end

  describe "PartFile.load" do
    test "an arm loads with its pieces in order and its two mounts" do
      match load("arm_m") do
        Ok(p) ->
          Test.assert_true(List.map(KitPf.pieces(p), fn q -> KitPf.piece_name(q)) == ["part", "upper", "fore"], "pieces")
          Test.assert_true(List.length(KitPf.mounts(p)) == 2 && Option.is_some(KitPf.mount(p, "hand_r")) && Option.is_some(KitPf.mount(p, "forearm_r")), "mounts")
        Err(e) -> Test.fail(e)
      end
    end
    test "a marker's position is its model's centre in rig axes" do
      -- attach at file (2, 2, 21), one voxel: rig centre (-2.5, 21.5, 2.5); the shoulder's low corner (-4, 18, 0)
      match load("arm_m") do
        Ok(p) -> Test.assert_true(KitPf.marker_at(KitPf.attach(p)) == (1.5, 3.5, 2.5) && KitPf.marker_piece(KitPf.attach(p)) == "part", "on the shoulder")
        Err(e) -> Test.fail(e)
      end
    end
    test "facing suffix @+z^+y converts to rig axes" do
      match load("arm_m") do
        Ok(p) ->
          match KitPf.mount(p, "hand_r") do
            Some(m) ->
              let k = KitPf.mount_marker(m)
              Test.assert_true(KitPf.marker_facing(k) == (0.0, 1.0, 0.0) && KitPf.marker_up(k) == (0.0, 0.0, 1.0), "file up is rig y, file y is rig z")
              Test.assert_true(KitPf.marker_piece(k) == "fore" && KitPf.marker_at(k) == (1.5, 0.5, 2.5), "on the forearm")
            None -> Test.fail("no hand mount")
          end
        Err(e) -> Test.fail(e)
      end
    end
    test "sidecar slots, size, side and tags" do
      match load("gun_l") do
        Ok(p) -> Test.assert_true(KitPf.slots(p) == ["hand", "shoulder", "forearm"] && KitPf.size(p) == "L" && KitPf.side(p) == "" && KitPf.tag(p, "weight") == 4.0, "gun")
        Err(e) -> Test.fail(e)
      end
      match load("arm_m") do
        Ok(p) -> Test.assert_true(KitPf.side(p) == "r" && KitPf.tag(p, "power") == 2.0, "arm")
        Err(e) -> Test.fail(e)
      end
    end
    test "legs load six leg pieces" do
      match load("legs_m") do
        Ok(p) -> Test.assert_true(List.length(KitPf.pieces(p)) == 7, "hip and six")
        Err(e) -> Test.fail(e)
      end
    end
    test "two attach markers are an error naming them" do
      Test.assert_true(err_has(load("bad_two_attach"), "attach"), "names attach")
    end
    test "a piece with an unknown parent is an error" do
      Test.assert_true(err_has(load("bad_parent"), "nope"), "names the parent")
    end
    test "a colour past the palette is an error" do
      Test.assert_true(match KitPfl.load("test/fixtures/arm_m.vox", 4) do Err(e) -> String.contains(e, "colour") | Ok(_) -> false end, "colour 5 with 4")
    end
    test "parse_sidecar reports the bad line" do
      Test.assert_true(match KitPfl.parse_sidecar("size = M\nweight 9\n") do Err(e) -> String.contains(e, "line 2") | Ok(_) -> false end, "line 2")
      Test.assert_true(KitPfl.parse_sidecar("# c\n\nslots = a b # c\n") == Ok([("slots", "a b")]), "comments")
    end
  end
end
