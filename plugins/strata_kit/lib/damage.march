-- Damage — what hits do to an assembled figure: holes carved in a part,
-- parts broken off as loose pieces, and loose pieces settling as rubble.
--
-- Carving works on a rig part's own grid: voxels whose centres lie within
-- the radius of the struck voxel's centre are removed, except those within a
-- small ball round the part's anchor (so a part stays on its joint until the
-- game decides it is destroyed), and every voxel left facing a removed one
-- takes the interior colour. The game re-uploads the rig
-- (Strata.Anim.replace_rig, Strata.Render.refresh_rig).
mod StrataKit.Damage do

  -- the interior colour (a palette index); the radius (voxels) round a part's anchor never removed
  type CarveSettings = { cv_interior : Int, cv_keep : Float }

  doc "Carving with [interior] as the colour of new faces, keeping 2 voxels round each part's anchor."
  fn carve_settings(interior : Int) : CarveSettings do { cv_interior: interior, cv_keep: 2.0 } end

  pfn idx(sx : Int, sy : Int, x : Int, y : Int, z : Int) : Int do x + sx * (y + sy * z) end
  pfn d2(ax : Float, ay : Float, az : Float, bx : Float, by0 : Float, bz : Float) : Float do (ax -. bx) *. (ax -. bx) +. (ay -. by0) *. (ay -. by0) +. (az -. bz) *. (az -. bz) end

  -- the cells of the box [lo, hi] clipped to the grid
  pfn cells(sx : Int, sy : Int, sz : Int, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int) : List((Int, Int, Int)) do
    let cx0 = if x0 < 0 do 0 else x0 end
    let cy0 = if y0 < 0 do 0 else y0 end
    let cz0 = if z0 < 0 do 0 else z0 end
    let cx1 = if x1 >= sx do sx - 1 else x1 end
    let cy1 = if y1 >= sy do sy - 1 else y1 end
    let cz1 = if z1 >= sz do sz - 1 else z1 end
    if cx0 > cx1 || cy0 > cy1 || cz0 > cz1 do Nil
    else List.flat_map(List.range(cz0, cz1 + 1), fn z -> List.flat_map(List.range(cy0, cy1 + 1), fn y -> List.map(List.range(cx0, cx1 + 1), fn x -> (x, y, z)))) end
  end

  pfn remove_go(g : NativeU8Arr, sx : Int, sy : Int, cs : List((Int, Int, Int)), hx : Float, hy : Float, hz : Float, r2 : Float, ax : Float, ay : Float, az : Float, k2 : Float, n : Int, gone : List((Int, Int, Int))) : (NativeU8Arr, Int, List((Int, Int, Int))) do
    match cs do
      Nil -> (g, n, gone)
      Cons((x, y, z), rest) ->
        let fx = int_to_float(x) +. 0.5
        let fy = int_to_float(y) +. 0.5
        let fz = int_to_float(z) +. 0.5
        let i = idx(sx, sy, x, y, z)
        if NativeArray.get_u8(g, i) != 0 && d2(fx, fy, fz, hx, hy, hz) <= r2 && d2(fx, fy, fz, ax, ay, az) > k2 do
          remove_go(NativeArray.set_u8(g, i, 0), sx, sy, rest, hx, hy, hz, r2, ax, ay, az, k2, n + 1, Cons((x, y, z), gone))
        else remove_go(g, sx, sy, rest, hx, hy, hz, r2, ax, ay, az, k2, n, gone) end
    end
  end

  pfn paint_faces(g : NativeU8Arr, sx : Int, sy : Int, sz : Int, gone : List((Int, Int, Int)), interior : Int) : NativeU8Arr do
    match gone do
      Nil -> g
      Cons((x, y, z), rest) ->
        let ns = [(x + 1, y, z), (x - 1, y, z), (x, y + 1, z), (x, y - 1, z), (x, y, z + 1), (x, y, z - 1)]
        let g2 = List.fold_left(ns, g, fn (acc, c) -> paint_one(acc, sx, sy, sz, c, interior))
        paint_faces(g2, sx, sy, sz, rest, interior)
    end
  end
  pfn paint_one(g : NativeU8Arr, sx : Int, sy : Int, sz : Int, c : (Int, Int, Int), interior : Int) : NativeU8Arr do
    match c do
      (x, y, z) ->
        if x < 0 || y < 0 || z < 0 || x >= sx || y >= sy || z >= sz do g
        else
          let i = idx(sx, sy, x, y, z)
          if NativeArray.get_u8(g, i) != 0 do NativeArray.set_u8(g, i, interior) else g end
        end
    end
  end

  doc "Carve rig part [part] round its voxel (x, y, z): voxels whose centres are within [radius] voxels of that voxel's centre are removed, except within the keep radius of the part's anchor; the voxels left facing a removed one take the interior colour. Answers the rig and how many voxels were removed."
  fn carve(rig : Strata.Rig.Rig, part : Int, x : Int, y : Int, z : Int, radius : Float, s : CarveSettings) : (Strata.Rig.Rig, Int) do
    match Strata.Rig.size(rig, part) do
      (sx, sy, sz) ->
        if sx * sy * sz == 0 do (rig, 0)
        else
          let rr = float_to_int(Math.ceil(radius))
          let (ax, ay, az) = Strata.Rig.anchor_at(rig, part)
          match remove_go(Strata.Rig.grid(rig, part), sx, sy, cells(sx, sy, sz, x - rr, y - rr, z - rr, x + rr, y + rr, z + rr),
                          int_to_float(x) +. 0.5, int_to_float(y) +. 0.5, int_to_float(z) +. 0.5, radius *. radius, ax, ay, az, s.cv_keep *. s.cv_keep, 0, Nil) do
            (g, n, gone) -> if n == 0 do (rig, 0) else (Strata.Rig.with_grid(rig, part, paint_faces(g, sx, sy, sz, gone, s.cv_interior)), n) end
          end
        end
    end
  end

  doc "Carve where a ray struck a figure (Strata.Anim.hit_ray's answer for a figure of this rig)."
  fn carve_hit(rig : Strata.Rig.Rig, h : Strata.Anim.FigureHit, radius : Float, s : CarveSettings) : (Strata.Rig.Rig, Int) do
    carve(rig, h.part, h.x, h.y, h.z, radius, s)
  end

  -- ── Breaking off ─────────────────────────────────────────────────────────

  -- a grid of block ids, its low corner in metres, its rotation (x, y, z, w)
  type KitLoose = KLoose(Strata.Body.Grid, (Float, Float, Float), (Float, Float, Float, Float))

  doc "A loose piece's grid of block ids."
  fn loose_grid(l : KitLoose) : Strata.Body.Grid do match l do KLoose(g, _, _) -> g end end
  doc "A loose piece's low corner in metres."
  fn loose_corner(l : KitLoose) : (Float, Float, Float) do match l do KLoose(_, c, _) -> c end end
  doc "A loose piece's rotation (x, y, z, w)."
  fn loose_turn(l : KitLoose) : (Float, Float, Float, Float) do match l do KLoose(_, _, q) -> q end end

  pfn rot(q : (Float, Float, Float, Float), v : (Float, Float, Float)) : (Float, Float, Float) do
    match (q, v) do
      ((qx, qy, qz, qw), (x, y, z)) ->
        let r = Strata.Math.Quat.rotate(Strata.Math.Quat.Quat(qx, qy, qz, qw), Strata.Math.Vec3.new(x, y, z))
        (Strata.Math.Vec3.x(r), Strata.Math.Vec3.y(r), Strata.Math.Vec3.z(r))
    end
  end
  pfn add3(a : (Float, Float, Float), b : (Float, Float, Float)) : (Float, Float, Float) do match (a, b) do ((ax, ay, az), (bx, by0, bz)) -> (ax +. bx, ay +. by0, az +. bz) end end

  -- a rig part's grid as block ids
  pfn body_of(rig : Strata.Rig.Rig, rp : Int, debris : Int -> Int) : Strata.Body.Grid do
    match Strata.Rig.size(rig, rp) do
      (sx, sy, sz) ->
        let g = Strata.Rig.grid(rig, rp)
        List.fold_left(List.range(0, sx * sy * sz), Strata.Body.grid(sx, sy, sz), fn (b, i) ->
          let c = NativeArray.get_u8(g, i)
          if c == 0 do b else Strata.Body.grid_set(b, i % sx, (i / sx) % sy, i / (sx * sy), debris(c)) end)
    end
  end

  pfn is_under(p : List(String), prefix : List(String)) : Bool do List.take(p, List.length(prefix)) == prefix end

  pfn loose_of(rig : Strata.Rig.Rig, rp : Int, pose : Int -> ((Float, Float, Float), (Float, Float, Float, Float)), debris : Int -> Int, shatter : Option((Int, Int, Int, Int, Float, Strata.Blocks.Registry))) : List(KitLoose) do
    let v = Strata.Rig.voxel_size(rig)
    let (ax, ay, az) = Strata.Rig.anchor_at(rig, rp)
    match pose(rp) do
      (origin, q) ->
        let corner = add3(origin, rot(q, (0.0 -. ax *. v, 0.0 -. ay *. v, 0.0 -. az *. v)))
        let g = body_of(rig, rp, debris)
        match shatter do
          Some((srp, x, y, z, excess, reg)) ->
            if srp == rp do
              List.map(Strata.Fracture.pieces(reg, g, x, y, z, excess, v, rp), fn pc -> match pc do
                (pg, lx, ly, lz) -> KLoose(pg, add3(corner, rot(q, (int_to_float(lx) *. v, int_to_float(ly) *. v, int_to_float(lz) *. v))), q)
              end)
            else [KLoose(g, corner, q)] end
          None -> [KLoose(g, corner, q)]
        end
    end
  end

  doc "Break off the node at [path]: the build without it (StrataKit.Build.detach), and every rig part of the removed subtree (as carved) as a loose grid of block ids ([debris] maps a palette index to a block id) at its pose ([pose] gives a rig part's world origin and rotation, from Strata.Anim). With Some((rig part, x, y, z, excess, registry)) the struck part is first cut round its voxel (x, y, z) by Strata.Fracture.pieces. The grids are at the rig's voxel size: add them with Strata.Physics.add_fine. The root cannot be broken off ((b, none))."
  fn break_off(m : StrataKit.Assemble.KitMap, b : StrataKit.Build.KitBuild, rig : Strata.Rig.Rig, pose : Int -> ((Float, Float, Float), (Float, Float, Float, Float)), path : List(String), debris : Int -> Int, shatter : Option((Int, Int, Int, Int, Float, Strata.Blocks.Registry))) : (StrataKit.Build.KitBuild, List(KitLoose)) do
    match StrataKit.Build.detach(b, path) do
      (rest, None) -> (rest, Nil)
      (rest, Some(_)) ->
        let rps = List.filter_map(StrataKit.Assemble.entries(m), fn e -> match e do (rp, p, _) -> if is_under(p, path) do Some(rp) else None end end)
        (rest, List.flat_map(rps, fn rp -> loose_of(rig, rp, pose, debris, shatter)))
    end
  end
end
