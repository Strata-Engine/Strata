-- Part — a piece of a modular figure: voxel pieces, where it attaches, the
-- mounts it offers, effect markers and the game's numeric tags.
--
-- Coordinates are the part's own voxels, y up, facing +z forward (the rig's
-- axes). A part is one or more pieces: the root (named "part") and pieces
-- jointed to it or to each other, each a voxel grid (palette indices of the
-- game's shared palette, 0 empty, index x + sx * (y + sy * z)). A piece has an
-- anchor, the point of its own grid it turns about, and a pivot, where that
-- point sits in its parent piece's grid; the root's anchor is the part's
-- attach point.
--
-- A marker is a named point on one piece with a facing and an up direction
-- (unit vectors). A mount is a marker that offers a slot (a slot type and a
-- size, the game's strings); a mount named ..._l is on the left.
mod StrataKit.Part do

  -- name, the piece it is on, position (that piece's voxels), facing, up
  type KitMarker = KMarker(String, String, Float, Float, Float, (Float, Float, Float), (Float, Float, Float))
  -- slot type, size, name, where
  type KitMount = KMount(String, String, String, KitMarker)
  -- name, parent piece ("" for the root), size, grid, pivot (parent's voxels), anchor (own voxels)
  type KitPiece = KPiece(String, String, Int, Int, Int, NativeU8Arr, (Float, Float, Float), (Float, Float, Float))
  type KitPart = { kp_pieces : List(KitPiece), kp_attach : KitMarker, kp_mounts : List(KitMount), kp_fx : List(KitMarker),
                   kp_slots : List(String), kp_size : String, kp_side : String, kp_tags : List((String, Float)) }

  doc "A marker [name] on piece [piece] at (x, y, z) with [facing] and [up]."
  fn marker(name : String, piece : String, x : Float, y : Float, z : Float, facing : (Float, Float, Float), up : (Float, Float, Float)) : KitMarker do KMarker(name, piece, x, y, z, facing, up) end
  doc "A marker's name."
  fn marker_name(m : KitMarker) : String do match m do KMarker(n, _, _, _, _, _, _) -> n end end
  doc "The piece a marker is on."
  fn marker_piece(m : KitMarker) : String do match m do KMarker(_, p, _, _, _, _, _) -> p end end
  doc "A marker's position in its piece's voxels."
  fn marker_at(m : KitMarker) : (Float, Float, Float) do match m do KMarker(_, _, x, y, z, _, _) -> (x, y, z) end end
  doc "A marker's facing."
  fn marker_facing(m : KitMarker) : (Float, Float, Float) do match m do KMarker(_, _, _, _, _, f, _) -> f end end
  doc "A marker's up."
  fn marker_up(m : KitMarker) : (Float, Float, Float) do match m do KMarker(_, _, _, _, _, _, u) -> u end end

  doc "A mount offering [slot] of [size], named [name], at [where]."
  fn mount_of(slot : String, size : String, name : String, where : KitMarker) : KitMount do KMount(slot, size, name, where) end
  doc "A mount's slot type."
  fn mount_slot(m : KitMount) : String do match m do KMount(s, _, _, _) -> s end end
  doc "A mount's size."
  fn mount_size(m : KitMount) : String do match m do KMount(_, z, _, _) -> z end end
  doc "A mount's name."
  fn mount_name(m : KitMount) : String do match m do KMount(_, _, n, _) -> n end end
  doc "Where a mount is."
  fn mount_marker(m : KitMount) : KitMarker do match m do KMount(_, _, _, w) -> w end end
  doc "Is the mount on the left (its name ends _l)?"
  fn mount_left(m : KitMount) : Bool do String.ends_with(mount_name(m), "_l") end

  doc "A piece: [name], jointed to [parent] (\"\" for the root), its grid of sx x sy x sz, its [pivot] in the parent's voxels and its [anchor] in its own."
  fn piece_of(name : String, parent : String, sx : Int, sy : Int, sz : Int, grid : NativeU8Arr, pivot : (Float, Float, Float), anchor : (Float, Float, Float)) : KitPiece do KPiece(name, parent, sx, sy, sz, grid, pivot, anchor) end
  doc "The piece with its anchor moved to [a]."
  fn with_anchor(p : KitPiece, a : (Float, Float, Float)) : KitPiece do match p do KPiece(n, q, x, y, z, g, v, _) -> KPiece(n, q, x, y, z, g, v, a) end end

  doc "A piece's name."
  fn piece_name(p : KitPiece) : String do match p do KPiece(n, _, _, _, _, _, _, _) -> n end end
  doc "A piece's parent piece (\"\" for the root)."
  fn piece_parent(p : KitPiece) : String do match p do KPiece(_, q, _, _, _, _, _, _) -> q end end
  doc "A piece's size."
  fn piece_size(p : KitPiece) : (Int, Int, Int) do match p do KPiece(_, _, x, y, z, _, _, _) -> (x, y, z) end end
  doc "A piece's grid."
  fn piece_grid(p : KitPiece) : NativeU8Arr do match p do KPiece(_, _, _, _, _, g, _, _) -> g end end
  doc "Where a piece's anchor sits in its parent's voxels."
  fn piece_pivot(p : KitPiece) : (Float, Float, Float) do match p do KPiece(_, _, _, _, _, _, v, _) -> v end end
  doc "A piece's anchor in its own voxels."
  fn piece_anchor(p : KitPiece) : (Float, Float, Float) do match p do KPiece(_, _, _, _, _, _, _, a) -> a end end

  doc "A part of one piece named \"part\": its grid, its attach marker (the piece's anchor), mounts, effect markers, the slots it goes in, its size, its side (\"r\", \"l\" or \"\" for either) and tags."
  fn from_grid(sx : Int, sy : Int, sz : Int, grid : NativeU8Arr, attach : KitMarker, mounts : List(KitMount), fx : List(KitMarker), slots : List(String), size : String, side : String, tags : List((String, Float))) : KitPart do
    { kp_pieces: [KPiece("part", "", sx, sy, sz, grid, (0.0, 0.0, 0.0), marker_at(attach))], kp_attach: attach, kp_mounts: mounts, kp_fx: fx,
      kp_slots: slots, kp_size: size, kp_side: side, kp_tags: tags }
  end

  doc "The part with piece [name] added, jointed to [parent] at [pivot] (parent's voxels), turning about [anchor] (its own voxels)."
  fn with_piece(p : KitPart, name : String, parent : String, sx : Int, sy : Int, sz : Int, grid : NativeU8Arr, pivot : (Float, Float, Float), anchor : (Float, Float, Float)) : KitPart do
    { p with kp_pieces: List.append(p.kp_pieces, [KPiece(name, parent, sx, sy, sz, grid, pivot, anchor)]) }
  end

  doc "The part's pieces, the root first."
  fn pieces(p : KitPart) : List(KitPiece) do p.kp_pieces end
  doc "The part's attach marker."
  fn attach(p : KitPart) : KitMarker do p.kp_attach end
  doc "The mounts the part offers."
  fn mounts(p : KitPart) : List(KitMount) do p.kp_mounts end
  doc "The part's effect markers."
  fn fx(p : KitPart) : List(KitMarker) do p.kp_fx end
  doc "The slot types the part goes in."
  fn slots(p : KitPart) : List(String) do p.kp_slots end
  doc "The part's size."
  fn size(p : KitPart) : String do p.kp_size end
  doc "The side the part is drawn for: \"r\", \"l\", or \"\" for either."
  fn side(p : KitPart) : String do p.kp_side end
  doc "The game's numeric tag [key] (0 when absent)."
  fn tag(p : KitPart, key : String) : Float do match List.find(p.kp_tags, fn t -> match t do (k, _) -> k == key end) do Some((_, v)) -> v | None -> 0.0 end end
  doc "The mount named [name], if the part offers one."
  fn mount(p : KitPart, name : String) : Option(KitMount) do List.find(p.kp_mounts, fn m -> mount_name(m) == name) end
  doc "The piece named [name]."
  fn piece(p : KitPart, name : String) : Option(KitPiece) do List.find(p.kp_pieces, fn q -> piece_name(q) == name) end

  -- ── Mirroring ───────────────────────────────────────────────────────────
  pfn flip_grid(g : NativeU8Arr, sx : Int, sy : Int, sz : Int) : NativeU8Arr do
    List.fold_left(List.range(0, sx * sy * sz), NativeArray.make_u8(sx * sy * sz, 0), fn (out, i) ->
      NativeArray.set_u8(out, (sx - 1 - i % sx) + sx * (i / sx), NativeArray.get_u8(g, i)))
  end
  pfn side_name(n : String) : String do
    if String.ends_with(n, "_l") do String.slice_bytes(n, 0, String.byte_size(n) - 2) ++ "_r"
    else if String.ends_with(n, "_r") do String.slice_bytes(n, 0, String.byte_size(n) - 2) ++ "_l"
    else n end end
  end
  pfn width_of(p : KitPart, piece_n : String) : Float do
    match piece(p, piece_n) do Some(q) -> match piece_size(q) do (x, _, _) -> int_to_float(x) end | None -> 0.0 end
  end
  pfn flip_vec(v : (Float, Float, Float)) : (Float, Float, Float) do match v do (x, y, z) -> (0.0 -. x, y, z) end end
  pfn mirror_marker(p : KitPart, m : KitMarker) : KitMarker do
    match m do KMarker(n, pc, x, y, z, f, u) -> KMarker(side_name(n), side_name(pc), width_of(p, pc) -. x, y, z, flip_vec(f), u) end
  end
  pfn mirror_piece(p : KitPart, q : KitPiece) : KitPiece do
    match q do
      KPiece(n, par, sx, sy, sz, g, (vx, vy, vz), (ax, ay, az)) ->
        let pw = if par == "" do 0.0 else width_of(p, par) end
        KPiece(side_name(n), side_name(par), sx, sy, sz, flip_grid(g, sx, sy, sz), (if par == "" do vx else pw -. vx end, vy, vz), (int_to_float(sx) -. ax, ay, az))
    end
  end

  doc "The part mirrored left for right: every grid flipped in x, every marker and joint mirrored within its piece (x becomes the piece's width less x; facing and up have x negated), names ending _l and _r swapped (mounts and pieces), side r and l swapped. Mirroring twice gives the part back."
  fn mirror(p : KitPart) : KitPart do
    { p with kp_pieces: List.map(p.kp_pieces, fn q -> mirror_piece(p, q)), kp_attach: mirror_marker(p, p.kp_attach),
             kp_mounts: List.map(p.kp_mounts, fn m -> match m do KMount(s, z, n, w) -> KMount(s, z, side_name(n), mirror_marker(p, w)) end),
             kp_fx: List.map(p.kp_fx, fn m -> mirror_marker(p, m)),
             kp_side: if p.kp_side == "r" do "l" else if p.kp_side == "l" do "r" else p.kp_side end end }
  end
end
