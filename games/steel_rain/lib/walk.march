-- Walk — a unit walking a path of tile centres (metres).
--
-- It starts on the first centre and heads for each next one in turn at a
-- given speed, carrying a step's leftover distance round corners; its height
-- runs straight between centres, so it climbs and drops with the ground. The
-- heading is the turn about y from +z toward +x (so +z is 0, +x a quarter
-- turn), as Strata.Anim.place takes it.
mod SteelRain.Walk do

  -- where it is, the centres still ahead, the heading, moving this step
  type Walk = { wk_pos : (Float, Float, Float), wk_ahead : List((Float, Float, Float)), wk_heading : Float, wk_moving : Bool }

  doc "A walk along [centres], standing on the first (an empty list stands at the origin)."
  fn start(centres : List((Float, Float, Float))) : Walk do
    match centres do
      Nil -> { wk_pos: (0.0, 0.0, 0.0), wk_ahead: Nil, wk_heading: 0.0, wk_moving: false }
      Cons(p, rest) -> { wk_pos: p, wk_ahead: rest, wk_heading: first_heading(p, rest), wk_moving: false }
    end
  end
  pfn first_heading(p : (Float, Float, Float), rest : List((Float, Float, Float))) : Float do
    match rest do Cons(q, _) -> heading_to(p, q, 0.0) | Nil -> 0.0 end
  end
  pfn heading_to(p : (Float, Float, Float), q : (Float, Float, Float), old : Float) : Float do
    match (p, q) do
      ((px, _, pz), (qx, _, qz)) -> if Math.abs(qx -. px) +. Math.abs(qz -. pz) < 0.000001 do old else Math.atan2(qx -. px, qz -. pz) end
    end
  end

  doc "The walk [dt] seconds on at [speed] m/s."
  fn step(w : Walk, dt : Float, speed : Float) : Walk do go({ w with wk_moving: false }, speed *. dt) end

  pfn go(w : Walk, left : Float) : Walk do
    match w.wk_ahead do
      Nil -> w
      Cons(q, rest) ->
        if left <= 0.0 do w
        else
          match (w.wk_pos, q) do
            ((px, py, pz), (qx, qy, qz)) ->
              let dx = qx -. px
              let dy = qy -. py
              let dz = qz -. pz
              let flat = Math.sqrt(dx *. dx +. dz *. dz)
              let h = heading_to(w.wk_pos, q, w.wk_heading)
              if flat <= left do go({ w with wk_pos: q, wk_ahead: rest, wk_heading: h, wk_moving: true }, left -. flat)
              else
                let k = left /. flat
                { w with wk_pos: (px +. dx *. k, py +. dy *. k, pz +. dz *. k), wk_heading: h, wk_moving: true }
              end
          end
        end
    end
  end

  doc "Where it is (metres)."
  fn pos(w : Walk) : (Float, Float, Float) do w.wk_pos end
  doc "Its heading (radians about y, +z is 0)."
  fn heading(w : Walk) : Float do w.wk_heading end
  doc "Has it reached the last centre?"
  fn done(w : Walk) : Bool do List.is_empty(w.wk_ahead) end
  doc "Did the last step move it?"
  fn moving(w : Walk) : Bool do w.wk_moving end
end
