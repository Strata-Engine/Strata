-- Steel Rain, the first prototype: one mech on a generated map.
--
-- The map comes from strata_maps (rolling ground and a river with weirs and
-- fords, checked for routes); strata_tactics lays its grid over the playable
-- square and runs the camera; the mech is the Warden (SteelRain.Mech), built from strata_kit
-- parts sculpted in code. Hovering a
-- tile the mech can reach shows the way; a click sends it walking there tile
-- by tile, its legs stepping, the camera following; when it arrives its reach
-- is shown again. Camera: W A S D pan, Q E turn, R F zoom, the right mouse
-- button drags it round, Page Up / Down move the floor cut. Escape quits.
--
-- STRATA_MAP_SEED (default 5) picks the map; STRATA_CLOSE=1 starts the camera
-- close and low, STRATA_YAW its angle in degrees (default 45). STRATA_FRAMES=n runs n frames
-- without input, sending the mech to the reachable tile furthest north at
-- frame 20, and writes frame n - 3 to STRATA_SHOT.
mod SteelRain do

  needs IO
  needs IO.Process
  needs IO.Spawn
  needs IO.Foreign
  needs Audio
  needs IO.FileSystem
  needs Anim

  alias StrataKit.Motion as SrMo
  alias Strata.Blocks as SrBl
  alias Strata.Math.Mat4 as SrM
  alias Strata.Math.Quat as SrQ

  doc "The prototype's version."
  fn version() : String do "0.1.0" end

  -- ── Blocks: 1 stone, 2 dirt, 3 grass, 4 sand, 5 asphalt, 6 concrete, 7 lava, 8 rubble, 9 scorched, 10 deck, 11 sink, 12..19 water ──
  pfn plain(tex : Int) : Strata.Blocks.Def do SrBl.with_faces(SrBl.def(), tex, tex, tex) end
  pfn add(r : Strata.Blocks.Registry, d : Strata.Blocks.Def) : Strata.Blocks.Registry do
    match SrBl.register(r, d) do Ok((r2, _)) -> r2 | Err(_) -> r end
  end
  pfn registry() : Strata.Blocks.Registry do
    let water = SrBl.with_material(SrBl.with_faces(SrBl.with_collide(SrBl.with_layer(SrBl.with_opacity(SrBl.def(), Strata.Blocks.SeeThrough), Strata.Blocks.Translucent), false), 11, 11, 11), 10, 0)
    let r10 = List.fold_left([plain(1), plain(2), SrBl.with_faces(SrBl.def(), 3, 2, 2), plain(4), plain(5), plain(6), plain(7), plain(8), plain(9), plain(10)], SrBl.empty(), fn (r, d) -> add(r, d))
    let r11 = add(r10, water)
    match SrBl.register_fluid(r11, water) do Ok((r19, _)) -> r19 | Err(_) -> r11 end
  end
  pfn blocks() : StrataMaps.Settings.MapBlocks do
    { mb_stone: 1, mb_dirt: 2, mb_grass: 3, mb_sand: 4, mb_asphalt: 5, mb_concrete: 6, mb_water: 19, mb_sink: 11, mb_weir: 6, mb_lava: 7, mb_rubble: 8, mb_scorched: 9, mb_deck: 10 }
  end
  -- the grid's terrain kinds: 1 ground, 2 water (the sink and the fluid)
  pfn kind(id : Int) : Int do if id == 11 || id >= 12 do 2 else 1 end end

  pfn tile_px(a : NativeU8Arr, i : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if i >= 256 do a
    else
      let n = ((i * 2654435761) / 65536) % 24 - 12
      let a1 = NativeArray.set_u8(NativeArray.set_u8(a, i * 4, chan(r + n)), i * 4 + 1, chan(g + n))
      tile_px(NativeArray.set_u8(NativeArray.set_u8(a1, i * 4 + 2, chan(b + n)), i * 4 + 3, 255), i + 1, r, g, b)
    end
  end
  pfn chan(v : Int) : Int do if v < 0 do 0 else if v > 255 do 255 else v end end end
  pfn tex(i : Int, r : Int, g : Int, b : Int) : Bool do Strata.Ffi.Vk.texture_set(i, tile_px(NativeArray.make_u8(1024, 0), 0, r, g, b)) end
  pfn textures(reg : Strata.Blocks.Registry) : Bool do
    Strata.Ffi.Vk.textures_create(16, 12)
      && tex(0, 255, 0, 255) && tex(1, 122, 120, 116) && tex(2, 112, 84, 58) && tex(3, 86, 132, 60) && tex(4, 196, 180, 132)
      && tex(5, 52, 52, 56) && tex(6, 168, 164, 156) && tex(7, 230, 90, 20) && tex(8, 104, 98, 92) && tex(9, 40, 36, 34)
      && tex(10, 120, 96, 70) && tex(11, 56, 98, 140)
      && Strata.Ffi.Vk.textures_commit() && Strata.Render.upload_blocks(reg)
  end

  pfn settle(s : Strata.Stream.Stream, n : Int) : Strata.Stream.Stream do
    if n >= 100000 do s else let s2 = Strata.Stream.tick(s)
      if Strata.Stream.settled(s2) do s2 else settle(s2, n + 1) end end
  end

  -- ── The mech: SteelRain.Mech (the Warden) ────────────────────────────────
  pfn stand() : Float do SteelRain.Mech.stand() end

  -- ── The game ─────────────────────────────────────────────────────────────
  -- the mech's tile, its walk, gait, figure; input; the last view-projection
  type Game = { gm_tile : (Int, Int), gm_walk : SteelRain.Walk.Walk, gm_gait : StrataKit.Motion.KitGait, gm_f : Int, gm_input : Strata.Input.Input, gm_vp : NativeFloatArr }

  pfn mover() : StrataTactics.Reach.Mover do StrataTactics.Reach.mover(5, 2, 3, 10) end
  pfn cost(k : Int) : Int do if k == 2 do 2 else 1 end end
  pfn reach_of(gr : StrataTactics.Grid.TileGrid, t : (Int, Int)) : StrataTactics.Reach.Reach do
    StrataTactics.Reach.find(gr, t, mover(), cost, fn _ -> StrataTactics.Reach.pass_open())
  end
  pfn walking(g : Game) : Bool do !SteelRain.Walk.done(g.gm_walk) end

  -- the first standable tile from the south edge's middle
  pfn home_tile(gr : StrataTactics.Grid.TileGrid, n : Int) : (Int, Int) do
    let order = List.flat_map(List.range(0, n), fn tz -> List.map(List.range(0, n), fn k -> ((n / 2 + (if k % 2 == 0 do k / 2 else 0 - (k + 1) / 2 end) + n) % n, tz)))
    match List.find(order, fn t -> StrataTactics.Grid.standable(gr, t)) do Some(t) -> t | None -> (n / 2, 0) end
  end
  -- the scripted target: the reachable tile furthest north (the largest z)
  pfn furthest(r : StrataTactics.Reach.Reach) : Option((Int, Int)) do
    List.fold_left(StrataTactics.Reach.tiles(r), None, fn (best, t) -> match (best, t) do
      (None, _) -> Some(t)
      (Some((bx, bz)), (_, tz)) -> if tz > bz do Some(t) else best end
    end)
  end

  -- the marks: the reach and the way to the hovered tile while standing; the way still ahead while walking
  pfn marks(tac : StrataTactics.TacticsState, g : Game, hovered : Option((Int, Int))) : StrataTactics.TacticsState do
    let gr = StrataTactics.grid(tac)
    let col = StrataTactics.Marks.colours()
    if walking(g) do tac
    else
      let r = reach_of(gr, g.gm_tile)
      let ts = StrataTactics.Reach.tiles(r)
      let way = match hovered do Some(t) -> StrataTactics.Marks.path(gr, StrataTactics.Reach.path(r, t), col.mc_path) | None -> Nil end
      StrataTactics.show(tac, List.append(StrataTactics.Marks.tiles(gr, ts, col.mc_reach), List.append(StrataTactics.Marks.outline(gr, ts, col.mc_outline), way)))
    end
  end

  pfn tile_name(t : (Int, Int)) : String do match t do (x, z) -> "(" ++ int_to_string(x) ++ ", " ++ int_to_string(z) ++ ")" end end

  -- send the mech to tile t if it can get there
  pfn order_move(tac : StrataTactics.TacticsState, g : Game, t : (Int, Int)) : (StrataTactics.TacticsState, Game) do
    let gr = StrataTactics.grid(tac)
    let r = reach_of(gr, g.gm_tile)
    if walking(g) || t == g.gm_tile || Option.is_none(StrataTactics.Reach.cost_to(r, t)) do (tac, g)
    else
      let way = StrataTactics.Reach.path(r, t)
      let centres = List.map(way, fn p -> StrataTactics.Grid.centre(gr, p))
      Authority.must(println("steel_rain: walking " ++ tile_name(g.gm_tile) ++ " to " ++ tile_name(t) ++ " over " ++ int_to_string(List.length(way) - 1) ++ " tiles (reach " ++ int_to_string(List.length(StrataTactics.Reach.tiles(r))) ++ " tiles; from there " ++ int_to_string(List.length(StrataTactics.Reach.tiles(reach_of(gr, t)))) ++ ")"))
      (StrataTactics.with_camera(tac, StrataTactics.Camera.follow(StrataTactics.camera(tac), StrataTactics.Grid.centre(gr, t))), { g with gm_tile: t, gm_walk: SteelRain.Walk.start(centres) })
    end
  end

  -- the mech placed where its walk is, its legs stepping
  pfn pose(a : Strata.Anim.Anim, g : Game, dt : Float) : (Strata.Anim.Anim, Game) do
    let w = SteelRain.Walk.step(g.gm_walk, dt, 2.5)
    let speed = if SteelRain.Walk.moving(w) do 2.5 else 0.0 end
    let h = SteelRain.Walk.heading(w)
    match SteelRain.Walk.pos(w) do
      (x, y, z) ->
        let a1 = Strata.Anim.place(a, g.gm_f, x, y +. stand(), z, SrQ.from_axis_angle(0.0, 1.0, 0.0, h))
        match SrMo.gait_step(g.gm_gait, dt, (x, y, z), h, speed, 0.0) do
          (g2, targets, bob) -> (Strata.Anim.update(SrMo.gait_apply(a1, g.gm_f, g2, targets, bob, (x, y, z), h), dt), { g with gm_walk: w, gm_gait: g2 })
        end
    end
  end

  pfn frame_loop(s : Strata.Stream.Stream, sl : Strata.Render.Render, a : Strata.Anim.Anim, tac : StrataTactics.TacticsState, g : Game, frame : Int, frames : Int, t_prev : Float, vpbuf : NativeF32Arr) : Unit do
    Strata.Ffi.Vk.poll()
    let scripted = frames > 0
    let now = Strata.Ffi.Vk.time()
    let dt = if scripted do 1.0 /. 60.0 else (if now -. t_prev > 0.1 do 0.1 else now -. t_prev end) end
    let inp = Strata.Input.step(g.gm_input, if scripted do Strata.Input.idle() else Strata.Render.input(g.gm_input, 0) end)
    if Strata.Ffi.Vk.should_close() || Strata.Input.held(inp, "game.quit") || (scripted && frame >= frames) do ()
    else
      let ww = int_to_float(Strata.Ffi.Vk.win_w())
      let wh = int_to_float(Strata.Ffi.Vk.win_h())
      let pointer = if scripted do None else Some((Strata.Ffi.Vk.mouse_x(), Strata.Ffi.Vk.mouse_y())) end
      let f = Strata.Plugin.frame(Strata.Stream.world(s), inp, pointer, if scripted do 0.0 else Strata.Ffi.Vk.scroll_y() end, dt, ww, wh, g.gm_vp)
      match StrataTactics.update(tac, f) do
        (tac1, _, evs) ->
          let target = if scripted do (if frame == 20 do furthest(reach_of(StrataTactics.grid(tac1), g.gm_tile)) else None end)
            else List.head_opt(List.filter_map(evs, fn e -> if StrataTactics.event_index(e) == 2 do StrataTactics.event_tile(e) else None end)) end
          let (tac2, g1) = match target do Some(t) -> order_move(tac1, g, t) | None -> (tac1, g) end
          let hovered = if scripted do None else StrataTactics.hovered(tac2) end
          let (a2, g2) = pose(a, g1, dt)
          -- while it walks the camera keeps it in view
          let tac2b = if walking(g1) do StrataTactics.with_camera(tac2, StrataTactics.Camera.follow(StrataTactics.camera(tac2), SteelRain.Walk.pos(g2.gm_walk))) else tac2 end
          let tac3 = marks(tac2b, g2, hovered)
          match Strata.Render.sync(sl, Strata.Stream.tick(s)) do
            (sl2, s2) ->
              let subject = match SteelRain.Walk.pos(g2.gm_walk) do (x, y, z) -> Some((x, y +. 2.0, z)) end
              if Strata.Render.overlay(StrataTactics.overlay(tac3, subject)) do () else () end
              let aspect = if wh > 0.0 do ww /. wh else 1.6 end
              let vp = StrataTactics.view_proj(tac3, aspect)
              let vpb = SrM.write_f32(vp, vpbuf)
              Strata.Ffi.Vk.set_camera(vpb)
              match StrataTactics.Camera.eye(StrataTactics.camera(tac3)) do (ex, ey, ez) -> Strata.Ffi.Vk.set_eye(ex, ey, ez, 0.4) end
              let u0 = Strata.Render.ui_begin(1.0)
              let u1 = Strata.Text.text(u0, Strata.Ui.bottom_left(), 12.0, 12.0, Strata.Text.default_font(), 14.0, (1.0, 1.0, 1.0, 1.0), "click a blue tile: move   WASD QE RF, right drag: camera   Esc: quit")
              if Strata.Render.draw_ui(u1) do () else () end
              Strata.Render.set_time(if scripted do int_to_float(frame) /. 60.0 else now end)
              if scripted && frame == frames - 3 do Strata.Ffi.Vk.request_shot() else () end
              let next = if Strata.Render.draw(1.0) do frame + 1 else frame end
              frame_loop(s2, sl2, a2, tac3, { g2 with gm_input: inp, gm_vp: vp }, next, frames, now, vpb)
          end
      end
    end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let frames = Authority.must(Env.get_int("STRATA_FRAMES", 0))
    let seed = Authority.must(Env.get_int("STRATA_MAP_SEED", 5))
    if !Strata.Ffi.Vk.open(1280, 800, false, 0) do Authority.must(println("steel_rain: could not open a Vulkan window"))
    else
      Strata.Ffi.Vk.set_offscreen(Authority.must(Env.get_int("STRATA_OFFSCREEN", 0)) == 1)
      Strata.Ffi.Vk.set_lighting(4)
      let reg = registry()
      if Strata.Render.set_light_box(7, 3) do () else () end
      if textures(reg) do () else Authority.must(println("steel_rain: could not upload textures")) end
      Strata.Render.set_sun(0.45, 0.82, 0.35, 1.0, 0.92, 0.8)
      Strata.Ffi.Vk.set_fog(160.0, 320.0)
      let s0 = StrataMaps.Settings.settings(seed, 16)
      let ms = { s0 with ms_base: 1, ms_knobs: StrataMaps.Settings.with_knob(StrataMaps.Settings.with_knob(s0.ms_knobs, "relief", 0.4), "water", 0.5) }
      match StrataMaps.generate(ms, blocks(), 4, 2) do
        (gen, d, rep) ->
          Authority.must(println("steel_rain: map " ++ (if rep.cr_ok do "passed" else "failed" end) ++ " with " ++ int_to_string(rep.cr_routes) ++ " routes"))
          let (hi, lo) = StrataMaps.TerrainStage.span(d)
          let mid_y = int_to_float((hi + lo) / 2) *. 0.4
          let w0 = Strata.World.new(reg, gen, d.md_settings.ms_seed, 0.4)
          let st = settle(Strata.Stream.set_focus(Strata.Stream.start(w0, Strata.Stream.config(7, 3, 64, 8)), [(0.0, mid_y, 0.0)]), 0)
          -- the grid over the playable square: 16 x 16 tiles of 8 voxels, height steps of 2
          let x0 = StrataMaps.Data.corner(d.md_settings) + StrataMaps.Settings.ring_voxels()
          let n = d.md_settings.ms_tiles
          let gs = StrataTactics.Grid.settings(x0, x0, n, n, 8, 2, lo - 8, hi + 24, 10, kind)
          let cfg0 = StrataTactics.config(gs)
          let cs = cfg0.tx_camera
          -- the cut keeps 2.5 m round the Warden's middle (its chest and guns reach forward of it)
          let close = Authority.must(Env.get_int("STRATA_CLOSE", 0)) == 1
          let cfg = { cfg0 with tx_camera: if close do { cs with cm_near: 15.0, cm_far: 17.0, cm_pitch_near_deg: 24.0, cm_pitch_far_deg: 24.0, cm_cut_clear: 2.5 } else { cs with cm_near: 12.0, cm_far: 60.0, cm_cut_clear: 2.5 } end }
          match StrataTactics.setup(cfg, reg, Strata.Stream.world(st)) do
            (tac0, _, tac_bindings) ->
              match Strata.Input.merge([("game", [("game.quit", Strata.Input.Key(256), 1.0)]), ("tactics", tac_bindings)]) do
                (bindings, _) ->
                  let gr = StrataTactics.grid(tac0)
                  let home = home_tile(gr, n)
                  match SteelRain.Mech.assemble() do
                    (rig, _, _) ->
                      match Strata.Anim.finish_rig(Strata.Anim.open(16), rig) do
                        (a0, id) ->
                          match StrataTactics.Grid.centre(gr, home) do
                            (hx, hy, hz) ->
                              match Strata.Anim.spawn_at(a0, id, hx, hy +. stand(), hz, SrQ.identity()) do
                                (a1, fig) ->
                                  let g0 = { gm_tile: home, gm_walk: SteelRain.Walk.start([(hx, hy, hz)]), gm_gait: SrMo.gait(rig), gm_f: fig, gm_input: Strata.Input.start(Strata.Input.new(bindings)), gm_vp: SrM.identity() }
                                  -- the floor cut starts four levels up (12 m over the focus): open ground keeps its hills; Page Down lowers it into buildings
                                  let yaw = int_to_float(Authority.must(Env.get_int("STRATA_YAW", 45)))
                                  let c0 = StrataTactics.camera(tac0)
                                  let tac1 = StrataTactics.with_camera(tac0, StrataTactics.Camera.follow(StrataTactics.Camera.set_level({ c0 with tc_yaw: yaw, tc_yaw_to: yaw }, 4), (hx, hy, hz)))
                                  match Strata.Render.sync(Strata.Render.new(16384), st) do
                                    (sl, st2) -> frame_loop(st2, Strata.Render.figures(sl, a1, [rig]), a1, tac1, g0, 0, frames, Strata.Ffi.Vk.time(), NativeArray.make_f32(16, 0.0))
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
      Strata.Ffi.Vk.close()
    end
  end
end
