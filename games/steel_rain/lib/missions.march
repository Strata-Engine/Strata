-- SteelRain.Missions — what each mission asks of the map, and its pieces.
--
-- Destroy: the player's mechs start on the north edge; a battery of three
-- gun emplacements stands on single tiles in the south, on high ground where
-- there is any; a supply depot stands on a patch of four tiles further south.
-- (The fight keeps the mission's state: SteelRain.Fight.)
mod SteelRain.Missions do

  pfn rule(name : String, kind : Int, tiles : Int, edge : Int, far : List((String, Int)), high : Bool, count : Int) : StrataMaps.Sites.SiteRule do
    { sr_name: name, sr_kind: kind, sr_tiles: tiles, sr_edge: edge, sr_far_from: far, sr_high: high, sr_in_settlement: false, sr_open_sky: false, sr_count: count }
  end

  doc "The Destroy mission's sites: \"spawn north\" (4 tiles on the north edge), \"spawn south\" (4 on the south edge), \"battery\" (three single tiles, high, at least 10 from the north spawn), \"supply\" (a patch of 4 tiles at least 12 from the north spawn)."
  fn destroy_rules() : List(StrataMaps.Sites.SiteRule) do
    [rule("spawn north", 0, 4, 3, Nil, false, 1), rule("spawn south", 0, 4, 2, Nil, false, 1),
     rule("battery", 1, 1, -1, [("spawn north", 10)], true, 3), rule("supply", 0, 4, -1, [("spawn north", 12)], false, 1)]
  end

  doc "The depot's cells standing on the floor at (x, y, z) (its low corner): a concrete shed 12 x 12 voxels, walls 6 high with a doorway on the north side, and a roof."
  fn depot_cells(x : Int, y : Int, z : Int) : List((Int, Int, Int)) do
    let walls = List.filter_map(List.range(0, 12 * 12 * 6), fn i -> wall_cell(x, y, z, i % 12, i / 144, (i / 12) % 12))
    let roof = List.map(List.range(0, 144), fn i -> (x + i % 12, y + 6, z + i / 12))
    List.append(walls, roof)
  end
  pfn wall_cell(x : Int, y : Int, z : Int, i : Int, h : Int, k : Int) : Option((Int, Int, Int)) do
    let edge = i == 0 || i == 11 || k == 0 || k == 11
    let door = k == 0 && i >= 4 && i <= 7 && h < 4
    if edge && !door do Some((x + i, y + h, z + k)) else None end
  end
end
