-- Mech — the Warden, Steel Rain's first walker, sculpted in code.
--
-- An original heavy walker in the spirit of the genre: a broad torso with a
-- sloped glacis and a tinted canopy, armoured side torsos with panel seams,
-- hazard stripes, a searchlight and glowing heat vents on the back; arms of
-- a big pauldron, a hydraulic upper arm and a forearm autocannon held level
-- (the elbow bent at rest); a missile rack on the left shoulder and a sensor
-- dish on the right; legs of armoured thighs and shins with chrome pistons,
-- knee caps, and three-toed feet with heel spurs. 0.08 m a voxel. Grids are
-- x across (+x the mech's left), y up, z forward.
--
-- Palette: 1 hull, 2 hull shade (panels), 3 frame, 4 gun metal, 5 canopy,
-- 6 hazard yellow, 7 hazard black, 8 trim (the team colour), 9 vent glow,
-- 10 piston chrome, 11 sole, 12 lamp, 13 tube bore, 14 missile tip.
mod SteelRain.Mech do

  alias SteelRain.Sculpt as MeS
  alias StrataKit.Part as MeP
  alias StrataKit.Build as MeB
  alias StrataKit.Assemble as MeA

  doc "Metres a voxel."
  fn voxel() : Float do 0.08 end

  pfn fwd() : (Float, Float, Float) do (0.0, 0.0, 1.0) end
  pfn upv() : (Float, Float, Float) do (0.0, 1.0, 0.0) end
  pfn mk(name : String, piece : String, x : Float, y : Float, z : Float) : StrataKit.Part.KitMarker do MeP.marker(name, piece, x, y, z, fwd(), upv()) end
  pfn mt(slot : String, size : String, name : String, x : Float, y : Float, z : Float) : StrataKit.Part.KitMount do MeP.mount_of(slot, size, name, mk(name, "part", x, y, z)) end
  pfn sz3(s : SteelRain.Sculpt.Sculpt) : (Int, Int, Int) do MeS.size(s) end

  -- hazard stripes: yellow and black diagonals
  pfn hazard(s : SteelRain.Sculpt.Sculpt, face : Int, x0 : Int, y0 : Int, z0 : Int, x1 : Int, y1 : Int, z1 : Int) : SteelRain.Sculpt.Sculpt do
    let s1 = MeS.surface(s, face, fn (x, y, z) -> x >= x0 && x <= x1 && y >= y0 && y <= y1 && z >= z0 && z <= z1 && (x + y + z) % 4 < 2, 6)
    MeS.surface(s1, face, fn (x, y, z) -> x >= x0 && x <= x1 && y >= y0 && y <= y1 && z >= z0 && z <= z1 && (x + y + z) % 4 >= 2, 7)
  end

  -- ── The torso ────────────────────────────────────────────────────────────
  pfn torso_grid() : SteelRain.Sculpt.Sculpt do
    -- the centre torso, its glacis sloping back above y 12
    let s0 = MeS.box(MeS.canvas(30, 26, 24), 8, 0, 3, 21, 21, 21, 1)
    let s1 = MeS.carve(s0, fn (x, y, z) -> 2 * z + y > 54)
    -- the canopy: a frame, the glass inside it
    let s2 = MeS.surface(MeS.surface(s1, 4, MeS.in_box(11, 14, 0, 18, 20, 23), 3), 2, MeS.in_box(11, 14, 12, 18, 21, 23), 3)
    let s3 = MeS.surface(MeS.surface(s2, 4, MeS.in_box(12, 15, 0, 17, 19, 23), 5), 2, MeS.in_box(12, 15, 13, 17, 20, 23), 5)
    -- side torsos, chamfered on the outer top and front edges
    let s4 = MeS.box(MeS.box(s3, 1, 3, 4, 8, 19, 20, 1), 21, 3, 4, 28, 19, 20, 1)
    let s5 = MeS.carve(s4, fn (x, y, z) -> (x <= 8 && y - x > 14) || (x >= 21 && y + x > 43) || (x + 20 - z < 3) || (28 - x + 20 - z < 3))
    -- the collar behind the canopy; seams between centre and sides; panel lines
    let s6 = MeS.fill(s5, fn (x, y, z) -> x >= 9 && x <= 20 && y >= 20 && y <= 21 && z >= 3 && z <= 9, 2)
    let s7 = MeS.carve(s6, fn (x, y, z) -> (x == 8 || x == 21) && z >= 20 && y <= 18)
    let s8 = MeS.surface(MeS.surface(s7, 4, fn (x, y, z) -> y == 9 && (x <= 7 || x >= 22), 2), 4, fn (x, y, z) -> y == 6 && x >= 9 && x <= 20, 2)
    let s9 = MeS.surface(s8, 0, fn (x, y, z) -> y == 11 || z == 12, 2)
    let s10 = MeS.surface(s9, 1, fn (x, y, z) -> y == 11 || z == 12, 2)
    -- trim: a band across the centre front, a stripe along each side torso's top
    let s11 = MeS.surface(s10, 4, fn (x, y, z) -> (y == 9 || y == 10) && x >= 9 && x <= 20, 8)
    let s12 = MeS.surface(s11, 2, fn (x, y, z) -> (x == 3 || x == 4 || x == 25 || x == 26) && z >= 6, 8)
    -- hazard stripes along the side torsos' lower front
    let s13 = hazard(hazard(s12, 4, 1, 3, 0, 7, 5, 23), 4, 22, 3, 0, 28, 5, 23)
    -- a searchlight on the right side torso (low x)
    let s14 = MeS.box(MeS.box(s13, 3, 13, 21, 6, 16, 21, 3), 4, 14, 21, 5, 15, 21, 12)
    -- heat vents on the back of the side torsos: slats over a glow
    let vent = fn (x, y, z) -> (x >= 2 && x <= 6 || x >= 23 && x <= 27) && y >= 7 && y <= 15
    let s15 = MeS.carve(s14, fn (x, y, z) -> vent(x, y, z) && z == 4 && y % 2 == 0)
    let s16 = MeS.fill(s15, fn (x, y, z) -> vent(x, y, z) && z == 5 && y % 2 == 0, 9)
    let s17 = MeS.paint(s16, fn (x, y, z) -> vent(x, y, z) && z == 4, 3)
    -- the underside in frame colour; an antenna on the left shoulder's back
    let s18 = MeS.surface(s17, 3, fn (x, y, z) -> true, 3)
    let s19 = MeS.box(s18, 24, 18, 6, 24, 24, 6, 4)
    MeS.set(s19, 24, 25, 6, 14)
  end
  pfn torso() : StrataKit.Part.KitPart do
    let s = torso_grid()
    match sz3(s) do
      (sx, sy, sz) ->
        MeP.from_grid(sx, sy, sz, MeS.grid(s), mk("attach", "part", 15.0, 0.0, 12.0),
          [mt("arm", "M", "arm_l", 29.0, 15.0, 12.0), mt("arm", "M", "arm_r", 1.0, 15.0, 12.0),
           mt("shoulder", "L", "shoulder_l", 25.0, 19.0, 11.0), mt("shoulder", "L", "shoulder_r", 4.0, 19.0, 11.0),
           mt("hip", "M", "hip", 15.0, 0.0, 12.0)],
          Nil, ["core"], "M", "", [("weight", 40.0)])
    end
  end

  -- ── The arm (drawn for the right, mirrored on the left) ──────────────────
  pfn pauldron() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.box(MeS.canvas(9, 10, 12), 1, 0, 1, 8, 9, 10, 1)
    let s1 = MeS.carve(s0, fn (x, y, z) -> y - x > 6 || ((z == 1 || z == 10) && (y >= 8 || y <= 1)) || ((z == 1 || z == 10) && x == 1))
    let s2 = MeS.surface(MeS.surface(s1, 1, fn (x, y, z) -> y == 5, 2), 2, fn (x, y, z) -> x == 4 || x == 5, 8)
    hazard(s2, 1, 0, 1, 0, 9, 2, 12)
  end
  pfn upper_arm() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.cyl_y(MeS.canvas(6, 12, 6), 3.0, 3.0, 2.3, 2, 11, 3)
    let s1 = MeS.box(s0, 1, 8, 1, 4, 11, 4, 2)
    let s2 = MeS.box(s1, 2, 2, 0, 3, 9, 0, 10)
    MeS.cyl_x(s2, 1.5, 3.0, 1.6, 0, 5, 3)
  end
  pfn forearm() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.cyl_x(MeS.canvas(8, 8, 22), 5.5, 2.5, 2.5, 1, 6, 3)
    let s1 = MeS.box(s0, 1, 3, 2, 6, 7, 11, 1)
    let s2 = MeS.carve(s1, fn (x, y, z) -> y - x > 5 || (z == 11 && y == 7))
    let s3 = MeS.box(s2, 2, 0, 6, 6, 3, 15, 4)
    let s4 = MeS.cyl_z(MeS.cyl_z(s3, 3.0, 1.5, 1.0, 16, 20, 4), 5.5, 1.5, 1.0, 16, 20, 4)
    let s5 = MeS.box(s4, 1, 0, 19, 7, 3, 20, 3)
    let s6 = MeS.carve(MeS.carve(s5, MeS.in_box(2, 1, 19, 3, 1, 21)), MeS.in_box(5, 1, 19, 6, 1, 21))
    let s7 = MeS.surface(MeS.surface(s6, 0, fn (x, y, z) -> z >= 8 && z <= 13 && z % 2 == 0, 2), 1, fn (x, y, z) -> z >= 8 && z <= 13 && z % 2 == 0, 2)
    MeS.surface(s7, 2, fn (x, y, z) -> z == 4 || z == 5, 8)
  end
  pfn arm() : StrataKit.Part.KitPart do
    let p = pauldron()
    let u = upper_arm()
    let f = forearm()
    match (sz3(p), sz3(u), sz3(f)) do
      ((px, py, pz), (ux, uy, uz), (fx, fy, fz)) ->
        let a0 = MeP.from_grid(px, py, pz, MeS.grid(p), mk("attach", "part", 9.0, 6.0, 5.5), Nil, [mk("muzzle", "fore", 4.0, 1.5, 21.0)], ["arm"], "M", "r", [("weight", 14.0)])
        let a1 = MeP.with_piece(a0, "upper", "part", ux, uy, uz, MeS.grid(u), (4.5, 1.0, 5.5), (3.0, 12.0, 3.0))
        MeP.with_piece(a1, "fore", "upper", fx, fy, fz, MeS.grid(f), (3.0, 1.5, 3.0), (3.5, 5.5, 2.5))
    end
  end

  -- ── The shoulders ────────────────────────────────────────────────────────
  pfn rack_grid() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.box(MeS.box(MeS.canvas(9, 8, 11), 0, 1, 0, 8, 7, 10, 1), 3, 0, 3, 5, 0, 7, 3)
    let s1 = MeS.carve(s0, fn (x, y, z) -> (7 - y) + z < 2)
    let s2 = MeS.surface(s1, 4, fn (x, y, z) -> true, 3)
    let tube = fn (x, y, z) -> x % 2 == 1 && x <= 7 && y % 2 == 0 && y >= 2 && y <= 6
    let s3 = MeS.fill(MeS.carve(s2, fn (x, y, z) -> tube(x, y, z) && z == 10), fn (x, y, z) -> tube(x, y, z) && z == 9, 14)
    let s4 = MeS.surface(MeS.surface(s3, 2, fn (x, y, z) -> z == 5, 2), 0, fn (x, y, z) -> y == 5, 8)
    MeS.surface(s4, 1, fn (x, y, z) -> y == 5, 8)
  end
  pfn rack() : StrataKit.Part.KitPart do
    let s = rack_grid()
    match sz3(s) do (sx, sy, sz) -> MeP.from_grid(sx, sy, sz, MeS.grid(s), mk("attach", "part", 4.5, 0.0, 5.5), Nil, [mk("missiles", "part", 4.5, 4.0, 10.0)], ["shoulder"], "L", "", [("weight", 9.0)]) end
  end
  pfn sensor_grid() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.box(MeS.box(MeS.canvas(7, 8, 7), 3, 0, 3, 3, 2, 3, 3), 2, 3, 1, 4, 5, 3, 1)
    let s1 = MeS.cyl_z(s0, 3.5, 4.5, 3.2, 4, 4, 10)
    let s2 = MeS.paint(s1, fn (x, y, z) -> z == 4 && (x - 3) * (x - 3) + (y - 4) * (y - 4) <= 3, 4)
    MeS.set(MeS.box(s2, 3, 4, 5, 3, 4, 6, 4), 3, 7, 4, 14)
  end
  pfn sensor() : StrataKit.Part.KitPart do
    let s = sensor_grid()
    match sz3(s) do (sx, sy, sz) -> MeP.from_grid(sx, sy, sz, MeS.grid(s), mk("attach", "part", 3.5, 0.0, 3.5), Nil, Nil, ["shoulder"], "L", "", [("weight", 3.0)]) end
  end

  -- ── The legs ─────────────────────────────────────────────────────────────
  pfn pelvis() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.box(MeS.canvas(20, 5, 12), 3, 0, 2, 16, 4, 9, 3)
    let s1 = MeS.box(s0, 5, 1, 9, 14, 4, 10, 1)
    let s2 = MeS.surface(s1, 4, fn (x, y, z) -> y == 3, 8)
    MeS.cyl_x(s2, 2.5, 6.0, 2.5, 0, 19, 2)
  end
  pfn thigh() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.box(MeS.canvas(8, 15, 9), 2, 0, 2, 5, 14, 6, 3)
    let s1 = MeS.box(MeS.box(s0, 0, 3, 4, 7, 14, 8, 1), 0, 5, 2, 7, 12, 4, 2)
    let s2 = MeS.carve(s1, fn (x, y, z) -> (z - 6) + (5 - y) > 2)
    let s3 = MeS.cyl_x(s2, 13.0, 4.5, 2.5, 1, 6, 2)
    let s4 = MeS.box(MeS.box(MeS.box(s3, 3, 2, 0, 4, 11, 1, 10), 2, 2, 0, 5, 2, 1, 3), 2, 11, 0, 5, 11, 1, 3)
    MeS.surface(s4, 4, fn (x, y, z) -> y == 9, 2)
  end
  pfn shin() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.box(MeS.canvas(8, 17, 10), 2, 0, 2, 5, 16, 6, 3)
    let s1 = MeS.box(MeS.box(s0, 0, 2, 5, 7, 14, 9, 1), 0, 4, 2, 7, 11, 4, 2)
    let s2 = MeS.carve(s1, fn (x, y, z) -> (z == 9 && y < 6) || (z >= 8 && y < 3))
    let s3 = MeS.box(s2, 0, 13, 6, 7, 16, 9, 1)
    let s4 = MeS.cyl_x(s3, 15.5, 4.5, 2.2, 1, 6, 2)
    let s5 = MeS.surface(s4, 4, fn (x, y, z) -> y >= 15, 8)
    let s6 = MeS.box(MeS.box(s5, 3, 3, 0, 4, 13, 1, 10), 2, 13, 0, 5, 13, 1, 3)
    let s7 = MeS.cyl_x(s6, 1.5, 4.0, 1.8, 2, 5, 2)
    hazard(MeS.surface(s7, 4, fn (x, y, z) -> y == 7, 2), 4, 0, 10, 0, 8, 11, 10)
  end
  pfn foot() : SteelRain.Sculpt.Sculpt do
    let s0 = MeS.box(MeS.canvas(10, 4, 15), 3, 1, 4, 6, 3, 8, 3)
    let toe = fn (x, y, z) -> (x <= 2 || (x >= 4 && x <= 5) || x >= 7) && y <= 2 && z >= 8 && z <= 14
    let s1 = MeS.carve(MeS.fill(s0, toe, 1), fn (x, y, z) -> y == 2 && z >= 12)
    let s2 = MeS.paint(s1, fn (x, y, z) -> z >= 13, 4)
    let s3 = MeS.carve(MeS.box(s2, 3, 0, 0, 6, 2, 3, 1), fn (x, y, z) -> y == 2 && z == 0)
    MeS.box(MeS.surface(s3, 3, fn (x, y, z) -> true, 11), 2, 0, 4, 7, 1, 8, 3)
  end
  pfn leg(p : StrataKit.Part.KitPart, s : String, x : Float) : StrataKit.Part.KitPart do
    let t = thigh()
    let h = shin()
    let f = foot()
    match (sz3(t), sz3(h), sz3(f)) do
      ((tx, ty, tz), (hx, hy, hz), (fx, fy, fz)) ->
        let p1 = MeP.with_piece(p, "thigh_" ++ s, "part", tx, ty, tz, MeS.grid(t), (x, 2.5, 6.0), (4.0, 13.0, 4.5))
        let p2 = MeP.with_piece(p1, "shin_" ++ s, "thigh_" ++ s, hx, hy, hz, MeS.grid(h), (4.0, 1.5, 4.5), (4.0, 15.5, 4.5))
        MeP.with_piece(p2, "foot_" ++ s, "shin_" ++ s, fx, fy, fz, MeS.grid(f), (4.0, 1.5, 4.0), (5.0, 3.5, 6.0))
    end
  end
  pfn legs() : StrataKit.Part.KitPart do
    let p = pelvis()
    match sz3(p) do
      (px, py, pz) -> leg(leg(MeP.from_grid(px, py, pz, MeS.grid(p), mk("attach", "part", 10.0, 5.0, 6.0), Nil, Nil, ["hip"], "M", "", [("weight", 30.0)]), "l", 17.0), "r", 3.0)
    end
  end

  -- ── The build ────────────────────────────────────────────────────────────
  doc "The parts: 0 torso, 1 arm, 2 missile rack, 3 sensor, 4 legs."
  fn parts() : List(StrataKit.Part.KitPart) do [torso(), arm(), rack(), sensor(), legs()] end
  pfn rank(s : String) : Int do if s == "L" do 0 else if s == "M" do 1 else 2 end end end
  doc "The fitting rule: the slot named, the part no bigger than the mount."
  fn fits(slot : String, size : String, slots : List(String), psize : String) : Bool do List.any(slots, fn s -> s == slot) && rank(psize) <= rank(size) end
  doc "The Warden's build."
  fn build() : StrataKit.Build.KitBuild do
    MeB.node(0, [("arm_l", MeB.leaf(1)), ("arm_r", MeB.leaf(1)), ("shoulder_l", MeB.leaf(2)), ("shoulder_r", MeB.leaf(3)), ("hip", MeB.leaf(4))])
  end
  doc "The palette: (index, red, green, blue, roughness, emission)."
  fn palette() : List((Int, Float, Float, Float, Float, Float)) do
    [(1, 0.5, 0.45, 0.3, 0.65, 0.0), (2, 0.32, 0.29, 0.2, 0.7, 0.0), (3, 0.13, 0.13, 0.14, 0.55, 0.0), (4, 0.07, 0.07, 0.08, 0.35, 0.0),
     (5, 0.03, 0.08, 0.1, 0.08, 0.12), (6, 0.9, 0.68, 0.08, 0.6, 0.0), (7, 0.05, 0.05, 0.05, 0.7, 0.0), (8, 0.8, 0.35, 0.08, 0.5, 0.0),
     (9, 1.0, 0.42, 0.08, 0.5, 0.9), (10, 0.66, 0.68, 0.7, 0.2, 0.0), (11, 0.06, 0.06, 0.06, 0.95, 0.0), (12, 0.95, 0.97, 1.0, 0.3, 1.0),
     (13, 0.02, 0.02, 0.02, 0.9, 0.0), (14, 0.65, 0.1, 0.06, 0.5, 0.2)]
  end
  doc "The assembly settings (the trim, index 8, in the team colour)."
  fn settings() : StrataKit.Assemble.AssembleSettings do MeA.settings(voxel(), palette(), [(8, (0.8, 0.35, 0.08))]) end
  doc "The Warden assembled: rig, map, what was left out."
  fn assemble() : (Strata.Rig.Rig, StrataKit.Assemble.KitMap, List((List(String), String))) do MeA.assemble(parts(), build(), fits, settings()) end

  -- the legs straight, root to sole, voxels: pelvis to the hip drums, hip to knee, knee to ankle, ankle to sole
  pfn leg_voxels() : Float do 2.5 +. 11.5 +. 14.0 +. 3.5 end
  doc "How high the root stands over the floor, metres: the legs at 92% of straight (knees a little bent)."
  fn stand() : Float do 0.92 *. leg_voxels() *. voxel() end
  doc "Its height standing, metres: to the top of the missile rack."
  fn height() : Float do stand() +. (19.0 +. 8.0) *. voxel() end
end
