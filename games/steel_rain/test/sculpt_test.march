-- Sculpting voxel grids for parts.
mod SteelRain.Test.Sculpt do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Sculpt as SrS

  pfn count(s : SteelRain.Sculpt.Sculpt, c : Int) : Int do
    match SrS.size(s) do (sx, sy, sz) -> List.length(List.filter(List.range(0, sx * sy * sz), fn i -> NativeArray.get_u8(SrS.grid(s), i) == c)) end
  end

  describe "Sculpt" do
    test "a box fills its corners inclusive, in x + sx * (y + sy * z) order" do
      let s = SrS.box(SrS.canvas(4, 3, 2), 1, 0, 0, 2, 1, 1, 5)
      Test.assert_true(count(s, 5) == 8 && SrS.get(s, 1, 0, 0) == 5 && SrS.get(s, 2, 1, 1) == 5 && SrS.get(s, 3, 0, 0) == 0, "eight voxels")
      Test.assert_true(NativeArray.get_u8(SrS.grid(s), 2 + 4 * (1 + 3 * 1)) == 5, "index order")
    end
    test "a box past the edges is clipped" do
      Test.assert_true(count(SrS.box(SrS.canvas(3, 3, 3), -5, -5, -5, 10, 0, 0, 1), 1) == 3, "one row")
    end
    test "a cylinder along z covers a disc in each slice" do
      let s = SrS.cyl_z(SrS.canvas(9, 9, 4), 4.5, 4.5, 2.5, 0, 3, 2)
      Test.assert_true(SrS.get(s, 4, 4, 0) == 2 && SrS.get(s, 6, 4, 3) == 2 && SrS.get(s, 0, 0, 1) == 0 && count(s, 2) == 4 * count(SrS.cyl_z(SrS.canvas(9, 9, 1), 4.5, 4.5, 2.5, 0, 0, 2), 2), "discs")
    end
    test "paint recolours only filled voxels" do
      let s = SrS.paint(SrS.box(SrS.canvas(4, 1, 1), 0, 0, 0, 1, 0, 0, 1), fn (x, y, z) -> true, 7)
      Test.assert_true(count(s, 7) == 2 && count(s, 0) == 2, "two painted, two empty")
    end
    test "carve empties what the shape covers" do
      let s = SrS.carve(SrS.box(SrS.canvas(4, 4, 1), 0, 0, 0, 3, 3, 0, 1), fn (x, y, z) -> x + y > 4)
      Test.assert_true(SrS.get(s, 3, 3, 0) == 0 && SrS.get(s, 3, 1, 0) == 1 && count(s, 1) == 13, "the corner cut")
    end
    test "surface paints only voxels with an empty neighbour on the given face" do
      -- +z face: the front layer of a solid block
      let s = SrS.surface(SrS.box(SrS.canvas(3, 3, 3), 0, 0, 0, 2, 2, 2, 1), 4, fn (x, y, z) -> true, 9)
      Test.assert_true(count(s, 9) == 9 && SrS.get(s, 1, 1, 2) == 9 && SrS.get(s, 1, 1, 1) == 1, "front layer only")
    end
    test "a canvas reads 0 outside and ignores sets outside" do
      let s = SrS.set(SrS.canvas(2, 2, 2), 5, 0, 0, 3)
      Test.assert_true(SrS.get(s, -1, 0, 0) == 0 && SrS.get(s, 5, 0, 0) == 0 && count(s, 0) == 8, "outside")
    end
  end
end
