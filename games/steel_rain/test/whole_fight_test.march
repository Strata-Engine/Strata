-- A whole Destroy fight, headless, played by the scripted player to its end.
mod SteelRain.Test.WholeFight do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Script as SrSc

  describe "A whole fight" do
    test "a scripted Destroy fight plays to a result with no illegal order" do
      match SrSc.play(SteelRain.Test.Fights.destroy_small(), 600) do
        (f, orders, refused) ->
          Test.assert_true(Option.is_some(f.fg_result), "a result after " ++ int_to_string(orders) ++ " orders")
          Test.assert_eq_int(refused, 0, "no order refused")
      end
    end
  end
end
