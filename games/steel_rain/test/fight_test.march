-- Fight: the state, setup on the spawns, turns and orders.
mod SteelRain.Test.Fight do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Fight as SrF
  alias SteelRain.Test.Fights as SrFt

  pfn is_turn(e : SteelRain.Fight.Event) : Bool do match e do ETurn(_) -> true | _ -> false end end

  describe "Fight" do
    test "a new fight has every mech on its spawn and a unit to act" do
      let f = SrFt.small()
      Test.assert_eq_int(List.length(f.fg_mechs), 4, "four mechs")
      Test.assert_true(Option.is_some(SrF.active(f)), "someone acts")
      Test.assert_true(List.all(f.fg_mechs, fn m -> match m.mc_tile do (_, z) -> if m.mc_side == 0 do z == 0 else z == 15 end end), "on their spawns")
    end
    test "ending a turn passes it on and sheds heat" do
      let f = SrFt.with_heat(SrFt.small(), 20)
      let me = SrFt.first_active(f)
      match SrF.step(f, OEnd(0.0)) do
        Ok((f2, evs)) -> Test.assert_true(SrFt.heat_of(f2, me) < 20 && List.any(evs, is_turn), "shed, next turn")
        Err(e) -> Test.fail(e)
      end
    end
    test "an order the fight cannot take is refused and changes nothing" do
      let f = SrFt.small()
      match SrF.step(f, OBrace) do
        Ok((f2, _)) -> Test.assert_true(Result.is_err(SrF.step(f2, OBrace)), "a second act is refused")
        Err(e) -> Test.fail(e)
      end
    end
    test "the same orders from the same fight give the same fight" do
      let f = SrFt.small()
      let os = [OBrace, OEnd(0.0), OEnd(1.0), OEnd(2.0)]
      Test.assert_true(SrFt.summary(SrFt.run_orders(f, os)) == SrFt.summary(SrFt.run_orders(f, os)), "deterministic")
    end
    test "every mech gets a turn before any has a third" do
      let f = SrFt.run_orders(SrFt.small(), List.map(List.range(0, 8), fn _ -> OEnd(0.0)))
      Test.assert_true(Option.is_some(SrF.active(f)), "still running")
    end
  end
end
