-- The Warden: Steel Rain's first walker, assembled from its parts.
mod SteelRain.Test.Mech do

  needs IO.Clock
  needs IO.Console
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Mech as SrMe

  describe "Mech" do
    test "the Warden assembles with nothing left out" do
      match SrMe.assemble() do (_, _, probs) -> Test.assert_true(List.is_empty(probs), "nothing left out") end
    end
    test "it has two legs and a muzzle on each forearm gun" do
      match SrMe.assemble() do
        (rig, m, _) ->
          Test.assert_true(List.length(Strata.Rig.legs(rig)) == 2, "two legs")
          Test.assert_true(List.length(StrataKit.Assemble.markers(m, "muzzle")) == 2, "two muzzles")
      end
    end
    test "it stands between 4 and 5.5 m tall on bent knees" do
      -- the root stands at stand(); the torso and the rack rise above it
      Test.assert_true(SrMe.stand() > 2.0 && SrMe.stand() < 3.2 && SrMe.height() > 4.0 && SrMe.height() < 5.5, "tall enough to read as a heavy walker, short enough for a 3.2 m tile")
    end
  end
end
