-- Moving, watches, bracing and withdrawing.
mod SteelRain.Test.Move do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Fight as SrMv
  alias SteelRain.Test.Fights as SrMvf

  pfn watch_shots(r : Result((SteelRain.Fight.Fight, List(SteelRain.Fight.Event)), String)) : Int do
    match r do
      Ok((_, evs)) -> List.length(List.filter(evs, fn e -> match e do EWatchFired(_, _) -> true | _ -> false end))
      Err(_) -> -1
    end
  end

  describe "Moving" do
    test "a mech moves along a reachable path and gets warm" do
      match SrMv.step(SrMvf.facing_pair(), OMove(SrMvf.path6())) do
        Ok((f2, _)) -> Test.assert_true(SrMvf.tile_of(f2, 1) == (5, 9) && SrMvf.heat_of(f2, 1) > 0, "there, warm")
        Err(e) -> Test.fail(e)
      end
    end
    test "a path it cannot walk, or a second move, is refused" do
      Test.assert_true(Result.is_err(SrMv.step(SrMvf.facing_pair(), OMove([(5, 4), (5, 12)]))), "no jumping")
      match SrMv.step(SrMvf.facing_pair(), OMove([(5, 4), (5, 5)])) do
        Ok((f2, _)) -> Test.assert_true(Result.is_err(SrMv.step(f2, OMove([(5, 5), (5, 6)]))), "moved already")
        Err(e) -> Test.fail(e)
      end
    end
    test "walking into a watched lane draws fire once; two watches are a crossfire" do
      Test.assert_eq_int(watch_shots(SrMv.step(SrMvf.lane_watched(), OMove(SrMvf.path6()))), 1, "one watch fires once")
      Test.assert_eq_int(watch_shots(SrMv.step(SrMvf.lane_watched_twice(), OMove(SrMvf.path6()))), 2, "both fire")
    end
    test "a mover knocked out or crippled by watch fire stops where it was hit" do
      match SrMv.step(SrMvf.lane_lethal(), OMove(SrMvf.path6())) do
        Ok((f2, _)) -> Test.assert_true(SrMvf.tile_of(f2, 1) == (5, 7) && (SrMvf.state_of(f2, 1) == 2 || SrMvf.legless(f2, 1)), "stopped on (5, 7)")
        Err(e) -> Test.fail(e)
      end
    end
    test "holding a watch sets an arc and is an act" do
      match SrMv.step(SrMvf.facing_pair(), OWatch(SrMvf.arm_path(), 1.5708)) do
        Ok((f2, _)) -> Test.assert_true(List.length(f2.fg_watches) == 1 && Result.is_err(SrMv.step(f2, OBrace)), "an arc, and acted")
        Err(e) -> Test.fail(e)
      end
    end
    test "a mech on its own spawn edge withdraws; elsewhere it cannot" do
      match SrMv.step(SrMvf.on_spawn(), OWithdraw) do
        Ok((f2, _)) -> Test.assert_eq_int(SrMvf.state_of(f2, 1), 1, "withdrawn")
        Err(e) -> Test.fail(e)
      end
      Test.assert_true(Result.is_err(SrMv.step(SrMvf.facing_pair(), OWithdraw)), "not from mid-field")
    end
  end
end
