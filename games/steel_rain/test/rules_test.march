-- Rules: Steel Rain's numbers and the formulas over a build.
mod SteelRain.Test.Rules do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Rules as SrR

  describe "Rules" do
    test "the Warden's speed comes from its torso and legs" do
      Test.assert_true(SrR.speed(SteelRain.Mech.parts(), SteelRain.Mech.build()) >= 1, "at least 1")
    end
    test "a heavier build is no faster" do
      Test.assert_true(SrR.speed(SteelRain.Mech.parts(), SteelRain.Mech.build()) <= SrR.speed(SteelRain.Mech.parts(), SteelRain.Mech.striker()), "the lighter striker is at least as fast")
    end
    test "shots from behind hit harder than from the side, and the side harder than the front" do
      let n = SrR.numbers()
      -- the target faces +z; the shooter in front is at +z
      let front = SrR.facing_factor(n, (0.0, 5.0), (0.0, 0.0), 1.5708)
      let side = SrR.facing_factor(n, (5.0, 0.0), (0.0, 0.0), 1.5708)
      let rear = SrR.facing_factor(n, (0.0, -5.0), (0.0, 0.0), 1.5708)
      Test.assert_true(rear > side && side > front, "rear over side over front")
    end
    test "every weapon the fight uses has numbers" do
      Test.assert_true(Option.is_some(SrR.weapon(1)) && Option.is_some(SrR.weapon(2)) && Option.is_some(SrR.weapon(3)) && Option.is_none(SrR.weapon(9)), "1, 2, 3, not 9")
    end
    test "the Warden sheds heat and has a mover from its legs" do
      let m = SrR.mover(SteelRain.Mech.parts(), SteelRain.Mech.build())
      Test.assert_true(SrR.shed(SteelRain.Mech.parts(), SteelRain.Mech.build()) > 0 && m.mv_move > 0 && m.mv_height > 0, "sheds, moves")
    end
  end
end
