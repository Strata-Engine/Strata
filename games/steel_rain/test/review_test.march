-- The final review's findings, each pinned by a test.
mod SteelRain.Test.Review do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Fight as SrRv
  alias SteelRain.Test.Fights as SrRvf

  pfn first_line_start(is : List(Strata.Overlay.Item)) : (Float, Float, Float) do
    match List.find(is, fn i -> Strata.Overlay.kind_index(i) == 1) do Some(OvLine(a, _, _, _, _)) -> a | _ -> (-99.0, -99.0, -99.0) end
  end
  pfn fell(evs : List(SteelRain.Fight.Event), id : Int) : Int do
    List.fold_left(evs, 0, fn (n, e) -> match e do EMechFell(u, _, h) -> if u == id && h > n do h else n end | _ -> n end)
  end
  pfn near(a : (Float, Float, Float), b : (Float, Float, Float)) : Bool do
    match (a, b) do ((ax, ay, az), (bx, by, bz)) -> Math.abs(ax -. bx) +. Math.abs(ay -. by) +. Math.abs(az -. bz) < 0.01 end
  end

  describe "Review" do
    test "a move cannot end on an ally's tile" do
      let f = SrRvf.ally_between()
      Test.assert_true(Result.is_err(SrRv.step(f, OMove([(5, 4), (5, 5), (5, 6), (5, 7)]))), "refused")
    end
    test "a unit that is out fires nothing" do
      let f = SrRvf.facing_pair()
      let dead = { f with fg_mechs: List.map(f.fg_mechs, fn m -> if m.mc_id == 2 do { m with mc_state: 2 } else m end) }
      match SrRv.shoot(dead, 2, SrRvf.arm_path(), SrRvf.torso_point_of(f, 1)) do
        (_, evs) -> Test.assert_true(List.is_empty(evs), "no rounds")
      end
    end
    test "a unit taken out leaves no watch weapon behind" do
      let f = SrRvf.fire_until_core_lost(SrRvf.lane_watched())
      Test.assert_true(SrRvf.state_of(f, 2) == 2 && !List.any(f.fg_watch_weapons, fn w -> match w do (o, _) -> o == 2 end), "gone")
    end
    test "the aiming cone starts at the muzzle the shot will fire from" do
      -- mech 1 faces away (-z) and aims at mech 2 (+z): the volley turns it first
      let f0 = SrRvf.facing_pair()
      let f = SteelRain.Fight.update(f0, 1, fn m -> { m with mc_yaw: -1.5708 })
      let aim = SrRvf.torso_point_of(f, 2)
      match SrRv.mech(f, 1) do
        Some(m) -> let yaw = SrRv.volley_yaw(f, m, [(SrRvf.arm_path(), aim)])
          Test.assert_true(near(first_line_start(SteelRain.Screen.cone_items(f, 1, SrRvf.arm_path(), aim)), SteelRain.Hull.muzzle(m.mc_hull, SrRvf.arm_path(), SrRv.pos(f, m), yaw)), "same muzzle")
        None -> Test.fail("no mech")
      end
    end
    test "every weapon a mech carries can be picked" do
      let f = SrRvf.facing_pair()
      match SrRv.mech(f, 1) do
        Some(m) -> Test.assert_eq_int(List.length(SteelRain.Screen.weapons(f, m)), 3, "two autocannons and the rack")
        None -> Test.fail("no mech")
      end
    end
    test "a fall no deeper than the mech's own drop does not hurt its legs" do
      let f = SrRvf.slab_at(6)
      match SrRv.step(f, SrRvf.fire_at_pillar(f)) do
        Ok((f2, evs)) -> Test.assert_true(fell(evs, 2) >= 2 && fell(evs, 2) <= 3 && SrRvf.armour_on(f2, 2, ["hip"]) == SrRvf.armour_on(f, 2, ["hip"]), "fell 2 or 3 steps, legs whole")
        Err(e) -> Test.fail(e)
      end
    end
    test "the scripted player can win a Destroy fight with the default numbers and the game's four Wardens" do
      match SteelRain.Script.play(SrRvf.destroy_with(4), 800) do
        (f, _, refused) -> Test.assert_true(SrRvf.won(f) && refused == 0, "won")
      end
    end
  end
end
