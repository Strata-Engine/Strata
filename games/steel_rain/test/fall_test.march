-- Mechs falling when their ground goes; debris; wrecks.
mod SteelRain.Test.Fall do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Fight as SrFl
  alias SteelRain.Test.Fights as SrFlf

  pfn fell_steps(evs : List(SteelRain.Fight.Event), id : Int) : Int do
    List.fold_left(evs, 0, fn (n, e) -> match e do EMechFell(u, _, h) -> if u == id && h > n do h else n end | _ -> n end)
  end

  describe "Falling" do
    test "cutting the pillar under a mech's slab drops it, its legs hurt" do
      let f = SrFlf.slab_fight(false, false)
      match SrFl.step(f, SrFlf.fire_at_pillar(f)) do
        Ok((f2, evs)) -> Test.assert_true(fell_steps(evs, 2) >= 2 && SrFlf.armour_on(f2, 2, ["hip"]) < SrFlf.armour_on(f, 2, ["hip"]), "fell, legs hurt")
        Err(e) -> Test.fail(e)
      end
    end
    test "a mech whose tile can no longer hold it slides off; onto a held tile, it takes a free one and both are bumped" do
      let f = SrFlf.slab_fight(true, true)
      match SrFl.step(f, SrFlf.fire_at_pillar(f)) do
        Ok((f2, evs)) -> Test.assert_true(fell_steps(evs, 2) >= 1 && SrFlf.tile_of(f2, 2) != (5, 10) && SrFlf.tile_of(f2, 2) != SrFlf.tile_of(f2, 3) && SrFlf.armour_on(f2, 3, Nil) < SrFlf.armour_on(f, 3, Nil), "slid, apart, bumped")
        Err(e) -> Test.fail(e)
      end
    end
    test "a wreck becomes rubble on its tile" do
      let f = SrFlf.fire_until_core_lost(SrFlf.facing_pair())
      Test.assert_true(SrFlf.state_of(f, 2) == 2 && SrFlf.rubble_on_tile(f, (5, 10)) > 0, "rubble")
    end
  end
end
