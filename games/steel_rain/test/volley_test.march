-- Volleys: rounds through terrain and parts, damage, delay and heat.
mod SteelRain.Test.Volley do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Fight as SrV
  alias SteelRain.Test.Fights as SrVf

  pfn is_part_hit(e : SteelRain.Fight.Event) : Bool do match e do EPartHit(_, _, _) -> true | _ -> false end end
  pfn is_carved(e : SteelRain.Fight.Event) : Bool do match e do ECarved(_) -> true | _ -> false end end
  pfn delayed(e : SteelRain.Fight.Event, id : Int) : Bool do match e do EDelayed(u, a) -> u == id && a > 0 | _ -> false end end
  pfn part_hit_on(e : SteelRain.Fight.Event, id : Int) : Bool do match e do EPartHit(u, _, _) -> u == id | _ -> false end end

  describe "Volley" do
    test "a volley at an exposed mech hits a part, delays it and heats the shooter" do
      let f = SrVf.facing_pair()
      match SrV.step(f, OFire([(SrVf.arm_path(), SrVf.torso_point_of(f, 2))])) do
        Ok((f2, evs)) -> Test.assert_true(List.any(evs, is_part_hit) && List.any(evs, fn e -> delayed(e, 2)) && SrVf.heat_of(f2, 1) > 0, "hit, delayed, hot")
        Err(e) -> Test.fail(e)
      end
    end
    test "a wall between them takes the rounds and wears away" do
      let f = SrVf.behind_wall()
      match SrV.step(f, OFire([(SrVf.arm_path(), SrVf.torso_point_of(f, 2))])) do
        Ok((f2, evs)) -> Test.assert_true(List.any(evs, is_carved) && !List.any(evs, is_part_hit) && SrVf.wall_voxels(f2) < SrVf.wall_voxels(f), "the wall, not the mech")
        Err(e) -> Test.fail(e)
      end
    end
    test "an ally in the cone is hit" do
      let f = SrVf.ally_between()
      match SrV.step(f, OFire([(SrVf.arm_path(), SrVf.torso_point_of(f, 2))])) do
        Ok((_, evs)) -> Test.assert_true(List.any(evs, fn e -> part_hit_on(e, 3)), "friendly fire")
        Err(e) -> Test.fail(e)
      end
    end
    test "a volley exactly at the heat cap is allowed; one over is refused" do
      let at = SrVf.with_heat_left(SrVf.facing_pair(), SrVf.volley_heat())
      Test.assert_true(Result.is_ok(SrV.step(at, SrVf.both_weapons(at))), "at the cap")
      Test.assert_true(Result.is_err(SrV.step(SrVf.with_heat_left(SrVf.facing_pair(), SrVf.volley_heat() - 1), SrVf.both_weapons(at))), "over")
    end
    test "a weapon the mech does not carry, or a second act, is refused" do
      let f = SrVf.facing_pair()
      Test.assert_true(Result.is_err(SrV.step(f, OFire([(["hip"], SrVf.torso_point_of(f, 2))]))), "legs are no weapon")
      match SrV.step(f, OBrace) do
        Ok((f2, _)) -> Test.assert_true(Result.is_err(SrV.step(f2, SrVf.both_weapons(f2))), "already acted")
        Err(e) -> Test.fail(e)
      end
    end
    test "shooting off the core takes the mech out" do
      Test.assert_eq_int(SrVf.state_of(SrVf.fire_until_core_lost(SrVf.facing_pair()), 2), 2, "out")
    end
  end
end
