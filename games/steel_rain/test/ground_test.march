-- Ground: carving terrain and dropping what it no longer holds as rubble.
mod SteelRain.Test.Ground do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Ground as SrG
  alias SteelRain.Test.Fights as SrGf

  -- a pillar 6 high on the flat map with a beam off its top, and where it stands
  pfn overhang() : (Strata.World.World, Int, Int, Int) do
    let d = SrGf.flat_map(16)
    match SrGf.tile_voxel(d, (6, 6)) do
      (x, y, z) -> (SrGf.wall(SrGf.wall(SrGf.world_of(d), x, y, z, x, y + 5, z, 1), x, y + 5, z, x + 6, y + 5, z, 1), x, y, z)
    end
  end
  pfn nothing_hangs(w : Strata.World.World, x : Int, y : Int, z : Int) : Bool do
    List.is_empty(Strata.Support.pieces(Strata.Support.loose_box(Strata.World.registry(w), w, x - 10, y - 4, z - 10, x + 10, y + 10, z + 10, y - 5, 0.4)))
  end

  describe "Ground" do
    test "cutting a pillar's foot drops the pillar and its beam as rubble" do
      match overhang() do
        (w0, x, y, z) -> match SrG.carve(w0, x, y + 1, z, 1, 1, 8) do
          (w, cs, fell) -> Test.assert_true(!List.is_empty(cs) && !List.is_empty(fell) && nothing_hangs(w, x, y, z), "fell, nothing left hanging")
        end
      end
    end
    test "what falls lands as rubble on the ground" do
      match overhang() do
        (w0, x, y, z) -> match SrG.carve(w0, x, y + 1, z, 1, 1, 8) do
          (w, _, _) -> Test.assert_true(List.any(List.range(0, 7), fn i -> Strata.World.get_block(w, x + i, y, z) == 8), "rubble on the floor")
        end
      end
    end
  end
end
