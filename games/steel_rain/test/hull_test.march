-- Hull: a mech's parts as boxes, from its rig at rest, for the fight's shots.
mod SteelRain.Test.Hull do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Hull as SrH

  pfn warden_hull() : SteelRain.Hull.Hull do
    match SteelRain.Mech.assemble() do (rig, m, _) -> SrH.of(rig, m, SteelRain.Mech.stand()) end
  end
  pfn box_bottom(p : (List(String), (Float, Float, Float), (Float, Float, Float))) : Float do match p do (_, (_, cy, _), (_, hy, _)) -> cy -. hy end end
  pfn centre_of(h : SteelRain.Hull.Hull, path : List(String)) : (Float, Float, Float) do
    match List.find(h.hl_parts, fn p -> match p do (q, _, _) -> q == path end) do Some((_, c, _)) -> c | None -> (-99.0, -99.0, -99.0) end
  end
  pfn y_of(v : (Float, Float, Float)) : Float do match v do (_, y, _) -> y end end
  pfn index_of(h : SteelRain.Hull.Hull, path : List(String)) : Int do
    match List.find(List.enumerate(h.hl_parts), fn e -> match e do (_, (q, _, _)) -> q == path end) do Some((i, _)) -> i | None -> -1 end
  end
  pfn box_centre(bs : List(StrataTactics.Shot.ShotBox), part : Int) : (Float, Float, Float) do
    match List.find(bs, fn b -> b.bx_part == part) do Some(b) -> b.bx_centre | None -> (-99.0, -99.0, -99.0) end
  end
  pfn near(a : Float, b : Float) : Bool do Math.abs(a -. b) < 0.01 end

  describe "Hull" do
    test "the Warden's hull has a box for every build node, all above its floor" do
      let h = warden_hull()
      Test.assert_eq_int(List.length(h.hl_parts), StrataKit.Build.count(SteelRain.Mech.build()), "one per node")
      Test.assert_true(List.all(h.hl_parts, fn p -> box_bottom(p) >= -0.05), "nothing below the floor")
      Test.assert_true(Math.abs(h.hl_height -. SteelRain.Mech.height()) < 0.3, "as tall as the Warden")
    end
    test "the legs' box is lower than the torso's" do
      Test.assert_true(y_of(centre_of(warden_hull(), ["hip"])) < y_of(centre_of(warden_hull(), Nil)), "legs below")
    end
    test "turning the mech a quarter turns its boxes" do
      let h = warden_hull()
      let paths = List.map(h.hl_parts, fn p -> match p do (q, _, _) -> q end)
      let i = index_of(h, ["arm_l"])
      match (box_centre(SrH.boxes(h, 1, (0.0, 0.0, 0.0), 0.0, paths), i), box_centre(SrH.boxes(h, 1, (0.0, 0.0, 0.0), 1.5708, paths), i)) do
        ((x0, y0, z0), (x1, y1, z1)) -> Test.assert_true(near(x1, 0.0 -. z0) && near(z1, x0) && near(y1, y0) && (Math.abs(z0) > 0.1 || Math.abs(x0) > 0.1), "a quarter turn: (x, z) to (-z, x)")
      end
    end
    test "boxes leave out the nodes no longer on the mech" do
      let h = warden_hull()
      Test.assert_eq_int(List.length(SrH.boxes(h, 1, (0.0, 0.0, 0.0), 0.0, [Nil, ["hip"]])), 2, "two left")
    end
    test "the arm's muzzle is ahead of the torso's centre" do
      let h = warden_hull()
      match (SrH.muzzle(h, ["arm_r"], (0.0, 0.0, 0.0), 0.0), centre_of(h, Nil)) do
        ((mx, _, _), (tx, _, _)) -> Test.assert_true(mx > tx, "forward is +x")
      end
    end
  end
end
