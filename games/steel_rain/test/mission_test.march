-- The Destroy mission: emplacements, the depot, winning and losing.
mod SteelRain.Test.Mission do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Test.Fights as SrMsf

  describe "Destroy" do
    test "a Destroy fight has the battery and the depot on their sites" do
      let f = SrMsf.destroy_small()
      Test.assert_eq_int(SrMsf.count_kind(f, 1), 3, "three emplacements")
      Test.assert_true(SrMsf.depot_cells(f) > 0, "the depot stands")
    end
    test "emplacements act on their own: the player only sees mech turns" do
      let f = SrMsf.destroy_small()
      let seen = SrMsf.turns_seen(f, 12)
      Test.assert_true(!List.is_empty(seen) && List.all(seen, fn id -> SrMsf.kind_of(f, id) == 0), "only mechs")
    end
    test "knocking out the battery and half the depot, then withdrawing, wins" do
      Test.assert_true(SrMsf.won(SrMsf.play_destroy(SrMsf.emplacements_at(SrMsf.destroy_with(4), 10), 400)), "won")
    end
    test "losing every mech loses" do
      Test.assert_true(SrMsf.lost(SrMsf.play_destroy(SrMsf.destroy_frail(), 400)), "lost")
    end
  end
end
