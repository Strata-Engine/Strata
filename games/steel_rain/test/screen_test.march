-- Screen: the parts of the fight screen that need no window.
mod SteelRain.Test.Screen do

  needs IO.Clock      -- charged to every test module once any uses Check.all (GAPS S3)

  needs IO.Console

  needs IO.FileRead

  needs IO.FileWrite
  needs IO.Process
  import Test
  alias SteelRain.Screen as SrScr
  alias SteelRain.Test.Fights as SrScf

  pfn volley_events(f : SteelRain.Fight.Fight) : List(SteelRain.Fight.Event) do
    match SteelRain.Fight.step(f, SrScf.both_weapons(f)) do Ok((_, evs)) -> evs | Err(_) -> Nil end
  end
  pfn is_tracer(b : SteelRain.Screen.Beat) : Bool do match b do BTracer(_, _, _) -> true | _ -> false end end
  pfn is_carve(b : SteelRain.Screen.Beat) : Bool do match b do BCarve(_) -> true | _ -> false end end
  pfn is_round(e : SteelRain.Fight.Event) : Bool do match e do ERound(_, _) -> true | _ -> false end end
  pfn first_index(bs : List(SteelRain.Screen.Beat), p : SteelRain.Screen.Beat -> Bool) : Int do
    match List.find_index(bs, p) do Some(i) -> i | None -> 100000 end
  end
  pfn warned(i : Strata.Overlay.Item) : Bool do
    match i do OvQuad(_, c, _) -> c == SrScr.warning() | OvLine(_, _, _, c, _) -> c == SrScr.warning() end
  end

  describe "Screen" do
    test "a volley plays as one tracer per round, the first carve after the first tracer" do
      let evs = volley_events(SrScf.behind_wall())
      let beats = SrScr.queue(evs)
      Test.assert_eq_int(List.length(List.filter(beats, is_tracer)), List.length(List.filter(evs, is_round)), "one tracer a round")
      Test.assert_true(List.any(beats, is_carve) && first_index(beats, is_tracer) < first_index(beats, is_carve), "in order")
    end
    test "the cone view marks an ally inside it" do
      let f = SrScf.ally_between()
      Test.assert_true(List.any(SrScr.cone_items(f, 1, SrScf.arm_path(), SrScf.torso_point_of(f, 2)), warned), "warned")
      let g = SrScf.facing_pair()
      Test.assert_true(!List.any(SrScr.cone_items(g, 1, SrScf.arm_path(), SrScf.torso_point_of(g, 2)), warned), "no ally, no warning")
    end
  end
end
